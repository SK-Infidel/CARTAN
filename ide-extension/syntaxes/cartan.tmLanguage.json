{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cartan",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#decorators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.car"
        },
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.car"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(fn|var|let|mut|const|return|struct|class|trait|impl|import|in|under|parameter|extern)\\b",
          "name": "keyword.control.car"
        },
        {
          "match": "\\b(if|else|while|for|break|continue|try|catch|throw|match|self)\\b",
          "name": "keyword.control.flow.car"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.car"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(tensor|vector|stream|int|i32|f32|float|bool|string|fp16|fp32|bf16|int8|tree|spike|neuron|sequence|block|lattice|ptr)\\b",
          "name": "support.type.car"
        },
        {
          "match": "\\b(Euclidean|PoincaréDisk|PoincareDisk|Minkowski|Adam|SGD|Hopfield|Kuramoto|LieGroup|Weyl)\\b",
          "name": "support.class.car"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.car",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.car"
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(@|->|=>|\\+|-|\\*|/|%|==|!=|>|<|>=|<=|&&|\\|\\||!|&mut|&)",
          "name": "keyword.operator.car"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "match": "@(location)\\b",
          "name": "entity.name.function.decorator.car"
        }
      ]
    }
  },
  "scopeName": "source.car"
}
