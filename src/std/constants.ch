// src/std/constants.ch
// CARTAN Standard Library: Physical, Mathematical, and Astronomical Constants Header

// Mathematical Constants
const PI: float = 3.14159265358979323846;
const E: float = 2.71828182845904523536;
const PHI: float = 1.61803398874989484820;
const SQRT2: float = 1.41421356237309504880;

// Universal Physical Constants (SI Units)
const SPEED_OF_LIGHT: float = 299792458.0;              // c (m/s)
const PLANCK_CONSTANT: float = 6.62607015e-34;            // h (J·s)
const REDUCED_PLANCK: float = 1.054571817e-34;           // hbar (J·s)
const GRAVITATIONAL_CONSTANT: float = 6.67430e-11;       // G (m^3/(kg·s^2))
const BOLTZMANN_CONSTANT: float = 1.380649e-23;          // k_B (J/K)
const ELEMENTARY_CHARGE: float = 1.602176634e-19;        // e (C)
const AVOGADRO_CONSTANT: float = 6.02214076e23;          // N_A (mol^-1)
const VACUUM_PERMITTIVITY: float = 8.8541878128e-12;     // epsilon_0 (F/m)
const VACUUM_PERMEABILITY: float = 1.25663706212e-6;     // mu_0 (N/A^2)

// Astronomical Constants
const ASTRONOMICAL_UNIT: float = 149597870700.0;         // au (m)
const LIGHT_YEAR: float = 9.4607304725808e15;            // ly (m)
const PARSEC: float = 3.08567758149137e16;               // pc (m)
const SOLAR_MASS: float = 1.98847e30;                    // M_sun (kg)
