// src/std/http.car
// CARTAN Standard Library: Layer 1 HTTP Client & Server Protocol Module

include "net.car";
include "io.car";

fn http_get(url: string) -> string {
    let sock = net_socket();
    if (sock <= 0.0) { return ""; }

    let conn = net_connect(sock, url, 80.0);
    if (conn == 0.0) {
        net_close(sock);
        return "";
    }

    let req = "GET / HTTP/1.1\r\nHost: cartan-lang.org\r\nConnection: close\r\n\r\n";
    net_send(sock, req);
    let resp = net_recv(sock);
    net_close(sock);
    return resp;
}

fn http_post(url: string, body: string) -> string {
    let sock = net_socket();
    if (sock <= 0.0) { return ""; }

    let conn = net_connect(sock, url, 80.0);
    if (conn == 0.0) {
        net_close(sock);
        return "";
    }

    let req = "POST / HTTP/1.1\r\nHost: cartan-lang.org\r\nContent-Type: application/json\r\nConnection: close\r\n\r\n";
    net_send(sock, req);
    net_send(sock, body);
    let resp = net_recv(sock);
    net_close(sock);
    return resp;
}
