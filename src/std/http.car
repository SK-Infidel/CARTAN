// src/std/http.car
// CARTAN Standard Library: Layer 1 HTTP Client & Server Protocol Module

include "net.car";
include "io.car";

mod http {
    fn get(url: string) -> string {
        let sock = net::socket();
        if (sock <= 0.0) { return ""; }

        let conn = net::connect(sock, url, 80.0);
        if (conn == 0.0) {
            net::close(sock);
            return "";
        }

        let req = "GET / HTTP/1.1\r\nHost: cartan-lang.org\r\nConnection: close\r\n\r\n";
        net::send(sock, req);
        let resp = net::recv(sock);
        net::close(sock);
        return resp;
    }

    fn post(url: string, body: string) -> string {
        let sock = net::socket();
        if (sock <= 0.0) { return ""; }

        let conn = net::connect(sock, url, 80.0);
        if (conn == 0.0) {
            net::close(sock);
            return "";
        }

        let req = "POST / HTTP/1.1\r\nHost: cartan-lang.org\r\nContent-Type: application/json\r\nConnection: close\r\n\r\n";
        net::send(sock, req);
        net::send(sock, body);
        let resp = net::recv(sock);
        net::close(sock);
        return resp;
    }
}
