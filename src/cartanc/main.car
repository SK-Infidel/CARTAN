// src/cartanc/main.car
// Entrypoint for Cartan Self-Hosted Compiler (cartanc2)

include "ast.ch";
include "lexer.car";
include "parser.car";
include "type_checker.car";
include "optimizer.car";
include "llvm_codegen.car";

extern fn cartan_float_to_string(f: float) -> string;
extern fn cartan_copy_file(src: string, dst: string) -> float;
extern fn cartan_get_env(key: string) -> string;
extern fn cartan_jit_eval(ll_file: string) -> float;
extern fn cartan_ast_tree_len(t: ptr) -> float;
extern fn cartan_ast_tree_set(t: ptr, i: float, item: ptr) -> void;
extern fn cartan_ast_tree_get(t: ptr, i: float) -> ptr;
extern fn cartan_ast_tree_push(t: ptr, item: ptr) -> void;
extern fn cartan_ast_tree_create() -> ptr;
extern fn cartan_tree_len(t: ptr) -> float;
extern fn cartan_tree_len_f(t: ptr) -> float;
extern fn cartan_tree_write_file(path: string, t: ptr) -> void;
extern fn cartan_string_replace(s: string, f: string, r: string) -> string;
extern fn cartan_flush(f: float) -> void;
extern fn cartan_read_line() -> string;
extern fn cartan_file_exists(path: string) -> float;
extern fn atof(s: string) -> float;
extern fn cartan_tree_has(container: ptr, target: string) -> float;
extern fn cartan_tree_remove(t: ptr, idx: float) -> void;
extern fn cartan_tree_set(t: ptr, idx: float, val: ptr) -> void;
extern fn printf(format: string) -> i32;
extern fn strcmp(s1: string, s2: string) -> i32;
extern fn system(cmd: string) -> i32;
extern fn cartan_read_file(path: string) -> string;
extern fn cartan_tree_create() -> ptr;
extern fn cartan_tree_push(t: ptr, item: ptr) -> void;
extern fn cartan_tree_get_f32(t: ptr, idx: float) -> ptr;
extern fn cartan_tree_len(t: ptr) -> float;
extern fn cartan_string_length(s: string) -> float;
extern fn sys_get_arg(idx: float) -> string;
extern fn sys_get_arg_count() -> float;
