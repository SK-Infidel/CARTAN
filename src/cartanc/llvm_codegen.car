            if (method_name == "push_str") {
                var arg_str = "";
                if (cartan_tree_len_f(args) > 0.0) {
                    let arg0 = cartan_tree_get_f32(args, 0.0);
                    let arg_reg = llvm_visit_expr(self_ptr, arg0);
                    arg_str = cartan_string_replace(cartan_string_replace(cartan_string_replace(cartan_string_replace(arg_reg, "ptr:", ""), "string:", ""), "array:", ""), "struct:", "");
                } else {}
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  call void @cartan_tree_push(ptr ", clean_obj), ", ptr "), arg_str), ")\n"));
                return "0.0";
            } else {}
            if (method_name == "to_lowercase") {
                let res_reg = next_reg(self_ptr);
                let p1 = cartan_string_concat("  ", res_reg);
                let p2 = cartan_string_concat(p1, " = call ptr @cartan_string_to_lowercase(ptr ");
                let p3 = cartan_string_concat(p2, clean_obj);
                let p4 = cartan_string_concat(p3, ")\n");
                cartan_tree_push(self_ptr.output, p4);
                return cartan_string_concat("string:", res_reg);
            } else {}
            if (method_name == "len") {
                let res_reg = next_reg(self_ptr);
                let i32_len = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", i32_len), " = call i32 @cartan_tree_len(ptr "), clean_obj), ")\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res_reg), " = sitofp i32 "), i32_len), " to float\n"));
                return res_reg;
            } else {}

            let res_reg = next_reg(self_ptr);
            let func_name = cartan_string_concat("cartan_method_", method_name);
            let p1 = cartan_string_concat("  ", res_reg);
            let p2 = cartan_string_concat(p1, " = call float @");
            let p3 = cartan_string_concat(p2, func_name);
            let p4 = cartan_string_concat(p3, "(ptr ");
            let p5 = cartan_string_concat(p4, clean_obj);
            let p6 = cartan_string_concat(p5, ")\n");
            cartan_tree_push(self_ptr.output, p6);
            return res_reg;
        }
        if (disc == 20.0 || disc == 34.0) {
            let object = cartan_tree_get_f32(expr, 1.0);
            let property_name = cartan_tree_get_f32(expr, 2.0);
            let obj_reg = llvm_visit_expr(self_ptr, object);
            var struct_type = "StructName";
            if (cartan_string_starts_with(obj_reg, "struct:") != 0.0) {
                var s_part = cartan_string_replace(obj_reg, "struct:", "");
                let clean_r = clean_reg(obj_reg);
                struct_type = cartan_string_replace(s_part, cartan_string_concat(":", clean_r), "");
            } else {
                let obj_disc = cartan_tree_get_f32(object, 0.0);
                if (obj_disc == 6.0 || obj_disc == 70.0) {
                    let obj_name = cartan_tree_get_f32(object, 1.0);
                    let vt = cartan_dict_get(self_ptr.var_types, obj_name);
                    if (vt != 0.0 && cartan_string_starts_with(vt, "%") != 0.0) {
                        struct_type = cartan_string_replace(vt, "%", "");
                    }
                }
            }
            let field_names = cartan_dict_get(self_ptr.struct_fields, struct_type);
            let field_types = cartan_dict_get(self_ptr.struct_field_types, struct_type);
            var f_idx = 0.0;
            if (field_names != 0.0) {
                var scan_i = 0.0;
                while (scan_i < cartan_tree_len_f(field_names)) {
                    let fn_cand = cartan_tree_get_f32(field_names, scan_i);
                    if (cartan_string_eq(fn_cand, property_name) != 0.0) {
                        f_idx = scan_i;
                        break;
                    }
                    scan_i = scan_i + 1.0;
                }
            }
            var ftype = "double";
            if (field_types != 0.0 && f_idx < cartan_tree_len_f(field_types)) {
                ftype = cartan_tree_get_f32(field_types, f_idx);
            }
            let clean_obj_reg = clean_reg(obj_reg);
            let elem_ptr = next_reg(self_ptr);
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", elem_ptr), " = getelementptr inbounds %"), struct_type), ", ptr "), clean_obj_reg), ", i32 0, i32 "), cartan_int_to_string(f_idx)), "\n"));
            
            let val_reg = next_reg(self_ptr);
            if (ftype == "ptr" || ftype == "string" || (cartan_string_starts_with(ftype, "%") != 0.0)) {
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_reg), " = load ptr, ptr "), elem_ptr), ", align 8\n"));
                if (ftype == "string") {
                    return cartan_string_concat("string:", val_reg);
                } else if (cartan_string_starts_with(ftype, "%") != 0.0) {
                    let clean_s = cartan_string_replace(ftype, "%", "");
                    return cartan_string_concat("struct:", cartan_string_concat(clean_s, cartan_string_concat(":", val_reg)));
                } else {
                    return cartan_string_concat("ptr:", val_reg);
                }
            } else {
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_reg), " = load double, ptr "), elem_ptr), ", align 8\n"));
                return val_reg;
            }
        }
        if (disc == 21.0 || disc == 36.0) {
            let object = cartan_tree_get_f32(expr, 1.0);
            let index = cartan_tree_get_f32(expr, 2.0);
            let obj_reg_raw = llvm_visit_expr(self_ptr, object);
            let clean_obj = clean_reg(obj_reg_raw);
            let idx_reg = llvm_visit_expr(self_ptr, index);
            
            let int_idx = next_reg(self_ptr);
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", int_idx), " = fptosi double "), as_float(self_ptr, idx_reg)), " to i32\n"));
            
            var is_raw_ptr = 0.0;
            if (cartan_string_starts_with(obj_reg_raw, "struct:") != 0.0) { is_raw_ptr = 1.0; }
            if (cartan_string_starts_with(obj_reg_raw, "ptr:") != 0.0) { is_raw_ptr = 1.0; }
            
            if (is_raw_ptr != 0.0) {
                let elem_ptr = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", elem_ptr), " = getelementptr inbounds double, ptr "), clean_obj), ", i32 "), int_idx), "\n"));
                let val_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_reg), " = load double, ptr "), elem_ptr), ", align 8\n"));
                return val_reg;
            } else {
                let elem_ptr = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", elem_ptr), " = getelementptr inbounds [100 x double], ptr "), clean_obj), ", i32 0, i32 "), int_idx), "\n"));
                let val_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_reg), " = load double, ptr "), elem_ptr), ", align 8\n"));
                return val_reg;
            }
        }
        if (disc == 24.0) {
            let elements = cartan_tree_get_f32(expr, 1.0);
            let len = cartan_tree_len_f(elements);
            let array_ptr = next_reg(self_ptr);
            let a1 = cartan_string_concat("  ", array_ptr);
            let a2 = cartan_string_concat(a1, " = alloca [");
            let a3 = cartan_string_concat(a2, len);
            let a4 = cartan_string_concat(a3, " x float], align 4\n");
            cartan_tree_push(self_ptr.output, a4);

            var idx_e = 0.0;
            while (idx_e < len) {
                let el = cartan_tree_get_f32(elements, idx_e);
                let val_reg = llvm_visit_expr(self_ptr, el);
                let elem_ptr = next_reg(self_ptr);
                let g1 = cartan_string_concat("  ", elem_ptr);
                let g2 = cartan_string_concat(g1, " = getelementptr inbounds [");
                let g3 = cartan_string_concat(g2, len);
                let g4 = cartan_string_concat(g3, " x float], ptr ");
                let g5 = cartan_string_concat(g4, array_ptr);
                let g6 = cartan_string_concat(g5, ", i32 0, i32 ");
                let g7 = cartan_string_concat(g6, idx_e);
                let g8 = cartan_string_concat(g7, "\n");
                cartan_tree_push(self_ptr.output, g8);

                let s1 = cartan_string_concat("  store float ", val_reg);
                let s2 = cartan_string_concat(s1, ", ptr ");
                let s3 = cartan_string_concat(s2, elem_ptr);
                let s4 = cartan_string_concat(s3, ", align 4\n");
                cartan_tree_push(self_ptr.output, s4);

                idx_e = idx_e + 1.0;
            }
            return array_ptr;
        }
        if (disc == 42.0 || disc == 75.0) {
            let target = cartan_tree_get_f32(expr, 1.0);
            let target_disc = cartan_tree_get_f32(target, 0.0);
            if (target_disc == 6.0) {
                let name = cartan_tree_get_f32(target, 1.0);
                let ptr_reg = cartan_dict_get(self_ptr.symbols, name);
                if (ptr_reg != 0.0) {
                    return cartan_string_concat("ptr:", ptr_reg);
                } else {}
            } else {}
            return "0.0";
        }
        if (disc == 43.0 || disc == 76.0) {
            let target = cartan_tree_get_f32(expr, 1.0);
            let ptr_val = llvm_visit_expr(self_ptr, target);
            if (ptr_val != 0.0) {
                let reg = cartan_string_replace(ptr_val, "ptr:", "");
                let res = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res), " = load ptr, ptr "), reg), ", align 8\n"));
                return cartan_string_concat("ptr:", res);
            } else {
                return "0.0";
            }
        }
        return "0.0";
    }



