                if (cartan_string_eq(op, "-") != 0.0) {
                    if (cartan_string_eq(r_reg, "0.0") != 0.0) { return l_reg; }
                }
                if (cartan_string_eq(op, "*") != 0.0) {
                    if (cartan_string_eq(r_reg, "1.0") != 0.0) { return l_reg; }
                    if (cartan_string_eq(l_reg, "1.0") != 0.0) { return r_reg; }
                    if (cartan_string_eq(r_reg, "0.0") != 0.0 || cartan_string_eq(l_reg, "0.0") != 0.0) { return "0.0"; }
                }
                if (cartan_string_eq(op, "/") != 0.0) {
                    if (cartan_string_eq(r_reg, "1.0") != 0.0) { return l_reg; }
                }

                var op_str = "fadd";
                if (cartan_string_eq(op, "-") != 0.0) { op_str = "fsub"; }
                else if (cartan_string_eq(op, "*") != 0.0) { op_str = "fmul"; }
                else if (cartan_string_eq(op, "/") != 0.0) { op_str = "fdiv"; }
                else {}

                let res_reg = next_reg(self_ptr);
                let p1 = cartan_string_concat("  ", res_reg);
                let p2 = cartan_string_concat(p1, " = ");
                let p3 = cartan_string_concat(p2, op_str);
                let p4 = cartan_string_concat(p3, " float ");
                let p5 = cartan_string_concat(p4, l_reg);
                let p6 = cartan_string_concat(p5, ", ");
                let p7 = cartan_string_concat(p6, r_reg);
                let p8 = cartan_string_concat(p7, "
");
                cartan_tree_push(self_ptr.output, p8);
                return res_reg;
            }
        }
        if (disc == 17.0 || disc == 27.0) {
            let name_node = cartan_tree_get_f32(expr, 1.0);
            var name = name_node;
            let name_disc = cartan_tree_get_f32(name_node, 0.0);
            if (name_disc == 0.0) {
                name = cartan_tree_get_f32(name_node, 1.0);
            }
            if (cartan_string_contains(name, "static_assert") != 0.0) {
                return "0.0";
            }
            let args = cartan_tree_get_f32(expr, 2.0);
            let num_args = cartan_tree_len_f(args);

            var arg_str = "";
            var idx_a = 0.0;
            while (idx_a < num_args) {
                let arg = cartan_tree_get_f32(args, idx_a);
                let arg_reg = llvm_visit_expr(self_ptr, arg);
                var formatted_arg = "";
                if ((cartan_string_starts_with(arg_reg, "ptr:") != 0.0) || (cartan_string_starts_with(arg_reg, "string:") != 0.0) || (cartan_string_starts_with(arg_reg, "array:") != 0.0) || (cartan_string_starts_with(arg_reg, "struct:") != 0.0)) {
                    let clean = cartan_string_replace(cartan_string_replace(cartan_string_replace(cartan_string_replace(arg_reg, "ptr:", ""), "string:", ""), "array:", ""), "struct:", "");
                    formatted_arg = cartan_string_concat("ptr ", clean);
                } else if (cartan_string_eq(name, "printf") != 0.0 && idx_a > 0.0) {
