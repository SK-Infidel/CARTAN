                cartan_tree_push(self_ptr.globals, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(global_name, " = private unnamed_addr constant ["), len_str), " x i8] "), cartan_string_concat(fmt_str, ", align 1\n")));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  call i32 (ptr, ...) @printf(ptr ", global_name), ", ptr "), clean_msg), ")\n"));
                if (self_ptr.current_return_type == "void") {
                    cartan_tree_push(self_ptr.output, "  ret void\n");
                } else if (self_ptr.current_return_type == "double" || self_ptr.current_return_type == "float") {
                    cartan_tree_push(self_ptr.output, "  ret double 1.0\n");
                } else if (self_ptr.current_return_type == "i64") {
                    cartan_tree_push(self_ptr.output, "  ret i64 1\n");
                } else {
                    cartan_tree_push(self_ptr.output, "  ret ptr null\n");
                }
                let unreachable = next_label(self_ptr, "unreachable_throw_");
                cartan_tree_push(self_ptr.output, cartan_string_concat(unreachable, ":\n"));
            }
            if (disc == 43.0 || disc == 166.0) {
                let block_val = cartan_tree_get_f32(stmt, 1.0);
                cartan_tree_push(self_ptr.output, "  ; Begin Async Compute Block\n");
                let block_stmts = cartan_tree_get_f32(block_val, 0.0);
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(block_stmts)) {
