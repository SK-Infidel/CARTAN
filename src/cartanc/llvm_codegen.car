        cartan_tree_push(self_ptr.output, "declare ptr @cartan_read_file(ptr)\n");
        cartan_tree_push(self_ptr.output, "declare float @cartan_file_exists(ptr)\n");
        cartan_tree_push(self_ptr.output, "declare ptr @cartan_string_char_at(ptr, float)\n");
        cartan_tree_push(self_ptr.output, "declare float @cartan_is_alpha(ptr)\n");
        cartan_tree_push(self_ptr.output, "declare float @cartan_is_alphanumeric(ptr)\n");
        cartan_tree_push(self_ptr.output, "declare void @cartan_panic(ptr)\n");
