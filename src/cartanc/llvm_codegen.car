
extern fn cartan_float_to_string(f: float) -> string;
extern fn cartan_int_to_string(f: float) -> string;
extern fn cartan_llvm_format_string_literal(s: string, id: float) -> string;
extern fn cartan_strip_prefix(s: string) -> string;



struct LLVMGenerator {
    output: ptr;
    register_count: float;
    label_count: float;
    string_counter: float;
    globals: ptr;
    symbols: ptr;
    var_types: ptr;
    var_manifolds: ptr;
    struct_fields: ptr;
    func_return_types: ptr;
    loop_labels: ptr;
    current_return_type: string;
    struct_field_types: ptr;
    struct_field_stmts: ptr;
    current_struct: string;
    loop_meta_counter: float;
    loop_metadata: ptr;
    declared_externs: ptr;
    enum_variants: ptr;
    enum_variant_types: ptr;
    header: ptr;
    decls: ptr;
    global_var_types: ptr;
}

fn llvm_codegen_init() -> LLVMGenerator {
    var l = LLVMGenerator {
        output: cartan_tree_create(),
        register_count: 1.0,
        label_count: 1.0,
        string_counter: 1.0,
        globals: cartan_tree_create(),
        symbols: cartan_tree_create(),
        var_types: cartan_tree_create(),
        var_manifolds: cartan_tree_create(),
        struct_fields: cartan_tree_create(),
        func_return_types: cartan_tree_create(),
        loop_labels: cartan_tree_create(),
        current_return_type: "",
        struct_field_types: cartan_tree_create(),
        struct_field_stmts: cartan_tree_create(),
        current_struct: "",
        loop_meta_counter: 0.0,
        loop_metadata: cartan_tree_create(),
        declared_externs: cartan_tree_create(),
        enum_variants: cartan_tree_create(),
        enum_variant_types: cartan_tree_create(),
        header: cartan_tree_create(),
        decls: cartan_tree_create(),
        global_var_types: cartan_tree_create(),
    };
    cartan_dict_set(l.func_return_types, "cartan_tree_create", "ptr");
    cartan_dict_set(l.func_return_types, "cartan_tree_get_f32", "ptr");
