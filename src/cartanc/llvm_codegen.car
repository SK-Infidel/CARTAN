    cartan_dict_set(l.func_return_types, "cartan_c_int_to_string", "string");
    cartan_dict_set(l.func_return_types, "cartan_c_float_to_string", "string");
    cartan_dict_set(l.func_return_types, "cartan_c_sprintf_hex_byte", "void");
    cartan_dict_set(l.func_return_types, "cartan_c_tree_push", "void");
    cartan_dict_set(l.func_return_types, "cartan_c_tree_set", "void");
    cartan_dict_set(l.func_return_types, "cartan_c_tree_remove", "void");
    cartan_dict_set(l.func_return_types, "cartan_c_tree_len_f", "double");
