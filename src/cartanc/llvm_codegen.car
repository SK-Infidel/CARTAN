            } else {
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(p1, " = call double @"), name), "("), arg_str), ")\n"));
                return res_reg;
            }
        }
        if (disc == 29.0) {
            let object = cartan_tree_get_f32(expr, 1.0);
            let method_name = cartan_tree_get_f32(expr, 2.0);
            let args = cartan_tree_get_f32(expr, 3.0);
            let obj_reg = llvm_visit_expr(self_ptr, object);
            let clean_obj = cartan_string_replace(cartan_string_replace(cartan_string_replace(cartan_string_replace(obj_reg, "ptr:", ""), "string:", ""), "array:", ""), "struct:", "");

            if (method_name == "push_str") {
