            }
        }
        if (disc == 21.0 || disc == 36.0) {
            let object = cartan_tree_get_f32(expr, 1.0);
            let index = cartan_tree_get_f32(expr, 2.0);
            let obj_reg_raw = llvm_visit_expr(self_ptr, object);
            let clean_obj = clean_reg(obj_reg_raw);
            let idx_reg = llvm_visit_expr(self_ptr, index);
            
            let int_idx = next_reg(self_ptr);
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", int_idx), " = fptosi double "), as_float(self_ptr, idx_reg)), " to i32\n"));
            
            var is_raw_ptr = 0.0;
            if (cartan_string_starts_with(obj_reg_raw, "struct:") != 0.0) { is_raw_ptr = 1.0; }
            if (cartan_string_starts_with(obj_reg_raw, "ptr:") != 0.0) { is_raw_ptr = 1.0; }
            
            var is_string = 0.0;
            if (cartan_string_starts_with(obj_reg_raw, "string:") != 0.0) { is_string = 1.0; }

            if (is_string != 0.0) {
                let elem_ptr = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", elem_ptr), " = getelementptr inbounds i8, ptr "), clean_obj), ", i32 "), int_idx), "\n"));
                let byte_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", byte_reg), " = load i8, ptr "), elem_ptr), ", align 1\n"));
                let val_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_reg), " = uitofp i8 "), byte_reg), " to double\n"));
                return val_reg;
            } else if (is_raw_ptr != 0.0) {
                let elem_ptr = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", elem_ptr), " = getelementptr inbounds double, ptr "), clean_obj), ", i32 "), int_idx), "\n"));
                let val_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_reg), " = load double, ptr "), elem_ptr), ", align 8\n"));
                return val_reg;
            } else {
                let elem_ptr = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", elem_ptr), " = getelementptr inbounds [100 x double], ptr "), clean_obj), ", i32 0, i32 "), int_idx), "\n"));
                let val_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_reg), " = load double, ptr "), elem_ptr), ", align 8\n"));
                return val_reg;
            }
        }
        if (disc == 24.0) {
            let elements = cartan_tree_get_f32(expr, 1.0);
            let len = cartan_tree_len_f(elements);
            let array_ptr = next_reg(self_ptr);
            let a1 = cartan_string_concat("  ", array_ptr);
            let a2 = cartan_string_concat(a1, " = alloca [");
            let a3 = cartan_string_concat(a2, cartan_int_to_string(len));
            let a4 = cartan_string_concat(a3, " x float], align 4\n");
            cartan_tree_push(self_ptr.output, a4);

            var idx_e = 0.0;
            while (idx_e < len) {
                let el = cartan_tree_get_f32(elements, idx_e);
                let val_reg = llvm_visit_expr(self_ptr, el);
                let elem_ptr = next_reg(self_ptr);
                let g1 = cartan_string_concat("  ", elem_ptr);
                let g2 = cartan_string_concat(g1, " = getelementptr inbounds [");
                let g3 = cartan_string_concat(g2, cartan_int_to_string(len));
                let g4 = cartan_string_concat(g3, " x float], ptr ");
                let g5 = cartan_string_concat(g4, array_ptr);
                let g6 = cartan_string_concat(g5, ", i32 0, i32 ");
                let g7 = cartan_string_concat(g6, cartan_int_to_string(idx_e));
                let g8 = cartan_string_concat(g7, "\n");
                cartan_tree_push(self_ptr.output, g8);

                let s1 = cartan_string_concat("  store float ", as_float(self_ptr, val_reg));
                let s2 = cartan_string_concat(s1, ", ptr ");
                let s3 = cartan_string_concat(s2, elem_ptr);
                let s4 = cartan_string_concat(s3, ", align 4\n");
                cartan_tree_push(self_ptr.output, s4);

                idx_e = idx_e + 1.0;
            }
            return array_ptr;
        }
        if (disc == 42.0 || disc == 75.0) {
            let target = cartan_tree_get_f32(expr, 1.0);
            let target_disc = cartan_tree_get_f32(target, 0.0);
            if (target_disc == 6.0) {
                let name = cartan_tree_get_f32(target, 1.0);
                let ptr_reg = cartan_dict_get(self_ptr.symbols, name);
                if (ptr_reg != 0.0) {
                    return cartan_string_concat("ptr:", ptr_reg);
                } else {}
            } else {}
            return "0.0";
        }
        if (disc == 43.0 || disc == 76.0) {
            let target = cartan_tree_get_f32(expr, 1.0);
            let ptr_val = llvm_visit_expr(self_ptr, target);
            if (ptr_val != 0.0) {
                let reg = cartan_string_replace(ptr_val, "ptr:", "");
                let res = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res), " = load ptr, ptr "), reg), ", align 8\n"));
                return cartan_string_concat("ptr:", res);
            } else {
                return "0.0";
            }
        }
        return "0.0";
    }



