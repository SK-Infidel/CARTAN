}


    

    fn next_reg(self_ptr: LLVMGenerator) -> string {
        let reg = cartan_string_concat("%", cartan_int_to_string(self_ptr.register_count));
        self_ptr.register_count = self_ptr.register_count + 1.0;
        return reg;
    }

    fn clean_reg(val: string) -> string {
        return cartan_strip_prefix(val);
    }

    fn as_float(self_ptr: LLVMGenerator, val: string) -> string {
        var is_ptr = 0.0;
        if (cartan_string_starts_with(val, "ptr:") != 0.0) { is_ptr = 1.0; }
        if (cartan_string_starts_with(val, "string:") != 0.0) { is_ptr = 1.0; }
        if (cartan_string_starts_with(val, "array:") != 0.0) { is_ptr = 1.0; }
        if (cartan_string_starts_with(val, "struct:") != 0.0) { is_ptr = 1.0; }
        if (cartan_string_starts_with(val, "tree<") != 0.0) { is_ptr = 1.0; }
        if (is_ptr != 0.0) {
            let clean_p = clean_reg(val);
            let int_reg = next_reg(self_ptr);
            let flt_reg = next_reg(self_ptr);
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", int_reg), " = ptrtoint ptr "), clean_p), " to i64\n"));
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", flt_reg), " = sitofp i64 "), int_reg), " to double\n"));
            return flt_reg;
        }
        let clean = cartan_strip_prefix(val);
        if (cartan_string_starts_with(clean, "%") != 0.0) { return clean; }
        if (cartan_string_starts_with(clean, "@") != 0.0) { return clean; }
        if (cartan_string_starts_with(clean, "0x") != 0.0) { return clean; }
        if (cartan_string_contains(clean, ".") != 0.0) { return clean; }
        if (cartan_string_contains(clean, "e") != 0.0) {
            if (cartan_string_contains(clean, ".") == 0.0) {
                return cartan_string_replace(clean, "e", ".0e");
            }
            return clean;
        }
        if (cartan_string_contains(clean, "E") != 0.0) {
            if (cartan_string_contains(clean, ".") == 0.0) {
                return cartan_string_replace(clean, "E", ".0E");
            }
            return clean;
        }
        if (cartan_string_eq(clean, "null") != 0.0) { return "0.0"; }
        if (cartan_string_eq(clean, "undef") != 0.0) { return clean; }
        if (cartan_string_length(clean) == 0.0) { return "0.0"; }
        return cartan_string_concat(clean, ".0");
    }

    fn promote_float_to_tensor(self_ptr: LLVMGenerator, float_reg: string) -> string {
        let tensor_reg = next_reg(self_ptr);
        // Allocate a tensor of size 1
        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", tensor_reg), " = call ptr @cartan_tensor_alloc_temporary(double 1.0)\n"));
        
        // Load the data pointer (which is the first field of Tensor struct)
        let data_ptr = next_reg(self_ptr);
        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", data_ptr), " = load ptr, ptr "), tensor_reg), ", align 8\n"));
        
        // Store the float value into the data pointer
        let val_f = as_float(self_ptr, float_reg);
        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store float ", val_f), ", ptr "), data_ptr), ", align 4\n"));
        
        return cartan_string_concat("ptr:", tensor_reg);
    }

    fn next_label(self_ptr: LLVMGenerator, prefix: string) -> string {
        let label = cartan_string_concat(prefix, cartan_int_to_string(self_ptr.label_count));
        self_ptr.label_count = self_ptr.label_count + 1.0;
        return label;
    }

    fn add_builtin_extern(self_ptr: LLVMGenerator, user_defined: ptr, name: string, decl_line: string) {
        cartan_tree_push(self_ptr.declared_externs, name);
        if (cartan_tree_has(user_defined, name) == 0.0) {
            cartan_tree_push(self_ptr.decls, decl_line);
        }
    }

    fn generate(self_ptr: LLVMGenerator, ast: ptr) -> string {
        // Pass 1: Forward declarations
        var idx_stmt = 0.0;
        let a_len = cartan_tree_len_f(ast);
        while (idx_stmt < a_len) {
            var stmt = cartan_tree_get_f32(ast, idx_stmt);
            idx_stmt = idx_stmt + 1.0;
            let disc = cartan_tree_get_f32(stmt, 0.0);
            if (disc == 5.0 || disc == 10.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let fields = cartan_tree_get_f32(stmt, 2.0);
                let field_names = cartan_tree_create();
                let field_types = cartan_tree_create();
                var idx_field = 0.0;
                while (idx_field < cartan_tree_len_f(fields)) {
                    var field = cartan_tree_get_f32(fields, idx_field);
                    idx_field = idx_field + 1.0;
                    let field_disc = cartan_tree_get_f32(field, 0.0);
                    if (field_disc == 4.0 || field_disc == 8.0) {
                        let field_name = cartan_tree_get_f32(field, 1.0);
                        let type_name = cartan_tree_get_f32(field, 2.0);
                        cartan_tree_push(field_names, field_name);
                        let t = "";
                        if (cartan_string_eq(type_name, "Tensor") != 0.0 || cartan_string_eq(type_name, "Vector") != 0.0) {
                            t = "ptr";
                        } else if (cartan_string_eq(type_name, "float") != 0.0 || cartan_string_eq(type_name, "int") != 0.0 || cartan_string_eq(type_name, "double") != 0.0) {
                            t = "double";
                        } else if (cartan_string_eq(type_name, "string") != 0.0) {
                            t = "string";
                        } else if (is_uppercase(type_name) != 0.0) {
                            t = cartan_string_concat("%", type_name);
                        } else {
                            t = "ptr";
                        }
                        cartan_tree_push(field_types, t);
                    }
                }
                cartan_dict_set(self_ptr.struct_fields, name, field_names);
                cartan_dict_set(self_ptr.struct_field_types, name, field_types);
            }
            if (disc == 2.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let variants = cartan_tree_get_f32(stmt, 2.0);
                let variant_map = cartan_tree_create();
                let variant_type_map = cartan_tree_create();
                var i = 0.0;
                while (i < cartan_tree_len_f(variants)) {
                    var variant = cartan_tree_get_f32(variants, i);
                    let v_name = cartan_tree_get_f32(variant, 0.0);
                    let fields = cartan_tree_get_f32(variant, 1.0);
                    let pair = cartan_tree_create();
                    cartan_tree_push(pair, v_name);
                    cartan_tree_push(pair, cartan_float_to_string(i));
                    cartan_tree_push(variant_map, pair);
                    let v_types = cartan_tree_create();
                    if (fields != 0.0) {
                        var idx_opt_type = 0.0;
                        while (idx_opt_type < cartan_tree_len_f(fields)) {
                            var opt_type = cartan_tree_get_f32(fields, idx_opt_type);
                            let t = cartan_tree_get_f32(opt_type, 1.0);
                            var llvm_t = "ptr";
                            if (t == "Tensor" || t == "Vector") {
                                llvm_t = "ptr";
                            } else if (t == "float" || t == "int") {
                                llvm_t = "double";
                            } else if (is_uppercase(t) != 0.0) {
                                llvm_t = cartan_string_concat("%", t);
                            } else {
                                llvm_t = "ptr";
                            }
                            cartan_tree_push(v_types, llvm_t);
                            idx_opt_type = idx_opt_type + 1.0;
                        }
                    } else {}
                    let type_pair = cartan_tree_create();
                    cartan_tree_push(type_pair, v_name);
                    cartan_tree_push(type_pair, v_types);
                    cartan_tree_push(variant_type_map, type_pair);
                    i = i + 1.0;
                }
                cartan_dict_set(self_ptr.enum_variants, name, variant_map);
                cartan_dict_set(self_ptr.enum_variant_types, name, variant_type_map);
            }
            if (disc == 14.0 || disc == 131.0) {
                var fn_name = cartan_tree_get_f32(stmt, 1.0);
                if (cartan_string_eq(fn_name, "main") != 0.0) { fn_name = "user_main"; }
                let rt = cartan_tree_get_f32(stmt, 4.0);
                var logical_ret_type = "void";
                if (rt != 0.0) {
                    if (rt == "void") { logical_ret_type = "void"; }
                    else if (rt == "float" || rt == "int" || rt == "i32" || rt == "i64" || rt == "bool" || rt == "double") { logical_ret_type = "double"; }
                    else if (rt == "ptr" || rt == "string" || (cartan_string_starts_with(rt, "tree<") != 0.0)) { logical_ret_type = rt; }
                    else if (is_uppercase(rt) != 0.0) { logical_ret_type = cartan_string_concat("%", rt); }
                    else { logical_ret_type = "double"; }
                } else {}
                cartan_dict_set(self_ptr.func_return_types, fn_name, logical_ret_type);
            }
            if (disc == 15.0) {
                let fn_name = cartan_tree_get_f32(stmt, 1.0);
                let rt = cartan_tree_get_f32(stmt, 3.0);
                var logical_ret_type = "void";
                if (rt != 0.0) {
                    if (rt == "void") { logical_ret_type = "void"; }
                    else if (rt == "float" || rt == "int" || rt == "i32" || rt == "i64" || rt == "bool" || rt == "double") { logical_ret_type = "double"; }
                    else if (rt == "ptr" || rt == "string" || (cartan_string_starts_with(rt, "tree<") != 0.0)) { logical_ret_type = rt; }
                    else if (is_uppercase(rt) != 0.0) { logical_ret_type = cartan_string_concat("%", rt); }
                    else { logical_ret_type = "double"; }
                } else {}
                cartan_dict_set(self_ptr.func_return_types, fn_name, logical_ret_type);
            }
            if (disc == 34.0 || disc == 88.0 || disc == 157.0) {
                var target_name = cartan_tree_get_f32(stmt, 2.0);
                var methods = cartan_tree_get_f32(stmt, 3.0);
                if (methods == 0.0) {
                    target_name = cartan_tree_get_f32(stmt, 1.0);
                    methods = cartan_tree_get_f32(stmt, 2.0);
                }
                if (methods != 0.0) {
                    var idx_im = 0.0;
                    while (idx_im < cartan_tree_len_f(methods)) {
                        var m = cartan_tree_get_f32(methods, idx_im);
                        idx_im = idx_im + 1.0;
                        let md = cartan_tree_get_f32(m, 0.0);
                        if (md == 14.0 || md == 131.0) {
                            let fn_name = cartan_tree_get_f32(m, 1.0);
                            let rt = cartan_tree_get_f32(m, 4.0);
                            var logical_ret_type = "void";
                            if (rt != 0.0) {
                                if (rt == "void") { logical_ret_type = "void"; }
                                else if (rt == "float" || rt == "int" || rt == "i32" || rt == "i64" || rt == "bool" || rt == "double") { logical_ret_type = "double"; }
                                else if (rt == "ptr" || rt == "string" || (cartan_string_starts_with(rt, "tree<") != 0.0)) { logical_ret_type = rt; }
                                else if (is_uppercase(rt) != 0.0) { logical_ret_type = cartan_string_concat("%", rt); }
                                else { logical_ret_type = "double"; }
                            }
                            var safe_name = fn_name;
                            if (target_name != 0.0 && cartan_string_length(target_name) > 0.0) {
                                safe_name = cartan_string_concat(cartan_string_concat(target_name, "_"), fn_name);
