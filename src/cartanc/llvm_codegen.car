                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", catch_alloca), " = alloca ptr, align 8\n"));
                    cartan_dict_set(self_ptr.symbols, catch_var, catch_alloca);
                    cartan_dict_set(self_ptr.var_types, catch_var, "ptr");
                }
            }
            if (disc == 21.0) { // Throw
                let expr = cartan_tree_get_f32(stmt, 1.0);
                var clean_msg = "null";
                if (expr != 0.0) {
                    let msg_reg = llvm_visit_expr(self_ptr, expr);
                    clean_msg = clean_reg(msg_reg);
                }
                let id = self_ptr.string_counter;
                self_ptr.string_counter = self_ptr.string_counter + 1.0;
                let global_name = cartan_string_concat("@.str.throw.", cartan_int_to_string(id));
                let fmt_str = "c\"Uncaught Exception: %s\\0A\\00\"";
