        add_builtin_extern(self_ptr, user_defined_names, "cartan_internal_import_onnx", "declare ptr @cartan_internal_import_onnx(ptr)\n");
        add_builtin_extern(self_ptr, user_defined_names, "cartan_print", "declare float @cartan_print(ptr)\n");

        // Pass 0: Collect structs
        var idx_stmt = 0.0;
        while (idx_stmt < cartan_tree_len_f(ast)) {
            var stmt = cartan_tree_get_f32(ast, idx_stmt);
            idx_stmt = idx_stmt + 1.0;
            let stmt_disc = cartan_tree_get_f32(stmt, 0.0);
            if (stmt_disc == 5.0 || stmt_disc == 10.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let fields = cartan_tree_get_f32(stmt, 2.0);
                let field_names = cartan_tree_create();
                let field_types = cartan_tree_create();
                let field_stmts = cartan_tree_create();
                var idx_field = 0.0;
                while (idx_field < cartan_tree_len_f(fields)) {
                    var field = cartan_tree_get_f32(fields, idx_field);
                    idx_field = idx_field + 1.0;
                    let disc = cartan_tree_get_f32(field, 0.0);
                    if (disc == 4.0 || disc == 8.0) {
                        let field_name = cartan_tree_get_f32(field, 1.0);
                        let type_name = cartan_tree_get_f32(field, 2.0);
                        cartan_tree_push(field_names, field_name);
                        let t = "";
                        if (cartan_string_eq(type_name, "Tensor") != 0.0 || cartan_string_eq(type_name, "Vector") != 0.0) {
                            t = "ptr";
                        } else if (cartan_string_eq(type_name, "float") != 0.0 || cartan_string_eq(type_name, "int") != 0.0 || cartan_string_eq(type_name, "double") != 0.0) {
                            t = "double";
                        } else if (cartan_string_eq(type_name, "string") != 0.0) {
                            t = "string";
                        } else if (is_uppercase(type_name) != 0.0) {
                            t = cartan_string_concat("%", type_name);
                        } else {
                            t = "ptr";
                        }
                        cartan_tree_push(field_types, t);
                        cartan_tree_push(field_stmts, field);
                    }
                }
                let count = cartan_tree_len_f(field_names);
                cartan_dict_set(self_ptr.struct_fields, name, field_names);
                cartan_dict_set(self_ptr.struct_field_types, name, field_types);
                cartan_dict_set(self_ptr.struct_field_stmts, name, field_stmts);
                cartan_tree_push(self_ptr.header, cartan_string_concat(cartan_string_concat("%", name), " = type { "));
                var idx_i = 0.0;
                while (idx_i < count) {
                    var i = idx_i;
                    idx_i = idx_i + 1.0;
                    if (i > 0.0) { cartan_tree_push(self_ptr.header, ", "); }
                    let t = cartan_tree_get_f32(field_types, i);
                    let llvm_t = "";
                    if (cartan_string_eq(t, "string") != 0.0) {
                        llvm_t = "ptr";
                    } else {
                        llvm_t = t;
                    }
                    cartan_tree_push(self_ptr.header, llvm_t);
                }
                cartan_tree_push(self_ptr.header, " }\n");
            }
        }
        cartan_tree_push(self_ptr.header, "\n");

        // user_defined_names already collected at start of generate
        // Pass 1: Collect globals and declare extern functions
        var idx_stmt = 0.0;
        while (idx_stmt < cartan_tree_len_f(ast)) {
            var stmt = cartan_tree_get_f32(ast, idx_stmt);
            idx_stmt = idx_stmt + 1.0;
            let disc = cartan_tree_get_f32(stmt, 0.0);
            if (disc == 0.0) {

            } else if (disc == 15.0 || disc == 48.0) {
                let fn_name = cartan_tree_get_f32(stmt, 1.0);
                let parameters = cartan_tree_get_f32(stmt, 2.0);
                let rt = cartan_tree_get_f32(stmt, 3.0);
                if (cartan_tree_has(user_defined_names, fn_name) == 0.0 && cartan_tree_has(self_ptr.declared_externs, fn_name) == 0.0) {
                    cartan_tree_push(self_ptr.declared_externs, fn_name);
                    let param_types = cartan_tree_create();
                    var idx_p = 0.0;
                    while (idx_p < cartan_tree_len_f(parameters)) {
                        var p = cartan_tree_get_f32(parameters, idx_p);
                        idx_p = idx_p + 1.0;
                        let p_type_name = cartan_tree_get_f32(p, 1.0);
                        var p_type = "ptr";
                        if (p_type_name == "float" || p_type_name == "int" || p_type_name == "double") {
                            p_type = "double";
                        } else {
                            p_type = "ptr";
                        }
                        cartan_tree_push(param_types, p_type);
                    }
                    var logical_ret = "void";
                    if (rt != 0.0) {
                        if (cartan_string_eq(rt, "void") != 0.0) { logical_ret = "void"; }
                        else if (rt == "Tensor" || rt == "Vector") { logical_ret = "ptr"; }
                        else if (rt == "float" || rt == "int" || rt == "double") { logical_ret = "double"; }
                        else if (is_uppercase(rt) != 0.0) { logical_ret = cartan_string_concat("%", rt); }
                        else if (rt == "string") { logical_ret = "string"; }
                        else { logical_ret = "ptr"; }
                    } else {}
                    var abi_ret = "ptr";
                    if (logical_ret == "double" || logical_ret == "void") {
                        abi_ret = logical_ret;
                    } else {
                        abi_ret = "ptr";
                    }
                    
                    var params = "";
                    var idx_pt = 0.0;
                    while (idx_pt < cartan_tree_len_f(param_types)) {
                        let pt = cartan_tree_get_f32(param_types, idx_pt);
                        if (idx_pt > 0.0) { params = cartan_string_concat(params, ", "); } else {}
                        params = cartan_string_concat(params, pt);
                        idx_pt = idx_pt + 1.0;
                    }
                    if (fn_name == "printf") {
                        if (cartan_string_length(params) == 0.0) { params = "..."; }
                        else { params = cartan_string_concat(params, ", ..."); }
                    } else {}
                    if (fn_name == "sprintf") { params = "ptr, ptr, ..."; abi_ret = "i32"; } else {}
                    if (fn_name == "malloc") { params = "i64"; } else {}
                    if (fn_name == "calloc") { params = "i64, i64"; } else {}
                    if (fn_name == "free") { params = "ptr"; abi_ret = "void"; } else {}
                    if (fn_name == "strlen") { params = "ptr"; abi_ret = "i64"; } else {}
                    if (fn_name == "strcmp") { params = "ptr, ptr"; abi_ret = "i32"; } else {}
                    if (fn_name == "strncmp") { params = "ptr, ptr, i64"; abi_ret = "i32"; } else {}
                    if (fn_name == "memcpy") { params = "ptr, ptr, i64"; abi_ret = "ptr"; } else {}
                    if (fn_name == "fseek") { params = "ptr, i64, i32"; abi_ret = "i32"; } else {}
                    if (fn_name == "ftell") { params = "ptr"; abi_ret = "i64"; } else {}
                    if (fn_name == "fread") { params = "ptr, i64, i64, ptr"; abi_ret = "i64"; } else {}
                    if (fn_name == "fwrite") { params = "ptr, i64, i64, ptr"; abi_ret = "i64"; } else {}
                    if (fn_name == "fflush") { params = "ptr"; abi_ret = "i32"; } else {}
                    if (fn_name == "fclose") { params = "ptr"; abi_ret = "i32"; } else {}
                    if (fn_name == "fputs") { params = "ptr, ptr"; abi_ret = "i32"; } else {}
                    if (fn_name == "fgets") { params = "ptr, i32, ptr"; abi_ret = "ptr"; } else {}
                    if (fn_name == "system") { params = "ptr"; abi_ret = "i32"; } else {}
                    if (fn_name == "remove") { params = "ptr"; abi_ret = "i32"; } else {}
                    if (fn_name == "rename") { params = "ptr, ptr"; abi_ret = "i32"; } else {}
                    if (fn_name == "exit") { params = "i32"; abi_ret = "void"; } else {}
                    if (fn_name == "__acrt_iob_func") { params = "i32"; abi_ret = "ptr"; } else {}
                    cartan_dict_set(self_ptr.func_return_types, fn_name, logical_ret);
                    cartan_tree_push(self_ptr.decls, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("declare ", abi_ret), " @"), fn_name), "("), params), ")\n"));
                    cartan_dict_set(self_ptr.symbols, fn_name, cartan_string_concat("@", fn_name));
                } else {}
            }
        }

        // Pass 2: Process User-Defined Functions
        let all_funcs = cartan_tree_create();
        var idx_stmt = 0.0;
        while (idx_stmt < cartan_tree_len_f(ast)) {
            var stmt = cartan_tree_get_f32(ast, idx_stmt);
            idx_stmt = idx_stmt + 1.0;
            let stmt_disc = cartan_tree_get_f32(stmt, 0.0);
            if (stmt_disc == 14.0 || stmt_disc == 131.0) {
                let tup = cartan_tree_create(); cartan_tree_push(tup, ""); cartan_tree_push(tup, stmt); cartan_tree_push(all_funcs, tup);
            }
            if (stmt_disc == 2.0) { let name = cartan_tree_get_f32(stmt, 1.0);
                cartan_tree_push(self_ptr.header, cartan_string_concat(cartan_string_concat("%", name), " = type { float, [16 x ptr] }\n"));
            }
            if (stmt_disc == 5.0 || stmt_disc == 10.0) { let name = cartan_tree_get_f32(stmt, 1.0); let fields = cartan_tree_get_f32(stmt, 2.0);
                var idx_field = 0.0;
                while (idx_field < cartan_tree_len_f(fields)) {
                    var field = cartan_tree_get_f32(fields, idx_field);
                    idx_field = idx_field + 1.0;
                    let field_disc = cartan_tree_get_f32(field, 0.0); if (field_disc == 14.0 || field_disc == 44.0 || field_disc == 131.0) {
                        let tup = cartan_tree_create(); cartan_tree_push(tup, name); cartan_tree_push(tup, field); cartan_tree_push(all_funcs, tup);
                    }
                }
            }
            if (stmt_disc == 88.0) { let target_name = cartan_tree_get_f32(stmt, 1.0); let methods = cartan_tree_get_f32(stmt, 2.0);
                var idx_method = 0.0;
while (idx_method < cartan_tree_len_f(methods)) {
    var method = cartan_tree_get_f32(methods, idx_method);
    idx_method = idx_method + 1.0;
                    let method_disc = cartan_tree_get_f32(method, 0.0); if (method_disc == 14.0 || method_disc == 131.0) {
                        let tup = cartan_tree_create(); cartan_tree_push(tup, target_name); cartan_tree_push(tup, method); cartan_tree_push(all_funcs, tup);
                    }
                }
            }
        }

        let global_symbols = cartan_dict_clone(self_ptr.symbols);
        var idx_func = 0.0;
        while (idx_func < cartan_tree_len_f(all_funcs)) {
            var tup = cartan_tree_get_f32(all_funcs, idx_func);
            idx_func = idx_func + 1.0;
            var struct_name = cartan_tree_get_f32(tup, 0.0);
            var decl = cartan_tree_get_f32(tup, 1.0);
            self_ptr.current_struct = struct_name;
            self_ptr.symbols = cartan_dict_clone(global_symbols);
            self_ptr.var_types = cartan_tree_create();
            
            let fn_name = cartan_tree_get_f32(decl, 1.0);
            printf("[DEBUG codegen fn] %s\n", fn_name);
            cartan_flush(0.0);
            let parameters = cartan_tree_get_f32(decl, 3.0);
            let rt = cartan_tree_get_f32(decl, 4.0);
            let body = cartan_tree_get_f32(decl, 6.0);

            let param_types = cartan_tree_create();
            let _sname = struct_name;
            if (_sname != 0.0 && cartan_string_length(_sname) > 0.0) {
                cartan_tree_push(param_types, "ptr %arg_self");
            } else {}
            
            var idx_p = 0.0;
            while (idx_p < cartan_tree_len_f(parameters)) {
                var p = cartan_tree_get_f32(parameters, idx_p);
                idx_p = idx_p + 1.0;
                let p_name = cartan_tree_get_f32(p, 0.0);
                let p_type_name = cartan_tree_get_f32(p, 1.0);
                var p_type = "ptr";
                if (p_type_name == "float" || p_type_name == "int") {
                    p_type = "double";
                } else {
                    p_type = "ptr";
                }
                cartan_tree_push(param_types, cartan_string_concat(cartan_string_concat(p_type, " %arg_"), p_name));
            }
            
            var logical_ret = "void";
            if (rt != 0.0) {
                if (cartan_string_eq(rt, "void") != 0.0) { logical_ret = "void"; }
                else if (rt == "Tensor" || rt == "Vector") { logical_ret = "ptr"; }
                else if (rt == "float" || rt == "int") { logical_ret = "double"; }
                else if (is_uppercase(rt) != 0.0) { logical_ret = cartan_string_concat("%", rt); }
                else if (rt == "string") { logical_ret = "string"; }
                else { logical_ret = "ptr"; }
            } else {}
            var abi_ret = "ptr";
            if (logical_ret == "double" || logical_ret == "void") {
                abi_ret = logical_ret;
            } else {
                abi_ret = "ptr";
            }
            
            var params = "";
            var idx_pt = 0.0;
            while (idx_pt < cartan_tree_len_f(param_types)) {
                let pt = cartan_tree_get_f32(param_types, idx_pt);
                if (idx_pt > 0.0) { params = cartan_string_concat(params, ", "); } else {}
                params = cartan_string_concat(params, pt);
                idx_pt = idx_pt + 1.0;
            }

            var safe_name = fn_name;
            if (cartan_string_eq(fn_name, "main") != 0.0) {
                if (struct_name == 0.0 || cartan_string_length(struct_name) == 0.0) {
                    safe_name = "user_main";
                } else {}
            } else if (struct_name != 0.0) {
                if (cartan_string_length(struct_name) > 0.0) {
                    safe_name = cartan_string_concat(cartan_string_concat(struct_name, "_"), fn_name);
                } else {}
            } else {}
            cartan_dict_set(self_ptr.func_return_types, safe_name, logical_ret);
            
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("define ", abi_ret), " @"), safe_name), "("));
            cartan_tree_push(self_ptr.output, cartan_string_concat(params, ") {\nentry:\n"));

            if (struct_name != 0.0 && cartan_string_length(struct_name) > 0.0) {
                let alloc_ptr = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", alloc_ptr), " = alloca ptr, align 8\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  store ptr %arg_self, ptr ", alloc_ptr), ", align 8\n"));
                cartan_dict_set(self_ptr.symbols, "self", alloc_ptr);
                cartan_dict_set(self_ptr.var_types, "self", cartan_string_concat("%", struct_name));
            } else {}

            idx_p = 0.0;
            while (idx_p < cartan_tree_len_f(parameters)) {
                var p = cartan_tree_get_f32(parameters, idx_p);
                idx_p = idx_p + 1.0;
                let p_name = cartan_tree_get_f32(p, 0.0);
                let p_type_name = cartan_tree_get_f32(p, 1.0);
                var p_type = "ptr";
                if (p_type_name == "float" || p_type_name == "int") {
                    p_type = "double";
                } else {
                    p_type = "ptr";
                }
                let alloc_ptr = next_reg(self_ptr);
                var align = "8";
                if (p_type == "ptr" || p_type == "double") {
                    align = "8";
                } else {
                    align = "4";
                }
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", alloc_ptr), " = alloca "), p_type), ", align "), align), "\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ", p_type), " %arg_"), p_name), ", ptr "), alloc_ptr), ", align "), align), "\n"));
                cartan_dict_set(self_ptr.symbols, p_name, alloc_ptr);
                var type_to_insert = p_type;
                if (p_type == "ptr") {
                    if (is_uppercase(p_type_name) != 0.0) {
                        if (p_type_name != "Tensor") {
                            if (p_type_name != "Vector") {
                                type_to_insert = cartan_string_concat("%", p_type_name);
                            } else {}
                        } else {}
                    } else if (cartan_string_eq(p_type_name, "string") != 0.0) {
                        type_to_insert = "string";
                    } else {}
                } else {}
                cartan_dict_set(self_ptr.var_types, p_name, type_to_insert);
            }

            self_ptr.current_return_type = abi_ret;
            var body_stmts = body;
            if (cartan_tree_len_f(body_stmts) == 0.0) {
                body_stmts = cartan_tree_get_f32(body, 0.0);
            }
            var idx_bs = 0.0;
            while (idx_bs < cartan_tree_len_f(body_stmts)) {
                var s = cartan_tree_get_f32(body_stmts, idx_bs);
                idx_bs = idx_bs + 1.0;
                llvm_visit_stmt(self_ptr, s);
            }
            self_ptr.current_return_type = "float";
            
            // Add default return if needed
            let last_idx = cartan_tree_len_f(self_ptr.output) - 1.0;
            var last_line = "";
            if (last_idx >= 0.0) {
                last_line = cartan_tree_get_f32(self_ptr.output, last_idx);
            }
            if (cartan_string_contains(last_line, "ret ") == 0.0) {
                if (cartan_string_eq(abi_ret, "void") != 0.0) {
                    cartan_tree_push(self_ptr.output, "  ret void\n");
                } else if (cartan_string_eq(abi_ret, "double") != 0.0) {
                    cartan_tree_push(self_ptr.output, "  ret double 0.0\n");
                } else {
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ret ", abi_ret), " null\n"));
                }
            }
            
            cartan_tree_push(self_ptr.output, "}\n\n");
        }

        // Pass 3: Main logic
        cartan_tree_push(self_ptr.globals, "@global_argc = global i32 0, align 4\n");
        cartan_tree_push(self_ptr.globals, "@global_argv = global ptr null, align 8\n");
        cartan_tree_push(self_ptr.globals, "@.str.empty_arg = private unnamed_addr constant [1 x i8] c\"\\00\", align 1\n");
        cartan_tree_push(self_ptr.globals, "@.str.fmt_int = private unnamed_addr constant [5 x i8] c\"%.0f\\00\", align 1\n");
        cartan_tree_push(self_ptr.globals, "@.str.fmt_flt_one = private unnamed_addr constant [5 x i8] c\"%.1f\\00\", align 1\n");
        cartan_tree_push(self_ptr.globals, "@.str.fmt_flt_g = private unnamed_addr constant [3 x i8] c\"%g\\00\", align 1\n");
        cartan_tree_push(self_ptr.globals, "@.str.fmt_sci_fix = private unnamed_addr constant [9 x i8] c\"%.*s.0%s\\00\", align 1\n");
        cartan_tree_push(self_ptr.globals, "@.str.fmt_hex_byte = private unnamed_addr constant [6 x i8] c\"\\5C%02x\\00\", align 1\n\n");
        cartan_tree_push(self_ptr.output, "define ptr @sys_get_arg(double %index) {\n");
        cartan_tree_push(self_ptr.output, "entry:\n");
        cartan_tree_push(self_ptr.output, "  %idx_i32 = fptosi double %index to i32\n");
        cartan_tree_push(self_ptr.output, "  %argc = load i32, ptr @global_argc, align 4\n");
        cartan_tree_push(self_ptr.output, "  %in_bounds = icmp slt i32 %idx_i32, %argc\n");
        cartan_tree_push(self_ptr.output, "  %non_neg = icmp sge i32 %idx_i32, 0\n");
        cartan_tree_push(self_ptr.output, "  %valid = and i1 %in_bounds, %non_neg\n");
        cartan_tree_push(self_ptr.output, "  br i1 %valid, label %load_arg, label %ret_empty\n\n");
        cartan_tree_push(self_ptr.output, "load_arg:\n");
        cartan_tree_push(self_ptr.output, "  %argv = load ptr, ptr @global_argv, align 8\n");
        cartan_tree_push(self_ptr.output, "  %elem_ptr = getelementptr inbounds ptr, ptr %argv, i32 %idx_i32\n");
        cartan_tree_push(self_ptr.output, "  %arg_str = load ptr, ptr %elem_ptr, align 8\n");
        cartan_tree_push(self_ptr.output, "  ret ptr %arg_str\n\n");
        cartan_tree_push(self_ptr.output, "ret_empty:\n");
        cartan_tree_push(self_ptr.output, "  ret ptr @.str.empty_arg\n");
        cartan_tree_push(self_ptr.output, "}\n\n");
        cartan_tree_push(self_ptr.output, "define double @sys_get_arg_count() {\n");
        cartan_tree_push(self_ptr.output, "entry:\n");
        cartan_tree_push(self_ptr.output, "  %argc = load i32, ptr @global_argc, align 4\n");
        cartan_tree_push(self_ptr.output, "  %res = sitofp i32 %argc to double\n");
        cartan_tree_push(self_ptr.output, "  ret double %res\n");
        cartan_tree_push(self_ptr.output, "}\n\n");
        cartan_tree_push(self_ptr.output, "define void @cartan_crt_init(i32 %argc, ptr %argv) {\n");
        cartan_tree_push(self_ptr.output, "entry:\n");
        cartan_tree_push(self_ptr.output, "  %call_cp = call i32 @SetConsoleCP(i32 65001)\n");
        cartan_tree_push(self_ptr.output, "  %call_ocp = call i32 @SetConsoleOutputCP(i32 65001)\n");
        cartan_tree_push(self_ptr.output, "  ret void\n");
        cartan_tree_push(self_ptr.output, "}\n\n");

        cartan_tree_push(self_ptr.output, "define double @c_cartan_string_char_at(ptr %s, double %idx) {\nentry:\n  %is_null = icmp eq ptr %s, null\n  br i1 %is_null, label %ret_zero, label %check_bounds\ncheck_bounds:\n  %len = call i64 @strlen(ptr %s)\n  %i = fptosi double %idx to i64\n  %neg = icmp slt i64 %i, 0\n  %over = icmp uge i64 %i, %len\n  %bad = or i1 %neg, %over\n  br i1 %bad, label %ret_zero, label %load_char\nload_char:\n  %char_ptr = getelementptr inbounds i8, ptr %s, i64 %i\n  %ch = load i8, ptr %char_ptr, align 1\n  %ch_u32 = zext i8 %ch to i32\n  %res = uitofp i32 %ch_u32 to double\n  ret double %res\nret_zero:\n  ret double 0.0\n}\n\n");
        cartan_tree_push(self_ptr.output, "define ptr @cartan_c_memcpy(ptr %dest, ptr %src, double %count) {\nentry:\n  %dest_null = icmp eq ptr %dest, null\n  %src_null = icmp eq ptr %src, null\n  %either_null = or i1 %dest_null, %src_null\n  %le_zero = fcmp ole double %count, 0.0\n  %skip = or i1 %either_null, %le_zero\n  br i1 %skip, label %ret_dest, label %do_copy\ndo_copy:\n  %n = fptoui double %count to i64\n  %res = call ptr @memcpy(ptr %dest, ptr %src, i64 %n)\n  ret ptr %res\nret_dest:\n  ret ptr %dest\n}\n\n");
        cartan_tree_push(self_ptr.output, "define double @cartan_c_strncmp(ptr %s1, ptr %s2, double %n) {\nentry:\n  %s1_null = icmp eq ptr %s1, null\n  %s2_null = icmp eq ptr %s2, null\n  %either_null = or i1 %s1_null, %s2_null\n  %le_zero = fcmp ole double %n, 0.0\n  %skip = or i1 %either_null, %le_zero\n  br i1 %skip, label %ret_zero, label %do_cmp\ndo_cmp:\n  %count = fptoui double %n to i64\n  %res_i32 = call i32 @strncmp(ptr %s1, ptr %s2, i64 %count)\n  %res = sitofp i32 %res_i32 to double\n  ret double %res\nret_zero:\n  ret double 0.0\n}\n\n");
        cartan_tree_push(self_ptr.output, "define ptr @cartan_c_ptr_add(ptr %p, double %offset) {\nentry:\n  %is_null = icmp eq ptr %p, null\n  br i1 %is_null, label %ret_null, label %do_add\ndo_add:\n  %off_i64 = fptosi double %offset to i64\n  %res = getelementptr inbounds i8, ptr %p, i64 %off_i64\n  ret ptr %res\nret_null:\n  ret ptr null\n}\n\n");
        cartan_tree_push(self_ptr.output, "define ptr @cartan_c_int_to_string(double %val) {\nentry:\n  %buf = call ptr @malloc(i64 64)\n  %is_null = icmp eq ptr %buf, null\n  br i1 %is_null, label %ret_empty, label %do_fmt\ndo_fmt:\n  call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 64, ptr @.str.fmt_int, double %val)\n  ret ptr %buf\nret_empty:\n  ret ptr @.str.empty_arg\n}\n\n");
        cartan_tree_push(self_ptr.output, "define ptr @cartan_c_float_to_string(double %val) {\nentry:\n  %buf = call ptr @malloc(i64 64)\n  %is_null = icmp eq ptr %buf, null\n  br i1 %is_null, label %ret_empty, label %check_int\ncheck_int:\n  %fl = call double @llvm.floor.f64(double %val)\n  %is_int = fcmp oeq double %val, %fl\n  br i1 %is_int, label %fmt_point_one, label %fmt_g\nfmt_point_one:\n  call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 64, ptr @.str.fmt_flt_one, double %val)\n  ret ptr %buf\nfmt_g:\n  call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 64, ptr @.str.fmt_flt_g, double %val)\n  %dot = call ptr @strchr(ptr %buf, i32 46)\n  %has_dot = icmp ne ptr %dot, null\n  br i1 %has_dot, label %ret_buf, label %check_e\ncheck_e:\n  %ep_lower = call ptr @strchr(ptr %buf, i32 101)\n  %has_lower = icmp ne ptr %ep_lower, null\n  br i1 %has_lower, label %fix_sci, label %check_upper_e\ncheck_upper_e:\n  %ep_upper = call ptr @strchr(ptr %buf, i32 69)\n  %has_upper = icmp ne ptr %ep_upper, null\n  br i1 %has_upper, label %fix_sci_upper, label %ret_buf\nfix_sci_upper:\n  br label %fix_sci_common\nfix_sci:\n  br label %fix_sci_common\nfix_sci_common:\n  %ep = phi ptr [ %ep_lower, %fix_sci ], [ %ep_upper, %fix_sci_upper ]\n  %buf_int = ptrtoint ptr %buf to i64\n  %ep_int = ptrtoint ptr %ep to i64\n  %diff = sub i64 %ep_int, %buf_int\n  %prefix_len = trunc i64 %diff to i32\n  %temp = alloca [64 x i8], align 1\n  call i32 (ptr, i64, ptr, ...) @snprintf(ptr %temp, i64 64, ptr @.str.fmt_sci_fix, i32 %prefix_len, ptr %buf, ptr %ep)\n  call ptr @strncpy(ptr %buf, ptr %temp, i64 64)\n  ret ptr %buf\nret_buf:\n  ret ptr %buf\nret_empty:\n  ret ptr @.str.empty_arg\n}\n\n");
        cartan_tree_push(self_ptr.output, "define void @cartan_c_sprintf_hex_byte(ptr %dest, double %b) {\nentry:\n  %is_null = icmp eq ptr %dest, null\n  br i1 %is_null, label %done, label %do_fmt\ndo_fmt:\n  %b_u32 = fptoui double %b to i32\n  call i32 (ptr, i64, ptr, ...) @snprintf(ptr %dest, i64 4, ptr @.str.fmt_hex_byte, i32 %b_u32)\n  br label %done\ndone:\n  ret void\n}\n\n");
        cartan_tree_push(self_ptr.output, "define ptr @cartan_c_tree_create() {\nentry:\n  %tree = call ptr @malloc(i64 32)\n  store i32 212167239, ptr %tree, align 4\n  %ref_ptr = getelementptr inbounds i8, ptr %tree, i64 4\n  store i32 1, ptr %ref_ptr, align 4\n  %size_ptr = getelementptr inbounds i8, ptr %tree, i64 8\n  store i64 0, ptr %size_ptr, align 8\n  %cap_ptr = getelementptr inbounds i8, ptr %tree, i64 16\n  store i64 16, ptr %cap_ptr, align 8\n  %data = call ptr @malloc(i64 128)\n  %data_field = getelementptr inbounds i8, ptr %tree, i64 24\n  store ptr %data, ptr %data_field, align 8\n  ret ptr %tree\n}\n\n");
        cartan_tree_push(self_ptr.output, "define double @cartan_c_tree_len_f(ptr %t) {\nentry:\n  %is_null = icmp eq ptr %t, null\n  br i1 %is_null, label %ret_zero, label %check_magic\ncheck_magic:\n  %magic = load i32, ptr %t, align 4\n  %is_tree = icmp eq i32 %magic, 212167239\n  br i1 %is_tree, label %load_len, label %ret_zero\nload_len:\n  %size_ptr = getelementptr inbounds i8, ptr %t, i64 8\n  %sz = load i64, ptr %size_ptr, align 8\n  %res = uitofp i64 %sz to double\n  ret double %res\nret_zero:\n  ret double 0.0\n}\n\n");
        cartan_tree_push(self_ptr.output, "define void @cartan_c_tree_push(ptr %t, ptr %item) {\nentry:\n  %is_null = icmp eq ptr %t, null\n  br i1 %is_null, label %done, label %check_magic\ncheck_magic:\n  %magic = load i32, ptr %t, align 4\n  %is_tree = icmp eq i32 %magic, 212167239\n  br i1 %is_tree, label %check_cap, label %done\ncheck_cap:\n  %sz_ptr = getelementptr inbounds i8, ptr %t, i64 8\n  %sz = load i64, ptr %sz_ptr, align 8\n  %cap_ptr = getelementptr inbounds i8, ptr %t, i64 16\n  %cap = load i64, ptr %cap_ptr, align 8\n  %need_grow = icmp uge i64 %sz, %cap\n  br i1 %need_grow, label %grow, label %do_push\ngrow:\n  %new_cap = mul i64 %cap, 2\n  store i64 %new_cap, ptr %cap_ptr, align 8\n  %data_field_g = getelementptr inbounds i8, ptr %t, i64 24\n  %old_data = load ptr, ptr %data_field_g, align 8\n  %new_bytes = mul i64 %new_cap, 8\n  %new_data = call ptr @realloc(ptr %old_data, i64 %new_bytes)\n  store ptr %new_data, ptr %data_field_g, align 8\n  br label %do_push\ndo_push:\n  %data_field_p = getelementptr inbounds i8, ptr %t, i64 24\n  %cur_data = load ptr, ptr %data_field_p, align 8\n  %slot = getelementptr inbounds ptr, ptr %cur_data, i64 %sz\n  store ptr %item, ptr %slot, align 8\n  %new_sz = add i64 %sz, 1\n  store i64 %new_sz, ptr %sz_ptr, align 8\n  br label %done\ndone:\n  ret void\n}\n\n");
        cartan_tree_push(self_ptr.output, "define ptr @cartan_c_tree_get(ptr %t, double %idx) {\nentry:\n  %is_null = icmp eq ptr %t, null\n  br i1 %is_null, label %ret_null, label %check_magic\nret_null:\n  ret ptr null\ncheck_magic:\n  %i64_idx = fptosi double %idx to i64\n  %magic = load i32, ptr %t, align 4\n  %is_tree = icmp eq i32 %magic, 212167239\n  br i1 %is_tree, label %tree_lookup, label %flat_lookup\ntree_lookup:\n  %size_ptr = getelementptr inbounds i8, ptr %t, i64 8\n  %size = load i64, ptr %size_ptr, align 8\n  %non_neg = icmp sge i64 %i64_idx, 0\n  %in_bounds = icmp slt i64 %i64_idx, %size\n  %valid = and i1 %non_neg, %in_bounds\n  br i1 %valid, label %tree_load, label %ret_null\ntree_load:\n  %data_ptr_ptr = getelementptr inbounds i8, ptr %t, i64 24\n  %data_ptr = load ptr, ptr %data_ptr_ptr, align 8\n  %data_is_null = icmp eq ptr %data_ptr, null\n  br i1 %data_is_null, label %ret_null, label %tree_do_load\ntree_do_load:\n  %slot = getelementptr inbounds ptr, ptr %data_ptr, i64 %i64_idx\n  %val = load ptr, ptr %slot, align 8\n  ret ptr %val\nflat_lookup:\n  %elem_slot = getelementptr inbounds i64, ptr %t, i64 %i64_idx\n  %raw_i = load i64, ptr %elem_slot, align 8\n  %is_zero_idx = icmp eq i64 %i64_idx, 0\n  br i1 %is_zero_idx, label %check_zero_disc, label %check_float_or_ptr\ncheck_zero_disc:\n  %is_raw0_zero = icmp eq i64 %raw_i, 0\n  br i1 %is_raw0_zero, label %ret_null, label %check_disc_range\ncheck_disc_range:\n  %d0 = bitcast i64 %raw_i to double\n  %ge_min = icmp uge i64 %raw_i, 4607182418800017408\n  %le_max = icmp ule i64 %raw_i, 4643176046757085184\n  %in_disc_range = and i1 %ge_min, %le_max\n  br i1 %in_disc_range, label %check_disc_int, label %check_float_or_ptr\ncheck_disc_int:\n  %d0_as_i64 = fptosi double %d0 to i64\n  %d0_recast = sitofp i64 %d0_as_i64 to double\n  %is_exact_int = fcmp oeq double %d0, %d0_recast\n  br i1 %is_exact_int, label %ret_disc_int, label %check_float_or_ptr\nret_disc_int:\n  %disc_ptr = inttoptr i64 %d0_as_i64 to ptr\n  ret ptr %disc_ptr\ncheck_float_or_ptr:\n  %shr = lshr i64 %raw_i, 48\n  %exp_i = and i64 %shr, 65535\n  %exp_ge = icmp uge i64 %exp_i, 16368\n  %exp_le = icmp ule i64 %exp_i, 17376\n  %is_dbl = and i1 %exp_ge, %exp_le\n  br i1 %is_dbl, label %ret_dbl_as_intptr, label %ret_raw_ptr\nret_dbl_as_intptr:\n  %dbl_val = bitcast i64 %raw_i to double\n  %dbl_to_i64 = fptoui double %dbl_val to i64\n  %res_ptr_from_dbl = inttoptr i64 %dbl_to_i64 to ptr\n  ret ptr %res_ptr_from_dbl\nret_raw_ptr:\n  %res_raw_ptr = inttoptr i64 %raw_i to ptr\n  ret ptr %res_raw_ptr\n}\n\n");
        cartan_tree_push(self_ptr.output, "define void @cartan_c_tree_set(ptr %t, double %idx, ptr %val) {\nentry:\n  %is_null = icmp eq ptr %t, null\n  br i1 %is_null, label %done, label %check_magic\ncheck_magic:\n  %magic = load i32, ptr %t, align 4\n  %is_tree = icmp eq i32 %magic, 212167239\n  br i1 %is_tree, label %check_cap, label %done\ncheck_cap:\n  %i = fptoui double %idx to i64\n  %cap_ptr = getelementptr inbounds i8, ptr %t, i64 16\n  %cap = load i64, ptr %cap_ptr, align 8\n  %need_grow = icmp uge i64 %i, %cap\n  br i1 %need_grow, label %grow, label %store_elem\ngrow:\n  %i_plus_1 = add i64 %i, 1\n  %new_cap = mul i64 %i_plus_1, 2\n  store i64 %new_cap, ptr %cap_ptr, align 8\n  %data_field_g = getelementptr inbounds i8, ptr %t, i64 24\n  %old_data = load ptr, ptr %data_field_g, align 8\n  %new_bytes = mul i64 %new_cap, 8\n  %new_data = call ptr @realloc(ptr %old_data, i64 %new_bytes)\n  store ptr %new_data, ptr %data_field_g, align 8\n  br label %store_elem\nstore_elem:\n  %data_field_s = getelementptr inbounds i8, ptr %t, i64 24\n  %cur_data = load ptr, ptr %data_field_s, align 8\n  %slot = getelementptr inbounds ptr, ptr %cur_data, i64 %i\n  store ptr %val, ptr %slot, align 8\n  %sz_ptr = getelementptr inbounds i8, ptr %t, i64 8\n  %sz = load i64, ptr %sz_ptr, align 8\n  %i_plus_1_sz = add i64 %i, 1\n  %need_sz_up = icmp uge i64 %i, %sz\n  br i1 %need_sz_up, label %update_sz, label %done\nupdate_sz:\n  store i64 %i_plus_1_sz, ptr %sz_ptr, align 8\n  br label %done\ndone:\n  ret void\n}\n\n");
        cartan_tree_push(self_ptr.output, "define void @cartan_c_tree_remove(ptr %t, double %idx) {\nentry:\n  %is_null = icmp eq ptr %t, null\n  br i1 %is_null, label %done, label %check_magic\ncheck_magic:\n  %magic = load i32, ptr %t, align 4\n  %is_tree = icmp eq i32 %magic, 212167239\n  br i1 %is_tree, label %check_bounds, label %done\ncheck_bounds:\n  %i = fptoui double %idx to i64\n  %sz_ptr = getelementptr inbounds i8, ptr %t, i64 8\n  %sz = load i64, ptr %sz_ptr, align 8\n  %out_of_bounds = icmp uge i64 %i, %sz\n  br i1 %out_of_bounds, label %done, label %shift_loop_init\nshift_loop_init:\n  %data_field = getelementptr inbounds i8, ptr %t, i64 24\n  %data = load ptr, ptr %data_field, align 8\n  %sz_minus_1 = sub i64 %sz, 1\n  br label %shift_loop_cond\nshift_loop_cond:\n  %j = phi i64 [ %i, %shift_loop_init ], [ %j_next, %shift_loop_body ]\n  %cmp = icmp ult i64 %j, %sz_minus_1\n  br i1 %cmp, label %shift_loop_body, label %shift_loop_done\nshift_loop_body:\n  %j_plus_1 = add i64 %j, 1\n  %src_slot = getelementptr inbounds ptr, ptr %data, i64 %j_plus_1\n  %val_to_move = load ptr, ptr %src_slot, align 8\n  %dst_slot = getelementptr inbounds ptr, ptr %data, i64 %j\n  store ptr %val_to_move, ptr %dst_slot, align 8\n  %j_next = add i64 %j, 1\n  br label %shift_loop_cond\nshift_loop_done:\n  store i64 %sz_minus_1, ptr %sz_ptr, align 8\n  br label %done\ndone:\n  ret void\n}\n\n");
        
        let has_main = 0.0;
        var main_params_count = 0.0;
        var idx_stmt = 0.0;
        while (idx_stmt < cartan_tree_len_f(ast)) {
            var stmt = cartan_tree_get_f32(ast, idx_stmt);
            idx_stmt = idx_stmt + 1.0;
            let stmt_disc = cartan_tree_get_f32(stmt, 0.0);
            if (stmt_disc == 14.0 || stmt_disc == 131.0) {
                let fn_name = cartan_tree_get_f32(stmt, 1.0);
                let parameters = cartan_tree_get_f32(stmt, 3.0);
                if (cartan_string_eq(fn_name, "main") != 0.0) {
                    has_main = 1.0;
                    main_params_count = cartan_tree_len_f(parameters);
                } else {}
            } else {}
        }
        
        cartan_tree_push(self_ptr.output, "define i32 @main(i32 %argc, ptr %argv) {\n");
        cartan_tree_push(self_ptr.output, "entry:\n");
        cartan_tree_push(self_ptr.output, "  call void @cartan_crt_init(i32 %argc, ptr %argv)\n");
        cartan_tree_push(self_ptr.output, "  store i32 %argc, ptr @global_argc, align 4\n");
        cartan_tree_push(self_ptr.output, "  store ptr %argv, ptr @global_argv, align 8\n");

        idx_stmt = 0.0;
        while (idx_stmt < cartan_tree_len_f(ast)) {
            var stmt = cartan_tree_get_f32(ast, idx_stmt);
            idx_stmt = idx_stmt + 1.0;
            let stmt_disc = cartan_tree_get_f32(stmt, 0.0);
            if (stmt_disc == 14.0 || stmt_disc == 131.0) {
                let fn_name = cartan_tree_get_f32(stmt, 1.0);
                let is_agent = cartan_tree_get_f32(stmt, 5.0);
                if (is_agent != 0.0) {
                    var target_fn = fn_name;
                    if (cartan_string_eq(fn_name, "main") != 0.0) {
                        target_fn = "user_main";
                    } else {}
                    let str_ptr = cartan_string_concat("@.str.agent.", fn_name);
                    let fn_len = cartan_string_length(fn_name) + 1.0;
                    cartan_tree_push(self_ptr.globals, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(str_ptr, " = private unnamed_addr constant ["), cartan_float_to_string(fn_len)), " x i8] c\""), fn_name), "\\00\", align 1\n"));
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  call void @cartan_rt_register_capability(ptr ", str_ptr), ", ptr @"), target_fn), ")\n"));
                } else {}
            } else {}
        }

        if (has_main != 0.0) {
            var ret_type = cartan_dict_get(self_ptr.func_return_types, "user_main");
            if (ret_type == 0.0) { ret_type = "void"; }
            var call_instr = "  call void @user_main()";
            if (main_params_count > 0.0) {
                if (ret_type == "void") {
                    call_instr = "  %conv_argc = sitofp i32 %argc to double\n  call void @user_main(double %conv_argc, ptr %argv)";
                } else {
                    call_instr = "  %conv_argc = sitofp i32 %argc to double\n  %exit_code_float = call double @user_main(double %conv_argc, ptr %argv)";
                }
            } else {
                if (ret_type != "void") {
                    call_instr = "  %exit_code_float = call double @user_main()";
                }
            }

            if (ret_type == "void") {
                cartan_tree_push(self_ptr.output, cartan_string_concat(call_instr, "\n"));
                cartan_tree_push(self_ptr.output, "  ret i32 0\n");
            } else {
                cartan_tree_push(self_ptr.output, cartan_string_concat(call_instr, "\n"));
                cartan_tree_push(self_ptr.output, "  %exit_code_int = fptosi double %exit_code_float to i32\n");
                cartan_tree_push(self_ptr.output, "  ret i32 %exit_code_int\n");
            }
        } else {
            var idx_stmt = 0.0;
            while (idx_stmt < cartan_tree_len_f(ast)) {
                var stmt = cartan_tree_get_f32(ast, idx_stmt);
                idx_stmt = idx_stmt + 1.0;
                let skip = 0.0;
                let disc = cartan_tree_get_f32(stmt, 0.0);
                if (disc == 15.0 || disc == 48.0) { skip = 1.0; }
                if (disc == 14.0 || disc == 44.0 || disc == 131.0) { skip = 1.0; }
                if (disc == 3.0 || disc == 4.0) {
                    let is_const = cartan_tree_get_f32(stmt, 2.0);
                    if (is_const == 1.0) { skip = 1.0; }
                }
                if (skip == 0.0) {
                    llvm_visit_stmt(self_ptr, stmt);
                }
            }
            cartan_tree_push(self_ptr.output, "  ret i32 0\n");
        }
        cartan_tree_push(self_ptr.output, "}\n\n");

        let final_output = cartan_tree_create();
        var idx_h = 0.0;
        while (idx_h < cartan_tree_len_f(self_ptr.header)) {
            cartan_tree_push(final_output, cartan_tree_get_f32(self_ptr.header, idx_h));
            idx_h = idx_h + 1.0;
        }
        var idx_g = 0.0;
        while (idx_g < cartan_tree_len_f(self_ptr.globals)) {
            cartan_tree_push(final_output, cartan_tree_get_f32(self_ptr.globals, idx_g));
            idx_g = idx_g + 1.0;
        }
        var idx_o = 0.0;
        while (idx_o < cartan_tree_len_f(self_ptr.output)) {
            cartan_tree_push(final_output, cartan_tree_get_f32(self_ptr.output, idx_o));
            idx_o = idx_o + 1.0;
        }
        var idx_d = 0.0;
        let emitted_decls = cartan_tree_create();
        while (idx_d < cartan_tree_len_f(self_ptr.decls)) {
            let decl_str = cartan_tree_get_f32(self_ptr.decls, idx_d);
            var already_emitted = 0.0;
            var idx_ed = 0.0;
            while (idx_ed < cartan_tree_len_f(emitted_decls)) {
                let prev_decl = cartan_tree_get_f32(emitted_decls, idx_ed);
                if (cartan_string_eq(prev_decl, decl_str) != 0.0) {
                    already_emitted = 1.0;
                }
                idx_ed = idx_ed + 1.0;
            }
            if (already_emitted == 0.0) {
                cartan_tree_push(emitted_decls, decl_str);
                cartan_tree_push(final_output, decl_str);
            }
            idx_d = idx_d + 1.0;
        }
        var idx_meta = 0.0;
        while (idx_meta < cartan_tree_len_f(self_ptr.loop_metadata)) {
            cartan_tree_push(final_output, cartan_tree_get_f32(self_ptr.loop_metadata, idx_meta));
            idx_meta = idx_meta + 1.0;
        }

        // DWARF Line Metadata Attachments (BACKLOG-005-B)
        cartan_tree_push(final_output, "\n!llvm.dbg.cu = !{!0}\n");
        cartan_tree_push(final_output, "!llvm.module.flags = !{!1, !2}\n");
        cartan_tree_push(final_output, "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !3, producer: \"Cartan Compiler v2.0\", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug)\n");
        cartan_tree_push(final_output, "!1 = !{i32 2, !\"Dwarf Version\", i32 4}\n");
        cartan_tree_push(final_output, "!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n");
        cartan_tree_push(final_output, "!3 = !DIFile(filename: \"main.car\", directory: \".\")\n");

        return final_output;
    }

    /// Recursively visits a Statement node and generates corresponding LLVM IR instructions,
    /// managing blocks, control-flow jumps, stack allocations, and runtime function linkages.
    fn llvm_visit_stmt(self_ptr: LLVMGenerator, stmt: Stmt) {
        let disc = stmt[0];
        if (disc == 0.0) {

            } else if (disc == 41.0 || disc == 75.0) {
                let condition = cartan_tree_get_f32(stmt, 1.0);
                let cond_reg = llvm_visit_expr(self_ptr, condition);
                var is_cond_ptr = 0.0;
                if (cartan_string_starts_with(cond_reg, "ptr:") != 0.0) { is_cond_ptr = 1.0; }
                if (cartan_string_starts_with(cond_reg, "string:") != 0.0) { is_cond_ptr = 1.0; }
                var clean_cond = cond_reg;
                if (cartan_string_starts_with(clean_cond, "ptr:") != 0.0) { clean_cond = cartan_string_replace(clean_cond, "ptr:", ""); }
                if (cartan_string_starts_with(clean_cond, "string:") != 0.0) { clean_cond = cartan_string_replace(clean_cond, "string:", ""); }
                
                let end_label = next_label(self_ptr, "match_end_");
                let arms = cartan_tree_get_f32(stmt, 2.0);
                var idx_arm = 0.0;
                while (idx_arm < cartan_tree_len_f(arms)) {
                    var arm = cartan_tree_get_f32(arms, idx_arm);
                    idx_arm = idx_arm + 1.0;
                    let pat_val = cartan_tree_get_f32(arm, 1.0);
                    let body = cartan_tree_get_f32(arm, 2.0);
                    let arm_label = next_label(self_ptr, "match_arm_");
                    let next_arm_label = next_label(self_ptr, "match_next_");
                    
                    if (pat_val != 0.0) {
                        let pat_reg = llvm_visit_expr(self_ptr, pat_val);
                        var is_pat_ptr = 0.0;
                        if (cartan_string_starts_with(pat_reg, "ptr:") != 0.0) { is_pat_ptr = 1.0; }
                        if (cartan_string_starts_with(pat_reg, "string:") != 0.0) { is_pat_ptr = 1.0; }
                        var clean_pat = pat_reg;
                        if (cartan_string_starts_with(clean_pat, "ptr:") != 0.0) { clean_pat = cartan_string_replace(clean_pat, "ptr:", ""); }
                        if (cartan_string_starts_with(clean_pat, "string:") != 0.0) { clean_pat = cartan_string_replace(clean_pat, "string:", ""); }
                        
                          if (is_cond_ptr != 0.0 && is_pat_ptr != 0.0) {
                              let is_prompt = (cartan_tree_get_f32(pat_val, 0.0) == 4.0);
                              let cmp_res = next_reg(self_ptr);
                              if (is_prompt != 0.0) {
                                  cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", cmp_res), " = call float @cartan_pattern_match(ptr "), clean_cond), ", ptr "), clean_pat), ")\n"));
                              } else {
                                  cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", cmp_res), " = call float @strcmp(ptr "), clean_cond), ", ptr "), clean_pat), ")\n"));
                              }
                              let cond_bool = next_reg(self_ptr);
                              if (is_prompt != 0.0) {
                                  cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", cond_bool), " = icmp sgt float "), cmp_res), ", 0\n"));
                              } else {
                                  cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", cond_bool), " = icmp eq float "), cmp_res), ", 0\n"));
                              }
                              cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  br i1 ", cond_bool), ", label %"), arm_label), ", label %"), next_arm_label), "\n"));
                          } else {
                              // Float comparison
                              var cond_f = "";
                              if (is_cond_ptr != 0.0) {
                                  let t1 = next_reg(self_ptr);
                                  let t2 = next_reg(self_ptr);
                                  cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", t1), " = ptrtoint ptr "), clean_cond), " to i64\n"));
                                  cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", t2), " = sitofp i64 "), t1), " to float\n"));
                                  cond_f = t2;
                              } else {
                                  cond_f = clean_cond;
                              }
                              
                              var pat_f = "";
                              if (is_pat_ptr != 0.0) {
                                  let t1 = next_reg(self_ptr);
                                  let t2 = next_reg(self_ptr);
                                  cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", t1), " = ptrtoint ptr "), clean_pat), " to i64\n"));
                                  cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", t2), " = sitofp i64 "), t1), " to float\n"));
                                  pat_f = t2;
                              } else {
                                  pat_f = clean_pat;
                              }
                              
                              let cond_bool = next_reg(self_ptr);
                              cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", cond_bool), " = fcmp oeq float "), cond_f), ", "), pat_f), "\n"));
                              cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  br i1 ", cond_bool), ", label %"), arm_label), ", label %"), next_arm_label), "\n"));
                          }
                    } else {
                        // Wildcard fallback
                        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  br label %", arm_label), "\n"));
                    }
                    
                    cartan_tree_push(self_ptr.output, cartan_string_concat(arm_label, ":\n"));
                    llvm_visit_stmt(self_ptr, body);
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  br label %", end_label), "\n"));
                    
                    cartan_tree_push(self_ptr.output, cartan_string_concat(next_arm_label, ":\n"));
                }
                
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  br label %", end_label), "\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(end_label, ":\n"));
            }
            if (disc == 17.0) {
                let condition = cartan_tree_get_f32(stmt, 1.0);
                let then_block = cartan_tree_get_f32(stmt, 2.0);
                let else_block = cartan_tree_get_f32(stmt, 3.0);

                let cond_reg = llvm_visit_expr(self_ptr, condition);
                let cond_bool = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", cond_bool), " = fcmp one double "), as_float(self_ptr, cond_reg)), ", 0.0\n"));
                
                let then_label = next_label(self_ptr, "then_");
                let else_label = next_label(self_ptr, "else_");
                let end_label = next_label(self_ptr, "end_");

                if (else_block != 0.0) {
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  br i1 ", cond_bool), ", label %"), then_label), ", label %"), else_label), "\n"));
                } else {
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  br i1 ", cond_bool), ", label %"), then_label), ", label %"), end_label), "\n"));
                }

                cartan_tree_push(self_ptr.output, cartan_string_concat(then_label, ":\n"));
                
                let then_stmts = cartan_tree_get_f32(then_block, 0.0);
                var idx_s = 0.0;
                while (idx_s < cartan_tree_len_f(then_stmts)) {
                    var s = cartan_tree_get_f32(then_stmts, idx_s);
                    idx_s = idx_s + 1.0; llvm_visit_stmt(self_ptr, s);
                }
                
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  br label %", end_label), "\n"));

                if (else_block != 0.0) {
                    cartan_tree_push(self_ptr.output, cartan_string_concat(else_label, ":\n"));
                    let else_stmts = cartan_tree_get_f32(else_block, 0.0);
                    var idx_e = 0.0;
                    while (idx_e < cartan_tree_len_f(else_stmts)) {
                        var s = cartan_tree_get_f32(else_stmts, idx_e);
                        idx_e = idx_e + 1.0; llvm_visit_stmt(self_ptr, s);
                    }
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  br label %", end_label), "\n"));
                }
                cartan_tree_push(self_ptr.output, cartan_string_concat(end_label, ":\n"));
            }
            if (disc == 18.0) {
                let condition = cartan_tree_get_f32(stmt, 1.0);
                let body = cartan_tree_get_f32(stmt, 2.0);

                let cond_label = next_label(self_ptr, "while_cond_");
                let body_label = next_label(self_ptr, "while_body_");
                let end_label = next_label(self_ptr, "while_end_");

                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  br label %", cond_label), "\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cond_label, ":\n"));

                let cond_reg = llvm_visit_expr(self_ptr, condition);
                let cond_bool = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", cond_bool), " = fcmp one double "), as_float(self_ptr, cond_reg)), ", 0.0\n"));
                
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  br i1 ", cond_bool), ", label %"), body_label), ", label %"), end_label), "\n"));

                cartan_tree_push(self_ptr.output, cartan_string_concat(body_label, ":\n"));
                
                let ll = cartan_tree_create();
                cartan_tree_push(ll, cond_label);
                cartan_tree_push(ll, end_label);
                cartan_tree_push(self_ptr.loop_labels, ll);
                
                let body_stmts = cartan_tree_get_f32(body, 0.0);
                var idx_s = 0.0;
                while (idx_s < cartan_tree_len_f(body_stmts)) {
                    var s = cartan_tree_get_f32(body_stmts, idx_s);
                    idx_s = idx_s + 1.0; llvm_visit_stmt(self_ptr, s);
                }
                
                // Pop the loop label
                let num_labels = cartan_tree_len_f(self_ptr.loop_labels);
                if (num_labels > 0.0) {
                    cartan_tree_remove(self_ptr.loop_labels, num_labels - 1.0);
                }

                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  br label %", cond_label), "\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(end_label, ":\n"));
            }
            if (disc == 24.0) {
                let expr = cartan_tree_get_f32(stmt, 1.0);
                if (expr != 0.0) {
                    let ret_val = llvm_visit_expr(self_ptr, expr);
                    if (self_ptr.current_return_type == "i64") {
                        var cond_i64 = cartan_string_starts_with(ret_val, "%");
                        if (cond_i64 != 0.0) {
                            if (cartan_string_contains(ret_val, ".") == 0.0) {
                                cond_i64 = 1.0;
                            } else {
                                cond_i64 = 0.0;
                            }
                        }
                        if (cond_i64 != 0.0) {
                            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ret i64 ", ret_val), "\n"));
                        } else {
                            let int_val = next_reg(self_ptr);
                            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", int_val), " = fptosi double "), as_float(self_ptr, ret_val)), " to i64\n"));
                            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ret i64 ", int_val), "\n"));
                        }
                    } else if (self_ptr.current_return_type == "double" || self_ptr.current_return_type == "float") {
                        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ret double ", as_float(self_ptr, ret_val)), "\n"));
                    } else if (self_ptr.current_return_type == "ptr") {
                        var cond_ptr = cartan_string_starts_with(ret_val, "ptr:");
                        if (cond_ptr == 0.0) { if (cartan_string_starts_with(ret_val, "string:") != 0.0) { cond_ptr = 1.0; } }
                        if (cond_ptr == 0.0) { if (cartan_string_starts_with(ret_val, "array:") != 0.0) { cond_ptr = 1.0; } }
                        if (cond_ptr == 0.0) { if (cartan_string_starts_with(ret_val, "struct:") != 0.0) { cond_ptr = 1.0; } }
                        if (cond_ptr == 0.0) { if (cartan_string_starts_with(ret_val, "tree<") != 0.0) { cond_ptr = 1.0; } }
                        if (cond_ptr != 0.0) {
                            let clean_r = clean_reg(ret_val);
                            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ret ptr ", clean_r), "\n"));
                        } else {
                            let int_val = next_reg(self_ptr);
                            let ptr_val = next_reg(self_ptr);
                            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", int_val), " = fptoui double "), as_float(self_ptr, ret_val)), " to i64\n"));
                            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", ptr_val), " = inttoptr i64 "), int_val), " to ptr\n"));
                            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ret ptr ", ptr_val), "\n"));
                        }
                    } else if (self_ptr.current_return_type == "void") {
                          cartan_tree_push(self_ptr.output, "  ret void\n");
                    } else {
                          cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ret ", self_ptr.current_return_type), " "), ret_val), "\n"));
                    }
                } else {
                    if (self_ptr.current_return_type == "i64") {
                        cartan_tree_push(self_ptr.output, "  ret i64 0\n");
                    } else if (self_ptr.current_return_type == "float") {
                        cartan_tree_push(self_ptr.output, "  ret float 0.0\n");
                    } else if (self_ptr.current_return_type == "void") {
                        cartan_tree_push(self_ptr.output, "  ret void\n");
                    } else {
                        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ret ", self_ptr.current_return_type), " null\n"));
                    }
                }
                let unreachable = next_label(self_ptr, "unreachable_");
                cartan_tree_push(self_ptr.output, cartan_string_concat(unreachable, ":\n"));
            }
            if (disc == 8.0) {

            } else if (disc == 10.0) {

                // Handled in Pass 0
            }
            if (disc == 88.0) {

                // Handled in Pass 2
            }
            if (disc == 86.0) {

                // Handled in Pass 2
            }
            if (disc == 3.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let is_mut = cartan_tree_get_f32(stmt, 2.0);
                let value = cartan_tree_get_f32(stmt, 3.0);
                let type_annotation = cartan_tree_get_f32(stmt, 4.0);

                let val_reg = llvm_visit_expr(self_ptr, value);
                
                var struct_override = "";
                var is_explicit_ptr = 0.0;
                if (type_annotation != 0.0) {
                    var ty_str = type_annotation;
                    var cond_ty = cartan_string_starts_with(ty_str, "ptr<");
                    if (cond_ty != 0.0) {
                        var inner = cartan_string_replace(cartan_string_replace(ty_str, "ptr<", ""), ">", "");
                        struct_override = cartan_string_concat("%", inner);
                    } else if (cartan_string_eq(ty_str, "ptr") != 0.0 || cartan_string_starts_with(ty_str, "tree<") != 0.0 || cartan_string_eq(ty_str, "string") != 0.0) {
                        is_explicit_ptr = 1.0;
                    }
                }
                
                var struct_name = struct_override; 
                if (struct_name != "") {
                    let raw_ptr = cartan_string_replace(cartan_string_replace(cartan_string_replace(cartan_string_replace(val_reg, "ptr:", ""), "struct:", ""), "array:", ""), "string:", "");
                    var real_reg = raw_ptr;
                    let ptr_reg = next_reg(self_ptr);
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", real_reg), ", ptr "), ptr_reg), ", align 8\n"));
                    cartan_dict_set(self_ptr.var_types, name, struct_name);
                    cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                } else if (is_explicit_ptr != 0.0) {
                    let raw_ptr = cartan_string_replace(cartan_string_replace(cartan_string_replace(cartan_string_replace(val_reg, "ptr:", ""), "struct:", ""), "array:", ""), "string:", "");
                    var real_reg = raw_ptr;
                    if (cartan_string_eq(real_reg, "0.0") != 0.0 || cartan_string_eq(real_reg, "0") != 0.0) {
                        real_reg = "null";
                    }
                    let ptr_reg = next_reg(self_ptr);
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", real_reg), ", ptr "), ptr_reg), ", align 8\n"));
                    cartan_dict_set(self_ptr.var_types, name, type_annotation);
                    cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                } else if (cartan_string_starts_with(val_reg, "struct:") != 0.0) {
                    var s_part = cartan_string_replace(val_reg, "struct:", "");
                    let clean_r = clean_reg(val_reg);
                    let struct_name = cartan_string_replace(s_part, cartan_string_concat(":", clean_r), "");
                    let ptr_reg = next_reg(self_ptr);
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", clean_r), ", ptr "), ptr_reg), ", align 8\n"));
                    cartan_dict_set(self_ptr.var_types, name, cartan_string_concat("%", struct_name));
                    cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                } else if (cartan_string_starts_with(val_reg, "array:") != 0.0) {
                    let raw_ptr = cartan_string_replace(val_reg, "array:", "");
                    let ptr_reg = next_reg(self_ptr);
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", raw_ptr), ", ptr "), ptr_reg), ", align 8\n"));
                    cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                    cartan_dict_set(self_ptr.var_types, name, "ptr");
                } else if (cartan_string_starts_with(val_reg, "string:") != 0.0) {
                      let raw_ptr = cartan_string_replace(val_reg, "string:", "");
                      let ptr_reg = next_reg(self_ptr);
                      cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                      cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", raw_ptr), ", ptr "), ptr_reg), ", align 8\n"));
                      cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                      cartan_dict_set(self_ptr.var_types, name, "string");
                } else if (cartan_string_starts_with(val_reg, "ptr:") != 0.0) {
                    let raw_ptr = cartan_string_replace(val_reg, "ptr:", "");
                    let ptr_reg = next_reg(self_ptr);
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", raw_ptr), ", ptr "), ptr_reg), ", align 8\n"));
                    cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                    
                    var inferred_type = "ptr";
                    if (cartan_string_eq(name, "expr") == 1.0) { inferred_type = "%Expr"; }
                    if (cartan_string_contains(name, "_expr") != 0.0) { inferred_type = "%Expr"; }
                    if (cartan_string_contains(name, "_node") != 0.0) { inferred_type = "ptr"; }
                    if (cartan_string_eq(name, "bin_op") == 1.0) { inferred_type = "%Expr"; }
                    if (cartan_string_eq(name, "mul_op") == 1.0) { inferred_type = "%Expr"; }
                    if (cartan_string_eq(name, "inner") == 1.0) { inferred_type = "%Expr"; }
                    if (cartan_string_eq(name, "inner_inner") == 1.0) { inferred_type = "%Expr"; }
                    if (cartan_string_eq(name, "child") == 1.0) { inferred_type = "%Expr"; }
                    if (cartan_string_eq(name, "optimized_child") == 1.0) { inferred_type = "%Expr"; }
                    if (cartan_string_eq(name, "stmt") == 1.0) { inferred_type = "%Stmt"; }
                    if (cartan_string_eq(name, "decl") == 1.0) { inferred_type = "%Stmt"; }
                    if (cartan_string_contains(name, "_stmt") != 0.0) { inferred_type = "%Stmt"; }
                    if (cartan_string_eq(name, "tok") == 1.0) { inferred_type = "%Token"; }
                    if (cartan_string_eq(name, "token") == 1.0) { inferred_type = "%Token"; }
                    if (cartan_string_eq(name, "path_tok") == 1.0) { inferred_type = "%Token"; }
                    if (cartan_string_eq(name, "current") == 1.0) { inferred_type = "%Token"; }
                    if (cartan_string_eq(name, "parser") == 1.0) { inferred_type = "%Parser"; }
                    if (cartan_string_eq(name, "lexer") == 1.0) { inferred_type = "%Lexer"; }
                    
                    cartan_dict_set(self_ptr.var_types, name, inferred_type);
                } else {
                    let ptr_reg = next_reg(self_ptr);
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca double, align 8\n"));
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store double ", as_float(self_ptr, val_reg)), ", ptr "), ptr_reg), ", align 8\n"));
                    cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                    cartan_dict_set(self_ptr.var_types, name, "double");
                }
            }
            if (disc == 1.0) {
                let expr = cartan_tree_get_f32(stmt, 1.0);
                llvm_visit_expr(self_ptr, expr);
            }
            if (disc == 96.0) {
                let alias = cartan_tree_get_f32(stmt, 1.0);
                let uri = cartan_tree_get_f32(stmt, 2.0);
                let uri_global = cartan_string_concat("@.str.model.uri.", cartan_int_to_string(self_ptr.string_counter));
                self_ptr.string_counter = self_ptr.string_counter + 1.0;
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(uri_global, " = private unnamed_addr constant ["), cartan_int_to_string(cartan_string_length(uri) + 1.0)), " x i8] c\""), uri), "\\00\", align 1\n"));
                let res_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res_reg), " = call ptr @cartan_internal_import_onnx(ptr "), uri_global), ")\n"));
                
                let ptr_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", res_reg), ", ptr "), ptr_reg), ", align 8\n"));
                cartan_dict_set(self_ptr.symbols, alias, ptr_reg);
                cartan_dict_set(self_ptr.var_types, alias, "ptr");
            }
            if (disc == 73.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let ptr_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                cartan_dict_set(self_ptr.var_types, name, "ptr");
            }
            if (disc == 98.0) {
                let body = cartan_tree_get_f32(stmt, 1.0);
                let stmts = cartan_tree_get_f32(body, 0.0);
                cartan_tree_push(self_ptr.output, "  ; JIT BLOCK BEGIN\n");
                let body_stmts = cartan_tree_get_f32(body, 0.0);
                var idx_s = 0.0;
                while (idx_s < cartan_tree_len_f(body_stmts)) {
                    var s = cartan_tree_get_f32(body_stmts, idx_s);
                    idx_s = idx_s + 1.0;
                    llvm_visit_stmt(self_ptr, s);
                }
                cartan_tree_push(self_ptr.output, "  ; JIT BLOCK END\n");
            }
            if (disc == 6.0 || disc == 12.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let shape = cartan_tree_get_f32(stmt, 2.0);
                let manifold_val = cartan_tree_get_f32(stmt, 3.0);
                let layout_val = cartan_tree_get_f32(stmt, 4.0);
                let location = cartan_tree_get_f32(stmt, 5.0);
                let backend = cartan_tree_get_f32(stmt, 6.0);
                let is_lazy = cartan_tree_get_f32(stmt, 7.0);
                let is_unified = cartan_tree_get_f32(stmt, 8.0);
                let is_latent = cartan_tree_get_f32(stmt, 9.0);

                let res_reg = next_reg(self_ptr);
                var alloc_func = "";
                if (is_latent != 0.0) {
                    alloc_func = "cartan_rt_alloc_tensor_latent";
                } else if (is_unified != 0.0) {
                    alloc_func = "cartan_rt_alloc_tensor_unified";
                } else if (is_lazy != 0.0) {
                    alloc_func = "cartan_rt_alloc_tensor_lazy";
                } else {
                    alloc_func = "cartan_tensor_alloc";
                }
                var alloc_nd_func = "";
                if (is_latent != 0.0) { alloc_nd_func = alloc_func; }
                else if (is_unified != 0.0) { alloc_nd_func = alloc_func; }
                else if (is_lazy != 0.0) { alloc_nd_func = alloc_func; }
                else { alloc_nd_func = "cartan_tensor_alloc_nd"; }

                let shape_len = cartan_tree_len_f(shape);
                var cond_shape = 0.0;
                if (shape_len > 1.0) { if (shape_len <= 4.0) { cond_shape = 1.0; } }
                if (cond_shape != 0.0) {
                    let dims = cartan_tree_create();
                    var idx = 0.0;
                    while (idx < 4.0) {
                        if (idx < shape_len) {
                            var dim = cartan_tree_get_f32(shape, idx);
                            let dim_disc = cartan_tree_get_f32(dim, 0.0);
                            if (dim_disc == 0.0) {
                                let val = cartan_tree_get_f32(dim, 1.0);
                                cartan_tree_push(dims, val);
                            } else {
                                cartan_tree_push(dims, 1.0);
                            }
                        } else {
                            cartan_tree_push(dims, 1.0);
                        }
                        idx = idx + 1.0;
                    }
                    if (alloc_nd_func == "cartan_tensor_alloc_nd") {
                        var s_alloc = cartan_string_concat("  ", res_reg);
                        s_alloc = cartan_string_concat(s_alloc, " = call ptr @");
                        s_alloc = cartan_string_concat(s_alloc, alloc_nd_func);
                        s_alloc = cartan_string_concat(s_alloc, "(double ");
                        s_alloc = cartan_string_concat(s_alloc, cartan_float_to_string(shape_len));
                        s_alloc = cartan_string_concat(s_alloc, ", double ");
                        s_alloc = cartan_string_concat(s_alloc, cartan_float_to_string(cartan_tree_get_f32(dims, 0.0)));
                        s_alloc = cartan_string_concat(s_alloc, ", double ");
                        s_alloc = cartan_string_concat(s_alloc, cartan_float_to_string(cartan_tree_get_f32(dims, 1.0)));
                        s_alloc = cartan_string_concat(s_alloc, ", double ");
                        s_alloc = cartan_string_concat(s_alloc, cartan_float_to_string(cartan_tree_get_f32(dims, 2.0)));
                        s_alloc = cartan_string_concat(s_alloc, ", double ");
                        s_alloc = cartan_string_concat(s_alloc, cartan_float_to_string(cartan_tree_get_f32(dims, 3.0)));
                        s_alloc = cartan_string_concat(s_alloc, ")\n");
                        cartan_tree_push(self_ptr.output, s_alloc);
                    } else {
                        let total_size = cartan_tree_get_f32(dims, 0.0) * cartan_tree_get_f32(dims, 1.0) * cartan_tree_get_f32(dims, 2.0) * cartan_tree_get_f32(dims, 3.0);
                        var s_alloc = cartan_string_concat("  ", res_reg);
                        s_alloc = cartan_string_concat(s_alloc, " = call ptr @");
                        s_alloc = cartan_string_concat(s_alloc, alloc_func);
                        s_alloc = cartan_string_concat(s_alloc, "(double ");
                        s_alloc = cartan_string_concat(s_alloc, cartan_float_to_string(total_size));
                        s_alloc = cartan_string_concat(s_alloc, ", double 0.0)\n");
                        cartan_tree_push(self_ptr.output, s_alloc);
                    }
                } else {
                    var size = 1.0;
                    if (shape_len == 1.0) {
                        let shapeptr = cartan_tree_get_f32(shape, 0.0);
                        let shapeptr_disc = cartan_tree_get_f32(shapeptr, 0.0); 
                        if (shapeptr_disc == 0.0) { 
                            size = cartan_tree_get_f32(shapeptr, 1.0);
                        }
                    }
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res_reg), " = call ptr @"), alloc_func), "(double "), size), ", double 0.0)\n"));
                }
                
                let ptr_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", res_reg), ", ptr "), ptr_reg), ", align 8\n"));
                cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                cartan_dict_set(self_ptr.var_types, name, "ptr");
            }
            if (disc == 8.0 || disc == 28.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let dim = cartan_tree_get_f32(stmt, 2.0);
                let location = cartan_tree_get_f32(stmt, 3.0);
                let backend = cartan_tree_get_f32(stmt, 4.0);

                var num_elems = 1.0;
                let dim_disc = cartan_tree_get_f32(dim, 0.0);
                if (dim_disc == 0.0) {
                    num_elems = cartan_tree_get_f32(dim, 1.0);
                }
                
                let res_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res_reg), " = call ptr @cartan_vector_alloc(double "), num_elems));
                cartan_tree_push(self_ptr.output, ")\n");
                let ptr_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", res_reg), ", ptr "), ptr_reg), ", align 8\n"));
                cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                cartan_dict_set(self_ptr.var_types, name, "ptr");
            }

            if (disc == 9.0 || disc == 32.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let max_len = cartan_tree_get_f32(stmt, 2.0);
                var size = 1.0;
                let max_len_disc = cartan_tree_get_f32(max_len, 0.0); if (max_len_disc == 0.0) { size = cartan_tree_get_f32(max_len, 1.0); }
                let res_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res_reg), " = call ptr @cartan_alloc_sequence(double "), size), ")\n"));
                let ptr_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", res_reg), ", ptr "), ptr_reg), ", align 8\n"));
                cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                cartan_dict_set(self_ptr.var_types, name, "ptr");
            }
            if (disc == 10.0 || disc == 34.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let block_size = cartan_tree_get_f32(stmt, 2.0);
                var size = 1.0;
                let block_size_disc = cartan_tree_get_f32(block_size, 0.0); if (block_size_disc == 0.0) { size = cartan_tree_get_f32(block_size, 1.0); }
                let res_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res_reg), " = call ptr @cartan_alloc_block(double "), size), ")\n"));
                let ptr_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", res_reg), ", ptr "), ptr_reg), ", align 8\n"));
                cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                cartan_dict_set(self_ptr.var_types, name, "ptr");
            }
            if (disc == 11.0 || disc == 36.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let dim = cartan_tree_get_f32(stmt, 3.0);
                var size = 1.0;
                let dim_disc = cartan_tree_get_f32(dim, 0.0); if (dim_disc == 0.0) { size = cartan_tree_get_f32(dim, 1.0); }
                let res_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res_reg), " = call ptr @cartan_rt_alloc_lattice(double 0.0, double "), size), ")\n"));
                let ptr_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", res_reg), ", ptr "), ptr_reg), ", align 8\n"));
                cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                cartan_dict_set(self_ptr.var_types, name, "ptr");
            }
            if (disc == 12.0 || disc == 39.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let res_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", res_reg), " = call ptr @cartan_rt_alloc_tree(double 0.0)\n"));
                let ptr_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", res_reg), ", ptr "), ptr_reg), ", align 8\n"));
                cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                cartan_dict_set(self_ptr.var_types, name, "ptr");
            }
            if (disc == 7.0 || disc == 21.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let shape = cartan_tree_get_f32(stmt, 2.0);
                let manifold_val = cartan_tree_get_f32(stmt, 3.0);
                let optimizer = cartan_tree_get_f32(stmt, 7.0);

                var alloc_fn = "cartan_tensor_alloc";
                var alloc_nd_fn = "cartan_tensor_alloc_nd";
                if (optimizer == 1.0) {
                    alloc_fn = "cartan_alloc_parameter_adam";
                    alloc_nd_fn = "cartan_alloc_parameter_adam_nd";
                }
                
                let res_reg = next_reg(self_ptr);
                let shape_len = cartan_tree_len_f(shape);
                var cond_shape = 0.0;
                if (shape_len > 1.0) { if (shape_len <= 4.0) { cond_shape = 1.0; } }
                if (cond_shape != 0.0) {
                    let dims = cartan_tree_create();
                    cartan_tree_push(dims, 1.0); cartan_tree_push(dims, 1.0); cartan_tree_push(dims, 1.0); cartan_tree_push(dims, 1.0);
                    var i = 0.0;
                    while (i < shape_len) {
                        var dim = cartan_tree_get_f32(shape, i);
                        let dim_disc = cartan_tree_get_f32(dim, 0.0);
                        if (dim_disc == 0.0) {
                            let val = cartan_tree_get_f32(dim, 1.0);
                            cartan_tree_set(dims, i, val);
                        }
                        i = i + 1.0;
                    }
                    var s_alloc = cartan_string_concat("  ", res_reg);
                    s_alloc = cartan_string_concat(s_alloc, " = call ptr @");
                    s_alloc = cartan_string_concat(s_alloc, alloc_nd_fn);
                    s_alloc = cartan_string_concat(s_alloc, "(float ");
                    s_alloc = cartan_string_concat(s_alloc, cartan_float_to_string(shape_len));
                    s_alloc = cartan_string_concat(s_alloc, ", float ");
                    s_alloc = cartan_string_concat(s_alloc, cartan_float_to_string(cartan_tree_get_f32(dims, 0.0)));
                    s_alloc = cartan_string_concat(s_alloc, ", float ");
                    s_alloc = cartan_string_concat(s_alloc, cartan_float_to_string(cartan_tree_get_f32(dims, 1.0)));
                    s_alloc = cartan_string_concat(s_alloc, ", float ");
                    s_alloc = cartan_string_concat(s_alloc, cartan_float_to_string(cartan_tree_get_f32(dims, 2.0)));
                    s_alloc = cartan_string_concat(s_alloc, ", float ");
                    s_alloc = cartan_string_concat(s_alloc, cartan_float_to_string(cartan_tree_get_f32(dims, 3.0)));
                    s_alloc = cartan_string_concat(s_alloc, ")\n");
                    cartan_tree_push(self_ptr.output, s_alloc);
                } else {
                    var num_elems = 1.0;
                    var idx_dim = 0.0;
                    while (idx_dim < shape_len) {
                        var dim = cartan_tree_get_f32(shape, idx_dim);
                        let dim_disc = cartan_tree_get_f32(dim, 0.0);
                        if (dim_disc == 0.0) {
                            let val = cartan_tree_get_f32(dim, 1.0);
                            num_elems = num_elems * val;
                        }
                        idx_dim = idx_dim + 1.0;
                    }
                    var s_alloc = cartan_string_concat("  ", res_reg);
                    s_alloc = cartan_string_concat(s_alloc, " = call ptr @");
                    s_alloc = cartan_string_concat(s_alloc, alloc_fn);
                    s_alloc = cartan_string_concat(s_alloc, "(float ");
                    s_alloc = cartan_string_concat(s_alloc, cartan_float_to_string(num_elems));
                    s_alloc = cartan_string_concat(s_alloc, ")\n");
                    cartan_tree_push(self_ptr.output, s_alloc);
                }
                
                let ptr_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = alloca ptr, align 8\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", res_reg), ", ptr "), ptr_reg), ", align 8\n"));
                cartan_dict_set(self_ptr.symbols, name, ptr_reg);
                cartan_dict_set(self_ptr.var_types, name, "ptr");
                cartan_dict_set(self_ptr.var_manifolds, name, manifold_val);
            }
            if (disc == 22.0 || disc == 66.0) {
                let donor_path = cartan_tree_get_f32(stmt, 1.0);
                let local_tensor = cartan_tree_get_f32(stmt, 2.0);
                let id = self_ptr.string_counter;
                self_ptr.string_counter = self_ptr.string_counter + 1.0;
                
                let c_str = cartan_string_concat(cartan_string_concat(cartan_string_concat("c\"", donor_path), "\\00\""), ", align 1\n");
                let global_name = cartan_string_concat("@.str.donor.", cartan_int_to_string(id));
                let len_str = cartan_int_to_string(cartan_string_length(donor_path) + 1.0);
                cartan_tree_push(self_ptr.globals, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(global_name, " = private unnamed_addr constant ["), len_str), " x i8] "), c_str));
                
                let tensor_ptr = cartan_dict_get(self_ptr.symbols, local_tensor); 
                if (tensor_ptr != 0.0) {
                    let val_reg = next_reg(self_ptr);
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_reg), " = load ptr, ptr "), tensor_ptr), ", align 8\n"));
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  call void @cartan_absorb_weights(ptr ", global_name), ", ptr "), val_reg), ")\n"));
                }
            }
            if (disc == 23.0) { // ProjectVocabStmt
                let source_tensor = cartan_tree_get_f32(stmt, 1.0);
                let target_vocab = cartan_tree_get_f32(stmt, 2.0);
                let src_ptr = cartan_dict_get(self_ptr.symbols, source_tensor);
                let tgt_ptr = cartan_dict_get(self_ptr.symbols, target_vocab);
                if (src_ptr != 0.0) { if (tgt_ptr != 0.0) {
                    let val_src = next_reg(self_ptr);
                    let val_tgt = next_reg(self_ptr);
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_src), " = load ptr, ptr "), src_ptr), ", align 8\n"));
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_tgt), " = load ptr, ptr "), tgt_ptr), ", align 8\n"));
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  call void @cartan_project_vocab(ptr ", val_src), ", ptr "), val_tgt), ")\n"));
                }}
            }
            if (disc == 20.0 || disc == 62.0) {
                let try_block = cartan_tree_get_f32(stmt, 1.0);
                let try_stmts = cartan_tree_get_f32(try_block, 0.0);
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(try_stmts)) {
                    var b_stmt = cartan_tree_get_f32(try_stmts, idx_stmt);
                    llvm_visit_stmt(self_ptr, b_stmt);
                    idx_stmt = idx_stmt + 1.0;
                }
            }
            if (disc == 43.0 || disc == 103.0) {
                let block_val = cartan_tree_get_f32(stmt, 1.0);
                cartan_tree_push(self_ptr.output, "  ; Begin Async Compute Block\n");
                let block_stmts = cartan_tree_get_f32(block_val, 0.0);
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(block_stmts)) {
                    var b_stmt = cartan_tree_get_f32(block_stmts, idx_stmt);
                    llvm_visit_stmt(self_ptr, b_stmt);
                    idx_stmt = idx_stmt + 1.0;
                }
                cartan_tree_push(self_ptr.output, "  ; End Async Compute Block\n");
            }
            if (disc == 44.0 || disc == 104.0) {
                let expr = cartan_tree_get_f32(stmt, 1.0);
                cartan_tree_push(self_ptr.output, "  ; --- Begin Backward Pass ---\n");
                let loss_reg = llvm_visit_expr(self_ptr, expr);
                
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  call void @cartan_tensor_backward(ptr ", loss_reg), ")\n"));
                cartan_tree_push(self_ptr.output, "  call void @cartan_tensor_step(double 0.01)\n");
                cartan_tree_push(self_ptr.output, "  call void @cartan_free_compute_graph()\n");
                cartan_tree_push(self_ptr.output, "  ; --- End Backward Pass ---\n");
            }
            if (disc == 59.0 || disc == 123.0) {
                let primary_type = cartan_tree_get_f32(stmt, 1.0);
                let fallback_type = cartan_tree_get_f32(stmt, 2.0);
                let block_val = cartan_tree_get_f32(stmt, 3.0);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ; --- Fluid Precision: primary=", primary_type), ", fallback="), fallback_type), " ---\n"));
                cartan_tree_push(self_ptr.output, "  call void @cartan_fluid_precision_start(ptr null, ptr null)\n");
                let block_stmts = cartan_tree_get_f32(block_val, 0.0);
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(block_stmts)) {
                    var b_stmt = cartan_tree_get_f32(block_stmts, idx_stmt);
                    llvm_visit_stmt(self_ptr, b_stmt);
                    idx_stmt = idx_stmt + 1.0;
                }
                cartan_tree_push(self_ptr.output, "  call void @cartan_fluid_precision_end()\n");
            }
            if (disc == 60.0 || disc == 124.0) {
                let block_size = cartan_tree_get_f32(stmt, 1.0);
                let density = cartan_tree_get_f32(stmt, 2.0);
                let block_val = cartan_tree_get_f32(stmt, 3.0);
                cartan_tree_push(self_ptr.output, "  ; --- Sparsity Block ---\n");
                let bs_reg = llvm_visit_expr(self_ptr, block_size);
                let den_reg = llvm_visit_expr(self_ptr, density);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  call void @cartan_sparsity_start(double ", bs_reg), ", double "), den_reg), ")\n"));
                let block_stmts = cartan_tree_get_f32(block_val, 0.0);
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(block_stmts)) {
                    var b_stmt = cartan_tree_get_f32(block_stmts, idx_stmt);
                    llvm_visit_stmt(self_ptr, b_stmt);
                    idx_stmt = idx_stmt + 1.0;
                }
                cartan_tree_push(self_ptr.output, "  call void @cartan_sparsity_end()\n");
            }
            if (disc == 61.0 || disc == 125.0) {

                let expr = cartan_tree_get_f32(stmt, 1.0);

                cartan_tree_push(self_ptr.output, "  ; --- Prune Graph ---\n");
                let thr_reg = llvm_visit_expr(self_ptr, expr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  call void @cartan_prune_graph(double ", thr_reg), ")\n"));
            }
            if (disc == 62.0 || disc == 126.0) {
                let intensity = cartan_tree_get_f32(stmt, 1.0);
                cartan_tree_push(self_ptr.output, "  ; --- Emit Spike ---\n");
                let int_reg = llvm_visit_expr(self_ptr, intensity);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  call void @cartan_emit_spike(double ", int_reg), ")\n"));
            }
            if (disc == 44.0) {

                // Handled in a separate pass
            }
            if (disc == 15.0 || disc == 48.0) {

                // Handled in Pass 1
            }
            if (disc == 36.0 || disc == 99.0) {
                let block_val = cartan_tree_get_f32(stmt, 1.0);
                let block_stmts = cartan_tree_get_f32(block_val, 0.0);
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(block_stmts)) {
                    var b_stmt = cartan_tree_get_f32(block_stmts, idx_stmt);
                    llvm_visit_stmt(self_ptr, b_stmt);
                    idx_stmt = idx_stmt + 1.0;
                }
            }
            if (disc == 25.0) { // BreakStmt
                let num_labels = cartan_tree_len_f(self_ptr.loop_labels);
                if (num_labels > 0.0) {
                    let last_pair = cartan_tree_get_f32(self_ptr.loop_labels, num_labels - 1.0);
                    let end_label = cartan_tree_get_f32(last_pair, 1.0);
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  br label %", end_label), "\n"));
                    let unreachable = next_label(self_ptr, "unreachable_");
                    cartan_tree_push(self_ptr.output, cartan_string_concat(unreachable, ":\n"));
                }
            }
            if (disc == 56.0 || disc == 119.0) {
                let condition = cartan_tree_get_f32(stmt, 1.0);
                let body = cartan_tree_get_f32(stmt, 2.0);
                let oth_val = cartan_tree_get_f32(stmt, 3.0);
                
                let start_label = next_label(self_ptr, "satisfy_start_");
                let end_label = next_label(self_ptr, "satisfy_end_");
                let otherwise_label = next_label(self_ptr, "satisfy_otherwise_");

                let ll = cartan_tree_create();
                cartan_tree_push(ll, start_label);
                cartan_tree_push(ll, end_label);
                cartan_tree_push(self_ptr.loop_labels, ll);

                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  br label %", start_label), "\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(start_label, ":\n"));

                let body_stmts = cartan_tree_get_f32(body, 0.0);
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(body_stmts)) {
                    var b_stmt = cartan_tree_get_f32(body_stmts, idx_stmt);
                    llvm_visit_stmt(self_ptr, b_stmt);
                    idx_stmt = idx_stmt + 1.0;
                }
                
                let cond_reg = llvm_visit_expr(self_ptr, condition);
                let is_1_0 = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", is_1_0), " = fcmp une double "), as_float(self_ptr, cond_reg)), ", 0.0\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  br i1 ", is_1_0), ", label %"), end_label), ", label %"), otherwise_label), "\n"));

                cartan_tree_push(self_ptr.output, cartan_string_concat(otherwise_label, ":\n"));
                if (oth_val != 0.0) {
                    let oth_stmts = cartan_tree_get_f32(oth_val, 0.0);
                    var idx_oth = 0.0;
                    while (idx_oth < cartan_tree_len_f(oth_stmts)) {
                        var o_stmt = cartan_tree_get_f32(oth_stmts, idx_oth);
                        llvm_visit_stmt(self_ptr, o_stmt);
                        idx_oth = idx_oth + 1.0;
                    }
                }
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  br label %", start_label), "\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(end_label, ":\n"));

                let num_labels = cartan_tree_len_f(self_ptr.loop_labels);
                if (num_labels > 0.0) { cartan_tree_remove(self_ptr.loop_labels, num_labels - 1.0); }
            }
            if (disc == 57.0 || disc == 120.0) {
                let num_labels = cartan_tree_len_f(self_ptr.loop_labels);
                if (num_labels > 0.0) {
                    let last_pair = cartan_tree_get_f32(self_ptr.loop_labels, num_labels - 1.0);
                    let cond_label = cartan_tree_get_f32(last_pair, 0.0);
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  br label %", cond_label), "\n"));
                    let unreachable = next_label(self_ptr, "unreachable_");
                    cartan_tree_push(self_ptr.output, cartan_string_concat(unreachable, ":\n"));
                }
            }
            if (disc == 26.0) { // ContinueStmt
                let num_labels = cartan_tree_len_f(self_ptr.loop_labels);
                if (num_labels > 0.0) {
                    let last_pair = cartan_tree_get_f32(self_ptr.loop_labels, num_labels - 1.0);
                    let cond_label = cartan_tree_get_f32(last_pair, 0.0);
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  br label %", cond_label), "\n"));
                    let unreachable = next_label(self_ptr, "unreachable_");
                    cartan_tree_push(self_ptr.output, cartan_string_concat(unreachable, ":\n"));
                }
            }
            if (disc == 47.0 || disc == 109.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let strategy = cartan_tree_get_f32(stmt, 2.0);
                let body = cartan_tree_get_f32(stmt, 3.0);
                let stmts = cartan_tree_get_f32(body, 0.0);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ; --- Begin Mesh Block: ", name), " (Supervisor: "), strategy), ") ---\n"));
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(stmts)) {
                    var s_stmt = cartan_tree_get_f32(stmts, idx_stmt);
                    idx_stmt = idx_stmt + 1.0;
                    llvm_visit_stmt(self_ptr, s_stmt);
                }
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ; --- End Mesh Block: ", name), " ---\n"));
            }
            if (disc == 48.0 || disc == 111.0) {
                let body = cartan_tree_get_f32(stmt, 1.0);
                let stmts = cartan_tree_get_f32(body, 0.0);
                cartan_tree_push(self_ptr.output, "  ; --- Begin Multimodal Sync Block ---\n");
                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_multimodal_sync_start()\n");
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(stmts)) {
                    var s_stmt = cartan_tree_get_f32(stmts, idx_stmt);
                    idx_stmt = idx_stmt + 1.0;
                    llvm_visit_stmt(self_ptr, s_stmt);
                }
                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_multimodal_sync_end()\n");
                cartan_tree_push(self_ptr.output, "  ; --- End Multimodal Sync Block ---\n");
            }
            if (disc == 49.0 || disc == 112.0) {
                let body = cartan_tree_get_f32(stmt, 1.0);
                let stmts = cartan_tree_get_f32(body, 0.0);

                cartan_tree_push(self_ptr.output, "  ; --- Begin Vmap Block ---\n");
                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_vmap_begin()\n");
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(stmts)) {
                    var s_stmt = cartan_tree_get_f32(stmts, idx_stmt);
                    idx_stmt = idx_stmt + 1.0;
                    llvm_visit_stmt(self_ptr, s_stmt);
                }
                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_vmap_end()\n");
                cartan_tree_push(self_ptr.output, "  ; --- End Vmap Block ---\n");
            }
            if (disc == 50.0 || disc == 113.0) {
                let body = cartan_tree_get_f32(stmt, 1.0);
                let stmts = cartan_tree_get_f32(body, 0.0);

                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_doubt_begin()\n");
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(stmts)) {
                    var s_stmt = cartan_tree_get_f32(stmts, idx_stmt);
                    idx_stmt = idx_stmt + 1.0;
                    llvm_visit_stmt(self_ptr, s_stmt);
                }
                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_doubt_end()\n");
            }
            if (disc == 51.0 || disc == 114.0) {
                let body = cartan_tree_get_f32(stmt, 1.0);
                let stmts = cartan_tree_get_f32(body, 0.0);

                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_chain_begin()\n");
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(stmts)) {
                    var s_stmt = cartan_tree_get_f32(stmts, idx_stmt);
                    idx_stmt = idx_stmt + 1.0;
                    llvm_visit_stmt(self_ptr, s_stmt);
                }
                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_chain_end()\n");
            }
            if (disc == 52.0 || disc == 115.0) {
                let body = cartan_tree_get_f32(stmt, 1.0);
                let stmts = cartan_tree_get_f32(body, 0.0);

                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_route_begin()\n");
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(stmts)) {
                    var s_stmt = cartan_tree_get_f32(stmts, idx_stmt);
                    idx_stmt = idx_stmt + 1.0;
                    llvm_visit_stmt(self_ptr, s_stmt);
                }
                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_route_end()\n");
            }
            if (disc == 53.0 || disc == 116.0) {
                let body = cartan_tree_get_f32(stmt, 1.0);
                let stmts = cartan_tree_get_f32(body, 0.0);

                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_grok_begin()\n");
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(stmts)) {
                    var s_stmt = cartan_tree_get_f32(stmts, idx_stmt);
                    idx_stmt = idx_stmt + 1.0;
                    llvm_visit_stmt(self_ptr, s_stmt);
                }
                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_grok_end()\n");
            }
            if (disc == 54.0 || disc == 117.0) {
                let body = cartan_tree_get_f32(stmt, 1.0);
                let stmts = cartan_tree_get_f32(body, 0.0);

                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_override_begin()\n");
                var idx_stmt = 0.0;
                while (idx_stmt < cartan_tree_len_f(stmts)) {
                    var s_stmt = cartan_tree_get_f32(stmts, idx_stmt);
                    idx_stmt = idx_stmt + 1.0;
                    llvm_visit_stmt(self_ptr, s_stmt);
                }
                cartan_tree_push(self_ptr.output, "  call void @cartan_rt_override_end()\n");
            }
            if (disc == 55.0 || disc == 118.0) {
                let func = cartan_tree_get_f32(stmt, 1.0);
                let f_decl = cartan_tree_create();
                cartan_tree_push(f_decl, 44.0);
                cartan_tree_push(f_decl, func);
                llvm_visit_stmt(self_ptr, f_decl);
            }
        }

    fn match_fused_linear_relu(self_ptr: LLVMGenerator, expr: ptr) -> ptr {
        var inner = cartan_tree_create();
        let disc = cartan_tree_get_f32(expr, 0.0);
        if (disc == 29.0) {
            let object = cartan_tree_get_f32(expr, 1.0);
            let method_name = cartan_tree_get_f32(expr, 2.0);
            if ((cartan_string_eq(method_name, "relu") != 0.0) || (cartan_string_eq(method_name, "relu_euclidean") != 0.0)) {
                inner = object;
            } else {}
        } else if (disc == 27.0) {
            let name = cartan_tree_get_f32(expr, 1.0);
            let args = cartan_tree_get_f32(expr, 2.0);
            if ((cartan_string_eq(name, "relu") != 0.0) || (cartan_string_eq(name, "Cartan.relu") != 0.0) || (cartan_string_eq(name, "relu_euclidean") != 0.0)) {
                if (cartan_tree_len_f(args) == 1.0) {
                    inner = cartan_tree_get_f32(args, 0.0);
                } else {}
            } else {}
        } else {}

        if (inner != 0.0) {
            let inner_disc = cartan_tree_get_f32(inner, 0.0);
            if (inner_disc == 24.0) {
                let left = cartan_tree_get_f32(inner, 1.0);
                let op = cartan_tree_get_f32(inner, 2.0);
                let right = cartan_tree_get_f32(inner, 3.0);
                if (cartan_string_eq(op, "+") != 0.0) {
                    let left_disc = cartan_tree_get_f32(left, 0.0);
                    if (left_disc == 24.0) {
                        let a = cartan_tree_get_f32(left, 1.0);
                        let op_mul = cartan_tree_get_f32(left, 2.0);
                        let b = cartan_tree_get_f32(left, 3.0);
                        if (cartan_string_eq(op_mul, "*") != 0.0) {
                            let a_reg = llvm_visit_expr(self_ptr, a);
                            let b_reg = llvm_visit_expr(self_ptr, b);
                            let c_reg = llvm_visit_expr(self_ptr, right);
                            let res_reg = next_reg(self_ptr);

                            var clean_a = cartan_string_replace(a_reg, "ptr:", "");
                            clean_a = cartan_string_replace(clean_a, "string:", "");
                            clean_a = cartan_string_replace(clean_a, "array:", "");
                            clean_a = cartan_string_replace(clean_a, "struct:", "");

                            var clean_b = cartan_string_replace(b_reg, "ptr:", "");
                            clean_b = cartan_string_replace(clean_b, "string:", "");
                            clean_b = cartan_string_replace(clean_b, "array:", "");
                            clean_b = cartan_string_replace(clean_b, "struct:", "");

                            var clean_c = cartan_string_replace(c_reg, "ptr:", "");
                            clean_c = cartan_string_replace(clean_c, "string:", "");
                            clean_c = cartan_string_replace(clean_c, "array:", "");
                            clean_c = cartan_string_replace(clean_c, "struct:", "");

                            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res_reg), " = call ptr @cartan_tensor_linear_relu(ptr "), clean_a), ", ptr "), clean_b), ", ptr "), clean_c), ")\n"));
                            return cartan_string_concat("ptr:", res_reg);
                        } else {}
                    } else {}
                } else {}
            } else {}
        } else {}
        return 0.0;
    }

    fn llvm_visit_expr(self_ptr: LLVMGenerator, expr: ptr) -> ptr {
        if (expr == 0.0) {
            return "0.0";
        }
        let disc = expr[0];
        if (disc == 0.0) {
            let i_val = expr[1];
            return cartan_int_to_string(i_val);
        }
        if (disc == 1.0) {
            let f_val = expr[1];
            let raw_s = cartan_float_to_string(f_val);
            if (cartan_string_contains(raw_s, "e") != 0.0 && cartan_string_contains(raw_s, ".") == 0.0) {
                return cartan_string_replace(raw_s, "e", ".0e");
            }
            if (cartan_string_contains(raw_s, "E") != 0.0 && cartan_string_contains(raw_s, ".") == 0.0) {
                return cartan_string_replace(raw_s, "E", ".0E");
            }
            return raw_s;
        }
        if (disc == 2.0) {
            let b_val = cartan_tree_get_f32(expr, 1.0);
            if (b_val != 0.0) { return "1.0"; } else { return "0.0"; }
        }
        if (disc == 3.0 || disc == 67.0) {
            let s = cartan_tree_get_f32(expr, 1.0);
            let id = self_ptr.string_counter;
            self_ptr.string_counter = self_ptr.string_counter + 1.0;
            let str_label = cartan_string_concat("@.str.", cartan_int_to_string(id));
            let global_decl = cartan_llvm_format_string_literal(s, id);
            cartan_tree_push(self_ptr.globals, global_decl);
            return cartan_string_concat("string:", str_label);
        }
        if (disc == 6.0 || disc == 70.0) {
            let name = cartan_tree_get_f32(expr, 1.0);
            let ptr_reg = cartan_dict_get(self_ptr.symbols, name);
            if (ptr_reg != 0.0) {
                if (cartan_string_starts_with(ptr_reg, "@.str.") != 0.0) {
                    return cartan_string_concat("string:", ptr_reg);
                }
                let val_reg = next_reg(self_ptr);
                var t = cartan_dict_get(self_ptr.var_types, name);
                if (t == 0.0) {
                    t = "double";
                } else if (t == "float") {
                    t = "double";
                }

                if (cartan_string_starts_with(t, "%") != 0.0) {
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_reg), " = load ptr, ptr "), ptr_reg), ", align 8\n"));
                    let clean_t = cartan_string_replace(t, "%", "");
                    return cartan_string_concat(cartan_string_concat(cartan_string_concat("struct:", clean_t), ":"), val_reg);
                } else if ((cartan_string_eq(t, "ptr") != 0.0) || (cartan_string_eq(t, "string") != 0.0) || (cartan_string_starts_with(t, "tree<") != 0.0) || (cartan_string_starts_with(t, "array:") != 0.0)) {
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_reg), " = load ptr, ptr "), ptr_reg), ", align 8\n"));
                    return cartan_string_concat(cartan_string_concat(t, ":"), val_reg);
                } else {
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", val_reg), " = load "), t), ", ptr "), ptr_reg), ", align 8\n"));
                    return val_reg;
                }
            } else {
                let curr_struct = self_ptr.current_struct;
                if (curr_struct != 0.0) {
                    let fields = cartan_dict_get(self_ptr.struct_fields, curr_struct);
                    if (fields != 0.0) {
                        if (cartan_tree_has(fields, name) != 0.0) {
                            let prop_node = cartan_tree_create();
                            cartan_tree_push(prop_node, 34.0);
                            let self_node = cartan_tree_create();
                            cartan_tree_push(self_node, 6.0);
                            cartan_tree_push(self_node, "self");
                            cartan_tree_push(prop_node, self_node);
                            cartan_tree_push(prop_node, name);
                            return llvm_visit_expr(self_ptr, prop_node);
                        } else {}
                    } else {}
                } else {}
                return "0.0";
            }
        }
        if (disc == 8.0) {
            let enum_name = cartan_tree_get_f32(expr, 1.0);
            let variant_name = cartan_tree_get_f32(expr, 2.0);
            let args = cartan_tree_get_f32(expr, 3.0);
            
            var tag_str = "0.0";
            let v_map = cartan_dict_get(self_ptr.enum_variants, enum_name);
            if (v_map != 0.0) {
                var scan_v = 0.0;
                while (scan_v < cartan_tree_len_f(v_map)) {
                    let pair = cartan_tree_get_f32(v_map, scan_v);
                    let vn = cartan_tree_get_f32(pair, 0.0);
                    if (cartan_string_eq(vn, variant_name) != 0.0) {
                        tag_str = cartan_tree_get_f32(pair, 1.0);
                        break;
                    }
                    scan_v = scan_v + 1.0;
                }
            }
            
            let num_fields = cartan_tree_len_f(args);
            let total_size = (num_fields + 1.0) * 8.0;
            let mem_reg = next_reg(self_ptr);
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", mem_reg), " = call ptr @malloc(i64 "), cartan_int_to_string(total_size)), ")\n"));
            
            // Store tag
            let tag_ptr = mem_reg;
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store double ", tag_str), ", ptr "), tag_ptr), ", align 8\n"));
            
            // Store fields
            var idx_a = 0.0;
            while (idx_a < num_fields) {
                let arg = cartan_tree_get_f32(args, idx_a);
                let field_reg_typed = llvm_visit_expr(self_ptr, arg);
                let clean_f = clean_reg(field_reg_typed);
                
                var field_val = clean_f;
                var is_f_ptr = 0.0;
                if (cartan_string_starts_with(field_reg_typed, "ptr:") != 0.0) { is_f_ptr = 1.0; }
                if (cartan_string_starts_with(field_reg_typed, "string:") != 0.0) { is_f_ptr = 1.0; }
                if (cartan_string_starts_with(field_reg_typed, "array:") != 0.0) { is_f_ptr = 1.0; }
                if (cartan_string_starts_with(field_reg_typed, "struct:") != 0.0) { is_f_ptr = 1.0; }
                
                let field_ptr_reg = next_reg(self_ptr);
                let offset_str = cartan_int_to_string(idx_a + 1.0);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", field_ptr_reg), " = getelementptr inbounds [100 x double], ptr "), mem_reg), ", i32 0, i32 "), offset_str), "\n"));
                if (is_f_ptr != 0.0) {
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store ptr ", clean_f), ", ptr "), field_ptr_reg), ", align 8\n"));
                } else if (cartan_string_eq(clean_f, "null") != 0.0) {
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  store ptr null, ptr "), field_ptr_reg), ", align 8\n");
                } else {
                    cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store double ", as_float(self_ptr, clean_f)), ", ptr "), field_ptr_reg), ", align 8\n"));
                }
                idx_a = idx_a + 1.0;
            }
            return cartan_string_concat("ptr:", mem_reg);
        }
        if (disc == 14.0) {
            let s_name = cartan_tree_get_f32(expr, 1.0);
            let s_fields = cartan_tree_get_f32(expr, 2.0);
            let size_ptr = next_reg(self_ptr);
            let size_int = next_reg(self_ptr);
            let struct_ptr = next_reg(self_ptr);
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", size_ptr), " = getelementptr %"), s_name), ", ptr null, i32 1\n"));
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", size_int), " = ptrtoint ptr "), size_ptr), " to i64\n"));
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", struct_ptr), " = call ptr @malloc(i64 "), size_int), ")\n"));
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store %", s_name), " zeroinitializer, ptr "), struct_ptr), ", align 8\n"));
            
            let field_names = cartan_dict_get(self_ptr.struct_fields, s_name);
            let field_types = cartan_dict_get(self_ptr.struct_field_types, s_name);
            if (field_names != 0.0 && s_fields != 0.0) {
                var idx_f = 0.0;
                while (idx_f < cartan_tree_len_f(s_fields)) {
                    let f_pair = cartan_tree_get_f32(s_fields, idx_f);
                    let f_name = cartan_tree_get_f32(f_pair, 0.0);
                    let f_expr = cartan_tree_get_f32(f_pair, 1.0);
                    let val_reg = llvm_visit_expr(self_ptr, f_expr);
                    
                    var f_idx = -1.0;
                    var scan_i = 0.0;
                    while (scan_i < cartan_tree_len_f(field_names)) {
                        let fn_cand = cartan_tree_get_f32(field_names, scan_i);
                        if (cartan_string_eq(fn_cand, f_name) != 0.0) {
                            f_idx = scan_i;
                            break;
                        }
                        scan_i = scan_i + 1.0;
                    }
                    
                    if (f_idx >= 0.0) {
                        let elem_ptr = next_reg(self_ptr);
                        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", elem_ptr), " = getelementptr inbounds %"), s_name), ", ptr "), struct_ptr), ", i32 0, i32 "), cartan_int_to_string(f_idx)), "\n"));
                        
                        var ftype = "double";
                        if (field_types != 0.0 && f_idx < cartan_tree_len_f(field_types)) {
                            ftype = cartan_tree_get_f32(field_types, f_idx);
                        }
                        
                        if (ftype == "float" || ftype == "double") {
                            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store double ", as_float(self_ptr, val_reg)), ", ptr "), elem_ptr), ", align 8\n"));
                        } else {
                            let clean_val = clean_reg(val_reg);
                            var final_val = clean_val;
                            if (cartan_string_eq(clean_val, "0.0") != 0.0) {
                                final_val = "null";
                            } else if (cartan_string_starts_with(val_reg, "ptr:") == 0.0 && cartan_string_starts_with(val_reg, "string:") == 0.0 && cartan_string_starts_with(val_reg, "struct:") == 0.0 && cartan_string_starts_with(val_reg, "array:") == 0.0) {
                                let int_reg = next_reg(self_ptr);
                                let ptr_reg = next_reg(self_ptr);
                                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", int_reg), " = fptoui double "), as_float(self_ptr, clean_val)), " to i64\n"));
                                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", ptr_reg), " = inttoptr i64 "), int_reg), " to ptr\n"));
                                final_val = ptr_reg;
                            }
