                    if (fn_name == "memcpy") { params = "ptr, ptr, i64"; abi_ret = "ptr"; } else {}
                    if (fn_name == "fseek" || fn_name == "_fseeki64") { params = "ptr, i64, i32"; abi_ret = "i32"; } else {}
                    if (fn_name == "ftell" || fn_name == "_ftelli64") { params = "ptr"; abi_ret = "i64"; } else {}
