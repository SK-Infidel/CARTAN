                let int_reg = llvm_visit_expr(self_ptr, intensity);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  call void @cartan_emit_spike(double ", as_float(self_ptr, int_reg)), ")\n"));
            }
            if (disc == 44.0) {

                // Handled in a separate pass
            }
            if (disc == 15.0 || disc == 138.0) {

