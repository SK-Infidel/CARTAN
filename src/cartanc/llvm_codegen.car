                } else {}
                arg_str = cartan_string_concat(arg_str, formatted_arg);
                idx_a = idx_a + 1.0;
            }

            if (cartan_string_contains(name, "static_assert") != 0.0) {
                return "0.0";
            }
            let res_reg = next_reg(self_ptr);
            let p1 = cartan_string_concat("  ", res_reg);
            if (cartan_string_eq(name, "printf") != 0.0) {
                let i32_reg = next_reg(self_ptr);
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", i32_reg), " = call i32 (ptr, ...) @printf("), arg_str), ")\n"));
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res_reg), " = sitofp i32 "), i32_reg), " to float\n"));
                return res_reg;
            } else {}

            var ret_type = cartan_dict_get(self_ptr.func_return_types, name);
            var ret_type_str = "double";
            var is_ptr_ret = 0.0;
            if (cartan_string_eq(name, "cartan_tree_create") != 0.0 || cartan_string_starts_with(name, "cartan_tensor_") != 0.0 || cartan_string_eq(name, "malloc") != 0.0) {
                ret_type_str = "ptr";
                is_ptr_ret = 1.0;
            } else if (ret_type != 0.0) {
                if (cartan_string_eq(ret_type, "ptr") != 0.0 || cartan_string_eq(ret_type, "string") != 0.0 || cartan_string_starts_with(ret_type, "%") != 0.0) {
                    ret_type_str = "ptr";
                    is_ptr_ret = 1.0;
                } else if (cartan_string_eq(ret_type, "void") != 0.0) {
