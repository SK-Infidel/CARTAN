                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res_reg), " = fsub float 0.0, "), rhs));
                cartan_tree_push(self_ptr.output, "
");
            } else {
                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", res_reg), " = fadd float 0.0, "), rhs));
                cartan_tree_push(self_ptr.output, "
");
            }
            return res_reg;
        }
        if (disc == 24.0) {
            let left = cartan_tree_get_f32(expr, 1.0);
            let op = cartan_tree_get_f32(expr, 2.0);
            let right = cartan_tree_get_f32(expr, 3.0);
            let l_reg = llvm_visit_expr(self_ptr, left);
            let r_reg = llvm_visit_expr(self_ptr, right);

            let is_l_ptr = (cartan_string_starts_with(l_reg, "ptr:") != 0.0) || (cartan_string_starts_with(l_reg, "array:") != 0.0) || (cartan_string_starts_with(l_reg, "struct:") != 0.0) || (cartan_string_starts_with(l_reg, "string:") != 0.0);
            let is_r_ptr = (cartan_string_starts_with(r_reg, "ptr:") != 0.0) || (cartan_string_starts_with(r_reg, "array:") != 0.0) || (cartan_string_starts_with(r_reg, "struct:") != 0.0) || (cartan_string_starts_with(r_reg, "string:") != 0.0);

            if ((is_l_ptr != 0.0) && (is_r_ptr != 0.0)) {
                let clean_l = cartan_string_replace(cartan_string_replace(cartan_string_replace(cartan_string_replace(l_reg, "ptr:", ""), "string:", ""), "array:", ""), "struct:", "");
                let clean_r = cartan_string_replace(cartan_string_replace(cartan_string_replace(cartan_string_replace(r_reg, "ptr:", ""), "string:", ""), "array:", ""), "struct:", "");

                var func_name = "cartan_tensor_add";
                if (cartan_string_eq(op, "-") != 0.0) { func_name = "cartan_tensor_sub"; }
                else if (cartan_string_eq(op, "*") != 0.0) { func_name = "cartan_tensor_mul"; }
                else if (cartan_string_eq(op, "/") != 0.0) { func_name = "cartan_tensor_div"; }
                else if (cartan_string_eq(op, "@") != 0.0) { func_name = "cartan_tensor_matmul_dynamic"; }
