
fn is_uppercase(s: string) -> float {
    let first = cartan_string_substring(s, 0.0, 1.0);
    if cartan_string_eq(first, "A") != 0.0 || cartan_string_eq(first, "B") != 0.0 || cartan_string_eq(first, "C") != 0.0 || cartan_string_eq(first, "D") != 0.0 || cartan_string_eq(first, "E") != 0.0 || cartan_string_eq(first, "F") != 0.0 || cartan_string_eq(first, "G") != 0.0 || cartan_string_eq(first, "H") != 0.0 || cartan_string_eq(first, "I") != 0.0 || cartan_string_eq(first, "J") != 0.0 || cartan_string_eq(first, "K") != 0.0 || cartan_string_eq(first, "L") != 0.0 || cartan_string_eq(first, "M") != 0.0 || cartan_string_eq(first, "N") != 0.0 || cartan_string_eq(first, "O") != 0.0 || cartan_string_eq(first, "P") != 0.0 || cartan_string_eq(first, "Q") != 0.0 || cartan_string_eq(first, "R") != 0.0 || cartan_string_eq(first, "S") != 0.0 || cartan_string_eq(first, "T") != 0.0 || cartan_string_eq(first, "U") != 0.0 || cartan_string_eq(first, "V") != 0.0 || cartan_string_eq(first, "W") != 0.0 || cartan_string_eq(first, "X") != 0.0 || cartan_string_eq(first, "Y") != 0.0 || cartan_string_eq(first, "Z") != 0.0 {
        return 1.0;
    }
    return 0.0;
}


struct LLVMGenerator {
    output: ptr;
    register_count: float;
    label_count: float;
    string_counter: float;
    globals: ptr;
    symbols: ptr;
    var_types: ptr;
    var_manifolds: ptr;
    struct_fields: ptr;
    func_return_types: ptr;
    loop_labels: ptr;
    current_return_type: string;
    struct_field_types: ptr;
    struct_field_stmts: ptr;
    current_struct: string;
    loop_meta_counter: float;
    loop_metadata: ptr;
    declared_externs: ptr;
    enum_variants: ptr;
    enum_variant_types: ptr;
}

fn llvm_codegen_init() -> LLVMGenerator {
    var l = LLVMGenerator {
        output: cartan_tree_create(),
        register_count: 1.0,
        label_count: 1.0,
        string_counter: 1.0,
        globals: cartan_tree_create(),
        symbols: cartan_tree_create(),
        var_types: cartan_tree_create(),
        var_manifolds: cartan_tree_create(),
        struct_fields: cartan_tree_create(),
        func_return_types: cartan_tree_create(),
        loop_labels: cartan_tree_create(),
        current_return_type: "",
        struct_field_types: cartan_tree_create(),
        struct_field_stmts: cartan_tree_create(),
        current_struct: "",
        loop_meta_counter: 0.0,
        loop_metadata: cartan_tree_create(),
        declared_externs: cartan_tree_create(),
        enum_variants: cartan_tree_create(),
        enum_variant_types: cartan_tree_create(),
    };
    cartan_dict_set(l.func_return_types, "cartan_tree_create", "ptr");
    cartan_dict_set(l.func_return_types, "cartan_tree_get_f32", "ptr");
    cartan_dict_set(l.func_return_types, "cartan_tree_len", "float");
    cartan_dict_set(l.func_return_types, "cartan_tree_len_f", "float");
    cartan_dict_set(l.func_return_types, "cartan_tree_len_f32", "float");
    cartan_dict_set(l.func_return_types, "cartan_string_concat", "string");
    cartan_dict_set(l.func_return_types, "cartan_float_to_string", "string");
    cartan_dict_set(l.func_return_types, "cartan_int_to_string", "string");
    cartan_dict_set(l.func_return_types, "cartan_string_substring", "string");
    cartan_dict_set(l.func_return_types, "cartan_string_char_at", "string");
    cartan_dict_set(l.func_return_types, "cartan_string_replace", "string");
    cartan_dict_set(l.func_return_types, "cartan_read_file", "string");
    cartan_dict_set(l.func_return_types, "malloc", "ptr");
    return l;
}


    

    fn next_reg(self_ptr: LLVMGenerator) -> string {
        let reg = cartan_string_concat("%", self_ptr.register_count);
        self_ptr.register_count += 1;
        return reg;
    }

    fn as_float(self_ptr: LLVMGenerator, val: string) -> string {
        let lower = val.to_lowercase();
        if (cartan_string_starts_with(lower, "0x") == 0.0 && cartan_string_starts_with(lower, "%") == 0.0 && cartan_string_starts_with(lower, "string:") == 0.0 && cartan_string_starts_with(lower, "ptr:") == 0.0 && cartan_string_starts_with(lower, "array:") == 0.0 && cartan_string_starts_with(lower, "struct:") == 0.0 && cartan_tree_has(lower, ".") == 0.0 && cartan_string_eq(lower, "null") == 0.0 && cartan_string_eq(lower, "undef") == 0.0) {
            return cartan_string_concat(val, ".0");
        } else {
            return val;
        }
    }

    fn promote_float_to_tensor(self_ptr: LLVMGenerator, float_reg: string) -> string {
        let tensor_reg = next_reg(self_ptr);
        // Allocate a tensor of size 1
        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", tensor_reg), " = call ptr @cartan_tensor_alloc_temporary(float 1)\n"));
        
        // Load the data pointer (which is the first field of Tensor struct)
        let data_ptr = next_reg(self_ptr);
        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", data_ptr), " = load ptr, ptr "), tensor_reg), ", align 8\n"));
        
        // Store the float value into the data pointer
        let val_f = as_float(self_ptr, float_reg);
        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store float ", val_f), ", ptr "), data_ptr), ", align 4\n"));
        
        return cartan_string_concat("ptr:", tensor_reg);
    }

    fn next_label(self_ptr: LLVMGenerator, prefix: string) -> string {
        let label = cartan_string_concat(prefix, self_ptr.label_count);
        self_ptr.label_count += 1;
        return label;
    }

    fn generate(self_ptr: LLVMGenerator, ast: ptr) -> string {
        printf("Entering generate()! len=%f\n", cartan_tree_len(ast)); cartan_flush(0.0);
        // Pass 1: Forward declarations
        var idx_stmt = 0.0;
while (idx_stmt < cartan_tree_len(ast)) {
    var stmt = cartan_tree_get_f32(ast, idx_stmt);
    idx_stmt = idx_stmt + 1.0;
            let disc = cartan_tree_get_f32(stmt, 0.0);
            if (disc == 10.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let fields = cartan_tree_get_f32(stmt, 2.0);
                let field_names = cartan_tree_create();
                let field_types = cartan_tree_create();
                var idx_field = 0.0;
                while (idx_field < cartan_tree_len(fields)) {
    var field = cartan_tree_get_f32(fields, idx_field);
    idx_field = idx_field + 1.0;
                        let field_disc = cartan_tree_get_f32(field, 0.0); if (field_disc == 8.0) { let field_name = cartan_tree_get_f32(field, 1.0); let type_name = cartan_tree_get_f32(field, 2.0);
                            cartan_tree_push(field_names, field_name);
                            let t = "";
                            if type_name == "Tensor" || type_name == "Vector" {
                                t = "ptr";
                            } else if type_name == "float" || type_name == "int" {
                                t = "float";
                            } else if type_name == "float" || type_name == "float" || type_name == "float" {
                                t = "float";
                            } else if (is_uppercase(type_name) != 0.0) {
                                t = cartan_string_concat("%", type_name);
                            } else {
                                t = "ptr";
                            }
                            cartan_tree_push(field_types, t);
                        }
                    }
                    cartan_dict_set(self_ptr.struct_fields, name, field_names);
                    cartan_dict_set(self_ptr.struct_field_types, name, field_types);
                }
            if (disc == 2.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let variants = cartan_tree_get_f32(stmt, 2.0);
                let variant_map = cartan_tree_create();
                let variant_type_map = cartan_tree_create();
                var i = 0.0;
                while (i < cartan_tree_len_f(variants)) {
                        var variant = cartan_tree_get_f32(variants, i);
                        let v_name = cartan_tree_get_f32(variant, 1.0);
                        let fields = cartan_tree_get_f32(variant, 2.0);
                        cartan_tree_push(variant_map, v_name, i);
                        let v_types = cartan_tree_create();
                        if (fields != 0.0) {
                            var idx_opt_type = 0.0;
                            while (idx_opt_type < cartan_tree_len_f(fields)) {
                                var opt_type = cartan_tree_get_f32(fields, idx_opt_type);
                                let t = opt_type;
                                var llvm_t = "ptr";
                                if (t == "Tensor" || t == "Vector") {
                                    llvm_t = "ptr";
                                } else if (t == "float" || t == "int") {
                                    llvm_t = "float";
                                } else if (is_uppercase(t) != 0.0) {
                                    llvm_t = cartan_string_concat("%", t);
                                } else {
                                    llvm_t = "ptr";
                                }
                                cartan_tree_push(v_types, llvm_t);
                                idx_opt_type = idx_opt_type + 1.0;
                            }
                        } else {}
                        cartan_tree_push(variant_type_map, v_name, v_types);
                    
                        i = i + 1.0;
                    }
                    cartan_dict_set(self_ptr.enum_variants, name, variant_map);
                    cartan_dict_set(self_ptr.enum_variant_types, name, variant_type_map);
                }
            if (disc == 14.0 || disc == 44.0) {
                let fn_name = cartan_tree_get_f32(stmt, 1.0);
                let rt = cartan_tree_get_f32(stmt, 4.0);
                var logical_ret_type = "void";
                if (rt != 0.0) {
                    if (rt == "float" || rt == "int") { logical_ret_type = "float"; }
                    else if (rt == "ptr" || rt == "string" || (cartan_string_starts_with(rt, "tree<") != 0.0)) { logical_ret_type = rt; }
                    else { logical_ret_type = cartan_string_concat("%", rt); }
                } else {}
                cartan_dict_set(self_ptr.func_return_types, fn_name, logical_ret_type);
            }
        }
        // Module header
        cartan_tree_push(self_ptr.output, "; ModuleID =  CartanModule \n");
        cartan_tree_push(self_ptr.output, "source_filename = \"cartan_source\"\n");
        cartan_tree_push(self_ptr.output, "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128\"\n");
        cartan_tree_push(self_ptr.output, "target triple = \"x86_64-pc-windows-msvc\"\n\n");
        
        // Standard library declarations
        cartan_tree_push(self_ptr.output, "declare ptr @malloc(i64)\n");
        cartan_tree_push(self_ptr.output, "declare void @free(ptr)\n");
        cartan_tree_push(self_ptr.output, "declare float @strcmp(ptr, ptr)\n");
        cartan_tree_push(self_ptr.output, "declare void @cartan_debug_break(ptr, double, ptr)\n");
        
        // Tensor Runtime declarations
        let declared_externs = cartan_tree_create();
        cartan_tree_push(declared_externs, "malloc");
        cartan_tree_push(declared_externs, "free");
        cartan_tree_push(declared_externs, "strcmp");
        cartan_tree_push(declared_externs, "cartan_debug_break");
        cartan_tree_push(declared_externs, "printf");
        cartan_tree_push(declared_externs, "cartan_tensor_alloc");
        cartan_tree_push(declared_externs, "cartan_tree_create");
        cartan_tree_push(declared_externs, "cartan_tree_push");
        cartan_tree_push(declared_externs, "cartan_tree_get_f32");
        cartan_tree_push(declared_externs, "cartan_tree_len");
        cartan_tree_push(declared_externs, "cartan_tree_remove");
        cartan_tree_push(declared_externs, "cartan_dict_get");
        cartan_tree_push(declared_externs, "cartan_dict_set");
        cartan_tree_push(declared_externs, "cartan_string_replace");
        cartan_tree_push(declared_externs, "cartan_string_contains");
        cartan_tree_push(declared_externs, "cartan_string_starts_with");
        cartan_tree_push(declared_externs, "cartan_string_eq");
        cartan_tree_push(declared_externs, "cartan_string_to_lowercase");
        cartan_tree_push(declared_externs, "cartan_float_to_string");
        cartan_tree_push(declared_externs, "cartan_int_to_string");
        cartan_tree_push(declared_externs, "cartan_string_substring");
        cartan_tree_push(declared_externs, "cartan_string_length");
        cartan_tree_push(declared_externs, "cartan_string_concat");
        cartan_tree_push(declared_externs, "cartan_read_file");
        cartan_tree_push(declared_externs, "cartan_file_exists");
        cartan_tree_push(declared_externs, "cartan_string_char_at");
        cartan_tree_push(declared_externs, "cartan_is_alpha");
        cartan_tree_push(declared_externs, "cartan_is_alphanumeric");
        cartan_tree_push(declared_externs, "cartan_panic");
        cartan_tree_push(declared_externs, "cartan_tree_size");
        cartan_tree_push(declared_externs, "cartan_tree_set");
        cartan_tree_push(declared_externs, "cartan_tensor_alloc_nd");
        cartan_tree_push(declared_externs, "cartan_tensor_linear_relu");
        cartan_tree_push(declared_externs, "cartan_tensor_add");
        cartan_tree_push(declared_externs, "cartan_tensor_sub");
        cartan_tree_push(declared_externs, "cartan_tensor_mul");
        cartan_tree_push(declared_externs, "cartan_tensor_matmul");
        cartan_tree_push(declared_externs, "cartan_tensor_matmul_dynamic");
        cartan_tree_push(declared_externs, "cartan_tensor_matmul_minkowski");
        cartan_tree_push(declared_externs, "cartan_tensor_matmul_poincare");
        cartan_tree_push(declared_externs, "cartan_tensor_backward");
        cartan_tree_push(declared_externs, "cartan_tensor_print");
        cartan_tree_push(declared_externs, "cartan_tensor_step");
        cartan_tree_push(declared_externs, "cartan_file_read_tokens");
        cartan_tree_push(declared_externs, "cartan_net_fetch_tokens");
        cartan_tree_push(declared_externs, "cartan_file_read_batch");
        cartan_tree_push(declared_externs, "cartan_tensor_mse_loss");
        cartan_tree_push(declared_externs, "cartan_tensor_cross_entropy_loss");
        cartan_tree_push(declared_externs, "cartan_tensor_spherical_cosine_loss");
        cartan_tree_push(declared_externs, "cartan_tensor_finsler_randers_loss");
        cartan_tree_push(declared_externs, "cartan_tensor_betti_homology_loss");
        cartan_tree_push(declared_externs, "cartan_tensor_embed");
        cartan_tree_push(declared_externs, "cartan_rt_parallel_transport");
        cartan_tree_push(declared_externs, "cartan_emit_spike");
        cartan_tree_push(declared_externs, "cartan_init_elastic_vocabulary");
        cartan_tree_push(declared_externs, "cartan_init_sieving_cache");
        cartan_tree_push(declared_externs, "cartan_init_fractal_attention");
        cartan_tree_push(declared_externs, "cartan_stream_init");
        cartan_tree_push(declared_externs, "cartan_init_spike");
        cartan_tree_push(declared_externs, "cartan_init_neuron");
        cartan_tree_push(declared_externs, "cartan_load_dma");
