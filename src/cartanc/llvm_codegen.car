            let clean_slot = clean_reg(slot_reg);
            let clean_shadow = clean_reg(shadow_reg);
            let res_reg = next_reg(self_ptr);
            let p1 = cartan_string_concat("  ", res_reg);
            let p2 = cartan_string_concat(p1, " = call ptr @cartan_rt_atomic_swap_graph(ptr ");
            let p3 = cartan_string_concat(p2, clean_slot);
            let p4 = cartan_string_concat(p3, ", ptr ");
            let p5 = cartan_string_concat(p4, clean_shadow);
            let p6 = cartan_string_concat(p5, ")\n");
            cartan_tree_push(self_ptr.output, p6);
            return cartan_string_concat("ptr:", res_reg);
        }
        if (disc == 34.0 || disc == 98.0) { // LexAndEmbed
            let text_expr = cartan_tree_get_f32(expr, 1.0);
            let text_reg = llvm_visit_expr(self_ptr, text_expr);
            let clean_text = clean_reg(text_reg);
            let res_reg = next_reg(self_ptr);
            let p1 = cartan_string_concat("  ", res_reg);
            let p2 = cartan_string_concat(p1, " = call ptr @cartan_lex_and_embed(ptr ");
            let p3 = cartan_string_concat(p2, clean_text);
            let p4 = cartan_string_concat(p3, ")\n");
            cartan_tree_push(self_ptr.output, p4);
            return cartan_string_concat("ptr:", res_reg);
        }
        if (disc == 35.0 || disc == 99.0) { // AlignGeodesics
            let w_expr = cartan_tree_get_f32(expr, 1.0);
            let b_expr = cartan_tree_get_f32(expr, 2.0);
            let w_reg = llvm_visit_expr(self_ptr, w_expr);
            let b_reg = llvm_visit_expr(self_ptr, b_expr);
            let clean_w = clean_reg(w_reg);
            let clean_b = clean_reg(b_reg);
            let res_reg = next_reg(self_ptr);
            let p1 = cartan_string_concat("  ", res_reg);
            let p2 = cartan_string_concat(p1, " = call ptr @cartan_align_geodesics(ptr ");
            let p3 = cartan_string_concat(p2, clean_w);
            let p4 = cartan_string_concat(p3, ", ptr ");
            let p5 = cartan_string_concat(p4, clean_b);
            let p6 = cartan_string_concat(p5, ")\n");
            cartan_tree_push(self_ptr.output, p6);
            return cartan_string_concat("ptr:", res_reg);
        }
        if (disc == 36.0 || disc == 100.0) { // GeometricBridge
            let src_expr = cartan_tree_get_f32(expr, 1.0);
            let tgt_expr = cartan_tree_get_f32(expr, 2.0);
            let src_reg = llvm_visit_expr(self_ptr, src_expr);
            let tgt_reg = llvm_visit_expr(self_ptr, tgt_expr);
            let clean_src = clean_reg(src_reg);
            let clean_tgt = clean_reg(tgt_reg);
            let res_reg = next_reg(self_ptr);
            let p1 = cartan_string_concat("  ", res_reg);
            let p2 = cartan_string_concat(p1, " = call ptr @cartan_geometric_bridge(ptr ");
            let p3 = cartan_string_concat(p2, clean_src);
            let p4 = cartan_string_concat(p3, ", ptr ");
            let p5 = cartan_string_concat(p4, clean_tgt);
            let p6 = cartan_string_concat(p5, ")\n");
            cartan_tree_push(self_ptr.output, p6);
            return cartan_string_concat("ptr:", res_reg);
        }
        if (disc == 50.0 || disc == 114.0) { // ReflectRepo
            let res_reg = next_reg(self_ptr);
            let p1 = cartan_string_concat("  ", res_reg);
            let p2 = cartan_string_concat(p1, " = call ptr @cartan_reflect_repo()\n");
            cartan_tree_push(self_ptr.output, p2);
            return cartan_string_concat("ptr:", res_reg);
        }
        if (disc == 26.0 || disc == 90.0) { // FusedKernel
            cartan_tree_push(self_ptr.output, "  ; --- Fused Kernel ---\n");
            let block_stmt = cartan_tree_get_f32(expr, 1.0);
            let block_stmts = cartan_tree_get_f32(block_stmt, 0.0);
            var idx_s = 0.0;
            var last_reg = "0.0";
            while (idx_s < cartan_tree_len_f(block_stmts)) {
                var s = cartan_tree_get_f32(block_stmts, idx_s);
                idx_s = idx_s + 1.0;
                let s_disc = cartan_tree_get_f32(s, 0.0);
                if (s_disc == 1.0 || s_disc == 124.0) { // ExprStmt
                    last_reg = llvm_visit_expr(self_ptr, cartan_tree_get_f32(s, 1.0));
                } else {
                    llvm_visit_stmt(self_ptr, s);
                }
            }
            return last_reg;
        }
        if (disc == 27.0 || disc == 91.0) { // Attention
            let tgt_expr = cartan_tree_get_f32(expr, 1.0);
            let rt_expr = cartan_tree_get_f32(expr, 2.0);
            let tgt_reg = llvm_visit_expr(self_ptr, tgt_expr);
            let rt_reg = llvm_visit_expr(self_ptr, rt_expr);
            let clean_tgt = clean_reg(tgt_reg);
            let clean_rt = clean_reg(rt_reg);
            let res_reg = next_reg(self_ptr);
            let p1 = cartan_string_concat("  ", res_reg);
            let p2 = cartan_string_concat(p1, " = call ptr @cartan_attention(ptr ");
            let p3 = cartan_string_concat(p2, clean_tgt);
            let p4 = cartan_string_concat(p3, ", ptr ");
            let p5 = cartan_string_concat(p4, clean_rt);
            let p6 = cartan_string_concat(p5, ")\n");
            cartan_tree_push(self_ptr.output, p6);
            return cartan_string_concat("ptr:", res_reg);
        }
        if (disc == 51.0 || disc == 115.0) { // SievingCacheInit
            let res_reg = next_reg(self_ptr);
            let p1 = cartan_string_concat("  ", res_reg);
            let p2 = cartan_string_concat(p1, " = call ptr @cartan_init_sieving_cache()\n");
            cartan_tree_push(self_ptr.output, p2);
            return cartan_string_concat("ptr:", res_reg);
        }
        if (disc == 52.0 || disc == 116.0) { // FractalAttentionInit
            let res_reg = next_reg(self_ptr);
            let p1 = cartan_string_concat("  ", res_reg);
            let p2 = cartan_string_concat(p1, " = call ptr @cartan_init_fractal_attention()\n");
            cartan_tree_push(self_ptr.output, p2);
            return cartan_string_concat("ptr:", res_reg);
        }
        if (disc == 53.0 || disc == 117.0) { // ElasticVocabularyInit
            let res_reg = next_reg(self_ptr);
            let p1 = cartan_string_concat("  ", res_reg);
            let p2 = cartan_string_concat(p1, " = call ptr @cartan_init_elastic_vocab()\n");
            cartan_tree_push(self_ptr.output, p2);
            return cartan_string_concat("ptr:", res_reg);
        }
        if (disc == 54.0 || disc == 118.0) { // SpikePrimitive
            let res_reg = next_reg(self_ptr);
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", res_reg), " = call double @cartan_get_last_spike()\n"));
            return res_reg;
        }
        if (disc == 55.0 || disc == 119.0) { // NeuronPrimitive
            let res_reg = next_reg(self_ptr);
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", res_reg), " = call double @cartan_get_last_spike()\n"));
            return res_reg;
        }
        return "0.0";
    }



