        cartan_tree_push(self_ptr.output, "declare ptr @cartan_int_to_string(float)\n");
        cartan_tree_push(self_ptr.output, "declare ptr @cartan_string_substring(ptr, float, float)\n");
        cartan_tree_push(self_ptr.output, "declare float @cartan_string_length(ptr)\n");
