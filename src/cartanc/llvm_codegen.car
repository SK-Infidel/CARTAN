        cartan_tree_push(self_ptr.output, "declare void @cartan_tree_set(ptr, float, ptr)\n");
        cartan_tree_push(self_ptr.output, "declare float @printf(ptr, ...)\n");
        cartan_tree_push(self_ptr.output, "declare ptr @cartan_tensor_alloc_nd(float, float, float, float, float, float)\n");
        cartan_tree_push(self_ptr.output, "declare ptr @cartan_tensor_linear_relu(ptr, ptr, ptr)\n");
        cartan_tree_push(self_ptr.output, "declare ptr @cartan_tensor_add(ptr, ptr)\n");
        cartan_tree_push(self_ptr.output, "declare ptr @cartan_tensor_sub(ptr, ptr)\n");
        cartan_tree_push(self_ptr.output, "declare ptr @cartan_tensor_mul(ptr, ptr)\n");
        cartan_tree_push(self_ptr.output, "declare ptr @cartan_tensor_div(ptr, ptr)\n");
        cartan_tree_push(self_ptr.output, "declare ptr @cartan_tensor_matmul(ptr, ptr)\n");
        cartan_tree_push(self_ptr.output, "declare ptr @cartan_tensor_matmul_dynamic(ptr, ptr)\n");
