    cartan_dict_set(l.func_return_types, "cartan_rt_paged_attention", "ptr");
    cartan_dict_set(l.func_return_types, "cartan_project_vocab", "void");
    cartan_dict_set(l.func_return_types, "cartan_vec_len", "double");
    cartan_dict_set(l.func_return_types, "cartan_vec_get_f32", "double");
    cartan_dict_set(l.func_return_types, "cartan_rt_atomic_swap_graph", "ptr");
