
extern fn cartan_float_to_string(f: float) -> string;
extern fn cartan_int_to_string(f: float) -> string;
extern fn cartan_llvm_format_string_literal(s: string, id: float) -> string;
extern fn cartan_strip_prefix(s: string) -> string;


fn is_uppercase(s: string) -> float {
    let first = cartan_string_substring(s, 0.0, 1.0);
    if (cartan_string_eq(first, "A") != 0.0 || cartan_string_eq(first, "B") != 0.0 || cartan_string_eq(first, "C") != 0.0 || cartan_string_eq(first, "D") != 0.0 || cartan_string_eq(first, "E") != 0.0 || cartan_string_eq(first, "F") != 0.0 || cartan_string_eq(first, "G") != 0.0 || cartan_string_eq(first, "H") != 0.0 || cartan_string_eq(first, "I") != 0.0 || cartan_string_eq(first, "J") != 0.0 || cartan_string_eq(first, "K") != 0.0 || cartan_string_eq(first, "L") != 0.0 || cartan_string_eq(first, "M") != 0.0 || cartan_string_eq(first, "N") != 0.0 || cartan_string_eq(first, "O") != 0.0 || cartan_string_eq(first, "P") != 0.0 || cartan_string_eq(first, "Q") != 0.0 || cartan_string_eq(first, "R") != 0.0 || cartan_string_eq(first, "S") != 0.0 || cartan_string_eq(first, "T") != 0.0 || cartan_string_eq(first, "U") != 0.0 || cartan_string_eq(first, "V") != 0.0 || cartan_string_eq(first, "W") != 0.0 || cartan_string_eq(first, "X") != 0.0 || cartan_string_eq(first, "Y") != 0.0 || cartan_string_eq(first, "Z") != 0.0) {
        return 1.0;
    }
    return 0.0;
}


struct LLVMGenerator {
    output: ptr;
    register_count: float;
    label_count: float;
    string_counter: float;
    globals: ptr;
    symbols: ptr;
    var_types: ptr;
    var_manifolds: ptr;
    struct_fields: ptr;
    func_return_types: ptr;
    loop_labels: ptr;
    current_return_type: string;
    struct_field_types: ptr;
    struct_field_stmts: ptr;
    current_struct: string;
    loop_meta_counter: float;
    loop_metadata: ptr;
    declared_externs: ptr;
    enum_variants: ptr;
    enum_variant_types: ptr;
    header: ptr;
    decls: ptr;
}

fn llvm_codegen_init() -> LLVMGenerator {
    var l = LLVMGenerator {
        output: cartan_tree_create(),
        register_count: 1.0,
        label_count: 1.0,
        string_counter: 1.0,
        globals: cartan_tree_create(),
        symbols: cartan_tree_create(),
        var_types: cartan_tree_create(),
        var_manifolds: cartan_tree_create(),
        struct_fields: cartan_tree_create(),
        func_return_types: cartan_tree_create(),
        loop_labels: cartan_tree_create(),
        current_return_type: "",
        struct_field_types: cartan_tree_create(),
        struct_field_stmts: cartan_tree_create(),
        current_struct: "",
        loop_meta_counter: 0.0,
        loop_metadata: cartan_tree_create(),
        declared_externs: cartan_tree_create(),
        enum_variants: cartan_tree_create(),
        enum_variant_types: cartan_tree_create(),
        header: cartan_tree_create(),
        decls: cartan_tree_create(),
    };
    cartan_dict_set(l.func_return_types, "cartan_tree_create", "ptr");
    cartan_dict_set(l.func_return_types, "cartan_tree_get_f32", "ptr");
    cartan_dict_set(l.func_return_types, "cartan_tree_len", "double");
    cartan_dict_set(l.func_return_types, "cartan_tree_len_f", "double");
    cartan_dict_set(l.func_return_types, "cartan_tree_len_f32", "double");
    cartan_dict_set(l.func_return_types, "cartan_string_concat", "string");
    cartan_dict_set(l.func_return_types, "cartan_float_to_string", "string");
    cartan_dict_set(l.func_return_types, "cartan_int_to_string", "string");
    cartan_dict_set(l.func_return_types, "cartan_string_substring", "string");
    cartan_dict_set(l.func_return_types, "cartan_string_char_at", "string");
    cartan_dict_set(l.func_return_types, "cartan_string_replace", "string");
    cartan_dict_set(l.func_return_types, "cartan_read_file", "string");
    cartan_dict_set(l.func_return_types, "cartan_read_line", "string");
    cartan_dict_set(l.func_return_types, "sys_get_arg", "string");
    cartan_dict_set(l.func_return_types, "cartan_string_starts_with", "double");
    cartan_dict_set(l.func_return_types, "malloc", "ptr");
    cartan_dict_set(l.func_return_types, "cartan_c_tree_create", "ptr");
    cartan_dict_set(l.func_return_types, "cartan_c_tree_get", "ptr");
    cartan_dict_set(l.func_return_types, "cartan_c_memcpy", "ptr");
    cartan_dict_set(l.func_return_types, "cartan_c_ptr_add", "ptr");
    cartan_dict_set(l.func_return_types, "cartan_c_int_to_string", "string");
    cartan_dict_set(l.func_return_types, "cartan_c_float_to_string", "string");
    cartan_dict_set(l.func_return_types, "cartan_c_sprintf_hex_byte", "void");
    cartan_dict_set(l.func_return_types, "cartan_c_tree_push", "void");
    cartan_dict_set(l.func_return_types, "cartan_c_tree_set", "void");
    cartan_dict_set(l.func_return_types, "cartan_c_tree_remove", "void");
    cartan_dict_set(l.func_return_types, "cartan_c_tree_len_f", "double");
    cartan_dict_set(l.func_return_types, "c_cartan_string_char_at", "double");
    cartan_dict_set(l.func_return_types, "cartan_c_strncmp", "double");
    cartan_dict_set(l.func_return_types, "strcmp", "double");
    cartan_dict_set(l.func_return_types, "strncmp", "double");
    cartan_dict_set(l.func_return_types, "system", "double");
    return l;
}


    

    fn next_reg(self_ptr: LLVMGenerator) -> string {
        let reg = cartan_string_concat("%", cartan_int_to_string(self_ptr.register_count));
        self_ptr.register_count = self_ptr.register_count + 1.0;
        return reg;
    }

    fn clean_reg(val: string) -> string {
        return cartan_strip_prefix(val);
    }

    fn as_float(self_ptr: LLVMGenerator, val: string) -> string {
        var is_ptr = 0.0;
        if (cartan_string_starts_with(val, "ptr:") != 0.0) { is_ptr = 1.0; }
        if (cartan_string_starts_with(val, "string:") != 0.0) { is_ptr = 1.0; }
        if (cartan_string_starts_with(val, "array:") != 0.0) { is_ptr = 1.0; }
        if (cartan_string_starts_with(val, "struct:") != 0.0) { is_ptr = 1.0; }
        if (cartan_string_starts_with(val, "tree<") != 0.0) { is_ptr = 1.0; }
        if (is_ptr != 0.0) {
            let clean_p = clean_reg(val);
            let int_reg = next_reg(self_ptr);
            let flt_reg = next_reg(self_ptr);
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", int_reg), " = ptrtoint ptr "), clean_p), " to i64\n"));
            cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", flt_reg), " = sitofp i64 "), int_reg), " to double\n"));
            return flt_reg;
        }
        let clean = cartan_strip_prefix(val);
        if (cartan_string_starts_with(clean, "%") != 0.0) { return clean; }
        if (cartan_string_starts_with(clean, "@") != 0.0) { return clean; }
        if (cartan_string_starts_with(clean, "0x") != 0.0) { return clean; }
        if (cartan_string_contains(clean, ".") != 0.0) { return clean; }
        if (cartan_string_contains(clean, "e") != 0.0) {
            if (cartan_string_contains(clean, ".") == 0.0) {
                return cartan_string_replace(clean, "e", ".0e");
            }
            return clean;
        }
        if (cartan_string_contains(clean, "E") != 0.0) {
            if (cartan_string_contains(clean, ".") == 0.0) {
                return cartan_string_replace(clean, "E", ".0E");
            }
            return clean;
        }
        if (cartan_string_eq(clean, "null") != 0.0) { return "0.0"; }
        if (cartan_string_eq(clean, "undef") != 0.0) { return clean; }
        if (cartan_string_length(clean) == 0.0) { return "0.0"; }
        return cartan_string_concat(clean, ".0");
    }

    fn promote_float_to_tensor(self_ptr: LLVMGenerator, float_reg: string) -> string {
        let tensor_reg = next_reg(self_ptr);
        // Allocate a tensor of size 1
        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat("  ", tensor_reg), " = call ptr @cartan_tensor_alloc_temporary(double 1.0)\n"));
        
        // Load the data pointer (which is the first field of Tensor struct)
        let data_ptr = next_reg(self_ptr);
        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  ", data_ptr), " = load ptr, ptr "), tensor_reg), ", align 8\n"));
        
        // Store the float value into the data pointer
        let val_f = as_float(self_ptr, float_reg);
        cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  store float ", val_f), ", ptr "), data_ptr), ", align 4\n"));
        
        return cartan_string_concat("ptr:", tensor_reg);
    }

    fn next_label(self_ptr: LLVMGenerator, prefix: string) -> string {
        let label = cartan_string_concat(prefix, cartan_int_to_string(self_ptr.label_count));
        self_ptr.label_count = self_ptr.label_count + 1.0;
        return label;
    }

    fn add_builtin_extern(self_ptr: LLVMGenerator, user_defined: ptr, name: string, decl_line: string) {
        cartan_tree_push(self_ptr.declared_externs, name);
        if (cartan_tree_has(user_defined, name) == 0.0) {
            cartan_tree_push(self_ptr.decls, decl_line);
        }
    }

    fn generate(self_ptr: LLVMGenerator, ast: ptr) -> string {
        // Pass 1: Forward declarations
        var idx_stmt = 0.0;
        let a_len = cartan_tree_len_f(ast);
        while (idx_stmt < a_len) {
            var stmt = cartan_tree_get_f32(ast, idx_stmt);
            idx_stmt = idx_stmt + 1.0;
            let disc = cartan_tree_get_f32(stmt, 0.0);
            if (disc == 5.0 || disc == 10.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let fields = cartan_tree_get_f32(stmt, 2.0);
                let field_names = cartan_tree_create();
                let field_types = cartan_tree_create();
                var idx_field = 0.0;
                while (idx_field < cartan_tree_len_f(fields)) {
                    var field = cartan_tree_get_f32(fields, idx_field);
                    idx_field = idx_field + 1.0;
                    let field_disc = cartan_tree_get_f32(field, 0.0);
                    if (field_disc == 4.0 || field_disc == 8.0) {
                        let field_name = cartan_tree_get_f32(field, 1.0);
                        let type_name = cartan_tree_get_f32(field, 2.0);
                        cartan_tree_push(field_names, field_name);
                        let t = "";
                        if (cartan_string_eq(type_name, "Tensor") != 0.0 || cartan_string_eq(type_name, "Vector") != 0.0) {
                            t = "ptr";
                        } else if (cartan_string_eq(type_name, "float") != 0.0 || cartan_string_eq(type_name, "int") != 0.0 || cartan_string_eq(type_name, "double") != 0.0) {
                            t = "double";
                        } else if (cartan_string_eq(type_name, "string") != 0.0) {
                            t = "string";
                        } else if (is_uppercase(type_name) != 0.0) {
                            t = cartan_string_concat("%", type_name);
                        } else {
                            t = "ptr";
                        }
                        cartan_tree_push(field_types, t);
                    }
                }
                cartan_dict_set(self_ptr.struct_fields, name, field_names);
                cartan_dict_set(self_ptr.struct_field_types, name, field_types);
            }
            if (disc == 2.0) {
                let name = cartan_tree_get_f32(stmt, 1.0);
                let variants = cartan_tree_get_f32(stmt, 2.0);
                let variant_map = cartan_tree_create();
                let variant_type_map = cartan_tree_create();
                var i = 0.0;
                while (i < cartan_tree_len_f(variants)) {
                    var variant = cartan_tree_get_f32(variants, i);
                    let v_name = cartan_tree_get_f32(variant, 0.0);
                    let fields = cartan_tree_get_f32(variant, 1.0);
                    let pair = cartan_tree_create();
                    cartan_tree_push(pair, v_name);
                    cartan_tree_push(pair, cartan_float_to_string(i));
                    cartan_tree_push(variant_map, pair);
                    let v_types = cartan_tree_create();
                    if (fields != 0.0) {
                        var idx_opt_type = 0.0;
                        while (idx_opt_type < cartan_tree_len_f(fields)) {
                            var opt_type = cartan_tree_get_f32(fields, idx_opt_type);
                            let t = cartan_tree_get_f32(opt_type, 1.0);
                            var llvm_t = "ptr";
                            if (t == "Tensor" || t == "Vector") {
                                llvm_t = "ptr";
                            } else if (t == "float" || t == "int") {
                                llvm_t = "double";
                            } else if (is_uppercase(t) != 0.0) {
                                llvm_t = cartan_string_concat("%", t);
                            } else {
                                llvm_t = "ptr";
                            }
                            cartan_tree_push(v_types, llvm_t);
                            idx_opt_type = idx_opt_type + 1.0;
                        }
                    } else {}
                    let type_pair = cartan_tree_create();
                    cartan_tree_push(type_pair, v_name);
                    cartan_tree_push(type_pair, v_types);
                    cartan_tree_push(variant_type_map, type_pair);
                    i = i + 1.0;
                }
                cartan_dict_set(self_ptr.enum_variants, name, variant_map);
                cartan_dict_set(self_ptr.enum_variant_types, name, variant_type_map);
            }
            if (disc == 14.0 || disc == 131.0) {
                var fn_name = cartan_tree_get_f32(stmt, 1.0);
                if (cartan_string_eq(fn_name, "main") != 0.0) { fn_name = "user_main"; }
                let rt = cartan_tree_get_f32(stmt, 4.0);
                var logical_ret_type = "void";
                if (rt != 0.0) {
                    if (rt == "void") { logical_ret_type = "void"; }
                    else if (rt == "float" || rt == "int" || rt == "i32" || rt == "i64" || rt == "bool" || rt == "double") { logical_ret_type = "double"; }
                    else if (rt == "ptr" || rt == "string" || (cartan_string_starts_with(rt, "tree<") != 0.0)) { logical_ret_type = rt; }
                    else if (is_uppercase(rt) != 0.0) { logical_ret_type = cartan_string_concat("%", rt); }
                    else { logical_ret_type = "double"; }
                } else {}
                cartan_dict_set(self_ptr.func_return_types, fn_name, logical_ret_type);
            }
            if (disc == 15.0) {
                let fn_name = cartan_tree_get_f32(stmt, 1.0);
                let rt = cartan_tree_get_f32(stmt, 3.0);
                var logical_ret_type = "void";
                if (rt != 0.0) {
                    if (rt == "void") { logical_ret_type = "void"; }
                    else if (rt == "float" || rt == "int" || rt == "i32" || rt == "i64" || rt == "bool" || rt == "double") { logical_ret_type = "double"; }
                    else if (rt == "ptr" || rt == "string" || (cartan_string_starts_with(rt, "tree<") != 0.0)) { logical_ret_type = rt; }
                    else if (is_uppercase(rt) != 0.0) { logical_ret_type = cartan_string_concat("%", rt); }
                    else { logical_ret_type = "double"; }
                } else {}
                cartan_dict_set(self_ptr.func_return_types, fn_name, logical_ret_type);
            }
        }
        // Module header
        let q = "\"";
        cartan_tree_push(self_ptr.header, "; ModuleID = 'CartanModule'\n");
        let sf = cartan_string_concat(cartan_string_concat("source_filename = ", q), cartan_string_concat("cartan_source", cartan_string_concat(q, "\n")));
        cartan_tree_push(self_ptr.header, sf);
        let dl = cartan_string_concat(cartan_string_concat("target datalayout = ", q), cartan_string_concat("e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128", cartan_string_concat(q, "\n")));
        cartan_tree_push(self_ptr.header, dl);
        let tt = cartan_string_concat(cartan_string_concat("target triple = ", q), cartan_string_concat("x86_64-pc-windows-msvc", cartan_string_concat(q, "\n\n")));
        cartan_tree_push(self_ptr.header, tt);
        
        // Pre-scan all user-defined and method names from AST
        let user_defined_names = cartan_tree_create();
        var idx_u = 0.0;
        let ast_len = cartan_tree_len_f(ast);
        while (idx_u < ast_len) {
            var s_u = cartan_tree_get_f32(ast, idx_u);
            idx_u = idx_u + 1.0;
            let d_u = cartan_tree_get_f32(s_u, 0.0);
            if (d_u == 14.0 || d_u == 131.0) {
                let name_u = cartan_tree_get_f32(s_u, 1.0);
                cartan_tree_push(user_defined_names, name_u);
            }
            if (d_u == 5.0 || d_u == 10.0) {
                let fields = cartan_tree_get_f32(s_u, 2.0);
                var idx_f = 0.0;
                while (idx_f < cartan_tree_len_f(fields)) {
                    var f = cartan_tree_get_f32(fields, idx_f);
                    idx_f = idx_f + 1.0;
                    let fd = cartan_tree_get_f32(f, 0.0);
                    if (fd == 14.0 || fd == 44.0 || fd == 131.0) {
                        let fn_name = cartan_tree_get_f32(f, 1.0);
                        cartan_tree_push(user_defined_names, fn_name);
                    }
                }
            }
            if (d_u == 88.0) {
                let methods = cartan_tree_get_f32(s_u, 2.0);
                var idx_im = 0.0;
                while (idx_im < cartan_tree_len_f(methods)) {
                    var m = cartan_tree_get_f32(methods, idx_im);
                    idx_im = idx_im + 1.0;
                    let md = cartan_tree_get_f32(m, 0.0);
                    if (md == 14.0 || md == 131.0) {
                        let fn_name = cartan_tree_get_f32(m, 1.0);
                        cartan_tree_push(user_defined_names, fn_name);
                    }
                }
            }
        }
        self_ptr.declared_externs = cartan_tree_create();
        cartan_tree_push(self_ptr.declared_externs, "sys_get_arg");
        cartan_tree_push(self_ptr.declared_externs, "sys_get_arg_count");
        cartan_tree_push(self_ptr.declared_externs, "cartan_crt_init");
        cartan_tree_push(self_ptr.declared_externs, "c_cartan_string_char_at");
        cartan_tree_push(self_ptr.declared_externs, "cartan_c_memcpy");
        cartan_tree_push(self_ptr.declared_externs, "cartan_c_strncmp");
        cartan_tree_push(self_ptr.declared_externs, "cartan_c_ptr_add");
        cartan_tree_push(self_ptr.declared_externs, "cartan_c_int_to_string");
        cartan_tree_push(self_ptr.declared_externs, "cartan_c_float_to_string");
        cartan_tree_push(self_ptr.declared_externs, "cartan_c_sprintf_hex_byte");
        cartan_tree_push(self_ptr.declared_externs, "cartan_c_tree_create");
        cartan_tree_push(self_ptr.declared_externs, "cartan_c_tree_len_f");
        cartan_tree_push(self_ptr.declared_externs, "cartan_c_tree_push");
        cartan_tree_push(self_ptr.declared_externs, "cartan_c_tree_get");
        cartan_tree_push(self_ptr.declared_externs, "cartan_c_tree_set");
        cartan_tree_push(self_ptr.declared_externs, "cartan_c_tree_remove");

        add_builtin_extern(self_ptr, user_defined_names, "malloc", "declare ptr @malloc(i64)\n");
        add_builtin_extern(self_ptr, user_defined_names, "realloc", "declare ptr @realloc(ptr, i64)\n");
        add_builtin_extern(self_ptr, user_defined_names, "free", "declare void @free(ptr)\n");
        add_builtin_extern(self_ptr, user_defined_names, "strlen", "declare i64 @strlen(ptr)\n");
        add_builtin_extern(self_ptr, user_defined_names, "memcpy", "declare ptr @memcpy(ptr, ptr, i64)\n");
        add_builtin_extern(self_ptr, user_defined_names, "strncmp", "declare i32 @strncmp(ptr, ptr, i64)\n");
        add_builtin_extern(self_ptr, user_defined_names, "snprintf", "declare i32 @snprintf(ptr, i64, ptr, ...)\n");
        add_builtin_extern(self_ptr, user_defined_names, "strchr", "declare ptr @strchr(ptr, i32)\n");
        add_builtin_extern(self_ptr, user_defined_names, "strncpy", "declare ptr @strncpy(ptr, ptr, i64)\n");
        add_builtin_extern(self_ptr, user_defined_names, "llvm.floor.f64", "declare double @llvm.floor.f64(double)\n");
        add_builtin_extern(self_ptr, user_defined_names, "strcmp", "declare i32 @strcmp(ptr, ptr)\n");
        add_builtin_extern(self_ptr, user_defined_names, "SetConsoleCP", "declare i32 @SetConsoleCP(i32)\n");
        add_builtin_extern(self_ptr, user_defined_names, "SetConsoleOutputCP", "declare i32 @SetConsoleOutputCP(i32)\n");
        add_builtin_extern(self_ptr, user_defined_names, "cartan_init_ising_embeddings", "declare void @cartan_init_ising_embeddings(ptr)\n");
        add_builtin_extern(self_ptr, user_defined_names, "cartan_sample_ising_attractor", "declare float @cartan_sample_ising_attractor(ptr, float, float)\n");
        add_builtin_extern(self_ptr, user_defined_names, "cartan_build_active_vocab_mapping", "declare float @cartan_build_active_vocab_mapping(ptr, ptr, ptr)\n");
        add_builtin_extern(self_ptr, user_defined_names, "cartan_load_active_vocab_mapping", "declare float @cartan_load_active_vocab_mapping(ptr)\n");
        add_builtin_extern(self_ptr, user_defined_names, "cartan_train_e8_attention_gpu", "declare float @cartan_train_e8_attention_gpu(ptr, ptr, ptr, ptr, ptr, ptr, float, float)\n");
        add_builtin_extern(self_ptr, user_defined_names, "cartan_train_magic_square_moe_gpu", "declare float @cartan_train_magic_square_moe_gpu(ptr, ptr, ptr, ptr, ptr, ptr, float, float)\n");
        add_builtin_extern(self_ptr, user_defined_names, "cartan_train_sft_aligned_gpu", "declare float @cartan_train_sft_aligned_gpu(ptr, ptr, ptr, ptr, ptr, ptr, float, float)\n");
        add_builtin_extern(self_ptr, user_defined_names, "cartan_forward_e8_attention_gpu", "declare ptr @cartan_forward_e8_attention_gpu(ptr, ptr, ptr, ptr, ptr)\n");
        add_builtin_extern(self_ptr, user_defined_names, "cartan_tokenize_prompt_string", "declare ptr @cartan_tokenize_prompt_string(ptr)\n");
        add_builtin_extern(self_ptr, user_defined_names, "cartan_save_model_checkpoint", "declare float @cartan_save_model_checkpoint(ptr, ptr, ptr, ptr, ptr)\n");
