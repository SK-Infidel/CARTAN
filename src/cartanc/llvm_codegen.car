                cartan_tree_push(self_ptr.output, cartan_string_concat(cartan_string_concat(cartan_string_concat(cartan_string_concat("  call void @cartan_tree_push(ptr ", clean_obj), ", ptr "), arg_str), ")\n"));
                return "0.0";
            } else {}
            if (method_name == "to_lowercase") {
                let res_reg = next_reg(self_ptr);
                let p1 = cartan_string_concat("  ", res_reg);
