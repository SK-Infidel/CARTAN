fn cartan_project_vocab(src: ptr, tgt: ptr) -> void {
    if (src == 0.0 || tgt == 0.0) { return; }
    let len = cartan_vec_len(src);
    var i = 0.0;
    while (i < len) {
        let val = cartan_vec_get_f32(src, i);
        cartan_vec_push_f32(tgt, val);
        i = i + 1.0;
    }
}

