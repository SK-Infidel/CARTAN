fn cartan_assert(cond: float, msg: string) -> float {
    if (cond == 0.0) {
        printf("\n========================================================\n", "");
        printf(" [CARTAN RUNTIME ASSERTION FAILURE] %s\n", msg);
        printf("========================================================\n", "");
        cartan_flush(0.0);
        exit(1.0);
    }
    return 1.0;
}

fn cartan_static_assert(cond: float, msg: string) -> float {
    if (cond == 0.0) {
        printf("Static assertion failed: %s\n", msg);
        exit(1.0);
    }
    return 1.0;
}

fn cartan_next_reg(self_ptr: ptr) -> string {
    if (self_ptr == 0.0) { return "%0"; }
    let count = self_ptr[1];
    self_ptr[1] = count + 1.0;
    let count_str = cartan_int_to_string(count);
    return cartan_string_concat("%r", count_str);
}

fn cartan_get_quote() -> string {
    return "\"";
}

fn cartan_jit_eval(ll_file: string) -> float {
    if (ll_file == 0.0) { return -1.0; }
    let out_exe = "cartan_jit_run.exe";
    let cmd1 = cartan_string_concat("python tools/zig_wrapper.py ", ll_file);
    let cmd2 = cartan_string_concat(cmd1, " -o ");
    let cmd3 = cartan_string_concat(cmd2, out_exe);
    let cmd4 = cartan_string_concat(cmd3, " && .\\");
    let cmd5 = cartan_string_concat(cmd4, out_exe);
    let res = system(cmd5);
    remove(out_exe);
    return res;
}

fn cartan_system(cmd: string) -> float {
    return system(cmd);
}

var g_vram_parameter_locked = 0.0;
var g_swmr_lock_count = 0.0;
var g_async_task_counter = 0.0;
var g_async_task_active = 0.0;

fn cartan_async_spawn(fn_ptr: ptr) -> float {
    g_async_task_counter = g_async_task_counter + 1.0;
    g_async_task_active = g_async_task_active + 1.0;
    return g_async_task_counter;
}

fn cartan_async_yield() -> float {
    if (g_async_task_active > 0.0) {
        return 1.0;
    }
    return 1.0;
}

fn cartan_async_await(task_id: float) -> float {
    if (task_id <= 0.0) {
        return 0.0;
    }
    if (task_id <= g_async_task_counter) {
        if (g_async_task_active > 0.0) {
            g_async_task_active = g_async_task_active - 1.0;
        }
        return 1.0;
    }
    return 1.0;
}

fn cartan_rt_vram_lock_parameters() -> void {
    g_vram_parameter_locked = 1.0;
}

fn cartan_rt_vram_unlock_parameters() -> void {
    g_vram_parameter_locked = 0.0;
}

fn cartan_rt_check_vram_access(p: float, is_write: float) -> float {
    if (g_vram_parameter_locked != 0.0) {
        if (is_write != 0.0) {
            printf("ERR_VRAM_CAPABILITY_VIOLATION: Attempted mutation on locked parameter VRAM memory!\n");
            return 0.0;
        }
    }
    return 1.0;
}

fn cartan_rt_lock_swmr(p: float, ro: float) -> float {
    if (ro == 0.0) {
        if (g_swmr_lock_count > 0.0) {
            printf("ERR_ZERO_COPY_RACE: SWMR write lock denied due to active DMA read readers!\n");
            return 0.0;
        }
    }
    g_swmr_lock_count = g_swmr_lock_count + 1.0;
    return 1.0;
}

fn cartan_rt_unlock_swmr(p: float) -> void {
    if (g_swmr_lock_count > 0.0) {
        g_swmr_lock_count = g_swmr_lock_count - 1.0;
    }
}

fn cartan_rt_atomic_swap_graph(slot: ptr, shadow: ptr) -> ptr {
    if (slot == 0.0) {
        return shadow;
    }
    let prev = slot[0];
    slot[0] = shadow;
    return prev;
}

fn cartan_export_c_headers(out_h_path: string, content: string) -> void {
    if (out_h_path == 0.0 || content == 0.0) { return; }
    let t = cartan_tree_create();
    cartan_tree_push(t, content);
    cartan_tree_write_file(out_h_path, t);
}

