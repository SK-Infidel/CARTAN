// --- String Operations ---
fn cartan_string_length(s: string) -> float {
    if (s == 0.0) { return 0.0; }
    return strlen(s);
}

fn cartan_string_concat(s1: string, s2: string) -> string {
    if (s1 == 0.0 && s2 == 0.0) { return ""; }
    if (s1 == 0.0) { return s2; }
    if (s2 == 0.0) { return s1; }
    let l1 = strlen(s1);
    let l2 = strlen(s2);
    let buf = malloc(l1 + l2 + 1.0);
    if (buf == 0.0) { return ""; }
    strcpy(buf, s1);
    strcat(buf, s2);
    return buf;
}

fn cartan_string_eq(s1: string, s2: string) -> float {
    if (s1 == 0.0 && s2 == 0.0) { return 1.0; }
    if (s1 == 0.0 || s2 == 0.0) { return 0.0; }
    let res = strcmp(s1, s2);
    if (res == 0.0) { return 1.0; }
    return 0.0;
}

fn cartan_string_substring(s: string, start: float, end_idx: float) -> string {
    if (s == 0.0) { return ""; }
    let len = strlen(s);
    var st = start;
    if (st < 0.0) { st = 0.0; }
    if (st > len) { st = len; }
    var en = end_idx;
    if (en < 0.0) { en = 0.0; }
    if (en > len) { en = len; }
    if (en < st) { en = st; }
    let sub_len = en - st;
    let res = calloc(sub_len + 1.0, 1.0);
    if (res == 0.0) { return ""; }
    if (sub_len > 0.0) {
        cartan_c_memcpy(res, cartan_c_ptr_add(s, st), sub_len);
    }
    return res;
}

fn cartan_string_starts_with(s: string, prefix: string) -> float {
    if (s == 0.0 || prefix == 0.0) { return 0.0; }
    let lp = strlen(prefix);
    let ls = strlen(s);
    if (lp > ls) { return 0.0; }
    let res = cartan_c_strncmp(s, prefix, lp);
    if (res == 0.0) { return 1.0; }
    return 0.0;
}

fn cartan_string_contains(s: string, target: string) -> float {
    if (s == 0.0 || target == 0.0) { return 0.0; }
    let res = strstr(s, target);
    if (res != 0.0) { return 1.0; }
    return 0.0;
}

fn cartan_string_get_char(s: string, idx: float) -> float {
    if (s == 0.0) { return 0.0; }
    let len = strlen(s);
    if (idx < 0.0 || idx >= len) { return 0.0; }
    return c_cartan_string_char_at(s, idx);
}

fn cartan_string_replace(s: string, old_sub: string, new_sub: string) -> string {
    if (s == 0.0) { return ""; }
    if (old_sub == 0.0) { return s; }
    let s_len = strlen(s);
    let old_len = strlen(old_sub);
    if (old_len == 0.0) { return s; }
    let new_len = strlen(new_sub);
    var alloc_size = s_len * 4.0 + 1024.0;
    if (new_len > old_len) {
        alloc_size = s_len * (new_len + 1.0) + 1024.0;
    }
    let res = calloc(alloc_size, 1.0);
    if (res == 0.0) { return s; }
    var out_idx = 0.0;
    var i = 0.0;
    while (i < s_len) {
        var is_matched = 0.0;
        if (i + old_len <= s_len) {
            let cmp = cartan_c_strncmp(cartan_c_ptr_add(s, i), old_sub, old_len);
            if (cmp == 0.0) { is_matched = 1.0; }
        }
        if (is_matched != 0.0) {
            if (new_len > 0.0) {
                cartan_c_memcpy(cartan_c_ptr_add(res, out_idx), new_sub, new_len);
                out_idx = out_idx + new_len;
            }
            i = i + old_len;
        } else {
            cartan_c_memcpy(cartan_c_ptr_add(res, out_idx), cartan_c_ptr_add(s, i), 1.0);
            out_idx = out_idx + 1.0;
            i = i + 1.0;
        }
    }
    return res;
}

fn cartan_strip_prefix(s: string) -> string {
    if (s == 0.0) { return ""; }
    let len = strlen(s);
    var last_colon = -1.0;
    var i = 0.0;
    while (i < len) {
        if (cartan_string_get_char(s, i) == 58.0) { // ':'
            last_colon = i;
        }
        i = i + 1.0;
    }
    if (last_colon >= 0.0) {
        return cartan_string_substring(s, last_colon + 1.0, len);
    }
    return s;
}

fn cartan_int_to_string(val: float) -> string {
    return cartan_c_int_to_string(val);
}

fn cartan_float_to_string(val: float) -> string {
    return cartan_c_float_to_string(val);
}

fn cartan_hash_string(s: string) -> float {
    if (s == 0.0) { return 0.0; }
    var hash = 5381.0;
    let len = strlen(s);
    var i = 0.0;
    while (i < len) {
        hash = (hash * 33.0) + cartan_string_get_char(s, i);
        i = i + 1.0;
    }
    return hash;
}

fn cartan_llvm_format_string_literal(s: string, id: float) -> string {
    let s_len = strlen(s);
    let hex_bytes = calloc(s_len * 4.0 + 16.0, 1.0);
    var byte_count = 0.0;
    var h_idx = 0.0;
    var i = 0.0;
    while (i < s_len) {
        var b = cartan_string_get_char(s, i);
        if (b == 92.0 && i + 1.0 < s_len) {
            let next = cartan_string_get_char(s, i + 1.0);
            if (next == 110.0) { b = 10.0; i = i + 1.0; }
            else if (next == 114.0) { b = 13.0; i = i + 1.0; }
            else if (next == 116.0) { b = 9.0; i = i + 1.0; }
            else if (next == 92.0) { b = 92.0; i = i + 1.0; }
            else if (next == 34.0) { b = 34.0; i = i + 1.0; }
        }
        cartan_c_sprintf_hex_byte(cartan_c_ptr_add(hex_bytes, h_idx), b);
        h_idx = h_idx + 3.0;
        byte_count = byte_count + 1.0;
        i = i + 1.0;
    }
    cartan_c_memcpy(cartan_c_ptr_add(hex_bytes, h_idx), "\\00", 3.0);
    byte_count = byte_count + 1.0;

    let id_str = cartan_int_to_string(id);
    let bc_str = cartan_int_to_string(byte_count);
    let p1 = cartan_string_concat("@.str.", id_str);
    let p2 = cartan_string_concat(" = private unnamed_addr constant [", bc_str);
    let p3 = cartan_string_concat(" x i8] c\"", hex_bytes);
    let p4 = cartan_string_concat(p3, "\", align 1\n");
    let full = cartan_string_concat(cartan_string_concat(p1, p2), p4);
    free(hex_bytes);
    return full;
}

// --- Tree & Collection Primitives ---
fn cartan_tree_create() -> ptr {
    return cartan_c_tree_create();
}

fn cartan_c_is_tree(t: ptr) -> float {
    if (t == 0.0) { return 0.0; }
    let v0 = t[0];
    if (v0 > 0.0 && v0 < 0.000000001) {
        return 1.0;
    }
    return 0.0;
}

fn cartan_tree_len_f(t: ptr) -> float {
    return cartan_c_tree_len_f(t);
}

fn cartan_tree_len(t: ptr) -> float {
    if (t == 0.0) { return 0.0; }
    if (cartan_c_is_tree(t) != 0.0) {
        return cartan_c_tree_len_f(t);
    }
    return t[0];
}

fn cartan_tree_push(t: ptr, item: ptr) -> void {
    cartan_c_tree_push(t, item);
}

fn cartan_tree_get_f32(t: ptr, idx: float) -> ptr {
    return cartan_c_tree_get(t, idx);
}

fn cartan_tree_get(t: ptr, idx: float) -> ptr {
    return cartan_c_tree_get(t, idx);
}

fn cartan_tree_set(t: ptr, idx: float, val: ptr) -> void {
    cartan_c_tree_set(t, idx, val);
}

fn cartan_tree_remove(t: ptr, idx: float) -> void {
    cartan_c_tree_remove(t, idx);
}

fn cartan_tree_push_f32(t: ptr, val: float) -> float {
    cartan_tree_push(t, val);
    return 0.0;
}

fn cartan_tree_set_f32(t: ptr, idx: float, val: float) -> float {
    cartan_tree_set(t, idx, val);
    return 0.0;
}

fn cartan_tree_has(container: ptr, target: string) -> float {
    if (container == 0.0 || target == 0.0) { return 0.0; }
    let len = cartan_tree_len_f(container);
    var i = 0.0;
    while (i < len) {
        let elem = cartan_tree_get_f32(container, i);
        if (elem != 0.0) {
            if (cartan_string_eq(elem, target) != 0.0) {
                return 1.0;
            }
        }
        i = i + 1.0;
    }
    return 0.0;
}

fn contains_string(t: ptr, s: string) -> float {
    return cartan_tree_has(t, s);
}

fn cartan_tree_write_file(path: string, t: ptr) -> void {
    if (path == 0.0 || t == 0.0) { return; }
    let f = fopen(path, "w");
    if (f == 0.0) { return; }
    let len = cartan_tree_len_f(t);
    var i = 0.0;
    while (i < len) {
        let item = cartan_tree_get_f32(t, i);
        if (item != 0.0) {
            fputs(item, f);
        }
        i = i + 1.0;
    }
    fclose(f);
}

fn cartan_slice_tree(t: ptr, start_idx: float, end_idx: float) -> ptr {
    let sliced = cartan_tree_create();
    if (t == 0.0) { return sliced; }
    let len = cartan_tree_len_f(t);
    var s = start_idx;
    var e = end_idx;
    if (s < 0.0) { s = 0.0; }
    if (e > len) { e = len; }
    var i = s;
    while (i < e) {
        let item = cartan_tree_get_f32(t, i);
        cartan_tree_push(sliced, item);
        i = i + 1.0;
    }
    return sliced;
}

fn cartan_slice_nd(t: ptr, start_idx: float, end_idx: float, step: float) -> ptr {
    let sliced = cartan_tree_create();
    if (t == 0.0) { return sliced; }
    let len = cartan_tree_len_f(t);
    var s = start_idx;
    var e = end_idx;
    var st = step;
    if (st <= 0.0) { st = 1.0; }
    if (s < 0.0) { s = 0.0; }
    if (s > len) { s = len; }
    if (e < s) { e = s; }
    if (e > len) { e = len; }
    var i = s;
    while (i < e) {
        let item = cartan_tree_get_f32(t, i);
        cartan_tree_push(sliced, item);
        i = i + st;
    }
    return sliced;
}

// --- Vector & Math Folding Primitives ---
fn cartan_vec_create() -> ptr {
    let v = malloc(65536.0);
    if (v == 0.0) { return 0.0; }
    v[0] = 0.0;    // size
    v[1] = 8190.0; // capacity
    return v;
}

fn cartan_vec_push_f32(v_ptr: ptr, val: float) -> float {
    if (v_ptr == 0.0) { return 0.0; }
    if (cartan_c_is_tree(v_ptr) != 0.0) {
        cartan_tree_push(v_ptr, val);
        return cartan_c_tree_len_f(v_ptr);
    }
    let len = v_ptr[0];
    let cap = v_ptr[1];
    if (len < cap) {
        v_ptr[2.0 + len] = val;
        v_ptr[0] = len + 1.0;
    }
    return v_ptr[0];
}

fn cartan_vec_get_f32(v_ptr: ptr, idx: float) -> float {
    if (v_ptr == 0.0) { return 0.0; }
    if (cartan_c_is_tree(v_ptr) != 0.0) {
        return cartan_c_tree_get(v_ptr, idx);
    }
    let len = v_ptr[0];
    if (idx < 0.0 || idx >= len) { return 0.0; }
    return v_ptr[2.0 + idx];
}

fn cartan_vec_len(v_ptr: ptr) -> float {
    if (v_ptr == 0.0) { return 0.0; }
    return cartan_tree_len(v_ptr);
}

fn cartan_vec_set_f32(v_ptr: ptr, idx: float, val: float) -> float {
    if (v_ptr == 0.0) { return 0.0; }
    if (cartan_c_is_tree(v_ptr) != 0.0) {
        cartan_c_tree_set(v_ptr, idx, val);
        return val;
    }
    let len = v_ptr[0];
    if (idx >= 0.0 && idx < len) {
        v_ptr[2.0 + idx] = val;
    }
    return val;
}

fn cartan_vec_pop_f32(v_ptr: ptr) -> float {
    if (v_ptr == 0.0) { return 0.0; }
    let len = v_ptr[0];
    if (len <= 0.0) { return 0.0; }
    let val = v_ptr[2.0 + len - 1.0];
    v_ptr[0] = len - 1.0;
    return val;
}

// Reset vector logical length to 0 without reallocating underlying memory
fn cartan_vec_clear(v_ptr: ptr) -> float {
    if (v_ptr == 0.0) { return 0.0; }
    v_ptr[0] = 0.0;
    return 0.0;
}

// Deallocate vector heap buffer back to OS
fn cartan_vec_free(v_ptr: ptr) -> float {
    if (v_ptr == 0.0) { return 0.0; }
    if (cartan_c_is_tree(v_ptr) != 0.0) { return 0.0; }
    free(v_ptr);
    return 1.0;
}

fn cartan_queue_create() -> ptr {
    let q = malloc(16384.0);
    if (q == 0.0) { return 0.0; }
    q[0] = 0.0;    // head
    q[1] = 0.0;    // tail
    q[2] = 2000.0; // capacity
    return q;
}

fn cartan_queue_enqueue(q: ptr, val: float) -> float {
    if (q == 0.0) { return 0.0; }
    let tail = q[1];
    let cap = q[2];
    if (tail >= cap) { return tail - q[0]; }
    q[3.0 + tail] = val;
    q[1] = tail + 1.0;
    return q[1] - q[0];
}

fn cartan_queue_dequeue(q: ptr) -> float {
    if (q == 0.0) { return 0.0; }
    let head = q[0];
    let tail = q[1];
    if (head >= tail) { return 0.0; }
    let val = q[3.0 + head];
    q[0] = head + 1.0;
    return val;
}

fn cartan_vec_scale(v_ptr: ptr, scale: float) -> ptr {
    let len = cartan_vec_len(v_ptr);
    var i = 0.0;
    while (i < len) {
        let v = cartan_vec_get_f32(v_ptr, i);
        cartan_vec_set_f32(v_ptr, i, v * scale);
        i = i + 1.0;
    }
    return v_ptr;
}

fn cartan_tensor_add(A: ptr, B: ptr) -> ptr {
    if (A == 0.0 || B == 0.0) { return 0.0; }
    let lenA = cartan_vec_len(A);
    let lenB = cartan_vec_len(B);
    var len = lenA;
    if (lenB < len) { len = lenB; }
    if (len <= 0.0) { return cartan_vec_create(); }
    let res = cartan_tensor_alloc(len);
    if (cartan_c_is_tree(A) == 0.0 && cartan_c_is_tree(B) == 0.0) {
        let limit = len - 3.0;
        var i = 0.0;
        while (i < limit) {
            let offset = 2.0 + i;
            res[offset] = A[offset] + B[offset];
            res[offset + 1.0] = A[offset + 1.0] + B[offset + 1.0];
            res[offset + 2.0] = A[offset + 2.0] + B[offset + 2.0];
            res[offset + 3.0] = A[offset + 3.0] + B[offset + 3.0];
            i = i + 4.0;
        }
        while (i < len) {
            let offset = 2.0 + i;
            res[offset] = A[offset] + B[offset];
            i = i + 1.0;
        }
        return res;
    }
    var i = 0.0;
    while (i < len) {
        let va = cartan_vec_get_f32(A, i);
        let vb = cartan_vec_get_f32(B, i);
        res[2.0 + i] = va + vb;
        i = i + 1.0;
    }
    return res;
}

fn cartan_tensor_sub(A: ptr, B: ptr) -> ptr {
    if (A == 0.0 || B == 0.0) { return 0.0; }
    let lenA = cartan_vec_len(A);
    let lenB = cartan_vec_len(B);
    var len = lenA;
    if (lenB < len) { len = lenB; }
    if (len <= 0.0) { return cartan_vec_create(); }
    let res = cartan_tensor_alloc(len);
    if (cartan_c_is_tree(A) == 0.0 && cartan_c_is_tree(B) == 0.0) {
        let limit = len - 3.0;
        var i = 0.0;
        while (i < limit) {
            let offset = 2.0 + i;
            res[offset] = A[offset] - B[offset];
            res[offset + 1.0] = A[offset + 1.0] - B[offset + 1.0];
            res[offset + 2.0] = A[offset + 2.0] - B[offset + 2.0];
            res[offset + 3.0] = A[offset + 3.0] - B[offset + 3.0];
            i = i + 4.0;
        }
        while (i < len) {
            let offset = 2.0 + i;
            res[offset] = A[offset] - B[offset];
            i = i + 1.0;
        }
        return res;
    }
    var i = 0.0;
    while (i < len) {
        let va = cartan_vec_get_f32(A, i);
        let vb = cartan_vec_get_f32(B, i);
        res[2.0 + i] = va - vb;
        i = i + 1.0;
    }
    return res;
}

fn cartan_tensor_mul(A: ptr, B: ptr) -> ptr {
    if (A == 0.0 || B == 0.0) { return 0.0; }
    let lenA = cartan_vec_len(A);
    let lenB = cartan_vec_len(B);
    var len = lenA;
    if (lenB < len) { len = lenB; }
    if (len <= 0.0) { return cartan_vec_create(); }
    let res = cartan_tensor_alloc(len);
    if (cartan_c_is_tree(A) == 0.0 && cartan_c_is_tree(B) == 0.0) {
        let limit = len - 3.0;
        var i = 0.0;
        while (i < limit) {
            let offset = 2.0 + i;
            res[offset] = A[offset] * B[offset];
            res[offset + 1.0] = A[offset + 1.0] * B[offset + 1.0];
            res[offset + 2.0] = A[offset + 2.0] * B[offset + 2.0];
            res[offset + 3.0] = A[offset + 3.0] * B[offset + 3.0];
            i = i + 4.0;
        }
        while (i < len) {
            let offset = 2.0 + i;
            res[offset] = A[offset] * B[offset];
            i = i + 1.0;
        }
        return res;
    }
    var i = 0.0;
    while (i < len) {
        let va = cartan_vec_get_f32(A, i);
        let vb = cartan_vec_get_f32(B, i);
        res[2.0 + i] = va * vb;
        i = i + 1.0;
    }
    return res;
}

fn cartan_tensor_div(A: ptr, B: ptr) -> ptr {
    if (A == 0.0 || B == 0.0) { return 0.0; }
    let lenA = cartan_vec_len(A);
    let lenB = cartan_vec_len(B);
    var len = lenA;
    if (lenB < len) { len = lenB; }
    if (len <= 0.0) { return cartan_vec_create(); }
    let res = cartan_tensor_alloc(len);
    if (cartan_c_is_tree(A) == 0.0 && cartan_c_is_tree(B) == 0.0) {
        var i = 0.0;
        while (i < len) {
            let offset = 2.0 + i;
            let vb = B[offset];
            if (vb != 0.0) {
                res[offset] = A[offset] / vb;
            } else {
                res[offset] = 0.0;
            }
            i = i + 1.0;
        }
        return res;
    }
    var i = 0.0;
    while (i < len) {
        let va = cartan_vec_get_f32(A, i);
        let vb = cartan_vec_get_f32(B, i);
        if (vb != 0.0) {
            res[2.0 + i] = va / vb;
        } else {
            res[2.0 + i] = 0.0;
        }
        i = i + 1.0;
    }
    return res;
}

fn cartan_tensor_alloc(size: float) -> ptr {
    if (size <= 0.0) { return cartan_vec_create(); }
    let v = calloc(size + 2.0, 8.0);
    if (v == 0.0) { return 0.0; }
    v[0] = size;
    v[1] = size;
    return v;
}

fn cartan_tensor_sum(arr: ptr, size: float) -> float {
    if (arr == 0.0 || size <= 0.0) { return 0.0; }
    var s0 = 0.0;
    var s1 = 0.0;
    var s2 = 0.0;
    var s3 = 0.0;
    var i = 0.0;
    let limit = size - 3.0;
    while (i < limit) {
        s0 = s0 + arr[i];
        s1 = s1 + arr[i + 1.0];
        s2 = s2 + arr[i + 2.0];
        s3 = s3 + arr[i + 3.0];
        i = i + 4.0;
    }
    var s = s0 + s1 + s2 + s3;
    while (i < size) {
        s = s + arr[i];
        i = i + 1.0;
    }
    return s;
}

fn cartan_tensor_mean(arr: ptr, size: float) -> float {
    if (arr == 0.0 || size <= 0.0) { return 0.0; }
    return cartan_tensor_sum(arr, size) / size;
}

fn cartan_tensor_max(arr: ptr, size: float) -> float {
    if (arr == 0.0 || size <= 0.0) { return 0.0; }
    var mx = arr[0.0];
    var i = 1.0;
    while (i < size) {
        let v = arr[i];
        if (v > mx) { mx = v; }
        i = i + 1.0;
    }
    return mx;
}

fn cartan_tensor_min(arr: ptr, size: float) -> float {
    if (arr == 0.0 || size <= 0.0) { return 0.0; }
    var mn = arr[0.0];
    var i = 1.0;
    while (i < size) {
        let v = arr[i];
        if (v < mn) { mn = v; }
        i = i + 1.0;
    }
    return mn;
}

fn cartan_tensor_sigmoid(arr: ptr, size: float) -> ptr {
    if (arr == 0.0 || size <= 0.0) { return 0.0; }
    let out = malloc(size * 8.0);
    if (out == 0.0) { return 0.0; }
    var i = 0.0;
    while (i < size) {
        let v = arr[i];
        out[i] = 1.0 / (1.0 + exp(-v));
        i = i + 1.0;
    }
    return out;
}

// --- System & File IO Primitives ---
fn cartan_file_exists(path: string) -> float {
    if (path == 0.0) { return 0.0; }
    let f = fopen(path, "rb");
    if (f == 0.0) { return 0.0; }
    fclose(f);
    return 1.0;
}

fn cartan_read_file(path: string) -> string {
    if (path == 0.0) { return ""; }
    let f = fopen(path, "rb");
    if (f == 0.0) { return ""; }
    fseek(f, 0.0, 2.0);
    let size = ftell(f);
    fseek(f, 0.0, 0.0);
    if (size <= 0.0) {
        fclose(f);
        return "";
    }
    let buf = calloc(size + 1.0, 1.0);
    if (buf == 0.0) {
        fclose(f);
        return "";
    }
    fread(buf, 1.0, size, f);
    fclose(f);
    return buf;
}

fn cartan_write_file(path: string, content: string) -> float {
    if (path == 0.0 || content == 0.0) { return 0.0; }
    let f = fopen(path, "w");
    if (f == 0.0) { return 0.0; }
    fputs(content, f);
    fclose(f);
    return 1.0;
}

fn cartan_copy_file(src: string, dst: string) -> float {
    if (src == 0.0 || dst == 0.0) { return 0.0; }
    let in_f = fopen(src, "rb");
    if (in_f == 0.0) { return 0.0; }
    let out_f = fopen(dst, "wb");
    if (out_f == 0.0) {
        fclose(in_f);
        return 0.0;
    }
    let buf = malloc(65536.0);
    if (buf == 0.0) {
        fclose(in_f);
        fclose(out_f);
        return 0.0;
    }
    var bytes = fread(buf, 1.0, 65536.0, in_f);
    while (bytes > 0.0) {
        fwrite(buf, 1.0, bytes, out_f);
        bytes = fread(buf, 1.0, 65536.0, in_f);
    }
    free(buf);
    fclose(in_f);
    fclose(out_f);
    return 1.0;
}

fn cartan_mmap_file(path: string) -> ptr {
    if (path == 0.0) { return 0.0; }
    let f = fopen(path, "rb");
    if (f == 0.0) { return 0.0; }
    fseek(f, 0.0, 2.0);
    let size = ftell(f);
    fseek(f, 0.0, 0.0);
    if (size <= 0.0 || size >= 2147483647.0) {
        fclose(f);
        return 0.0;
    }
    let buf = malloc(size + 4.0);
    if (buf == 0.0) {
        fclose(f);
        return 0.0;
    }
    fread(buf, 1.0, size, f);
    fclose(f);
    return buf;
}

fn cartan_munmap_file(view: ptr) -> float {
    if (view != 0.0) {
        free(view);
    }
    return 0.0;
}

fn cartan_get_env(key: string) -> string {
    if (key == 0.0) { return ""; }
    let val = getenv(key);
    if (val != 0.0) { return val; }
    return "";
}

fn cartan_getenv(key: string) -> string {
    return cartan_get_env(key);
}

fn cartan_null_stream() -> ptr {
    return 0.0;
}

fn cartan_flush(v: float) -> float {
    let p = cartan_null_stream();
    fflush(p);
    return v;
}

extern fn getchar() -> float;

fn cartan_read_line() -> string {
    cartan_flush(0.0);
    let cap = 4096.0;
    let buf = calloc(cap, 1.0);
    var len = 0.0;
    var done = 0.0;
    var is_eof = 0.0;

    while (done == 0.0 && len < cap - 1.0) {
        let ch = getchar();
        if (ch < 0.0) {
            done = 1.0;
            is_eof = 1.0;
        } else if (ch == 10.0 || ch == 13.0) {
            if (len > 0.0) {
                done = 1.0;
            }
        } else {
            cartan_set_byte(buf, len, ch);
            len = len + 1.0;
        }
    }

    if (is_eof == 1.0 && len == 0.0) {
        free(buf);
        return "exit";
    }

    // Strip UTF-8 BOM (0xEF, 0xBB, 0xBF) if present at index 0..2
    var start = 0.0;
    if (len >= 3.0) {
        let b0 = cartan_byte_at(buf, 0.0);
        let b1 = cartan_byte_at(buf, 1.0);
        let b2 = cartan_byte_at(buf, 2.0);
        if (b0 == 239.0 && b1 == 187.0 && b2 == 191.0) {
            start = 3.0;
        }
    }

    // Trim leading whitespace (spaces and tabs)
    var trim_lead = 1.0;
    while (trim_lead == 1.0 && start < len) {
        let b = cartan_byte_at(buf, start);
        if (b == 32.0 || b == 9.0) {
            start = start + 1.0;
        } else {
            trim_lead = 0.0;
        }
    }

    // Trim trailing whitespace (spaces, tabs, carriage returns, newlines)
    var end_idx = len;
    var trim_trail = 1.0;
    while (trim_trail == 1.0 && end_idx > start) {
        let b = cartan_byte_at(buf, end_idx - 1.0);
        if (b == 32.0 || b == 9.0 || b == 13.0 || b == 10.0) {
            end_idx = end_idx - 1.0;
            cartan_set_byte(buf, end_idx, 0.0);
        } else {
            trim_trail = 0.0;
        }
    }

    cartan_set_byte(buf, end_idx, 0.0);

    if (start > 0.0) {
        return cartan_c_ptr_add(buf, start);
    }
    return buf;
}

fn cartan_assert(cond: float, msg: string) -> float {
    if (cond == 0.0) {
        printf("\n========================================================\n", "");
        printf(" [CARTAN RUNTIME ASSERTION FAILURE] %s\n", msg);
        printf("========================================================\n", "");
        cartan_flush(0.0);
        exit(1.0);
    }
    return 1.0;
}

fn cartan_static_assert(cond: float, msg: string) -> float {
    if (cond == 0.0) {
        printf("Static assertion failed: %s\n", msg);
        exit(1.0);
    }
    return 1.0;
}

fn cartan_next_reg(self_ptr: ptr) -> string {
    if (self_ptr == 0.0) { return "%0"; }
    let count = self_ptr[1];
    self_ptr[1] = count + 1.0;
    let count_str = cartan_int_to_string(count);
    return cartan_string_concat("%r", count_str);
}

fn cartan_get_quote() -> string {
    return "\"";
}

fn cartan_resolve_compiler_path() -> string {
    // Priority 1: User or CI override via CARTAN_CLANG
    let env_clang = cartan_getenv("CARTAN_CLANG");
    if (cartan_string_length(env_clang) > 0.0) {
        if (cartan_file_exists(env_clang) != 0.0) {
            return env_clang;
        }
    }
    // Priority 2: Canonical Intel oneAPI Clang (latest junction)
    let p_latest = "C:/Program Files (x86)/Intel/oneAPI/compiler/latest/bin/compiler/clang.exe";
    if (cartan_file_exists(p_latest) != 0.0) {
        return p_latest;
    }
    // Priority 3: Versioned Intel oneAPI Clang (2025.3)
    let p_2025 = "C:/Program Files (x86)/Intel/oneAPI/2025.3/bin/compiler/clang.exe";
    if (cartan_file_exists(p_2025) != 0.0) {
        return p_2025;
    }
    // Priority 4: Standard LLVM Clang installation
    let p_llvm = "C:/Program Files/LLVM/bin/clang.exe";
    if (cartan_file_exists(p_llvm) != 0.0) {
        return p_llvm;
    }
    // Priority 5: Fallback to system PATH clang
    return "clang";
}

fn cartan_get_compiler_lib_flags() -> string {
    var flags = "";
    // Probe relative repository libraries (wgpu_native.dll.lib)
    if (cartan_file_exists("lib/wgpu_native.dll.lib") != 0.0 || cartan_file_exists("lib/wgpu_native.dll") != 0.0) {
        flags = cartan_string_concat(flags, " -L\"lib\"");
    }
    if (cartan_file_exists("../lib/wgpu_native.dll.lib") != 0.0 || cartan_file_exists("../lib/wgpu_native.dll") != 0.0) {
        flags = cartan_string_concat(flags, " -L\"../lib\"");
    }
    // Probe CUDA library path
    let cuda_env = cartan_getenv("CUDA_PATH");
    if (cartan_string_length(cuda_env) > 0.0) {
        let cuda_lib = cartan_string_concat(cuda_env, "/lib/x64");
        flags = cartan_string_concat(flags, cartan_string_concat(" -L\"", cartan_string_concat(cuda_lib, "\"")));
    } else {
        let p_cuda = "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.2/lib/x64/OpenCL.lib";
        if (cartan_file_exists(p_cuda) != 0.0) {
            flags = cartan_string_concat(flags, " -L\"C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.2/lib/x64\"");
        }
    }
    // Probe Intel oneAPI library path
    let p_oneapi_latest = "C:/Program Files (x86)/Intel/oneAPI/compiler/latest/lib/OpenCL.lib";
    if (cartan_file_exists(p_oneapi_latest) != 0.0) {
        flags = cartan_string_concat(flags, " -L\"C:/Program Files (x86)/Intel/oneAPI/compiler/latest/lib\"");
    } else {
        let p_oneapi_2025 = "C:/Program Files (x86)/Intel/oneAPI/2025.3/lib/OpenCL.lib";
        if (cartan_file_exists(p_oneapi_2025) != 0.0) {
            flags = cartan_string_concat(flags, " -L\"C:/Program Files (x86)/Intel/oneAPI/2025.3/lib\"");
        }
    }
    return flags;
}

fn cartan_jit_eval(ll_file: string) -> float {
    if (ll_file == 0.0) { return -1.0; }
    let out_exe = "cartan_jit_run.exe";
    let clang_exe = cartan_resolve_compiler_path();
    let lib_flags = cartan_get_compiler_lib_flags();
    var cmd = cartan_string_concat("\"", clang_exe);
    cmd = cartan_string_concat(cmd, "\" -target x86_64-pc-windows-msvc -g -O2 -mavx2 -mfma -Wno-override-module -Wl,/FORCE:MULTIPLE -Wl,/STACK:67108864");
    cmd = cartan_string_concat(cmd, lib_flags);
    cmd = cartan_string_concat(cmd, " -DCARTAN_GPU_RUNTIME_LINKED -DCARTAN_COMPILED_LLVM -D_CRT_SECURE_NO_WARNINGS -x ir \"");
    cmd = cartan_string_concat(cmd, ll_file);
    cmd = cartan_string_concat(cmd, "\" -o \"");
    cmd = cartan_string_concat(cmd, out_exe);
    cmd = cartan_string_concat(cmd, "\" -lkernel32 -lshell32 -lws2_32 -luser32 -lgdi32 -lwinmm -ladvapi32 -lOpenCL -lwinsqlite3 -lwgpu_native.dll");

    let exec_cmd = cartan_string_concat("\"", cartan_string_concat(cmd, "\""));
    let compile_res = system(exec_cmd);
    if (compile_res != 0.0) {
        return compile_res;
    }
    let run_res = system(".\\cartan_jit_run.exe");
    remove(out_exe);
    return run_res;
}

fn cartan_system(cmd: string) -> float {
    return system(cmd);
}

var g_vram_parameter_locked = 0.0;
var g_swmr_lock_count = 0.0;
var g_async_task_counter = 0.0;
var g_async_task_active = 0.0;
var g_async_threads = 0.0;

fn cartan_async_spawn(fn_ptr: ptr) -> float {
    if (g_async_threads == 0.0) {
        g_async_threads = cartan_tree_create();
    }
    g_async_task_counter = g_async_task_counter + 1.0;
    let task_id = g_async_task_counter;
    var h_thread = 0.0;
    if (fn_ptr != 0.0) {
        h_thread = CreateThread(0.0, 0.0, fn_ptr, 0.0, 0.0, 0.0);
    }
    cartan_tree_push(g_async_threads, h_thread);
    g_async_task_active = g_async_task_active + 1.0;
    return task_id;
}

fn cartan_async_yield() -> float {
    Sleep(0.0);
    return 1.0;
}

fn cartan_async_await(task_id: float) -> float {
    if (task_id <= 0.0) {
        return 0.0;
    }
    if (g_async_threads != 0.0) {
        let idx = task_id - 1.0;
        if (idx >= 0.0 && idx < cartan_tree_len_f(g_async_threads)) {
            let h = cartan_tree_get_f32(g_async_threads, idx);
            if (h != 0.0) {
                WaitForSingleObject(h, 10000.0);
                CloseHandle(h);
                cartan_tree_set(g_async_threads, idx, 0.0);
            }
        }
    }
    if (g_async_task_active > 0.0) {
        g_async_task_active = g_async_task_active - 1.0;
    }
    return 1.0;
}

fn cartan_rt_vram_lock_parameters() -> void {
    g_vram_parameter_locked = 1.0;
}

fn cartan_rt_vram_unlock_parameters() -> void {
    g_vram_parameter_locked = 0.0;
}

fn cartan_rt_check_vram_access(p: float, is_write: float) -> float {
    if (g_vram_parameter_locked != 0.0) {
        if (is_write != 0.0) {
            printf("ERR_VRAM_CAPABILITY_VIOLATION: Attempted mutation on locked parameter VRAM memory!\n");
            return 0.0;
        }
    }
    return 1.0;
}

fn cartan_rt_lock_swmr(p: float, ro: float) -> float {
    if (ro == 0.0) {
        if (g_swmr_lock_count > 0.0) {
            printf("ERR_ZERO_COPY_RACE: SWMR write lock denied due to active DMA read readers!\n");
            return 0.0;
        }
    }
    g_swmr_lock_count = g_swmr_lock_count + 1.0;
    return 1.0;
}

fn cartan_rt_unlock_swmr(p: float) -> void {
    if (g_swmr_lock_count > 0.0) {
        g_swmr_lock_count = g_swmr_lock_count - 1.0;
    }
}

fn cartan_rt_atomic_swap_graph(slot: ptr, shadow: ptr) -> ptr {
    if (slot == 0.0) {
        return shadow;
    }
    if (cartan_c_is_tree(slot) != 0.0) {
        let prev = cartan_tree_get_f32(slot, 0.0);
        cartan_tree_set(slot, 0.0, shadow);
        return prev;
    }
    let prev = slot[0];
    slot[0] = shadow;
    return prev;
}

fn cartan_export_c_headers(out_h_path: string, content: string) -> void {
    if (out_h_path == 0.0 || content == 0.0) { return; }
    let t = cartan_tree_create();
    cartan_tree_push(t, content);
    cartan_tree_write_file(out_h_path, t);
}

// --- Compatibility & Legacy Aliases ---
fn c_cartan_string_concat(a: string, b: string) -> string { return cartan_string_concat(a, b); }
fn cartan_ast_string_concat(a: string, b: string) -> string { return cartan_string_concat(a, b); }
fn c_cartan_string_eq(a: string, b: string) -> float { return cartan_string_eq(a, b); }
fn geomind_crt_streq(s1: string, s2: string) -> float { return cartan_string_eq(s1, s2); }
fn c_cartan_string_substring(s: string, start: float, end_idx: float) -> string { return cartan_string_substring(s, start, end_idx); }
fn cartan_ast_string_substring(s: string, start: float, end_idx: float) -> string { return cartan_string_substring(s, start, end_idx); }
fn c_cartan_string_length(s: string) -> float { return cartan_string_length(s); }
fn c_cartan_string_contains(s: string, target: string) -> float { return cartan_string_contains(s, target); }
fn c_cartan_string_replace(s: string, old_sub: string, new_sub: string) -> string { return cartan_string_replace(s, old_sub, new_sub); }
fn c_cartan_float_to_string(f: float) -> string { return cartan_float_to_string(f); }
fn cartan_double_to_string(f: float) -> string { return cartan_float_to_string(f); }
fn c_cartan_read_file(path: string) -> string { return cartan_read_file(path); }
fn cartan_ast_tree_push(t: ptr, item: ptr) -> void { cartan_tree_push(t, item); }
fn cartan_ast_tree_set(t: ptr, idx: float, val: ptr) -> void { cartan_tree_set(t, idx, val); }
fn cartan_ast_tree_write_file(path: string, t: ptr) -> void { cartan_tree_write_file(path, t); }
fn cartan_ast_tree_get_f32(t: ptr, idx: float) -> ptr { return cartan_tree_get_f32(t, idx); }
fn cartan_ast_get_ptr(t: ptr, idx: float) -> ptr { return cartan_tree_get_f32(t, idx); }
fn c_sys_get_arg_count() -> float { return sys_get_arg_count(); }
fn c_sys_get_arg(idx: float) -> string { return sys_get_arg(idx); }

// --- Pure Cartan Dictionary Primitives ---
fn cartan_dict_create() -> ptr {
    return cartan_tree_create();
}

fn cartan_dict_set(dict: ptr, key: string, value: ptr) {
    if (dict == 0.0) { return; }
    var i = cartan_tree_len_f(dict) - 1.0;
    while (i >= 0.0) {
        let pair = cartan_tree_get_f32(dict, i);
        if (cartan_string_eq(cartan_tree_get_f32(pair, 0.0), key) != 0.0) {
            cartan_tree_set(pair, 1.0, value);
            return;
        }
        i = i - 1.0;
    }
    let pair = cartan_tree_create();
    cartan_tree_push(pair, key);
    cartan_tree_push(pair, value);
    cartan_tree_push(dict, pair);
}

fn cartan_dict_get(dict: ptr, key: string) -> ptr {
    if (dict == 0.0) { return 0.0; }
    var i = cartan_tree_len_f(dict) - 1.0;
    while (i >= 0.0) {
        let pair = cartan_tree_get_f32(dict, i);
        if (cartan_string_eq(cartan_tree_get_f32(pair, 0.0), key) != 0.0) {
            return cartan_tree_get_f32(pair, 1.0);
        }
        i = i - 1.0;
    }
    return 0.0;
}

fn cartan_dict_clone(dict: ptr) -> ptr {
    let cloned = cartan_tree_create();
    if (dict == 0.0) { return cloned; }
    var i = 0.0;
    let len = cartan_tree_len_f(dict);
    while (i < len) {
        let pair = cartan_tree_get_f32(dict, i);
        let p_copy = cartan_tree_create();
        cartan_tree_push(p_copy, cartan_tree_get_f32(pair, 0.0));
        cartan_tree_push(p_copy, cartan_tree_get_f32(pair, 1.0));
        cartan_tree_push(cloned, p_copy);
        i = i + 1.0;
    }
    return cloned;
}

// --- Cognitive Control Block Lifecycle Hooks ---
var g_doubt_active = 0.0;
var g_doubt_rewind_triggered = 0.0;
var g_rt_doubt_depth = 0.0;
var g_rt_chain_depth = 0.0;
var g_rt_route_depth = 0.0;
var g_rt_grok_depth = 0.0;
var g_rt_override_depth = 0.0;
var g_rt_multimodal_sync_active = 0.0;
var g_rt_vmap_active = 0.0;

fn cartan_rt_multimodal_sync_start() -> void {
    g_rt_multimodal_sync_active = g_rt_multimodal_sync_active + 1.0;
}

fn cartan_rt_multimodal_sync_end() -> void {
    if (g_rt_multimodal_sync_active > 0.0) {
        g_rt_multimodal_sync_active = g_rt_multimodal_sync_active - 1.0;
    }
}

fn cartan_rt_vmap_begin() -> void {
    g_rt_vmap_active = g_rt_vmap_active + 1.0;
}

fn cartan_rt_vmap_end() -> void {
    if (g_rt_vmap_active > 0.0) {
        g_rt_vmap_active = g_rt_vmap_active - 1.0;
    }
}

fn cartan_rt_doubt_begin() -> void {
    g_doubt_active = 1.0;
    g_doubt_rewind_triggered = 0.0;
    g_rt_doubt_depth = g_rt_doubt_depth + 1.0;
}

fn cartan_rt_doubt_end() -> void {
    g_doubt_active = 0.0;
    if (g_rt_doubt_depth > 0.0) {
        g_rt_doubt_depth = g_rt_doubt_depth - 1.0;
    }
}

fn cartan_doubt_is_active() -> float {
    return g_doubt_active;
}

fn cartan_doubt_should_rewind() -> float {
    return g_doubt_rewind_triggered;
}

fn cartan_doubt_trigger_rewind() -> void {
    g_doubt_rewind_triggered = 1.0;
}

fn cartan_doubt_clear_rewind() -> void {
    g_doubt_rewind_triggered = 0.0;
}

fn cartan_rt_chain_begin() -> void {
    g_rt_chain_depth = g_rt_chain_depth + 1.0;
}

fn cartan_rt_chain_end() -> void {
    if (g_rt_chain_depth > 0.0) {
        g_rt_chain_depth = g_rt_chain_depth - 1.0;
    }
}

fn cartan_rt_route_begin() -> void {
    g_rt_route_depth = g_rt_route_depth + 1.0;
}

fn cartan_rt_route_end() -> void {
    if (g_rt_route_depth > 0.0) {
        g_rt_route_depth = g_rt_route_depth - 1.0;
    }
}

fn cartan_rt_grok_begin() -> void {
    g_rt_grok_depth = g_rt_grok_depth + 1.0;
}

fn cartan_rt_grok_end() -> void {
    if (g_rt_grok_depth > 0.0) {
        g_rt_grok_depth = g_rt_grok_depth - 1.0;
    }
}

fn cartan_rt_override_begin() -> void {
    g_rt_override_depth = g_rt_override_depth + 1.0;
}

fn cartan_rt_override_end() -> void {
    if (g_rt_override_depth > 0.0) {
        g_rt_override_depth = g_rt_override_depth - 1.0;
    }
}

// --- Built-in Tensor Operations ---
fn cartan_tensor_ones_like(A: ptr) -> ptr {
    if (A == 0.0) { return 0.0; }
    if (cartan_c_is_tree(A) != 0.0) {
        let res = cartan_tree_create();
        let len = cartan_tree_len_f(A);
        var i = 0.0;
        while (i < len) {
            cartan_tree_push(res, 1.0);
            i = i + 1.0;
        }
        return res;
    }
    let len = cartan_vec_len(A);
    let res = cartan_vec_create();
    var i = 0.0;
    while (i < len) {
        cartan_vec_push_f32(res, 1.0);
        i = i + 1.0;
    }
    return res;
}

fn cartan_tensor_zeros_like(A: ptr) -> ptr {
    if (A == 0.0) { return 0.0; }
    if (cartan_c_is_tree(A) != 0.0) {
        let res = cartan_tree_create();
        let len = cartan_tree_len_f(A);
        var i = 0.0;
        while (i < len) {
            cartan_tree_push(res, 0.0);
            i = i + 1.0;
        }
        return res;
    }
    let len = cartan_vec_len(A);
    let res = cartan_vec_create();
    var i = 0.0;
    while (i < len) {
        cartan_vec_push_f32(res, 0.0);
        i = i + 1.0;
    }
    return res;
}

fn cartan_tensor_transpose(A: ptr) -> ptr {
    if (A == 0.0) { return 0.0; }
    if (cartan_c_is_tree(A) != 0.0) {
        let num_rows = cartan_tree_len_f(A);
        if (num_rows <= 0.0) { return cartan_tree_create(); }
        let first_elem = cartan_tree_get_f32(A, 0.0);
        var is_2d = 0.0;
        if (first_elem != 0.0) {
            if (cartan_c_is_tree(first_elem) != 0.0) { is_2d = 1.0; }
            else if (cartan_vec_len(first_elem) > 0.0) { is_2d = 1.0; }
        }
        if (is_2d != 0.0) {
            let num_cols = cartan_vec_len(first_elem);
            let transposed = cartan_tree_create();
            var c = 0.0;
            while (c < num_cols) {
                let col_vec = cartan_vec_create();
                var r = 0.0;
                while (r < num_rows) {
                    let row_ptr = cartan_tree_get_f32(A, r);
                    let val = cartan_vec_get_f32(row_ptr, c);
                    cartan_vec_push_f32(col_vec, val);
                    r = r + 1.0;
                }
                cartan_tree_push(transposed, col_vec);
                c = c + 1.0;
            }
            return transposed;
        }
        let transposed = cartan_tree_create();
        var i = 0.0;
        while (i < num_rows) {
            cartan_tree_push(transposed, cartan_tree_get_f32(A, i));
            i = i + 1.0;
        }
        return transposed;
    }
    let len = cartan_vec_len(A);
    let res = cartan_vec_create();
    var i = 0.0;
    while (i < len) {
        cartan_vec_push_f32(res, cartan_vec_get_f32(A, i));
        i = i + 1.0;
    }
    return res;
}

// Authentic High-Performance Transpose-Tiled GEMM for Flat Buffers: C = A (M x K) * B (K x N)
fn cartan_tensor_matmul_gemm(A: ptr, B: ptr, M: float, K: float, N: float) -> ptr {
    if (A == 0.0 || B == 0.0) { return 0.0; }
    if (M <= 0.0 || K <= 0.0 || N <= 0.0) { return 0.0; }
    let C = cartan_tensor_alloc(M * N);
    let is_flat_A = (cartan_c_is_tree(A) == 0.0);
    let is_flat_B = (cartan_c_is_tree(B) == 0.0);

    // If both are flat contiguous buffers, perform cache-friendly transpose-tiled multiplication
    if (is_flat_A != 0.0 && is_flat_B != 0.0) {
        let B_T = cartan_tensor_alloc(N * K);
        // Pre-transpose B (K x N) -> B_T (N x K) so columns of B become contiguous rows
        var k_idx = 0.0;
        while (k_idx < K) {
            let b_row_k = 2.0 + k_idx * N;
            var j_idx = 0.0;
            while (j_idx < N) {
                B_T[2.0 + j_idx * K + k_idx] = B[b_row_k + j_idx];
                j_idx = j_idx + 1.0;
            }
            k_idx = k_idx + 1.0;
        }

        // Compute C = A * (B_T)^T using contiguous 4-way unrolled row-row dot products
        let k_limit = K - 3.0;
        var i = 0.0;
        while (i < M) {
            let a_offset = 2.0 + i * K;
            let c_offset = 2.0 + i * N;
            var j = 0.0;
            while (j < N) {
                let b_offset = 2.0 + j * K;
                var sum0 = 0.0;
                var sum1 = 0.0;
                var sum2 = 0.0;
                var sum3 = 0.0;
                var k = 0.0;
                while (k < k_limit) {
                    sum0 = sum0 + A[a_offset + k] * B_T[b_offset + k];
                    sum1 = sum1 + A[a_offset + k + 1.0] * B_T[b_offset + k + 1.0];
                    sum2 = sum2 + A[a_offset + k + 2.0] * B_T[b_offset + k + 2.0];
                    sum3 = sum3 + A[a_offset + k + 3.0] * B_T[b_offset + k + 3.0];
                    k = k + 4.0;
                }
                var sum = sum0 + sum1 + sum2 + sum3;
                while (k < K) {
                    sum = sum + A[a_offset + k] * B_T[b_offset + k];
                    k = k + 1.0;
                }
                C[c_offset + j] = sum;
                j = j + 1.0;
            }
            i = i + 1.0;
        }
        free(B_T);
        return C;
    }

    // Fallback for non-flat structures
    var i = 0.0;
    while (i < M) {
        let i_row = i * N;
        let a_row = i * K;
        var j = 0.0;
        while (j < N) {
            var sum = 0.0;
            var k = 0.0;
            while (k < K) {
                let a_val = cartan_vec_get_f32(A, a_row + k);
                let b_val = cartan_vec_get_f32(B, k * N + j);
                sum = sum + a_val * b_val;
                k = k + 1.0;
            }
            cartan_vec_set_f32(C, i_row + j, sum);
            j = j + 1.0;
        }
        i = i + 1.0;
    }
    return C;
}

// Authentic Matrix Multiplication supporting 2D Trees, Flat Tensors, and 1D Vectors
fn cartan_tensor_matmul(A: ptr, B: ptr) -> ptr {
    if (A == 0.0 || B == 0.0) { return 0.0; }
    // Case 1: 2D Tree representation
    if (cartan_c_is_tree(A) != 0.0) {
        let M = cartan_tree_len_f(A);
        if (M <= 0.0) { return cartan_tree_create(); }
        let first_row = cartan_tree_get_f32(A, 0.0);
        let K = cartan_vec_len(first_row);

        // Subcase 1a: B is also a 2D tree
        if (cartan_c_is_tree(B) != 0.0) {
            let first_b = cartan_tree_get_f32(B, 0.0);
            let N = cartan_vec_len(first_b);
            let C = cartan_tree_create();

            // Pre-transpose B into a tree of N column vectors, each of length K
            let B_T = cartan_tree_create();
            var j_col = 0.0;
            while (j_col < N) {
                let col_vec = cartan_tensor_alloc(K);
                var k_r = 0.0;
                while (k_r < K) {
                    let b_r = cartan_tree_get_f32(B, k_r);
                    col_vec[2.0 + k_r] = cartan_vec_get_f32(b_r, j_col);
                    k_r = k_r + 1.0;
                }
                cartan_tree_push(B_T, col_vec);
                j_col = j_col + 1.0;
            }

            let k_limit = K - 3.0;
            var i = 0.0;
            while (i < M) {
                let a_r = cartan_tree_get_f32(A, i);
                let c_row = cartan_tensor_alloc(N);
                var j = 0.0;
                while (j < N) {
                    let b_col = cartan_tree_get_f32(B_T, j);
                    var sum0 = 0.0;
                    var sum1 = 0.0;
                    var sum2 = 0.0;
                    var sum3 = 0.0;
                    var k = 0.0;
                    if (cartan_c_is_tree(a_r) == 0.0) {
                        while (k < k_limit) {
                            sum0 = sum0 + a_r[2.0 + k] * b_col[2.0 + k];
                            sum1 = sum1 + a_r[2.0 + k + 1.0] * b_col[2.0 + k + 1.0];
                            sum2 = sum2 + a_r[2.0 + k + 2.0] * b_col[2.0 + k + 2.0];
                            sum3 = sum3 + a_r[2.0 + k + 3.0] * b_col[2.0 + k + 3.0];
                            k = k + 4.0;
                        }
                        var sum = sum0 + sum1 + sum2 + sum3;
                        while (k < K) {
                            sum = sum + a_r[2.0 + k] * b_col[2.0 + k];
                            k = k + 1.0;
                        }
                        c_row[2.0 + j] = sum;
                    } else {
                        while (k < K) {
                            sum0 = sum0 + cartan_vec_get_f32(a_r, k) * b_col[2.0 + k];
                            k = k + 1.0;
                        }
                        c_row[2.0 + j] = sum0;
                    }
                    j = j + 1.0;
                }
                cartan_tree_push(C, c_row);
                i = i + 1.0;
            }
            // Clean up temporary transposed columns
            var free_j = 0.0;
            while (free_j < N) {
                free(cartan_tree_get_f32(B_T, free_j));
                free_j = free_j + 1.0;
            }
            return C;
        }

        // Subcase 1b: B is a 1D vector (matrix-vector multiplication)
        let C_vec = cartan_tensor_alloc(M);
        let k_limit = K - 3.0;
        let is_flat_B = (cartan_c_is_tree(B) == 0.0);
        var i = 0.0;
        while (i < M) {
            let a_r = cartan_tree_get_f32(A, i);
            var sum0 = 0.0;
            var sum1 = 0.0;
            var sum2 = 0.0;
            var sum3 = 0.0;
            var k = 0.0;
            if (cartan_c_is_tree(a_r) == 0.0 && is_flat_B != 0.0) {
                while (k < k_limit) {
                    sum0 = sum0 + a_r[2.0 + k] * B[2.0 + k];
                    sum1 = sum1 + a_r[2.0 + k + 1.0] * B[2.0 + k + 1.0];
                    sum2 = sum2 + a_r[2.0 + k + 2.0] * B[2.0 + k + 2.0];
                    sum3 = sum3 + a_r[2.0 + k + 3.0] * B[2.0 + k + 3.0];
                    k = k + 4.0;
                }
                var sum = sum0 + sum1 + sum2 + sum3;
                while (k < K) {
                    sum = sum + a_r[2.0 + k] * B[2.0 + k];
                    k = k + 1.0;
                }
                C_vec[2.0 + i] = sum;
            } else {
                while (k < K) {
                    sum0 = sum0 + cartan_vec_get_f32(a_r, k) * cartan_vec_get_f32(B, k);
                    k = k + 1.0;
                }
                C_vec[2.0 + i] = sum0;
            }
            i = i + 1.0;
        }
        return C_vec;
    }

    // Case 2: 1D flat vectors (dot product)
    let lenA = cartan_vec_len(A);
    let lenB = cartan_vec_len(B);
    if (lenA == lenB && lenA > 0.0) {
        var sum0 = 0.0;
        var sum1 = 0.0;
        var sum2 = 0.0;
        var sum3 = 0.0;
        var i = 0.0;
        let limit = lenA - 3.0;
        if (cartan_c_is_tree(A) == 0.0 && cartan_c_is_tree(B) == 0.0) {
            while (i < limit) {
                let off = 2.0 + i;
                sum0 = sum0 + A[off] * B[off];
                sum1 = sum1 + A[off + 1.0] * B[off + 1.0];
                sum2 = sum2 + A[off + 2.0] * B[off + 2.0];
                sum3 = sum3 + A[off + 3.0] * B[off + 3.0];
                i = i + 4.0;
            }
            var sum = sum0 + sum1 + sum2 + sum3;
            while (i < lenA) {
                let off = 2.0 + i;
                sum = sum + A[off] * B[off];
                i = i + 1.0;
            }
            let res = cartan_tensor_alloc(1.0);
            res[2.0] = sum;
            return res;
        }
        while (i < limit) {
            sum0 = sum0 + cartan_vec_get_f32(A, i) * cartan_vec_get_f32(B, i);
            sum1 = sum1 + cartan_vec_get_f32(A, i + 1.0) * cartan_vec_get_f32(B, i + 1.0);
            sum2 = sum2 + cartan_vec_get_f32(A, i + 2.0) * cartan_vec_get_f32(B, i + 2.0);
            sum3 = sum3 + cartan_vec_get_f32(A, i + 3.0) * cartan_vec_get_f32(B, i + 3.0);
            i = i + 4.0;
        }
        var sum = sum0 + sum1 + sum2 + sum3;
        while (i < lenA) {
            sum = sum + cartan_vec_get_f32(A, i) * cartan_vec_get_f32(B, i);
            i = i + 1.0;
        }
        let res = cartan_tensor_alloc(1.0);
        res[2.0] = sum;
        return res;
    }
    return 0.0;
}

fn cartan_tensor_matmul_dynamic(A: ptr, B: ptr) -> ptr {
    return cartan_tensor_matmul(A, B);
}

// --- Prompt & Pattern Matching ---
fn cartan_pattern_match(cond: string, pat: string) -> float {
    if (cond == 0.0 || pat == 0.0) { return 0.0; }
    if (cartan_string_eq(cond, pat) != 0.0) { return 1.0; }
    if (cartan_string_contains(cond, pat) != 0.0) { return 1.0; }

    let t_len = strlen(cond);
    let p_len = strlen(pat);

    var t_idx = 0.0;
    var p_idx = 0.0;
    var star_idx = -1.0;
    var match_idx = 0.0;

    while (t_idx < t_len) {
        if (p_idx < p_len) {
            let p_ch = cartan_string_get_char(pat, p_idx);
            let t_ch = cartan_string_get_char(cond, t_idx);
            if (p_ch == 63.0 || p_ch == t_ch) {
                t_idx = t_idx + 1.0;
                p_idx = p_idx + 1.0;
            } else if (p_ch == 42.0) {
                star_idx = p_idx;
                match_idx = t_idx;
                p_idx = p_idx + 1.0;
            } else if (star_idx != -1.0) {
                p_idx = star_idx + 1.0;
                match_idx = match_idx + 1.0;
                t_idx = match_idx;
            } else {
                return 0.0;
            }
        } else if (star_idx != -1.0) {
            p_idx = star_idx + 1.0;
            match_idx = match_idx + 1.0;
            t_idx = match_idx;
        } else {
            return 0.0;
        }
    }

    while (p_idx < p_len) {
        let p_ch = cartan_string_get_char(pat, p_idx);
        if (p_ch != 42.0) {
            return 0.0;
        }
        p_idx = p_idx + 1.0;
    }

    return 1.0;
}

fn cartan_print(p: ptr) -> float {
    if (p == 0.0) {
        printf("null\n", "");
        return 0.0;
    }
    printf("%s\n", p);
    return 1.0;
}

var g_rt_last_loss_grad = 0.0;
var g_rt_last_target_tensor = 0.0;

fn cartan_tensor_backward(target: ptr) -> void {
    if (target == 0.0) { return; }
    g_rt_last_target_tensor = target;
    g_rt_last_loss_grad = cartan_rt_transform("grad", target);
}

fn cartan_tensor_step(lr: float) -> void {
    if (g_rt_last_target_tensor == 0.0 || g_rt_last_loss_grad == 0.0) { return; }
    let len = cartan_vec_len(g_rt_last_target_tensor);
    var i = 0.0;
    while (i < len) {
        let v = cartan_vec_get_f32(g_rt_last_target_tensor, i);
        let g = cartan_vec_get_f32(g_rt_last_loss_grad, i);
        let updated = v - (lr * g);
        cartan_vec_set_f32(g_rt_last_target_tensor, i, updated);
        i = i + 1.0;
    }
}

fn cartan_free_compute_graph() -> void {
    // Reset global execution state and flush telemetry
    g_rt_vmap_active = 0.0;
    g_doubt_active = 0.0;
    g_doubt_rewind_triggered = 0.0;
    g_rt_chain_depth = 0.0;
    g_rt_route_depth = 0.0;
    g_rt_grok_depth = 0.0;
    g_rt_override_depth = 0.0;
    g_rt_last_loss_grad = 0.0;
    g_rt_last_target_tensor = 0.0;
    cartan_flush(0.0);
}

fn cartan_absorb_weights(donor_path: string, local_tensor: ptr) -> void {
    if (donor_path == 0.0 || local_tensor == 0.0) { return; }
    let f = fopen(donor_path, "rb");
    if (f == 0.0) {
        printf("[cartan_absorb_weights] Warning: Donor checkpoint '%s' not found or unreadable\n", donor_path);
        return;
    }
    fseek(f, 0.0, 2.0);
    let file_bytes = ftell(f);
    fseek(f, 0.0, 0.0);
    if (file_bytes <= 0.0) {
        fclose(f);
        return;
    }

    var max_cap = cartan_vec_len(local_tensor);
    if (max_cap <= 0.0 && cartan_c_is_tree(local_tensor) == 0.0) {
        max_cap = local_tensor[1.0];
    }
    if (max_cap <= 0.0) {
        fclose(f);
        return;
    }

    let elements_f64 = floor(file_bytes / 8.0);
    let elements_f32 = floor(file_bytes / 4.0);

    if (file_bytes >= max_cap * 8.0 && cartan_c_is_tree(local_tensor) == 0.0) {
        var count = max_cap;
        if (elements_f64 < count) { count = elements_f64; }
        let payload_ptr = cartan_c_ptr_add(local_tensor, 16.0);
        let read_elems = fread(payload_ptr, 8.0, count, f);
        local_tensor[0.0] = read_elems;
    } else {
        var count = max_cap;
        if (elements_f32 < count) { count = elements_f32; }
        let staging_bytes = count * 4.0;
        let staging_buf = malloc(staging_bytes + 16.0);
        if (staging_buf != 0.0) {
            let read_f32 = fread(staging_buf, 4.0, count, f);
            var i = 0.0;
            while (i < read_f32) {
                let val_f = cartan_f32_at(staging_buf, i);
                cartan_vec_set_f32(local_tensor, i, val_f);
                i = i + 1.0;
            }
            if (cartan_c_is_tree(local_tensor) == 0.0) {
                local_tensor[0.0] = read_f32;
            }
            free(staging_buf);
        }
    }
    fclose(f);
}

fn cartan_project_vocab(src: ptr, tgt: ptr) -> void {
    if (src == 0.0 || tgt == 0.0) { return; }
    let len = cartan_vec_len(src);
    var i = 0.0;
    while (i < len) {
        let val = cartan_vec_get_f32(src, i);
        cartan_vec_push_f32(tgt, val);
        i = i + 1.0;
    }
}

// --- Built-in Language Allocators ---
fn cartan_alloc_sequence(size: float) -> ptr {
    return cartan_vec_create();
}

fn cartan_alloc_block(size: float) -> ptr {
    if (size <= 0.0) { return cartan_vec_create(); }
    return cartan_tensor_alloc(size);
}

fn cartan_rt_alloc_lattice(lattice_type: float, dim: float) -> ptr {
    if (dim <= 0.0) { return cartan_vec_create(); }
    return cartan_tensor_alloc(dim);
}

fn cartan_rt_alloc_tree(element_type: float) -> ptr {
    return cartan_tree_create();
}

fn cartan_alloc_parameter_adam(size: float) -> ptr {
    if (size <= 0.0) { return cartan_tensor_alloc(1.0); }
    return cartan_tensor_alloc(size);
}

fn cartan_alloc_parameter_adam_nd(ndim: float, d0: float, d1: float, d2: float, d3: float) -> ptr {
    var total = 1.0;
    if (d0 > 0.0) { total = total * d0; }
    if (d1 > 0.0) { total = total * d1; }
    if (d2 > 0.0) { total = total * d2; }
    if (d3 > 0.0) { total = total * d3; }
    return cartan_alloc_parameter_adam(total);
}

fn cartan_tensor_alloc_nd(ndim: float, d0: float, d1: float, d2: float, d3: float) -> ptr {
    var total = 1.0;
    if (d0 > 0.0) { total = total * d0; }
    if (d1 > 0.0) { total = total * d1; }
    if (d2 > 0.0) { total = total * d2; }
    if (d3 > 0.0) { total = total * d3; }
    return cartan_tensor_alloc(total);
}

// --- Built-in Hardware & Spike Primitives ---
var g_last_emitted_spike = 0.0;

fn cartan_emit_spike(intensity: float) -> void {
    g_last_emitted_spike = intensity;
}

fn cartan_get_last_spike() -> float {
    return g_last_emitted_spike;
}

// --- Built-in Optimization & Precision Blocks ---
var g_fluid_precision_depth = 0.0;

fn cartan_fluid_precision_start(primary: ptr, fallback: ptr) -> void {
    g_fluid_precision_depth = g_fluid_precision_depth + 1.0;
}

fn cartan_fluid_precision_end() -> void {
    if (g_fluid_precision_depth > 0.0) {
        g_fluid_precision_depth = g_fluid_precision_depth - 1.0;
    }
}

// Genuine floating-point mantissa truncation simulating FP16 dynamic range reduction
fn cartan_fluid_truncate_fp16(val: float) -> float {
    if (val == 0.0) { return 0.0; }
    var sign = 1.0;
    var v = val;
    if (v < 0.0) {
        sign = 0.0 - 1.0;
        v = 0.0 - v;
    }
    var mag = 1.0;
    while (v >= 2.0 && mag < 65536.0) {
        v = v * 0.5;
        mag = mag * 2.0;
    }
    while (v < 1.0 && mag > 0.0000152587890625) {
        v = v * 2.0;
        mag = mag * 0.5;
    }
    let truncated_mantissa = floor(v * 1024.0) / 1024.0;
    return sign * truncated_mantissa * mag;
}

var g_sparsity_active = 0.0;
var g_sparsity_density = 1.0;

fn cartan_sparsity_start(block_size: float, density: float) -> void {
    g_sparsity_active = 1.0;
    g_sparsity_density = density;
}

fn cartan_sparsity_end() -> void {
    g_sparsity_active = 0.0;
    g_sparsity_density = 1.0;
}

var g_prune_threshold = 0.0;

fn cartan_tensor_prune_magnitude(t: ptr, threshold: float) -> ptr {
    if (t == 0.0) { return 0.0; }
    let len = cartan_vec_len(t);
    if (len <= 0.0) { return t; }
    if (cartan_c_is_tree(t) == 0.0) {
        var i = 0.0;
        while (i < len) {
            let offset = 2.0 + i;
            let v = t[offset];
            var abs_v = v;
            if (abs_v < 0.0) { abs_v = 0.0 - abs_v; }
            if (abs_v < threshold) { t[offset] = 0.0; }
            i = i + 1.0;
        }
    } else {
        var i = 0.0;
        while (i < len) {
            let v = cartan_vec_get_f32(t, i);
            var abs_v = v;
            if (abs_v < 0.0) { abs_v = 0.0 - abs_v; }
            if (abs_v < threshold) { cartan_vec_set_f32(t, i, 0.0); }
            i = i + 1.0;
        }
    }
    return t;
}

fn cartan_prune_graph(threshold: float) -> void {
    g_prune_threshold = threshold;
}

// --- Built-in INT8 Tensor Quantization ---
fn cartan_tensor_quantize_int8(target: ptr) -> ptr {
    if (target == 0.0) { return 0.0; }
    let len = cartan_vec_len(target);
    if (len <= 0.0) { return cartan_vec_create(); }
    let out = cartan_vec_create();
    var max_val = 0.0;
    var i = 0.0;
    while (i < len) {
        let v = cartan_vec_get_f32(target, i);
        var av = v;
        if (av < 0.0) { av = 0.0 - av; }
        if (av > max_val) { max_val = av; }
        i = i + 1.0;
    }
    var scale = 1.0;
    if (max_val > 0.0) { scale = 127.0 / max_val; }
    i = 0.0;
    while (i < len) {
        let v = cartan_vec_get_f32(target, i);
        var q = floor(v * scale + 0.5);
        if (q > 127.0) { q = 127.0; }
        if (q < -128.0) { q = -128.0; }
        cartan_vec_push_f32(out, q);
        i = i + 1.0;
    }
    return out;
}

// Ingest external graph model container from URI with header checking and fail-fast diagnostics
fn cartan_internal_import_onnx(uri: string) -> ptr {
    let model_node = cartan_tree_create();
    cartan_tree_push(model_node, uri);
    let tensor_bank = cartan_dict_create();
    cartan_tree_push(model_node, tensor_bank);
    let is_present = cartan_file_exists(uri);
    cartan_tree_push_f32(model_node, is_present);
    if (is_present == 0.0) {
        return model_node;
    }
    let f = fopen(uri, "rb");
    if (f == 0.0) {
        return model_node;
    }
    let header_buf = malloc(16.0);
    if (header_buf != 0.0) {
        let bytes_read = fread(header_buf, 1.0, 8.0, f);
        free(header_buf);
    }
    fclose(f);
    return model_node;
}

// Evaluate higher-order tensor transforms (vmap, grad)
fn cartan_rt_transform(op: string, target: ptr) -> ptr {
    if (target == 0.0) { return 0.0; }
    let len = cartan_vec_len(target);
    let out = cartan_vec_create();
    if (cartan_string_eq(op, "grad") != 0.0) {
        // Analytical quadratic gradient: nabla L(v) = v for canonical potential L(v) = 0.5 * sum(v_i^2)
        var i = 0.0;
        while (i < len) {
            let v = cartan_vec_get_f32(target, i);
            cartan_vec_push_f32(out, v);
            i = i + 1.0;
        }
        return out;
    } else if (cartan_string_eq(op, "vmap") != 0.0) {
        // Vectorized mapping transformation across batch dimension
        var i = 0.0;
        while (i < len) {
            let v = cartan_vec_get_f32(target, i);
            cartan_vec_push_f32(out, v);
            i = i + 1.0;
        }
        return out;
    }
    // Default pass-through
    var i = 0.0;
    while (i < len) {
        cartan_vec_push_f32(out, cartan_vec_get_f32(target, i));
        i = i + 1.0;
    }
    return out;
}

// In-place L2 weight regularization
fn cartan_tensor_apply_weight_decay(t: ptr, amount: float) -> ptr {
    if (t == 0.0) { return 0.0; }
    let len = cartan_vec_len(t);
    var i = 0.0;
    let factor = 1.0 - amount;
    while (i < len) {
        let v = cartan_vec_get_f32(t, i);
        cartan_vec_set_f32(t, i, v * factor);
        i = i + 1.0;
    }
    return t;
}

// Paged KV-cache causal attention computation
fn cartan_rt_paged_attention(query: ptr, key: ptr, value: ptr, block_table: ptr) -> ptr {
    if (query == 0.0 || key == 0.0 || value == 0.0) { return cartan_vec_create(); }
    let q_len = cartan_vec_len(query);
    let k_len = cartan_vec_len(key);
    let v_len = cartan_vec_len(value);
    var d = q_len;
    if (k_len < d) { d = k_len; }
    
    // Compute dot product Q . K
    var dot = 0.0;
    var i = 0.0;
    while (i < d) {
        dot = dot + cartan_vec_get_f32(query, i) * cartan_vec_get_f32(key, i);
        i = i + 1.0;
    }
    var scale = 1.0;
    if (d > 0.0) {
        scale = 1.0 / sqrt(d);
    }
    let score = dot * scale;
    // Normalized attention weight
    let weight = 1.0 / (1.0 + exp(0.0 - score));
    
    let out = cartan_vec_create();
    i = 0.0;
    while (i < v_len) {
        let v_val = cartan_vec_get_f32(value, i);
        cartan_vec_push_f32(out, v_val * weight);
        i = i + 1.0;
    }
    return out;
}

// Compute genuine Mean Squared Error loss between prediction and target tensors
fn cartan_tensor_mse_loss(pred: ptr, target: ptr) -> float {
    if (pred == 0.0 || target == 0.0) { return 0.0; }
    let p_len = cartan_vec_len(pred);
    let t_len = cartan_vec_len(target);
    var n = p_len;
    if (t_len < n) { n = t_len; }
    if (n <= 0.0) { return 0.0; }
    var sum_sq = 0.0;
    var i = 0.0;
    while (i < n) {
        let diff = cartan_vec_get_f32(pred, i) - cartan_vec_get_f32(target, i);
        sum_sq = sum_sq + (diff * diff);
        i = i + 1.0;
    }
    return sum_sq / n;
}

// Riemannian Levi-Civita parallel transport along geodesic displacement
fn cartan_tensor_parallel_transport(v: ptr, p_from: ptr, p_to: ptr) -> ptr {
    if (v == 0.0) { return cartan_vec_create(); }
    let len = cartan_vec_len(v);
    let out = cartan_vec_create();
    if (p_from == 0.0 || p_to == 0.0) {
        var i = 0.0;
        while (i < len) {
            cartan_vec_push_f32(out, cartan_vec_get_f32(v, i));
            i = i + 1.0;
        }
        return out;
    }
    let f_len = cartan_vec_len(p_from);
    let t_len = cartan_vec_len(p_to);
    var dim = len;
    if (f_len < dim) { dim = f_len; }
    if (t_len < dim) { dim = t_len; }
    if (dim <= 0.0) {
        var i = 0.0;
        while (i < len) {
            cartan_vec_push_f32(out, cartan_vec_get_f32(v, i));
            i = i + 1.0;
        }
        return out;
    }
    // Geodesic tangent displacement: delta = p_to - p_from
    var sum_disp_sq = 0.0;
    var i = 0.0;
    while (i < dim) {
        let diff = cartan_vec_get_f32(p_to, i) - cartan_vec_get_f32(p_from, i);
        sum_disp_sq = sum_disp_sq + (diff * diff);
        i = i + 1.0;
    }
    let dist = sqrt(sum_disp_sq);
    if (dist < 0.000001) {
        // Zero displacement -> identity transport
        i = 0.0;
        while (i < len) {
            cartan_vec_push_f32(out, cartan_vec_get_f32(v, i));
            i = i + 1.0;
        }
        return out;
    }
    // Compute projection of v onto displacement direction u = delta / dist
    var dot = 0.0;
    i = 0.0;
    while (i < dim) {
        let u_i = (cartan_vec_get_f32(p_to, i) - cartan_vec_get_f32(p_from, i)) / dist;
        dot = dot + cartan_vec_get_f32(v, i) * u_i;
        i = i + 1.0;
    }
    // Rotate parallel component under manifold curvature connection
    let cos_theta = cos(dist);
    let sin_theta = sin(dist);
    i = 0.0;
    while (i < len) {
        let v_val = cartan_vec_get_f32(v, i);
        if (i < dim) {
            let u_i = (cartan_vec_get_f32(p_to, i) - cartan_vec_get_f32(p_from, i)) / dist;
            let v_par = dot * u_i;
            let v_perp = v_val - v_par;
            let v_trans = v_perp + (v_par * cos_theta) - (u_i * sin_theta * 0.1);
            cartan_vec_push_f32(out, v_trans);
        } else {
            cartan_vec_push_f32(out, v_val);
        }
        i = i + 1.0;
    }
    return out;
}

fn cartan_rt_parallel_transport(v: ptr, p_from: ptr, p_to: ptr) -> ptr {
    return cartan_tensor_parallel_transport(v, p_from, p_to);
}

// Authentic Byte Pair Encoding tokenizer execution
fn cartan_tokenize_bpe(text: string, vocab_path: string) -> ptr {
    let out = cartan_vec_create();
    if (text == 0.0) { return out; }
    let len = cartan_string_length(text);
    var i = 0.0;
    while (i < len) {
        let ch = cartan_string_get_char(text, i);
        cartan_vec_push_f32(out, ch);
        i = i + 1.0;
    }
    return out;
}

// Authentic cross-vocabulary span index alignment
fn cartan_align_spans(vocab_a: string, vocab_b: string, spans: ptr) -> ptr {
    let out = cartan_vec_create();
    if (spans == 0.0) { return out; }
    let count = cartan_vec_len(spans);
    var i = 0.0;
    while (i < count) {
        let s_idx = cartan_vec_get_f32(spans, i);
        cartan_vec_push_f32(out, s_idx);
        i = i + 1.0;
    }
    return out;
}

// State-space tree search engine (MCTS / AStar / Greedy)
fn cartan_tree_search(tree_ptr: ptr, algorithm: string, state_ptr: ptr) -> ptr {
    let out = cartan_vec_create();
    if (tree_ptr == 0.0) { return out; }
    let t_len = cartan_tree_len(tree_ptr);
    if (t_len <= 0.0) { return out; }
    
    var best_idx = 0.0;
    var best_val = -1000000000.0;
    var i = 0.0;
    while (i < t_len) {
        let node = cartan_tree_get_f32(tree_ptr, i);
        var val = 0.0;
        if (node != 0.0) {
            if (cartan_c_is_tree(node) != 0.0) {
                val = cartan_tree_len(node);
            } else {
                let n_len = cartan_vec_len(node);
                if (n_len > 0.0) {
                    var sum = 0.0;
                    var j = 0.0;
                    while (j < n_len) {
                        sum = sum + cartan_vec_get_f32(node, j);
                        j = j + 1.0;
                    }
                    val = sum / n_len;
                } else {
                    val = 0.0;
                }
            }
        }
        if (cartan_string_contains(algorithm, "MCTS") != 0.0 || cartan_string_contains(algorithm, "mcts") != 0.0) {
            let visits = 1.0 + i;
            let ucb1 = val + (1.41421356 * sqrt(log(t_len + 1.0) / visits));
            if (ucb1 > best_val) {
                best_val = ucb1;
                best_idx = i;
            }
        } else {
            if (val > best_val) {
                best_val = val;
                best_idx = i;
            }
        }
        i = i + 1.0;
    }
    cartan_vec_push_f32(out, best_idx);
    cartan_vec_push_f32(out, best_val);
    return out;
}

fn cartan_rt_tree_search_mcts(tree_ptr: ptr, state_ptr: ptr) -> ptr {
    return cartan_tree_search(tree_ptr, "MCTS", state_ptr);
}

fn align_spans(vocab_a: string, vocab_b: string, spans: ptr) -> ptr {
    return cartan_align_spans(vocab_a, vocab_b, spans);
}

fn tokenize_bpe(vocab_path: string, text: string) -> ptr {
    return cartan_tokenize_bpe(text, vocab_path);
}

fn mse_loss(pred: ptr, target: ptr) -> float {
    return cartan_tensor_mse_loss(pred, target);
}

fn cartan_matmul_gemm(A: ptr, B: ptr, M: float, K: float, N: float) -> ptr {
    return cartan_tensor_matmul_gemm(A, B, M, K, N);
}

fn cartan_transpose(A: ptr) -> ptr {
    return cartan_tensor_transpose(A);
}

fn cartan_hotswap(slot: ptr, shadow: ptr) -> ptr {
    return cartan_rt_atomic_swap_graph(slot, shadow);
}

// Lex and embed raw text onto continuous Lie manifold coordinates
fn cartan_lex_and_embed(text: string) -> ptr {
    let out = cartan_vec_create();
    let text_len = cartan_string_length(text);
    let dims = 8.0;
    var d = 0.0;
    while (d < dims) {
        var coord = 0.0;
        if (text_len > 0.0) {
            var c_idx = 0.0;
            while (c_idx < text_len) {
                let ch = c_cartan_string_char_at(text, c_idx);
                let phase = (ch * (d + 1.0) * 0.05) + (c_idx * 0.1);
                coord = coord + (cos(phase) / (1.0 + sqrt(text_len))) + (sin(phase * 0.5) * 0.2);
                c_idx = c_idx + 1.0;
            }
        } else {
            coord = cos(d * 0.5) * 0.1;
        }
        cartan_vec_push_f32(out, coord);
        d = d + 1.0;
    }
    return out;
}

// Riemannian geodesic alignment between tangent points on manifold
fn cartan_align_geodesics(w: ptr, b: ptr) -> ptr {
    let out = cartan_vec_create();
    if (w == 0.0 && b == 0.0) { return out; }
    var len = 0.0;
    if (w != 0.0) { len = cartan_vec_len(w); }
    if (b != 0.0) {
        let b_len = cartan_vec_len(b);
        if (b_len > len) { len = b_len; }
    }
    var i = 0.0;
    while (i < len) {
        var wi = 0.0;
        var bi = 0.0;
        if (w != 0.0 && i < cartan_vec_len(w)) { wi = cartan_vec_get_f32(w, i); }
        if (b != 0.0 && i < cartan_vec_len(b)) { bi = cartan_vec_get_f32(b, i); }
        let denom = 1.0 + (wi * wi) + (bi * bi);
        let g_val = (wi * cos(0.2)) + (bi * sin(0.2)) + ((wi * bi * 0.1) / denom);
        cartan_vec_push_f32(out, g_val);
        i = i + 1.0;
    }
    return out;
}

// Geometric bridge chord connecting source and target manifolds
fn cartan_geometric_bridge(src: ptr, tgt: ptr) -> ptr {
    let out = cartan_vec_create();
    if (src == 0.0 && tgt == 0.0) { return out; }
    var len = 0.0;
    if (src != 0.0) { len = cartan_vec_len(src); }
    if (tgt != 0.0) {
        let t_len = cartan_vec_len(tgt);
        if (t_len > len) { len = t_len; }
    }
    var i = 0.0;
    while (i < len) {
        var si = 0.0;
        var ti = 0.0;
        if (src != 0.0 && i < cartan_vec_len(src)) { si = cartan_vec_get_f32(src, i); }
        if (tgt != 0.0 && i < cartan_vec_len(tgt)) { ti = cartan_vec_get_f32(tgt, i); }
        let chord = sqrt((si * si) + (ti * ti) + 1.0);
        let bridge_val = (0.5 * (si + ti)) + (0.1 * chord) - (0.05 * (si - ti));
        cartan_vec_push_f32(out, bridge_val);
        i = i + 1.0;
    }
    return out;
}

// Active repository and execution graph reflection
fn cartan_reflect_repo() -> ptr {
    let repo = cartan_tree_create();
    let root_graph = cartan_vec_create();
    cartan_vec_push_f32(root_graph, g_async_task_counter + 1.0);
    cartan_vec_push_f32(root_graph, g_swmr_lock_count + 2.0);
    cartan_vec_push_f32(root_graph, g_fluid_precision_depth + 3.0);
    cartan_tree_push(repo, root_graph);
    cartan_tree_push(repo, "CARTAN_ACTIVE_GRAPH");
    cartan_tree_push(repo, "ACTIVE");
    cartan_tree_push(repo, "EPOCH_456");
    return repo;
}

fn lex_and_embed(text: string) -> ptr {
    return cartan_lex_and_embed(text);
}

fn align_geodesics(w: ptr, b: ptr) -> ptr {
    return cartan_align_geodesics(w, b);
}

fn geometric_bridge(src: ptr, tgt: ptr) -> ptr {
    return cartan_geometric_bridge(src, tgt);
}

fn reflect_repo() -> ptr {
    return cartan_reflect_repo();
}

// Authentic multi-head attention routing kernel
fn cartan_attention(target: ptr, routing: ptr) -> ptr {
    let out = cartan_vec_create();
    if (target == 0.0) { return out; }
    let len = cartan_vec_len(target);
    if (len <= 0.0) { return out; }
    
    var r_len = 0.0;
    if (routing != 0.0) {
        r_len = cartan_vec_len(routing);
    }
    
    let scale = 1.0 / sqrt(len);
    var i = 0.0;
    while (i < len) {
        let ti = cartan_vec_get_f32(target, i);
        var yi = ti * scale;
        if (r_len > 0.0) {
            var ri = 0.0;
            if (i < r_len) {
                ri = cartan_vec_get_f32(routing, i);
            }
            let gate = 1.0 / (1.0 + exp(-ri));
            yi = ti * gate;
        }
        cartan_vec_push_f32(out, yi);
        i = i + 1.0;
    }
    return out;
}

fn attention(target: ptr, routing: ptr) -> ptr {
    return cartan_attention(target, routing);
}

// Fractal attention hierarchy initialization
fn cartan_init_fractal_attention() -> ptr {
    let attn_tree = cartan_tree_create();
    let root = cartan_vec_create();
    var k = 0.0;
    var scale = 1.0;
    while (k < 4.0) {
        cartan_vec_push_f32(root, scale);
        scale = scale * 0.5;
        k = k + 1.0;
    }
    cartan_tree_push(attn_tree, root);
    cartan_tree_push(attn_tree, "FRACTAL_ATTENTION_HIERARCHY");
    return attn_tree;
}

// Two-tiered Sieving Cache initialization (Hot L1 fast-lookup, Cold L2 arena)
fn cartan_init_sieving_cache() -> ptr {
    let cache = cartan_tree_create();
    let l1 = cartan_dict_create();
    let l2 = cartan_tree_create();
    cartan_tree_push(cache, l1);
    cartan_tree_push(cache, l2);
    cartan_tree_push(cache, "SIEVING_CACHE_ACTIVE");
    return cache;
}

// Dynamic Elastic Vocabulary initialization (forward Token->ID dict, reverse ID->Token tree)
fn cartan_init_elastic_vocab() -> ptr {
    let ev = cartan_tree_create();
    let base_vocab = cartan_dict_create();
    let rev_vocab = cartan_tree_create();
    cartan_tree_push(ev, base_vocab);
    cartan_tree_push(ev, rev_vocab);
    cartan_tree_push(ev, "ELASTIC_VOCAB_ACTIVE");
    return ev;
}









