// --- Built-in Tensor Operations ---
fn cartan_tensor_ones_like(A: ptr) -> ptr {
    if (A == 0.0) { return 0.0; }
    if (cartan_c_is_tree(A) != 0.0) {
        let res = cartan_tree_create();
        let len = cartan_tree_len_f(A);
        var i = 0.0;
        while (i < len) {
            cartan_tree_push(res, 1.0);
            i = i + 1.0;
        }
        return res;
    }
    let len = cartan_vec_len(A);
    let res = cartan_vec_create();
    var i = 0.0;
    while (i < len) {
        cartan_vec_push_f32(res, 1.0);
        i = i + 1.0;
    }
    return res;
}

fn cartan_tensor_zeros_like(A: ptr) -> ptr {
    if (A == 0.0) { return 0.0; }
    if (cartan_c_is_tree(A) != 0.0) {
        let res = cartan_tree_create();
        let len = cartan_tree_len_f(A);
        var i = 0.0;
        while (i < len) {
            cartan_tree_push(res, 0.0);
            i = i + 1.0;
        }
        return res;
    }
    let len = cartan_vec_len(A);
    let res = cartan_vec_create();
    var i = 0.0;
    while (i < len) {
        cartan_vec_push_f32(res, 0.0);
        i = i + 1.0;
    }
    return res;
}

fn cartan_tensor_transpose(A: ptr) -> ptr {
    if (A == 0.0) { return 0.0; }
    if (cartan_c_is_tree(A) != 0.0) {
        let num_rows = cartan_tree_len_f(A);
        if (num_rows <= 0.0) { return cartan_tree_create(); }
        let first_elem = cartan_tree_get_f32(A, 0.0);
        var is_2d = 0.0;
        if (first_elem != 0.0) {
            if (cartan_c_is_tree(first_elem) != 0.0) { is_2d = 1.0; }
            else if (cartan_vec_len(first_elem) > 0.0) { is_2d = 1.0; }
        }
        if (is_2d != 0.0) {
            let num_cols = cartan_vec_len(first_elem);
            let transposed = cartan_tree_create();
            var c = 0.0;
            while (c < num_cols) {
                let col_vec = cartan_vec_create();
                var r = 0.0;
                while (r < num_rows) {
                    let row_ptr = cartan_tree_get_f32(A, r);
                    let val = cartan_vec_get_f32(row_ptr, c);
                    cartan_vec_push_f32(col_vec, val);
                    r = r + 1.0;
                }
                cartan_tree_push(transposed, col_vec);
                c = c + 1.0;
            }
            return transposed;
        }
        let transposed = cartan_tree_create();
        var i = 0.0;
        while (i < num_rows) {
            cartan_tree_push(transposed, cartan_tree_get_f32(A, i));
            i = i + 1.0;
        }
        return transposed;
    }
    let len = cartan_vec_len(A);
    let res = cartan_vec_create();
    var i = 0.0;
    while (i < len) {
        cartan_vec_push_f32(res, cartan_vec_get_f32(A, i));
        i = i + 1.0;
    }
    return res;
}

// --- Prompt & Pattern Matching ---
fn cartan_pattern_match(cond: string, pat: string) -> float {
    if (cond == 0.0 || pat == 0.0) { return 0.0; }
    if (cartan_string_eq(cond, pat) != 0.0) { return 1.0; }
    if (cartan_string_contains(cond, pat) != 0.0) { return 1.0; }

    let t_len = strlen(cond);
    let p_len = strlen(pat);

    var t_idx = 0.0;
    var p_idx = 0.0;
    var star_idx = -1.0;
    var match_idx = 0.0;

    while (t_idx < t_len) {
        if (p_idx < p_len) {
            let p_ch = cartan_string_get_char(pat, p_idx);
            let t_ch = cartan_string_get_char(cond, t_idx);
            if (p_ch == 63.0 || p_ch == t_ch) {
                t_idx = t_idx + 1.0;
                p_idx = p_idx + 1.0;
            } else if (p_ch == 42.0) {
                star_idx = p_idx;
                match_idx = t_idx;
                p_idx = p_idx + 1.0;
            } else if (star_idx != -1.0) {
                p_idx = star_idx + 1.0;
                match_idx = match_idx + 1.0;
                t_idx = match_idx;
            } else {
                return 0.0;
            }
        } else if (star_idx != -1.0) {
            p_idx = star_idx + 1.0;
            match_idx = match_idx + 1.0;
            t_idx = match_idx;
        } else {
            return 0.0;
        }
    }

    while (p_idx < p_len) {
        let p_ch = cartan_string_get_char(pat, p_idx);
        if (p_ch != 42.0) {
            return 0.0;
        }
        p_idx = p_idx + 1.0;
    }

    return 1.0;
}

fn cartan_print(p: ptr) -> float {
    if (p == 0.0) {
        printf("null\n", "");
        return 0.0;
    }
    printf("%s\n", p);
    return 1.0;
}

