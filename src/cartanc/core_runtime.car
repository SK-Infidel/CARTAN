// src/cartanc/core_runtime.car
// CARTAN Self-Hosting Pure Native Runtime Kernel (Zero C Dependency)

// --- Libc Core Extern Declarations ---
extern fn malloc(size: float) -> ptr;
extern fn calloc(count: float, size: float) -> ptr;
extern fn free(p: ptr);
extern fn memcpy(dest: ptr, src: ptr, count: float) -> ptr;
extern fn strlen(s: string) -> float;
extern fn strcpy(dest: ptr, src: string) -> ptr;
extern fn strcat(dest: ptr, src: string) -> ptr;
extern fn strcmp(s1: string, s2: string) -> float;
extern fn strncmp(s1: string, s2: string, n: float) -> float;
extern fn c_cartan_string_char_at(s: string, idx: float) -> float;
extern fn cartan_c_memcpy(dest: ptr, src: ptr, count: float) -> ptr;
extern fn cartan_c_strncmp(s1: string, s2: string, n: float) -> float;
extern fn cartan_c_ptr_add(p: ptr, offset: float) -> ptr;
extern fn cartan_c_tree_create() -> ptr;
extern fn cartan_c_tree_len_f(t: ptr) -> float;
extern fn cartan_c_tree_get(t: ptr, idx: float) -> ptr;
extern fn cartan_c_tree_push(t: ptr, item: ptr) -> void;
extern fn cartan_c_tree_set(t: ptr, idx: float, val: ptr) -> void;
extern fn cartan_c_tree_remove(t: ptr, idx: float) -> void;
extern fn strstr(haystack: string, needle: string) -> ptr;
extern fn atof(s: string) -> float;
extern fn cartan_c_int_to_string(val: float) -> string;
extern fn cartan_c_float_to_string(val: float) -> string;
extern fn cartan_c_sprintf_hex_byte(dest: ptr, b: float) -> void;
extern fn sprintf(buf: ptr, fmt: string, val: float) -> float;
extern fn printf(fmt: string, s: string) -> float;
extern fn exit(code: float) -> void;
extern fn fopen(path: string, mode: string) -> ptr;
extern fn fclose(file: ptr) -> float;
extern fn fseek(file: ptr, offset: float, origin: float) -> float;
extern fn ftell(file: ptr) -> float;
extern fn fread(buffer: ptr, size: float, count: float, file: ptr) -> float;
extern fn fwrite(buffer: ptr, size: float, count: float, file: ptr) -> float;
extern fn fputs(str: string, file: ptr) -> float;
extern fn fgets(buffer: ptr, size: float, file: ptr) -> ptr;
extern fn getenv(name: string) -> ptr;
extern fn system(cmd: string) -> float;
extern fn remove(path: string) -> float;
extern fn rename(old_path: string, new_path: string) -> float;
