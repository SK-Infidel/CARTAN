fn cartan_alloc_parameter_adam_nd(ndim: float, d0: float, d1: float, d2: float, d3: float) -> ptr {
    var total = 1.0;
    if (d0 > 0.0) { total = total * d0; }
    if (d1 > 0.0) { total = total * d1; }
    if (d2 > 0.0) { total = total * d2; }
    if (d3 > 0.0) { total = total * d3; }
    return cartan_alloc_parameter_adam(total);
}

