
include "ast.ch";

struct Parser {
    tokens: ptr;
    current: float;
    allow_struct_init: float;
    has_error: float;
}

fn parser_init(tokens: ptr) -> Parser {
    var p = Parser { tokens: tokens, current: 0.0, allow_struct_init: 1.0, has_error: 0.0 };
    return p;
}


    fn peek(self_ptr: Parser) -> Token {
let _t = cartan_tree_get_f32(self_ptr.tokens, self_ptr.current);
return _t;
}

fn peek_next(self_ptr: Parser) -> Token {
return cartan_tree_get_f32(self_ptr.tokens, self_ptr.current + 1.0);
}

fn previous(self_ptr: Parser) -> Token {
return cartan_tree_get_f32(self_ptr.tokens, self_ptr.current - 1.0);
}

extern fn cartan_ast_strdup(string: ptr) -> ptr;
extern fn debug_print_ptr(p: Stmt) -> void;
extern fn cartan_tree_push(t: ptr, itm: ptr) -> void;
extern fn cartan_dump_bytes(ptr_val: ptr, size: float) -> float;
extern fn printf(fmt: string, val: ptr) -> float;

    fn is_at_end(self_ptr: Parser) -> float {
        let t = peek(self_ptr);
        if (t == 0.0) { return 1.0; }
        let tt = t.token_type;
        let first = tt[0];
        if (first == 168.0) { return 1.0; }
        return 0.0;
    }

    fn parser_check(self_ptr: Parser, t_type: float) -> float {
        if is_at_end(self_ptr) {
            return 0.0;
        }
         return peek(self_ptr).token_type[0] == t_type;
    }

    fn advance(self_ptr: Parser) -> Token {
        if !is_at_end(self_ptr) {
            self_ptr.current += 1;
        }
         return previous(self_ptr);
    }

    fn match_token(self_ptr: Parser, expected_type: float) -> float {
        if (parser_check(self_ptr, expected_type) != 0.0) {
            advance(self_ptr);
            return 1.0;
        }
        return 0.0;
    }

    fn consume(self_ptr: Parser, t_type: float, message: string) -> Token {
        if parser_check(self_ptr, t_type) {
             return advance(self_ptr);
        }
        let tok = peek(self_ptr);
        let line = 1.0;
        let col = 1.0;
        if (tok != 0.0) {
            line = tok.span.line;
            col = tok.span.col_start;
        }
        printf("error[E0001]: %s at line %f, column %f\n", message, line, col);
        printf("  |\n");
        printf("  | ^^^ %s\n", message);
        cartan_flush(0.0);
        self_ptr.has_error = 1.0;
        return 0.0;
    }

    fn get_current_line(self_ptr: Parser) -> float {
        let tok = peek(self_ptr);
        if (tok == 0.0) { return 1.0; }
        return tok.span.line;
    }

    /// Main entry point for parsing the input token stream.
    /// Returns a list of global-scope AST statements or a parser diagnostic error.
    fn parse(self_ptr: Parser) -> ptr {
  let statements = cartan_tree_create();
while !is_at_end(self_ptr) {
let stmt = declaration(self_ptr);
cartan_tree_push(statements, stmt);
}
return statements;
}

    /// Parses a declaration statement. A declaration can be a function, struct, variable,
    /// tensor, sequence, block, cognitive block, custom manifold space, actor, trait or impl.
    fn declaration(self_ptr: Parser) -> Stmt {
        let is_pub = 0.0;
        let tok = peek(self_ptr);
        if (tok != 0.0 && tok.token_type[0] == 107.0) {
            let lex = tok.token_type[1];
            if (cartan_string_eq(lex, "pub") != 0.0) {
                advance(self_ptr);
                is_pub = 1.0;
            } else if (cartan_string_eq(lex, "mod") != 0.0 || cartan_string_eq(lex, "use") != 0.0) {
                advance(self_ptr);
                let name_tok = consume(self_ptr, 107.0, "Expected module identifier");
                consume(self_ptr, 161.0, "Expected ; after module directive");
                return Stmt::Placeholder("module_directive");
            }
        }

        let is_agent_accessible = 0.0;
        if (match_token(self_ptr, 78.0) != 0.0) {
            is_agent_accessible = 1.0;
        }

        let is_lazy = 0.0;
        let is_unified = 0.0;
        let is_latent = 0.0;
        while parser_check(self_ptr, 47.0) || parser_check(self_ptr, 48.0) || parser_check(self_ptr, 52.0) {
            if (match_token(self_ptr, 47.0) != 0.0) { is_lazy = 1.0; }
            if (match_token(self_ptr, 48.0) != 0.0) { is_unified = 1.0; }
            if (match_token(self_ptr, 52.0) != 0.0) { is_latent = 1.0; }
        }

        if (match_token(self_ptr, 43.0) != 0.0) {
             return macro_declaration(self_ptr);
        } else if (match_token(self_ptr, 17.0) != 0.0) {
             return extern_function_declaration(self_ptr);
        } else if (match_token(self_ptr, 0.0) != 0.0) {
             return function_declaration(self_ptr, is_agent_accessible);
        } else if (match_token(self_ptr, 4.0) != 0.0) {
             return struct_declaration(self_ptr);
        } else if (match_token(self_ptr, 22.0) != 0.0) {
             return enum_declaration(self_ptr);
        } else if (match_token(self_ptr, 88.0) != 0.0) {
             return var_declaration(self_ptr, 0.0);
        } else if (match_token(self_ptr, 3.0) != 0.0) {
             return var_declaration(self_ptr, 0.0);
        } else if (match_token(self_ptr, 1.0) != 0.0) {
             return var_declaration(self_ptr, 0.0);
        } else if (match_token(self_ptr, 2.0) != 0.0) {
             return var_declaration(self_ptr, 1.0);
        } else if (match_token(self_ptr, 6.0) != 0.0) {
             return tensor_declaration(self_ptr, is_lazy, is_unified, is_latent);
        } else if (match_token(self_ptr, 7.0) != 0.0) {
             return vector_declaration(self_ptr);
        } else if (match_token(self_ptr, 10.0) != 0.0) {
             return parameter_declaration(self_ptr);
        } else if (match_token(self_ptr, 11.0) != 0.0) {
             return sequence_declaration(self_ptr);
        } else if (match_token(self_ptr, 4.0) != 0.0) {
             return struct_declaration(self_ptr);
        } else if (match_token(self_ptr, 31.0) != 0.0) {
             return import_declaration(self_ptr);
        } else if (match_token(self_ptr, 169.0) != 0.0) {
             return include_declaration(self_ptr);
        } else if (match_token(self_ptr, 40.0) != 0.0) {
             return pipeline_declaration(self_ptr);
        } else if (match_token(self_ptr, 91.0) != 0.0) {
             return layer_declaration(self_ptr);
        } else if (match_token(self_ptr, 92.0) != 0.0) {
             return graph_declaration(self_ptr);
        } else if (match_token(self_ptr, 94.0) != 0.0) {
             return rule_declaration(self_ptr);
        } else if (match_token(self_ptr, 95.0) != 0.0) {
             return knowledge_base_declaration(self_ptr);
        } else if (match_token(self_ptr, 98.0) != 0.0) {
             return evolve_declaration(self_ptr);
        } else if (match_token(self_ptr, 99.0) != 0.0) {
             return spawn_declaration(self_ptr);
        } else if (match_token(self_ptr, 101.0) != 0.0) {
             return trait_declaration(self_ptr);
        } else if (match_token(self_ptr, 102.0) != 0.0) {
             return impl_declaration(self_ptr);
        } else if (match_token(self_ptr, 103.0) != 0.0) {
             return receive_declaration(self_ptr);
        } else if (match_token(self_ptr, 58.0) != 0.0) {
            let condition = expression(self_ptr);
            consume(self_ptr, 152.0, "Expected  {  before satisfy body");
            let body = parse_block(self_ptr);
            let otherwise_node = 0.0;
            if (match_token(self_ptr, 59.0) != 0.0) {
                consume(self_ptr, 152.0, "Expected  {  before otherwise body");
                otherwise_node = parse_block(self_ptr);
            }
            return Stmt::Placeholder;
        } else if (match_token(self_ptr, 100.0) != 0.0) {
             return dataframe_declaration(self_ptr);
        } else if (match_token(self_ptr, 41.0) != 0.0) {
            consume(self_ptr, 152.0, "Expected  {  after  jit ");
            let body = parse_block(self_ptr);
            return Stmt::JitBlock(body);
        } else if (match_token(self_ptr, 12.0) != 0.0) {
             return block_declaration(self_ptr);
        } else if (match_token(self_ptr, 9.0) != 0.0) {
             return lattice_declaration(self_ptr);
        } else if (match_token(self_ptr, 8.0) != 0.0) {
             return tree_declaration(self_ptr);
        } else if (match_token(self_ptr, 14.0) != 0.0) {
             return manifold_declaration(self_ptr);
        } else if (match_token(self_ptr, 44.0) != 0.0) {
            let _tok = consume(self_ptr, 107.0, "Expected mesh identifier");
        if (_tok == 0.0) { return 0.0; }
        let name = _tok.token_type[1];
            consume(self_ptr, 61.0, "Expected  supervisor  after mesh name");
            consume(self_ptr, 150.0, "Expected  (  after  supervisor ");
            let _tok = consume(self_ptr, 110.0, "Expected supervisor strategy string");
        if (_tok == 0.0) { return 0.0; }
        let strategy = _tok.token_type[1];
            consume(self_ptr, 151.0, "Expected  )  after supervisor strategy");
            consume(self_ptr, 152.0, "Expected  {  after mesh supervisor");
            let body = parse_block(self_ptr);
            return Stmt::MeshBlock( name, strategy, body );
        } else if (match_token(self_ptr, 46.0) != 0.0) {
            consume(self_ptr, 152.0, "Expected  {  after  multimodal ");
            let body = parse_block(self_ptr);
            return Stmt::MultimodalBlock( body );
        } else if (match_token(self_ptr, 37.0) != 0.0) {
            consume(self_ptr, 152.0, "Expected  {  after  vmap ");
            let body = parse_block(self_ptr);
            return Stmt::VmapBlock( body );
        } else if (match_token(self_ptr, 49.0) != 0.0) {
            consume(self_ptr, 152.0, "Expected  {  after  doubt ");
            let body = parse_block(self_ptr);
            return Stmt::DoubtBlock( body );
        } else if (match_token(self_ptr, 50.0) != 0.0) {
            consume(self_ptr, 152.0, "Expected  {  after  chain ");
            let body = parse_block(self_ptr);
            return Stmt::ChainBlock( body );
        } else if (match_token(self_ptr, 53.0) != 0.0) {
            consume(self_ptr, 152.0, "Expected  {  after  route ");
            let body = parse_block(self_ptr);
            return Stmt::RouteBlock( body );
        } else if (match_token(self_ptr, 54.0) != 0.0) {
            consume(self_ptr, 152.0, "Expected  {  after  grok ");
            let body = parse_block(self_ptr);
            return Stmt::GrokBlock( body );
        } else if (match_token(self_ptr, 56.0) != 0.0) {
            consume(self_ptr, 152.0, "Expected  {  after  override ");
            let body = parse_block(self_ptr);
            return Stmt::OverrideBlock( body );
        } else if (match_token(self_ptr, 55.0) != 0.0) {
            let _func_decl = function_declaration(self_ptr, 0.0);
            if (_func_decl != 0.0 && _func_decl[0] == 44.0) {
                let decl = _func_decl[1];
                return Stmt::ToolDecl(decl);
            } else {
                return 0.0;
            }
        } else if (match_token(self_ptr, 15.0) != 0.0) {
             return topology_declaration(self_ptr);
        } else if (match_token(self_ptr, 5.0) != 0.0) {
             return stream_declaration(self_ptr);
        } else {
             return statement(self_ptr);
        }
    }

    fn stream_declaration(self_ptr: Parser) -> Stmt {
        let id_expr = expression(self_ptr);
        consume(self_ptr, 157.0, "Expected  :  after stream ID");
        let name_token = consume(self_ptr, 107.0, "Expected manifold name");
        let manifold_name = name_token.token_type[1];
        consume(self_ptr, 161.0, "Expected  ;  after stream declaration");
        return Stmt::StreamDecl(  id_expr, manifold_name );
    }

    fn include_declaration(self_ptr: Parser) -> Stmt {
        let path_token = consume(self_ptr, 110.0, "Expected string literal for include path");
        let path = path_token.token_type[1];
        consume(self_ptr, 161.0, "Expected ';' after include statement");
        return Stmt::Include(path);
    }

    fn import_declaration(self_ptr: Parser) -> Stmt {
        let path_token = consume(self_ptr, 110.0, "Expected string literal for import path/uri");
        let path = path_token.token_type[1];
        
        if (match_token(self_ptr, 39.0) != 0.0) {
            let alias_token = consume(self_ptr, 107.0, "Expected alias after  as ");
            let alias = alias_token.token_type[1];
            consume(self_ptr, 161.0, "Expected  ;  after import statement");
            return Stmt::ImportModel(  path, alias );
        } else {
            consume(self_ptr, 161.0, "Expected  ;  after import path");
            return Stmt::Import(  path );
        }
    }

    fn manifold_declaration(self_ptr: Parser) -> Stmt {
        let name_token = consume(self_ptr, 107.0, "Expected manifold name");
        let name = name_token.token_type[1];
        consume(self_ptr, 152.0, "Expected  {  after manifold name");
        let body = parse_block(self_ptr);
        return Stmt::ManifoldDecl( name, body );
    }

    fn topology_declaration(self_ptr: Parser) -> Stmt {
        let name_token = consume(self_ptr, 107.0, "Expected topology name");
        let name = name_token.token_type[1];
        consume(self_ptr, 152.0, "Expected  {  after topology name");
        let body = parse_block(self_ptr);
        return Stmt::TopologyDecl( name, body );
    }
    
    fn tensor_declaration(self_ptr: Parser, is_lazy: float, is_unified: float, is_latent: float) -> Stmt {
        let name_token = consume(self_ptr, 107.0, "Expected tensor name");
        let name = name_token.token_type[1];
         return tensor_declaration_with_name(self_ptr, name, 0.0, 0.0, is_lazy, is_unified, is_latent);
    }

    fn vector_declaration(self_ptr: Parser) -> Stmt {
        let name_token = consume(self_ptr, 107.0, "Expected vector name");
        let name = name_token.token_type[1];

        consume(self_ptr, 154.0, "Expected  [  after vector name");
        
        let data_type = 0.0;
        // If the first thing is an identifier followed by a comma, it s the data type (e.g. float, 16)
        if (peek(self_ptr).token_type[0] == 107.0) { 
            let dt = peek(self_ptr).token_type[1];
            let next_is_comma = 0.0;
            let next_tok = peek_next(self_ptr);
            if (next_tok.token_type[0] == 156.0) { next_is_comma = 1.0; }
            if (next_is_comma != 0.0) {
                data_type = dt;
                advance(self_ptr); // consume identifier
                advance(self_ptr); // consume comma
            }
        }
        let dim_expr = expression(self_ptr);
        
        consume(self_ptr, 155.0, "Expected  ]  after vector dimension");

        let space = VectorSpace::AmbientEuclidean;
        if (match_token(self_ptr, 87.0) != 0.0) {
            let anchor_token = consume(self_ptr, 107.0, "Expected anchor variable name after  at ");
            let anchor_name = anchor_token.token_type[1];
            space = VectorSpace::TangentSpace(anchor_name);
        }

        consume(self_ptr, 161.0, "Expected  ;  after vector declaration");

        return Stmt::VectorDecl(
            name,
            data_type,
             dim_expr,
            space);
    }

    fn sequence_declaration(self_ptr: Parser) -> Stmt {
        let name_token = consume(self_ptr, 107.0, "Expected sequence name");
        let name = name_token.token_type[1];
        consume(self_ptr, 154.0, "Expected  [  after sequence name");
        let max_len = expression(self_ptr);
        consume(self_ptr, 155.0, "Expected  ]  after sequence size");
        consume(self_ptr, 161.0, "Expected  ;  after sequence declaration");
        return Stmt::SequenceDecl( name, max_len );
    }

    fn block_declaration(self_ptr: Parser) -> Stmt {
        let name_token = consume(self_ptr, 107.0, "Expected block name");
        let name = name_token.token_type[1];
        consume(self_ptr, 154.0, "Expected  [  after block name");
        let size = expression(self_ptr);
        consume(self_ptr, 155.0, "Expected  ]  after block size");
        consume(self_ptr, 161.0, "Expected  ;  after block declaration");
        return Stmt::BlockDecl( name, size );
    }

    fn lattice_declaration(self_ptr: Parser) -> Stmt {
        let name_token = consume(self_ptr, 107.0, "Expected lattice name");
        let name = name_token.token_type[1];
        consume(self_ptr, 154.0, "Expected  [  after lattice name");
        let lattice_type_token = consume(self_ptr, 107.0, "Expected lattice type (e.g. E8, Boolean)");
        let lattice_type = lattice_type_token.token_type[1];
        consume(self_ptr, 156.0, "Expected  ,  after lattice type");
        let dim = expression(self_ptr);
        consume(self_ptr, 155.0, "Expected  ]  after lattice dimension");
        consume(self_ptr, 161.0, "Expected  ;  after lattice declaration");
        return Stmt::LatticeDecl( name, lattice_type, dim );
    }

    fn tree_declaration(self_ptr: Parser) -> Stmt {
        let name_token = consume(self_ptr, 107.0, "Expected t name");
        let name = name_token.token_type[1];
        consume(self_ptr, 131.0, "Expected  <  after t name");
        let element_type_token = consume(self_ptr, 107.0, "Expected t element type (e.g. tensor)");
        let element_type = element_type_token.token_type[1];
        consume(self_ptr, 133.0, "Expected  >  after t element type");
        consume(self_ptr, 161.0, "Expected  ;  after t declaration");
        return Stmt::TreeDecl( name, element_type );
    }

    fn parameter_declaration(self_ptr: Parser) -> Stmt {
        let optimizer = 0.0;
        if (match_token(self_ptr, 154.0) != 0.0) {
            let opt_token = consume(self_ptr, 107.0, "Expected optimizer name (e.g. Adam)");
            if (opt_token.token_type[0] == 107.0) {
                let s = opt_token.token_type[1];
                if (cartan_string_eq(s, "Adam") != 0.0) { optimizer = OptimizerState::Adam; }
                else if (cartan_string_eq(s, "SGD") != 0.0) { optimizer = OptimizerState::SGD; }
                else { return 0.0; }
            }
            consume(self_ptr, 155.0, "Expected  ]  after optimizer");
        }
        
        let name_token = consume(self_ptr, 107.0, "Expected parameter name");
        let name = name_token.token_type[1];
         return tensor_declaration_with_name(self_ptr, name, 1.0, optimizer, 0.0, 0.0, 0.0);
    }

    fn tensor_declaration_with_name(self_ptr: Parser, name: string, is_parameter: float, optimizer: ptr, is_lazy: float, is_unified: float, is_latent: float) -> Stmt {
        consume(self_ptr, 154.0, "Expected  [  after tensor name for shape");
        
        let shape = cartan_tree_create();
        if !parser_check(self_ptr, 155.0) {
            while (1.0) {
                cartan_tree_push(shape, expression(self_ptr));
                if !(match_token(self_ptr, 156.0) != 0.0) {
                    break;
                }
            }
        }
        
        consume(self_ptr, 155.0, "Expected  ]  after tensor shape");
        
        let manifold_val = ManifoldSpace::Euclidean;
        if (match_token(self_ptr, 32.0) != 0.0) {
            let space_token = consume(self_ptr, 107.0, "Expected manifold space name after  in ");
            let space_name = space_token.token_type[1];
            if (space_name == "Minkowski") { manifold_val = ManifoldSpace::Minkowski; }
            else if (space_name == "PoincareDisk") { manifold_val = ManifoldSpace::PoincareDisk; }
            else if (space_name == "Euclidean") { manifold_val = ManifoldSpace::Euclidean; }
            else { manifold_val = ManifoldSpace::Custom(space_name); }
        }
        



        let precision_str = "";
        if (match_token(self_ptr, 71.0) != 0.0) {
            let prec_tok = consume(self_ptr, 107.0, "Expected precision type after 'under'");
            precision_str = prec_tok.token_type[1];
        }
        
        let layout_val = 0.0;
        if (match_token(self_ptr, 13.0) != 0.0) {
            consume(self_ptr, 150.0, "Expected  (  after layout");
            let layout_token = consume(self_ptr, 107.0, "Expected layout type (SoA, Tiled)");
            let layout_name = layout_token.token_type[1];
            
            if layout_name == "SoA" {
                layout_val = MemoryLayout::SoA;
            } else if layout_name == "Tiled" {
                consume(self_ptr, 150.0, "Expected  (  after Tiled");
                let x_token = consume(self_ptr, 108.0, "Expected integer for Tile width");
                let x = x_token.token_type[1];
                consume(self_ptr, 156.0, "Expected  , ");
                let y_token = consume(self_ptr, 108.0, "Expected integer for Tile height");
                let y = y_token.token_type[1];
                consume(self_ptr, 151.0, "Expected  )  after Tiled dims");
                layout_val = MemoryLayout::Tiled(x, y);
            } else {
                layout_val = MemoryLayout::Default;
            }
            consume(self_ptr, 151.0, "Expected  )  after layout definition");
        }
        
        let location = 0.0;
        if (match_token(self_ptr, 162.0) != 0.0) {
            consume(self_ptr, 150.0, "Expected  ( ");
            let _tok1 = consume(self_ptr, 110.0, "Expected location string");
            let loc_str = "";
            if (_tok1 != 0.0) { loc_str = _tok1.token_type[1]; }
            location = loc_str;
            consume(self_ptr, 151.0, "Expected  ) ");
        }
        
        let backend = StorageBackend::Memory;
        if (match_token(self_ptr, 163.0) != 0.0) {
            consume(self_ptr, 150.0, "Expected  ( ");
            let _tok2 = consume(self_ptr, 110.0, "Expected backend string");
            let backend_str = "";
            if (_tok2 != 0.0) { backend_str = _tok2.token_type[1]; }
            if backend_str == "NVMe" {
                backend = StorageBackend::NVMe;
            }
            consume(self_ptr, 151.0, "Expected  ) ");
        }
        
        consume(self_ptr, 161.0, "Expected  ;  after declaration");

        if (is_parameter != 0.0) {
            return Stmt::ParameterDecl(
                name,
                shape,
                manifold_val,
                layout_val,
                location,
                backend,
                optimizer,
                precision_str);
        } else {
            return Stmt::TensorDecl(
                name,
                shape,
                manifold_val,
                layout_val,
                location,
                backend,
                is_lazy,
                is_unified,
                is_latent,
                precision_str);
        }
    }

    
    fn parse_block(self_ptr: Parser) -> BlockStmt {
        let statements = cartan_tree_create();
        while !parser_check(self_ptr, 153.0) && !is_at_end(self_ptr) {
            cartan_tree_push(statements, declaration(self_ptr));
        }
        consume(self_ptr, 153.0, "Expected  }  after block");
        return BlockStmt { statements: statements };
    }




    fn pipeline_declaration(self_ptr: Parser) -> Stmt {
        let name_token = consume(self_ptr, 107.0, "Expected pipeline name");
        let name = name_token.token_type[1];

        consume(self_ptr, 152.0, "Expected  {  before pipeline body");
        let layers = cartan_tree_create();
        while !parser_check(self_ptr, 153.0) && !is_at_end(self_ptr) {
            cartan_tree_push(layers, expression(self_ptr));
            if !parser_check(self_ptr, 153.0) {
                consume(self_ptr, 156.0, "Expected  ,  between pipeline layers");
            }
        }
        consume(self_ptr, 153.0, "Expected  }  after pipeline body");
        
        return Stmt::PipelineDecl( name, layers );
    }

    fn layer_declaration(self_ptr: Parser) -> Stmt {
        let name_token = consume(self_ptr, 107.0, "Expected layer name");
        let name = name_token.token_type[1];
        consume(self_ptr, 128.0, "Expected  =  after layer name");
        
        let layer_type_tok = consume(self_ptr, 107.0, "Expected layer type");
        let layer_type = "";
        if (layer_type_tok.token_type[0] == 107.0) { layer_type = layer_type_tok.token_type[1]; }
        consume(self_ptr, 150.0, "Expected  ( ");
        let dim = expression(self_ptr);
        consume(self_ptr, 156.0, "Expected  , ");
        let act_tok = consume(self_ptr, 107.0, "Expected activation");
        let activation = "";
        if (act_tok.token_type[0] == 107.0) { activation = act_tok.token_type[1]; }
        consume(self_ptr, 151.0, "Expected  ) ");

        consume(self_ptr, 161.0, "Expected  ;  after layer definition");
        return Stmt::LayerDecl( name, layer_type, dim, activation );
    }

