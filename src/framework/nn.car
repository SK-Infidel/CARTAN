// src/framework/nn.car
// CARTAN Layer 2 Framework: Production Neural Network Primitives & Layers Module

include "../std/tensor.cl";
include "../std/math.cl";

fn nn_linear(x: ptr, w: ptr, b: ptr) -> ptr {
    let out = tensor_matmul(x, w);
    if (b != 0.0) {
        return tensor_add(out, b, cartan_tree_len(out));
    }
    return out;
}

fn nn_relu(x: ptr) -> ptr {
    if (x == 0.0) { return 0.0; }
    relu(x);
    return x;
}

fn nn_gelu(x: ptr) -> ptr {
    if (x == 0.0) { return 0.0; }
    return gelu(x);
}

fn nn_silu(x: ptr) -> ptr {
    if (x == 0.0) { return 0.0; }
    return silu(x);
}

fn nn_sigmoid(x: ptr) -> ptr {
    if (x == 0.0) { return 0.0; }
    return sigmoid(x);
}

fn nn_softmax(x: ptr) -> ptr {
    if (x == 0.0) { return 0.0; }
    return softmax(x);
}

fn nn_layer_norm(x: ptr, gamma: ptr, beta: ptr, eps: float) -> ptr {
    let mean_val = mean(x);
    let diff = sub(x, mean_val);
    let var_val = mean(mul(diff, diff));
    let std_dev = math_sqrt(var_val + eps);
    let norm = tensor_div_scalar(diff, std_dev);
    if (gamma != 0.0) {
        let scaled = mul(norm, gamma);
        if (beta != 0.0) {
            return add(scaled, beta);
        }
        return scaled;
    }
    return norm;
}

fn nn_sgd_step(param: ptr, grad: ptr, lr: float) {
    let update = tensor_mul_scalar(grad, lr);
    let new_param = sub(param, update);
    tensor_copy(param, new_param);
}

fn nn_adam_step(param: ptr, grad: ptr, m: ptr, v: ptr, lr: float, beta1: float, beta2: float, eps: float, step: float) {
    let one_minus_b1 = 1.0 - beta1;
    let one_minus_b2 = 1.0 - beta2;
    
    let m_update = add(tensor_mul_scalar(m, beta1), tensor_mul_scalar(grad, one_minus_b1));
    let grad_sq = mul(grad, grad);
    let v_update = add(tensor_mul_scalar(v, beta2), tensor_mul_scalar(grad_sq, one_minus_b2));
    
    tensor_copy(m, m_update);
    tensor_copy(v, v_update);
    
    let m_hat = tensor_div_scalar(m_update, 1.0 - math_pow(beta1, step));
    let v_hat = tensor_div_scalar(v_update, 1.0 - math_pow(beta2, step));
    
    let denom = tensor_add_scalar(tensor_sqrt(v_hat), eps);
    let step_val = div(m_hat, denom);
    
    let new_param = sub(param, tensor_mul_scalar(step_val, lr));
    tensor_copy(param, new_param);
}
