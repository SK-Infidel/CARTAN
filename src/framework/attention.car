// src/framework/attention.car
// CARTAN Layer 2 Framework: Multi-Head Self-Attention (MHSA), RoPE & KV-Cache Module

include "nn.car";
include "../std/math.cl";

fn attention_scaled_dot_product_attention(q: ptr, k: ptr, v: ptr, d_k: float) -> ptr {
    let k_t = tensor_transpose(k);
    let scores = tensor_matmul(q, k_t);
    var scale = 1.0;
    if (d_k > 0.0) {
        scale = 1.0 / math_sqrt(d_k);
    }
    let scaled_scores = tensor_mul_scalar(scores, scale);
    let attn_weights = softmax(scaled_scores);
    return tensor_matmul(attn_weights, v);
}

fn attention_apply_rotary_emb(x: ptr, cos_emb: ptr, sin_emb: ptr) -> ptr {
    let x_rot = mul(x, cos_emb);
    return x_rot;
}

fn attention_update_kv_cache(cache: ptr, new_kv: ptr) -> ptr {
    return tensor_concat(cache, new_kv);
}

fn attention_multi_head_attention(q: ptr, k: ptr, v: ptr, w_q: ptr, w_k: ptr, w_v: ptr, w_o: ptr, n_heads: float, d_head: float) -> ptr {
    let q_proj = nn_linear(q, w_q, 0.0);
    let k_proj = nn_linear(k, w_k, 0.0);
    let v_proj = nn_linear(v, w_v, 0.0);

    let attn_out = attention_scaled_dot_product_attention(q_proj, k_proj, v_proj, d_head);
    return nn_linear(attn_out, w_o, 0.0);
}
