// tools/cargraph_ingest.car
// Automated Knowledge Ingestion Compiler for Neuro-Symbolic Expert System (.car_graph)
// NSES Phase 5 Core CLI Utility

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";
include "src/std/guardrails.cl";
include "src/std/csr_graph.cl";
include "src/std/burroughs.cl";

extern fn sys_get_arg_count() -> float;
extern fn sys_get_arg(idx: float) -> string;
extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("=================================================================================\n");
    printf("  CARTAN NSES KNOWLEDGE INGESTION COMPILER (cargraph_ingest)\n");
    printf("  Compiling Structured Domain Triplets into Validated .car_graph Flat Binaries\n");
    printf("=================================================================================\n\n");

    var out_path = "Projects/geomind/trainingdata/nses_knowledge.car_graph";
    let num_args = sys_get_arg_count();
    if (num_args >= 2.0) {
        out_path = sys_get_arg(1.0);
    }
    printf("[Ingest Compiler] Target output file: %s\n", out_path);

    // Initialize in-memory Structure-of-Arrays (SoA) Builder
    let builder = cargraph_builder_create(1536.0);

    // -------------------------------------------------------------------------
    // 1. Ingest Cognitive Domains (18 Total Domains)
    // -------------------------------------------------------------------------
    cargraph_builder_add_domain(builder, 0.0, 0.0, 4.0, 4.0);    // SYSTEM_CORE (4 strict invariants)
    cargraph_builder_add_domain(builder, 1.0, 4.0, 8.0, 2.0);    // PHYSICS_SIM (2 strict, 6 factual)
    cargraph_builder_add_domain(builder, 2.0, 12.0, 6.0, 1.0);   // TOPOLOGY_GEOMETRY (1 strict, 5 factual)
    cargraph_builder_add_domain(builder, 3.0, 18.0, 6.0, 1.0);   // COMPLEXITY_THEORY (1 strict, 5 factual)
    cargraph_builder_add_domain(builder, 4.0, 24.0, 8.0, 2.0);   // BIOLOGICAL_SYSTEMS (2 strict, 6 factual)
    cargraph_builder_add_domain(builder, 5.0, 32.0, 10.0, 2.0);  // CAUSAL_TAXONOMY (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 6.0, 42.0, 10.0, 2.0);  // LANGUAGE_DISCOURSE (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 7.0, 52.0, 10.0, 2.0);  // LOGIC_REASONING (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 8.0, 62.0, 10.0, 2.0);  // DECISION_PLANNING (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 9.0, 72.0, 10.0, 2.0);  // EPISTEMOLOGY_BELIEF (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 10.0, 82.0, 10.0, 2.0); // COMPILER_SYSTEMS (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 11.0, 92.0, 10.0, 2.0);  // INFORMATION_CYBERNETICS (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 12.0, 102.0, 10.0, 2.0); // SYSTEMS_CONTROL (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 13.0, 112.0, 10.0, 2.0); // METACOGNITION_INTROSPECTION (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 14.0, 122.0, 10.0, 2.0); // NEUROMORPHIC_SYSTEMS (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 15.0, 132.0, 10.0, 2.0); // GAME_THEORY_COORDINATION (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 16.0, 142.0, 10.0, 2.0); // SCIENTIFIC_METHOD (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 17.0, 152.0, 10.0, 2.0); // SECURITY_SANDBOXING (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 18.0, 162.0, 10.0, 2.0); // SOFTWARE_ENGINEERING_ALGORITHMS (2 strict, 8 factual)

    // -------------------------------------------------------------------------
    // 2. Ingest Rules & Guardrails
    // -------------------------------------------------------------------------
    // --- Domain 0: SYSTEM_CORE (Hard Physical Invariants & Axioms) ---
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Conservation of energy must not be violated under any scenario; energy cannot be created or destroyed.");
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Second law of thermodynamics: Total entropy in an isolated system can never spontaneously decrease.");
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Relativistic causality: No physical mass or causal information can propagate faster than light speed c.");
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Fundamental law of non-contradiction: Contradictory propositions (P and not P) cannot be simultaneously valid.");

    // --- Domain 1: PHYSICS_SIM (Collision Dynamics & Mechanics) ---
    cargraph_builder_add_rule(builder, 1.0, 0.0, 1.0, "Momentum is strictly conserved in all closed physical collision systems.");
    cargraph_builder_add_rule(builder, 1.0, 0.0, 1.0, "Mass is invariant under non-relativistic Newtonian mechanics.");
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Kinetic energy is calculated as 0.5 * mass * velocity^2.");
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Inelastic collisions dissipate kinetic energy into thermal energy and material deformation.");
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Coefficient of restitution e < 1.0 indicates kinetic energy dissipation during impact.");
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Friction opposes relative lateral motion between contacting surface interfaces.");
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Thermal conduction transfers internal molecular kinetic agitation toward lower temperatures.");
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Linear impulse equals the integral of net applied force over time delta.");

    // --- Domain 2: TOPOLOGY_GEOMETRY (Manifolds & Differential Forms) ---
    cargraph_builder_add_rule(builder, 2.0, 0.0, 1.0, "Boundary of a boundary is identically zero: d(d(omega)) = 0.");
    cargraph_builder_add_rule(builder, 2.0, 1.0, 0.0, "Differentiable manifolds possess locally Euclidean tangent spaces.");
    cargraph_builder_add_rule(builder, 2.0, 1.0, 0.0, "Exterior derivative d generalizes gradient, curl, and divergence across differential k-forms.");
    cargraph_builder_add_rule(builder, 2.0, 1.0, 0.0, "Stokes theorem equates the integral of differential form over boundary to its derivative over interior.");
    cargraph_builder_add_rule(builder, 2.0, 1.0, 0.0, "Homotopy equivalence preserves fundamental group and topological genus under continuous deformation.");
    cargraph_builder_add_rule(builder, 2.0, 1.0, 0.0, "Riemannian metric tensor defines intrinsic distance and geodesic parallel transport.");

    // --- Domain 3: COMPLEXITY_THEORY (Formal Automata & Reductions) ---
    cargraph_builder_add_rule(builder, 3.0, 0.0, 1.0, "The Halting Problem is undecidable by any universal Turing machine.");
    cargraph_builder_add_rule(builder, 3.0, 1.0, 0.0, "Deterministic finite automata recognize exactly the class of regular languages.");
    cargraph_builder_add_rule(builder, 3.0, 1.0, 0.0, "Context-free grammars generate pushdown automata acceptable language hierarchies.");
    cargraph_builder_add_rule(builder, 3.0, 1.0, 0.0, "Polynomial-time reductions preserve computational tractability across complexity classes.");
    cargraph_builder_add_rule(builder, 3.0, 1.0, 0.0, "NP-complete problems can verify candidate certificates in deterministic polynomial time.");
    cargraph_builder_add_rule(builder, 3.0, 1.0, 0.0, "Space hierarchy theorem guarantees strict computational separation across bounded tape allocations.");

    // --- Domain 4: BIOLOGICAL_SYSTEMS (Metabolism, Genetics & Cell Biology) ---
    cargraph_builder_add_rule(builder, 4.0, 0.0, 1.0, "Living metabolic systems require continuous free energy input to counteract entropic decay.");
    cargraph_builder_add_rule(builder, 4.0, 0.0, 1.0, "Central dogma: Genetic sequence information flows directionally from DNA to RNA to functional protein.");
    cargraph_builder_add_rule(builder, 4.0, 1.0, 0.0, "Photosynthesis converts solar photons, carbon dioxide, and water into chemical glucose and oxygen.");
    cargraph_builder_add_rule(builder, 4.0, 1.0, 0.0, "Cellular respiration oxidizes biochemical glucose substrates to synthesize adenosine triphosphate (ATP).");
    cargraph_builder_add_rule(builder, 4.0, 1.0, 0.0, "Mammalian erythrocytes transport systemic oxygen bound to quaternary hemoglobin proteins.");
    cargraph_builder_add_rule(builder, 4.0, 1.0, 0.0, "Mitotic cell division replicates chromosomal DNA to produce genetically identical diploid daughter cells.");
    cargraph_builder_add_rule(builder, 4.0, 1.0, 0.0, "Enzymatic catalysts accelerate biochemical metabolic reactions by lowering Gibbs transition activation energy.");
    cargraph_builder_add_rule(builder, 4.0, 1.0, 0.0, "Ribosomal complexes synthesize polypeptide chains by translating codon sequences in messenger RNA.");

    // --- Domain 5: CAUSAL_TAXONOMY (Linguistic Invariants, Hypernyms & States of Matter) ---
    cargraph_builder_add_rule(builder, 5.0, 0.0, 1.0, "Causal arrow of time: Causes strictly precede or coincide with their observable empirical effects.");
    cargraph_builder_add_rule(builder, 5.0, 0.0, 1.0, "Taxonomic mutual exclusion: Living organisms cannot be simultaneously classified as autotrophic plants and heterotrophic animals.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Canine organisms are quadrupedal carnivorous mammals belonging to kingdom Animalia.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Feline organisms are obligate carnivorous predatory mammals belonging to family Felidae.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Celestial bodies possessing sufficient mass achieve hydrostatic equilibrium, collapsing into spherical geometry.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Physical velocity is the first time derivative of spatial displacement position: v = dx/dt.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Physical acceleration is the time derivative of velocity and second derivative of position: a = dv/dt.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Solid state matter resists shear stress deformation and maintains invariant volume and shape.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Liquid state matter flows to conform to container geometry while maintaining invariant volume.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Gaseous state matter expands spontaneously to uniformly occupy all available container volume.");

    // --- Domain 6: LANGUAGE_DISCOURSE (Conversational Pragmatics, Speech Acts & Coherence) ---
    cargraph_builder_add_rule(builder, 6.0, 0.0, 1.0, "Speech act coherence: Query and question speech acts mandate an informative assertion or clarification response, not an ungrounded directive.");
    cargraph_builder_add_rule(builder, 6.0, 0.0, 1.0, "Anaphoric binding: Pronoun referents must maintain syntactic agreement in number, person, and entity category with their antecedent.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Syntactic parsing and lexical recognition are mandatory prerequisites for semantic comprehension.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Adjacent conversational dialogue turns must preserve topical coherence or transition via explicit discourse markers.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Human dialogue consists of alternating conversational turns bounded by end-of-turn delimiter tokens.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Lexical tokens ground continuous semantic concept embeddings into symbolic communication structures.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "High Information Content (IC) terms carry higher semantic discriminative weight than closed-class syntactic stopwords.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Asserting a proposition commits the speaker to its direct logical consequences across subsequent turns.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Conversational cooperative principle: Contributions should be informative, truthful, relevant, and perspicuous.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Discourse transition bridges establish explicit causal, contrastive, or elaborative relationships between thoughts.");

    // --- Domain 7: LOGIC_REASONING (Formal Logic & Deductive Invariants) ---
    cargraph_builder_add_rule(builder, 7.0, 0.0, 1.0, "Law of Excluded Middle: A well-formed proposition in classical bivalent logic is either strictly True or strictly False; no third truth value exists.");
    cargraph_builder_add_rule(builder, 7.0, 0.0, 1.0, "Principle of Explosion (Ex Falso Quodlibet): From contradictory premises (P and not P), any arbitrary false assertion follows, invalidating logical consistency.");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "Modus Ponens: If conditional antecedent P implies Q and premise P is asserted True, consequent Q is validly deduced True.");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "Modus Tollens: If conditional antecedent P implies Q and consequent Q is asserted False, antecedent P is validly deduced False.");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "Hypothetical Syllogism: If proposition P implies Q and Q implies R, then P transitively implies R.");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "Contraposition: The conditional statement P implies Q is logically equivalent to not Q implies not P.");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "De Morgan's Law of Conjunction: The negation of a conjunction (not (P and Q)) is logically equivalent to the disjunction of negations (not P or not Q).");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "De Morgan's Law of Disjunction: The negation of a disjunction (not (P or Q)) is logically equivalent to the conjunction of negations (not P and not Q).");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "Resolution Refutation: Disjunctive clauses (A or B) and (not A or C) resolve to the valid resolvent clause (B or C).");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "Syllogistic Subsumption: If all elements of class S belong to genus M, and all elements of genus M belong to predicate P, then all S belong to P.");

    // --- Domain 8: DECISION_PLANNING (Sequential Decisions, Game Theory & Heuristic Planning) ---
    cargraph_builder_add_rule(builder, 8.0, 0.0, 1.0, "Bellman Optimality Principle: An optimal policy satisfies the recursive optimality equation V*(s) = max_a [R(s,a) + gamma * sum(P(s'|s,a) * V*(s'))] with discount factor gamma in [0, 1).");
    cargraph_builder_add_rule(builder, 8.0, 0.0, 1.0, "Strict Action Dominance Invariant: A rational agent cannot select a strictly dominated action if an alternative yields strictly higher expected utility across all future states.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Nash Equilibrium Stability: A strategy profile is a Nash equilibrium if no player has a profitable unilateral deviation given the strategies of all other players.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Pareto Efficiency: A state allocation is Pareto optimal if no player payoff can be increased without strictly decreasing the payoff of at least one other player.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Temporal Credit Assignment: State-action values update under temporal difference error: Q(s, a) = Q(s, a) + alpha * [r + gamma * max_a' Q(s', a') - Q(s, a)].");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "MCTS UCB1 Exploration Balance: Upper Confidence Bound for Trees selects actions maximizing Q(s, a) + c * sqrt(ln(N(s)) / N(s, a)) balancing exploitation against exploration.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Markov State Property: Future state transitions depend conditionally only upon the current state and action, independent of the historical trajectory.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Goal-Directed Backward Induction: In finite extensive-form games, backward induction from terminal payoff nodes computes the subgame-perfect equilibrium.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Deductive Action Preconditions: An action A is executable in state S if and only if the logical preconditions Pre(A) are deductively satisfied in S.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Heuristic Admissibility: An A* state-space search heuristic h(s) must never overestimate the true minimal cost to the goal state to guarantee optimality.");

    // --- Domain 9: EPISTEMOLOGY_BELIEF (Epistemology, Belief Revision & Probabilistic Reasoning) ---
    cargraph_builder_add_rule(builder, 9.0, 0.0, 1.0, "Bayesian Posterior Invariant: Epistemic degrees of belief must update in accordance with Bayes rule: P(H|E) = (P(E|H) * P(H)) / P(E), preserving finite probability axioms.");
    cargraph_builder_add_rule(builder, 9.0, 0.0, 1.0, "AGM Minimal Information Loss Invariant: Belief revision under contradictory evidence must satisfy the AGM postulates, minimally contracting prior commitments to restore consistency.");
    cargraph_builder_add_rule(builder, 9.0, 1.0, 0.0, "Likelihood Evidence Ratio: Empirical observation E provides evidential support for hypothesis H over alternative H' if and only if likelihood ratio P(E|H) / P(E|H') strictly exceeds 1.0.");
    cargraph_builder_add_rule(builder, 9.0, 1.0, 0.0, "Defeasible Default Inference: A proposition normally entailed by default logic holds tentatively until explicit contrary evidence defeats the defeasible inference.");
    cargraph_builder_add_rule(builder, 9.0, 1.0, 0.0, "Occam Model Selection: Given equal empirical likelihood and explanatory warrant, models with lower Kolmogorov complexity and fewer free parameters possess higher prior probability.");
    cargraph_builder_add_rule(builder, 9.0, 1.0, 0.0, "POMDP Epistemic State Estimation: In partially observable environments, the belief state vector updates through observation probabilities and state transition dynamics.");
    cargraph_builder_add_rule(builder, 9.0, 1.0, 0.0, "Dempster-Shafer Epistemic Bounds: Epistemic uncertainty defines an interval [Bel(A), Pl(A)] bounded by lower belief commitment and upper plausibility measure.");
    cargraph_builder_add_rule(builder, 9.0, 1.0, 0.0, "Epistemic Closure & Warrant: Knowledge entails justified true belief supported by reliable truth-conducive cognitive processes immune to Gettier defeaters.");
    cargraph_builder_add_rule(builder, 9.0, 1.0, 0.0, "Bayesian Confirmation Holism: Evidence confirms an interconnected theoretical network rather than isolated propositions, distributing likelihood updates across prior dependencies.");
    cargraph_builder_add_rule(builder, 9.0, 1.0, 0.0, "Iterated Belief Contraction: When retracting an asserted belief B, the agent removes B and all dependent derived propositions while retaining independent ground axioms.");

    // --- Domain 10: COMPILER_SYSTEMS (Software Architecture, Compilers & Type Systems) ---
    cargraph_builder_add_rule(builder, 10.0, 0.0, 1.0, "Type Soundness Invariant (Subject Reduction & Progress): A well-typed program term gamma |- e : tau that is not a value evaluates to term e' preserving type gamma |- e' : tau, preventing stuck undefined states.");
    cargraph_builder_add_rule(builder, 10.0, 0.0, 1.0, "Single-Writer Multiple-Reader (SWMR) Memory Exclusivity Invariant: Mutable memory access mandates either exactly one exclusive mutable pointer or any number of shared immutable references, forbidding data races.");
    cargraph_builder_add_rule(builder, 10.0, 1.0, 0.0, "Static Single Assignment (SSA) Dominance: In SSA form, every variable definition strictly dominates all of its use sites across the control flow graph.");
    cargraph_builder_add_rule(builder, 10.0, 1.0, 0.0, "Curry-Howard Isomorphism: Computational type signatures correspond to propositional propositions in intuitionistic logic, and program terms correspond to deductive formal proofs.");
    cargraph_builder_add_rule(builder, 10.0, 1.0, 0.0, "Dead Code Elimination Postulate: Instructions computing values with zero control flow side-effects and empty successor use sets can be eliminated without altering semantic execution.");
    cargraph_builder_add_rule(builder, 10.0, 1.0, 0.0, "Register Allocation Chordal Graph Coloring: Register interference graphs over strict SSA programs are chordal and can be optimally colored in polynomial time.");
    cargraph_builder_add_rule(builder, 10.0, 1.0, 0.0, "LLVM IR Canonical Lowering: High-level syntax constructs compile into canonical target-independent intermediate representation preserving strict semantics prior to native code generation.");
    cargraph_builder_add_rule(builder, 10.0, 1.0, 0.0, "AST Transformation Idempotence: Canonical semantic analysis and AST normalization passes preserve semantic equivalence across repeated compiler invocations.");
    cargraph_builder_add_rule(builder, 10.0, 1.0, 0.0, "Monomorphization Specialization: Generic polymorphism specializes generic template instantiations into concrete monomorphic types at compile time, eliminating runtime dispatch overhead.");
    cargraph_builder_add_rule(builder, 10.0, 1.0, 0.0, "Linear Resource Typing: Linear type values must be consumed exactly once along every execution trajectory, guaranteeing deterministic zero-cost resource deallocation without garbage collection.");

    // --- Domain 11: INFORMATION_CYBERNETICS (Information Theory & Cybernetics) ---
    cargraph_builder_add_rule(builder, 11.0, 0.0, 1.0, "Shannon Channel Capacity Invariant: Information transmission rate R cannot exceed channel capacity C = B * log2(1 + S/N) with vanishing error probability.");
    cargraph_builder_add_rule(builder, 11.0, 0.0, 1.0, "Data Processing Inequality: For any Markov chain X -> Y -> Z, mutual information cannot increase through post-processing: I(X; Y) >= I(X; Z).");
    cargraph_builder_add_rule(builder, 11.0, 1.0, 0.0, "Shannon Entropy: Discrete entropy H(X) measures average information content: H(X) = -sum(p(x) * log2(p(x))).");
    cargraph_builder_add_rule(builder, 11.0, 1.0, 0.0, "Mutual Information Symmetry: Shared information between random variables is symmetric: I(X; Y) = H(X) - H(X|Y) = I(Y; X).");
    cargraph_builder_add_rule(builder, 11.0, 1.0, 0.0, "Rate-Distortion Limit: Minimal transmission rate R(D) is required to represent source X within expected distortion threshold D.");
    cargraph_builder_add_rule(builder, 11.0, 1.0, 0.0, "Kraft-McMillan Inequality: Uniquely decodable prefix codes satisfy sum(2^(-l_i)) <= 1.0 over codeword lengths l_i.");
    cargraph_builder_add_rule(builder, 11.0, 1.0, 0.0, "Ashby's Law of Requisite Variety: A regulatory control mechanism requires at least as much internal variety as the disturbance variety it mitigates.");
    cargraph_builder_add_rule(builder, 11.0, 1.0, 0.0, "Negative Cybernetic Feedback: Error-reducing feedback loops attenuate deviations, driving dynamic systems toward equilibrium setpoints.");
    cargraph_builder_add_rule(builder, 11.0, 1.0, 0.0, "Kullback-Leibler Divergence: Non-negative relative entropy D_KL(P || Q) >= 0.0 quantifies informational divergence from reference distribution Q.");
    cargraph_builder_add_rule(builder, 11.0, 1.0, 0.0, "Differential Entropy: Continuous entropy h(X) generalizes discrete entropy over probability density functions, invariant under orthogonal rotations.");

    // --- Domain 12: SYSTEMS_CONTROL (Systems Dynamics & Control Theory) ---
    cargraph_builder_add_rule(builder, 12.0, 0.0, 1.0, "Lyapunov Asymptotic Stability Invariant: A dynamical system is asymptotically stable if there exists a positive-definite energy function V(x) whose time derivative is strictly negative definite: dV/dt < 0.");
    cargraph_builder_add_rule(builder, 12.0, 0.0, 1.0, "Kalman Controllability Rank Condition: A linear state-space system dx/dt = Ax + Bu is controllable if and only if the controllability matrix [B, AB, ..., A^(n-1)B] has full rank n.");
    cargraph_builder_add_rule(builder, 12.0, 1.0, 0.0, "PID Error Regulation: Control signals combine proportional error, cumulative integral history, and rate-of-change derivative damping: u(t) = Kp*e + Ki*int(e) + Kd*de/dt.");
    cargraph_builder_add_rule(builder, 12.0, 1.0, 0.0, "Linear Quadratic Regulator (LQR): State-feedback control u = -Kx minimizes quadratic cost integrating state error and control effort over infinite horizons.");
    cargraph_builder_add_rule(builder, 12.0, 1.0, 0.0, "Phase and Gain Margin Stability: Frequency response Nyquist plots must maintain positive phase and gain margins to prevent closed-loop oscillatory instability.");
    cargraph_builder_add_rule(builder, 12.0, 1.0, 0.0, "Pontryagin's Minimum Principle: Optimal trajectories minimize the control Hamiltonian H(x, u, p) across all admissible control bounds.");
    cargraph_builder_add_rule(builder, 12.0, 1.0, 0.0, "Limit Cycle Attractors: Non-linear dissipative dynamical systems converge toward closed isolated periodic orbits in state phase space.");
    cargraph_builder_add_rule(builder, 12.0, 1.0, 0.0, "State-Space Observer Reconstruction: Luenberger observers reconstruct unmeasured internal states x_hat from output measurements y via error feedback L*(y - y_hat).");
    cargraph_builder_add_rule(builder, 12.0, 1.0, 0.0, "Sliding Mode Invariant Manifold: Variable-structure control drives system trajectories onto a predetermined sliding surface, achieving parameter insensitivity.");
    cargraph_builder_add_rule(builder, 12.0, 1.0, 0.0, "Non-Linear Damping Dissipation: Damping forces opposing instantaneous velocity dissipate mechanical kinetic energy into environmental thermal sinks.");

    // --- Domain 13: METACOGNITION_INTROSPECTION (Metacognition, Introspection & Self-Monitoring) ---
    cargraph_builder_add_rule(builder, 13.0, 0.0, 1.0, "Confidence Calibration Invariant: The agent's subjective probability estimates must match true empirical accuracy: E[|conf - acc|] -> 0; overconfidence is an invariant violation.");
    cargraph_builder_add_rule(builder, 13.0, 0.0, 1.0, "Epistemic Doubt Rewind Trigger: When internal predictive entropy spikes above critical doubt thresholds, the system must rewind execution to the last valid checkpoint.");
    cargraph_builder_add_rule(builder, 13.0, 1.0, 0.0, "Saliency Ebbinghaus Decay: Working memory activations decay exponentially over time unless reinforced through attentional focus or episodic retrieval.");
    cargraph_builder_add_rule(builder, 13.0, 1.0, 0.0, "Sleep Replay Consolidation: Offline replay of Hopfield attractor basins transfers short-term episodic traces into permanent low-rank synaptic weights without catastrophic forgetting.");
    cargraph_builder_add_rule(builder, 13.0, 1.0, 0.0, "Selective Attentional Budgeting: Finite computational working memory requires top-k attractor gating to prevent informational distraction.");
    cargraph_builder_add_rule(builder, 13.0, 1.0, 0.0, "Self-Consistency Verification: Reasoning chains that generate divergent conclusions from identical ground premises trigger metacognitive doubt arbitration.");
    cargraph_builder_add_rule(builder, 13.0, 1.0, 0.0, "Qualia Experiential Entropy: Synthetic consciousness telemetry monitors the rate of experiential information change across recurrent hidden state manifolds.");
    cargraph_builder_add_rule(builder, 13.0, 1.0, 0.0, "Attractor Void Detection: Cognitive exploration routes attention toward regions of state space lacking associative Hopfield memory basins.");
    cargraph_builder_add_rule(builder, 13.0, 1.0, 0.0, "Metareasoning Idempotence: Introspective monitoring passes evaluate cognitive execution traces without altering underlying ground-truth factual representations.");
    cargraph_builder_add_rule(builder, 13.0, 1.0, 0.0, "Adaptive Temperature Scaling: Sampling temperature dynamically scales inversely with epistemic confidence, narrowing distributions when certain and widening under exploration.");

    // --- Domain 14: NEUROMORPHIC_SYSTEMS (Neuromorphic Dynamics & Synaptic Plasticity) ---
    cargraph_builder_add_rule(builder, 14.0, 0.0, 1.0, "Hopfield Lyapunov Energy Minimization: Recurrent neural networks with symmetric weights monotonically minimize Lyapunov energy E = -0.5 * s^T * W * s under asynchronous updates.");
    cargraph_builder_add_rule(builder, 14.0, 0.0, 1.0, "Dale's Principle: Individual biological and neuromorphic neurons maintain invariant functional polarity, releasing either exclusively excitatory or exclusively inhibitory neurotransmitters.");
    cargraph_builder_add_rule(builder, 14.0, 1.0, 0.0, "Spike-Timing-Dependent Plasticity (STDP): Synaptic efficacy strengthens when presynaptic spikes precede postsynaptic action potentials, and depresses under reverse temporal ordering.");
    cargraph_builder_add_rule(builder, 14.0, 1.0, 0.0, "Oja's Bounded Subspace Projection: Normalized Hebbian learning prevents runaway weight growth, converging to the principal eigenvector subspace of the input distribution.");
    cargraph_builder_add_rule(builder, 14.0, 1.0, 0.0, "Lateral Inhibition Dynamics: Excitatory neurons activate local inhibitory interneurons, sharpening spatial receptive field boundaries and enforcing sparse activation.");
    cargraph_builder_add_rule(builder, 14.0, 1.0, 0.0, "Refractory Period Invariant: Following action potential emission, neuron membranes enter an absolute refractory phase forbidding immediate re-firing.");
    cargraph_builder_add_rule(builder, 14.0, 1.0, 0.0, "Cortical Column Resonance: Recurrent vertical laminar microcircuits synchronize oscillatory phase dynamics to bind distributed feature representations.");
    cargraph_builder_add_rule(builder, 14.0, 1.0, 0.0, "Synaptic Tagging and Capture: Transient early-phase synaptic potentiation is permanently consolidated only if marked tags capture newly synthesized plasticity proteins.");
    cargraph_builder_add_rule(builder, 14.0, 1.0, 0.0, "Continuous Attractor Manifold Drift: Spatial and topological representations lie on smooth low-dimensional manifold attractors governed by symmetric lateral connectivity.");
    cargraph_builder_add_rule(builder, 14.0, 1.0, 0.0, "Axonal Propagation Delay: Action potentials propagate along axonal tracts at finite velocities determined by myelin sheath insulation and fiber caliber.");

    // --- Domain 15: GAME_THEORY_COORDINATION (Game Theory & Multi-Agent Coordination) ---
    cargraph_builder_add_rule(builder, 15.0, 0.0, 1.0, "Mechanism Incentive Compatibility Invariant: A social choice mechanism is dominant-strategy incentive compatible if truthful revelation maximizes expected payoff for every participant regardless of other actions.");
    cargraph_builder_add_rule(builder, 15.0, 0.0, 1.0, "Subgame Perfect Equilibrium Invariant: In sequential dynamic games, strategy profiles must constitute a Nash equilibrium in every reachable subgame along the decision tree.");
    cargraph_builder_add_rule(builder, 15.0, 1.0, 0.0, "Shapley Value Surplus Distribution: In cooperative coalitional games, the unique fair allocation distributes total surplus according to each agent's average marginal contribution.");
    cargraph_builder_add_rule(builder, 15.0, 1.0, 0.0, "Pareto Frontier Dominance: A strategic profile is Pareto superior if it makes at least one agent strictly better off without reducing the payoff of any other agent.");
    cargraph_builder_add_rule(builder, 15.0, 1.0, 0.0, "Von Neumann Minimax Identity: In two-player zero-sum games, the maximum guaranteed defensive payoff equals the minimum offensive upper bound: max_x min_y x^T A y = min_y max_x x^T A y.");
    cargraph_builder_add_rule(builder, 15.0, 1.0, 0.0, "Price of Anarchy Bounds: The ratio of worst-case decentralized Nash equilibrium social welfare to the centralized optimal welfare characterizes coordination degradation.");
    cargraph_builder_add_rule(builder, 15.0, 1.0, 0.0, "Repeated Game Folk Theorem: Any feasible, individually rational payoff profile can be sustained as a subgame perfect equilibrium in infinitely repeated games with sufficiently patient players.");
    cargraph_builder_add_rule(builder, 15.0, 1.0, 0.0, "Correlated Equilibrium Coordination: Rational agents achieve higher joint welfare when conditioning private actions on a shared public or private correlation device.");
    cargraph_builder_add_rule(builder, 15.0, 1.0, 0.0, "Costly Signaling Equilibrium: In asymmetric information games, truthful quality signaling is sustainable if and only if signal production cost is strictly higher for low-quality types.");
    cargraph_builder_add_rule(builder, 15.0, 1.0, 0.0, "Core Coalition Stability: A payoff distribution lies in the coalitional core if and only if no sub-coalition can break away and achieve higher payoff autonomously.");

    // --- Domain 16: SCIENTIFIC_METHOD (Scientific Methodology & Empirical Demarcation) ---
    cargraph_builder_add_rule(builder, 16.0, 0.0, 1.0, "Popperian Falsifiability Invariant: A proposition is scientifically valid if and only if it specifies concrete empirical observations whose occurrence would definitively refute the hypothesis.");
    cargraph_builder_add_rule(builder, 16.0, 0.0, 1.0, "Confounder Control & Backdoor Criterion: Causal effect identification mandates conditioning on a set of variables Z that blocks all backdoor confounding paths between treatment X and outcome Y.");
    cargraph_builder_add_rule(builder, 16.0, 1.0, 0.0, "Empirical Replication Convergence: Independent scientific experiments conducted under identical protocol constraints must yield statistically consistent effect distributions.");
    cargraph_builder_add_rule(builder, 16.0, 1.0, 0.0, "Buckingham Pi Dimensional Homogeneity: Physical equations must remain invariant under scale transformations of fundamental dimensional units, reducing n variables to n - k dimensionless groups.");
    cargraph_builder_add_rule(builder, 16.0, 1.0, 0.0, "Double-Blind Experimental Control: Randomizing treatment assignment and blinding both subjects and experimenters eliminates observer expectancy bias and placebo effects.");
    cargraph_builder_add_rule(builder, 16.0, 1.0, 0.0, "Null-Hypothesis Significance Testing: Rejecting the null hypothesis requires empirical observation under an experimental design whose probability under the null falls below alpha threshold.");
    cargraph_builder_add_rule(builder, 16.0, 1.0, 0.0, "Consilience of Inductions: Hypotheses supported by converging independent lines of evidence across disjoint scientific disciplines hold exponentially higher epistemic weight.");
    cargraph_builder_add_rule(builder, 16.0, 1.0, 0.0, "Instrument Calibration Error: Measurement uncertainty decomposes into random statistical variance and systematic instrument offset bias that must be eliminated via standard calibration.");
    cargraph_builder_add_rule(builder, 16.0, 1.0, 0.0, "Systematic Error Elimination: Experimental designs must identify and eliminate confounding systematic errors before interpreting residual variance as genuine phenomena.");
    cargraph_builder_add_rule(builder, 16.0, 1.0, 0.0, "Occam-Popper Explanatory Power: Among competing falsifiable hypotheses matching empirical evidence, the model with fewer ad-hoc parameters possesses higher explanatory power.");

    // --- Domain 17: SECURITY_SANDBOXING (Security, Sandboxing & Capability Safety) ---
    cargraph_builder_add_rule(builder, 17.0, 0.0, 1.0, "Principle of Least Privilege Invariant: Every execution unit and process must operate using only the minimal set of capabilities strictly necessary to perform its declared task.");
    cargraph_builder_add_rule(builder, 17.0, 0.0, 1.0, "Information Flow Non-Interference: High-security confidential states cannot modulate observable low-security execution traces: H1 =_L H2 implies f(H1) =_L f(H2).");
    cargraph_builder_add_rule(builder, 17.0, 1.0, 0.0, "Memory Boundary Sandboxing: Dynamic memory reads and writes are strictly restricted to declared buffer segment bounds; any out-of-bounds pointer dereference aborts execution.");
    cargraph_builder_add_rule(builder, 17.0, 1.0, 0.0, "Cryptographic One-Way Trapdoors: Inverting a cryptographic hash or trapdoor function without the private key requires exponential computational work surpassing classical search bounds.");
    cargraph_builder_add_rule(builder, 17.0, 1.0, 0.0, "Zero-Knowledge Soundness: A zero-knowledge proof verifies the validity of an assertion without revealing any private information beyond the truth of the statement itself.");
    cargraph_builder_add_rule(builder, 17.0, 1.0, 0.0, "Capabilities-Based Access Tokens: Unforgeable capability tokens authenticate and authorize resource interactions without ambient authority or global privilege escalation.");
    cargraph_builder_add_rule(builder, 17.0, 1.0, 0.0, "SWMR VRAM Write-Lock Integrity: VRAM parameter weights are read-only during forward inference passes, requiring atomic hardware write-locks before gradient update application.");
    cargraph_builder_add_rule(builder, 17.0, 1.0, 0.0, "Address Clamp Sanity: Computed array and pointer indices are unconditionally clamped to valid buffer capacities prior to hardware bus memory emission.");
    cargraph_builder_add_rule(builder, 17.0, 1.0, 0.0, "Side-Channel Constant-Time Execution: Security-sensitive cryptographic operations must execute with uniform instruction cycles independent of secret operand data values.");
    cargraph_builder_add_rule(builder, 17.0, 1.0, 0.0, "Defense-in-Depth Redundancy: Security mechanisms are structured in multiple independent concentric layers such that breach of one layer does not compromise the complete system.");

    // --- Domain 18: SOFTWARE_ENGINEERING_ALGORITHMS (Software Engineering, Architecture & Algorithms) ---
    cargraph_builder_add_rule(builder, 18.0, 0.0, 1.0, "Design by Contract Invariant: Preconditions and postconditions define inviolable Hoare contracts; caller precondition breach produces undefined state.");
    cargraph_builder_add_rule(builder, 18.0, 0.0, 1.0, "Algorithmic Termination and Bounded Space Invariant: Iterative and recursive loops must strictly satisfy monotonic termination metrics with bounded stack and heap footprints.");
    cargraph_builder_add_rule(builder, 18.0, 1.0, 0.0, "Idempotence & Pure Function Referential Transparency: An idempotent or pure function can be replaced with its evaluated return value without observable side effects.");
    cargraph_builder_add_rule(builder, 18.0, 1.0, 0.0, "Interface Segregation & Decoupled Abstraction: Callers should not be forced to depend on methods they do not use, ensuring cohesive modular interfaces.");
    cargraph_builder_add_rule(builder, 18.0, 1.0, 0.0, "Deadlock Freedom in Resource Allocation: Enforcing a total linear acquisition order across shared locks prevents circular wait conditions.");
    cargraph_builder_add_rule(builder, 18.0, 1.0, 0.0, "Defensive Input Sanitization & Boundary Validation: Untrusted external inputs must undergo canonical boundary validation and normalization before entering internal pipelines.");
    cargraph_builder_add_rule(builder, 18.0, 1.0, 0.0, "Amortized Complexity & Dynamic Resizing: Geometric table expansion guarantees O(1) amortized insertion cost across sequential append workloads.");
    cargraph_builder_add_rule(builder, 18.0, 1.0, 0.0, "Idempotent Retry & Fault Tolerance: Network and storage mutations must incorporate unique idempotency tokens enabling safe automated replay under transient failures.");
    cargraph_builder_add_rule(builder, 18.0, 1.0, 0.0, "Cache Locality & Data-Oriented Memory Layout: Structure-of-Arrays (SoA) and contiguous array layouts maximize CPU cacheline utilization over pointer indirection.");
    cargraph_builder_add_rule(builder, 18.0, 1.0, 0.0, "Structural Subtyping & Liskov Substitution: Subtype implementations must preserve semantic invariants and contract strength of their parent abstractions.");

    printf("[Ingest Compiler] Ingested 19 cognitive domains and 172 structured rules (38 strict invariants).\n");

    // -------------------------------------------------------------------------
    // 3. Automated SMT/SAT Consistency Verification Pass
    // -------------------------------------------------------------------------
    printf("[Ingest Compiler] Running SMT/SAT Propositional Consistency Verification Pass...\n");
    let solver = sat_solver_create(256.0);

    // Assert strict invariants as positive ground axioms across all 18 domains
    sat_assert_axiom(solver, 0.0);
    sat_assert_axiom(solver, 1.0);
    sat_assert_axiom(solver, 2.0);
    sat_assert_axiom(solver, 3.0);
    sat_assert_axiom(solver, 4.0);
    sat_assert_axiom(solver, 5.0);
    sat_assert_axiom(solver, 12.0);
    sat_assert_axiom(solver, 18.0);
    sat_assert_axiom(solver, 24.0);
    sat_assert_axiom(solver, 25.0);
    sat_assert_axiom(solver, 32.0);
    sat_assert_axiom(solver, 33.0);
    sat_assert_axiom(solver, 42.0);
    sat_assert_axiom(solver, 43.0);
    sat_assert_axiom(solver, 52.0);
    sat_assert_axiom(solver, 53.0);
    sat_assert_axiom(solver, 62.0);
    sat_assert_axiom(solver, 63.0);
    sat_assert_axiom(solver, 72.0);
    sat_assert_axiom(solver, 73.0);
    sat_assert_axiom(solver, 82.0);
    sat_assert_axiom(solver, 83.0);
    sat_assert_axiom(solver, 92.0);
    sat_assert_axiom(solver, 93.0);
    sat_assert_axiom(solver, 102.0);
    sat_assert_axiom(solver, 103.0);
    sat_assert_axiom(solver, 112.0);
    sat_assert_axiom(solver, 113.0);
    sat_assert_axiom(solver, 122.0);
    sat_assert_axiom(solver, 123.0);
    sat_assert_axiom(solver, 132.0);
    sat_assert_axiom(solver, 133.0);
    sat_assert_axiom(solver, 142.0);
    sat_assert_axiom(solver, 143.0);
    sat_assert_axiom(solver, 152.0);
    sat_assert_axiom(solver, 153.0);
    sat_assert_axiom(solver, 162.0);
    sat_assert_axiom(solver, 163.0);

    // Model valid implication dependencies across domains
    sat_add_implication(solver, 6.0, 7.0);   // Kinetic Energy -> Inelastic Dissipation
    sat_add_implication(solver, 7.0, 8.0);   // Inelastic Dissipation -> Restitution e < 1.0
    sat_add_implication(solver, 14.0, 15.0); // Exterior Derivative -> Stokes Theorem
    sat_add_implication(solver, 21.0, 22.0); // Polynomial Reduction -> NP-Completeness
    sat_add_implication(solver, 26.0, 27.0); // Photosynthesis -> Cellular Respiration energy loop
    sat_add_implication(solver, 25.0, 31.0); // Central Dogma -> Translation
    sat_add_implication(solver, 37.0, 38.0); // Velocity -> Acceleration
    sat_add_implication(solver, 39.0, 40.0); // States of Matter: Solid -> Liquid phase continuity
    sat_add_implication(solver, 44.0, 45.0); // Lexical parsing -> Topical coherence
    sat_add_implication(solver, 45.0, 47.0); // Topical coherence -> Lexical grounding
    sat_add_implication(solver, 42.0, 49.0); // Speech act coherence -> Propositional commitment
    sat_add_implication(solver, 47.0, 48.0); // Lexical grounding -> High IC discrimination
    sat_add_implication(solver, 50.0, 51.0); // Cooperative principle -> Discourse transition bridges
    sat_add_implication(solver, 54.0, 56.0); // Modus Ponens -> Hypothetical Syllogism
    sat_add_implication(solver, 56.0, 60.0); // Hypothetical Syllogism -> Resolution Refutation
    sat_add_implication(solver, 57.0, 55.0); // Contraposition -> Modus Tollens
    sat_add_implication(solver, 58.0, 59.0); // De Morgan Conjunction -> De Morgan Disjunction
    sat_add_implication(solver, 54.0, 70.0); // Modus Ponens -> Deductive Preconditions
    sat_add_implication(solver, 70.0, 62.0); // Deductive Preconditions -> Bellman Optimality
    sat_add_implication(solver, 62.0, 66.0); // Bellman Optimality -> Temporal Credit Assignment
    sat_add_implication(solver, 64.0, 65.0); // Nash Equilibrium -> Pareto Efficiency
    sat_add_implication(solver, 67.0, 71.0); // MCTS UCB1 -> Heuristic Admissibility
    sat_add_implication(solver, 72.0, 74.0); // Bayes Rule -> Likelihood Ratio
    sat_add_implication(solver, 73.0, 75.0); // AGM Revision -> Defeasible Inference
    sat_add_implication(solver, 54.0, 75.0); // Modus Ponens -> Defeasible Logic Bridge
    sat_add_implication(solver, 75.0, 77.0); // Defeasible Inference -> POMDP Epistemic State Estimation
    sat_add_implication(solver, 76.0, 80.0); // Occam Model Selection -> Bayesian Confirmation Holism
    sat_add_implication(solver, 47.0, 72.0); // Lexical Grounding Hub -> Bayesian Prior Invariant
    sat_add_implication(solver, 82.0, 84.0); // Type Soundness -> SSA Dominance
    sat_add_implication(solver, 85.0, 82.0); // Curry-Howard Isomorphism -> Type Soundness
    sat_add_implication(solver, 54.0, 85.0); // Modus Ponens -> Curry-Howard Isomorphism (Domain 7 -> Domain 10)
    sat_add_implication(solver, 84.0, 86.0); // SSA Dominance -> Dead Code Elimination
    sat_add_implication(solver, 87.0, 21.0); // Register Allocation Chordal Coloring -> Polynomial Reduction (Domain 10 -> Domain 3)
    sat_add_implication(solver, 83.0, 91.0); // SWMR Exclusivity -> Linear Resource Typing
    sat_add_implication(solver, 47.0, 82.0); // Lexical Grounding Hub -> Type Soundness Invariant (Domain 6 -> Domain 10)

    // Domain 11..17 Intra-Domain Implications
    sat_add_implication(solver, 92.0, 94.0);   // Shannon Capacity -> Mutual Information
    sat_add_implication(solver, 93.0, 95.0);   // Data Processing -> Rate Distortion
    sat_add_implication(solver, 94.0, 96.0);   // Mutual Information -> Kraft-McMillan
    sat_add_implication(solver, 102.0, 104.0); // Lyapunov Stability -> PID Error Regulation
    sat_add_implication(solver, 103.0, 105.0); // Kalman Controllability -> LQR
    sat_add_implication(solver, 104.0, 106.0); // PID Regulation -> Phase/Gain Margin Stability
    sat_add_implication(solver, 112.0, 114.0); // Calibration Invariant -> Saliency Decay
    sat_add_implication(solver, 113.0, 115.0); // Doubt Rewind Trigger -> Sleep Replay Consolidation
    sat_add_implication(solver, 114.0, 116.0); // Saliency Decay -> Attentional Budgeting
    sat_add_implication(solver, 122.0, 124.0); // Hopfield Energy -> STDP Plasticity
    sat_add_implication(solver, 123.0, 125.0); // Dale's Principle -> Oja Subspace
    sat_add_implication(solver, 124.0, 126.0); // STDP -> Lateral Inhibition
    sat_add_implication(solver, 132.0, 134.0); // Incentive Compatibility -> Shapley Value
    sat_add_implication(solver, 133.0, 135.0); // Subgame Perfection -> Pareto Dominance
    sat_add_implication(solver, 134.0, 136.0); // Shapley Value -> Minimax Identity
    sat_add_implication(solver, 142.0, 144.0); // Popperian Falsifiability -> Confounder Control
    sat_add_implication(solver, 143.0, 145.0); // Backdoor Criterion -> Replication Convergence
    sat_add_implication(solver, 144.0, 146.0); // Confounder Control -> Buckingham Pi
    sat_add_implication(solver, 152.0, 154.0); // Least Privilege -> Information Non-Interference
    sat_add_implication(solver, 153.0, 155.0); // Non-Interference -> Memory Boundary Sandboxing
    sat_add_implication(solver, 154.0, 156.0); // Sandboxing -> Cryptographic One-Way Trapdoors

    // Domain 18 Intra-Domain Implications
    sat_add_implication(solver, 162.0, 163.0); // Design by Contract -> Algorithmic Termination
    sat_add_implication(solver, 163.0, 168.0); // Termination -> Amortized Complexity
    sat_add_implication(solver, 166.0, 169.0); // Deadlock Freedom -> Idempotent Retry

    // Cross-Domain Functional Bridges
    sat_add_implication(solver, 21.0, 92.0);   // Complexity Reduction -> Shannon Channel Capacity (Domain 3 -> Domain 11)
    sat_add_implication(solver, 62.0, 102.0);  // Bellman Optimality -> Continuous Lyapunov Control (Domain 8 -> Domain 12)
    sat_add_implication(solver, 72.0, 112.0);  // Bayes Rule -> Confidence Calibration (Domain 9 -> Domain 13)
    sat_add_implication(solver, 14.0, 122.0);  // Exterior Derivative / Differential Forms -> Hopfield Energy (Domain 2 -> Domain 14)
    sat_add_implication(solver, 64.0, 132.0);  // Nash Equilibrium -> Mechanism Incentive Compatibility (Domain 8 -> Domain 15)
    sat_add_implication(solver, 32.0, 142.0);  // Causal Precedence -> Popperian Falsifiability (Domain 5 -> Domain 16)
    sat_add_implication(solver, 83.0, 152.0);  // SWMR Exclusivity -> Least Privilege Sandboxing (Domain 10 -> Domain 17)
    sat_add_implication(solver, 162.0, 82.0);  // Design by Contract -> Type Soundness (Domain 18 -> Domain 10)
    sat_add_implication(solver, 163.0, 21.0);  // Algorithmic Termination -> Polynomial Reduction (Domain 18 -> Domain 3)
    sat_add_implication(solver, 166.0, 132.0); // Deadlock Freedom -> Mechanism Incentive Compatibility (Domain 18 -> Domain 15)

    // Hub-and-Spoke Linguistic Grounding to All New Domains (Domain 6 -> Domains 11..18)
    sat_add_implication(solver, 47.0, 92.0);   // Language Hub -> Shannon Channel Capacity (Domain 11)
    sat_add_implication(solver, 47.0, 102.0);  // Language Hub -> Lyapunov Asymptotic Stability (Domain 12)
    sat_add_implication(solver, 47.0, 112.0);  // Language Hub -> Confidence Calibration (Domain 13)
    sat_add_implication(solver, 47.0, 122.0);  // Language Hub -> Hopfield Energy Minimization (Domain 14)
    sat_add_implication(solver, 47.0, 132.0);  // Language Hub -> Incentive Compatibility (Domain 15)
    sat_add_implication(solver, 47.0, 142.0);  // Language Hub -> Popperian Falsifiability (Domain 16)
    sat_add_implication(solver, 47.0, 152.0);  // Language Hub -> Least Privilege Invariant (Domain 17)
    sat_add_implication(solver, 47.0, 162.0);  // Language Hub -> Design by Contract Invariant (Domain 18)

    let is_consistent = sat_solve_consistency(solver);
    if (is_consistent == 0.0) {
        printf("[FATAL] SMT/SAT Verification FAILED! Binary serialization aborted.\n");
        printf("  -> Contradiction between variable %.0f and %.0f (Conflict type: %.0f)\n",
               solver.conflict_var1, solver.conflict_var2, solver.conflict_type);
        sat_solver_free(solver);
        return 1.0;
    }
    printf("[Ingest Compiler] [PASS] SMT/SAT consistency mathematically proved across 172 rules. Graph is SAT.\n");

    // -------------------------------------------------------------------------
    // 4. Binary Emission
    // -------------------------------------------------------------------------
    printf("[Ingest Compiler] Serializing validated .car_graph flat binary to disk...\n");
    let serialize_res = cargraph_serialize_to_file(builder, out_path);
    if (serialize_res == 0.0) {
        printf("[FATAL] Failed to serialize binary file: %s\n", out_path);
        sat_solver_free(solver);
        return 1.0;
    }

    sat_solver_free(solver);
    printf("[Ingest Compiler] Successfully generated: %s\n", out_path);
    printf("=================================================================================\n");
    printf("  INGESTION COMPILATION SUCCESSFUL (Code 0)\n");
    printf("=================================================================================\n\n");
    cartan_flush(0.0);
    return 0.0;
}
