// tools/cargraph_ingest.car
// Automated Knowledge Ingestion Compiler for Neuro-Symbolic Expert System (.car_graph)
// NSES Phase 5 Core CLI Utility

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";
include "src/std/guardrails.cl";
include "src/std/csr_graph.cl";
include "src/std/burroughs.cl";

extern fn sys_get_arg_count() -> float;
extern fn sys_get_arg(idx: float) -> string;
extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("=================================================================================\n");
    printf("  CARTAN NSES KNOWLEDGE INGESTION COMPILER (cargraph_ingest)\n");
    printf("  Compiling Structured Domain Triplets into Validated .car_graph Flat Binaries\n");
    printf("=================================================================================\n\n");

    var out_path = "test/geomind/trainingdata/nses_knowledge.car_graph";
    let num_args = sys_get_arg_count();
    if (num_args >= 2.0) {
        out_path = sys_get_arg(1.0);
    }
    printf("[Ingest Compiler] Target output file: %s\n", out_path);

    // Initialize in-memory Structure-of-Arrays (SoA) Builder
    let builder = cargraph_builder_create(1536.0);

    // -------------------------------------------------------------------------
    // 1. Ingest Cognitive Domains (6 Total Domains)
    // -------------------------------------------------------------------------
    cargraph_builder_add_domain(builder, 0.0, 0.0, 4.0, 4.0);   // SYSTEM_CORE (4 strict invariants)
    cargraph_builder_add_domain(builder, 1.0, 4.0, 8.0, 2.0);   // PHYSICS_SIM (2 strict, 6 factual)
    cargraph_builder_add_domain(builder, 2.0, 12.0, 6.0, 1.0);  // TOPOLOGY_GEOMETRY (1 strict, 5 factual)
    cargraph_builder_add_domain(builder, 3.0, 18.0, 6.0, 1.0);  // COMPLEXITY_THEORY (1 strict, 5 factual)
    cargraph_builder_add_domain(builder, 4.0, 24.0, 8.0, 2.0);  // BIOLOGICAL_SYSTEMS (2 strict, 6 factual)
    cargraph_builder_add_domain(builder, 5.0, 32.0, 10.0, 2.0); // CAUSAL_TAXONOMY (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 6.0, 42.0, 10.0, 2.0); // LANGUAGE_DISCOURSE (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 7.0, 52.0, 10.0, 2.0); // LOGIC_REASONING (2 strict, 8 factual)
    cargraph_builder_add_domain(builder, 8.0, 62.0, 10.0, 2.0); // DECISION_PLANNING (2 strict, 8 factual)

    // -------------------------------------------------------------------------
    // 2. Ingest Rules & Guardrails
    // -------------------------------------------------------------------------
    // --- Domain 0: SYSTEM_CORE (Hard Physical Invariants & Axioms) ---
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Conservation of energy must not be violated under any scenario; energy cannot be created or destroyed.");
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Second law of thermodynamics: Total entropy in an isolated system can never spontaneously decrease.");
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Relativistic causality: No physical mass or causal information can propagate faster than light speed c.");
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Fundamental law of non-contradiction: Contradictory propositions (P and not P) cannot be simultaneously valid.");

    // --- Domain 1: PHYSICS_SIM (Collision Dynamics & Mechanics) ---
    cargraph_builder_add_rule(builder, 1.0, 0.0, 1.0, "Momentum is strictly conserved in all closed physical collision systems.");
    cargraph_builder_add_rule(builder, 1.0, 0.0, 1.0, "Mass is invariant under non-relativistic Newtonian mechanics.");
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Kinetic energy is calculated as 0.5 * mass * velocity^2.");
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Inelastic collisions dissipate kinetic energy into thermal energy and material deformation.");
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Coefficient of restitution e < 1.0 indicates kinetic energy dissipation during impact.");
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Friction opposes relative lateral motion between contacting surface interfaces.");
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Thermal conduction transfers internal molecular kinetic agitation toward lower temperatures.");
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Linear impulse equals the integral of net applied force over time delta.");

    // --- Domain 2: TOPOLOGY_GEOMETRY (Manifolds & Differential Forms) ---
    cargraph_builder_add_rule(builder, 2.0, 0.0, 1.0, "Boundary of a boundary is identically zero: d(d(omega)) = 0.");
    cargraph_builder_add_rule(builder, 2.0, 1.0, 0.0, "Differentiable manifolds possess locally Euclidean tangent spaces.");
    cargraph_builder_add_rule(builder, 2.0, 1.0, 0.0, "Exterior derivative d generalizes gradient, curl, and divergence across differential k-forms.");
    cargraph_builder_add_rule(builder, 2.0, 1.0, 0.0, "Stokes theorem equates the integral of differential form over boundary to its derivative over interior.");
    cargraph_builder_add_rule(builder, 2.0, 1.0, 0.0, "Homotopy equivalence preserves fundamental group and topological genus under continuous deformation.");
    cargraph_builder_add_rule(builder, 2.0, 1.0, 0.0, "Riemannian metric tensor defines intrinsic distance and geodesic parallel transport.");

    // --- Domain 3: COMPLEXITY_THEORY (Formal Automata & Reductions) ---
    cargraph_builder_add_rule(builder, 3.0, 0.0, 1.0, "The Halting Problem is undecidable by any universal Turing machine.");
    cargraph_builder_add_rule(builder, 3.0, 1.0, 0.0, "Deterministic finite automata recognize exactly the class of regular languages.");
    cargraph_builder_add_rule(builder, 3.0, 1.0, 0.0, "Context-free grammars generate pushdown automata acceptable language hierarchies.");
    cargraph_builder_add_rule(builder, 3.0, 1.0, 0.0, "Polynomial-time reductions preserve computational tractability across complexity classes.");
    cargraph_builder_add_rule(builder, 3.0, 1.0, 0.0, "NP-complete problems can verify candidate certificates in deterministic polynomial time.");
    cargraph_builder_add_rule(builder, 3.0, 1.0, 0.0, "Space hierarchy theorem guarantees strict computational separation across bounded tape allocations.");

    // --- Domain 4: BIOLOGICAL_SYSTEMS (Metabolism, Genetics & Cell Biology) ---
    cargraph_builder_add_rule(builder, 4.0, 0.0, 1.0, "Living metabolic systems require continuous free energy input to counteract entropic decay.");
    cargraph_builder_add_rule(builder, 4.0, 0.0, 1.0, "Central dogma: Genetic sequence information flows directionally from DNA to RNA to functional protein.");
    cargraph_builder_add_rule(builder, 4.0, 1.0, 0.0, "Photosynthesis converts solar photons, carbon dioxide, and water into chemical glucose and oxygen.");
    cargraph_builder_add_rule(builder, 4.0, 1.0, 0.0, "Cellular respiration oxidizes biochemical glucose substrates to synthesize adenosine triphosphate (ATP).");
    cargraph_builder_add_rule(builder, 4.0, 1.0, 0.0, "Mammalian erythrocytes transport systemic oxygen bound to quaternary hemoglobin proteins.");
    cargraph_builder_add_rule(builder, 4.0, 1.0, 0.0, "Mitotic cell division replicates chromosomal DNA to produce genetically identical diploid daughter cells.");
    cargraph_builder_add_rule(builder, 4.0, 1.0, 0.0, "Enzymatic catalysts accelerate biochemical metabolic reactions by lowering Gibbs transition activation energy.");
    cargraph_builder_add_rule(builder, 4.0, 1.0, 0.0, "Ribosomal complexes synthesize polypeptide chains by translating codon sequences in messenger RNA.");

    // --- Domain 5: CAUSAL_TAXONOMY (Linguistic Invariants, Hypernyms & States of Matter) ---
    cargraph_builder_add_rule(builder, 5.0, 0.0, 1.0, "Causal arrow of time: Causes strictly precede or coincide with their observable empirical effects.");
    cargraph_builder_add_rule(builder, 5.0, 0.0, 1.0, "Taxonomic mutual exclusion: Living organisms cannot be simultaneously classified as autotrophic plants and heterotrophic animals.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Canine organisms are quadrupedal carnivorous mammals belonging to kingdom Animalia.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Feline organisms are obligate carnivorous predatory mammals belonging to family Felidae.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Celestial bodies possessing sufficient mass achieve hydrostatic equilibrium, collapsing into spherical geometry.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Physical velocity is the first time derivative of spatial displacement position: v = dx/dt.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Physical acceleration is the time derivative of velocity and second derivative of position: a = dv/dt.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Solid state matter resists shear stress deformation and maintains invariant volume and shape.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Liquid state matter flows to conform to container geometry while maintaining invariant volume.");
    cargraph_builder_add_rule(builder, 5.0, 1.0, 0.0, "Gaseous state matter expands spontaneously to uniformly occupy all available container volume.");

    // --- Domain 6: LANGUAGE_DISCOURSE (Conversational Pragmatics, Speech Acts & Coherence) ---
    cargraph_builder_add_rule(builder, 6.0, 0.0, 1.0, "Speech act coherence: Query and question speech acts mandate an informative assertion or clarification response, not an ungrounded directive.");
    cargraph_builder_add_rule(builder, 6.0, 0.0, 1.0, "Anaphoric binding: Pronoun referents must maintain syntactic agreement in number, person, and entity category with their antecedent.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Syntactic parsing and lexical recognition are mandatory prerequisites for semantic comprehension.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Adjacent conversational dialogue turns must preserve topical coherence or transition via explicit discourse markers.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Human dialogue consists of alternating conversational turns bounded by end-of-turn delimiter tokens.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Lexical tokens ground continuous semantic concept embeddings into symbolic communication structures.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "High Information Content (IC) terms carry higher semantic discriminative weight than closed-class syntactic stopwords.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Asserting a proposition commits the speaker to its direct logical consequences across subsequent turns.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Conversational cooperative principle: Contributions should be informative, truthful, relevant, and perspicuous.");
    cargraph_builder_add_rule(builder, 6.0, 1.0, 0.0, "Discourse transition bridges establish explicit causal, contrastive, or elaborative relationships between thoughts.");

    // --- Domain 7: LOGIC_REASONING (Formal Logic & Deductive Invariants) ---
    cargraph_builder_add_rule(builder, 7.0, 0.0, 1.0, "Law of Excluded Middle: A well-formed proposition in classical bivalent logic is either strictly True or strictly False; no third truth value exists.");
    cargraph_builder_add_rule(builder, 7.0, 0.0, 1.0, "Principle of Explosion (Ex Falso Quodlibet): From contradictory premises (P and not P), any arbitrary false assertion follows, invalidating logical consistency.");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "Modus Ponens: If conditional antecedent P implies Q and premise P is asserted True, consequent Q is validly deduced True.");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "Modus Tollens: If conditional antecedent P implies Q and consequent Q is asserted False, antecedent P is validly deduced False.");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "Hypothetical Syllogism: If proposition P implies Q and Q implies R, then P transitively implies R.");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "Contraposition: The conditional statement P implies Q is logically equivalent to not Q implies not P.");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "De Morgan's Law of Conjunction: The negation of a conjunction (not (P and Q)) is logically equivalent to the disjunction of negations (not P or not Q).");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "De Morgan's Law of Disjunction: The negation of a disjunction (not (P or Q)) is logically equivalent to the conjunction of negations (not P and not Q).");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "Resolution Refutation: Disjunctive clauses (A or B) and (not A or C) resolve to the valid resolvent clause (B or C).");
    cargraph_builder_add_rule(builder, 7.0, 1.0, 0.0, "Syllogistic Subsumption: If all elements of class S belong to genus M, and all elements of genus M belong to predicate P, then all S belong to P.");

    // --- Domain 8: DECISION_PLANNING (Sequential Decisions, Game Theory & Heuristic Planning) ---
    cargraph_builder_add_rule(builder, 8.0, 0.0, 1.0, "Bellman Optimality Principle: An optimal policy satisfies the recursive optimality equation V*(s) = max_a [R(s,a) + gamma * sum(P(s'|s,a) * V*(s'))] with discount factor gamma in [0, 1).");
    cargraph_builder_add_rule(builder, 8.0, 0.0, 1.0, "Strict Action Dominance Invariant: A rational agent cannot select a strictly dominated action if an alternative yields strictly higher expected utility across all future states.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Nash Equilibrium Stability: A strategy profile is a Nash equilibrium if no player has a profitable unilateral deviation given the strategies of all other players.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Pareto Efficiency: A state allocation is Pareto optimal if no player payoff can be increased without strictly decreasing the payoff of at least one other player.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Temporal Credit Assignment: State-action values update under temporal difference error: Q(s, a) = Q(s, a) + alpha * [r + gamma * max_a' Q(s', a') - Q(s, a)].");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "MCTS UCB1 Exploration Balance: Upper Confidence Bound for Trees selects actions maximizing Q(s, a) + c * sqrt(ln(N(s)) / N(s, a)) balancing exploitation against exploration.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Markov State Property: Future state transitions depend conditionally only upon the current state and action, independent of the historical trajectory.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Goal-Directed Backward Induction: In finite extensive-form games, backward induction from terminal payoff nodes computes the subgame-perfect equilibrium.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Deductive Action Preconditions: An action A is executable in state S if and only if the logical preconditions Pre(A) are deductively satisfied in S.");
    cargraph_builder_add_rule(builder, 8.0, 1.0, 0.0, "Heuristic Admissibility: An A* state-space search heuristic h(s) must never overestimate the true minimal cost to the goal state to guarantee optimality.");

    printf("[Ingest Compiler] Ingested 9 cognitive domains and 72 structured rules (18 strict invariants).\n");

    // -------------------------------------------------------------------------
    // 3. Automated SMT/SAT Consistency Verification Pass
    // -------------------------------------------------------------------------
    printf("[Ingest Compiler] Running SMT/SAT Propositional Consistency Verification Pass...\n");
    let solver = sat_solver_create(80.0);

    // Assert strict invariants as positive ground axioms across all 9 domains
    sat_assert_axiom(solver, 0.0);
    sat_assert_axiom(solver, 1.0);
    sat_assert_axiom(solver, 2.0);
    sat_assert_axiom(solver, 3.0);
    sat_assert_axiom(solver, 4.0);
    sat_assert_axiom(solver, 5.0);
    sat_assert_axiom(solver, 12.0);
    sat_assert_axiom(solver, 18.0);
    sat_assert_axiom(solver, 24.0);
    sat_assert_axiom(solver, 25.0);
    sat_assert_axiom(solver, 32.0);
    sat_assert_axiom(solver, 33.0);
    sat_assert_axiom(solver, 42.0);
    sat_assert_axiom(solver, 43.0);
    sat_assert_axiom(solver, 52.0);
    sat_assert_axiom(solver, 53.0);
    sat_assert_axiom(solver, 62.0);
    sat_assert_axiom(solver, 63.0);

    // Model valid implication dependencies across domains
    sat_add_implication(solver, 6.0, 7.0);   // Kinetic Energy -> Inelastic Dissipation
    sat_add_implication(solver, 7.0, 8.0);   // Inelastic Dissipation -> Restitution e < 1.0
    sat_add_implication(solver, 14.0, 15.0); // Exterior Derivative -> Stokes Theorem
    sat_add_implication(solver, 21.0, 22.0); // Polynomial Reduction -> NP-Completeness
    sat_add_implication(solver, 26.0, 27.0); // Photosynthesis -> Cellular Respiration energy loop
    sat_add_implication(solver, 25.0, 31.0); // Central Dogma -> Translation
    sat_add_implication(solver, 37.0, 38.0); // Velocity -> Acceleration
    sat_add_implication(solver, 39.0, 40.0); // States of Matter: Solid -> Liquid phase continuity
    sat_add_implication(solver, 44.0, 45.0); // Lexical parsing -> Topical coherence
    sat_add_implication(solver, 45.0, 47.0); // Topical coherence -> Lexical grounding
    sat_add_implication(solver, 42.0, 49.0); // Speech act coherence -> Propositional commitment
    sat_add_implication(solver, 47.0, 48.0); // Lexical grounding -> High IC discrimination
    sat_add_implication(solver, 50.0, 51.0); // Cooperative principle -> Discourse transition bridges
    sat_add_implication(solver, 54.0, 56.0); // Modus Ponens -> Hypothetical Syllogism
    sat_add_implication(solver, 56.0, 60.0); // Hypothetical Syllogism -> Resolution Refutation
    sat_add_implication(solver, 57.0, 55.0); // Contraposition -> Modus Tollens
    sat_add_implication(solver, 58.0, 59.0); // De Morgan Conjunction -> De Morgan Disjunction
    sat_add_implication(solver, 54.0, 70.0); // Modus Ponens -> Deductive Preconditions
    sat_add_implication(solver, 70.0, 62.0); // Deductive Preconditions -> Bellman Optimality
    sat_add_implication(solver, 62.0, 66.0); // Bellman Optimality -> Temporal Credit Assignment
    sat_add_implication(solver, 64.0, 65.0); // Nash Equilibrium -> Pareto Efficiency
    sat_add_implication(solver, 67.0, 71.0); // MCTS UCB1 -> Heuristic Admissibility

    let is_consistent = sat_solve_consistency(solver);
    if (is_consistent == 0.0) {
        printf("[FATAL] SMT/SAT Verification FAILED! Binary serialization aborted.\n");
        printf("  -> Contradiction between variable %.0f and %.0f (Conflict type: %.0f)\n",
               solver.conflict_var1, solver.conflict_var2, solver.conflict_type);
        sat_solver_free(solver);
        return 1.0;
    }
    printf("[Ingest Compiler] [PASS] SMT/SAT consistency mathematically proved across 72 rules. Graph is SAT.\n");

    // -------------------------------------------------------------------------
    // 4. Binary Emission
    // -------------------------------------------------------------------------
    printf("[Ingest Compiler] Serializing validated .car_graph flat binary to disk...\n");
    let serialize_res = cargraph_serialize_to_file(builder, out_path);
    if (serialize_res == 0.0) {
        printf("[FATAL] Failed to serialize binary file: %s\n", out_path);
        sat_solver_free(solver);
        return 1.0;
    }

    sat_solver_free(solver);
    printf("[Ingest Compiler] Successfully generated: %s\n", out_path);
    printf("=================================================================================\n");
    printf("  INGESTION COMPILATION SUCCESSFUL (Code 0)\n");
    printf("=================================================================================\n\n");
    cartan_flush(0.0);
    return 0.0;
}
