// tools/ns_rule_generator.car
// Automated Neuro-Symbolic Rule Generator & Horn-Clause Ingestion Compiler
// Ingests structured relational triples (ConceptNet / ATOMIC 2020), validates via SMT/SAT,
// and compiles them into flat binary .car_graph files and native CARTAN declarative rules.

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";

extern fn sys_get_arg_count() -> float;
extern fn sys_get_arg(idx: float) -> string;
extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn atof(s: string) -> float;

// Normalizes a relational triple into natural language rule text
fn ns_normalize_triple_to_rule(head: string, rel: string, tail: string) -> string {
    if (cartan_string_eq(rel, "HasPrerequisite") != 0.0) {
        return cartan_string_concat(cartan_string_concat(head, " is a mandatory prerequisite for "), cartan_string_concat(tail, "."));
    }
    if (cartan_string_eq(rel, "Causes") != 0.0) {
        return cartan_string_concat(cartan_string_concat(head, " directly causes "), cartan_string_concat(tail, "."));
    }
    if (cartan_string_eq(rel, "xIntent") != 0.0) {
        return cartan_string_concat("The communicative intent behind ", cartan_string_concat(cartan_string_concat(head, " is "), cartan_string_concat(tail, ".")));
    }
    if (cartan_string_eq(rel, "xNeed") != 0.0) {
        return cartan_string_concat("Executing ", cartan_string_concat(cartan_string_concat(head, " requires "), cartan_string_concat(tail, " beforehand.")));
    }
    if (cartan_string_eq(rel, "xEffect") != 0.0) {
        return cartan_string_concat("The pragmatic consequence of ", cartan_string_concat(cartan_string_concat(head, " is "), cartan_string_concat(tail, ".")));
    }
    if (cartan_string_eq(rel, "MustAgree") != 0.0) {
        return cartan_string_concat(head, cartan_string_concat(" must strictly maintain syntactic agreement with ", cartan_string_concat(tail, ".")));
    }
    if (cartan_string_eq(rel, "BoundedBy") != 0.0) {
        return cartan_string_concat(head, cartan_string_concat(" is structurally bounded by ", cartan_string_concat(tail, ".")));
    }
    if (cartan_string_eq(rel, "IsA") != 0.0) {
        return cartan_string_concat(head, cartan_string_concat(" is a specialized taxonomic instance of ", cartan_string_concat(tail, ".")));
    }
    return cartan_string_concat(cartan_string_concat(head, " "), cartan_string_concat(cartan_string_concat(rel, " "), cartan_string_concat(tail, ".")));
}

// Ingests structured triples string buffer into CARGRAPH builder and SAT solver
fn ns_process_triples_buffer(
    content: string,
    builder: CarGraphBuilder,
    solver: SatSolver,
    domain_idx: float,
    min_confidence: float
) -> float {
    if (content == 0.0 || cartan_string_length(content) == 0.0) {
        return 0.0;
    }

    let lines = string_split(content, "\n");
    let num_lines = cartan_tree_len_f(lines);
    var ingested_count = 0.0;
    var i = 0.0;

    while (i < num_lines) {
        let raw_line = cartan_tree_get_f32(lines, i);
        let line_len = cartan_string_length(raw_line);
        // Skip comments and empty lines
        if (line_len > 2.0 && cartan_string_starts_with(raw_line, "#") == 0.0) {
            // Split fields by TAB or COMMA
            var fields = string_split(raw_line, "\t");
            if (cartan_tree_len_f(fields) < 3.0) {
                fields = string_split(raw_line, ",");
            }
            let num_fields = cartan_tree_len_f(fields);
            if (num_fields >= 3.0) {
                let head = cartan_tree_get_f32(fields, 0.0);
                let rel = cartan_tree_get_f32(fields, 1.0);
                let tail = cartan_tree_get_f32(fields, 2.0);

                var conf = 1.0;
                if (num_fields >= 4.0) {
                    let conf_str = cartan_tree_get_f32(fields, 3.0);
                    conf = atof(conf_str);
                    if (conf <= 0.0) { conf = 1.0; }
                }

                var is_strict = 0.0;
                if (num_fields >= 5.0) {
                    let strict_str = cartan_tree_get_f32(fields, 4.0);
                    is_strict = atof(strict_str);
                }

                // Filter by minimum confidence threshold
                if (conf >= min_confidence) {
                    let rule_text = ns_normalize_triple_to_rule(head, rel, tail);
                    cargraph_builder_add_rule(builder, domain_idx, 1.0, is_strict, rule_text);

                    // If strict invariant, assert in SAT solver
                    let rule_var_id = collections_list_len(builder.rule_domain_indices) - 1.0;
                    if (is_strict > 0.0 && rule_var_id < solver.num_vars) {
                        sat_assert_axiom(solver, rule_var_id);
                    }
                    ingested_count = ingested_count + 1.0;
                }
            }
        }
        i = i + 1.0;
    }
    return ingested_count;
}

// Generates native declarative CARTAN source code representation
fn ns_emit_declarative_cartan(
    builder: CarGraphBuilder,
    domain_name: string,
    output_path: string
) -> float {
    let num_rules = collections_list_len(builder.rule_domain_indices);
    if (num_rules <= 0.0) { return 0.0; }

    var code = cartan_string_concat("// Auto-Generated Declarative Knowledge Base from Neuro-Symbolic Triples\n\nknowledge_base ", cartan_string_concat(domain_name, " {\n"));

    var i = 0.0;
    while (i < num_rules) {
        let r_text = cartan_tree_get_f32(builder.rule_strings, i);
        let r_strict = collections_list_get(builder.rule_is_stricts, i);
        let r_idx_str = cartan_float_to_string(i);

        var r_decl = "    rule r_";
        r_decl = cartan_string_concat(r_decl, r_idx_str);
        if (r_strict > 0.0) {
            r_decl = cartan_string_concat(r_decl, " [invariant] = \"");
        } else {
            r_decl = cartan_string_concat(r_decl, " = \"");
        }
        r_decl = cartan_string_concat(r_decl, r_text);
        r_decl = cartan_string_concat(r_decl, "\";\n");

        code = cartan_string_concat(code, r_decl);
        i = i + 1.0;
    }
    code = cartan_string_concat(code, "}\n");
    return fs_write_all(output_path, code);
}

fn main(argc: float, argv: ptr) -> float {
    printf("=================================================================================\n");
    printf("  CARTAN NEURO-SYMBOLIC RULE GENERATOR & INGESTION COMPILER\n");
    printf("  Compiling ConceptNet 5.8 & ATOMIC 2020 Triples into Validated Knowledge Bases\n");
    printf("=================================================================================\n\n");

    var in_path = "";
    var out_graph_path = "build/generated_ns_knowledge.car_graph";
    var out_car_path = "build/generated_knowledge_base.car";

    let num_args = sys_get_arg_count();
    if (num_args >= 2.0) {
        in_path = sys_get_arg(1.0);
    }
    if (num_args >= 3.0) {
        out_graph_path = sys_get_arg(2.0);
    }
    if (num_args >= 4.0) {
        out_car_path = sys_get_arg(3.0);
    }

    var content = "";
    if (cartan_string_length(in_path) > 0.0 && fs_exists(in_path) != 0.0) {
        printf("[Rule Generator] Ingesting triples from file: %s\n", in_path);
        content = fs_read_all(in_path);
    } else {
        printf("[Rule Generator] Using Canonical ATOMIC 2020 & ConceptNet Ingest Suite...\n");
        // Canonical sample of high-confidence triples
        content = "# Head\tRelation\tTail\tConfidence\tIsStrict\n";
        content = cartan_string_concat(content, "speech\tHasPrerequisite\tvocabulary\t1.0\t1.0\n");
        content = cartan_string_concat(content, "question\txIntent\tanswer\t0.98\t1.0\n");
        content = cartan_string_concat(content, "pronoun\tMustAgree\tantecedent\t1.0\t1.0\n");
        content = cartan_string_concat(content, "contradiction\tCauses\tcommunication_failure\t0.95\t0.0\n");
        content = cartan_string_concat(content, "turn_taking\tBoundedBy\tdelimiters\t0.99\t0.0\n");
        content = cartan_string_concat(content, "asserting_proposition\txEffect\tlogical_commitment\t0.96\t0.0\n");
    }

    let builder = cargraph_builder_create(1536.0);
    let solver = sat_solver_create(256.0);

    let count = ns_process_triples_buffer(content, builder, solver, 6.0, 0.95);
    printf("[Rule Generator] Ingested %.0f validated relational triples.\n", count);
    cargraph_builder_add_domain(builder, 6.0, 0.0, count, builder.num_strict); // Domain 6: LANGUAGE_DISCOURSE

    // Verify SMT/SAT consistency
    printf("[Rule Generator] Verifying SMT/SAT propositional consistency...\n");
    let is_sat = sat_solve_consistency(solver);
    if (is_sat == 0.0) {
        printf("[FATAL] Rule set contains contradictory axioms ($P \\land \\neg P$)!\n");
        sat_solver_free(solver);
        cargraph_builder_free(builder);
        return 1.0;
    }
    printf("[Rule Generator] [PASS] SMT/SAT consistency mathematically proved. Graph is SAT.\n");

    // Serialize .car_graph
    printf("[Rule Generator] Serializing flat binary to: %s\n", out_graph_path);
    let s_ok = cargraph_serialize_to_file(builder, out_graph_path);
    if (s_ok == 0.0) {
        printf("[FATAL] Failed to serialize .car_graph binary!\n");
        sat_solver_free(solver);
        cargraph_builder_free(builder);
        return 1.0;
    }

    // Emit declarative CARTAN code
    printf("[Rule Generator] Emitting declarative CARTAN source to: %s\n", out_car_path);
    ns_emit_declarative_cartan(builder, "language_discourse_generated", out_car_path);

    sat_solver_free(solver);
    cargraph_builder_free(builder);

    printf("=================================================================================\n");
    printf("  NEURO-SYMBOLIC RULE GENERATION COMPILATION SUCCESSFUL (Code 0)\n");
    printf("=================================================================================\n\n");
    cartan_flush(0.0);
    return 0.0;
}
