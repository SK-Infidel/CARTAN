// tools/build_toolchain.car
// CARTAN Developer Utility: Atomic Compiler Build, Synchronizer & Regression Suite Harness

include "src/cartanc/ast.ch";

extern fn printf(fmt: string, val: string) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn system(cmd: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("====================================================\n", "");
    printf(" CARTAN Developer Toolchain Builder & Sync Harness\n", "");
    printf("====================================================\n\n", "");
    cartan_flush(0.0);

    // [Step 1] Synchronize c_runtime.c to ~/.cartan/
    printf("[1/2] Synchronizing C Runtime Kernel to ~/.cartan/c_runtime.c...\n", "");
    cartan_flush(0.0);
    system("cmd.exe /c copy /Y src\\cartanc\\c_runtime.c C:\\Users\\rich-\\.cartan\\c_runtime.c");
    printf(" -> Sync Complete.\n", "");

    // [Step 2] Execute 13-target Compiler Regression Test Suite
    printf("[2/2] Executing 13-Target Compiler Regression Suite...\n", "");
    cartan_flush(0.0);
    system("cartanc.exe build test/compiler_suite/run_tests.car -o run_tests.exe");

    printf("\nAtomic Toolchain Build & Verification Complete!\n", "");
    return 0.0;
}
