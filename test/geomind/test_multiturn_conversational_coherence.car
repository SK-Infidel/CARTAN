// test/geomind/test_multiturn_conversational_coherence.car
// Verification Suite: Multi-Turn Conversational Coherence & Dynamic Entity Grounding

fn sleep_detect_attractor_voids(basins_file: string, dim: float) -> float { return 0.0; }
fn cartan_tensor_train_step(hidden_ptr: ptr, target_tok_id: float, learning_rate: float) -> float { return 0.0; }

include "test/geomind/chat.cl";

fn test_assert(cond: float, msg: string) -> float {
    if (cond == 0.0) {
        printf("[FAILURE] %s\n", msg);
        cartan_flush(0.0);
        return 0.0;
    }
    printf("[SUCCESS] %s\n", msg);
    cartan_flush(0.0);
    return 1.0;
}

fn main() -> float {
    printf("================================================================================\n");
    printf("  GEOMIND MULTI-TURN CONVERSATIONAL COHERENCE & DYNAMIC GROUNDING SUITE\n");
    printf("================================================================================\n\n");
    cartan_flush(0.0);

    let test_db_path = "test/geomind/trainingdata/test_multiturn.db";
    if (cartan_file_exists(test_db_path) == 1.0) {
        remove(test_db_path);
    }

    let db = sqlite_vec_open(test_db_path);
    test_assert(db != 0.0, "Opened new test database");
    sqlite_vec_init_schema(db);
    sqlite_vec_upsert_domain(db, 0.0, "SYSTEM_INVARIANTS", "Safety");
    sqlite_vec_upsert_domain(db, 1.0, "PHYSICS_AND_WORLD", "World State");
    sqlite_vec_upsert_domain(db, 4.0, "BIOLOGY_AND_LIFE", "Life Sciences");
    sqlite_vec_upsert_domain(db, 9.0, "SELF_AND_IDENTITY", "Self Awareness");

    // Populate entity states
    sqlite_vec_upsert_entity_state(db, 1.0, "France", "capital", "Paris", 1.0);
    sqlite_vec_upsert_entity_state(db, 1.0, "Germany", "capital", "Berlin", 1.0);
    sqlite_vec_upsert_entity_state(db, 1.0, "Japan", "capital", "Tokyo", 1.0);
    sqlite_vec_upsert_entity_state(db, 4.0, "Cell", "division", "mitosis", 1.0);
    sqlite_vec_upsert_entity_state(db, 9.0, "Self", "name", "GeoMind", 1.0);
    sqlite_vec_upsert_entity_state(db, 1.0, "User", "preferred_name", "Rick", 1.0);

    g_chat_db = db;
    g_chat_db_init = 1.0;

    // --- GATE 1: Dynamic Entity Grounding (ISSUE-318) ---
    printf("\n--- Gate 1: Dynamic Factual Attractor Retrieval & Entity Matching ---\n");
    let res_france = geomind_chat_retrieve_factual_attractor("What is the capital of France?", 1.0);
    test_assert(cartan_string_contains(res_france, "Paris") == 1.0, "Dynamically grounded France.capital -> Paris");

    let res_germany = geomind_chat_retrieve_factual_attractor("Tell me about Germany capital city", 1.0);
    test_assert(cartan_string_contains(res_germany, "Berlin") == 1.0, "Dynamically grounded Germany.capital -> Berlin");

    let res_japan = geomind_chat_retrieve_factual_attractor("Is Tokyo the capital of Japan?", 1.0);
    test_assert(cartan_string_contains(res_japan, "Tokyo") == 1.0, "Dynamically grounded Japan.capital -> Tokyo");

    let res_cell = geomind_chat_retrieve_factual_attractor("How does a biological Cell perform division?", 4.0);
    test_assert(cartan_string_contains(res_cell, "mitosis") == 1.0, "Dynamically grounded Cell.division -> mitosis");

    // --- GATE 2: Multi-Turn Episode Logging & Prior Retrieval (ISSUE-317) ---
    printf("\n--- Gate 2: Multi-Turn Conversation Logging & Prior Retrieval ---\n");
    // Turn 1
    geomind_chat_log_turn("user", "Hello! I am building a starship.");
    geomind_chat_log_turn("geomind", "Greetings Rick! Building a starship sounds like an ambitious engineering journey.");

    // Turn 2
    geomind_chat_log_turn("user", "We are naming the starship Odyssey.");
    geomind_chat_log_turn("geomind", "Odyssey is a noble name for an interstellar exploration vessel.");

    // Turn 3 Active Prompt
    geomind_chat_log_turn("user", "What was the name of the starship?");

    // Query prior episodes for active session (must retrieve turns 1 and 2, but NOT current turn 3)
    let ep_stmt = cartan_sqlite_prepare_prior_episodes(db, "session_active", 6.0);
    test_assert(ep_stmt != 0.0, "Prepared prior episodes query");

    var prior_count = 0.0;
    var has_odyssey = 0.0;
    var has_active_question = 0.0;
    while (cartan_sqlite_step(ep_stmt) == 100.0) {
        let spk = cartan_sqlite_column_text(ep_stmt, 0.0);
        let cnt = cartan_sqlite_column_text(ep_stmt, 1.0);
        if (cartan_string_contains(cnt, "Odyssey") == 1.0) {
            has_odyssey = 1.0;
        }
        if (cartan_string_contains(cnt, "What was the name") == 1.0) {
            has_active_question = 1.0;
        }
        prior_count = prior_count + 1.0;
    }
    cartan_sqlite_finalize(ep_stmt);

    test_assert(prior_count == 4.0, "Retrieved exactly 4 prior turns (2 user, 2 model)");
    test_assert(has_odyssey == 1.0, "Prior history contains 'Odyssey' context");
    test_assert(has_active_question == 0.0, "Current active question correctly excluded from prior history");

    // --- GATE 3: Multi-Turn Token Stream Packaging ---
    printf("\n--- Gate 3: Multi-Turn Token Stream Assembly ---\n");
    let test_tokens = cartan_vec_create();
    cartan_vec_push_f32(test_tokens, 2.0); // <bos>

    let ep_stmt2 = cartan_sqlite_prepare_prior_episodes(db, "session_active", 6.0);
    while (cartan_sqlite_step(ep_stmt2) == 100.0) {
        let spk = cartan_sqlite_column_text(ep_stmt2, 0.0);
        let cnt = cartan_sqlite_column_text(ep_stmt2, 1.0);
        var r_tok = 4368.0;
        if (cartan_string_eq(spk, "user") == 1.0) { r_tok = 2364.0; }
        geomind_chat_append_turn_tokens(test_tokens, r_tok, cnt);
    }
    cartan_sqlite_finalize(ep_stmt2);

    // Current turn
    geomind_chat_append_turn_tokens(test_tokens, 2364.0, "What was the name of the starship?");
    // Model starter
    cartan_vec_push_f32(test_tokens, 105.0);
    cartan_vec_push_f32(test_tokens, 4368.0);
    cartan_vec_push_f32(test_tokens, 107.0);

    let total_toks = cartan_vec_len(test_tokens);
    printf("Total Multi-Turn Token Sequence Length: %s tokens\n", cartan_float_to_string(total_toks));
    test_assert(total_toks > 30.0, "Multi-turn prompt tokens assembled with prior dialogue history");
    cartan_vec_free(test_tokens);

    // --- GATE 4: Session Clear Verification ---
    printf("\n--- Gate 4: Session Clearing (/clear /new /reset) ---\n");
    geomind_chat_set_session_pos(120.0);
    test_assert(geomind_chat_get_session_pos() == 120.0, "Session position successfully set to 120.0");
    let clr_ok = geomind_chat_clear_session();
    test_assert(clr_ok == 1.0, "Executed geomind_chat_clear_session()");
    test_assert(geomind_chat_get_session_pos() == 0.0, "Session position reset to 0.0 upon session clear");

    let ep_stmt3 = cartan_sqlite_prepare_prior_episodes(db, "session_active", 6.0);
    var post_clr_count = 0.0;
    while (cartan_sqlite_step(ep_stmt3) == 100.0) {
        post_clr_count = post_clr_count + 1.0;
    }
    cartan_sqlite_finalize(ep_stmt3);
    test_assert(post_clr_count == 0.0, "Active session history cleanly cleared");

    // --- GATE 5: Triggered Associative Recall & Memory Cues ---
    printf("\n--- Gate 5: Triggered Associative Memory Cues ---\n");
    let trig_rem = geomind_chat_detect_associative_trigger("Remember when we were talking about the starship Odyssey?");
    test_assert(trig_rem == 1.0, "Triggered associative recall on 'Remember when...'");

    let trig_earlier = geomind_chat_detect_associative_trigger("Earlier you said something about Berlin.");
    test_assert(trig_earlier == 1.0, "Triggered associative recall on 'Earlier you said...'");

    let trig_recall = geomind_chat_detect_associative_trigger("Do you recall what we discussed a while back?");
    test_assert(trig_recall == 1.0, "Triggered associative recall on 'Do you recall...'");

    let trig_none = geomind_chat_detect_associative_trigger("Calculate the square root of 144.");
    test_assert(trig_none == 0.0, "Negative trigger correctly ignored on standard calculation prompt");

    sqlite_vec_close(db);
    remove(test_db_path);

    printf("\n================================================================================\n");
    printf("  ALL MULTI-TURN CONVERSATIONAL COHERENCE & GROUNDING TESTS PASSED!\n");
    printf("================================================================================\n\n");
    cartan_flush(0.0);
    return 0.0;
}
