// test/geomind/ising_state_machine.car
// GeoMind Continuous Hopfield Topological Physics & Ising Spin State Machine

include "../../src/std/physics.car";

struct IsingState {
    num_spins: float;
    temperature: float;
    spins: ptr;
}

fn geomind_ising_relax(state: IsingState, steps: float) -> IsingState {
    if (state.spins == 0.0) { return state; }
    var step = 0.0;
    while (step < steps) {
        var i = 0.0;
        while (i < state.num_spins) {
            let s = cartan_tree_get_f32(state.spins, i);
            let relaxed_s = physics::hopfield_spin_relax(s, 0.0, state.temperature);
            cartan_tree_set(state.spins, i, relaxed_s);
            i = i + 1.0;
        }
        step = step + 1.0;
    }
    return state;
}
