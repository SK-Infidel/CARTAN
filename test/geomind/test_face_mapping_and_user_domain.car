// test/geomind/test_face_mapping_and_user_domain.car
// Verification Suite for Sprint 493:
// Gate 1: Domain 10 Registration, User Profile Partitioning & Creator Decoupling
// Gate 2: L2 Unit Hypersphere Normalization & Bit-for-Bit CSV Vector Serialization
// Gate 3: Eikonal Face Feature Embedding & Cosine Similarity Verification
// Gate 4: Cognitive Preamble Dynamic Conditioning Across Verified vs Guest Interlocutors

include "src/std/math.cl";
include "src/std/string.cl";
include "src/std/collections.cl";
include "src/std/fs.cl";
include "src/std/sqlite_vec.cl";
include "src/std/vision.cl";

extern fn cartan_assert(cond: float, msg: string);
extern fn cartan_test_banner(name: string);
extern fn cartan_print_test_summary(passed: float, failed: float);

// Forward declaration of chat preamble routines for standalone testing
var g_active_user_id: string = "User:Guest";
var g_active_user_verified: float = 0.0;

fn test_chat_build_preamble(db: ptr) -> string {
    if (db == 0.0) { return ""; }
    var s_name = sqlite_vec_get_entity_state(db, 9.0, "Self", "name");
    if (cartan_string_length(s_name) == 0.0) { s_name = "GeoMind"; }
    var s_creator = sqlite_vec_get_entity_state(db, 9.0, "Self", "creator");
    if (cartan_string_length(s_creator) == 0.0) { s_creator = "Rick"; }
    var s_role = sqlite_vec_get_entity_state(db, 9.0, "Self", "role");
    if (cartan_string_length(s_role) == 0.0) { s_role = "Neuro-Symbolic Cognitive Assistant"; }

    var pre = "You are ";
    pre = cartan_string_concat(pre, s_name);
    pre = cartan_string_concat(pre, ". Your creator and architect is ");
    pre = cartan_string_concat(pre, s_creator);
    pre = cartan_string_concat(pre, ". Your role is ");
    pre = cartan_string_concat(pre, s_role);
    pre = cartan_string_concat(pre, ". ");

    if (cartan_string_eq(g_active_user_id, "User:Rick") == 1.0) {
        pre = cartan_string_concat(pre, "The user speaking with you is Rick (Creator & Architect, Verified). Always identify yourself as ");
        pre = cartan_string_concat(pre, s_name);
        pre = cartan_string_concat(pre, " and acknowledge ");
        pre = cartan_string_concat(pre, s_creator);
        pre = cartan_string_concat(pre, " as your creator.");
    } else if (g_active_user_verified == 1.0) {
        let u_name = sqlite_vec_get_user_attr(db, g_active_user_id, "preferred_name");
        pre = cartan_string_concat(pre, "The user speaking with you is ");
        pre = cartan_string_concat(pre, u_name);
        pre = cartan_string_concat(pre, " (Verified Interlocutor). Always identify yourself as ");
        pre = cartan_string_concat(pre, s_name);
        pre = cartan_string_concat(pre, " and acknowledge ");
        pre = cartan_string_concat(pre, s_creator);
        pre = cartan_string_concat(pre, " as your creator.");
    } else {
        pre = cartan_string_concat(pre, "The user speaking with you is an unverified guest. Greet them politely and ask who they are without assuming their identity. Always identify yourself as ");
        pre = cartan_string_concat(pre, s_name);
        pre = cartan_string_concat(pre, " and acknowledge ");
        pre = cartan_string_concat(pre, s_creator);
        pre = cartan_string_concat(pre, " as your creator.");
    }
    return pre;
}

fn main() -> float {
    printf("======================================================================\n[TEST] Sprint 493: Domain 10 USERS_AND_RELATIONSHIPS & Biometric Face Mapping Verification\n======================================================================\n");
    var total_passed = 0.0;
    var total_failed = 0.0;

    let test_db_path = "scratch/test_biometrics_domain10.db";
    if (cartan_file_exists(test_db_path) == 1.0) {
        remove(test_db_path);
    }

    let db = sqlite_vec_open(test_db_path);
    cartan_assert(db != 0.0, "Database handle successfully opened");
    sqlite_vec_init_schema(db);

    // Seed Domain 9 (Self & Identity)
    sqlite_vec_upsert_domain(db, 9.0, "SELF_AND_IDENTITY", "Introspective Identity, Self-Concept, Agency, and Creator Relationship");
    sqlite_vec_upsert_entity_state(db, 9.0, "Self", "name", "GeoMind", 1.0);
    sqlite_vec_upsert_entity_state(db, 9.0, "Self", "creator", "Rick", 1.0);
    sqlite_vec_upsert_entity_state(db, 9.0, "Self", "role", "Neuro-Symbolic Cognitive Assistant", 1.0);

    // =========================================================================
    // Gate 1: Domain 10 Registration, Seeding & Profile Partitioning
    // =========================================================================
    printf("\n--- GATE 1: Domain 10 Registration, Seeding & Profile Partitioning ---\n");
    let init10_ok = sqlite_vec_init_domain10(db);
    cartan_assert(init10_ok == 1.0, "sqlite_vec_init_domain10 succeeded");

    let r_name = sqlite_vec_get_user_attr(db, "User:Rick", "preferred_name");
    cartan_assert(cartan_string_eq(r_name, "Rick") == 1.0, "User:Rick preferred_name == 'Rick'");

    let r_role = sqlite_vec_get_user_attr(db, "User:Rick", "role");
    cartan_assert(cartan_string_eq(r_role, "Creator & Architect") == 1.0, "User:Rick role == 'Creator & Architect'");

    let r_rel = sqlite_vec_get_user_attr(db, "User:Rick", "relationship");
    cartan_assert(cartan_string_eq(r_rel, "Father / Primary Creator") == 1.0, "User:Rick relationship == 'Father / Primary Creator'");

    let r_tier = sqlite_vec_get_user_attr(db, "User:Rick", "permission_tier");
    cartan_assert(cartan_string_eq(r_tier, "root") == 1.0, "User:Rick permission_tier == 'root'");

    let g_name = sqlite_vec_get_user_attr(db, "User:Guest", "preferred_name");
    cartan_assert(cartan_string_eq(g_name, "Guest") == 1.0, "User:Guest preferred_name == 'Guest'");

    let g_tier = sqlite_vec_get_user_attr(db, "User:Guest", "permission_tier");
    cartan_assert(cartan_string_eq(g_tier, "guest") == 1.0, "User:Guest permission_tier == 'guest'");

    // Verify Domain 9 remains invariant
    let s_creator = sqlite_vec_get_entity_state(db, 9.0, "Self", "creator");
    cartan_assert(cartan_string_eq(s_creator, "Rick") == 1.0, "Self.creator remains anchored to 'Rick' in Domain 9");

    printf("  [PASS] Gate 1: Domain 10 User Profiles and Creator Anchoring Verified.\n");
    total_passed = total_passed + 1.0;

    // =========================================================================
    // Gate 2: L2 Unit Hypersphere Normalization & CSV Vector Serialization
    // =========================================================================
    printf("\n--- GATE 2: L2 Unit Hypersphere Normalization & CSV Vector Serialization ---\n");
    let test_dim = 320.0;
    let v_test = cartan_tensor_alloc(test_dim);
    var vi = 0.0;
    while (vi < test_dim) {
        // Construct synthetic deterministic non-zero gradient
        let val = sin(vi * 0.10) + cos(vi * 0.05);
        cartan_vec_set_f32(v_test, vi, val);
        vi = vi + 1.0;
    }

    let norm = cartan_vec_normalize_l2(v_test, test_dim);
    cartan_assert(norm > 0.0, "cartan_vec_normalize_l2 computed valid norm");

    // Compute empirical L2 length of normalized vector
    var sum_sq = 0.0;
    vi = 0.0;
    while (vi < test_dim) {
        let val = cartan_vec_get_f32(v_test, vi);
        sum_sq = sum_sq + (val * val);
        vi = vi + 1.0;
    }
    let l2_len = sqrt(sum_sq);
    printf("  Normalized vector L2 length: %.6f\n", l2_len);
    cartan_assert(math_abs(l2_len - 1.0) < 0.0001, "Vector lies exactly on unit hypersphere S^319 (|len - 1.0| < 1e-4)");

    // Serialize to CSV string
    let csv_str = vision_serialize_vector_csv(v_test, test_dim);
    cartan_assert(cartan_string_length(csv_str) > 500.0, "Serialized CSV string length > 500 chars");

    // Save to Domain 10 in SQLite
    let save_ok = sqlite_vec_save_user_face_embedding(db, "User:Rick", csv_str);
    cartan_assert(save_ok == 1.0, "Saved face embedding to SQLite User:Rick profile");

    let is_reg = sqlite_vec_get_user_attr(db, "User:Rick", "face_registered");
    cartan_assert(cartan_string_eq(is_reg, "1") == 1.0, "User:Rick face_registered == '1'");

    // Retrieve from SQLite and deserialize
    let loaded_csv = sqlite_vec_get_user_face_embedding(db, "User:Rick");
    let v_reconstructed = vision_deserialize_vector_csv(loaded_csv, test_dim);

    // Assert bit-for-bit numerical fidelity across all 320 dimensions
    var max_diff = 0.0;
    vi = 0.0;
    while (vi < test_dim) {
        let orig = cartan_vec_get_f32(v_test, vi);
        let recon = cartan_vec_get_f32(v_reconstructed, vi);
        let diff = math_abs(orig - recon);
        if (diff > max_diff) { max_diff = diff; }
        vi = vi + 1.0;
    }
    printf("  Maximum serialization reconstruction error: %.8f\n", max_diff);
    cartan_assert(max_diff < 0.001, "Maximum reconstruction difference < 1e-3");

    printf("  [PASS] Gate 2: L2 Unit Hypersphere Normalization and CSV Persistence Verified.\n");
    total_passed = total_passed + 1.0;

    // =========================================================================
    // Gate 3: Eikonal Face Feature Embedding & Cosine Similarity Discrimination
    // =========================================================================
    printf("\n--- GATE 3: Eikonal Face Feature Embedding & Cosine Similarity Discrimination ---\n");
    // Self-Identity: similarity(v, v) == 1.0
    let self_sim = vision_cosine_similarity(v_test, v_test, test_dim);
    printf("  Self-Identity Cosine Similarity: %.6f\n", self_sim);
    cartan_assert(math_abs(self_sim - 1.0) < 0.0001, "Self-similarity == 1.0000");

    // Orthogonal Vector Construction: negate even dimensions and swap adjacent pairs
    let v_ortho = cartan_tensor_alloc(test_dim);
    vi = 0.0;
    while (vi < test_dim) {
        if (math_mod(vi, 2.0) == 0.0) {
            cartan_vec_set_f32(v_ortho, vi, -1.0 * cartan_vec_get_f32(v_test, vi + 1.0));
        } else {
            cartan_vec_set_f32(v_ortho, vi, cartan_vec_get_f32(v_test, vi - 1.0));
        }
        vi = vi + 1.0;
    }
    cartan_vec_normalize_l2(v_ortho, test_dim);
    let ortho_sim = vision_cosine_similarity(v_test, v_ortho, test_dim);
    printf("  Orthogonal Vector Cosine Similarity: %.6f\n", ortho_sim);
    cartan_assert(math_abs(ortho_sim) < 0.0001, "Orthogonal similarity == 0.0000");

    // Perturbed Vector (Authentic Face with 8% camera sensor noise): should match >= 0.85
    let v_perturbed = cartan_tensor_alloc(test_dim);
    vi = 0.0;
    while (vi < test_dim) {
        let base = cartan_vec_get_f32(v_test, vi);
        let noise = base * sin(vi * 2.5) * 0.08;
        cartan_vec_set_f32(v_perturbed, vi, base + noise);
        vi = vi + 1.0;
    }
    cartan_vec_normalize_l2(v_perturbed, test_dim);
    let perturbed_sim = vision_cosine_similarity(v_test, v_perturbed, test_dim);
    printf("  Perturbed Live Face Cosine Similarity: %.6f\n", perturbed_sim);
    cartan_assert(perturbed_sim >= 0.85, "Perturbed live face similarity >= 0.85 (VERIFIED MATCH)");

    // Unrelated Independent Face Vector: should fail verification (< 0.50)
    let v_other = cartan_tensor_alloc(test_dim);
    vi = 0.0;
    while (vi < test_dim) {
        let base = cos(vi * 0.8) * cos(vi * 1.3);
        cartan_vec_set_f32(v_other, vi, base);
        vi = vi + 1.0;
    }
    cartan_vec_normalize_l2(v_other, test_dim);
    let other_sim = vision_cosine_similarity(v_test, v_other, test_dim);
    printf("  Unrelated Face Cosine Similarity: %.6f\n", other_sim);
    cartan_assert(other_sim < 0.50, "Unrelated face similarity < 0.50 (CORRECTLY REJECTED)");

    printf("  [PASS] Gate 3: Metric Properties and Biometric Discrimination Verified.\n");
    total_passed = total_passed + 1.0;

    // =========================================================================
    // Gate 4: Cognitive Preamble Conditioning Across Verified vs Guest Interlocutors
    // =========================================================================
    printf("\n--- GATE 4: Cognitive Preamble Conditioning Across Verified vs Guest Interlocutors ---\n");
    // Test Case A: Default Unverified Guest
    g_active_user_id = "User:Guest";
    g_active_user_verified = 0.0;
    let pre_guest = test_chat_build_preamble(db);
    printf("  Guest Preamble: \"%s\"\n", pre_guest);
    cartan_assert(cartan_string_contains(pre_guest, "unverified guest") == 1.0, "Guest preamble identifies user as unverified guest");
    cartan_assert(cartan_string_contains(pre_guest, "The user speaking with you is Rick (Creator") == 0.0, "Guest preamble does NOT claim user is Rick");

    // Test Case B: Authenticated Creator (User:Rick)
    g_active_user_id = "User:Rick";
    g_active_user_verified = 1.0;
    let pre_rick = test_chat_build_preamble(db);
    printf("  Rick Preamble:  \"%s\"\n", pre_rick);
    cartan_assert(cartan_string_contains(pre_rick, "The user speaking with you is Rick (Creator & Architect, Verified)") == 1.0, "Rick preamble confirms verified creator identity");
    cartan_assert(cartan_string_contains(pre_rick, "unverified guest") == 0.0, "Rick preamble does NOT mark Rick as guest");

    // Test Case C: Verified New Interlocutor (User:Alice)
    sqlite_vec_set_user_attr(db, "User:Alice", "preferred_name", "Alice");
    sqlite_vec_set_user_attr(db, "User:Alice", "role", "Collaborator");
    g_active_user_id = "User:Alice";
    g_active_user_verified = 1.0;
    let pre_alice = test_chat_build_preamble(db);
    printf("  Alice Preamble: \"%s\"\n", pre_alice);
    cartan_assert(cartan_string_contains(pre_alice, "The user speaking with you is Alice (Verified Interlocutor)") == 1.0, "Alice preamble addresses Alice by name");

    printf("  [PASS] Gate 4: Cognitive Preamble Multi-User Conditioning Verified.\n");
    total_passed = total_passed + 1.0;

    // Cleanup resources
    sqlite_vec_close(db);
    remove(test_db_path);
    free(v_test);
    free(v_reconstructed);
    free(v_ortho);
    free(v_perturbed);
    free(v_other);

    printf("======================================================================\n[SUMMARY] Passed: %.0f, Failed: %.0f\n======================================================================\n", total_passed, total_failed);
    cartan_assert(total_failed == 0.0, "All 4 Gates in Sprint 493 test suite passed cleanly");
    return 0.0;
}
