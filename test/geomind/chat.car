// test/geomind/chat.car
// Active Vocabulary Interactive Chat Engine

extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_init_magnetic_resonator(n_oscillators: float) -> Tensor;
extern fn cartan_generate_e8_weyl_matrix() -> Tensor;
extern fn cartan_generate_e8_coordinates(n_oscillators: float) -> Tensor;
extern fn cartan_alloc_sequence(size: float) -> Tensor;
extern fn cartan_e8_hopfield_step_gpu(phases: Tensor, coords: Tensor, j_weyl: Tensor, dt: float, size: float);
extern fn cartan_inject_e8_perturbation(phases: Tensor, coords: Tensor, raw_sig: Tensor, size: float);
extern fn cartan_forward_e8_attention_gpu(phases: Tensor, w_q: Tensor, w_k: Tensor, w_v: Tensor, lm_head: Tensor) -> Tensor;
extern fn cartan_sample_ising_attractor(logits: Tensor, temp: float, top_p: float) -> float;
extern fn cartan_record_recent_token(tok_id: float);
extern fn cartan_decode_token_string(tok_id: float);
extern fn cartan_set_tensor_element(t: Tensor, idx: float, val: float);
extern fn cartan_tokenize_prompt_string(prompt_str: string) -> Tensor;
extern fn cartan_load_model_checkpoint(w_q: Tensor, w_k: Tensor, w_v: Tensor, lm_head: Tensor, path: string) -> float;
extern fn cartan_load_active_vocab_mapping(map_path: string) -> float;

fn main() -> float {
    printf("================================================================================\n");
    printf("  GEOMIND CARTAN ACTIVE VOCABULARY CHAT ENGINE (chat.exe)\n");
    printf("  Sliding Context Window QKV Attention | V_active = 180 | E8 Resonator\n");
    printf("================================================================================\n\n");
    cartan_flush(0.0);
    
    cartan_load_active_vocab_mapping("test/geomind/trainingdata/active_vocab_50k_mapping.bin");
    
    var n_oscillators = 1000000.0;
    var phases = cartan_init_magnetic_resonator(n_oscillators);
    var coordinates = cartan_generate_e8_coordinates(n_oscillators);
    var j_weyl = cartan_generate_e8_weyl_matrix();
    
    @agent_accessible parameter[Adam] w_q[240, 240] in Euclidean;
    @agent_accessible parameter[Adam] w_k[240, 240] in Euclidean;
    @agent_accessible parameter[Adam] w_v[240, 240] in Euclidean;
    @agent_accessible parameter[Adam] lm_head[240, 50257] in Euclidean;
    
    cartan_load_model_checkpoint(w_q, w_k, w_v, lm_head, "test/geomind/checkpoints/geomind_sft_grokked.model");
    
    var prompt_seq = cartan_tokenize_prompt_string("Once upon a time there was a brave little knight");
    cartan_inject_e8_perturbation(phases, coordinates, prompt_seq, n_oscillators);
    
    var dt = 0.01;
    var step = 0.0;
    while (step < 10.0) {
        cartan_e8_hopfield_step_gpu(phases, coordinates, j_weyl, dt, n_oscillators);
        step = step + 1.0;
    }
    
    var recent_history = cartan_alloc_sequence(64.0);
    var single_tok = cartan_alloc_sequence(1.0);
    var zero_idx = 0.0;
    
    printf("User: Once upon a time there was a brave little knight\n");
    printf("Assistant: ");
    cartan_flush(0.0);
    
    var gen_step = 0.0;
    while (gen_step < 40.0) {
        var logits_gen: Tensor = cartan_forward_e8_attention_gpu(phases, w_q, w_k, w_v, lm_head);
        var sampled_token_id = cartan_sample_ising_attractor(logits_gen, 0.7, 0.9);
        
        cartan_record_recent_token(sampled_token_id);
        cartan_decode_token_string(sampled_token_id);
        cartan_flush(0.0);
        
        cartan_set_tensor_element(single_tok, zero_idx, sampled_token_id);
        cartan_inject_e8_perturbation(phases, coordinates, single_tok, n_oscillators);
        cartan_e8_hopfield_step_gpu(phases, coordinates, j_weyl, dt, n_oscillators);
        
        gen_step = gen_step + 1.0;
    }
    
    printf("\n\n");
    cartan_flush(0.0);
    return 0.0;
}
