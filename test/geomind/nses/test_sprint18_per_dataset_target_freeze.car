// test/geomind/nses/test_sprint18_per_dataset_target_freeze.car
// Sprint 431 Regression Harness: Per-Dataset Target Loss Freezing & Universal CLI Options
// Verification for [ISSUE-179]

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/fs.cl";
include "src/std/string.cl";

extern fn atof(s: string) -> float;

// Simulates CLI parsing identical to get_cli_target_loss
fn mock_cli_target_loss(flag: string, val_str: string, default_val: float) -> float {
    if (cartan_string_eq(flag, "-training-loss") == 1.0 ||
        cartan_string_eq(flag, "--training-loss") == 1.0 ||
        cartan_string_eq(flag, "-target-loss") == 1.0 ||
        cartan_string_eq(flag, "--target-loss") == 1.0 ||
        cartan_string_eq(flag, "-tl") == 1.0 ||
        cartan_string_eq(flag, "--tl") == 1.0 ||
        cartan_string_eq(flag, "-loss") == 1.0 ||
        cartan_string_eq(flag, "--loss") == 1.0) {
        return atof(val_str);
    }
    return default_val;
}

// Evaluates per-domain freeze status
fn evaluate_domain_frozen(t_loss: float, tr_loss: float, va_loss: float) -> float {
    if (t_loss > 0.0) {
        if ((tr_loss > 0.0 && tr_loss <= t_loss) || (va_loss > 0.0 && va_loss <= t_loss)) {
            return 1.0;
        }
    }
    return 0.0;
}

// Evaluates whether all domains in corpus have reached target loss
fn evaluate_all_domains_reached(num_datasets: float, domain_losses: ptr, val_domain_losses: ptr, t_loss: float) -> float {
    if (t_loss <= 0.0) { return 0.0; }
    var all_reached = 1.0;
    var d = 0.0;
    while (d < num_datasets) {
        let tr_l = cartan_vec_get_f32(domain_losses, d);
        let va_l = cartan_vec_get_f32(val_domain_losses, d);
        if ((tr_l <= 0.0 || tr_l > t_loss) && (va_l <= 0.0 || va_l > t_loss)) {
            all_reached = 0.0;
        }
        d = d + 1.0;
    }
    return all_reached;
}

fn main() -> float {
    printf("=================================================================================\n");
    printf("  SPRINT 431 QA HARNESS: PER-DATASET TARGET LOSS FREEZING & UNIVERSAL CLI\n");
    printf("  Verification of Per-Domain Backprop Gating, Drift Recovery & Stopping\n");
    printf("=================================================================================\n\n");

    // -------------------------------------------------------------------------
    // Gate TS-18.1: Universal CLI Target Loss Flag Aliases
    // -------------------------------------------------------------------------
    printf("[Gate TS-18.1] Testing Universal CLI Target Loss Flag Aliases...\n");
    let t1 = mock_cli_target_loss("-target-loss", "2.15", 3.0);
    let t2 = mock_cli_target_loss("--target-loss", "2.15", 3.0);
    let t3 = mock_cli_target_loss("-tl", "2.15", 3.0);
    let t4 = mock_cli_target_loss("--tl", "2.15", 3.0);
    let t5 = mock_cli_target_loss("-loss", "2.15", 3.0);
    let t6 = mock_cli_target_loss("--loss", "2.15", 3.0);
    let t7 = mock_cli_target_loss("-training-loss", "2.15", 3.0);
    let t8 = mock_cli_target_loss("--training-loss", "2.15", 3.0);
    let t_def = mock_cli_target_loss("-unknown", "2.15", 3.0);

    if (t1 == 2.15 && t2 == 2.15 && t3 == 2.15 && t4 == 2.15 &&
        t5 == 2.15 && t6 == 2.15 && t7 == 2.15 && t8 == 2.15 && t_def == 3.0) {
        printf("  [PASS] All 8 CLI target loss aliases parsed identically (target = 2.15, default = 3.00).\n\n");
    } else {
        printf("  [FAIL] Inconsistent CLI target loss parsing across aliases!\n\n");
        return 1.0;
    }

    // -------------------------------------------------------------------------
    // Gate TS-18.2: Per-Dataset Target Loss Condition & Backward Pass Freezing
    // -------------------------------------------------------------------------
    printf("[Gate TS-18.2] Testing Per-Dataset Target Loss Condition & Step LR Gating...\n");
    let target = 2.00;
    let base_lr = 0.001;

    // D0: 1.85 (reached) -> frozen
    let f0 = evaluate_domain_frozen(target, 1.85, 1.90);
    var lr0 = base_lr;
    if (f0 == 1.0) { lr0 = 0.0; }

    // D1: 2.45 (not reached) -> active
    let f1 = evaluate_domain_frozen(target, 2.45, 2.50);
    var lr1 = base_lr;
    if (f1 == 1.0) { lr1 = 0.0; }

    // D2: 1.95 (reached via val loss) -> frozen
    let f2 = evaluate_domain_frozen(target, 2.05, 1.95);
    var lr2 = base_lr;
    if (f2 == 1.0) { lr2 = 0.0; }

    // D3: 3.10 (not reached) -> active
    let f3 = evaluate_domain_frozen(target, 3.10, 3.15);
    var lr3 = base_lr;
    if (f3 == 1.0) { lr3 = 0.0; }

    if (f0 == 1.0 && lr0 == 0.0 &&
        f1 == 0.0 && lr1 == 0.001 &&
        f2 == 1.0 && lr2 == 0.0 &&
        f3 == 0.0 && lr3 == 0.001) {
        printf("  [PASS] Target reached domains D0/D2 correctly froze backprop (step_lr = 0.0).\n");
        printf("  [PASS] Unreached domains D1/D3 correctly maintained full backprop (step_lr = 0.001).\n\n");
    } else {
        printf("  [FAIL] Incorrect per-domain target loss freezing logic!\n\n");
        return 2.0;
    }

    // -------------------------------------------------------------------------
    // Gate TS-18.3: Bidirectional Loss Drift Recovery
    // -------------------------------------------------------------------------
    printf("[Gate TS-18.3] Testing Bidirectional Loss Drift & Automatic Backprop Resumption...\n");
    // Initially frozen at 1.85
    let init_frozen = evaluate_domain_frozen(target, 1.85, 1.90);

    // Drifts up to 2.15 (both tr and va above 2.00) -> unfreezes
    let drifted_frozen = evaluate_domain_frozen(target, 2.15, 2.20);
    var drifted_lr = base_lr;
    if (drifted_frozen == 1.0) { drifted_lr = 0.0; }

    // Recovered back down to 1.92 -> re-freezes
    let recovered_frozen = evaluate_domain_frozen(target, 1.92, 1.98);
    var recovered_lr = base_lr;
    if (recovered_frozen == 1.0) { recovered_lr = 0.0; }

    if (init_frozen == 1.0 && drifted_frozen == 0.0 && drifted_lr == 0.001 && recovered_frozen == 1.0 && recovered_lr == 0.0) {
        printf("  [PASS] Initial state: Frozen (Loss 1.85 <= 2.00, step_lr = 0.0).\n");
        printf("  [PASS] Drift state: Automatically resumed backprop (Loss 2.15 > 2.00, step_lr = 0.001).\n");
        printf("  [PASS] Recovered state: Re-frozen backprop (Loss 1.92 <= 2.00, step_lr = 0.0).\n\n");
    } else {
        printf("  [FAIL] Bidirectional drift recovery failed to unfreeze/re-freeze backprop!\n\n");
        return 3.0;
    }

    // -------------------------------------------------------------------------
    // Gate TS-18.4: Multi-Domain Full Convergence Stopping Criterion
    // -------------------------------------------------------------------------
    printf("[Gate TS-18.4] Testing Multi-Domain Convergence Stopping Criterion...\n");
    let d_tr = cartan_vec_create();
    let d_va = cartan_vec_create();

    // Partial convergence (2 of 4 domains met target)
    cartan_vec_push_f32(d_tr, 1.85); cartan_vec_push_f32(d_va, 1.90); // D0: met
    cartan_vec_push_f32(d_tr, 2.45); cartan_vec_push_f32(d_va, 2.50); // D1: not met
    cartan_vec_push_f32(d_tr, 1.95); cartan_vec_push_f32(d_va, 1.98); // D2: met
    cartan_vec_push_f32(d_tr, 3.10); cartan_vec_push_f32(d_va, 3.15); // D3: not met

    let partial_reached = evaluate_all_domains_reached(4.0, d_tr, d_va, target);

    // Full convergence (all 4 domains met target)
    cartan_vec_set_f32(d_tr, 1.0, 1.99); cartan_vec_set_f32(d_va, 1.0, 1.98); // D1: now met
    cartan_vec_set_f32(d_tr, 3.0, 1.90); cartan_vec_set_f32(d_va, 3.0, 1.95); // D3: now met

    let full_reached = evaluate_all_domains_reached(4.0, d_tr, d_va, target);

    cartan_vec_free(d_tr);
    cartan_vec_free(d_va);

    if (partial_reached == 0.0 && full_reached == 1.0) {
        printf("  [PASS] Partial convergence (D1/D3 above target): Training continues (all_reached = 0.0).\n");
        printf("  [PASS] Full convergence (all domains <= target): Session terminates (all_reached = 1.0).\n\n");
    } else {
        printf("  [FAIL] Multi-domain stopping criterion failed!\n\n");
        return 4.0;
    }

    printf("=================================================================================\n");
    printf("  ALL SPRINT 431 GATES PASSED (100%% VERIFIED)\n");
    printf("=================================================================================\n");
    return 0.0;
}
