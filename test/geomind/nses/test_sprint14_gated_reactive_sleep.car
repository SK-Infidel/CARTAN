// test/geomind/nses/test_sprint14_gated_reactive_sleep.car
// Sprint 427 Regression Harness: Gated Reactive Sleep on Broken Synaptic Thresholds
// Verification for [ISSUE-175]

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/csr_graph.cl";
include "src/std/sat_solver.cl";
include "src/std/cargraph_simd.cl";
include "src/std/dynamic_graph.cl";
include "src/std/cargraph_consolidate.cl";

fn main() -> float {
    printf("=================================================================================\n");
    printf("  SPRINT 427 QA HARNESS: GATED REACTIVE METACOGNITIVE SLEEP (ISSUE-175)\n");
    printf("  Verification of Synaptic Threshold Detection & Reactive Sleep Gating\n");
    printf("=================================================================================\n\n");

    // -------------------------------------------------------------------------
    // Gate TS-14.1: Baseline Graph Without Decayed Synapses
    // -------------------------------------------------------------------------
    printf("[TS-14.1] Testing Synaptic Threshold Check on Un-decayed Baseline Graph...\n");
    let b1 = csr_builder_create(8.0);
    csr_builder_add_edge(b1, 0.0, 1.0, 1.25, 1.0, 0.0);
    csr_builder_add_edge(b1, 1.0, 2.0, 1.20, 1.0, 0.0);
    csr_builder_add_edge(b1, 2.0, 3.0, 1.15, 1.0, 0.0);
    let csr_clean = csr_builder_build(b1);
    csr_builder_free(b1);

    let arena_empty = dynamic_arena_create(65536.0, 8.0);

    let has_prune_clean = cargraph_has_prunable_synapses(csr_clean, arena_empty, 1.001);
    printf("  -> Baseline Graph Has Prunable Synapses: %.0f (Expected: 0.0)\n", has_prune_clean);
    cartan_assert(has_prune_clean == 0.0, "TS-14.1 Clean graph must not report prunable synapses");
    printf("[PASS] TS-14.1: Baseline graph with weights >= 1.15 verified non-prunable.\n\n");

    // -------------------------------------------------------------------------
    // Gate TS-14.2: Resident CSR Edge Decayed Below Threshold
    // -------------------------------------------------------------------------
    printf("[TS-14.2] Testing Threshold Detection on Decayed Resident CSR Synapse...\n");
    let b2 = csr_builder_create(8.0);
    csr_builder_add_edge(b2, 0.0, 1.0, 1.25, 1.0, 0.0);
    csr_builder_add_edge(b2, 1.0, 2.0, 0.85, 1.0, 0.0); // Decayed synapse: 0.85 < 1.001
    csr_builder_add_edge(b2, 2.0, 3.0, 1.15, 1.0, 0.0);
    let csr_decayed = csr_builder_build(b2);
    csr_builder_free(b2);

    let has_prune_decayed = cargraph_has_prunable_synapses(csr_decayed, arena_empty, 1.001);
    printf("  -> Decayed CSR Graph Has Prunable Synapses: %.0f (Expected: 1.0)\n", has_prune_decayed);
    cartan_assert(has_prune_decayed == 1.0, "TS-14.2 Decayed CSR must report prunable synapses");
    printf("[PASS] TS-14.2: Resident CSR decayed synapse (w=0.85 < 1.001) detected cleanly.\n\n");

    // -------------------------------------------------------------------------
    // Gate TS-14.3: Dynamic Arena Edge Below Threshold
    // -------------------------------------------------------------------------
    printf("[TS-14.3] Testing Threshold Detection on Dynamic Delta Arena Synapse...\n");
    let arena_dynamic = dynamic_arena_create(65536.0, 8.0);
    dynamic_arena_append_edge(arena_dynamic, 0.0, 4.0, 0.75, 1.0); // Dynamic edge: 0.75 < 1.001

    let has_prune_dynamic = cargraph_has_prunable_synapses(csr_clean, arena_dynamic, 1.001);
    printf("  -> Dynamic Arena Graph Has Prunable Synapses: %.0f (Expected: 1.0)\n", has_prune_dynamic);
    cartan_assert(has_prune_dynamic == 1.0, "TS-14.3 Dynamic arena with w=0.75 must report prunable synapses");
    printf("[PASS] TS-14.3: Dynamic arena synapse (w=0.75 < 1.001) detected cleanly.\n\n");

    // -------------------------------------------------------------------------
    // Gate TS-14.4: Reactive Sleep Trigger Gating Under High PPL / Acute Loss Spikes
    // -------------------------------------------------------------------------
    printf("[TS-14.4] Testing Reactive Sleep Suppression Under High PPL Spike...\n");

    // Scenario A: Acute spike (vl = 4.80, ema = 3.90, diff = +0.90, IVPPL = 121.5) on CLEAN graph
    let ema_val_loss = 3.90;
    let vl = 4.80;
    var acute_spike = 0.0;
    if (ema_val_loss > 0.0 && vl > ema_val_loss + 0.35) {
        acute_spike = 1.0;
    }

    var trigger_sleep_clean = 0.0;
    var sleep_reason_clean = "";
    let is_cadence_due = 0.0;
    if (is_cadence_due == 1.0) {
        trigger_sleep_clean = 1.0;
        sleep_reason_clean = "Cadence";
    } else {
        let has_prunable = cargraph_has_prunable_synapses(csr_clean, arena_empty, 1.001);
        if (has_prunable == 1.0) {
            if (acute_spike == 1.0) {
                trigger_sleep_clean = 1.0;
                sleep_reason_clean = "Reactive (Spike & Broken Threshold)";
            }
        }
    }
    printf("  -> Scenario A (Acute Spike, No Prunable Synapses): Sleep Triggered = %.0f (Expected: 0.0)\n", trigger_sleep_clean);
    cartan_assert(trigger_sleep_clean == 0.0, "TS-14.4 Reactive sleep must be suppressed when threshold is unbroken");

    // Scenario B: Acute spike on DECAYED graph (broken threshold)
    var trigger_sleep_decayed = 0.0;
    var sleep_reason_decayed = "";
    if (is_cadence_due == 1.0) {
        trigger_sleep_decayed = 1.0;
    } else {
        let has_prunable = cargraph_has_prunable_synapses(csr_decayed, arena_empty, 1.001);
        if (has_prunable == 1.0) {
            if (acute_spike == 1.0) {
                trigger_sleep_decayed = 1.0;
                sleep_reason_decayed = "Reactive (Acute Loss Spike > +0.35 & Synaptic Threshold Broken)";
            }
        }
    }
    printf("  -> Scenario B (Acute Spike, Broken Threshold): Sleep Triggered = %.0f (Expected: 1.0)\n", trigger_sleep_decayed);
    cartan_assert(trigger_sleep_decayed == 1.0, "TS-14.4 Reactive sleep must engage when threshold is broken");
    printf("[PASS] TS-14.4: Spurious reactive sleep suppressed on un-decayed graph and engaged on broken threshold.\n\n");

    // Clean up
    csr_graph_free(csr_clean);
    csr_graph_free(csr_decayed);
    dynamic_arena_free(arena_empty);
    dynamic_arena_free(arena_dynamic);

    printf("=================================================================================\n");
    printf("  ALL SPRINT 427 REGRESSION GATES PASSED (100%% EMPIRICAL VERIFICATION)\n");
    printf("=================================================================================\n");
    cartan_flush(0.0);
    return 0.0;
}
