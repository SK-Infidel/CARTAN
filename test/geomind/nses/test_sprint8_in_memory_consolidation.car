// test/geomind/nses/test_sprint8_in_memory_consolidation.car
// NSES Phase 8 Verification Harness: In-Memory Hot NSES Graph Consolidation
// Verification Gates: TS-8.1 (In-Memory Compaction), TS-8.2 (Zero Disk I/O & Heap Defragmentation), TS-8.3 (Sub-millisecond Latency)

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/csr_graph.cl";
include "src/std/dynamic_graph.cl";
include "src/std/cargraph_consolidate.cl";
include "src/std/sleep.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn clock() -> float;
extern fn printf(format: string) -> i32;
extern fn malloc(size: float) -> ptr;
extern fn free(p: ptr);

fn main(argc: float, argv: ptr) -> float {
    printf("=================================================================================\n");
    printf("  NSES SPRINT 8 VERIFICATION HARNESS (test_sprint8_in_memory_consolidation)\n");
    printf("  Testing Pure In-Memory CSR Compaction, Zero Disk I/O, Sub-ms Consolidation\n");
    printf("=================================================================================\n\n");

    // 1. Build Base CSR Topology (16 nodes)
    let b_base = csr_builder_create(16.0);
    csr_builder_add_edge(b_base, 0.0, 1.0, 1.50, 1.0, 0.0);
    csr_builder_add_edge(b_base, 2.0, 3.0, 1.40, 1.0, 0.0);
    csr_builder_add_edge(b_base, 4.0, 5.0, 0.50, 1.0, 0.0); // Decayed base edge (w < 1.001)
    let base_csr = csr_builder_build(b_base);
    csr_builder_free(b_base);

    // 2. Populate Dynamic Delta Arena
    let arena = dynamic_arena_create(65536.0, 16.0);
    // Add 4 active dynamic edges (w = 1.35)
    var i = 0.0;
    while (i < 4.0) {
        dynamic_arena_append_edge(arena, i + 6.0, i + 7.0, 1.35, 1.0);
        i = i + 1.0;
    }
    // Add 4 decayed dynamic edges (w = 0.65)
    i = 0.0;
    while (i < 4.0) {
        dynamic_arena_append_edge(arena, i + 11.0, i + 12.0, 0.65, 1.0);
        i = i + 1.0;
    }

    printf("[Setup] Base CSR: 3 edges | Arena: 8 dynamic edges (4 active, 4 decayed)\n");
    cartan_assert(arena.used_bytes == 8.0 * 64.0, "TS-8.0 Arena byte count mismatch");

    // -------------------------------------------------------------------------
    // GATE TS-8.1: Pure In-Memory Compaction
    // -------------------------------------------------------------------------
    printf("\n[TS-8.1] Executing cargraph_sleep_consolidate_memory in pure RAM...\n");
    let metrics = malloc(24.0);
    metrics[0] = 0.0;
    metrics[1] = 0.0;
    metrics[2] = 0.0;

    let t0 = clock();
    let compacted_csr = cargraph_sleep_consolidate_memory(base_csr, arena, 1.001, metrics);
    let t1 = clock();
    let latency_ms = t1 - t0;

    let pruned = metrics[0];
    let retained = metrics[1];
    let duration_recorded = metrics[2];
    free(metrics);

    printf("  -> Retained active edges (w >= 1.001): %.0f (Expected: 6.0 = 2 base + 4 arena)\n", retained);
    printf("  -> Pruned decayed synapses (w < 1.001): %.0f (Expected: 5.0 = 1 base + 4 arena)\n", pruned);
    printf("  -> Arena Used Bytes Post-Compaction: %.0f bytes (Expected: 0)\n", arena.used_bytes);
    printf("  -> In-Memory Compaction Latency: %.2f ms (Recorded: %.2f ms)\n", latency_ms, duration_recorded);

    cartan_assert(retained == 6.0, "TS-8.1 Retained edges count mismatch");
    cartan_assert(pruned == 5.0, "TS-8.1 Pruned edges count mismatch");
    cartan_assert(arena.used_bytes == 0.0, "TS-8.1 Arena not defragmented to 0 bytes");
    cartan_assert(cargraph_verify_csr_monotonicity(compacted_csr) == 1.0, "TS-8.1 CSR monotonicity check");
    printf("[PASS] TS-8.1: In-memory CSR compaction verified with zero disk operations.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-8.2: In-Memory Axiomatic Consolidation via CarGraphFile
    // -------------------------------------------------------------------------
    printf("[TS-8.2] Testing sleep_run_axiomatic_consolidation_graph with loaded binary...\n");
    let graph_path = "test/geomind/trainingdata/nses_knowledge.car_graph";
    let basins_path = "test/geomind/trainingdata/hopfield_basins.bin";
    let cg = cargraph_load_binary(graph_path);
    cartan_assert(cg.is_valid == 1.0, "TS-8.2 Failed to load nses_knowledge.car_graph");

    let t_ax0 = clock();
    let ax_count = sleep_run_axiomatic_consolidation_graph(cg, basins_path, 2560.0, 0.0002);
    let t_ax1 = clock();
    let ax_latency = t_ax1 - t_ax0;

    printf("  -> Axiomatic rules consolidated: %.0f\n", ax_count);
    printf("  -> In-memory Axiomatic Consolidation Latency: %.2f ms\n", ax_latency);
    cartan_assert(ax_count >= 1.0, "TS-8.2 Axiomatic rule consolidation must process rules");
    cargraph_free(cg);
    printf("[PASS] TS-8.2: In-memory axiomatic rule replay verified.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-8.3: Performance & Sub-Millisecond Compaction Gate
    // -------------------------------------------------------------------------
    printf("[TS-8.3] Validating in-memory compaction latency (< 5.0 ms hard gate)...\n");
    cartan_assert(latency_ms < 5.0, "TS-8.3 In-memory compaction latency exceeded 5.0ms hard gate");
    printf("[PASS] TS-8.3: Compaction executed in %.2f ms (hard gate: < 5.0 ms).\n\n", latency_ms);

    csr_graph_free(base_csr);
    csr_graph_free(compacted_csr);
    dynamic_arena_free(arena);

    printf("=================================================================================\n");
    printf("  ALL SPRINT 8 GATES PASSED CLEANLY (Exit Code: 0)\n");
    printf("=================================================================================\n");
    return 0.0;
}
