// test/geomind/nses/test_sprint12_dynamic_gamma_and_eof_wrap.car
// NSES Phase 12 Verification Harness: Dynamic Gamma Domain Isolation & Double-Buffer EOF Wrap
// Gates:
//   TS-12.1: Per-Domain Baseline Isolation (Zero Cross-Domain Surge False-Positives)
//   TS-12.2: Intra-Domain Acute Surge Amplification & Grounding
//   TS-12.3: Same-Domain Double-Buffer EOF Wrap-Around & Recurrent Context Reset
//   TS-12.4: Continuous Multi-Cycle Streaming Ingestion & Zero-Stall Pipeline Invariant

include "src/std/math.cl";
include "src/std/dynamic_gamma.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn clock() -> float;
extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("=================================================================================\n");
    printf("  NSES SPRINT 12 VERIFICATION HARNESS (test_sprint12_dynamic_gamma_and_eof_wrap)\n");
    printf("  Verifying Dynamic Gamma Domain Isolation & Double-Buffer EOF Wrap-Around\n");
    printf("=================================================================================\n\n");

    let cfg = dynamic_gamma_create(0.10, 0.02, 0.35, 6.0, 0.10);

    // -------------------------------------------------------------------------
    // GATE TS-12.1: Per-Domain Baseline Isolation
    // -------------------------------------------------------------------------
    printf("[TS-12.1] Verifying Cross-Domain Surge False-Positive Prevention...\n");
    // Domain 7 (Storytelling/Narrative): high baseline loss = 4.54, spikes to 4.85
    let d7_baseline = 4.54;
    let d7_current = 4.85;
    // Domain 8 (Cloze Part 04): low baseline loss = 3.92
    let d8_baseline = 3.92;
    let d8_current = 3.93;

    // Normal evaluations against domain's own baselines
    let g_d7_isolated = dynamic_gamma_compute(cfg, 5.0, 6.0, 0.10, d7_current, d7_baseline);
    let g_d8_isolated = dynamic_gamma_compute(cfg, 5.0, 6.0, 0.10, d8_current, d8_baseline);

    // Previous buggy behavior: Domain 8 receives Domain 7's loss (4.55) against global EMA (4.10)
    let global_ema = 4.10;
    let g_d8_buggy = dynamic_gamma_compute(cfg, 5.0, 6.0, 0.10, d7_current, global_ema);

    printf("  -> Domain 7 Isolated (L=4.85 vs Base=4.54): gamma = %.4f\n", g_d7_isolated);
    printf("  -> Domain 8 Isolated (L=3.93 vs Base=3.92): gamma = %.4f\n", g_d8_isolated);
    printf("  -> Domain 8 Cross-Domain Leak (L=4.85 vs EMA=4.10): gamma = %.4f\n", g_d8_buggy);

    // Verify isolated evaluations have no false surge boost
    cartan_assert(g_d8_isolated == cfg.base_gamma * 0.85, "TS-12.1 Isolated Domain 8 must match unboosted baseline");
    cartan_assert(g_d7_isolated == cfg.base_gamma * 0.85, "TS-12.1 Isolated Domain 7 must match unboosted baseline");
    // Verify that buggy behavior falsely boosted gamma by > 10%
    cartan_assert(g_d8_buggy > g_d8_isolated, "TS-12.1 Buggy leak falsely inflated gamma");
    printf("  -> TS-12.1 PASSED: Domain baseline isolation completely eliminates cross-domain false positives.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-12.2: Intra-Domain Acute Surge Detection
    // -------------------------------------------------------------------------
    printf("[TS-12.2] Verifying Legitimate Intra-Domain Acute Surge Detection...\n");
    // Domain 8 genuinely surges from 3.92 to 4.90 (> 1.15 * 3.92 = 4.508)
    let d8_surge = 4.90;
    let g_d8_surged = dynamic_gamma_compute(cfg, 5.0, 6.0, 0.10, d8_surge, d8_baseline);
    printf("  -> Domain 8 Real Surge (L=4.90 vs Base=3.92): gamma = %.4f (Base: %.4f)\n", g_d8_surged, g_d8_isolated);
    cartan_assert(g_d8_surged > g_d8_isolated * 1.08, "TS-12.2 True intra-domain surge must boost gamma");
    printf("  -> TS-12.2 PASSED: Legitimate intra-domain surges are reliably detected and boosted.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-12.3: Same-Domain Double-Buffer EOF Wrap-Around
    // -------------------------------------------------------------------------
    printf("[TS-12.3] Verifying Same-Domain Double-Buffer EOF Wrap-Around...\n");
    let content_len = 10000.0;
    var standby_has_prev = 1.0;

    // Subtest A: Mid-file chunk boundary (no wrap)
    var active_next_line = 4096.0;
    var st_start = active_next_line;
    if (st_start >= content_len) {
        st_start = 0.0;
        standby_has_prev = 0.0;
    }
    printf("  -> Mid-File Chunk: active_next = %.0f -> st_start = %.0f, has_prev = %.0f\n",
           active_next_line, st_start, standby_has_prev);
    cartan_assert(st_start == 4096.0, "TS-12.3 Mid-file offset must be preserved");
    cartan_assert(standby_has_prev == 1.0, "TS-12.3 Recurrent continuity must be retained mid-file");

    // Subtest B: Exact EOF chunk boundary (wrap required)
    active_next_line = 10000.0;
    st_start = active_next_line;
    if (st_start >= content_len) {
        st_start = 0.0;
        standby_has_prev = 0.0;
    }
    printf("  -> Exact EOF Chunk: active_next = %.0f -> st_start = %.0f, has_prev = %.0f\n",
           active_next_line, st_start, standby_has_prev);
    cartan_assert(st_start == 0.0, "TS-12.3 Exact EOF must wrap st_start strictly to 0.0");
    cartan_assert(standby_has_prev == 0.0, "TS-12.3 Exact EOF must reset recurrent continuity to 0.0");

    // Subtest C: Past EOF boundary (wrap required)
    standby_has_prev = 1.0;
    active_next_line = 10512.0;
    st_start = active_next_line;
    if (st_start >= content_len) {
        st_start = 0.0;
        standby_has_prev = 0.0;
    }
    printf("  -> Past EOF Chunk: active_next = %.0f -> st_start = %.0f, has_prev = %.0f\n",
           active_next_line, st_start, standby_has_prev);
    cartan_assert(st_start == 0.0, "TS-12.3 Past EOF must wrap st_start strictly to 0.0");
    cartan_assert(standby_has_prev == 0.0, "TS-12.3 Past EOF must reset recurrent continuity to 0.0");
    printf("  -> TS-12.3 PASSED: Double-buffering EOF wrap-around and state reset verified.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-12.4: Continuous Multi-Cycle Streaming Ingestion
    // -------------------------------------------------------------------------
    printf("[TS-12.4] Verifying Continuous Streaming Simulation (10 Chunks, 2 Wraps)...\n");
    let file_size = 1200.0;
    let chunk_size = 500.0;
    var cur_offset = 0.0;
    var step = 0.0;
    var wraps_observed = 0.0;

    while (step < 10.0) {
        let chunk_start = cur_offset;
        var next_offset = chunk_start + chunk_size;
        var wrapped = 0.0;
        if (next_offset >= file_size) {
            next_offset = 0.0;
            wrapped = 1.0;
            wraps_observed = wraps_observed + 1.0;
        }
        printf("  -> Step %.0f: Chunk [%.0f - %.0f] | Next: %.0f (Wrapped: %.0f)\n",
               step, chunk_start, chunk_start + chunk_size, next_offset, wrapped);
        cartan_assert(chunk_start >= 0.0 && chunk_start < file_size, "TS-12.4 Chunk start must be within valid file bounds");
        cur_offset = next_offset;
        step = step + 1.0;
    }
    cartan_assert(wraps_observed >= 3.0, "TS-12.4 Multi-cycle stream must cleanly wrap around at least 3 times");
    printf("  -> TS-12.4 PASSED: Multi-cycle streaming executes with zero stalls or boundary overruns.\n\n");

    printf("=================================================================================\n");
    printf("  ALL 4 VERIFICATION GATES PASSED (100%% EMPIRICAL INTEGRITY)\n");
    printf("=================================================================================\n");
    cartan_flush(0.0);
    return 0.0;
}
