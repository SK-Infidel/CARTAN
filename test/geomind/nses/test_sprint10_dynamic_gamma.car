// test/geomind/nses/test_sprint10_dynamic_gamma.car
// NSES Phase 10 Verification Harness: Dynamic Gamma Scaling & Adaptive Hopfield Coupling
// Gates:
//   TS-10.1: Domain Base Scaling (Conservation Invariants vs Empirical Biology)
//   TS-10.2: Uncertainty & Surprisal Modulation (High Uncertainty Surge vs High Confidence Decay)
//   TS-10.3: Loss Surge Amplification & Safety Clamping [gamma_min, gamma_max]
//   TS-10.4: Sub-Microsecond Evaluation Latency Benchmark

include "src/std/math.cl";
include "src/std/dynamic_gamma.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn clock() -> float;
extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("=================================================================================\n");
    printf("  NSES SPRINT 10 VERIFICATION HARNESS (test_sprint10_dynamic_gamma)\n");
    printf("  Testing Adaptive Hopfield Coupling, Uncertainty Modulation & Loss Surge Control\n");
    printf("=================================================================================\n\n");

    let cfg = dynamic_gamma_create(0.10, 0.02, 0.35, 6.0, 0.10);
    cartan_assert(cfg.base_gamma == 0.10, "TS-10.0 Base gamma init");
    cartan_assert(cfg.min_gamma == 0.02, "TS-10.0 Min gamma init");
    cartan_assert(cfg.max_gamma == 0.35, "TS-10.0 Max gamma init");

    // -------------------------------------------------------------------------
    // GATE TS-10.1: Domain Base Scaling
    // -------------------------------------------------------------------------
    printf("[TS-10.1] Verifying Domain Base Scaling Hierarchy...\n");
    let g_d0 = dynamic_gamma_compute(cfg, 0.0, 6.0, 0.10, 4.0, 4.0); // SYSTEM_CORE
    let g_d1 = dynamic_gamma_compute(cfg, 1.0, 6.0, 0.10, 4.0, 4.0); // PHYSICS_SIM
    let g_d2 = dynamic_gamma_compute(cfg, 2.0, 6.0, 0.10, 4.0, 4.0); // TOPOLOGY_GEOMETRY
    let g_d3 = dynamic_gamma_compute(cfg, 3.0, 6.0, 0.10, 4.0, 4.0); // COMPLEXITY_THEORY
    let g_d4 = dynamic_gamma_compute(cfg, 4.0, 6.0, 0.10, 4.0, 4.0); // BIOLOGICAL_SYSTEMS
    let g_d5 = dynamic_gamma_compute(cfg, 5.0, 6.0, 0.10, 4.0, 4.0); // CAUSAL_TAXONOMY

    printf("  -> Domain 0 (System Core Invariants): gamma = %.4f\n", g_d0);
    printf("  -> Domain 1 (Physics Sim):            gamma = %.4f\n", g_d1);
    printf("  -> Domain 2 (Topology & Forms):       gamma = %.4f\n", g_d2);
    printf("  -> Domain 3 (Complexity Theory):      gamma = %.4f\n", g_d3);
    printf("  -> Domain 4 (Biological Systems):     gamma = %.4f\n", g_d4);
    printf("  -> Domain 5 (Causal Taxonomy):        gamma = %.4f\n", g_d5);

    cartan_assert(g_d0 > g_d1, "TS-10.1 Domain 0 invariant coupling must exceed Domain 1");
    cartan_assert(g_d1 >= g_d2, "TS-10.1 Domain 1 coupling must be >= Domain 2");
    cartan_assert(g_d2 > g_d3, "TS-10.1 Domain 2 coupling must exceed Domain 3");
    cartan_assert(g_d3 > g_d4, "TS-10.1 Domain 3 coupling must exceed Domain 4");
    cartan_assert(g_d4 == g_d5, "TS-10.1 Domain 4 and 5 baseline parity");
    printf("  -> TS-10.1 PASSED: Domain baseline priority hierarchy verified.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-10.2: Uncertainty Modulation
    // -------------------------------------------------------------------------
    printf("[TS-10.2] Verifying Uncertainty & Surprisal Modulation...\n");
    // High uncertainty scenario: Entropy = 8.5 bits (elevated), Certainty = 2% (low)
    let g_high_unc = dynamic_gamma_compute(cfg, 1.0, 8.5, 0.02, 4.0, 4.0);
    printf("  -> High Uncertainty (H=8.5b, C=2%%): gamma = %.4f (Base: %.4f)\n", g_high_unc, g_d1);
    cartan_assert(g_high_unc > g_d1 * 1.30, "TS-10.2 High uncertainty must significantly amplify gamma");

    // High confidence scenario: Entropy = 3.5 bits (low), Certainty = 30% (high)
    let g_high_conf = dynamic_gamma_compute(cfg, 1.0, 3.5, 0.30, 4.0, 4.0);
    printf("  -> High Confidence  (H=3.5b, C=30%%): gamma = %.4f (Base: %.4f)\n", g_high_conf, g_d1);
    cartan_assert(g_high_conf < g_d1 * 0.70, "TS-10.2 High confidence must attenuate gamma perturbation");
    cartan_assert(g_high_conf >= cfg.min_gamma, "TS-10.2 Gamma must respect min_gamma clamp");
    printf("  -> TS-10.2 PASSED: Uncertainty modulation verified.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-10.3: Loss Surge Amplification & Safety Clamping
    // -------------------------------------------------------------------------
    printf("[TS-10.3] Verifying Loss Surge Amplification & Safety Bounds...\n");
    // Normal steady-state loss
    let g_normal = dynamic_gamma_compute(cfg, 0.0, 6.0, 0.10, 4.0, 4.0);
    // Severe loss spike (cur_loss = 7.5 vs EMA = 4.0)
    let g_spike = dynamic_gamma_compute(cfg, 0.0, 6.0, 0.10, 7.5, 4.0);
    printf("  -> Normal Loss (L=4.0, EMA=4.0): gamma = %.4f\n", g_normal);
    printf("  -> Loss Spike  (L=7.5, EMA=4.0): gamma = %.4f\n", g_spike);
    cartan_assert(g_spike > g_normal * 1.40, "TS-10.3 Loss spike must trigger surge boost");

    // Extreme catastrophic divergence simulation (check safety clamp ceiling)
    let g_extreme = dynamic_gamma_compute(cfg, 0.0, 12.0, 0.001, 20.0, 2.0);
    printf("  -> Catastrophic Spike (L=20, H=12b): gamma = %.4f (Clamp Max: %.4f)\n", g_extreme, cfg.max_gamma);
    cartan_assert(g_extreme == cfg.max_gamma, "TS-10.3 Gamma must clamp strictly to max_gamma");

    // Extreme convergence simulation (check safety clamp floor)
    let cfg_floor = dynamic_gamma_create(0.02, 0.02, 0.35, 6.0, 0.10);
    let g_min = dynamic_gamma_compute(cfg_floor, 5.0, 0.5, 0.99, 0.5, 4.0);
    printf("  -> Super-Converged (L=0.5, H=0.5b): gamma = %.4f (Clamp Min: %.4f)\n", g_min, cfg_floor.min_gamma);
    cartan_assert(g_min == cfg_floor.min_gamma, "TS-10.3 Gamma must clamp strictly to min_gamma");
    printf("  -> TS-10.3 PASSED: Surge boost and safety boundaries verified.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-10.4: Sub-Microsecond Evaluation Latency Benchmark
    // -------------------------------------------------------------------------
    printf("[TS-10.4] Benchmarking Dynamic Gamma Compute Latency...\n");
    let t0 = clock();
    var rep = 0.0;
    var g_accum = 0.0;
    while (rep < 10000.0) {
        let g = dynamic_gamma_compute(cfg, 1.0, 6.5, 0.08, 4.2, 4.0);
        g_accum = g_accum + g;
        rep = rep + 1.0;
    }
    let t1 = clock();
    let avg_us = ((t1 - t0) / 10000.0) * 1000.0;
    printf("  -> 10,000 Evaluations: Accum = %.2f | Average Latency: %.4f microseconds\n", g_accum, avg_us);
    cartan_assert(avg_us < 1.0, "TS-10.4 Dynamic gamma calculation must be sub-microsecond");
    printf("  -> TS-10.4 PASSED: Sub-microsecond computation confirmed.\n\n");

    printf("=================================================================================\n");
    printf("  SPRINT 423 VERIFICATION SUCCESSFUL: 4/4 GATES PASSED (100%% EMPIRICAL PROOF)\n");
    printf("=================================================================================\n");
    cartan_flush(0.0);
    return 0.0;
}
