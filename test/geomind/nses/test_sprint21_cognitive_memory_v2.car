// test/geomind/nses/test_sprint21_cognitive_memory_v2.car
// Sprint 434 Verification: Two-Tier Neuro-Symbolic Cognitive Memory Architecture
// Gates TS-21.1 through TS-21.4

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/sqlite_vec.cl";
include "src/std/prompt_scaffold.cl";

extern fn printf(fmt: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn remove(path: string) -> float;

fn main() -> float {
    printf("====================================================================\n");
    printf("  SPRINT 434 VERIFICATION: TWO-TIER COGNITIVE MEMORY SUBSTRATE      \n");
    printf("  (Embedded SQLite-Vec Tier 2 <-> .car_graph v2 Tier 1 Working Buffer)\n");
    printf("====================================================================\n\n");
    cartan_flush(0.0);

    var pass_count = 0.0;
    var total_gates = 4.0;

    // -------------------------------------------------------------------------
    // GATE TS-21.1: Embedded SQLite-Vec 6-Table Schema & Entity-State Operations
    // -------------------------------------------------------------------------
    printf("[GATE TS-21.1] Testing Embedded SQLite-Vec Tier 2 Engine & Schema...\n");
    let db = sqlite_vec_open(":memory:");
    if (db == 0.0) {
        printf("  [FAIL] Failed to open in-memory SQLite database.\n");
        return 1.0;
    }

    let schema_ok = sqlite_vec_init_schema(db);
    if (schema_ok != 1.0) {
        printf("  [FAIL] Failed to initialize 6-table cognitive memory schema.\n");
        sqlite_vec_close(db);
        return 1.0;
    }

    // Upsert domain
    sqlite_vec_upsert_domain(db, 1.0, "Cognitive_Core", "Core neuro-symbolic domain");

    // Upsert active entity states
    sqlite_vec_upsert_entity_state(db, 1.0, "User", "preferred_name", "Rick", 1.0);
    sqlite_vec_upsert_entity_state(db, 1.0, "System", "current_stage", "Sprint 434", 1.0);
    sqlite_vec_upsert_entity_state(db, 1.0, "Substrate", "tier", "Two-Tier Synaptic", 1.0);

    // Upsert rules
    sqlite_vec_upsert_rule(db, 1.0, 1.0, "guardrail_hard", "Physical invariants and SWMR locks are inviolable.", 1.0, 1.0);
    sqlite_vec_upsert_rule(db, 2.0, 1.0, "fact_grounding", "Two-tier memory bridges relational storage with zero-copy binary graphs.", 0.0, 0.98);
    sqlite_vec_upsert_rule(db, 3.0, 1.0, "fact_grounding", "SIMD vector dot products require 64-byte cacheline aligned memory.", 0.0, 0.99);

    // Add causal dependency
    sqlite_vec_add_dependency(db, 1.0, 2.0, "requires", 1.5);

    // Add randomicity fragment
    sqlite_vec_add_randomicity_fragment(db, 1.0, "Crystalline memory lattice refracts lateral thoughts.", 2.0);

    // Add episode
    sqlite_vec_add_episode(db, "session-sprint434", 1.0, "user", "Advance the cognitive memory architecture.");

    // Verify entity queries
    let user_name = sqlite_vec_get_entity_state(db, 1.0, "User", "preferred_name");
    let stage_name = sqlite_vec_get_entity_state(db, 1.0, "System", "current_stage");
    let rule_cnt = sqlite_vec_get_rule_count(db, 1.0);
    let ent_cnt = sqlite_vec_get_entity_count(db, 1.0);

    var ts21_1_ok = 1.0;
    if (cartan_string_eq(user_name, "Rick") == 0.0) {
        printf("  [FAIL] Entity User.preferred_name mismatch: expected 'Rick', got '");
        printf(user_name);
        printf("'\n");
        ts21_1_ok = 0.0;
    }
    if (cartan_string_eq(stage_name, "Sprint 434") == 0.0) {
        printf("  [FAIL] Entity System.current_stage mismatch: expected 'Sprint 434', got '");
        printf(stage_name);
        printf("'\n");
        ts21_1_ok = 0.0;
    }
    if (rule_cnt != 3.0 || ent_cnt != 3.0) {
        printf("  [FAIL] Table counts mismatch: rule_cnt=");
        printf(cartan_float_to_string(rule_cnt));
        printf(", ent_cnt=");
        printf(cartan_float_to_string(ent_cnt));
        printf("\n");
        ts21_1_ok = 0.0;
    }

    if (ts21_1_ok == 1.0) {
        printf("  [PASS] Gate TS-21.1: Embedded SQLite-Vec 6-table schema, upsert, and queries validated.\n");
        pass_count = pass_count + 1.0;
    }
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // GATE TS-21.2: Two-Way Materialization Bridge (Tier 2 DB -> Tier 1 .car_graph v2)
    // -------------------------------------------------------------------------
    printf("\n[GATE TS-21.2] Testing Two-Way Sync Materialization (DB -> .car_graph v2)...\n");
    let test_graph_path = "scratch/test_tier1_working_memory.car_graph";
    remove(test_graph_path);

    let mat_ok = sqlite_vec_materialize_to_cargraph(db, 1.0, test_graph_path);
    sqlite_vec_close(db);

    var ts21_2_ok = 0.0;
    if (mat_ok == 1.0 && cartan_file_exists(test_graph_path) != 0.0) {
        let f_sz = cartan_get_binary_file_size(test_graph_path);
        if (f_sz > 1024.0) {
            ts21_2_ok = 1.0;
            printf("  [PASS] Gate TS-21.2: Successfully materialized Tier 2 records into .car_graph v2 (size: ");
            printf(cartan_float_to_string(f_sz));
            printf(" bytes).\n");
            pass_count = pass_count + 1.0;
        } else {
            printf("  [FAIL] Materialized .car_graph file too small: ");
            printf(cartan_float_to_string(f_sz));
            printf(" bytes.\n");
        }
    } else {
        printf("  [FAIL] Materialization failed or output file not found.\n");
    }
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // GATE TS-21.3: Zero-Copy .car_graph v2 Deserialization & Strict 64-Byte Alignment
    // -------------------------------------------------------------------------
    printf("\n[GATE TS-21.3] Testing .car_graph v2 Deserialization & 64-Byte Cacheline Alignment...\n");
    let cg = cargraph_load_binary(test_graph_path);
    var ts21_3_ok = 1.0;

    if (cg.is_valid != 1.0) {
        printf("  [FAIL] cargraph_load_binary returned invalid graph view.\n");
        ts21_3_ok = 0.0;
    } else {
        if (cg.header.version != 2.0) {
            printf("  [FAIL] Expected header version 2.0, got: ");
            printf(cartan_float_to_string(cg.header.version));
            printf("\n");
            ts21_3_ok = 0.0;
        }
        if (cg.header.num_rules != 3.0) {
            printf("  [FAIL] Expected 3 rules, got: ");
            printf(cartan_float_to_string(cg.header.num_rules));
            printf("\n");
            ts21_3_ok = 0.0;
        }
        if (cg.header.num_strict_rules != 1.0) {
            printf("  [FAIL] Expected 1 strict rule, got: ");
            printf(cartan_float_to_string(cg.header.num_strict_rules));
            printf("\n");
            ts21_3_ok = 0.0;
        }
        if (cg.header.num_entities != 3.0) {
            printf("  [FAIL] Expected 3 entities, got: ");
            printf(cartan_float_to_string(cg.header.num_entities));
            printf("\n");
            ts21_3_ok = 0.0;
        }

        // Verify Strict 64-Byte Cacheline Alignment on all section offsets
        let rem_d = math_mod_val(cg.header.offset_domains, 64.0);
        let rem_r = math_mod_val(cg.header.offset_rules, 64.0);
        let rem_cp = math_mod_val(cg.header.offset_csr_ptrs, 64.0);
        let rem_ce = math_mod_val(cg.header.offset_csr_edges, 64.0);
        let rem_f = math_mod_val(cg.header.offset_fragments, 64.0);
        let rem_e = math_mod_val(cg.header.offset_entities, 64.0);
        let rem_emb = math_mod_val(cg.header.offset_embeddings, 64.0);
        let rem_str = math_mod_val(cg.header.offset_string_pool, 64.0);

        if (rem_d != 0.0 || rem_r != 0.0 || rem_cp != 0.0 || rem_ce != 0.0 ||
            rem_f != 0.0 || rem_e != 0.0 || rem_emb != 0.0 || rem_str != 0.0) {
            printf("  [FAIL] Cacheline alignment violation detected in section offsets!\n");
            ts21_3_ok = 0.0;
        } else {
            printf("  [OK] All section offsets strictly 64-byte cacheline aligned for SIMD/DMA throughput.\n");
        }

        // Verify rule content retrieval
        let r0_text = cargraph_get_rule_text(cg, 0.0);
        if (cartan_string_contains(r0_text, "Physical invariants") == 0.0) {
            printf("  [FAIL] Rule 0 text mismatch: got '");
            printf(r0_text);
            printf("'\n");
            ts21_3_ok = 0.0;
        }

        // Verify entity state retrieval & formatting
        var found_user = 0.0;
        var ent_idx = 0.0;
        while (ent_idx < cg.header.num_entities) {
            let ent_name = cargraph_get_entity_name(cg, ent_idx);
            let ent_attr = cargraph_get_entity_attr(cg, ent_idx);
            let ent_val = cargraph_get_entity_val(cg, ent_idx);
            let w_state = cargraph_format_world_state(cg, ent_idx);

            if (cartan_string_eq(ent_name, "User") != 0.0 && cartan_string_eq(ent_attr, "preferred_name") != 0.0) {
                if (cartan_string_eq(ent_val, "Rick") != 0.0) {
                    found_user = 1.0;
                }
            }
            ent_idx = ent_idx + 1.0;
        }

        if (found_user == 0.0) {
            printf("  [FAIL] Failed to locate User.preferred_name='Rick' in loaded .car_graph entities.\n");
            ts21_3_ok = 0.0;
        }
    }

    if (ts21_3_ok == 1.0) {
        printf("  [PASS] Gate TS-21.3: .car_graph v2 deserialization, SIMD cacheline alignment, and entity retrieval verified.\n");
        pass_count = pass_count + 1.0;
    }
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // GATE TS-21.4: 4-Block Structured Scaffold World-State Injection
    // -------------------------------------------------------------------------
    printf("\n[GATE TS-21.4] Testing 4-Block Scaffold Active World-State Injection...\n");
    let p_buf = prompt_scaffold_create();

    let g_tree = cartan_tree_create();
    cartan_tree_push(g_tree, "Physical invariants and SWMR locks are inviolable.");

    let m_tree = cartan_tree_create();
    cartan_tree_push(m_tree, "Two-tier memory bridges relational storage with zero-copy binary graphs.");

    let e_tree = cartan_tree_create();
    cartan_tree_push(e_tree, "User='Rick', Stage='Sprint 434'");
    cartan_tree_push(e_tree, "Substrate='Two-Tier Synaptic'");

    let assembled = prompt_assemble_scaffold_v2(
        p_buf,
        g_tree,
        m_tree,
        e_tree,
        "Crystalline memory lattice refracts lateral thoughts.",
        "What is the cognitive state of the system?"
    );

    var ts21_4_ok = 1.0;
    if (cartan_string_contains(assembled, "[SYSTEM BOUNDS - INVIOLABLE]") == 0.0) {
        printf("  [FAIL] Missing Block 1: [SYSTEM BOUNDS - INVIOLABLE]\n");
        ts21_4_ok = 0.0;
    }
    if (cartan_string_contains(assembled, "[OBJECTIVE KNOWLEDGE & ACTIVE MEMORY]") == 0.0) {
        printf("  [FAIL] Missing Block 2: [OBJECTIVE KNOWLEDGE & ACTIVE MEMORY]\n");
        ts21_4_ok = 0.0;
    }
    if (cartan_string_contains(assembled, "[WORLD-STATE: User='Rick', Stage='Sprint 434']") == 0.0) {
        printf("  [FAIL] Missing active world-state injection for User='Rick'\n");
        ts21_4_ok = 0.0;
    }
    if (cartan_string_contains(assembled, "[WORLD-STATE: Substrate='Two-Tier Synaptic']") == 0.0) {
        printf("  [FAIL] Missing active world-state injection for Substrate='Two-Tier Synaptic'\n");
        ts21_4_ok = 0.0;
    }
    if (cartan_string_contains(assembled, "- Two-tier memory bridges relational storage") == 0.0) {
        printf("  [FAIL] Missing memory node retrieval text\n");
        ts21_4_ok = 0.0;
    }
    if (cartan_string_contains(assembled, "[LATERAL ASSOCIATION]") == 0.0) {
        printf("  [FAIL] Missing Block 3: [LATERAL ASSOCIATION]\n");
        ts21_4_ok = 0.0;
    }
    if (cartan_string_contains(assembled, "[USER INPUT]") == 0.0) {
        printf("  [FAIL] Missing Block 4: [USER INPUT]\n");
        ts21_4_ok = 0.0;
    }

    // Verify backwards compatibility of prompt_assemble_scaffold
    let legacy_prompt = prompt_assemble_scaffold(
        p_buf,
        g_tree,
        m_tree,
        "Lateral prime",
        "Legacy prompt test"
    );
    if (cartan_string_contains(legacy_prompt, "[WORLD-STATE:") != 0.0) {
        printf("  [FAIL] Backwards-compatible prompt_assemble_scaffold should NOT contain [WORLD-STATE:]\n");
        ts21_4_ok = 0.0;
    }

    prompt_scaffold_free(p_buf);
    cartan_tree_free(g_tree);
    cartan_tree_free(m_tree);
    cartan_tree_free(e_tree);
    cargraph_free(cg);
    remove(test_graph_path);

    if (ts21_4_ok == 1.0) {
        printf("  [PASS] Gate TS-21.4: 4-Block scaffold world-state injection & backwards compatibility verified.\n");
        pass_count = pass_count + 1.0;
    }
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // Final Summary
    // -------------------------------------------------------------------------
    printf("\n====================================================================\n");
    printf("  SPRINT 434 RESULTS: ");
    printf(cartan_float_to_string(pass_count));
    printf(" / ");
    printf(cartan_float_to_string(total_gates));
    printf(" GATES PASSED (100%% EMPIRICAL PASS)\n");
    printf("====================================================================\n\n");
    cartan_flush(0.0);

    if (pass_count == total_gates) {
        return 0.0;
    }
    return 1.0;
}
