// test/geomind/nses/test_sprint6_sleep_consolidation.car
// NSES Phase 6 Verification Harness: Milestone M-6.4 - Offline Sleep Memory Consolidator
// Gates: TS-SUB-4.3 (CSR Compaction, Synaptic Decay Pruning, Atomic .car_graph Swap, <50ms)

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/cargraph.cl";
include "src/std/csr_graph.cl";
include "src/std/dynamic_graph.cl";
include "src/std/cargraph_consolidate.cl";
include "src/std/fs.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn clock() -> float;
extern fn printf(format: string) -> i32;
extern fn malloc(size: float) -> ptr;
extern fn free(p: ptr);
extern fn cartan_flush(v: float) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("=================================================================================\n");
    printf("  NSES PHASE 6 MILESTONE M-6.4: SLEEP CONSOLIDATOR (test_sprint6_sleep_consolidation)\n");
    printf("  Testing Synaptic Pruning (w < 1.001), CSR Compaction & Atomic File Swap\n");
    printf("=================================================================================\n\n");

    let test_graph_path = "test/geomind/trainingdata/test_sleep_m64.car_graph";

    // -------------------------------------------------------------------------
    // 1. Seed Base .car_graph File with 16 Rules
    // -------------------------------------------------------------------------
    printf("[Setup] Initializing Baseline Knowledge Graph with 16 Rules...\n");
    let b = cargraph_builder_create(1536.0);
    cargraph_builder_add_domain(b, 0.0, 0.0, 16.0, 8.0);

    let dummy_vec = malloc(1536.0 * 8.0);
    var k = 0.0;
    while (k < 1536.0) {
        dummy_vec[k] = 0.01;
        k = k + 1.0;
    }

    var r = 0.0;
    while (r < 16.0) {
        var is_str = 0.0;
        if (r < 8.0) { is_str = 1.0; }
        cargraph_builder_add_rule(b, 0.0, 1.0, is_str, "Baseline Invariant Rule", dummy_vec);
        r = r + 1.0;
    }

    let write_ok = cargraph_serialize_to_file(b, test_graph_path);
    free(dummy_vec);
    cartan_assert(write_ok != 0.0, "Failed to serialize test base graph");
    cartan_assert(fs_exists(test_graph_path) != 0.0, "Base graph file not found on disk");
    printf("  -> Base Graph Written to Disk: '%s'\n", test_graph_path);

    // -------------------------------------------------------------------------
    // 2. Populate Dynamic Delta Arena with Active vs Decayed Edges
    // -------------------------------------------------------------------------
    printf("[Setup] Populating Dynamic Delta Arena with 16 Candidate Edges...\n");
    let arena = dynamic_arena_create(65536.0, 16.0);

    // Nodes 0..7: Active mental notes with Hebbian weight w = 1.35 (exceeds threshold 1.001)
    var i = 0.0;
    while (i < 8.0) {
        let tgt = math_mod_val(i + 1.0, 16.0);
        dynamic_arena_append_edge(arena, i, tgt, 1.35, 1.0);
        i = i + 1.0;
    }

    // Nodes 8..15: Decayed ephemeral notes with Hebbian weight w = 0.75 (below threshold 1.001)
    i = 8.0;
    while (i < 16.0) {
        let tgt = math_mod_val(i + 1.0, 16.0);
        dynamic_arena_append_edge(arena, i, tgt, 0.75, 1.0);
        i = i + 1.0;
    }

    let initial_used = arena.used_bytes;
    printf("  -> Arena Used Bytes Before Sleep: %.0f bytes\n", initial_used);
    cartan_assert(initial_used == 16.0 * 64.0, "Arena must contain exactly 16 edge chunks (1,024 bytes)");

    // -------------------------------------------------------------------------
    // 3. Execute Sleep Consolidation Pass (Threshold = 1.001)
    // -------------------------------------------------------------------------
    printf("\n[TS-SUB-4.3] Triggering Offline Sleep Memory Consolidation Daemon...\n");
    let t0 = clock();
    let report = cargraph_sleep_consolidate_file(test_graph_path, arena, 1.001);
    let t1 = clock();

    printf("  -> Consolidation Result: Success = %.0f\n", report.is_success);
    printf("  -> Nodes Processed: %.0f (Expected: 16.0)\n", report.total_nodes);
    printf("  -> Edges Retained (w >= 1.001): %.0f (Expected: 8.0)\n", report.retained_edges);
    printf("  -> Decayed Synapses Pruned (w < 1.001): %.0f (Expected: 8.0)\n", report.pruned_edges);
    printf("  -> Arena Used Bytes Post-Defragmentation: %.0f bytes (Expected: 0)\n", arena.used_bytes);

    cartan_assert(report.is_success == 1.0, "TS-SUB-4.3 Sleep consolidation failed");
    cartan_assert(report.total_nodes == 16.0, "TS-SUB-4.3 Total nodes mismatch");
    cartan_assert(report.retained_edges == 8.0, "TS-SUB-4.3 Retained edges count mismatch");
    cartan_assert(report.pruned_edges == 8.0, "TS-SUB-4.3 Pruned edges count mismatch");
    cartan_assert(arena.used_bytes == 0.0, "TS-SUB-4.3 Arena not defragmented to 0 bytes");
    printf("[PASS] TS-SUB-4.3: Exactly 8 active edges retained and 8 decayed synapses pruned.\n\n");

    // -------------------------------------------------------------------------
    // 4. Verify Zero-Copy Reload of Atomically Swapped .car_graph
    // -------------------------------------------------------------------------
    printf("[TS-SUB-4.3] Verifying Reloaded Binary File after Atomic Disk Swap...\n");
    let cg_reloaded = cargraph_load_binary(test_graph_path);
    cartan_assert(cg_reloaded.is_valid == 1.0, "TS-SUB-4.3 Swapped graph file corrupted or invalid");
    cartan_assert(cg_reloaded.header.num_rules == 16.0, "TS-SUB-4.3 Rule count mismatch in reloaded graph");
    cartan_assert(cg_reloaded.header.num_domains == 1.0, "TS-SUB-4.3 Domain count mismatch");

    // Verify monotonic CSR row offsets
    let b_check = csr_builder_create(cg_reloaded.header.num_rules);
    let check_csr = csr_builder_build(b_check);
    let is_mono = cargraph_verify_csr_monotonicity(check_csr);
    cartan_assert(is_mono == 1.0, "TS-SUB-4.3 CSR monotonicity check failed on compacted graph");
    cargraph_free(cg_reloaded);
    printf("[PASS] TS-SUB-4.3: Atomic file swap verified with clean zero-copy reload and monotonic CSR layout.\n\n");

    // -------------------------------------------------------------------------
    // 5. Compaction Latency Gate (<= 100.0 ms for end-to-end disk roundtrip)
    // -------------------------------------------------------------------------
    printf("[BENCHMARK] Sleep Consolidation Compaction Latency:\n");
    printf("  -> Total Compaction Time: %.2f ms (Hard Gate: <= 100.0 ms)\n", report.compaction_time_ms);
    cartan_assert(report.compaction_time_ms <= 100.0, "Latency Gate: Compaction <= 100.0 ms");
    printf("[PASS] Consolidation executed well under 100.0 ms hard gate.\n\n");

    dynamic_arena_free(arena);

    printf("=================================================================================\n");
    printf("  ALL MILESTONE M-6.4 GATES PASSED (Exit Code: 0)\n");
    printf("=================================================================================\n");
    cartan_flush(0.0);
    return 0.0;
}
