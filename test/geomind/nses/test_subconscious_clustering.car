// test/geomind/nses/test_subconscious_clustering.car
// NSES Phase 6 Verification Harness: Suite 3 - Autonomous Domain Genesis & Clustering (TS-SUB-3)
// Gates: TS-SUB-3.1, TS-SUB-3.2, TS-SUB-3.3 & Centroid Scan Latency Benchmarks (<1.5ms)

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/cartanc/cargraph_simd.car";
include "src/std/domain_genesis.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn clock() -> float;
extern fn printf(format: string) -> i32;
extern fn malloc(size: float) -> ptr;
extern fn free(p: ptr);
extern fn cartan_flush(v: float) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("================================================================================\n");
    printf("  NSES PHASE 6 SUITE 3: DOMAIN GENESIS & CLUSTERING (test_subconscious_clustering)\n");
    printf("  Testing Orthogonal Genesis (novelty > 0.35), Intra-Attachment & Centroid Stability\n");
    printf("================================================================================\n\n");

    let tracker = domain_genesis_create(32.0, 1536.0, 0.35);
    cartan_assert(tracker.num_domains == 0.0, "Initial domain count check");

    // -------------------------------------------------------------------------
    // GATE TS-SUB-3.1: Orthogonal Domain Genesis (8 Disjoint Corpora)
    // -------------------------------------------------------------------------
    printf("[TS-SUB-3.1] Ingesting 8 Conceptually Orthogonal Disjoint Corpora...\n");
    let v_proto = malloc(1536.0 * 8.0);

    var d_idx = 0.0;
    while (d_idx < 8.0) {
        // Generate distinct orthogonal vector using disjoint 192-dim block partitions
        let start_dim = d_idx * 192.0;
        let end_dim = start_dim + 192.0;
        var k = 0.0;
        while (k < 1536.0) {
            if (k >= start_dim && k < end_dim) {
                v_proto[k] = sin(k * 0.05 + 1.0) + 1.5;
            } else {
                v_proto[k] = 0.0;
            }
            k = k + 1.0;
        }
        cargraph_simd_normalize_1536(v_proto);

        var name = "Domain Partition";
        if (d_idx == 0.0) { name = "Quantum Hall Effect"; }
        else if (d_idx == 1.0) { name = "RISC-V Microarchitecture"; }
        else if (d_idx == 2.0) { name = "Admiralty Maritime Law"; }
        else if (d_idx == 3.0) { name = "Mycology & Fungal Networks"; }
        else if (d_idx == 4.0) { name = "Conformal Field Topology"; }
        else if (d_idx == 5.0) { name = "Compressible Fluid Dynamics"; }
        else if (d_idx == 6.0) { name = "Epigenetic Methylation"; }
        else { name = "Algebraic Number Theory"; }

        let allocated_id = domain_genesis_ingest_note(tracker, v_proto, name);
        printf("  -> Corpus %.0f ('%s') Ingested -> Domain Partition Minted: %.0f\n", d_idx + 1.0, name, allocated_id);
        cartan_assert(allocated_id == d_idx, "TS-SUB-3.1 Novelty threshold failed to mint new domain partition");
        d_idx = d_idx + 1.0;
    }

    printf("  -> Total Domains Minted: %.0f (Expected: 8.0)\n", tracker.num_domains);
    cartan_assert(tracker.num_domains == 8.0, "TS-SUB-3.1 Expected exactly 8 domains minted");
    printf("[PASS] TS-SUB-3.1: Exactly 8 new domains minted with unit-normalized centroids.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-SUB-3.2: Intra-Domain Attachment (500 Granular Facts)
    // -------------------------------------------------------------------------
    printf("[TS-SUB-3.2] Streaming 500 Granular Facts Matching Established Domains...\n");
    var fact_i = 0.0;
    var attached_count = 0.0;
    let initial_domains = tracker.num_domains;

    while (fact_i < 500.0) {
        // Pick an established domain
        let target_dom = math_mod_val(fact_i, 8.0);
        let c_vec = domain_genesis_get_centroid(tracker, target_dom);
        
        // Perturb the cluster centroid slightly (high similarity cos >= 0.95, novelty <= 0.05)
        var k = 0.0;
        while (k < 1536.0) {
            v_proto[k] = c_vec[k] + (sin(fact_i + k) * 0.005);
            k = k + 1.0;
        }
        cargraph_simd_normalize_1536(v_proto);

        let attached_id = domain_genesis_ingest_note(tracker, v_proto, "Granular Intra-Domain Fact");
        if (attached_id == target_dom) {
            attached_count = attached_count + 1.0;
        }

        fact_i = fact_i + 1.0;
    }

    printf("  -> Facts Ingested: %.0f | Attached to Existing Domains: %.0f (%.2f%%)\n",
           fact_i, attached_count, (attached_count / 500.0) * 100.0);
    printf("  -> Post-Stream Domain Count: %.0f (Invariant check: %.0f == 8.0)\n",
           tracker.num_domains, initial_domains);

    cartan_assert(attached_count == 500.0, "TS-SUB-3.2 Granular facts erroneously triggered domain genesis");
    cartan_assert(tracker.num_domains == 8.0, "TS-SUB-3.2 Domain count must remain invariant at 8");
    printf("[PASS] TS-SUB-3.2: 100.00%% of granular facts attached to existing domains; domain count invariant.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-SUB-3.3: Centroid Stability & Velocity Decay (2,000 Notes)
    // -------------------------------------------------------------------------
    printf("[TS-SUB-3.3] Ingesting 2,000 Domain-Specific Notes to Verify Asymptotic Centroid Decay...\n");
    let target_dom = 0.0; // Quantum Hall Effect
    let c_0 = domain_genesis_get_centroid(tracker, target_dom);
    let prev_c = malloc(1536.0 * 8.0);

    var note_i = 0.0;
    var v_early = 0.0;
    var v_late = 0.0;

    while (note_i < 2000.0) {
        // Copy current centroid to prev_c
        var k = 0.0;
        while (k < 1536.0) {
            prev_c[k] = c_0[k];
            k = k + 1.0;
        }

        // Perturb candidate within target domain manifold
        k = 0.0;
        while (k < 1536.0) {
            v_proto[k] = c_0[k] + (cos(note_i * 0.1 + k) * 0.01);
            k = k + 1.0;
        }
        cargraph_simd_normalize_1536(v_proto);

        domain_genesis_ingest_note(tracker, v_proto, "Quantum Fact");

        // Compute step velocity: || c_t - c_{t-1} ||
        let sim_step = cargraph_simd_cosine_sim_1536(c_0, prev_c);
        let velocity = 1.0 - sim_step;

        if (note_i == 10.0) { v_early = velocity; }
        if (note_i == 1999.0) { v_late = velocity; }

        note_i = note_i + 1.0;
    }

    printf("  -> Early Centroid Velocity (Step 10): %.8f\n", v_early);
    printf("  -> Late Centroid Velocity (Step 2000): %.8f\n", v_late);
    printf("  -> Velocity Decay Ratio: %.2fx Reduction\n", v_early / (v_late + 0.00000001));

    cartan_assert(v_late < v_early * 0.01, "TS-SUB-3.3 Centroid drift did not decay asymptotically");
    printf("[PASS] TS-SUB-3.3: Centroid velocity decayed asymptotically toward zero; zero catastrophic drift.\n\n");

    // -------------------------------------------------------------------------
    // LATENCY BENCHMARK: Centroid Scan (<1.50 ms Hard Gate)
    // -------------------------------------------------------------------------
    let bench_scans = 1000.0;
    let t0 = clock();
    var s_i = 0.0;
    while (s_i < bench_scans) {
        domain_genesis_max_similarity(tracker, v_proto);
        s_i = s_i + 1.0;
    }
    let t1 = clock();
    let total_scan_ms = t1 - t0;
    let ms_per_scan = total_scan_ms / bench_scans;

    printf("[BENCHMARK] Domain Genesis Centroid Scan Execution:\n");
    printf("  -> 1,000 Scans Time: %.2f ms\n", total_scan_ms);
    printf("  -> Average Latency: %.4f ms (Hard Gate: <= 1.50 ms)\n", ms_per_scan);
    cartan_assert(ms_per_scan <= 1.50, "Latency Gate: Centroid Scan <= 1.50 ms");
    printf("[PASS] Centroid scan executed well within 1.50 ms hard gate.\n\n");

    free(v_proto);
    free(prev_c);
    domain_genesis_free(tracker);

    printf("================================================================================\n");
    printf("  ALL TS-SUB-3 SUITE GATES PASSED (Exit Code: 0)\n");
    printf("================================================================================\n");
    cartan_flush(0.0);
    return 0.0;
}
