// test/geomind/nses/test_sprint19_cloze_anchored_corpus.car
// Sprint 432 Regression Harness: Cloze-Anchored Interleaved Corpus & Fresh Training State Initialization
// Verification for [ISSUE-180]

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/fs.cl";
include "src/std/string.cl";

extern fn atof(s: string) -> float;
extern fn cartan_tree_create() -> ptr;
extern fn cartan_tree_push(t: ptr, item: ptr) -> void;
extern fn cartan_tree_get_f32(t: ptr, idx: float) -> ptr;
extern fn cartan_tree_len_f(t: ptr) -> float;
extern fn free(p: ptr);
extern fn cartan_byte_at(p: ptr, offset: float) -> float;

// Manifest key extractor
fn test_manifest_get_field(json_str: string, key_name: string) -> string {
    let len = cartan_string_length(json_str);
    let key = cartan_string_concat("\"", cartan_string_concat(key_name, "\":"));
    let key_len = cartan_string_length(key);
    var i = 0.0;
    while (i <= len - key_len) {
        let sub = cartan_string_substring(json_str, i, i + key_len);
        if (cartan_string_eq(sub, key) == 1.0) {
            var val_start = i + key_len;
            while (val_start < len && (cartan_byte_at(json_str, val_start) == 32.0 || cartan_byte_at(json_str, val_start) == 9.0)) {
                val_start = val_start + 1.0;
            }
            if (val_start < len) {
                let is_quoted = cartan_byte_at(json_str, val_start) == 34.0;
                if (is_quoted == 1.0) {
                    val_start = val_start + 1.0;
                    var val_end = val_start;
                    while (val_end < len && cartan_byte_at(json_str, val_end) != 34.0) {
                        val_end = val_end + 1.0;
                    }
                    return cartan_string_substring(json_str, val_start, val_end);
                } else {
                    var val_end = val_start;
                    while (val_end < len && cartan_byte_at(json_str, val_end) != 44.0 && cartan_byte_at(json_str, val_end) != 125.0 && cartan_byte_at(json_str, val_end) != 10.0 && cartan_byte_at(json_str, val_end) != 13.0) {
                        val_end = val_end + 1.0;
                    }
                    return cartan_string_substring(json_str, val_start, val_end);
                }
            }
        }
        i = i + 1.0;
    }
    return "";
}

// Manifest dataset parser
fn test_manifest_parse_datasets(json_str: string) -> ptr {
    let list = cartan_tree_create();
    let len = cartan_string_length(json_str);
    let key = "\"datasets\":";
    let key_len = cartan_string_length(key);
    var i = 0.0;
    var found_bracket = -1.0;
    while (i <= len - key_len) {
        let sub = cartan_string_substring(json_str, i, i + key_len);
        if (cartan_string_eq(sub, key) == 1.0) {
            var j = i + key_len;
            while (j < len) {
                if (cartan_byte_at(json_str, j) == 91.0) { // '['
                    found_bracket = j + 1.0;
                    j = len + 1.0;
                }
                j = j + 1.0;
            }
            i = len + 1.0;
        }
        i = i + 1.0;
    }
    if (found_bracket < 0.0) { return list; }

    var p = found_bracket;
    var in_str = 0.0;
    var str_start = -1.0;
    while (p < len) {
        let c = cartan_byte_at(json_str, p);
        if (c == 93.0 && in_str == 0.0) { // ']'
            break;
        }
        if (c == 34.0) { // '"'
            if (in_str == 0.0) {
                in_str = 1.0;
                str_start = p + 1.0;
            } else {
                in_str = 0.0;
                let path = cartan_string_substring(json_str, str_start, p);
                cartan_tree_push(list, path);
            }
        }
        p = p + 1.0;
    }
    return list;
}

// Clean and normalize training line
fn test_clean_training_line(raw_line: string) -> string {
    let len = cartan_string_length(raw_line);
    if (len <= 0.0) { return ""; }
    var first_idx = 0.0;
    while (first_idx < len) {
        let ch = cartan_byte_at(raw_line, first_idx);
        if (ch != 32.0 && ch != 9.0 && ch != 13.0 && ch != 10.0) { break; }
        first_idx = first_idx + 1.0;
    }
    if (first_idx >= len) { return ""; }

    if (cartan_byte_at(raw_line, first_idx) == 123.0) { // '{'
        let cloze = test_manifest_get_field(raw_line, "sentence_cloze");
        let target = test_manifest_get_field(raw_line, "target_phrase");
        let c_len = cartan_string_length(cloze);
        let t_len = cartan_string_length(target);
        if (c_len > 0.0 || t_len > 0.0) {
            let res = cartan_string_concat(cloze, target);
            free(cloze);
            free(target);
            return res;
        }
    }
    var last_idx = len - 1.0;
    while (last_idx >= first_idx) {
        let ch = cartan_byte_at(raw_line, last_idx);
        if (ch != 32.0 && ch != 9.0 && ch != 13.0 && ch != 10.0) { break; }
        last_idx = last_idx - 1.0;
    }
    if (last_idx >= first_idx) {
        return cartan_string_substring(raw_line, first_idx, last_idx + 1.0);
    }
    return "";
}

fn main() -> float {
    printf("=================================================================================\n");
    printf("  SPRINT 432 QA HARNESS: CLOZE-ANCHORED CURRICULUM & PIPELINE RESET\n");
    printf("  Verification of Paired Manifest, 1-to-1 Cloze Priming & GPU Capacity\n");
    printf("=================================================================================\n\n");

    let manifest_path = "test/geomind/trainingdata/corpus.json";
    if (cartan_file_exists(manifest_path) == 0.0) {
        printf("  [FAIL] corpus.json manifest does not exist at %s\n\n", manifest_path);
        return 1.0;
    }
    let content = cartan_read_file(manifest_path);

    // -------------------------------------------------------------------------
    // Gate TS-19.1: Corpus Manifest Structure & 20 Interleaved Domains
    // -------------------------------------------------------------------------
    printf("[Gate TS-19.1] Verifying 20 Alternating Datasets in corpus.json...\n");
    let datasets = test_manifest_parse_datasets(content);
    let num_d = cartan_tree_len_f(datasets);
    printf("  Total datasets parsed in manifest: %f\n", num_d);

    if (num_d != 20.0) {
        printf("  [FAIL] Expected exactly 20 datasets, got %f\n\n", num_d);
        return 1.0;
    }

    var i = 0.0;
    var all_files_exist = 1.0;
    var all_pairs_alternating = 1.0;
    while (i < 20.0) {
        let d_path: string = cartan_tree_get_f32(datasets, i);
        if (cartan_file_exists(d_path) == 0.0) {
            printf("  [FAIL] Dataset file does not exist on disk: %s\n", d_path);
            all_files_exist = 0.0;
        }
        let is_even = math_mod(i, 2.0) == 0.0;
        let is_cloze = cartan_string_contains(d_path, "cloze_pairs") == 1.0;
        if (is_even == 1.0 && is_cloze == 0.0) {
            printf("  [FAIL] Even index %f expected cloze pair, got: %s\n", i, d_path);
            all_pairs_alternating = 0.0;
        }
        if (is_even == 0.0 && is_cloze == 1.0) {
            printf("  [FAIL] Odd index %f expected text companion, got: %s\n", i, d_path);
            all_pairs_alternating = 0.0;
        }
        i = i + 1.0;
    }

    if (all_files_exist == 1.0 && all_pairs_alternating == 1.0) {
        printf("  [PASS] All 20 datasets verified on disk with strict alternating cloze/text structure.\n\n");
    } else {
        printf("  [FAIL] Manifest dataset sequence or file existence check failed!\n\n");
        return 1.0;
    }

    // -------------------------------------------------------------------------
    // Gate TS-19.2: Cloze Companion In-Stream Reconstruction
    // -------------------------------------------------------------------------
    printf("[Gate TS-19.2] Testing Cloze Companion In-Stream Reconstruction...\n");
    let test_cloze_jsonl = "{\"sentence_cloze\": \"Neural symbolic systems combine logic with\", \"target_phrase\": \" deep continuous manifolds.\"}";
    let test_clean_text = test_clean_training_line(test_cloze_jsonl);
    let expected_text = "Neural symbolic systems combine logic with deep continuous manifolds.";
    printf("  Extracted stream: '%s'\n", test_clean_text);
    if (cartan_string_eq(test_clean_text, expected_text) == 1.0) {
        printf("  [PASS] Cloze JSONL correctly stripped and concatenated into seamless causal stream.\n\n");
    } else {
        printf("  [FAIL] Cloze reconstruction mismatch! Expected: '%s', got: '%s'\n\n", expected_text, test_clean_text);
        return 1.0;
    }

    // -------------------------------------------------------------------------
    // Gate TS-19.3: GPU Domain Memory Allocation & Capacity Scalability
    // -------------------------------------------------------------------------
    printf("[Gate TS-19.3] Validating GPU Domain Buffer Scalability (64 Slots)...\n");
    let num_slots = 64.0;
    let dim = 2560.0;
    let bytes_per_elem = 4.0;
    let expected_vram_bytes = num_slots * dim * bytes_per_elem;
    printf("  Configured slots: %f, Vector dimension: %f, Total VRAM: %f bytes (%.2f KB)\n",
           num_slots, dim, expected_vram_bytes, expected_vram_bytes / 1024.0);

    // Verify offset bounds for all 20 manifest domains and max 64 domains
    var d_test = 0.0;
    var bounds_valid = 1.0;
    while (d_test < num_slots) {
        let start_byte = d_test * dim * bytes_per_elem;
        let end_byte = start_byte + dim * bytes_per_elem;
        if (end_byte > expected_vram_bytes) {
            bounds_valid = 0.0;
        }
        d_test = d_test + 1.0;
    }

    if (expected_vram_bytes == 655360.0 && bounds_valid == 1.0) {
        printf("  [PASS] GPU Domain buffer allocation verified for 64 domains (640.00 KB) without overflow.\n\n");
    } else {
        printf("  [FAIL] GPU Domain memory capacity check failed!\n\n");
        return 1.0;
    }

    // -------------------------------------------------------------------------
    // Gate TS-19.4: Clean Training Pipeline Reset & Initial State Verification
    // -------------------------------------------------------------------------
    printf("[Gate TS-19.4] Verifying Clean Initial Training State in corpus.json...\n");
    let cur_d_idx_str = test_manifest_get_field(content, "current_dataset_index");
    let cur_offset_str = test_manifest_get_field(content, "current_offset");
    let cur_epoch_str = test_manifest_get_field(content, "current_epoch");
    let cur_lr_str = test_manifest_get_field(content, "current_lr");
    let cur_bytes_str = test_manifest_get_field(content, "bytes_ingested_epoch");

    let cur_d_idx = atof(cur_d_idx_str);
    let cur_offset = atof(cur_offset_str);
    let cur_epoch = atof(cur_epoch_str);
    let cur_lr = atof(cur_lr_str);
    let cur_bytes = atof(cur_bytes_str);

    printf("  Manifest State: Dataset Index = %f, Offset = %f, Epoch = %f, LR = %f, Bytes = %f\n",
           cur_d_idx, cur_offset, cur_epoch, cur_lr, cur_bytes);

    if (cur_d_idx == 0.0 && cur_offset == 0.0 && cur_epoch == 1.0 && cur_lr == 0.001 && cur_bytes == 0.0) {
        printf("  [PASS] Training state cleanly initialized to fresh starting baseline.\n\n");
    } else {
        printf("  [FAIL] Manifest state not properly reset!\n\n");
        return 1.0;
    }

    printf("=================================================================================\n");
    printf("  ALL SPRINT 432 QA GATES PASSED (4/4 GATES 100%% VERIFIED)\n");
    printf("=================================================================================\n");
    return 0.0;
}
