// test/geomind/nses/test_sprint22_sleep_consolidation_chat.car
// Sprint 435 Verification: Phase B Metacognitive Sleep Consolidation & Interactive Cognitive Chat
// Gates TS-22.1 through TS-22.4

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/dynamic_graph.cl";
include "src/std/cargraph_consolidate.cl";
include "src/std/sqlite_vec.cl";
include "src/std/prompt_scaffold.cl";

extern fn printf(fmt: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn remove(path: string) -> float;

fn main() -> float {
    printf("====================================================================\n");
    printf("  SPRINT 435 VERIFICATION: PHASE B METACOGNITIVE SLEEP CONSOLIDATION\n");
    printf("  & INTERACTIVE COGNITIVE CHAT TWO-TIER MEMORY INTEGRATION          \n");
    printf("====================================================================\n\n");
    cartan_flush(0.0);

    var pass_count = 0.0;
    var total_gates = 4.0;

    // -------------------------------------------------------------------------
    // GATE TS-22.1: Metacognitive Episode Consolidation & Fact Extraction
    // -------------------------------------------------------------------------
    printf("[GATE TS-22.1] Testing Metacognitive Episode Consolidation & Fact Extraction...\n");
    let db = sqlite_vec_open(":memory:");
    if (db == 0.0) {
        printf("  [FAIL] Failed to open in-memory SQLite database.\n");
        return 1.0;
    }

    let schema_ok = sqlite_vec_init_schema(db);
    if (schema_ok != 1.0) {
        printf("  [FAIL] Failed to initialize cognitive memory schema.\n");
        sqlite_vec_close(db);
        return 1.0;
    }

    sqlite_vec_upsert_domain(db, 1.0, "Cognitive_Domain", "Active reasoning domain");

    // Add conversational dialogue episodes (2 user assertions + 1 assistant turn)
    sqlite_vec_add_episode(db, "session-s22", 1.0, "user", "The speed of light in vacuum is exactly 299792458 meters per second.");
    sqlite_vec_add_episode(db, "session-s22", 1.0, "user", "General relativity describes gravity as the geometric curvature of spacetime.");
    sqlite_vec_add_episode(db, "session-s22", 1.0, "geomind", "Physical constants acknowledged and logged.");

    let uncons_init = sqlite_vec_get_unconsolidated_count(db, 1.0);
    let rules_init = sqlite_vec_get_rule_count(db, 1.0);

    // Run Metacognitive Episode Consolidation Pass
    let cons_res = sqlite_vec_consolidate_episodes(db, 1.0);
    let uncons_after = sqlite_vec_get_unconsolidated_count(db, 1.0);
    let rules_after = sqlite_vec_get_rule_count(db, 1.0);

    var ts22_1_ok = 1.0;
    if (uncons_init != 3.0) {
        printf("  [FAIL] Expected 3 unconsolidated episodes before pass, found: %s\n", cartan_float_to_string(uncons_init));
        ts22_1_ok = 0.0;
    }
    if (rules_init != 0.0) {
        printf("  [FAIL] Expected 0 active rules before pass, found: %s\n", cartan_float_to_string(rules_init));
        ts22_1_ok = 0.0;
    }
    if (uncons_after != 0.0) {
        printf("  [FAIL] Expected 0 unconsolidated episodes after pass, found: %s\n", cartan_float_to_string(uncons_after));
        ts22_1_ok = 0.0;
    }
    if (rules_after != 2.0) {
        printf("  [FAIL] Expected 2 extracted active rules after pass, found: %s\n", cartan_float_to_string(rules_after));
        ts22_1_ok = 0.0;
    }

    if (ts22_1_ok == 1.0) {
        printf("  [PASS] Metacognitive episode consolidation converted dialogue assertions into 2 active rule elements.\n\n");
        pass_count = pass_count + 1.0;
    } else {
        printf("  [FAIL] Gate TS-22.1 failed.\n\n");
    }
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // GATE TS-22.2: Belief Revision & Contradiction Supersession
    // -------------------------------------------------------------------------
    printf("[GATE TS-22.2] Testing Belief Revision & Contradiction Supersession...\n");
    // Insert initial belief and revised belief
    sqlite_vec_upsert_rule(db, 101.0, 1.0, "fact_grounding", "Active working memory is constrained to 7 discrete items.", 0.0, 0.85);
    sqlite_vec_upsert_rule(db, 102.0, 1.0, "fact_grounding", "Active working memory is dynamically pooled via Continuous Hopfield basins.", 0.0, 0.99);

    let rules_pre_super = sqlite_vec_get_rule_count(db, 1.0); // should be 2 (from TS-22.1) + 2 = 4

    // Execute belief revision: rule 102 supersedes rule 101
    let super_ok = sqlite_vec_supersede_rule(db, 101.0, 102.0);
    let rules_post_super = sqlite_vec_get_rule_count(db, 1.0); // rule 101 is now 'superseded', active count should be 3

    var ts22_2_ok = 1.0;
    if (super_ok != 1.0) {
        printf("  [FAIL] sqlite_vec_supersede_rule returned failure code.\n");
        ts22_2_ok = 0.0;
    }
    if (rules_pre_super != 4.0) {
        printf("  [FAIL] Expected 4 active rules before supersession, found: %s\n", cartan_float_to_string(rules_pre_super));
        ts22_2_ok = 0.0;
    }
    if (rules_post_super != 3.0) {
        printf("  [FAIL] Expected 3 active rules after supersession (1 superseded), found: %s\n", cartan_float_to_string(rules_post_super));
        ts22_2_ok = 0.0;
    }

    if (ts22_2_ok == 1.0) {
        printf("  [PASS] Contradicted belief superseded; active rule count cleanly maintained at %s.\n\n",
            cartan_float_to_string(rules_post_super));
        pass_count = pass_count + 1.0;
    } else {
        printf("  [FAIL] Gate TS-22.2 failed.\n\n");
    }
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // GATE TS-22.3: Ebbinghaus Synaptic Decay & Hebbian Dynamic Flush
    // -------------------------------------------------------------------------
    printf("[GATE TS-22.3] Testing Ebbinghaus Synaptic Decay & Hebbian Dynamic Flush...\n");
    // Insert fragile non-strict rule with low initial confidence (0.21)
    sqlite_vec_upsert_rule(db, 201.0, 1.0, "fact_grounding", "Transient heuristic hypothesis with low verification.", 0.0, 0.21);
    let rules_pre_decay = sqlite_vec_get_rule_count(db, 1.0); // should be 3 + 1 = 4

    // Apply Ebbinghaus decay step: confidence decays to 0.21 * 0.90 = 0.189 < 0.20 threshold -> pruned
    sqlite_vec_apply_ebbinghaus_decay(db, 1.0, 0.20);
    let rules_post_decay = sqlite_vec_get_rule_count(db, 1.0); // should return to 3 (fragile rule pruned)

    // Flush Hebbian dynamic CSR weight back to dependencies table
    let flush_ok = sqlite_vec_flush_hebbian_weight(db, 102.0, 1.0, 1.45);

    var ts22_3_ok = 1.0;
    if (rules_pre_decay != 4.0) {
        printf("  [FAIL] Expected 4 active rules before decay, found: %s\n", cartan_float_to_string(rules_pre_decay));
        ts22_3_ok = 0.0;
    }
    if (rules_post_decay != 3.0) {
        printf("  [FAIL] Expected 3 active rules after decay pruning, found: %s\n", cartan_float_to_string(rules_post_decay));
        ts22_3_ok = 0.0;
    }
    if (flush_ok != 1.0) {
        printf("  [FAIL] Hebbian weight flush failed.\n");
        ts22_3_ok = 0.0;
    }

    if (ts22_3_ok == 1.0) {
        printf("  [PASS] Ebbinghaus decay pruned decayed rule (confidence < 0.20) and Hebbian weight flushed (w=1.45).\n\n");
        pass_count = pass_count + 1.0;
    } else {
        printf("  [FAIL] Gate TS-22.3 failed.\n\n");
    }
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // GATE TS-22.4: End-to-End Chat Dialogue, Entity Continuity & .car_graph v2 Re-Materialization
    // -------------------------------------------------------------------------
    printf("[GATE TS-22.4] Testing End-to-End Chat Dialogue & .car_graph v2 Re-Materialization...\n");
    // Upsert entity states
    sqlite_vec_upsert_entity_state(db, 1.0, "User", "preferred_name", "Rick", 1.0);
    sqlite_vec_upsert_entity_state(db, 1.0, "GeoMind", "architecture", "Two-Tier Synaptic", 1.0);

    let test_graph_path = "scratch/sprint22_test.car_graph";
    let mat_ok = sqlite_vec_materialize_to_cargraph(db, 1.0, test_graph_path);

    var ts22_4_ok = 1.0;
    if (mat_ok != 1.0) {
        printf("  [FAIL] Materialization of .car_graph v2 returned failure.\n");
        ts22_4_ok = 0.0;
    }

    // Load materialized .car_graph v2
    let cg = cargraph_load_binary(test_graph_path);
    if (cg.is_valid != 1.0) {
        printf("  [FAIL] Materialized graph failed zero-copy validation.\n");
        ts22_4_ok = 0.0;
    } else {
        if (cg.header.version != 2.0) {
            printf("  [FAIL] Expected header version 2.0, found: %s\n", cartan_float_to_string(cg.header.version));
            ts22_4_ok = 0.0;
        }
        if (cg.header.num_entities != 2.0) {
            printf("  [FAIL] Expected 2 entities in v2 header, found: %s\n", cartan_float_to_string(cg.header.num_entities));
            ts22_4_ok = 0.0;
        }
        let tag0 = cargraph_format_world_state(cg, 0.0);
        let tag1 = cargraph_format_world_state(cg, 1.0);
        if (cartan_string_contains(tag0, "GeoMind.architecture='Two-Tier Synaptic'") == 0.0) {
            printf("  [FAIL] World-state tag 0 mismatch: '%s'\n", tag0);
            ts22_4_ok = 0.0;
        }
        if (cartan_string_contains(tag1, "User.preferred_name='Rick'") == 0.0) {
            printf("  [FAIL] World-state tag 1 mismatch: '%s'\n", tag1);
            ts22_4_ok = 0.0;
        }

        // Test sleep consolidation cycle on .car_graph v2 to verify entity preservation
        let arena = dynamic_arena_create(65536.0, 32.0);
        let rep = cargraph_sleep_consolidate_file(test_graph_path, arena, 1.001);
        dynamic_arena_free(arena);

        if (rep.is_success != 1.0) {
            printf("  [FAIL] cargraph_sleep_consolidate_file failed on .car_graph v2.\n");
            ts22_4_ok = 0.0;
        } else {
            // Reload and verify entities were fully preserved across sleep consolidation
            let cg_reloaded = cargraph_load_binary(test_graph_path);
            if (cg_reloaded.is_valid != 1.0) {
                printf("  [FAIL] Reloaded consolidated graph is invalid.\n");
                ts22_4_ok = 0.0;
            } else {
                if (cg_reloaded.header.version != 2.0) {
                    printf("  [FAIL] Reloaded graph header version downgraded from 2.0 to: %s\n",
                        cartan_float_to_string(cg_reloaded.header.version));
                    ts22_4_ok = 0.0;
                }
                if (cg_reloaded.header.num_entities != 2.0) {
                    printf("  [FAIL] Entity states lost during consolidation: expected 2, found: %s\n",
                        cartan_float_to_string(cg_reloaded.header.num_entities));
                    ts22_4_ok = 0.0;
                }
                let reload_tag0 = cargraph_format_world_state(cg_reloaded, 0.0);
                let reload_tag1 = cargraph_format_world_state(cg_reloaded, 1.0);
                if (cartan_string_contains(reload_tag0, "GeoMind.architecture='Two-Tier Synaptic'") == 0.0) {
                    printf("  [FAIL] Reloaded world state tag 0 mismatch: '%s'\n", reload_tag0);
                    ts22_4_ok = 0.0;
                }
                if (cartan_string_contains(reload_tag1, "User.preferred_name='Rick'") == 0.0) {
                    printf("  [FAIL] Reloaded world state tag 1 mismatch: '%s'\n", reload_tag1);
                    ts22_4_ok = 0.0;
                }
                cargraph_free(cg_reloaded);
            }
        }
        cargraph_free(cg);
    }

    // Cleanup scratch file
    remove(test_graph_path);
    sqlite_vec_close(db);

    if (ts22_4_ok == 1.0) {
        printf("  [PASS] .car_graph v2 materialization and sleep consolidation round-trip preserved all entity states.\n\n");
        pass_count = pass_count + 1.0;
    } else {
        printf("  [FAIL] Gate TS-22.4 failed.\n\n");
    }
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // Final Retrospective Verification Summary
    // -------------------------------------------------------------------------
    printf("====================================================================\n");
    printf("  SPRINT 435 VERIFICATION SUMMARY: %s / %s GATES PASSED\n",
        cartan_float_to_string(pass_count), cartan_float_to_string(total_gates));
    printf("====================================================================\n");
    cartan_flush(0.0);

    if (pass_count == total_gates) {
        return 0.0;
    }
    return 1.0;
}
