// test/geomind/nses/test_sprint2_guardrails_sat.car
// NSES Phase 2 Verification Harness: Deterministic Symbolic Subsystem & SMT/SAT Verifier
// Verification Gates: TS-2.1, TS-2.2, TS-2.3

include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";
include "src/std/guardrails.cl";
include "src/cartanc/cargraph_simd.car";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn remove(path: string) -> float;
extern fn clock() -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("================================================================================\n");
    printf("  NSES SPRINT 2 EMPIRICAL VERIFICATION HARNESS (test_sprint2_guardrails_sat)\n");
    printf("  Testing Deterministic Guardrails, Domain 0 Immunity & SMT/SAT Verifier\n");
    printf("================================================================================\n\n");

    let test_graph_path = "test_nses_graph_sprint2.car_graph";

    // -------------------------------------------------------------------------
    // GATE TS-2.1: Domain 0 (SYSTEM_CORE) Invariant Immunity & Zero ANN Bypass
    // -------------------------------------------------------------------------
    printf("[TS-2.1] Building Multi-Domain Test Graph with 10 Physical Invariants & 500 Facts...\n");
    let builder = cargraph_builder_create(1536.0);

    // Register 3 Domains:
    // Domain 0: SYSTEM_CORE (10 rules, 10 strict)
    // Domain 1: CHEMISTRY (250 rules, 0 strict)
    // Domain 2: FANTASY_FICTION (250 rules, 0 strict)
    cargraph_builder_add_domain(builder, 0.0, 0.0, 10.0, 10.0);
    cargraph_builder_add_domain(builder, 1.0, 10.0, 250.0, 0.0);
    cargraph_builder_add_domain(builder, 2.0, 260.0, 250.0, 0.0);

    // Allocate vector buffers
    let v_zero = malloc(1536.0 * 8.0);
    let v_chem = malloc(1536.0 * 8.0);
    let v_fant = malloc(1536.0 * 8.0);

    var d_k = 0.0;
    while (d_k < 1536.0) {
        v_zero[d_k] = sin(d_k * 0.05);
        v_chem[d_k] = cos(d_k * 0.05);
        v_fant[d_k] = sin(d_k * 0.15 + 2.0);
        d_k = d_k + 1.0;
    }
    cargraph_simd_normalize_1536(v_zero);
    cargraph_simd_normalize_1536(v_chem);
    cargraph_simd_normalize_1536(v_fant);

    // Ingest 10 strict physical invariants into Domain 0 (SYSTEM_CORE)
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant 0: Total energy is strictly conserved in closed systems delta_E = 0", v_zero);
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant 1: Total momentum is conserved delta_p = 0 under translational symmetry", v_zero);
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant 2: Baryon number and net electric charge are strictly conserved", v_zero);
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant 3: Vacuum speed of light c = 299792458 m/s is an upper bound on signals", v_zero);
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant 4: Thermodynamic entropy is non-decreasing in isolated systems dS >= 0", v_zero);
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant 5: Mass-energy equivalence E = mc^2 governs mass transformation", v_zero);
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant 6: Heisenberg uncertainty Delta_x * Delta_p >= hbar / 2 restricts phase space", v_zero);
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant 7: Pauli exclusion principle prohibits fermion multi-occupancy", v_zero);
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant 8: Causality holds: an effect cannot precede its cause in any inertial frame", v_zero);
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant 9: Total probability over all quantum eigenstates equals 1.0", v_zero);

    // Ingest 250 facts in Domain 1 (Chemistry)
    var c_i = 0.0;
    while (c_i < 250.0) {
        cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Chemistry Fact: Molecular covalent bonding and stoichiometry", v_chem);
        c_i = c_i + 1.0;
    }

    // Ingest 250 facts in Domain 2 (Fantasy)
    var f_i = 0.0;
    while (f_i < 250.0) {
        cargraph_builder_add_rule(builder, 2.0, 2.0, 0.0, "Fantasy Myth: Spellcasting generates infinite ethereal mana", v_fant);
        f_i = f_i + 1.0;
    }

    let write_ok = cargraph_serialize_to_file(builder, test_graph_path);
    cartan_assert(write_ok == 1.0, "TS-2.1 Serialization of 510 rules failed");
    printf("  -> Serialized 510 rules across 3 domains into %s\n", test_graph_path);

    // Load binary graph back
    let cg = cargraph_load_binary(test_graph_path);
    cartan_assert(cg.is_valid == 1.0, "TS-2.1 Loaded graph is marked invalid");
    cartan_assert(cg.header.num_rules == 510.0, "TS-2.1 Total rule count mismatch (expected 510)");
    cartan_assert(cg.header.num_strict_rules == 10.0, "TS-2.1 Strict rule count mismatch (expected 10)");
    printf("  -> Verified graph header: 510 rules, 10 strict invariants, 3 domains.\n");

    // Verify direct slice extraction [0 .. num_strict_rules - 1] with complete ANN bypass
    let strict_slice = guardrails_get_strict_slice(cg);
    cartan_assert(strict_slice.is_valid == 1.0, "TS-2.1 Strict slice is invalid");
    cartan_assert(strict_slice.start_rule_idx == 0.0, "TS-2.1 Strict slice start index mismatch");
    cartan_assert(strict_slice.num_strict_rules == 10.0, "TS-2.1 Strict slice count mismatch");

    let prompt_bounds = guardrails_format_inviolable_bounds(cg, strict_slice);
    cartan_assert(cartan_string_contains(prompt_bounds, "[SYSTEM BOUNDS - INVIOLABLE]") != 0.0, "TS-2.1 Prompt bounds header mismatch");
    cartan_assert(cartan_string_contains(prompt_bounds, "Total energy is strictly conserved") != 0.0, "TS-2.1 Invariant 0 missing from bounds");
    printf("  -> Verified [SYSTEM BOUNDS - INVIOLABLE] deterministic prompt prefix formatted cleanly.\n");

    // Setup Domain Centroids buffer (Domain 0, 1, 2)
    let domain_centroids = malloc(3.0 * 1536.0 * 8.0);
    let c0_ptr = cartan_c_ptr_add(domain_centroids, 0.0);
    let c1_ptr = cartan_c_ptr_add(domain_centroids, 1.0 * 1536.0 * 8.0);
    let c2_ptr = cartan_c_ptr_add(domain_centroids, 2.0 * 1536.0 * 8.0);
    cartan_c_memcpy(c0_ptr, v_zero, 1536.0 * 8.0);
    cartan_c_memcpy(c1_ptr, v_chem, 1536.0 * 8.0);
    cartan_c_memcpy(c2_ptr, v_fant, 1536.0 * 8.0);

    // Adversarial Query Suite: 100 queries crafted to route directly to Domain 2 (Fantasy)
    // Testing whether Domain 0 physical invariants are 100.0% preserved despite vector misrouting
    printf("  -> Executing 100 Adversarial Misrouting Queries against Domain 2 (Fantasy)...\n");
    let q_adversarial = malloc(1536.0 * 8.0);
    var q_retention_successes = 0.0;

    let t0 = clock();
    var adv_q = 0.0;
    while (adv_q < 100.0) {
        // Construct adversarial embedding pointing strongly towards Fantasy
        var q_dim = 0.0;
        while (q_dim < 1536.0) {
            q_adversarial[q_dim] = v_fant[q_dim] + (sin(adv_q * 0.1 + q_dim) * 0.01);
            q_dim = q_dim + 1.0;
        }
        cargraph_simd_normalize_1536(q_adversarial);

        // Route query with top_k = 1
        let q_route = guardrails_route_domains(cg, q_adversarial, domain_centroids, 1.0);

        // Verify active domains: must be [0.0, 2.0]
        cartan_assert(collections_list_get(q_route.active_domain_ids, 0.0) == 0.0, "TS-2.1 Domain 0 missing from route slot 0");
        cartan_assert(collections_list_get(q_route.active_domain_ids, 1.0) == 2.0, "TS-2.1 Expected route to Domain 2 (Fantasy)");

        // Extract active rules
        let extracted = guardrails_filter_active_rules(cg, q_route);

        // Check if all 10 Domain 0 strict invariants are present
        var invariants_present = 0.0;
        var r_k = 0.0;
        while (r_k < extracted.num_rules) {
            let r_id = collections_list_get(extracted.rule_ids, r_k);
            if (r_id < 10.0) {
                invariants_present = invariants_present + 1.0;
            }
            r_k = r_k + 1.0;
        }

        if (invariants_present == 10.0) {
            q_retention_successes = q_retention_successes + 1.0;
        }

        guardrails_free_route(q_route);
        guardrails_free_extraction(extracted);
        adv_q = adv_q + 1.0;
    }
    let t1 = clock();
    let elapsed_ms = ((t1 - t0) / 1000.0) * 1000.0;
    let avg_latency_ms = elapsed_ms / 100.0;

    printf("  -> Retention Successes: %.0f / 100 (100.0%% Invariable Preservation)\n", q_retention_successes);
    printf("  -> Deterministic Slice & Extraction Latency: %.4f ms per turn (Budget: <= 0.8 ms)\n", avg_latency_ms);
    cartan_assert(q_retention_successes == 100.0, "TS-2.1 Invariant retention failed under adversarial misrouting");
    cartan_assert(avg_latency_ms <= 0.8, "TS-2.1 Latency exceeded 0.8 ms budget");
    printf("[PASS] TS-2.1: Domain 0 (SYSTEM_CORE) Invariant Immunity & Zero ANN Bypass Verified.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-2.2: SMT/SAT Axiomatic Consistency & Contradiction Detection
    // -------------------------------------------------------------------------
    printf("[TS-2.2] Testing SMT/SAT Propositional Verifier on Clean and Contradictory Topologies...\n");

    // Subtest 2.2.1: Valid, consistent logical topology (A -> B, B -> C)
    let solver_clean = sat_solver_create(5.0);
    sat_add_requirement(solver_clean, 0.0, 1.0); // 0 requires 1
    sat_add_requirement(solver_clean, 1.0, 2.0); // 1 requires 2
    sat_assert_axiom(solver_clean, 0.0);         // 0 is Axiom
    let is_sat_clean = sat_solve_consistency(solver_clean);
    cartan_assert(is_sat_clean == 1.0, "TS-2.2 Clean topology falsely flagged as UNSAT");
    cartan_assert(solver_clean.conflict_found == 0.0, "TS-2.2 Conflict flag incorrectly set for clean graph");
    printf("  -> Subtest 2.2.1 PASSED: Valid implication chain verified as SAT.\n");
    sat_solver_free(solver_clean);

    // Subtest 2.2.2: Direct Contradiction (Rule A requires B, AND Rule A contradicts B)
    let solver_direct = sat_solver_create(5.0);
    sat_add_requirement(solver_direct, 0.0, 1.0);   // 0 requires 1
    sat_add_contradiction(solver_direct, 0.0, 1.0); // 0 contradicts 1
    let is_sat_direct = sat_solve_consistency(solver_direct);
    cartan_assert(is_sat_direct == 0.0, "TS-2.2 Direct contradiction missed by SAT verifier");
    cartan_assert(solver_direct.conflict_found == 1.0, "TS-2.2 Conflict flag not set for direct contradiction");
    cartan_assert(solver_direct.conflict_type == 1.0, "TS-2.2 Conflict type mismatch (expected 1.0 Direct)");
    printf("  -> Subtest 2.2.2 PASSED: Direct contradiction detected (Type %.0f, var1=%.0f, var2=%.0f).\n",
           solver_direct.conflict_type, solver_direct.conflict_var1, solver_direct.conflict_var2);

    // Test build rejection gate
    let reject_ok = cargraph_verify_and_serialize(builder, "should_fail.car_graph", solver_direct);
    cartan_assert(reject_ok == 0.0, "TS-2.2 Serializer failed to abort on contradictory graph");
    printf("  -> Verified cargraph_verify_and_serialize cleanly blocks serialization on contradiction.\n");
    sat_solver_free(solver_direct);

    // Subtest 2.2.3: 2-SAT SCC Cyclic Contradiction
    // A -> B, B -> not(A), and not(A) -> A (pos and neg in same SCC)
    let solver_scc = sat_solver_create(4.0);
    sat_add_directed_edge(solver_scc, sat_lit_pos(0.0), sat_lit_pos(1.0)); // pos(0) -> pos(1)
    sat_add_directed_edge(solver_scc, sat_lit_pos(1.0), sat_lit_neg(0.0)); // pos(1) -> neg(0)
    sat_add_directed_edge(solver_scc, sat_lit_neg(0.0), sat_lit_pos(0.0)); // neg(0) -> pos(0)
    let is_sat_scc = sat_solve_consistency(solver_scc);
    cartan_assert(is_sat_scc == 0.0, "TS-2.2 2-SAT SCC cycle missed by verifier");
    cartan_assert(solver_scc.conflict_found == 1.0, "TS-2.2 Conflict flag not set for SCC cycle");
    cartan_assert(solver_scc.conflict_type == 2.0, "TS-2.2 Conflict type mismatch (expected 2.0 SCC Cycle)");
    printf("  -> Subtest 2.2.3 PASSED: Aspvall-Plass-Tarjan SCC cyclic contradiction detected (Type %.0f, var=%.0f).\n",
           solver_scc.conflict_type, solver_scc.conflict_var1);
    sat_solver_free(solver_scc);

    // Subtest 2.2.4: Axiom Cross-Contradiction
    // Rule 0 is Axiom (Energy conservation), Rule 1 is Axiom (Momentum conservation)
    // An adversarial edge asserts 0 contradicts 1: pos(0) -> neg(1)
    let solver_ax = sat_solver_create(5.0);
    sat_assert_axiom(solver_ax, 0.0);
    sat_assert_axiom(solver_ax, 1.0);
    sat_add_contradiction(solver_ax, 0.0, 1.0);
    let is_sat_ax = sat_solve_consistency(solver_ax);
    cartan_assert(is_sat_ax == 0.0, "TS-2.2 Axiom cross-contradiction missed by verifier");
    cartan_assert(solver_ax.conflict_found == 1.0, "TS-2.2 Conflict flag not set for axiom conflict");
    cartan_assert(solver_ax.conflict_type == 3.0, "TS-2.2 Conflict type mismatch (expected 3.0 Axiom Violation)");
    printf("  -> Subtest 2.2.4 PASSED: Axiom reachability conflict detected (Type %.0f, var1=%.0f, var2=%.0f).\n",
           solver_ax.conflict_type, solver_ax.conflict_var1, solver_ax.conflict_var2);
    sat_solver_free(solver_ax);

    printf("[PASS] TS-2.2: SMT/SAT Axiomatic Consistency & Contradiction Detection Verified.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-2.3: Zero Cross-Domain Leakage across Orthogonal Workspaces
    // -------------------------------------------------------------------------
    printf("[TS-2.3] Testing Orthogonal Workspace Isolation & Cross-Domain Leakage Prevention...\n");

    // Query 1: Routed to Domain 2 (Fantasy)
    let route_fant = guardrails_route_domains(cg, v_fant, domain_centroids, 1.0);
    let ext_fant = guardrails_filter_active_rules(cg, route_fant);

    // Verify 0 facts from Domain 1 (Chemistry) leaked into Fantasy context
    let leak_chem = guardrails_verify_zero_leakage(cg, ext_fant, 1.0);
    cartan_assert(leak_chem == 1.0, "TS-2.3 Chemistry facts leaked into Fantasy workspace");

    // Verify all 10 strict Domain 0 invariants are present
    cartan_assert(ext_fant.strict_count == 10.0, "TS-2.3 Strict count mismatch in Fantasy context");
    // Verify associative count equals Domain 2 fact count (250)
    cartan_assert(ext_fant.associative_count == 250.0, "TS-2.3 Associative fact count mismatch");
    printf("  -> Query 1 (Fantasy Route): 0 Chemistry rules leaked (0.0%% leakage), 10 Domain 0 invariants preserved.\n");

    // Query 2: Routed to Domain 1 (Chemistry)
    let route_chem = guardrails_route_domains(cg, v_chem, domain_centroids, 1.0);
    let ext_chem = guardrails_filter_active_rules(cg, route_chem);

    // Verify 0 facts from Domain 2 (Fantasy) leaked into Chemistry context
    let leak_fant = guardrails_verify_zero_leakage(cg, ext_chem, 2.0);
    cartan_assert(leak_fant == 1.0, "TS-2.3 Fantasy facts leaked into Chemistry workspace");

    // Verify all 10 strict Domain 0 invariants are present
    cartan_assert(ext_chem.strict_count == 10.0, "TS-2.3 Strict count mismatch in Chemistry context");
    // Verify associative count equals Domain 1 fact count (250)
    cartan_assert(ext_chem.associative_count == 250.0, "TS-2.3 Associative fact count mismatch");
    printf("  -> Query 2 (Chemistry Route): 0 Fantasy rules leaked (0.0%% leakage), 10 Domain 0 invariants preserved.\n");

    guardrails_free_route(route_fant);
    guardrails_free_extraction(ext_fant);
    guardrails_free_route(route_chem);
    guardrails_free_extraction(ext_chem);

    printf("[PASS] TS-2.3: Zero Cross-Domain Leakage across Orthogonal Workspaces Verified.\n\n");

    // Cleanup resources
    cargraph_free(cg);
    free(v_zero);
    free(v_chem);
    free(v_fant);
    free(q_adversarial);
    free(domain_centroids);
    remove(test_graph_path);

    printf("================================================================================\n");
    printf("  ALL SPRINT 2 EMPIRICAL VERIFICATION GATES PASSED (Code 0)\n");
    printf("================================================================================\n");
    return 0.0;
}
