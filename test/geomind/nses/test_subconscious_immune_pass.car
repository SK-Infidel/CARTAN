// test/geomind/nses/test_subconscious_immune_pass.car
// NSES Phase 6 Verification Harness: Suite 2 - Symbolic Immune Pass & Bitwise Rollback (TS-SUB-2)
// Gates: TS-SUB-2.1, TS-SUB-2.2, TS-SUB-2.3 & Append Latency Benchmarks (<100ns)

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/sat_solver.cl";
include "src/cartanc/cargraph_simd.car";
include "src/std/dynamic_graph.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn clock() -> float;
extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("================================================================================\n");
    printf("  NSES PHASE 6 SUITE 2: SYMBOLIC IMMUNE PASS (test_subconscious_immune_pass)\n");
    printf("  Testing Direct Invariant Negation, Transitive 2-SAT Contradictions & Bitwise Rollback\n");
    printf("================================================================================\n\n");

    let solver = sat_solver_create(64.0);
    // Setup transitive implication chain: Rule 10 -> Rule 11 -> Rule 12 (Domain 0 Invariant)
    sat_add_implication(solver, 10.0, 11.0);
    sat_add_implication(solver, 11.0, 12.0);
    sat_assert_axiom(solver, 12.0); // Rule 12 is strict ground axiom

    let arena = dynamic_arena_create(1048576.0, 128.0); // 1MB arena
    cartan_assert(arena.is_valid == 1.0, "Arena allocation check");

    // -------------------------------------------------------------------------
    // GATE TS-SUB-2.1: Direct Invariant Negation Blocking (500 Candidates)
    // -------------------------------------------------------------------------
    printf("[TS-SUB-2.1] Testing Direct Invariant Negation Blocking on 500 Candidate Notes...\n");
    var dir_i = 0.0;
    var dir_blocked = 0.0;

    let initial_used = arena.used_bytes;

    while (dir_i < 500.0) {
        dynamic_arena_begin_transaction(arena);
        // Candidate asserts CONTRADICTS against strict rule 0 (Domain 0 energy conservation)
        let pass = dynamic_arena_immune_pass(solver, 6.0, 0.0, 2.0, 1.0);
        if (pass == 0.0) {
            dir_blocked = dir_blocked + 1.0;
            dynamic_arena_rollback_transaction(arena);
        } else {
            dynamic_arena_append_edge(arena, 6.0, 0.0, 1.0, 2.0);
            dynamic_arena_commit_transaction(arena);
        }
        dir_i = dir_i + 1.0;
    }

    printf("  -> Direct Invariant Negations Blocked: %.0f / 500 (100.00%% Block Rate)\n", dir_blocked);
    printf("  -> Arena Used Bytes Delta: %.0f bytes (Expected: 0 bytes)\n", arena.used_bytes - initial_used);
    cartan_assert(dir_blocked == 500.0, "TS-SUB-2.1 Direct invariant negation leaked into memory");
    cartan_assert(arena.used_bytes == initial_used, "TS-SUB-2.1 Memory write occurred on rejected note");
    printf("[PASS] TS-SUB-2.1: 100.00%% of direct invariant negations blocked with zero memory writes.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-SUB-2.2: Transitive Contradiction Detection (300 Candidates)
    // -------------------------------------------------------------------------
    printf("[TS-SUB-2.2] Testing Transitive Contradiction Detection on 300 Multi-Hop Chains...\n");
    var trans_i = 0.0;
    var trans_blocked = 0.0;

    while (trans_i < 300.0) {
        dynamic_arena_begin_transaction(arena);
        // Rule 10 requires Rule 11 requires Rule 12. Candidate note from Rule 10 contradicts Rule 12!
        let pass = dynamic_arena_immune_pass(solver, 10.0, 12.0, 2.0, 0.0);
        if (pass == 0.0) {
            trans_blocked = trans_blocked + 1.0;
            dynamic_arena_rollback_transaction(arena);
        } else {
            dynamic_arena_append_edge(arena, 10.0, 12.0, 1.0, 2.0);
            dynamic_arena_commit_transaction(arena);
        }
        trans_i = trans_i + 1.0;
    }

    printf("  -> Transitive Contradictions Blocked: %.0f / 300 (100.00%% Block Rate)\n", trans_blocked);
    printf("  -> Arena Used Bytes Delta: %.0f bytes (Expected: 0 bytes)\n", arena.used_bytes - initial_used);
    cartan_assert(trans_blocked == 300.0, "TS-SUB-2.2 Transitive multi-hop contradiction leaked into memory");
    cartan_assert(arena.used_bytes == initial_used, "TS-SUB-2.2 Memory write occurred on transitive contradiction");
    printf("[PASS] TS-SUB-2.2: 100.00%% of transitive contradictions blocked via 2-SAT implication graph.\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-SUB-2.3: Bitwise State Rollback (1,000 Rejected Mutations)
    // -------------------------------------------------------------------------
    printf("[TS-SUB-2.3] Executing Bitwise State Rollback Verification on 1,000 Rejected Mutations...\n");
    // Populate an initial clean baseline in the arena
    dynamic_arena_append_edge(arena, 1.0, 2.0, 1.25, 1.0);
    dynamic_arena_append_edge(arena, 2.0, 3.0, 1.50, 1.0);
    let baseline_used = arena.used_bytes;
    let baseline_nodes = arena.dynamic_node_count;

    // Calculate baseline checksum across entire 1MB buffer
    var chk0 = 0.0;
    var b_idx = 0.0;
    while (b_idx < arena.capacity_bytes) {
        chk0 = chk0 + cartan_byte_at(arena.arena_buffer, b_idx) * (math_mod_val(b_idx, 255.0) + 1.0);
        b_idx = b_idx + 1.0;
    }

    // Attempt 1,000 invalid mutations with rollback
    var mut_i = 0.0;
    while (mut_i < 1000.0) {
        dynamic_arena_begin_transaction(arena);
        // Mutate arena memory
        dynamic_arena_append_edge(arena, 10.0, 12.0, 9.99, 2.0);
        // Simulate immune pass rejection and rollback
        dynamic_arena_rollback_transaction(arena);
        mut_i = mut_i + 1.0;
    }

    // Calculate post-rollback checksum across entire buffer
    var chk1 = 0.0;
    b_idx = 0.0;
    while (b_idx < arena.capacity_bytes) {
        chk1 = chk1 + cartan_byte_at(arena.arena_buffer, b_idx) * (math_mod_val(b_idx, 255.0) + 1.0);
        b_idx = b_idx + 1.0;
    }

    printf("  -> Baseline Checksum: %.0f | Post-Rollback Checksum: %.0f (Checksum Delta: %.0f)\n",
           chk0, chk1, chk1 - chk0);
    printf("  -> Memory Pointer: %.0f (Expected: %.0f)\n", arena.used_bytes, baseline_used);

    cartan_assert(chk0 == chk1, "TS-SUB-2.3 Bitwise state rollback failed: memory was corrupted");
    cartan_assert(arena.used_bytes == baseline_used, "TS-SUB-2.3 Used bytes diverged from baseline");
    cartan_assert(arena.dynamic_node_count == baseline_nodes, "TS-SUB-2.3 Dynamic node count diverged from baseline");
    printf("[PASS] TS-SUB-2.3: Bit-for-bit exact match verified across 1,000 rolled-back mutations (Delta = 0).\n\n");

    // -------------------------------------------------------------------------
    // LATENCY BENCHMARK: Lock-Free Edge Append (<100 ns Hard Gate)
    // -------------------------------------------------------------------------
    let bench_appends = 10000.0;
    let t0 = clock();
    var a_idx = 0.0;
    while (a_idx < bench_appends) {
        // Append in-place within pre-reserved bounds
        dynamic_arena_append_edge(arena, 1.0, 2.0, 1.0, 1.0);
        a_idx = a_idx + 1.0;
    }
    let t1 = clock();
    let total_ms = t1 - t0;
    let ns_per_append = (total_ms / bench_appends) * 1000000.0;

    printf("[BENCHMARK] Dynamic Delta Edge Append Execution:\n");
    printf("  -> 10,000 Appends Time: %.2f ms\n", total_ms);
    printf("  -> Average Latency: %.2f ns (Hard Gate: <= 100.0 ns)\n", ns_per_append);
    cartan_assert(ns_per_append <= 100.0, "Latency Gate: Dynamic Edge Append <= 100 ns");
    printf("[PASS] Dynamic edge append executed well under 100 ns hard gate.\n\n");

    sat_solver_free(solver);
    dynamic_arena_free(arena);

    printf("================================================================================\n");
    printf("  ALL TS-SUB-2 SUITE GATES PASSED (Exit Code: 0)\n");
    printf("================================================================================\n");
    cartan_flush(0.0);
    return 0.0;
}
