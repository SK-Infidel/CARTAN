// test/geomind/nses/test_sprint7_loss_shaping.car
// NSES Phase 7: Deterministic Loss Shaping & Knowledge Grounding Verification Harness
// Empirical verification of symbolic loss penalties, gradient shaping, multi-domain scaling, and CSR monotonicity

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";
include "src/std/guardrails.cl";
include "src/std/csr_graph.cl";
include "src/std/plasticity.cl";
include "src/std/burroughs.cl";
include "src/std/prompt_scaffold.cl";
include "src/std/veto_gate.cl";
include "src/std/nses_pipeline.cl";
include "src/std/cargraph_consolidate.cl";

extern fn printf(format: string) -> i32;
extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn clock() -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("=================================================================================\n");
    printf("  NSES PHASE 7: DETERMINISTIC LOSS SHAPING & KNOWLEDGE GROUNDING SUITE\n");
    printf("  Testing Invariant Penalty Gradients, Multi-Domain Knowledge & CSR Monotonicity\n");
    printf("=================================================================================\n\n");

    let graph_path = "test/geomind/trainingdata/nses_knowledge.car_graph";

    // -------------------------------------------------------------------------
    // 1. TS-7.1: Symbolic Negative Gradient Injection on Forbidden Logits
    // -------------------------------------------------------------------------
    printf("[TS-7.1] Testing Analytical Symbolic Gradient Injection on Forbidden Logits...\n");
    let v_reg = veto_registry_create();
    veto_registry_populate_defaults(v_reg);

    let vocab_size = 2560.0;
    let logits = cartan_vec_create();
    var vi = 0.0;
    while (vi < vocab_size) {
        cartan_vec_push_f32(logits, 2.0); // Baseline uniform logit = 2.0
        vi = vi + 1.0;
    }

    // Mark token 42, 108, and 512 as forbidden contradiction tokens
    let forbidden_toks = cartan_vec_create();
    cartan_vec_push_f32(forbidden_toks, 42.0);
    cartan_vec_push_f32(forbidden_toks, 108.0);
    cartan_vec_push_f32(forbidden_toks, 512.0);

    let penalty_loss = veto_compute_symbolic_loss_penalty(v_reg, 0.0, logits, forbidden_toks, 1.0);
    printf("  -> Computed Symbolic Loss Penalty: %.4f (Expected > 0.0)\n", penalty_loss);
    cartan_assert(penalty_loss > 0.0, "TS-7.1: Penalty loss must be strictly positive");

    let z_42 = cartan_vec_get_f32(logits, 42.0);
    let z_108 = cartan_vec_get_f32(logits, 108.0);
    let z_512 = cartan_vec_get_f32(logits, 512.0);
    printf("  -> Forbidden Token 42 Logit: %.2f (Baseline: 2.00, Expected <= -13.00)\n", z_42);
    printf("  -> Forbidden Token 108 Logit: %.2f (Baseline: 2.00, Expected <= -13.00)\n", z_108);
    printf("  -> Forbidden Token 512 Logit: %.2f (Baseline: 2.00, Expected <= -13.00)\n", z_512);

    cartan_assert(z_42 <= -13.0, "TS-7.1: Token 42 logit must be sharply suppressed by symbolic penalty");
    cartan_assert(z_108 <= -13.0, "TS-7.1: Token 108 logit must be sharply suppressed by symbolic penalty");
    cartan_assert(z_512 <= -13.0, "TS-7.1: Token 512 logit must be sharply suppressed by symbolic penalty");
    printf("[PASS] TS-7.1: Analytical symbolic penalty gradient successfully suppressed forbidden logits.\n\n");

    // -------------------------------------------------------------------------
    // 2. TS-7.2: Compliant Domain Tokens Invariant Preservation
    // -------------------------------------------------------------------------
    printf("[TS-7.2] Testing Preservation of Compliant Domain Tokens...\n");
    let z_compliant_0 = cartan_vec_get_f32(logits, 0.0);
    let z_compliant_100 = cartan_vec_get_f32(logits, 100.0);
    let z_compliant_1000 = cartan_vec_get_f32(logits, 1000.0);
    printf("  -> Compliant Token 0 Logit: %.2f (Expected: 2.00)\n", z_compliant_0);
    printf("  -> Compliant Token 100 Logit: %.2f (Expected: 2.00)\n", z_compliant_100);
    printf("  -> Compliant Token 1000 Logit: %.2f (Expected: 2.00)\n", z_compliant_1000);

    cartan_assert(z_compliant_0 == 2.0, "TS-7.2: Compliant token 0 must remain unperturbed");
    cartan_assert(z_compliant_100 == 2.0, "TS-7.2: Compliant token 100 must remain unperturbed");
    cartan_assert(z_compliant_1000 == 2.0, "TS-7.2: Compliant token 1000 must remain unperturbed");
    printf("[PASS] TS-7.2: Compliant domain tokens strictly preserved with zero gradient distortion.\n\n");

    cartan_vec_free(logits);
    cartan_vec_free(forbidden_toks);
    veto_registry_free(v_reg);

    // -------------------------------------------------------------------------
    // 3. TS-7.3: Multi-Domain Knowledge Scalability & Monotonicity
    // -------------------------------------------------------------------------
    printf("[TS-7.3] Testing Multi-Domain Scalability & CSR Layout Monotonicity...\n");
    let cg = cargraph_load_binary(graph_path);
    cartan_assert(cg.is_valid == 1.0, "TS-7.3: nses_knowledge.car_graph must be valid");

    printf("  -> Loaded Knowledge Domains: %.0f (Expected: 6.0)\n", cg.header.num_domains);
    printf("  -> Loaded Total Rules: %.0f (Expected >= 42.0)\n", cg.header.num_rules);
    printf("  -> Strict Physical Invariants: %.0f (Expected >= 12.0)\n", cg.header.num_strict_rules);

    cartan_assert(cg.header.num_domains == 6.0, "TS-7.3: Must contain exactly 6 cognitive domains");
    cartan_assert(cg.header.num_rules >= 42.0, "TS-7.3: Must contain at least 42 structured rules");
    cartan_assert(cg.header.num_strict_rules >= 12.0, "TS-7.3: Must contain at least 12 strict invariants");

    let b_check = csr_builder_create(cg.header.num_rules);
    var r = 0.0;
    while (r < cg.header.num_rules - 1.0) {
        csr_builder_add_edge(b_check, r, r + 1.0, 1.0, 1.0, 0.0);
        r = r + 1.0;
    }
    let check_csr = csr_builder_build(b_check);
    let is_mono = cargraph_verify_csr_monotonicity(check_csr);
    cartan_assert(is_mono == 1.0, "TS-7.3: CSR row pointer offsets must be strictly monotonic");
    csr_graph_free(check_csr);
    csr_builder_free(b_check);
    cargraph_free(cg);
    printf("[PASS] TS-7.3: Multi-domain knowledge binary verified with strict CSR monotonicity.\n\n");

    // -------------------------------------------------------------------------
    // 4. TS-7.4: End-to-End Pipeline Loss Shaping & Latency Verification
    // -------------------------------------------------------------------------
    printf("[TS-7.4] Testing End-to-End NSES Pipeline Loss Shaping Execution...\n");
    let pipe = nses_pipeline_create(graph_path);
    let test_logits = cartan_vec_create();
    var ti = 0.0;
    while (ti < 2560.0) {
        cartan_vec_push_f32(test_logits, 1.50);
        ti = ti + 1.0;
    }

    let f_toks = cartan_vec_create();
    cartan_vec_push_f32(f_toks, 99.0);

    let t0 = clock();
    let pipe_penalty = nses_pipeline_shape_loss(pipe, 0.0, test_logits, f_toks, 1.0);
    let t1 = clock();
    let shape_latency_ms = t1 - t0;

    printf("  -> Pipeline Loss Shaping Latency: %.4f ms (Hard Gate: <= 0.50 ms)\n", shape_latency_ms);
    printf("  -> Pipeline Shaped Penalty: %.4f\n", pipe_penalty);

    cartan_assert(shape_latency_ms <= 0.50, "TS-7.4: Loss shaping latency must be <= 0.50 ms");
    cartan_assert(pipe_penalty > 0.0, "TS-7.4: Pipeline penalty must be positive");
    cartan_assert(cartan_vec_get_f32(test_logits, 99.0) <= -13.50, "TS-7.4: Forbidden token 99 logit must be penalized");

    cartan_vec_free(test_logits);
    cartan_vec_free(f_toks);
    nses_pipeline_free(pipe);
    printf("[PASS] TS-7.4: End-to-end pipeline loss shaping passed well within 0.50 ms budget.\n\n");

    printf("=================================================================================\n");
    printf("  ALL SPRINT 413 NSES LOSS SHAPING GATES PASSED (Exit Code: 0)\n");
    printf("=================================================================================\n");
    cartan_flush(0.0);
    return 0.0;
}
