// test/geomind/moe.car
// GeoMind Hardware-Autotuned 4x4 Freudenthal Mixture-of-Experts Engine

include "../../src/std/autotune.car";

struct MoEConfig {
    num_experts: float;
    top_k: float;
    hidden_dim: float;
}

fn geomind_moe_forward(cfg: MoEConfig, x: ptr) -> ptr {
    let tile = autotune_find_optimal_tile(cfg.hidden_dim, cfg.hidden_dim, cfg.hidden_dim, "FP16");
    let out = autotune_matmul_tiled(x, x, cfg.hidden_dim, cfg.hidden_dim, cfg.hidden_dim, tile);
    return out;
}
