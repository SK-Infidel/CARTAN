// test/compiler_suite/test_hopfield_buffer.car
// Verification Suite: Continuous Hopfield Episodic Memory Buffer & Attractor Dynamics

include "../../src/std/resonator.cl";
include "../../src/std/math.cl";
include "../../src/std/collections.cl";
include "../../src/std/string.cl";

extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn cartan_static_assert(cond: float, msg: string) -> float;
extern fn cartan_float_to_string(v: float) -> string;
extern fn cartan_tree_len_f(t: ptr) -> float;

fn main() -> float {
    printf("================================================================================\n");
    printf("  CARTAN TEST SUITE: CONTINUOUS HOPFIELD EPISODIC MEMORY BUFFER VERIFICATION\n");
    printf("================================================================================\n\n");

    let dim = 8.0;

    // [1/4] Attractor Bank Construction & Normalization
    printf("[1/4] Initializing Attractor Basin Bank and Registering Vectors...\n");
    let bank = resonator_create_attractor_bank();
    static_assert(bank != 0.0, "Attractor bank allocation must succeed");

    let v1 = cartan_vec_create();
    cartan_vec_push_f32(v1, 1.0);
    cartan_vec_push_f32(v1, 0.0);
    cartan_vec_push_f32(v1, 0.0);
    cartan_vec_push_f32(v1, 0.0);
    cartan_vec_push_f32(v1, 0.0);
    cartan_vec_push_f32(v1, 0.0);
    cartan_vec_push_f32(v1, 0.0);
    cartan_vec_push_f32(v1, 0.0);
    let count1 = resonator_add_attractor(bank, v1, dim);
    static_assert(count1 == 1.0, "First attractor insertion must yield bank count 1.0");

    let v2 = cartan_vec_create();
    cartan_vec_push_f32(v2, 0.0);
    cartan_vec_push_f32(v2, 1.0);
    cartan_vec_push_f32(v2, 0.0);
    cartan_vec_push_f32(v2, 0.0);
    cartan_vec_push_f32(v2, 0.0);
    cartan_vec_push_f32(v2, 0.0);
    cartan_vec_push_f32(v2, 0.0);
    cartan_vec_push_f32(v2, 0.0);
    let count2 = resonator_add_attractor(bank, v2, dim);
    static_assert(count2 == 2.0, "Second attractor insertion must yield bank count 2.0");
    printf("  Registered %s attractor basins in memory bank.\n", cartan_float_to_string(count2));
    printf("[1/4] Attractor Bank Construction assertions PASSED.\n\n");

    // [2/4] Continuous Hopfield Relaxation & Monotonic Energy Descent
    printf("[2/4] Evaluating Continuous Hopfield Relaxation & Energy Descent...\n");
    let query_s = cartan_vec_create();
    cartan_vec_push_f32(query_s, 0.85);
    cartan_vec_push_f32(query_s, 0.15);
    cartan_vec_push_f32(query_s, 0.05);
    cartan_vec_push_f32(query_s, 0.0);
    cartan_vec_push_f32(query_s, 0.0);
    cartan_vec_push_f32(query_s, 0.0);
    cartan_vec_push_f32(query_s, 0.0);
    cartan_vec_push_f32(query_s, 0.0);

    let e_init = resonator_compute_energy(bank, query_s, dim);
    printf("  Initial Unrelaxed Energy E(s_0): %s\n", cartan_float_to_string(e_init));

    let relax_res = resonator_continuous_hopfield_relax(bank, query_s, dim, 2.0, 4.0);
    static_assert(relax_res == 1.0, "Hopfield relaxation must return status 1.0");

    let s0_val = cartan_vec_get_f32(query_s, 0.0);
    printf("  Relaxed State Vector Component s[0]: %s (Attractor Basin Convergence)\n", cartan_float_to_string(s0_val));
    static_assert(s0_val >= 0.85, "State vector component 0 must converge toward attractor 1.0");

    let e_relaxed = resonator_compute_energy(bank, query_s, dim);
    printf("  Relaxed Attractor Energy E(s_relaxed): %s\n", cartan_float_to_string(e_relaxed));
    static_assert(e_relaxed <= e_init, "Relaxation must monotonically decrease or maintain energy");
    printf("[2/4] Continuous Hopfield Relaxation assertions PASSED.\n\n");

    // [3/4] Binary Attractor Basin File Serialization & Deserialization
    printf("[3/4] Verifying Binary Basin Persistence (Save/Load to Disk)...\n");
    let test_file = "scratch/test_hopfield_basins.bin";
    let saved_count = resonator_save_basins(bank, test_file, dim);
    static_assert(saved_count == 2.0, "Must save 2.0 attractor basins to binary file");

    let loaded_bank = resonator_load_basins(test_file, dim);
    static_assert(loaded_bank != 0.0, "Loading basins must return non-null attractor bank");
    let loaded_len = cartan_tree_len_f(loaded_bank);
    static_assert(loaded_len == 2.0, "Loaded bank must contain exactly 2.0 attractor basins");

    let e_loaded = resonator_compute_energy(loaded_bank, query_s, dim);
    let diff_e = math_abs_val(e_loaded - e_relaxed);
    static_assert(diff_e < 0.001, "Energy computed from loaded bank must match in-memory bank");
    printf("  Verified persistence: %s basins successfully saved and restored bit-for-bit.\n", cartan_float_to_string(loaded_len));
    printf("[3/4] Binary Persistence assertions PASSED.\n\n");

    // [4/4] O(1) One-Shot Attractor Basin Insertion Without Backprop
    printf("[4/4] Testing O(1) One-Shot Attractor Basin Insertion Without Backprop...\n");
    let v3 = cartan_vec_create();
    cartan_vec_push_f32(v3, 0.0);
    cartan_vec_push_f32(v3, 0.0);
    cartan_vec_push_f32(v3, 1.0);
    cartan_vec_push_f32(v3, 0.0);
    cartan_vec_push_f32(v3, 0.0);
    cartan_vec_push_f32(v3, 0.0);
    cartan_vec_push_f32(v3, 0.0);
    cartan_vec_push_f32(v3, 0.0);

    let count3 = resonator_add_attractor(loaded_bank, v3, dim);
    static_assert(count3 == 3.0, "One-shot insertion must immediately increment basin count to 3.0 in O(1)");

    let resaved_count = resonator_save_basins(loaded_bank, test_file, dim);
    static_assert(resaved_count == 3.0, "Resaved bank must contain 3.0 basins");
    printf("  Successfully inserted new basin in O(1) operations (Active Basins: %s).\n", cartan_float_to_string(resaved_count));
    printf("[4/4] O(1) One-Shot Insertion assertions PASSED.\n\n");

    printf("TEST_HOPFIELD_BUFFER_SUCCESS\n\n");
    cartan_flush(0.0);
    return 0.0;
}
