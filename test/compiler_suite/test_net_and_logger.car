// test/compiler_suite/test_net_and_logger.car
// Verification Suite: Authentic Berkeley/Winsock OS Sockets & Telemetry Logger

include "../../src/std/net.cl";
include "../geomind/logger.cl";

extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn cartan_static_assert(cond: float, msg: string) -> float;
extern fn cartan_string_contains(haystack: string, needle: string) -> float;
extern fn cartan_string_eq(s1: string, s2: string) -> float;

fn main() -> float {
    printf("================================================================================\n");
    printf("  CARTAN TEST SUITE: NETWORKING SOCKETS & TELEMETRY LOGGER VERIFICATION\n");
    printf("================================================================================\n\n");

    // Part 1: Verify Telemetry Logger
    printf("[1/2] Verifying GeoMind Telemetry Logger & Metric Formatter...\n");
    geomind_log_init();
    geomind_log_step(10.0, 100.0, 0.25, 4500.0, 0.98);

    let line = geomind_format_metrics(10.0, 100.0, 0.25, 4500.0, 0.98);
    let has_step = cartan_string_contains(line, "Step 10");
    let has_loss = cartan_string_contains(line, "Loss: 0.25");
    let has_tok = cartan_string_contains(line, "Tok/s: 4500");
    let has_phase = cartan_string_contains(line, "Phase Coherence: 0.98");

    static_assert(has_step != 0.0, "Telemetry line must include Step");
    static_assert(has_loss != 0.0, "Telemetry line must include Loss");
    static_assert(has_tok != 0.0, "Telemetry line must include Tok/s");
    static_assert(has_phase != 0.0, "Telemetry line must include Phase Coherence");
    printf("[1/2] Logger assertions PASSED.\n\n");

    // Part 2: Verify Authentic OS Loopback TCP Sockets
    printf("[2/2] Verifying Authentic Berkeley/Winsock Loopback TCP Sockets...\n");
    let server = net_socket();
    static_assert(server > 0.0, "Server socket creation must return valid positive descriptor");

    net_set_timeout(server, 3000.0);

    let test_port = 31415.0;
    let b_res = net_bind(server, "127.0.0.1", test_port);
    static_assert(b_res == 1.0, "Server bind to 127.0.0.1:31415 must succeed");

    let l_res = net_listen(server, 5.0);
    static_assert(l_res == 1.0, "Server listen must succeed");

    let client = net_socket();
    static_assert(client > 0.0, "Client socket creation must return valid positive descriptor");
    net_set_timeout(client, 3000.0);

    let c_res = net_connect(client, "127.0.0.1", test_port);
    static_assert(c_res == 1.0, "Client connect to 127.0.0.1:31415 must succeed");

    let peer = net_accept(server);
    static_assert(peer > 0.0, "Server accept must return valid peer socket");
    net_set_timeout(peer, 3000.0);

    let msg_to_server = "CARTAN_TCP_SYN";
    let sent_bytes = net_send(client, msg_to_server);
    static_assert(sent_bytes == 14.0, "Client send must transmit 14 bytes");

    let recvd_at_server = net_recv(peer);
    printf("  [TCP Server Recv]: ");
    printf(recvd_at_server);
    printf("\n");
    let match_msg = cartan_string_eq(recvd_at_server, msg_to_server);
    static_assert(match_msg != 0.0, "Server received payload must match client transmission");

    let msg_to_client = "CARTAN_TCP_ACK";
    let reply_bytes = net_send(peer, msg_to_client);
    static_assert(reply_bytes == 14.0, "Server send must transmit 14 bytes");

    let recvd_at_client = net_recv(client);
    printf("  [TCP Client Recv]: ");
    printf(recvd_at_client);
    printf("\n");
    let match_reply = cartan_string_eq(recvd_at_client, msg_to_client);
    static_assert(match_reply != 0.0, "Client received payload must match server reply");

    net_close(peer);
    net_close(client);
    net_close(server);

    printf("[2/2] Authentic Loopback TCP Socket exchange PASSED.\n\n");
    printf("TEST_NET_AND_LOGGER_SUCCESS\n");
    return 0.0;
}
