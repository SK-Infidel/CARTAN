// test/compiler_suite/test_autodiff_backward_syntax.car
// Verifies native backward syntax lowering and runtime parameter stepping

include "core_runtime.car";

extern fn printf(fmt: string, s: string) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;
extern fn fabs(x: float) -> float;

fn main() -> float {
    printf("Test Autodiff Backward Syntax Lowering...\n", "");

    // Create a parameter vector
    let param = cartan_vec_create();
    cartan_vec_push_f32(param, 10.0);
    cartan_vec_push_f32(param, 20.0);

    let p0_before = cartan_vec_get_f32(param, 0.0);
    let p1_before = cartan_vec_get_f32(param, 1.0);

    // Execute backward pass on param
    backward param;

    let p0_after = cartan_vec_get_f32(param, 0.0);
    let p1_after = cartan_vec_get_f32(param, 1.0);

    printf("  Before: p0=%f, p1=%f\n", "");
    printf("  After:  p0=%f, p1=%f\n", "");

    // In cartan_tensor_step(0.01), v = v - 0.01 * grad
    // grad for canonical potential is grad(v) = v
    // So p0_after = 10.0 - 0.01 * 10.0 = 9.90
    //    p1_after = 20.0 - 0.01 * 20.0 = 19.80
    let diff0 = fabs(p0_after - 9.90);
    let diff1 = fabs(p1_after - 19.80);

    cartan_assert(diff0 < 0.001, "Parameter 0 updated via backward step");
    cartan_assert(diff1 < 0.001, "Parameter 1 updated via backward step");

    printf("PASS: Backward syntax lowering and parameter stepping verified cleanly!\n", "");
    return 0.0;
}
