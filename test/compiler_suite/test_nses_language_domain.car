// Target 71: NSES Language & Discourse Domain 6 Synthesis and Veto Verification
// Empirical regression test verifying 7-domain .car_graph loading, Stage 1 language routing,
// Stage 4 CSR memory retrieval, and linguistic veto gate enforcement.

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";
include "src/std/guardrails.cl";
include "src/std/csr_graph.cl";
include "src/std/plasticity.cl";
include "src/std/burroughs.cl";
include "src/std/prompt_scaffold.cl";
include "src/std/veto_gate.cl";
include "src/std/nses_pipeline.cl";

extern fn printf(fmt: string) -> i32;
extern fn exit(code: float) -> void;

fn main() -> float {
    printf("=====================================================================\n");
    printf("  Target 71: NSES Language & Discourse Domain 6 Verification\n");
    printf("=====================================================================\n\n");

    let graph_path = "test/geomind/trainingdata/nses_knowledge.car_graph";

    // 1. Verify 7-Domain Flat Binary Header
    let cg = cargraph_load_binary(graph_path);
    if (cg.is_valid == 0.0) {
        printf("FAILED: cargraph_load_binary failed to load graph\n");
        exit(1.0);
    }
    printf("Graph loaded successfully. Total bytes: %.0f\n", cg.header.file_size);
    printf("Active Domains: %.0f (expected 7.0)\n", cg.header.num_domains);
    printf("Total Rules: %.0f (expected 52.0)\n", cg.header.num_rules);
    printf("Strict Invariants: %.0f (expected 14.0)\n", cg.header.num_strict_rules);

    if (cg.header.num_domains != 7.0) {
        printf("FAILED: Expected 7.0 domains, got %.0f\n", cg.header.num_domains);
        exit(1.0);
    }
    if (cg.header.num_rules != 52.0) {
        printf("FAILED: Expected 52.0 rules, got %.0f\n", cg.header.num_rules);
        exit(1.0);
    }
    if (cg.header.num_strict_rules != 14.0) {
        printf("FAILED: Expected 14.0 strict rules, got %.0f\n", cg.header.num_strict_rules);
        exit(1.0);
    }

    // 2. Initialize NSES Master Pipeline
    let pipe = nses_pipeline_create(graph_path);
    if (pipe.is_ready == 0.0) {
        printf("FAILED: NSES Pipeline failed to initialize\n");
        exit(1.0);
    }
    printf("[PASS] NSES Pipeline initialized with Domain 6 topology.\n\n");

    // 3. Stage 1 Domain Routing & Stage 4 Memory Traversal Test
    let query = "What are the communicative rules of speech dialogue and language?";
    let turn = nses_pipeline_execute_turn(pipe, query, 1.0, "");

    printf("Query: %s\n", query);
    printf("Routed Domain: %.0f (expected 6.0 for LANGUAGE_DISCOURSE)\n", turn.active_domain);
    printf("Memory Nodes Traversed: %.0f\n", turn.traversed_count);

    if (turn.active_domain != 6.0) {
        printf("FAILED: Expected routed domain 6.0, got %.0f\n", turn.active_domain);
        exit(1.0);
    }
    if (turn.traversed_count <= 0.0) {
        printf("FAILED: Expected positive traversed count, got %.0f\n", turn.traversed_count);
        exit(1.0);
    }

    // Verify memory tree contains language rules
    let mem_len = cartan_tree_len_f(pipe.memory_tree);
    printf("Memory Tree Elements: %.0f\n", mem_len);
    if (mem_len <= 0.0) {
        printf("FAILED: Memory tree is empty after traversal\n");
        exit(1.0);
    }
    let mem_sample = cartan_tree_get_f32(pipe.memory_tree, 0.0);
    printf("Traversed Memory Node 0: %s\n\n", mem_sample);

    // 4. Test Deterministic Linguistic Veto Gate
    let bad_text = "The system asserts that words have no meaning and questions do not require answers.";
    let veto_res = veto_gate_scan(pipe.veto_reg, bad_text);

    printf("Testing Veto Gate with contradictory statement: '%s'\n", bad_text);
    printf("is_vetoed: %.0f (expected 1.0)\n", veto_res.is_vetoed);
    printf("violated_rule_id: %.0f (expected 8.0)\n", veto_res.violated_rule_id);
    printf("violation_pattern: '%s'\n", veto_res.violation_pattern);
    printf("Canonical Assertion: %s\n\n", veto_res.output_text);

    if (veto_res.is_vetoed != 1.0) {
        printf("FAILED: Expected veto gate to fire on linguistic contradiction\n");
        exit(1.0);
    }
    if (veto_res.violated_rule_id != 8.0) {
        printf("FAILED: Expected violated_rule_id == 8.0, got %.0f\n", veto_res.violated_rule_id);
        exit(1.0);
    }

    // 5. Test Clean Text Passes Through Veto Gate Cleanly
    let clean_text = "Human communication relies on syntactic grammar, shared semantics, and cooperative discourse.";
    let clean_res = veto_gate_scan(pipe.veto_reg, clean_text);
    if (clean_res.is_vetoed != 0.0) {
        printf("FAILED: Clean text was improperly vetoed!\n");
        exit(1.0);
    }
    printf("[PASS] Clean linguistic assertion passed through veto gate without suppression.\n\n");

    // Clean up
    nses_pipeline_free(pipe);

    printf("=====================================================================\n");
    printf("[PASS] Target 71: NSES Language Domain 6 & Pragmatic Invariants Verified Cleanly.\n");
    printf("=====================================================================\n");
    return 0.0;
}
