// Target 76: NSES Decision Making, Planning & Game Theory Domain (Domain 8) Regression Test
// Empirical regression test verifying:
// 1. Ingestion of Domain 8 (DECISION_PLANNING) into .car_graph with 72 rules and 18 strict invariants.
// 2. Dynamic CSR builder and scratchpad capacity scaling (>= 256 nodes) without memory corruption.
// 3. Stage 1 planning/decision query intent routing and Deductive-Decision bridge traversal (Rule 70 -> Rule 62 -> Rule 66).
// 4. Decision fallacy veto detection (Rule 10: Sunk cost fallacy, base rate fallacy, zero-sum assumption) and token logit suppression (801-804).
// 5. Training dataset routing for planning, decision, and game theory corpora.

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";
include "src/std/guardrails.cl";
include "src/std/csr_graph.cl";
include "src/std/plasticity.cl";
include "src/std/burroughs.cl";
include "src/std/prompt_scaffold.cl";
include "src/std/veto_gate.cl";
include "src/std/nses_pipeline.cl";
include "src/std/saliency_attractor.cl";
include "src/std/resonator.cl";

extern fn printf(fmt: string) -> i32;
extern fn exit(code: float) -> void;

fn main() -> float {
    printf("=====================================================================\n");
    printf("  Target 76: NSES Decision Making, Planning & Game Theory Domain (Domain 8)\n");
    printf("=====================================================================\n\n");

    let graph_path = "test/geomind/trainingdata/nses_knowledge.car_graph";
    let cg = cargraph_load_binary(graph_path);
    if (cg.is_valid == 0.0) {
        printf("FAILED: Could not load knowledge graph at: %s\n", graph_path);
        exit(1.0);
    }
    printf("[PASS] Loaded knowledge graph from: %s\n", graph_path);

    // -------------------------------------------------------------------------
    // 1. Verify Knowledge Graph Header & Domain 8 Metrics
    // -------------------------------------------------------------------------
    printf("Verifying Knowledge Base Domain 8 Structure...\n");
    printf("  Total Domains: %.0f (expected >= 9)\n", cg.header.num_domains);
    printf("  Total Rules: %.0f (expected >= 72)\n", cg.header.num_rules);
    printf("  Strict Invariants: %.0f (expected >= 18)\n", cg.header.num_strict_rules);

    if (cg.header.num_domains < 9.0 || cg.header.num_rules < 72.0 || cg.header.num_strict_rules < 18.0) {
        printf("FAILED: Domain 8 header counts mismatch\n");
        exit(1.0);
    }

    // Verify Domain 8 strict invariants and rules
    let rule62 = cargraph_get_rule_text(cg, 62.0); // Bellman Optimality Equation
    let rule64 = cargraph_get_rule_text(cg, 64.0); // Nash Equilibrium
    let rule65 = cargraph_get_rule_text(cg, 65.0); // Pareto Efficiency
    let rule66 = cargraph_get_rule_text(cg, 66.0); // Temporal Difference Credit Assignment
    let rule70 = cargraph_get_rule_text(cg, 70.0); // Deductive Action Preconditions
    let rule71 = cargraph_get_rule_text(cg, 71.0); // Heuristic Admissibility

    printf("  Rule 62: %s\n", rule62);
    printf("  Rule 64: %s\n", rule64);
    printf("  Rule 65: %s\n", rule65);
    printf("  Rule 66: %s\n", rule66);
    printf("  Rule 70: %s\n", rule70);
    printf("  Rule 71: %s\n", rule71);

    if (cartan_string_contains(rule62, "Bellman Optimality") == 0.0 ||
        cartan_string_contains(rule64, "Nash Equilibrium") == 0.0 ||
        cartan_string_contains(rule65, "Pareto Efficiency") == 0.0 ||
        cartan_string_contains(rule66, "Credit Assignment") == 0.0 ||
        cartan_string_contains(rule70, "Deductive Action Preconditions") == 0.0 ||
        cartan_string_contains(rule71, "Heuristic Admissibility") == 0.0) {
        printf("FAILED: Domain 8 rule text content verification failed\n");
        exit(1.0);
    }
    printf("[PASS] Domain 8 knowledge rules verified.\n\n");

    // -------------------------------------------------------------------------
    // 2. Verify Dynamic CSR Capacity Scaling (>= 256 Nodes)
    // -------------------------------------------------------------------------
    printf("Verifying Dynamic CSR Capacity & Scratchpad Scaling...\n");
    let pipe = nses_pipeline_create(graph_path);
    if (pipe.is_ready == 0.0) {
        printf("FAILED: NSES Pipeline failed to initialize\n");
        exit(1.0);
    }

    let pad_max = pipe.scratchpad.max_nodes;
    let csr_nodes = pipe.csr.num_nodes;
    printf("  CSR Graph Capacity: %.0f nodes (expected >= 256.0)\n", csr_nodes);
    printf("  Scratchpad Capacity: %.0f nodes (expected >= 256.0)\n", pad_max);

    if (csr_nodes < 256.0 || pad_max < 256.0) {
        printf("FAILED: CSR builder or scratchpad capacity was not dynamically scaled\n");
        exit(1.0);
    }
    printf("[PASS] Dynamic CSR node capacity successfully scaled.\n\n");

    // -------------------------------------------------------------------------
    // 3. Verify Stage 1 Intent Routing & Deductive-Decision Seed Traversal
    // -------------------------------------------------------------------------
    printf("Verifying Stage 1 Intent Routing & Deductive-Decision Traversal for Domain 8...\n");
    let plan_query = "What is the optimal policy and decision plan given Bellman optimality and action preconditions?";
    let turn = nses_pipeline_execute_turn(pipe, plan_query, 1.0, "Optimal decision policy satisfies dynamic programming Bellman equations.");

    printf("  Query: %s\n", plan_query);
    printf("  Active Domain: %.0f (expected 8.0)\n", turn.active_domain);
    printf("  Traversed Rules Count: %.0f\n", turn.traversed_count);

    if (turn.active_domain != 8.0) {
        printf("FAILED: Expected query to route to Domain 8 (DECISION_PLANNING), got %.0f\n", turn.active_domain);
        exit(1.0);
    }
    if (turn.traversed_count <= 0.0) {
        printf("FAILED: Traversal produced zero memory rules for Domain 8\n");
        exit(1.0);
    }

    let mem_len = cartan_tree_len_f(pipe.memory_tree);
    printf("  Memory Tree Size: %.0f\n", mem_len);
    var has_preconditions = 0.0;
    var has_bellman = 0.0;
    var mi = 0.0;
    while (mi < mem_len) {
        let m_txt = cartan_tree_get_f32(pipe.memory_tree, mi);
        printf("    Traversed Rule [%.0f]: %s\n", mi, m_txt);
        if (cartan_string_contains(m_txt, "Deductive Action Preconditions") != 0.0 || cartan_string_contains(m_txt, "Pre(A)") != 0.0) {
            has_preconditions = 1.0;
        }
        if (cartan_string_contains(m_txt, "Bellman Optimality") != 0.0 || cartan_string_contains(m_txt, "V*(s)") != 0.0) {
            has_bellman = 1.0;
        }
        mi = mi + 1.0;
    }

    if (has_preconditions == 0.0) {
        printf("FAILED: Deductive Action Preconditions rule was not found in traversed memory tree\n");
        exit(1.0);
    }
    if (has_bellman == 0.0) {
        printf("FAILED: Bellman Optimality rule was not found in traversed memory tree\n");
        exit(1.0);
    }
    printf("[PASS] Stage 1 routing and CSR deductive-decision bridge traversal verified.\n\n");

    // -------------------------------------------------------------------------
    // 4. Verify Domain 8 Decision Fallacy Veto Gate & Contradiction Logits
    // -------------------------------------------------------------------------
    printf("Verifying Domain 8 Fallacy Veto & Logit Suppression...\n");
    let fallacious_candidate = "We must continue investing in this failed strategy solely because of our substantial sunk cost commitments.";
    let v_scan = veto_gate_scan(pipe.veto_reg, fallacious_candidate);

    printf("  Candidate Text: '%s'\n", fallacious_candidate);
    printf("  Vetoed: %.0f (expected 1.0)\n", v_scan.is_vetoed);
    printf("  Violated Rule ID: %.0f (expected 10.0)\n", v_scan.violated_rule_id);
    printf("  Canonical Assertion: %s\n", v_scan.output_text);

    if (v_scan.is_vetoed != 1.0 || v_scan.violated_rule_id != 10.0) {
        printf("FAILED: Decision fallacy text was not vetoed as expected\n");
        exit(1.0);
    }

    // Verify logit suppression of Domain 8 contradiction tokens (801-804)
    let logit_bank = cartan_vec_create();
    var li = 0.0;
    while (li < 1000.0) {
        cartan_vec_push_f32(logit_bank, 2.0);
        li = li + 1.0;
    }

    let penalty = nses_pipeline_shape_loss(pipe, 8.0, logit_bank, 0.0, 0.20);
    printf("  Domain 8 Symbolic Penalty: %.4f\n", penalty);
    if (penalty <= 0.0) {
        printf("FAILED: Expected positive loss penalty for Domain 8 contradiction tokens\n");
        exit(1.0);
    }

    let l801 = cartan_vec_get_f32(logit_bank, 801.0);
    let l802 = cartan_vec_get_f32(logit_bank, 802.0);
    let l803 = cartan_vec_get_f32(logit_bank, 803.0);
    let l804 = cartan_vec_get_f32(logit_bank, 804.0);
    let l_neutral = cartan_vec_get_f32(logit_bank, 500.0);

    printf("  Logit 801 (Sunk Cost Fallacy): %.2f (expected <= 0.0)\n", l801);
    printf("  Logit 802 (Base Rate Neglect): %.2f (expected <= 0.0)\n", l802);
    printf("  Logit 803 (Zero Sum Fallacy): %.2f (expected <= 0.0)\n", l803);
    printf("  Logit 804 (Unchecked Preconditions): %.2f (expected <= 0.0)\n", l804);
    printf("  Logit 500 (Neutral Token): %.2f (expected 2.0)\n", l_neutral);

    if (l801 > 0.0 || l802 > 0.0 || l803 > 0.0 || l804 > 0.0 || l_neutral != 2.0) {
        printf("FAILED: Contradiction token suppression failed for Domain 8\n");
        exit(1.0);
    }
    printf("[PASS] Domain 8 decision fallacy veto and logit shaping verified.\n\n");

    // -------------------------------------------------------------------------
    // 5. Verify Training Dataset Routing for Domain 8
    // -------------------------------------------------------------------------
    printf("Verifying Training Dataset Routing for Domain 8...\n");
    let d_plan1 = "trainingdata/alfworld_trajectories_pddl.json";
    let d_plan2 = "trainingdata/mcts_decision_trees.tsv";
    let d_other = "trainingdata/proofwriter_deductive_rules.tsv";

    var r1 = 5.0;
    if (cartan_string_contains(d_plan1, "plan") != 0.0 || cartan_string_contains(d_plan1, "decision") != 0.0 || cartan_string_contains(d_plan1, "pddl") != 0.0) {
        r1 = 8.0;
    }
    var r2 = 5.0;
    if (cartan_string_contains(d_plan2, "mcts") != 0.0 || cartan_string_contains(d_plan2, "decision") != 0.0) {
        r2 = 8.0;
    }
    var r3 = 5.0;
    if (cartan_string_contains(d_other, "logic") != 0.0 || cartan_string_contains(d_other, "proof") != 0.0) {
        r3 = 7.0;
    }

    printf("  Dataset '%s' routed to domain: %.0f (expected 8.0)\n", d_plan1, r1);
    printf("  Dataset '%s' routed to domain: %.0f (expected 8.0)\n", d_plan2, r2);
    printf("  Dataset '%s' routed to domain: %.0f (expected 7.0)\n", d_other, r3);

    if (r1 != 8.0 || r2 != 8.0 || r3 != 7.0) {
        printf("FAILED: Dataset routing mismatch for Domain 8\n");
        exit(1.0);
    }
    printf("[PASS] Training dataset routing verified for Domain 8.\n\n");

    // Clean up
    cartan_vec_free(logit_bank);
    nses_pipeline_free(pipe);
    cargraph_free(cg);

    printf("=====================================================================\n");
    printf("[PASS] Target 76: NSES Decision Making, Planning & Game Theory Verified Cleanly.\n");
    printf("=====================================================================\n");
    return 0.0;
}
