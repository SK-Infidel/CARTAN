    // [8/9] Positive test: test_static_assert
    let t8_cmd = "cartanc.exe build test/compiler_suite/test_static_assert.car -o test_static_assert.exe";
    printf("[8/9] [// run-pass] Building Toolchain & static_assert Test: %s\n", t8_cmd);
    cartan_flush(0.0);
    system(t8_cmd);

    // [9/10] Positive test: test_comptime_autograd
    let t9_cmd = "cartanc.exe build test/compiler_suite/test_comptime_autograd.car -o test_comptime_autograd.exe";
    printf("[9/10] [// run-pass] Building Comptime & Static Autograd Test: %s\n", t9_cmd);
    cartan_flush(0.0);
    system(t9_cmd);

    // [10/11] Positive test: test_stdlib
    let t10_cmd = "cartanc.exe build test/compiler_suite/test_stdlib.car -o test_stdlib.exe";
    printf("[10/11] [// run-pass] Building Standard Libraries & Assertions Test: %s\n", t10_cmd);
    cartan_flush(0.0);
