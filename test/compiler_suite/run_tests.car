    cartan_flush(0.0);
    system(t15_cmd);

    // [16/17] Positive test: test_jit_engine
    let t16_cmd = "cartanc.exe run test/compiler_suite/test_jit_engine.car";
    printf("[16/17] [// run-pass] Executing In-Memory JIT Engine Test: %s\n", t16_cmd);
    cartan_flush(0.0);
