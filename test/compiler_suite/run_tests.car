// test/compiler_suite/run_tests.car
// CARTAN Automated Compiler Regression Test Runner

include "../../src/cartanc/ast.ch";

extern fn printf(fmt: string, val: string) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn system(cmd: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("====================================================\n", "");
    printf(" CARTAN Automated Compiler Test Runner (Sprint 5)\n", "");
    printf("====================================================\n\n", "");
    cartan_flush(0.0);

    // [1/4] Positive test: test_primitives
    let t1_cmd = "cartanc.exe build test/compiler_suite/test_primitives.car -o build/test_primitives.exe";
    printf("[1/4] [// run-pass] Building Primitives Test: %s\n", t1_cmd);
    cartan_flush(0.0);
    system(t1_cmd);

    // [2/4] Positive test: test_enums
    let t2_cmd = "cartanc.exe build test/compiler_suite/test_enums.car -o build/test_enums.exe";
    printf("[2/4] [// run-pass] Building Enums & Bit-Cast Test: %s\n", t2_cmd);
    cartan_flush(0.0);
    system(t2_cmd);

    // [3/4] Positive test: test_modules
    let t3_cmd = "cartanc.exe build test/compiler_suite/test_modules.car -o build/test_modules.exe";
    printf("[3/4] [// run-pass] Building Module System Test: %s\n", t3_cmd);
    cartan_flush(0.0);
    system(t3_cmd);

    // [4/5] Negative test: test_fail_syntax
