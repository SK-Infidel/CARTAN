    cartan_flush(0.0);
    system(t5_cmd);

    // [6/7] Positive test: test_dlpack_slicing
    let t6_cmd = "cartanc.exe build test/compiler_suite/test_dlpack_slicing.car -o test_dlpack_slicing.exe";
    printf("[6/7] [// run-pass] Building DLPack & ND Slicing Test: %s\n", t6_cmd);
    cartan_flush(0.0);
    system(t6_cmd);

    // [7/8] Positive test: test_security_sandboxing
    let t7_cmd = "cartanc.exe build test/compiler_suite/test_security_sandboxing.car -o test_security_sandboxing.exe";
    printf("[7/8] [// run-pass] Building Security & VRAM Sandboxing Test: %s\n", t7_cmd);
    cartan_flush(0.0);
