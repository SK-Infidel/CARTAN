    // [26/27] Positive test: test_framework_layer2
    let t26_cmd = "cartanc.exe build test/compiler_suite/test_framework_layer2.car -o build/test_framework_layer2.exe";
    printf("[26/27] [// run-pass] Building Layer 2 Framework (NN, Attention, Vision) Test: %s\n", t26_cmd);
    cartan_flush(0.0);
    system(t26_cmd);

    // [27/27] Positive test: test_repl
    let t27_cmd = "cartanc.exe repl";
    printf("[27/27] [// run-pass] Executing Interactive REPL Test: %s\n", t27_cmd);
    cartan_flush(0.0);
    system(t27_cmd);

    printf("\nAll 27 compiler snapshot test targets executed!\n", "");
    return 0.0;
