    // [17/18] Positive test: test_generics
    let t17_cmd = "cartanc.exe build test/compiler_suite/test_generics.car -o test_generics.exe";
    printf("[17/18] [// run-pass] Building Generic Collections & Monomorphization Test: %s\n", t17_cmd);
