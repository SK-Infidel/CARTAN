    // [12/13] Positive test: test_tensor_opt
    let t12_cmd = "cartanc.exe build test/compiler_suite/test_tensor_opt.car -o test_tensor_opt.exe";
    printf("[12/13] [// run-pass] Building Tensor Reductions & Activations Test: %s\n", t12_cmd);
    cartan_flush(0.0);
    system(t12_cmd);

    // [13/13] Positive test: test_optimizer
    let t13_cmd = "cartanc.exe build test/compiler_suite/test_optimizer.car -o test_optimizer.exe";
    printf("[13/14] [// run-pass] Building AST Constant Folding & Optimizer Test: %s\n", t13_cmd);
