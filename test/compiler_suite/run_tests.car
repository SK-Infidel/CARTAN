    cartan_flush(0.0);
    system(t24_cmd);

    // [25/26] Positive test: test_collections_ingest_env
    let t25_cmd = "cartanc.exe build test/compiler_suite/test_collections_ingest_env.car -o build/test_collections_ingest_env.exe";
    printf("[25/26] [// run-pass] Building Collections, Ingest & Env Test: %s\n", t25_cmd);
    cartan_flush(0.0);
