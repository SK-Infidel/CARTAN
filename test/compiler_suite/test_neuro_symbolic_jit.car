// test/compiler_suite/test_neuro_symbolic_jit.car
// CARTAN Regression Target 69: Neuro-Symbolic Declarations, JIT & DataFrame Lowering

include "core_runtime.car";

extern fn printf(fmt: string, s: string) -> float;
extern fn fabs(x: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;

fn assert_approx(val: float, expected: float, tol: float, msg: string) -> void {
    let diff = fabs(val - expected);
    if (diff > tol) {
        printf("[FAIL] %s: Expected approx ", msg);
        printf("%f, got ", "");
        printf("%f\n", "");
        cartan_assert(0.0, msg);
    }
}

fn assert_true(cond: float, msg: string) -> void {
    if (cond == 0.0) {
        printf("[FAIL] Assertion failed: %s\n", msg);
        cartan_assert(0.0, msg);
    }
}

fn main() -> float {
    printf("====================================================================\n", "");
    printf(" CARTAN Regression Target 69: Neuro-Symbolic Declarations & JIT     \n", "");
    printf("====================================================================\n\n", "");

    // -------------------------------------------------------------
    // Test 1: Native jit Block Execution and Lowering
    // -------------------------------------------------------------
    printf("Test 1: Native jit Block Execution...\n", "");
    var jit_accumulator = 100.0;
    var jit_factor = 2.5;

    jit {
        var local_step = jit_factor * 8.0;
        jit_accumulator = jit_accumulator + local_step;
    }

    assert_approx(jit_accumulator, 120.0, 0.0001, "Jit block statements must compute and update state");
    printf("  PASS: Native jit block execution verified (jit_accumulator = 120.0)\n", "");

    // -------------------------------------------------------------
    // Test 2: Native dataframe Block Lowering
    // -------------------------------------------------------------
    printf("Test 2: Native dataframe Block Lowering...\n", "");
    var df_col_sum = 0.0;
    var df_row_count = 10.0;

    dataframe SensorData {
        var base_reading = 4.2;
        df_col_sum = df_col_sum + (base_reading * df_row_count);
    }

    assert_approx(df_col_sum, 42.0, 0.0001, "Dataframe block statements must evaluate column and row operations");
    printf("  PASS: Native dataframe block execution verified (df_col_sum = 42.0)\n", "");

    // -------------------------------------------------------------
    // Test 3: Native graph Block Lowering
    // -------------------------------------------------------------
    printf("Test 3: Native graph Block Lowering...\n", "");
    var graph_nodes = 5.0;
    var graph_edges = 0.0;

    graph KnowledgeGraph {
        // Complete directed graph edges: N * (N - 1)
        graph_edges = graph_nodes * (graph_nodes - 1.0);
    }

    assert_approx(graph_edges, 20.0, 0.0001, "Graph block statements must evaluate graph topology metrics");
    printf("  PASS: Native graph block execution verified (graph_edges = 20.0)\n", "");

    // -------------------------------------------------------------
    // Test 4: Native rule Declaration and Variable Resolution
    // -------------------------------------------------------------
    printf("Test 4: Native rule Declaration and Variable Resolution...\n", "");
    var threshold = 75.0;
    var current_metric = 88.0;

    rule IsAnomaly = current_metric > threshold;
    assert_approx(IsAnomaly, 1.0, 0.0001, "Rule declaration must evaluate expression and bind result");

    rule AnomalyDelta = current_metric - threshold;
    assert_approx(AnomalyDelta, 13.0, 0.0001, "Rule declaration must compute arithmetic expression");
    printf("  PASS: Native rule declarations verified (IsAnomaly = 1.0, AnomalyDelta = 13.0)\n", "");

    // -------------------------------------------------------------
    // Test 5: Native knowledge_base Block Lowering
    // -------------------------------------------------------------
    printf("Test 5: Native knowledge_base Block Lowering...\n", "");
    var kb_rules_evaluated = 0.0;
    var kb_confidence = 0.0;

    knowledge_base MedicalDiagnosticKB {
        rule FeverScore = 38.5;
        rule SepsisThreshold = 38.0;
        var diff = FeverScore - SepsisThreshold;
        if (diff > 0.0) {
            kb_confidence = 0.95;
            kb_rules_evaluated = kb_rules_evaluated + 1.0;
        }
    }

    assert_approx(kb_rules_evaluated, 1.0, 0.0001, "KnowledgeBase block must evaluate embedded rules and logic");
    assert_approx(kb_confidence, 0.95, 0.0001, "KnowledgeBase block must set confidence score");
    printf("  PASS: Native knowledge_base block verified (kb_confidence = 0.95)\n", "");

    printf("\n>>> Target 69: All Neuro-Symbolic & JIT Assertions Passed! <<<\n\n", "");
    return 0.0;
}
