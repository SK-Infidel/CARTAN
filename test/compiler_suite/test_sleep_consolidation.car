// test/compiler_suite/test_sleep_consolidation.car
// Verification Suite: Autonomous Metacognitive Sleep Daemon & Generative Attractor Consolidation

include "../../src/std/sleep.cl";
include "../../src/std/math.cl";
include "../../src/std/collections.cl";
include "../../src/std/string.cl";

extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn cartan_float_to_string(v: float) -> string;
extern fn cartan_sleep_consolidate_cycle(filepath: string, lr: float, thresh: float) -> float;

fn main() -> float {
    printf("=================================================================================\n");
    printf("  CARTAN TEST SUITE: AUTONOMOUS METACOGNITIVE SLEEP CONSOLIDATION VERIFICATION\n");
    printf("=================================================================================\n\n");

    let dim = 8.0;

    // [1/5] Generative Attractor Replay & Resonance Evaluation
    printf("[1/5] Verifying Generative Attractor Replay & Resonance...\n");
    let basin1 = cartan_tensor_alloc(dim);
    var d = 0.0;
    while (d < dim) {
        cartan_vec_set_f32(basin1, d, (d + 1.0) * 0.1);
        d = d + 1.0;
    }
    // Unit normalize basin1
    var b_norm = 0.0;
    d = 0.0;
    while (d < dim) {
        let val = cartan_vec_get_f32(basin1, d);
        b_norm = b_norm + (val * val);
        d = d + 1.0;
    }
    let inv_b = 1.0 / math_sqrt(b_norm);
    d = 0.0;
    while (d < dim) {
        let val = cartan_vec_get_f32(basin1, d);
        cartan_vec_set_f32(basin1, d, val * inv_b);
        d = d + 1.0;
    }

    let replay1 = sleep_replay_basin(basin1, dim, 0.01, 2.0, 3.0);
    let rho = sleep_compute_resonance(basin1, replay1, dim);
    printf("  Generative replay trajectory resonance rho = %s\n", cartan_float_to_string(rho));
    cartan_assert(rho > 0.85, "Reconstruction resonance between basin and generative replay must exceed 0.85");
    printf("[1/5] Generative Attractor Replay assertions PASSED.\n\n");

    // [2/5] Hebbian Slow-Weight Consolidation
    printf("[2/5] Verifying Hebbian Slow-Weight Consolidation...\n");
    let hebb_status = sleep_consolidate_slow_weights(basin1, replay1, 0.001);
    cartan_assert(hebb_status == 1.0, "Hebbian slow-weight consolidation must return status 1.0");
    printf("  Synaptic slow-weight Hebbian consolidation verified (Status: %s)\n", cartan_float_to_string(hebb_status));
    printf("[2/5] Hebbian Slow-Weight Consolidation assertions PASSED.\n\n");

    // [3/5] Redundant Attractor Pruning & Compaction
    printf("[3/5] Verifying Redundant Attractor Basin Pruning & Compaction...\n");
    cartan_hopfield_clear();

    // Store primary attractor
    cartan_hopfield_store_hidden(basin1);

    // Create and store near-identical duplicate attractor (cosine similarity > 0.99)
    let basin_dup = cartan_tensor_alloc(dim);
    d = 0.0;
    while (d < dim) {
        let val = cartan_vec_get_f32(basin1, d);
        cartan_vec_set_f32(basin_dup, d, val + 0.0001);
        d = d + 1.0;
    }
    cartan_hopfield_store_hidden(basin_dup);

    // Create and store distinct orthogonal attractor
    let basin_ortho = cartan_tensor_alloc(dim);
    d = 0.0;
    while (d < dim) {
        if (d == 0.0) {
            cartan_vec_set_f32(basin_ortho, d, 1.0);
        } else {
            cartan_vec_set_f32(basin_ortho, d, 0.0);
        }
        d = d + 1.0;
    }
    cartan_hopfield_store_hidden(basin_ortho);

    let pre_sleep_count = cartan_hopfield_attractor_count();
    cartan_assert(pre_sleep_count == 3.0, "Pre-sleep memory bank must contain 3 attractors");
    printf("  Pre-sleep active attractors: %s\n", cartan_float_to_string(pre_sleep_count));

    // Save to test file
    let test_file = "scratch/test_sleep_basins.bin";
    cartan_hopfield_save_basins(test_file);

    // Run consolidation cycle with redundancy threshold 0.98
    let post_sleep_count = cartan_sleep_consolidate_cycle(test_file, 0.001, 0.98);
    printf("  Post-sleep consolidated attractors: %s (Pruned redundant duplicates)\n", cartan_float_to_string(post_sleep_count));
    cartan_assert(post_sleep_count == 2.0, "Duplicate basin must be pruned, leaving 2 unique attractors");
    printf("[3/5] Redundant Attractor Pruning assertions PASSED.\n\n");

    // [4/5] Binary File Persistence across Sleep Consolidation
    printf("[4/5] Verifying Binary Persistence of Compacted Attractor Basins...\n");
    cartan_hopfield_clear();
    let reloaded_count = cartan_hopfield_load_basins(test_file);
    cartan_assert(reloaded_count == 2.0, "Reloaded bank from disk must reflect compacted count of 2 attractors");
    printf("  Reloaded %s compacted attractors from %s\n", cartan_float_to_string(reloaded_count), test_file);
    printf("[4/5] Binary Persistence assertions PASSED.\n\n");

    // [5/5] Multi-Cycle Consolidation Stability
    printf("[5/5] Verifying Multi-Cycle Sleep Consolidation Stability...\n");
    var cycle = 1.0;
    while (cycle <= 3.0) {
        let stable_count = cartan_sleep_consolidate_cycle(test_file, 0.0005, 0.98);
        cartan_assert(stable_count == 2.0, "Stable memory bank count must not fluctuate across idle sleep cycles");
        cycle = cycle + 1.0;
    }
    printf("  Multi-cycle stability verified: Basin count remained exactly 2.0 across 3 consecutive cycles.\n");
    printf("[5/5] Multi-Cycle Consolidation Stability assertions PASSED.\n\n");

    printf("TEST_SLEEP_CONSOLIDATION_SUCCESS\n\n");
    cartan_flush(0.0);
    return 0.0;
}
