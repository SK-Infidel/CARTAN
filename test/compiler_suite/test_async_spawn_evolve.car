// test/compiler_suite/test_async_spawn_evolve.car
// CARTAN Regression Target 68: Statement Line Index Alignment, AST Arity Harmonization, and Spawn/Evolve Block Lowering

include "core_runtime.car";

extern fn printf(fmt: string, s: string) -> float;
extern fn fabs(x: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;

fn assert_approx(val: float, expected: float, tol: float, msg: string) -> void {
    let diff = fabs(val - expected);
    if (diff > tol) {
        printf("[FAIL] %s: Expected approx ", msg);
        printf("%f, got ", "");
        printf("%f\n", "");
        cartan_assert(0.0, msg);
    }
}

fn assert_true(cond: float, msg: string) -> void {
    if (cond == 0.0) {
        printf("[FAIL] Assertion failed: %s\n", msg);
        cartan_assert(0.0, msg);
    }
}

fn main() -> float {
    printf("====================================================================\n", "");
    printf(" CARTAN Regression Target 68: Async Spawn & Evolve Block Lowering   \n", "");
    printf("====================================================================\n\n", "");

    // -------------------------------------------------------------
    // Test 1: Native spawn Block Lowering and Runtime Dispatch
    // -------------------------------------------------------------
    printf("Test 1: Native spawn Block Lowering...\n", "");
    let count_before = g_async_task_counter;
    var worker_acc = 10.0;

    spawn WorkerActor {
        var computation = 25.0 * 2.0;
        worker_acc = worker_acc + computation;
    }

    assert_true(g_async_task_counter > count_before, "Spawn must increment global async task counter");
    assert_approx(worker_acc, 60.0, 0.0001, "Spawn body statements must execute and update state");
    printf("  PASS: Native spawn block lowering and execution verified\n", "");

    // -------------------------------------------------------------
    // Test 2: Native evolve Block Lowering and Genetic Optimization
    // -------------------------------------------------------------
    printf("Test 2: Native evolve Block Lowering...\n", "");
    var base_fitness = 100.0;
    var gene_mutation = 15.5;

    evolve PopulationOptimizer {
        var step_delta = gene_mutation * 2.0;
        base_fitness = base_fitness + step_delta;
    }

    assert_approx(base_fitness, 131.0, 0.0001, "Evolve block must execute internal statements");
    printf("  PASS: Native evolve block lowering and execution verified\n", "");

    // -------------------------------------------------------------
    // Test 3: Receive Handler Lowering inside Actor Context
    // -------------------------------------------------------------
    printf("Test 3: Receive Handler Lowering inside Spawn...\n", "");
    var msg_received = 0.0;

    spawn ReceptorAgent {
        receive packet(data: float) {
            msg_received = 42.0;
        }
    }

    assert_approx(msg_received, 42.0, 0.0001, "Receive handler body inside spawn must be lowered");
    printf("  PASS: Receive handler block lowering verified\n", "");

    // -------------------------------------------------------------
    // Test 4: Statement Discriminant Collision Prevention Check
    // -------------------------------------------------------------
    printf("Test 4: Statement Discriminant Collision Prevention...\n", "");
    // Ensure declarations with previously colliding line numbers work without interference
    sequence seq_test[8];
    block blk_test[16];
    lattice lat_test[Float, 32];
    tree tr_test<Item>;
    parameter param_test[4, 4];

    assert_true(seq_test != 0.0, "Sequence allocation pointer must be valid");
    assert_true(blk_test != 0.0, "Block allocation pointer must be valid");
    assert_true(lat_test != 0.0, "Lattice allocation pointer must be valid");
    assert_true(tr_test != 0.0, "Tree allocation pointer must be valid");
    assert_true(param_test != 0.0, "Parameter allocation pointer must be valid");

    // Test VarDecl, ExprStmt, and Runtime Spike/Prune execution
    var test_val = 55.0;
    test_val = test_val + 45.0;
    assert_approx(test_val, 100.0, 0.0001, "VarDecl and ExprStmt must function without discriminant collision");

    cartan_emit_spike(0.85);
    let spike_out = cartan_get_last_spike();
    assert_approx(spike_out, 0.85, 0.0001, "Emit spike must record genuine spike intensity");

    cartan_prune_graph(0.25);
    printf("  PASS: Statement discriminant collision prevention verified\n", "");

    printf("\nAll Target 68 async spawn and evolve lowering assertions passed!\n", "");
    return 0.0;
}
