// test/compiler_suite/test_finsler_randers.car
// Verification Suite: Non-Euclidean Finsler-Randers Sherman-Morrison Dual Projection & Dynamic Strides

include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/math.cl";
include "src/std/geom.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main() -> float {
    printf("================================================================================\n");
    printf("  CARTAN TEST SUITE: FINSLER-RANDERS SHERMAN-MORRISON VERIFICATION\n");
    printf("================================================================================\n\n");
    cartan_flush(0.0);

    var null_metric: ptr = 0.0;

    // [1/5] Dynamic Submanifold Strides Verification (248D, 1984D, 2560D)
    printf("[1/5] Verifying Dynamic Submanifold Strides across 248D, 1984D, and 2560D...\n");
    cartan_flush(0.0);

    // Test 248D (stride 31.0)
    let g248 = cartan_vec_create();
    let b248 = cartan_vec_create();
    let v248 = cartan_vec_create();
    let out248 = cartan_vec_create();
    var i = 0.0;
    while (i < 248.0) {
        cartan_vec_push_f32(g248, 0.01 * (i + 1.0));
        cartan_vec_push_f32(b248, 0.001);
        cartan_vec_push_f32(v248, 0.05);
        cartan_vec_push_f32(out248, 0.0);
        i = i + 1.0;
    }
    printf("  vectors populated\n");
    cartan_flush(0.0);
    let bwd248 = geomind_inverse_randers_backward_project(b248, 0.1, g248, v248);
    printf("  bwd248 done: %s\n", cartan_float_to_string(bwd248));
    cartan_flush(0.0);
    cartan_assert(bwd248 > 0.0, "248D backward projection alpha must be positive");
    let norm248 = geomind_inverse_randers_transform_grad(g248, b248, null_metric, out248);
    printf("  norm248 done: %s\n", cartan_float_to_string(norm248));
    cartan_flush(0.0);
    cartan_assert(norm248 > 0.0, "248D transform grad norm must be positive");

    // Test 1984D (stride 248.0)
    let g1984 = cartan_vec_create();
    let b1984 = cartan_vec_create();
    let v1984 = cartan_vec_create();
    let out1984 = cartan_vec_create();
    i = 0.0;
    while (i < 1984.0) {
        cartan_vec_push_f32(g1984, 0.002 * (math_mod_val(i, 10.0) + 1.0));
        cartan_vec_push_f32(b1984, 0.0005);
        cartan_vec_push_f32(v1984, 0.02);
        cartan_vec_push_f32(out1984, 0.0);
        i = i + 1.0;
    }
    let bwd1984 = geomind_inverse_randers_backward_project(b1984, 0.1, g1984, v1984);
    cartan_assert(bwd1984 > 0.0, "1984D backward projection alpha must be positive");
    let norm1984 = geomind_inverse_randers_transform_grad(g1984, b1984, null_metric, out1984);
    cartan_assert(norm1984 > 0.0, "1984D transform grad norm must be positive");

    // Test 2560D (stride 320.0)
    let g2560 = cartan_vec_create();
    let b2560 = cartan_vec_create();
    let v2560 = cartan_vec_create();
    let out2560 = cartan_vec_create();
    i = 0.0;
    while (i < 2560.0) {
        cartan_vec_push_f32(g2560, 0.001 * (math_mod_val(i, 8.0) + 1.0));
        cartan_vec_push_f32(b2560, 0.0002);
        cartan_vec_push_f32(v2560, 0.01);
        cartan_vec_push_f32(out2560, 0.0);
        i = i + 1.0;
    }
    let bwd2560 = geomind_inverse_randers_backward_project(b2560, 0.1, g2560, v2560);
    cartan_assert(bwd2560 > 0.0, "2560D backward projection alpha must be positive");
    let norm2560 = geomind_inverse_randers_transform_grad(g2560, b2560, null_metric, out2560);
    cartan_assert(norm2560 > 0.0, "2560D transform grad norm must be positive");
    printf("  [PASS] Dynamic Submanifold Strides Verified (248D, 1984D, 2560D)\n");
    cartan_flush(0.0);

    // [2/5] Zero-Drift Baseline Recovery
    printf("[2/5] Verifying Zero-Drift Baseline Recovery (b = 0 implies g_randers = g)...\n");
    cartan_flush(0.0);
    let test_dim = 16.0;
    let g_base = cartan_vec_create();
    let b_zero = cartan_vec_create();
    let out_zero = cartan_vec_create();
    i = 0.0;
    while (i < test_dim) {
        cartan_vec_push_f32(g_base, 0.005 * (i + 1.0));
        cartan_vec_push_f32(b_zero, 0.0);
        cartan_vec_push_f32(out_zero, 0.0);
        i = i + 1.0;
    }
    geomind_inverse_randers_transform_grad(g_base, b_zero, null_metric, out_zero);
    i = 0.0;
    while (i < test_dim) {
        let expected = cartan_vec_get_f32(g_base, i);
        let actual = cartan_vec_get_f32(out_zero, i);
        let diff = math_abs_val(actual - expected);
        cartan_assert(diff < 0.0001, "Zero drift must preserve exact gradient values");
        i = i + 1.0;
    }
    printf("  [PASS] Zero-Drift Baseline Recovery Verified\n");
    cartan_flush(0.0);

    // [3/5] Sherman-Morrison Collinear Damping
    printf("[3/5] Verifying Sherman-Morrison Collinear Damping along Drift...\n");
    cartan_flush(0.0);
    let g_col = cartan_vec_create();
    let b_col = cartan_vec_create();
    let out_col = cartan_vec_create();
    i = 0.0;
    while (i < test_dim) {
        let val = 0.01 * (i + 1.0);
        cartan_vec_push_f32(g_col, val);
        cartan_vec_push_f32(b_col, val * 0.10);
        cartan_vec_push_f32(out_col, 0.0);
        i = i + 1.0;
    }
    geomind_inverse_randers_transform_grad(g_col, b_col, null_metric, out_col);
    i = 0.0;
    while (i < test_dim) {
        let g_orig = cartan_vec_get_f32(g_col, i);
        let g_damped = cartan_vec_get_f32(out_col, i);
        cartan_assert(g_damped < g_orig, "Collinear gradient must be damped along forward drift");
        i = i + 1.0;
    }
    printf("  [PASS] Sherman-Morrison Collinear Damping Verified\n");
    cartan_flush(0.0);

    // [4/5] Orthogonal Drift Invariance
    printf("[4/5] Verifying Orthogonal Drift Invariance...\n");
    cartan_flush(0.0);
    // 2-element orthogonal vectors: g = [0.2, 0.0], b = [0.0, 0.2] => g . b = 0
    let g_orth = cartan_vec_create();
    let b_orth = cartan_vec_create();
    let out_orth = cartan_vec_create();
    cartan_vec_push_f32(g_orth, 0.20);
    cartan_vec_push_f32(g_orth, 0.0);
    cartan_vec_push_f32(b_orth, 0.0);
    cartan_vec_push_f32(b_orth, 0.20);
    cartan_vec_push_f32(out_orth, 0.0);
    cartan_vec_push_f32(out_orth, 0.0);
    geomind_inverse_randers_transform_grad(g_orth, b_orth, null_metric, out_orth);
    let g0_out = cartan_vec_get_f32(out_orth, 0.0);
    // Since b_0 = 0 and g . b = 0, g0_out should equal g_orth[0] = 0.20 exactly
    cartan_assert(math_abs_val(g0_out - 0.20) < 0.0001, "Orthogonal component must be preserved with factor 0");
    printf("  [PASS] Orthogonal Drift Invariance Verified\n");
    cartan_flush(0.0);

    // [5/5] Adaptive Geodesic Gradient Clipping (AGC)
    printf("[5/5] Verifying Adaptive Geodesic Gradient Clipping (AGC)...\n");
    cartan_flush(0.0);
    let g_huge = cartan_vec_create();
    let b_small = cartan_vec_create();
    let out_agc = cartan_vec_create();
    i = 0.0;
    while (i < test_dim) {
        cartan_vec_push_f32(g_huge, 50.0);
        cartan_vec_push_f32(b_small, 0.01);
        cartan_vec_push_f32(out_agc, 0.0);
        i = i + 1.0;
    }
    let norm_pre = geomind_inverse_randers_transform_grad(g_huge, b_small, null_metric, out_agc);
    cartan_assert(norm_pre > 1.0, "Pre-clip norm must exceed 1.0");
    i = 0.0;
    while (i < test_dim) {
        let clipped_val = cartan_vec_get_f32(out_agc, i);
        cartan_assert(math_abs_val(clipped_val) <= 1.0, "Clipped gradient components must be bounded within [-1.0, 1.0]");
        i = i + 1.0;
    }
    printf("  [PASS] Adaptive Geodesic Gradient Clipping (AGC) Verified\n\n");
    cartan_flush(0.0);

    printf("================================================================================\n");
    printf("  ALL 5 FINSLER-RANDERS GATES PASSED (EXIT CODE 0)\n");
    printf("================================================================================\n");
    return 0.0;
}
