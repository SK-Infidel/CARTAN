// test/compiler_suite/test_autotune.car
// CARTAN Compiler Suite: Test Hardware-Aware Micro-Kernel Autotuning Module
include "../../src/std/autotune.cl";

extern fn printf(fmt: string, s: string) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;

fn main() -> float {
    printf("[test_autotune] Initializing Hardware-Aware Micro-Kernel Autotuning verification...\n", "");
    let hw = autotune_probe_hardware();
    cartan_assert(hw.l1_cache_size == 32768.0, "L1 cache size probe must match 32KB");
    cartan_assert(hw.simd_width_bits == 256.0, "SIMD vector width probe must match 256-bit AVX2");

    let tile = autotune_find_optimal_tile(1024.0, 1024.0, 1024.0, "FP16");
    cartan_assert(tile.block_m == 128.0, "Matrix tile block M must match 128");
    cartan_assert(tile.block_n == 128.0, "Matrix tile block N must match 128");

    // Perform genuine 4x4 tiled GEMM (tile block = 2.0)
    let M = 4.0;
    let K = 4.0;
    let N = 4.0;
    let A = cartan_tensor_alloc(M * K);
    let B = cartan_tensor_alloc(K * N);
    
    var idx = 0.0;
    while (idx < 16.0) {
        cartan_vec_set_f32(A, idx, 2.0);
        cartan_vec_set_f32(B, idx, 3.0);
        idx = idx + 1.0;
    }

    let C = autotune_matmul_tiled(A, B, M, K, N, 2.0);
    cartan_assert(cartan_tree_len(C) == 16.0, "Tiled GEMM output size must match 4x4 (16)");

    // Theoretical dot product: sum_k(2.0 * 3.0) = 4 * 6.0 = 24.0
    var c_idx = 0.0;
    while (c_idx < 16.0) {
        let val = cartan_vec_get_f32(C, c_idx);
        cartan_assert(val == 24.0, "GEMM element must equal 24.0");
        c_idx = c_idx + 1.0;
    }

    // Verify 1024x1024 tensor allocation size query
    let big_T = cartan_tensor_alloc(1024.0 * 1024.0);
    cartan_assert(cartan_tree_len(big_T) == 1048576.0, "1024x1024 tensor allocation size must match 1048576");

    printf("[test_autotune] PASSED: Hardware-Aware Micro-Kernel Autotuning fully verified.\n", "");
    cartan_flush(0.0);
    return 0.0;
}
