// test/compiler_suite/test_loops_and_primitives.car
// CARTAN Regression Target 63: Native For Loops, Project Vocab, Prompt Literals, & Paged Attention

include "../../src/cartanc/ast.ch";

extern fn printf(fmt: string, val: string) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_float_to_string(v: float) -> string;
extern fn cartan_string_concat(s1: string, s2: string) -> string;
extern fn cartan_string_length(s: string) -> float;
extern fn cartan_vec_create() -> ptr;
extern fn cartan_vec_push_f32(v: ptr, val: float) -> float;
extern fn cartan_vec_get_f32(v: ptr, idx: float) -> float;
extern fn cartan_vec_len(v: ptr) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("====================================================\n", "");
    printf(" CARTAN Regression Target 63: Loops & Primitives    \n", "");
    printf("====================================================\n\n", "");
    cartan_flush(0.0);

    // 1. Test Native For Loop
    printf("Test 1: Native for-in loop over vector...\n", "");
    cartan_flush(0.0);
    let v_data = cartan_vec_create();
    cartan_vec_push_f32(v_data, 10.0);
    cartan_vec_push_f32(v_data, 20.0);
    cartan_vec_push_f32(v_data, 30.0);
    cartan_vec_push_f32(v_data, 40.0);
    var loop_sum = 0.0;
    var loop_count = 0.0;
    for elem in v_data {
        loop_sum = loop_sum + elem;
        loop_count = loop_count + 1.0;
    }
    if (loop_sum != 100.0 || loop_count != 4.0) {
        printf("  [ERROR] For loop failed! sum=%s\n", cartan_float_to_string(loop_sum));
        return 1.0;
    }
    let s_msg = cartan_string_concat(cartan_float_to_string(loop_count), " iterations, sum=");
    let s_msg2 = cartan_string_concat(s_msg, cartan_float_to_string(loop_sum));
    printf("  PASS: Native for loop verified (%s)\n", s_msg2);

    // 2. Test Project Vocab
    printf("Test 2: Project vocab projection...\n", "");
    cartan_flush(0.0);
    let src_vec = cartan_vec_create();
    cartan_vec_push_f32(src_vec, 101.0);
    cartan_vec_push_f32(src_vec, 102.0);
    let tgt_vec = cartan_vec_create();
    project_vocab(src_vec, tgt_vec);
    let tgt_len = cartan_vec_len(tgt_vec);
    let tgt_val0 = cartan_vec_get_f32(tgt_vec, 0.0);
    let tgt_val1 = cartan_vec_get_f32(tgt_vec, 1.0);
    if (tgt_len != 2.0 || tgt_val0 != 101.0 || tgt_val1 != 102.0) {
        printf("  [ERROR] project_vocab failed!\n", "");
        return 1.0;
    }
    printf("  PASS: project_vocab verified (len=2.0, elems=[101.0, 102.0])\n", "");

    // 3. Test Prompt Literal
    printf("Test 3: Prompt literal p\"...\" string syntax...\n", "");
    cartan_flush(0.0);
    let prompt_val = p"System: Autonomous cognitive substrate active.";
    let p_len = cartan_string_length(prompt_val);
    if (p_len <= 0.0) {
        printf("  [ERROR] Prompt literal length invalid!\n", "");
        return 1.0;
    }
    printf("  PASS: Prompt literal formatted cleanly (len=%s)\n", cartan_float_to_string(p_len));

    // 4. Test Paged Attention Computation
    printf("Test 4: Paged attention causal kernel...\n", "");
    cartan_flush(0.0);
    let q_vec = cartan_vec_create();
    cartan_vec_push_f32(q_vec, 1.0);
    cartan_vec_push_f32(q_vec, 0.0);
    let k_vec = cartan_vec_create();
    cartan_vec_push_f32(k_vec, 1.0);
    cartan_vec_push_f32(k_vec, 0.0);
    let v_vec = cartan_vec_create();
    cartan_vec_push_f32(v_vec, 42.0);
    let attn_out = paged_attention(q_vec, k_vec, v_vec);
    let attn_len = cartan_vec_len(attn_out);
    let attn_val = cartan_vec_get_f32(attn_out, 0.0);
    if (attn_len != 1.0 || attn_val <= 0.0) {
        printf("  [ERROR] paged_attention kernel failed!\n", "");
        return 1.0;
    }
    printf("  PASS: paged_attention computed authentic scaled output (val=%s)\n", cartan_float_to_string(attn_val));

    // 5. Test Try-Catch Structured Scope
    printf("Test 5: Try-catch block scoping...\n", "");
    cartan_flush(0.0);
    var try_executed = 0.0;
    try {
        try_executed = 1.0;
    } catch (err_msg) {
        try_executed = 0.0;
    }
    if (try_executed != 1.0) {
        printf("  [ERROR] Try-catch block execution failed!\n", "");
        return 1.0;
    }
    printf("  PASS: Try-catch scoped block verified.\n", "");

    printf("\nALL SPRINT 453 LOOPS AND PRIMITIVES TESTS PASSED EMPIRICALLY!\n", "");
    return 0.0;
}
