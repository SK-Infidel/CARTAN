// test/compiler_suite/test_collections_ingest_env.car
// CARTAN Regression Target [25/25]: Collections, Ingest & Env Module Integration Pass
// // run-pass

include "../../src/std/collections.car";
include "../../src/std/ingest.car";
include "../../src/std/env.car";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    let stk = collections::create_stack();
    collections::stack_push(stk, 42.0);
    let popped = collections::stack_pop(stk);
    cartan_assert(popped == 42.0, "collections::stack_pop failed");

    let q = collections::create_queue();
    collections::queue_enqueue(q, 100.0);
    let deq = collections::queue_dequeue(q);
    cartan_assert(deq == 100.0, "collections::queue_dequeue failed");

    let csv_res = ingest::parse_csv_line("a,b,c");
    cartan_assert(csv_res == 1.0, "ingest::parse_csv_line failed");

    let hw = env::detect_hardware();
    cartan_assert(hw >= 0.0, "env::detect_hardware failed");

    return 0.0;
}
