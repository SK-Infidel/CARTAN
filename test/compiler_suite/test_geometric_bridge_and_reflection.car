// test/compiler_suite/test_geometric_bridge_and_reflection.car
// CARTAN Regression Target 66: Geometric Alignment, Bridge, Manifold Embedding, & Repository Reflection

include "core_runtime.car";

extern fn printf(fmt: string, s: string) -> float;
extern fn fabs(x: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;

fn assert_approx(val: float, expected: float, tol: float, msg: string) -> void {
    let diff = fabs(val - expected);
    if (diff > tol) {
        printf("[FAIL] %s: Expected approx ", msg);
        printf("%f, got ", "");
        printf("%f\n", "");
        cartan_assert(0.0, msg);
    }
}

fn assert_true(cond: float, msg: string) -> void {
    if (cond == 0.0) {
        printf("[FAIL] Assertion failed: %s\n", msg);
        cartan_assert(0.0, msg);
    }
}

fn main() -> float {
    printf("===============================================================\n", "");
    printf(" CARTAN Regression Target 66: Geometric Bridge & Reflection   \n", "");
    printf("===============================================================\n\n", "");

    // -------------------------------------------------------------
    // Test 1: Authentic Manifold Text Embedding (Cartan.lex_and_embed)
    // -------------------------------------------------------------
    printf("Test 1: Authentic Manifold Text Embedding (Cartan.lex_and_embed)...\n", "");
    let text = "CARTAN_INTELLIGENCE_KERNEL";
    let embedded = Cartan.lex_and_embed(text);
    assert_true(embedded != 0.0, "Embedded vector must not be null");
    let emb_len = cartan_vec_len(embedded);
    assert_true(emb_len == 8.0, "Embedded vector must have 8 manifold dimensions");
    
    // Check that coordinates are non-zero genuine calculated values
    let c0 = cartan_vec_get_f32(embedded, 0.0);
    let c1 = cartan_vec_get_f32(embedded, 1.0);
    let c7 = cartan_vec_get_f32(embedded, 7.0);
    assert_true(fabs(c0) > 0.0001, "Dimension 0 coordinate must be non-zero");
    assert_true(fabs(c1) > 0.0001, "Dimension 1 coordinate must be non-zero");
    assert_true(fabs(c7) > 0.0001, "Dimension 7 coordinate must be non-zero");
    assert_true(c0 != c1, "Coordinates must not be identical dummy constants");
    printf("  PASS: Authentic text manifold embedding verified (8-D Lie coordinates)\n", "");

    // -------------------------------------------------------------
    // Test 2: Authentic Geodesic Alignment (Cartan.align_geodesics)
    // -------------------------------------------------------------
    printf("Test 2: Authentic Geodesic Alignment (Cartan.align_geodesics)...\n", "");
    let w = cartan_vec_create();
    cartan_vec_push_f32(w, 1.0);
    cartan_vec_push_f32(w, 2.0);
    cartan_vec_push_f32(w, 3.0);

    let b = cartan_vec_create();
    cartan_vec_push_f32(b, 0.5);
    cartan_vec_push_f32(b, 1.5);
    cartan_vec_push_f32(b, 2.5);

    let aligned = Cartan.align_geodesics(w, b);
    assert_true(aligned != 0.0, "Aligned geodesics vector must not be null");
    assert_true(cartan_vec_len(aligned) == 3.0, "Aligned vector must preserve length 3");

    // Theoretical check for i=0:
    // w0 = 1.0, b0 = 0.5
    // denom = 1 + 1.0^2 + 0.5^2 = 2.25
    // g0 = 1.0 * cos(0.2) + 0.5 * sin(0.2) + (1.0 * 0.5 * 0.1) / 2.25
    // cos(0.2) ~= 0.9800666, sin(0.2) ~= 0.1986693
    // g0 ~= 0.9800666 + 0.0993347 + 0.05 / 2.25 = 1.0794013 + 0.0222222 = 1.101623
    let g0 = cartan_vec_get_f32(aligned, 0.0);
    assert_approx(g0, 1.10162, 0.01, "Aligned geodesic element 0");

    let g1 = cartan_vec_get_f32(aligned, 1.0);
    let g2 = cartan_vec_get_f32(aligned, 2.0);
    assert_true(g1 > g0, "Aligned coordinates must preserve ordering");
    assert_true(g2 > g1, "Aligned coordinates must preserve ordering");
    printf("  PASS: Riemannian geodesic alignment verified (g0 ~= 1.1016)\n", "");

    // -------------------------------------------------------------
    // Test 3: Authentic Riemannian Bridge (Cartan.GeometricBridge)
    // -------------------------------------------------------------
    printf("Test 3: Authentic Riemannian Bridge (Cartan.GeometricBridge)...\n", "");
    let bridge = Cartan.GeometricBridge(w, b);
    assert_true(bridge != 0.0, "Bridge output must not be null");
    assert_true(cartan_vec_len(bridge) == 3.0, "Bridge output must have length 3");

    // Theoretical check for i=0:
    // s0 = 1.0, t0 = 0.5
    // chord = sqrt(1.0^2 + 0.5^2 + 1.0) = sqrt(2.25) = 1.5
    // B0 = 0.5 * (1.0 + 0.5) + 0.1 * 1.5 - 0.05 * (1.0 - 0.5)
    // B0 = 0.75 + 0.15 - 0.025 = 0.875
    let B0 = cartan_vec_get_f32(bridge, 0.0);
    assert_approx(B0, 0.875, 0.01, "Geometric bridge element 0");

    // Theoretical check for i=1:
    // s1 = 2.0, t1 = 1.5
    // chord = sqrt(4.0 + 2.25 + 1.0) = sqrt(7.25) ~= 2.692582
    // B1 = 0.5 * 3.5 + 0.1 * 2.692582 - 0.05 * 0.5 = 1.75 + 0.269258 - 0.025 = 1.994258
    let B1 = cartan_vec_get_f32(bridge, 1.0);
    assert_approx(B1, 1.99426, 0.01, "Geometric bridge element 1");
    printf("  PASS: Geometric bridge chord verified (B0 = 0.875, B1 = 1.994)\n", "");

    // -------------------------------------------------------------
    // Test 4: Repository Reflection & Dynamic Graph Hot-Swap
    // -------------------------------------------------------------
    printf("Test 4: Repository Reflection & Dynamic Graph Hot-Swap...\n", "");
    let repo = Cartan.reflect_repo();
    assert_true(repo != 0.0, "Reflected repository pointer must not be null");
    assert_true(cartan_tree_len(repo) >= 4.0, "Reflected repo must have metadata slots");

    let initial_root = cartan_tree_get_f32(repo, 0.0);
    assert_true(initial_root != 0.0, "Active graph root pointer must be present in slot 0");

    let mod_name = cartan_tree_get_f32(repo, 1.0);
    assert_true(cartan_string_eq(mod_name, "CARTAN_ACTIVE_GRAPH") != 0.0, "Module name matches");

    let status = cartan_tree_get_f32(repo, 2.0);
    assert_true(cartan_string_eq(status, "ACTIVE") != 0.0, "Initial repo status must be ACTIVE");

    let epoch = cartan_tree_get_f32(repo, 3.0);
    assert_true(cartan_string_eq(epoch, "EPOCH_456") != 0.0, "Initial repo epoch must be EPOCH_456");

    // Prepare shadow graph container
    let shadow_graph = cartan_vec_create();
    cartan_vec_push_f32(shadow_graph, 10.0);
    cartan_vec_push_f32(shadow_graph, 20.0);
    cartan_vec_push_f32(shadow_graph, 30.0);

    // Atomically hot-swap shadow graph into active repo slot 0
    let prev = Cartan.hot_swap(repo, shadow_graph);
    assert_true(prev == initial_root, "Previous graph root returned from swap");

    let updated_root = cartan_tree_get_f32(repo, 0.0);
    assert_true(updated_root == shadow_graph, "Slot 0 updated to shadow graph root");
    printf("  PASS: Repository reflection and shadow graph hot-swap verified\n", "");

    // -------------------------------------------------------------
    // Test 5: Top-Level Wrapper Functions Direct Invocation
    // -------------------------------------------------------------
    printf("Test 5: Top-Level Wrapper Functions Direct Invocation...\n", "");
    let emb_wrap = lex_and_embed("CARTAN");
    assert_true(cartan_vec_len(emb_wrap) == 8.0, "lex_and_embed wrapper must return 8-D vector");

    let align_wrap = align_geodesics(w, b);
    assert_true(cartan_vec_len(align_wrap) == 3.0, "align_geodesics wrapper must return 3-D vector");

    let bridge_wrap = geometric_bridge(w, b);
    assert_approx(cartan_vec_get_f32(bridge_wrap, 0.0), 0.875, 0.01, "geometric_bridge wrapper value");

    let repo_wrap = reflect_repo();
    assert_true(cartan_tree_get_f32(repo_wrap, 0.0) != 0.0, "reflect_repo wrapper graph root");
    printf("  PASS: All 4 top-level function wrappers executed and verified\n\n", "");

    printf("ALL SPRINT 456 GEOMETRIC BRIDGE & REFLECTION TESTS PASSED EMPIRICALLY!\n\n", "");
    return 0.0;
}
