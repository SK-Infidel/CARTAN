// test/compiler_suite/test_transforms_and_logic.car
// CARTAN Regression Target 62: Higher-Order Transforms, Weight Decay, Satisfy/Backtrack, & ONNX Ingestion

include "../../src/cartanc/ast.ch";

extern fn printf(fmt: string, val: string) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_float_to_string(v: float) -> string;
extern fn cartan_string_concat(s1: string, s2: string) -> string;
extern fn cartan_vec_create() -> ptr;
extern fn cartan_vec_push_f32(v: ptr, val: float) -> float;
extern fn cartan_vec_get_f32(v: ptr, idx: float) -> float;
extern fn cartan_vec_len(v: ptr) -> float;
extern fn cartan_internal_import_onnx(uri: string) -> ptr;

fn main(argc: float, argv: ptr) -> float {
    printf("====================================================\n", "");
    printf(" CARTAN Regression Target 62: Transforms & Logic   \n", "");
    printf("====================================================\n\n", "");
    cartan_flush(0.0);

    // 1. Test Higher-Order Transform: vmap
    printf("Test 1: Higher-order transform vmap...\n", "");
    cartan_flush(0.0);
    let t1 = cartan_vec_create();
    cartan_vec_push_f32(t1, 10.0);
    cartan_vec_push_f32(t1, 20.0);
    cartan_vec_push_f32(t1, 30.0);
    let vmapped = vmap(t1);
    let v_len = cartan_vec_len(vmapped);
    let v_val = cartan_vec_get_f32(vmapped, 1.0);
    if (v_len != 3.0 || v_val != 20.0) {
        printf("  [ERROR] vmap output invalid! len=%s\n", cartan_float_to_string(v_len));
        return 1.0;
    }
    let s_v = cartan_string_concat(cartan_float_to_string(v_len), ", elem[1]=");
    let s_v2 = cartan_string_concat(s_v, cartan_float_to_string(v_val));
    printf("  PASS: vmap verified (len=%s)\n", s_v2);

    // 2. Test Higher-Order Transform: grad
    printf("Test 2: Higher-order transform grad...\n", "");
    cartan_flush(0.0);
    let t2 = cartan_vec_create();
    cartan_vec_push_f32(t2, 5.0);
    cartan_vec_push_f32(t2, 10.0);
    let graded = grad(t2);
    let g_len = cartan_vec_len(graded);
    let g_val0 = cartan_vec_get_f32(graded, 0.0);
    if (g_len != 2.0 || g_val0 <= 0.0) {
        printf("  [ERROR] grad output invalid!\n", "");
        return 2.0;
    }
    let s_g = cartan_string_concat(cartan_float_to_string(g_len), ", adjoint[0]=");
    let s_g2 = cartan_string_concat(s_g, cartan_float_to_string(g_val0));
    printf("  PASS: grad verified (len=%s)\n", s_g2);

    // 3. Test Weight Decay Regularization
    printf("Test 3: Weight decay regularization...\n", "");
    cartan_flush(0.0);
    let t3 = cartan_vec_create();
    cartan_vec_push_f32(t3, 100.0);
    cartan_vec_push_f32(t3, 200.0);
    let decayed = weight_decay(t3, 0.1);
    let d_val0 = cartan_vec_get_f32(decayed, 0.0);
    let d_val1 = cartan_vec_get_f32(decayed, 1.0);
    if (d_val0 < 89.9 || d_val0 > 90.1 || d_val1 < 179.9 || d_val1 > 180.1) {
        printf("  [ERROR] weight_decay calculation incorrect! val0=%s\n", cartan_float_to_string(d_val0));
        return 3.0;
    }
    let s_d = cartan_string_concat(cartan_float_to_string(d_val0), ", 200 -> ");
    let s_d2 = cartan_string_concat(s_d, cartan_float_to_string(d_val1));
    printf("  PASS: weight_decay verified (100 -> %s)\n", s_d2);

    // 4. Test Declarative Satisfy & Backtrack Loop
    printf("Test 4: Declarative satisfy and backtrack constraint loop...\n", "");
    cartan_flush(0.0);
    var candidate = 1.0;
    var steps = 0.0;
    satisfy candidate >= 8.0 {
        steps = steps + 1.0;
        if (candidate < 8.0) {
            candidate = candidate * 2.0;
            backtrack;
        }
    } otherwise {
        candidate = 0.0;
    }

    if (candidate != 8.0 || steps != 4.0) {
        printf("  [ERROR] satisfy/backtrack failed! candidate=%s\n", cartan_float_to_string(candidate));
        return 4.0;
    }
    let s_sat = cartan_string_concat(cartan_float_to_string(candidate), " in steps: ");
    let s_sat2 = cartan_string_concat(s_sat, cartan_float_to_string(steps));
    printf("  PASS: satisfy/backtrack converged (candidate=%s)\n", s_sat2);

    // 5. Test Freestanding ONNX Ingestion Hook
    printf("Test 5: Freestanding ONNX ingestion...\n", "");
    cartan_flush(0.0);
    let model_container = cartan_internal_import_onnx("models/resnet50.onnx");
    if (model_container == 0.0) {
        printf("  [ERROR] ONNX model container allocation failed!\n", "");
        return 5.0;
    }
    printf("  PASS: ONNX model container allocated cleanly.\n", "");

    printf("\nALL SPRINT 452 TRANSFORMS AND LOGIC TESTS PASSED EMPIRICALLY!\n", "");
    return 0.0;
}
