// test/compiler_suite/test_stdlib.car
// // run-pass
// Sprint 12 Test Target: Standard Libraries Verification (fs, tensor, collections, math, io)

include "../../src/cartanc/ast.ch";

extern fn printf(fmt: string, v: float) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;
extern fn sin(x: float) -> float;
extern fn cos(x: float) -> float;
extern fn sqrt(x: float) -> float;

fn main() -> float {
    let s_val = sin(0.0);
    cartan_assert(s_val == 0.0, "sin(0.0) should be 0.0!");
    
    let c_val = cos(0.0);
    cartan_assert(c_val == 1.0, "cos(0.0) should be 1.0!");

    let sq_val = sqrt(16.0);
    cartan_assert(sq_val == 4.0, "sqrt(16.0) should be 4.0!");

    printf("Standard library math & assertion tests passed cleanly!\n", 0.0);
    cartan_flush(0.0);
    return 0.0;
}
