// test/compiler_suite/test_framework_layer2.car
// CARTAN Regression Target [26/26]: Layer 2 Framework (NN, Attention, Vision) Pass
// // run-pass

include "../../src/framework/nn.car";
include "../../src/framework/attention.car";
include "../../src/framework/vision.car";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    let t = tensor::alloc_sequence(10.0);
    cartan_assert(t != 0.0, "tensor::alloc_sequence failed");

    let act = nn::relu(t);
    cartan_assert(act != 0.0, "nn::relu failed");

    let g_act = nn::gelu(t);
    cartan_assert(g_act != 0.0, "nn::gelu failed");

    let attn_res = attention::scaled_dot_product_attention(t, t, t, 64.0);
    cartan_assert(attn_res != 0.0, "attention::scaled_dot_product_attention failed");

    let patch = vision::patch_embed(t, 16.0, 768.0);
    cartan_assert(patch != 0.0, "vision::patch_embed failed");

    return 0.0;
}
