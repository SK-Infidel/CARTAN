// test/compiler_suite/test_tensor_and_pointer_ops.car
// CARTAN Regression Target 65: Tensor Transposition, Graph Hot-Swap, Pointer Ops & Authentic GEMM

include "core_runtime.car";

extern fn printf(fmt: string, s: string) -> float;
extern fn fabs(x: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;

fn assert_approx(val: float, expected: float, tol: float, msg: string) -> void {
    let diff = fabs(val - expected);
    if (diff > tol) {
        printf("[FAIL] %s: Expected approx ", msg);
        printf("%f, got ", "");
        printf("%f\n", "");
        cartan_assert(0.0, msg);
    }
}

fn assert_true(cond: float, msg: string) -> void {
    if (cond == 0.0) {
        printf("[FAIL] Assertion failed: %s\n", msg);
        cartan_assert(0.0, msg);
    }
}

fn main() -> float {
    printf("===============================================================\n", "");
    printf(" CARTAN Regression Target 65: Tensor, Pointer & Hot-Swap Ops   \n", "");
    printf("===============================================================\n\n", "");

    // -------------------------------------------------------------
    // Test 1: Authentic GEMM Matrix Multiplication (2x3 * 3x2 -> 2x2)
    // -------------------------------------------------------------
    printf("Test 1: Genuine GEMM Matrix Multiplication (A x B)...\n", "");
    // A: 2x3 matrix [1, 2, 3; 4, 5, 6]
    let A = cartan_tensor_alloc(6.0);
    cartan_vec_set_f32(A, 0.0, 1.0);
    cartan_vec_set_f32(A, 1.0, 2.0);
    cartan_vec_set_f32(A, 2.0, 3.0);
    cartan_vec_set_f32(A, 3.0, 4.0);
    cartan_vec_set_f32(A, 4.0, 5.0);
    cartan_vec_set_f32(A, 5.0, 6.0);

    // B: 3x2 matrix [7, 8; 9, 10; 11, 12]
    let B = cartan_tensor_alloc(6.0);
    cartan_vec_set_f32(B, 0.0, 7.0);
    cartan_vec_set_f32(B, 1.0, 8.0);
    cartan_vec_set_f32(B, 2.0, 9.0);
    cartan_vec_set_f32(B, 3.0, 10.0);
    cartan_vec_set_f32(B, 4.0, 11.0);
    cartan_vec_set_f32(B, 5.0, 12.0);

    // C = A * B (2x2)
    // C[0,0] = 1*7 + 2*9 + 3*11 = 7 + 18 + 33 = 58
    // C[0,1] = 1*8 + 2*10 + 3*12 = 8 + 20 + 36 = 64
    // C[1,0] = 4*7 + 5*9 + 6*11 = 28 + 45 + 66 = 139
    // C[1,1] = 4*8 + 5*10 + 6*12 = 32 + 50 + 72 = 154
    let C = cartan_matmul_gemm(A, B, 2.0, 3.0, 2.0);
    assert_true(C != 0.0, "GEMM output buffer must not be null");

    let c00 = cartan_vec_get_f32(C, 0.0);
    let c01 = cartan_vec_get_f32(C, 1.0);
    let c10 = cartan_vec_get_f32(C, 2.0);
    let c11 = cartan_vec_get_f32(C, 3.0);

    assert_approx(c00, 58.0, 0.0001, "C[0,0] must equal 58.0");
    assert_approx(c01, 64.0, 0.0001, "C[0,1] must equal 64.0");
    assert_approx(c10, 139.0, 0.0001, "C[1,0] must equal 139.0");
    assert_approx(c11, 154.0, 0.0001, "C[1,1] must equal 154.0");
    printf("  PASS: GEMM multiplication verified (C = [[58, 64], [139, 154]])\n", "");

    // -------------------------------------------------------------
    // Test 2: Authentic Matrix Transposition (2D Tree representation)
    // -------------------------------------------------------------
    printf("Test 2: Genuine Matrix Transposition...\n", "");
    let row0 = cartan_vec_create();
    cartan_vec_push_f32(row0, 1.0);
    cartan_vec_push_f32(row0, 2.0);
    cartan_vec_push_f32(row0, 3.0);

    let row1 = cartan_vec_create();
    cartan_vec_push_f32(row1, 4.0);
    cartan_vec_push_f32(row1, 5.0);
    cartan_vec_push_f32(row1, 6.0);

    let mat = cartan_tree_create();
    cartan_tree_push(mat, row0);
    cartan_tree_push(mat, row1);

    // Transpose: 2x3 -> 3x2
    let mat_t = Cartan.transpose(mat);
    assert_true(mat_t != 0.0, "Transposed matrix must not be null");
    let t_rows = cartan_tree_len_f(mat_t);
    assert_approx(t_rows, 3.0, 0.0001, "Transposed matrix must have 3 rows");

    let t_r0 = cartan_tree_get_f32(mat_t, 0.0);
    let t_r1 = cartan_tree_get_f32(mat_t, 1.0);
    let t_r2 = cartan_tree_get_f32(mat_t, 2.0);

    // Row 0 of A^T: [1.0, 4.0]
    assert_approx(cartan_vec_get_f32(t_r0, 0.0), 1.0, 0.0001, "A^T[0,0] must equal 1.0");
    assert_approx(cartan_vec_get_f32(t_r0, 1.0), 4.0, 0.0001, "A^T[0,1] must equal 4.0");

    // Row 1 of A^T: [2.0, 5.0]
    assert_approx(cartan_vec_get_f32(t_r1, 0.0), 2.0, 0.0001, "A^T[1,0] must equal 2.0");
    assert_approx(cartan_vec_get_f32(t_r1, 1.0), 5.0, 0.0001, "A^T[1,1] must equal 5.0");

    // Row 2 of A^T: [3.0, 6.0]
    assert_approx(cartan_vec_get_f32(t_r2, 0.0), 3.0, 0.0001, "A^T[2,0] must equal 3.0");
    assert_approx(cartan_vec_get_f32(t_r2, 1.0), 6.0, 0.0001, "A^T[2,1] must equal 6.0");
    printf("  PASS: Matrix transpose verified (2x3 -> 3x2 matched exact values)\n", "");

    // -------------------------------------------------------------
    // Test 3: Dynamic Atomic Hot-Swap (Cartan.hot_swap)
    // -------------------------------------------------------------
    printf("Test 3: Atomic Graph Hot-Swap...\n", "");
    let slot = cartan_tree_create();
    let old_graph = malloc(64.0);
    let new_graph = malloc(64.0);
    cartan_tree_push(slot, old_graph);

    let prev = Cartan.hot_swap(slot, new_graph);
    assert_true(prev == old_graph, "HotSwap must return previous graph pointer");
    assert_true(cartan_tree_get_f32(slot, 0.0) == new_graph, "Slot must hold new graph pointer after swap");
    printf("  PASS: Atomic graph hot-swap verified\n", "");

    // -------------------------------------------------------------
    // Test 4: Pointer Address-Of (&x) and Dereference (*p)
    // -------------------------------------------------------------
    printf("Test 4: Pointer Address-Of and Dereference...\n", "");
    let scalar_val = 42.0;
    let ptr_to_scalar = &scalar_val;
    let deref_val = *ptr_to_scalar;
    assert_approx(deref_val, 42.0, 0.0001, "Dereferenced pointer must equal original scalar value");
    printf("  PASS: Pointer &x and *p verified (dereferenced 42.0)\n", "");

    // -------------------------------------------------------------
    // Test 5: Dynamic Matrix Multiplication (A @ B with 2D trees)
    // -------------------------------------------------------------
    printf("Test 5: Dynamic 2D Tree Matrix Multiplication...\n", "");
    // mat is 2x3 [[1, 2, 3], [4, 5, 6]]
    // mat_t is 3x2 [[1, 4], [2, 5], [3, 6]]
    // product = mat @ mat_t (2x2)
    // P[0,0] = 1*1 + 2*2 + 3*3 = 1 + 4 + 9 = 14
    // P[0,1] = 1*4 + 2*5 + 3*6 = 4 + 10 + 18 = 32
    // P[1,0] = 4*1 + 5*2 + 6*3 = 4 + 10 + 18 = 32
    // P[1,1] = 4*4 + 5*5 + 6*6 = 16 + 25 + 36 = 77
    let prod = cartan_tensor_matmul(mat, mat_t);
    assert_true(prod != 0.0, "Matrix product must not be null");
    assert_approx(cartan_tree_len_f(prod), 2.0, 0.0001, "Product must have 2 rows");

    let p_r0 = cartan_tree_get_f32(prod, 0.0);
    let p_r1 = cartan_tree_get_f32(prod, 1.0);

    assert_approx(cartan_vec_get_f32(p_r0, 0.0), 14.0, 0.0001, "P[0,0] must equal 14.0");
    assert_approx(cartan_vec_get_f32(p_r0, 1.0), 32.0, 0.0001, "P[0,1] must equal 32.0");
    assert_approx(cartan_vec_get_f32(p_r1, 0.0), 32.0, 0.0001, "P[1,0] must equal 32.0");
    assert_approx(cartan_vec_get_f32(p_r1, 1.0), 77.0, 0.0001, "P[1,1] must equal 77.0");
    printf("  PASS: 2D tree matmul verified (P = [[14, 32], [32, 77]])\n", "");

    printf("\nALL SPRINT 455 TENSOR, POINTER & HOT-SWAP TESTS PASSED EMPIRICALLY!\n\n", "");
    return 0.0;
}
