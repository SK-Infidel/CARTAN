// test/compiler_suite/test_multimodal_grounding.car
// Verification Suite: Multimodal Cross-Modal Grounding into Shared E8 Manifold Coordinates

include "../../src/std/vision.cl";
include "../../src/std/audio.cl";
include "../../src/std/math.cl";
include "../../src/std/collections.cl";
include "../../src/std/string.cl";

extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn cartan_float_to_string(v: float) -> string;

extern fn cartan_hopfield_clear() -> float;
extern fn cartan_hopfield_attractor_count() -> float;
extern fn cartan_hopfield_store_vector(vec: ptr, dim: float) -> float;
extern fn cartan_hopfield_store_hidden(h: ptr) -> float;
extern fn cartan_hopfield_relax(h: ptr, beta: float, steps: float) -> float;
extern fn cartan_hopfield_energy(h: ptr) -> float;

extern fn cartan_multimodal_ground_hidden(h: ptr, vision: ptr, audio: ptr) -> float;

fn main() -> float {
    printf("=================================================================================\n");
    printf("  CARTAN TEST SUITE: MULTIMODAL CROSS-MODAL GROUNDING VERIFICATION\n");
    printf("=================================================================================\n\n");

    // [1/5] SigLIP Visual Patch Extraction & Eikonal Stream Projection (Sector 5: dims 1600..1919)
    printf("[1/5] Verifying SigLIP Visual Patch Extraction & Eikonal Stream Projection...\n");
    let patch_dim = 16.0;
    let img = vision_create_image(patch_dim, patch_dim, 3.0);
    var y = 0.0;
    while (y < patch_dim) {
        var x = 0.0;
        while (x < patch_dim) {
            let r = (x + 1.0) / patch_dim;
            let g = (y + 1.0) / patch_dim;
            let b = 0.5;
            vision_set_pixel(img, x, y, 0.0, r * 255.0);
            vision_set_pixel(img, x, y, 1.0, g * 255.0);
            vision_set_pixel(img, x, y, 2.0, b * 255.0);
            x = x + 1.0;
        }
        y = y + 1.0;
    }
    let patch_tensor = vision_extract_patch(img, 0.0, 0.0, patch_dim, patch_dim);
    let patch_len = cartan_vec_len(patch_tensor);
    cartan_assert(patch_len == 768.0, "16x16 RGB patch must yield exactly 768 features");

    let eikonal_stream = vision_project_to_eikonal_stream(patch_tensor, 768.0, 320.0);
    let eik_len = cartan_vec_len(eikonal_stream);
    cartan_assert(eik_len == 320.0, "Eikonal projection must yield exactly 320 stream dimensions");

    let eik0 = cartan_vec_get_f32(eikonal_stream, 0.0);
    cartan_assert(eik0 > 0.0, "Eikonal projection element 0 must be positive");
    printf("  Visual patch extracted: %s features -> Projected to %s-D Eikonal stream (eik[0] = %s)\n",
        cartan_float_to_string(patch_len), cartan_float_to_string(eik_len), cartan_float_to_string(eik0));
    printf("[1/5] Visual Patch & Eikonal Projection assertions PASSED.\n\n");

    // [2/5] Audio Spectrogram DFT Harmonic Filterbank & Spectral Stream Projection (Sector 2: dims 640..959)
    printf("[2/5] Verifying Audio Spectrogram Filterbank & Spectral Stream Projection...\n");
    let num_samples = 256.0;
    let sample_rate = 16000.0;
    let audio_buf = audio_create_buffer(num_samples, sample_rate);
    var i = 0.0;
    let pi2 = 6.283185307179586;
    while (i < num_samples) {
        let t = i / sample_rate;
        // 440 Hz fundamental tone
        let s = sin(pi2 * 440.0 * t);
        audio_set_sample(audio_buf, i, s);
        i = i + 1.0;
    }
    let num_bins = 64.0;
    let dft_spec = audio_compute_dft_spectrum(audio_buf, num_bins);
    let spec_len = cartan_vec_len(dft_spec);
    cartan_assert(spec_len == 64.0, "DFT spectrum must yield 64 frequency bins");

    let spectral_stream = audio_project_to_spectral_stream(dft_spec, num_bins, 320.0);
    let spec_stream_len = cartan_vec_len(spectral_stream);
    cartan_assert(spec_stream_len == 320.0, "Spectral projection must yield exactly 320 stream dimensions");

    let spec0 = cartan_vec_get_f32(spectral_stream, 0.0);
    printf("  Acoustic waveform: %s samples -> 64 DFT bins -> %s-D Spectral stream (spec[0] = %s)\n",
        cartan_float_to_string(num_samples), cartan_float_to_string(spec_stream_len), cartan_float_to_string(spec0));
    printf("[2/5] Audio Filterbank & Spectral Projection assertions PASSED.\n\n");

    // [3/5] Cross-Modal Grounding into 2560-D E8 Hidden Manifold
    printf("[3/5] Verifying Cross-Modal Grounding into 2560-D Shared Manifold...\n");
    let h_multi = cartan_tensor_alloc(2560.0);
    var d = 0.0;
    while (d < 2560.0) {
        cartan_vec_set_f32(h_multi, d, 0.1);
        d = d + 1.0;
    }

    // Ground vision and audio into 2560-D state
    let ground_status = cartan_multimodal_ground_hidden(h_multi, patch_tensor, dft_spec);
    cartan_assert(ground_status == 1.0, "Multimodal grounding C runtime call must return 1.0");

    // Sector 0 (dims 0..319, Linguistic) should remain unchanged at 0.1
    let sec0_val = cartan_vec_get_f32(h_multi, 10.0);
    cartan_assert(sec0_val > 0.099 && sec0_val < 0.101, "Sector 0 (Linguistic) must remain unperturbed");

    // Sector 2 (dims 640..959, Spectral Audio) should be modified
    let sec2_val = cartan_vec_get_f32(h_multi, 650.0);
    cartan_assert(sec2_val != 0.1, "Sector 2 (Spectral Audio) must be grounded with acoustic features");

    // Sector 5 (dims 1600..1919, Eikonal Vision) should be modified
    let sec5_val = cartan_vec_get_f32(h_multi, 1610.0);
    cartan_assert(sec5_val != 0.1, "Sector 5 (Eikonal Vision) must be grounded with visual patch features");

    // Sector 7 (dims 2240..2559, Triality) should remain unchanged at 0.1
    let sec7_val = cartan_vec_get_f32(h_multi, 2300.0);
    cartan_assert(sec7_val > 0.099 && sec7_val < 0.101, "Sector 7 (Triality) must remain unperturbed");

    printf("  Sector isolation verified: Sector 0: %s | Sector 2 (Audio): %s | Sector 5 (Vision): %s | Sector 7: %s\n",
        cartan_float_to_string(sec0_val), cartan_float_to_string(sec2_val),
        cartan_float_to_string(sec5_val), cartan_float_to_string(sec7_val));
    printf("[3/5] Cross-Modal Manifold Grounding assertions PASSED.\n\n");

    // [4/5] Continuous Hopfield Attractor Basin Invariant Convergence
    printf("[4/5] Verifying Multimodal Continuous Hopfield Attractor Basin Convergence...\n");
    cartan_hopfield_clear();

    // Normalize grounded multimodal hidden state to unit sphere (canonical E8 manifold representation)
    var norm_sq = 0.0;
    d = 0.0;
    while (d < 2560.0) {
        let v = cartan_vec_get_f32(h_multi, d);
        norm_sq = norm_sq + (v * v);
        d = d + 1.0;
    }
    let inv_norm = 1.0 / math_sqrt(norm_sq);
    d = 0.0;
    while (d < 2560.0) {
        let v = cartan_vec_get_f32(h_multi, d);
        cartan_vec_set_f32(h_multi, d, v * inv_norm);
        d = d + 1.0;
    }

    // Store the grounded multimodal state as an attractor basin
    cartan_hopfield_store_hidden(h_multi);
    let n_basins = cartan_hopfield_attractor_count();
    cartan_assert(n_basins == 1.0, "Attractor bank must contain 1 stored basin");

    // Query with perturbed state (e.g. noisy visual input)
    let h_query = cartan_tensor_alloc(2560.0);
    d = 0.0;
    while (d < 2560.0) {
        let orig = cartan_vec_get_f32(h_multi, d);
        let noise = sin((d + 1.0) * 0.1) * 0.005;
        cartan_vec_set_f32(h_query, d, orig + noise);
        d = d + 1.0;
    }

    let energy_before = cartan_hopfield_energy(h_query);
    // Relax towards stored attractor basin
    cartan_hopfield_relax(h_query, 2.0, 3.0);
    let energy_after = cartan_hopfield_energy(h_query);
    printf("  Hopfield Attractor Basin: Initial E(h) = %s -> Relaxed E(h) = %s\n",
        cartan_float_to_string(energy_before), cartan_float_to_string(energy_after));
    cartan_assert(energy_after <= energy_before + 0.001, "Continuous Hopfield relaxation must decrease or maintain energy");
    printf("[4/5] Multimodal Attractor Basin Convergence assertions PASSED.\n\n");

    // [5/5] Multi-Sensory Concept Convergence (Sight + Sound + Text Attractor Association)
    printf("[5/5] Verifying Cross-Modal Concept Invariance in Hopfield Memory...\n");
    // Create text-dominant representation for same concept
    let h_text = cartan_tensor_alloc(2560.0);
    d = 0.0;
    while (d < 2560.0) {
        cartan_vec_set_f32(h_text, d, 0.01);
        d = d + 1.0;
    }
    // Blend with audio only
    let empty_vis = cartan_vec_create();
    cartan_multimodal_ground_hidden(h_text, empty_vis, dft_spec);

    // Normalize query vector
    var t_norm_sq = 0.0;
    d = 0.0;
    while (d < 2560.0) {
        let tv = cartan_vec_get_f32(h_text, d);
        t_norm_sq = t_norm_sq + (tv * tv);
        d = d + 1.0;
    }
    let t_inv = 1.0 / math_sqrt(t_norm_sq);
    d = 0.0;
    while (d < 2560.0) {
        let tv = cartan_vec_get_f32(h_text, d);
        cartan_vec_set_f32(h_text, d, tv * t_inv);
        d = d + 1.0;
    }

    let e_audio_only = cartan_hopfield_energy(h_text);
    // Relax towards multimodal memory basin
    cartan_hopfield_relax(h_text, 2.0, 3.0);
    let e_converged = cartan_hopfield_energy(h_text);
    printf("  Partial query (Audio-only) relaxed to shared attractor: Initial E = %s -> Relaxed E = %s\n",
        cartan_float_to_string(e_audio_only), cartan_float_to_string(e_converged));
    cartan_assert(e_converged <= e_audio_only + 0.001, "Sensory partial query must relax to attractor minimum");
    printf("[5/5] Cross-Modal Concept Invariance assertions PASSED.\n\n");

    printf("TEST_MULTIMODAL_GROUNDING_SUCCESS\n\n");
    cartan_flush(0.0);
    return 0.0;
}
