// test/compiler_suite/test_llvm_opt_pipeline.car
// CARTAN Regression Target [31/31]: Advanced LLVM Optimization Pass Pipeline (-O3 -ffast-math -flto) Pass
// // run-pass

include "../../src/std/math.car";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    var sum = 0.0;
    var i = 0.0;
    while (i < 100.0) {
        sum = sum + math::sqrt(i) * math::sin(i);
        i = i + 1.0;
    }
    cartan_assert(sum != 0.0, "Vectorized SIMD loop sum failed");
    return 0.0;
}
