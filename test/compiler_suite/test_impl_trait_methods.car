// Target 70: Trait and Impl Declaration with Method Lowering & Field Access
// Empirical regression test verifying struct method dispatch and property access.

extern fn printf(fmt: string, val: float) -> float;
extern fn exit(code: float) -> void;

trait Measurable {
    fn distance_sq(self: ptr) -> float {
        return 0.0;
    }
}

struct Point {
    x: float;
    y: float;
}

impl Point {
    fn scale(self: ptr, factor: float) -> float {
        return self.x * factor;
    }

    fn distance_sq(self: ptr) -> float {
        return self.x * self.x + self.y * self.y;
    }
}

fn main() -> float {
    let p = Point { x: 3.0, y: 4.0 };

    let d2 = p.distance_sq();
    printf("distance_sq = %f (expected 25.0)\n", d2);
    if (d2 != 25.0) {
        printf("FAILED: distance_sq expected 25.0, got %f\n", d2);
        exit(1.0);
    }

    let s = p.scale(2.5);
    printf("scale = %f (expected 7.5)\n", s);
    if (s != 7.5) {
        printf("FAILED: scale expected 7.5, got %f\n", s);
        exit(1.0);
    }

    printf("[PASS] Target 70: Trait and Impl method dispatch verified cleanly.\n", 70.0);
    return 0.0;
}
