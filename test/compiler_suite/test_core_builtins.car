// test/compiler_suite/test_core_builtins.car
// // run-pass
// Sprint 450 Regression Test: Freestanding Core Runtime Builtins & Cognitive Blocks

include "../../src/cartanc/ast.ch";

extern fn printf(fmt: string, v: float) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;

extern fn cartan_tensor_ones_like(A: ptr) -> ptr;
extern fn cartan_tensor_zeros_like(A: ptr) -> ptr;
extern fn cartan_tensor_transpose(A: ptr) -> ptr;
extern fn cartan_pattern_match(cond: string, pat: string) -> float;
extern fn cartan_print(msg: string) -> float;

fn main() -> float {
    // 1. Verify Cognitive Control Block syntax execution
    var cognitive_step = 0.0;
    
    doubt {
        cognitive_step = cognitive_step + 1.0;
    }
    cartan_assert(cognitive_step == 1.0, "doubt block failed to execute!");

    chain {
        cognitive_step = cognitive_step + 2.0;
    }
    cartan_assert(cognitive_step == 3.0, "chain block failed to execute!");

    route {
        cognitive_step = cognitive_step + 3.0;
    }
    cartan_assert(cognitive_step == 6.0, "route block failed to execute!");

    grok {
        cognitive_step = cognitive_step + 4.0;
    }
    cartan_assert(cognitive_step == 10.0, "grok block failed to execute!");

    override {
        cognitive_step = cognitive_step + 5.0;
    }
    cartan_assert(cognitive_step == 15.0, "override block failed to execute!");

    multimodal {
        cognitive_step = cognitive_step + 6.0;
    }
    cartan_assert(cognitive_step == 21.0, "multimodal block failed to execute!");

    vmap {
        cognitive_step = cognitive_step + 7.0;
    }
    cartan_assert(cognitive_step == 28.0, "vmap block failed to execute!");

    // 2. Verify Tensor Builtins on Vector
    let v = cartan_vec_create();
    cartan_vec_push_f32(v, 42.0);
    cartan_vec_push_f32(v, 99.0);
    cartan_vec_push_f32(v, -7.0);

    let v_ones = cartan_tensor_ones_like(v);
    cartan_assert(cartan_vec_len(v_ones) == 3.0, "v_ones len mismatch!");
    cartan_assert(cartan_vec_get_f32(v_ones, 0.0) == 1.0, "v_ones[0] must be 1.0!");
    cartan_assert(cartan_vec_get_f32(v_ones, 1.0) == 1.0, "v_ones[1] must be 1.0!");
    cartan_assert(cartan_vec_get_f32(v_ones, 2.0) == 1.0, "v_ones[2] must be 1.0!");

    let v_zeros = cartan_tensor_zeros_like(v);
    cartan_assert(cartan_vec_len(v_zeros) == 3.0, "v_zeros len mismatch!");
    cartan_assert(cartan_vec_get_f32(v_zeros, 0.0) == 0.0, "v_zeros[0] must be 0.0!");
    cartan_assert(cartan_vec_get_f32(v_zeros, 1.0) == 0.0, "v_zeros[1] must be 0.0!");
    cartan_assert(cartan_vec_get_f32(v_zeros, 2.0) == 0.0, "v_zeros[2] must be 0.0!");

    let v_trans = cartan_tensor_transpose(v);
    cartan_assert(cartan_vec_len(v_trans) == 3.0, "v_trans len mismatch!");
    cartan_assert(cartan_vec_get_f32(v_trans, 0.0) == 42.0, "v_trans[0] must be 42.0!");
    cartan_assert(cartan_vec_get_f32(v_trans, 1.0) == 99.0, "v_trans[1] must be 99.0!");

    // 3. Verify Matrix Transposition on 2D Tree
    let m = cartan_tree_create();
    let row0 = cartan_vec_create();
    cartan_vec_push_f32(row0, 1.0);
    cartan_vec_push_f32(row0, 2.0);
    cartan_vec_push_f32(row0, 3.0);
    let row1 = cartan_vec_create();
    cartan_vec_push_f32(row1, 4.0);
    cartan_vec_push_f32(row1, 5.0);
    cartan_vec_push_f32(row1, 6.0);
    cartan_tree_push(m, row0);
    cartan_tree_push(m, row1);

    let m_trans = cartan_tensor_transpose(m);
    cartan_assert(cartan_tree_len_f(m_trans) == 3.0, "m_trans must have 3 rows!");
    let t_row0 = cartan_tree_get_f32(m_trans, 0.0);
    let t_row1 = cartan_tree_get_f32(m_trans, 1.0);
    let t_row2 = cartan_tree_get_f32(m_trans, 2.0);
    cartan_assert(cartan_vec_len(t_row0) == 2.0, "t_row0 must have 2 cols!");
    cartan_assert(cartan_vec_get_f32(t_row0, 0.0) == 1.0, "t_row0[0] == 1.0!");
    cartan_assert(cartan_vec_get_f32(t_row0, 1.0) == 4.0, "t_row0[1] == 4.0!");
    cartan_assert(cartan_vec_get_f32(t_row1, 0.0) == 2.0, "t_row1[0] == 2.0!");
    cartan_assert(cartan_vec_get_f32(t_row1, 1.0) == 5.0, "t_row1[1] == 5.0!");
    cartan_assert(cartan_vec_get_f32(t_row2, 0.0) == 3.0, "t_row2[0] == 3.0!");
    cartan_assert(cartan_vec_get_f32(t_row2, 1.0) == 6.0, "t_row2[1] == 6.0!");

    // 4. Verify Pattern Matching
    let pm_exact = cartan_pattern_match("hello world", "hello world");
    cartan_assert(pm_exact == 1.0, "Exact pattern match failed!");

    let pm_star1 = cartan_pattern_match("hello world", "hello*");
    cartan_assert(pm_star1 == 1.0, "Prefix wildcard match failed!");

    let pm_star2 = cartan_pattern_match("hello world", "*world");
    cartan_assert(pm_star2 == 1.0, "Suffix wildcard match failed!");

    let pm_star3 = cartan_pattern_match("hello world", "*lo wo*");
    cartan_assert(pm_star3 == 1.0, "Infix wildcard match failed!");

    let pm_q = cartan_pattern_match("cat", "c?t");
    cartan_assert(pm_q == 1.0, "Single-char wildcard match failed!");

    let pm_fail = cartan_pattern_match("hello world", "goodbye*");
    cartan_assert(pm_fail == 0.0, "Mismatch pattern should return 0.0!");

    // 5. Verify Cartan Print
    let pr_res = cartan_print("Sprint 450 freestanding builtins and cognitive blocks verified!");
    cartan_assert(pr_res == 1.0, "cartan_print failed!");
    cartan_flush(0.0);

    return 0.0;
}
