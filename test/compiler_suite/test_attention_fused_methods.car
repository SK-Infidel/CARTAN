// test/compiler_suite/test_attention_fused_methods.car
// CARTAN Regression Target 67: Authentic Attention, Fused Kernel, Method Dispatch & Declaration Integrity

include "core_runtime.car";

extern fn printf(fmt: string, s: string) -> float;
extern fn fabs(x: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;

fn assert_approx(val: float, expected: float, tol: float, msg: string) -> void {
    let diff = fabs(val - expected);
    if (diff > tol) {
        printf("[FAIL] %s: Expected approx ", msg);
        printf("%f, got ", "");
        printf("%f\n", "");
        cartan_assert(0.0, msg);
    }
}

fn assert_true(cond: float, msg: string) -> void {
    if (cond == 0.0) {
        printf("[FAIL] Assertion failed: %s\n", msg);
        cartan_assert(0.0, msg);
    }
}

// Method implementation for vector weighted scaling with 2 arguments
fn cartan_method_compute_weighted(self_obj: ptr, scale: float, offset: float) -> float {
    let v0 = cartan_vec_get_f32(self_obj, 0.0);
    let v1 = cartan_vec_get_f32(self_obj, 1.0);
    return (v0 + v1) * scale + offset;
}

fn main() -> float {
    printf("====================================================================\n", "");
    printf(" CARTAN Regression Target 67: Attention, Fused Kernel & Methods    \n", "");
    printf("====================================================================\n\n", "");

    // -------------------------------------------------------------
    // Test 1: Authentic Attention Kernel via @attention syntax
    // -------------------------------------------------------------
    printf("Test 1: Authentic Runtime @attention Kernel...\n", "");
    let tgt = cartan_vec_create();
    cartan_vec_push_f32(tgt, 2.0);
    cartan_vec_push_f32(tgt, 4.0);
    cartan_vec_push_f32(tgt, 6.0);
    cartan_vec_push_f32(tgt, 8.0);

    let routing = cartan_vec_create();
    cartan_vec_push_f32(routing, 0.5);
    cartan_vec_push_f32(routing, -0.5);
    cartan_vec_push_f32(routing, 1.0);
    cartan_vec_push_f32(routing, 0.0);

    // Call native @attention operator
    let attn_out = @attention(routing = routing) tgt;
    assert_true(attn_out != 0.0, "Attention output tensor must not be null");

    let val0 = cartan_vec_get_f32(attn_out, 0.0);
    let val1 = cartan_vec_get_f32(attn_out, 1.0);
    let val2 = cartan_vec_get_f32(attn_out, 2.0);
    let val3 = cartan_vec_get_f32(attn_out, 3.0);

    assert_true(val0 > 0.0, "Attention val0 must be positive");
    assert_true(val1 > 0.0, "Attention val1 must be positive");
    assert_true(val2 > 0.0, "Attention val2 must be positive");
    assert_true(val3 > 0.0, "Attention val3 must be positive");
    assert_true(val0 != val1, "Attention output values must not be uniform constants");

    // Also test attention wrapper function from core_runtime
    let wrap_out = attention(tgt, routing);
    assert_true(wrap_out != 0.0, "Wrapper attention output tensor must not be null");
    let w_val0 = cartan_vec_get_f32(wrap_out, 0.0);
    assert_approx(val0, w_val0, 0.0001, "Direct and wrapper attention outputs must match");
    printf("  PASS: Authentic @attention kernel verified with Sigmoid gating and RMS scaling\n", "");

    // -------------------------------------------------------------
    // Test 2: Fused Kernel Block Execution (fuse { ... })
    // -------------------------------------------------------------
    printf("Test 2: Fused Kernel Block Execution (fuse { ... })...\n", "");
    let fused_val = fuse {
        let alpha = 14.5;
        let beta = 2.5;
        let gamma = alpha * 3.0 + beta;
        gamma - 6.0;
    };
    assert_approx(fused_val, 40.0, 0.0001, "Fused kernel block result mismatch");
    printf("  PASS: Fused kernel block evaluation verified\n", "");

    // -------------------------------------------------------------
    // Test 3: MethodCall Parameter Dispatch (multi-argument methods)
    // -------------------------------------------------------------
    printf("Test 3: MethodCall Parameter Dispatch with Multi-Arguments...\n", "");
    let test_vec = cartan_vec_create();
    cartan_vec_push_f32(test_vec, 3.0);
    cartan_vec_push_f32(test_vec, 7.0);

    // test_vec.compute_weighted(4.0, 5.0) -> (3.0 + 7.0) * 4.0 + 5.0 = 45.0
    let method_res = test_vec.compute_weighted(4.0, 5.0);
    assert_approx(method_res, 45.0, 0.0001, "MethodCall compute_weighted result mismatch");
    printf("  PASS: MethodCall multi-argument dispatch verified\n", "");

    // -------------------------------------------------------------
    // Test 4: Fractal Attention Block AST Variant
    // -------------------------------------------------------------
    printf("Test 4: Fractal Attention Block AST Variant Initialization...\n", "");
    let frac_tree = FractalAttentionBlock();
    assert_true(frac_tree != 0.0, "Fractal attention tree must not be null");
    let frac_root = cartan_tree_get_f32(frac_tree, 0.0);
    assert_true(frac_root != 0.0, "Fractal root must not be null");
    let r0 = cartan_vec_get_f32(frac_root, 0.0);
    let r1 = cartan_vec_get_f32(frac_root, 1.0);
    let r2 = cartan_vec_get_f32(frac_root, 2.0);
    assert_approx(r0, 1.0, 0.0001, "Fractal hierarchy level 0 must be 1.0");
    assert_approx(r1, 0.5, 0.0001, "Fractal hierarchy level 1 must be 0.5");
    assert_approx(r2, 0.25, 0.0001, "Fractal hierarchy level 2 must be 0.25");
    printf("  PASS: FractalAttentionBlock hierarchy initialization verified\n", "");

    // -------------------------------------------------------------
    // Test 5: Statement Declarations (Collision Rectification Check)
    // -------------------------------------------------------------
    printf("Test 5: Statement Declarations Execution...\n", "");
    sequence seq_reg[4];
    block blk_reg[8];
    lattice lat_reg[Boolean, 16];
    tree tree_reg<Node>;

    assert_true(seq_reg != 0.0, "Sequence declaration pointer must not be null");
    assert_true(blk_reg != 0.0, "Block declaration pointer must not be null");
    assert_true(lat_reg != 0.0, "Lattice declaration pointer must not be null");
    assert_true(tree_reg != 0.0, "Tree declaration pointer must not be null");
    printf("  PASS: Statement declarations (sequence, block, lattice, tree) verified\n", "");

    printf("\nAll Target 67 attention, fused kernel, and method dispatch assertions passed!\n", "");
    return 0.0;
}
