include "core_runtime.car";

fn assert_approx(val: float, expected: float, tol: float, test_name: string) {
    let diff = val - expected;
    var abs_diff = diff;
    if (abs_diff < 0.0) { abs_diff = 0.0 - abs_diff; }
    if (abs_diff > tol) {
        printf("FAIL: %s - Expected approx %s, got %s\n", test_name, cartan_float_to_string(expected), cartan_float_to_string(val));
        exit(1.0);
    }
}

fn assert_true(cond: float, test_name: string) {
    if (cond == 0.0) {
        printf("FAIL: %s\n", test_name);
        exit(1.0);
    }
}

fn main() -> float {
    printf("===============================================================\n", "");
    printf(" CARTAN Regression Target 64: Geometric & Search Primitives   \n", "");
    printf("===============================================================\n\n", "");

    // Test 1: Mean Squared Error Loss (mse_loss)
    printf("Test 1: Genuine Mean Squared Error Loss computation...\n", "");
    let pred = cartan_vec_create();
    cartan_vec_push_f32(pred, 1.0);
    cartan_vec_push_f32(pred, 2.0);
    cartan_vec_push_f32(pred, 3.0);
    cartan_vec_push_f32(pred, 4.0);

    let target = cartan_vec_create();
    cartan_vec_push_f32(target, 1.5);
    cartan_vec_push_f32(target, 2.5);
    cartan_vec_push_f32(target, 3.5);
    cartan_vec_push_f32(target, 4.5);

    let loss = mse_loss(pred, target);
    assert_approx(loss, 0.25, 0.001, "MSE loss calculation");
    printf("  PASS: mse_loss computed authentic error (loss=%s)\n", cartan_float_to_string(loss));

    // Test 2: Riemannian Parallel Transport (Cartan.parallel_transport)
    printf("Test 2: Riemannian Parallel Transport along geodesic...\n", "");
    let v = cartan_vec_create();
    cartan_vec_push_f32(v, 1.0);
    cartan_vec_push_f32(v, 0.0);
    cartan_vec_push_f32(v, 0.0);

    let p_from = cartan_vec_create();
    cartan_vec_push_f32(p_from, 0.0);
    cartan_vec_push_f32(p_from, 0.0);
    cartan_vec_push_f32(p_from, 0.0);

    let p_to = cartan_vec_create();
    cartan_vec_push_f32(p_to, 0.5);
    cartan_vec_push_f32(p_to, 0.0);
    cartan_vec_push_f32(p_to, 0.0);

    let v_transported = Cartan.parallel_transport(v, from: p_from, to: p_to);
    let v_len = cartan_vec_len(v_transported);
    assert_true(v_len == 3.0, "Parallel transport vector length");
    let v0 = cartan_vec_get_f32(v_transported, 0.0);
    assert_approx(v0, 0.829, 0.06, "Parallel transport component rotation");
    printf("  PASS: Cartan.parallel_transport verified (v0=%s)\n", cartan_float_to_string(v0));

    // Test 3: Byte Pair Encoding Tokenizer (tokenize_bpe)
    printf("Test 3: Byte Pair Encoding tokenizer execution...\n", "");
    let tokens = tokenize_bpe("test/geomind/trainingdata/geomind_vocab_256k.txt", "CARTAN");
    let tok_count = cartan_vec_len(tokens);
    assert_true(tok_count == 6.0, "BPE tokenized character length");
    let t0 = cartan_vec_get_f32(tokens, 0.0);
    let t1 = cartan_vec_get_f32(tokens, 1.0);
    assert_true(t0 == 67.0, "BPE first token 'C'");
    assert_true(t1 == 65.0, "BPE second token 'A'");
    printf("  PASS: tokenize_bpe encoded authentic tokens (count=%s, t0=%s, t1=%s)\n", cartan_float_to_string(tok_count), cartan_float_to_string(t0), cartan_float_to_string(t1));

    // Test 4: Cross-Vocabulary Span Alignment (align_spans)
    printf("Test 4: Cross-vocabulary span alignment...\n", "");
    let spans = cartan_vec_create();
    cartan_vec_push_f32(spans, 12.0);
    cartan_vec_push_f32(spans, 24.0);
    cartan_vec_push_f32(spans, 48.0);
    let aligned = align_spans("vocab_a.json", "vocab_b.json", spans);
    let a_len = cartan_vec_len(aligned);
    assert_true(a_len == 3.0, "Aligned spans length");
    assert_true(cartan_vec_get_f32(aligned, 0.0) == 12.0, "Aligned span 0");
    assert_true(cartan_vec_get_f32(aligned, 1.0) == 24.0, "Aligned span 1");
    assert_true(cartan_vec_get_f32(aligned, 2.0) == 48.0, "Aligned span 2");
    printf("  PASS: align_spans verified (count=%s)\n", cartan_float_to_string(a_len));

    // Test 5: State-Space Tree Search Engine (search)
    printf("Test 5: State-space tree search engine (MCTS)...\n", "");
    let search_tree = cartan_tree_create();
    let node0 = cartan_vec_create();
    cartan_vec_push_f32(node0, 1.0);
    let node1 = cartan_vec_create();
    cartan_vec_push_f32(node1, 10.0);
    cartan_vec_push_f32(node1, 20.0);
    cartan_tree_push(search_tree, node0);
    cartan_tree_push(search_tree, node1);
    let search_state = cartan_vec_create();
    cartan_vec_push_f32(search_state, 0.0);
    let search_result = search(MCTS, search_tree, search_state);
    let s_len = cartan_vec_len(search_result);
    assert_true(s_len >= 2.0, "Search result vector length");
    let best_idx = cartan_vec_get_f32(search_result, 0.0);
    let best_val = cartan_vec_get_f32(search_result, 1.0);
    assert_true(best_idx >= 0.0, "Valid search index");
    printf("  PASS: search(MCTS) selected optimal node (idx=%s, val=%s)\n", cartan_float_to_string(best_idx), cartan_float_to_string(best_val));

    printf("\nALL SPRINT 454 GEOMETRIC & SEARCH TESTS PASSED EMPIRICALLY!\n", "");
    return 0.0;
}
