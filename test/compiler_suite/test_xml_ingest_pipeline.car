// test/compiler_suite/test_xml_ingest_pipeline.car
// Authentic XML, Data Ingestion & Collections Verification Suite
// // run-pass

include "../../src/std/xml.car";
include "../../src/std/ingest.car";
include "../../src/std/collections.car";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn cartan_string_eq(s1: string, s2: string) -> float;
extern fn cartan_string_length(s: string) -> float;
extern fn cartan_string_contains(s: string, sub: string) -> float;
extern fn printf(format: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    // 1. Module-scoped collections verification
    let stk = collections::create_stack();
    collections::stack_push(stk, 55.0);
    collections::stack_push(stk, 99.0);
    let top1 = collections::stack_pop(stk);
    let top2 = collections::stack_pop(stk);
    cartan_assert(top1 == 99.0, "stack LIFO order check 1");
    cartan_assert(top2 == 55.0, "stack LIFO order check 2");

    let q = collections::create_queue();
    collections::queue_enqueue(q, 10.0);
    collections::queue_enqueue(q, 20.0);
    let f1 = collections::queue_dequeue(q);
    let f2 = collections::queue_dequeue(q);
    cartan_assert(f1 == 10.0, "queue FIFO order check 1");
    cartan_assert(f2 == 20.0, "queue FIFO order check 2");

    // 2. Authentic XML DOM Parsing & Attribute Extraction
    let xml_sample = "<catalog><book id=\"42\"><title>Cartan Architecture</title><author>Google DeepMind</author></book></catalog>";
    let root = xml::parse(xml_sample);
    cartan_assert(root != 0.0, "xml::parse root creation");

    let title_text = xml::get_text(root, "title");
    cartan_assert(cartan_string_eq(title_text, "Cartan Architecture") == 1.0, "xml::get_text title mismatch");

    let author_text = xml::get_text(root, "author");
    cartan_assert(cartan_string_eq(author_text, "Google DeepMind") == 1.0, "xml::get_text author mismatch");

    let book_elem = xml::get_element(root, "book");
    let book_id = xml::get_attribute(book_elem, "id");
    cartan_assert(cartan_string_eq(book_id, "42") == 1.0, "xml::get_attribute id mismatch");

    let serialized = xml::stringify(root);
    cartan_assert(cartan_string_contains(serialized, "Cartan Architecture") != 0.0, "xml::stringify integrity");

    // 3. Authentic CSV Parsing with Quoted Commas
    let csv_line = "model,layers,\"weight, bias\",loss";
    let csv_valid = ingest::parse_csv_line(csv_line);
    cartan_assert(csv_valid == 1.0, "ingest::parse_csv_line valid");

    let col_count = ingest::csv_column_count(csv_line);
    cartan_assert(col_count == 4.0, "ingest::csv_column_count 4 columns");

    let col0 = ingest::csv_get_column(csv_line, 0.0);
    cartan_assert(cartan_string_eq(col0, "model") == 1.0, "ingest::csv_get_column col0");

    let col2 = ingest::csv_get_column(csv_line, 2.0);
    cartan_assert(cartan_string_eq(col2, "weight, bias") == 1.0, "ingest::csv_get_column quoted comma");

    let invalid_csv = "broken,\"unclosed quote";
    let csv_invalid = ingest::parse_csv_line(invalid_csv);
    cartan_assert(csv_invalid == 0.0, "ingest::parse_csv_line broken quote rejected");

    // 4. Authentic JSON Lines Parsing & Field Extraction
    let jsonl_payload = "{\"id\": 101, \"token\": \"bos\"}\n{\"id\": 102, \"token\": \"eos\"}\n";
    let jsonl_valid = ingest::parse_json_lines(jsonl_payload);
    cartan_assert(jsonl_valid == 1.0, "ingest::parse_json_lines valid");

    let line_cnt = ingest::json_lines_count(jsonl_payload);
    cartan_assert(line_cnt == 2.0, "ingest::json_lines_count == 2");

    let fld = ingest::json_get_field("{\"id\": 101, \"token\": \"bos\"}", "token");
    cartan_assert(cartan_string_eq(fld, "bos") == 1.0, "ingest::json_get_field token value");

    let bad_jsonl = "{\"broken\": unclosed\n";
    let jsonl_invalid = ingest::parse_json_lines(bad_jsonl);
    cartan_assert(jsonl_invalid == 0.0, "ingest::parse_json_lines invalid rejected");

    printf("TEST_XML_INGEST_PIPELINE_SUCCESS\n");
    return 0.0;
}
