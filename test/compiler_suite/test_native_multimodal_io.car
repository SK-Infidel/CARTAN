// test/compiler_suite/test_native_multimodal_io.car
// Verification Suite: Native Multimodal I/O for Image (PPM / BMP) & Audio (WAV PCM)
// Tests:
//   [1/5] Native P6 Binary PPM Image Encoding, Disk Serialization, and Decoding
//   [2/5] Native 24-bit Windows BMP Encoding, Row-Padding Handling, and Decoding
//   [3/5] Native 16-bit PCM RIFF/WAVE Audio Encoding, Disk Serialization, and Decoding
//   [4/5] Cross-Modal Stream Projection into Eikonal and Spectral Streams
//   [5/5] Multimodal Hidden State Grounding & 42-Layer Manifold Step Execution

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/tensor.cl";
include "src/std/vision.cl";
include "src/std/audio.cl";
include "test/geomind/streams.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn cartan_float_to_string(v: float) -> string;
extern fn cartan_file_exists(path: string) -> float;
extern fn remove(path: string) -> float;
extern fn e8_attention_forward_step(h: ptr, temp: float) -> ptr;
extern fn cartan_multimodal_ground_hidden(hidden: ptr, vision: ptr, audio: ptr) -> float;

fn main() -> float {
    printf("=================================================================================\n");
    printf("  CARTAN TEST SUITE: NATIVE MULTIMODAL I/O (PPM, BMP, WAV) VERIFICATION\n");
    printf("=================================================================================\n\n");

    // [1/5] Native P6 Binary PPM Image Encoding & Decoding
    printf("[1/5] Verifying P6 Binary PPM Image Encoding, Writing & Decoding...\n");
    let ppm_file = "test_scratch_output.ppm";
    let img_ppm = vision_create_image(16.0, 16.0, 3.0);
    var y = 0.0;
    while (y < 16.0) {
        var x = 0.0;
        while (x < 16.0) {
            let r_val = x * 15.0;
            let g_val = y * 15.0;
            let b_val = 128.0;
            vision_set_pixel(img_ppm, x, y, 0.0, r_val);
            vision_set_pixel(img_ppm, x, y, 1.0, g_val);
            vision_set_pixel(img_ppm, x, y, 2.0, b_val);
            x = x + 1.0;
        }
        y = y + 1.0;
    }

    let save_ppm_res = vision_save_ppm(img_ppm, ppm_file);
    cartan_assert(save_ppm_res == 1.0, "vision_save_ppm must return 1.0 on success");
    cartan_assert(cartan_file_exists(ppm_file) == 1.0, "Saved PPM file must exist on disk");

    let loaded_ppm = vision_load_ppm(ppm_file);
    cartan_assert(loaded_ppm.width == 16.0, "Loaded PPM width must be exactly 16.0");
    cartan_assert(loaded_ppm.height == 16.0, "Loaded PPM height must be exactly 16.0");
    cartan_assert(loaded_ppm.channels == 3.0, "Loaded PPM channels must be 3.0");

    let p0_r = vision_get_pixel(loaded_ppm, 0.0, 0.0, 0.0);
    let p0_g = vision_get_pixel(loaded_ppm, 0.0, 0.0, 1.0);
    let p0_b = vision_get_pixel(loaded_ppm, 0.0, 0.0, 2.0);
    cartan_assert(p0_r == 0.0, "PPM Pixel (0,0) Red must match original 0.0");
    cartan_assert(p0_g == 0.0, "PPM Pixel (0,0) Green must match original 0.0");
    cartan_assert(p0_b == 128.0, "PPM Pixel (0,0) Blue must match original 128.0");

    let p8_r = vision_get_pixel(loaded_ppm, 8.0, 4.0, 0.0);
    let p8_g = vision_get_pixel(loaded_ppm, 8.0, 4.0, 1.0);
    let p8_b = vision_get_pixel(loaded_ppm, 8.0, 4.0, 2.0);
    cartan_assert(p8_r == 120.0, "PPM Pixel (8,4) Red must match original 120.0");
    cartan_assert(p8_g == 60.0, "PPM Pixel (8,4) Green must match original 60.0");
    cartan_assert(p8_b == 128.0, "PPM Pixel (8,4) Blue must match original 128.0");
    remove(ppm_file);
    printf("  -> [PASS] PPM P6 binary round-trip confirmed with byte-exact pixel match.\n\n");

    // [2/5] Native 24-bit Windows BMP Encoding & Row-Padding Handling
    printf("[2/5] Verifying 24-bit Windows BMP with 4-Byte Row-Padding Alignment...\n");
    let bmp_file = "test_scratch_output.bmp";
    // 15x11 image: row size is 45 bytes, padding is 3 bytes per row
    let img_bmp = vision_create_image(15.0, 11.0, 3.0);
    y = 0.0;
    while (y < 11.0) {
        var x = 0.0;
        while (x < 15.0) {
            vision_set_pixel(img_bmp, x, y, 0.0, (x + 1.0) * 16.0);
            vision_set_pixel(img_bmp, x, y, 1.0, (y + 1.0) * 20.0);
            vision_set_pixel(img_bmp, x, y, 2.0, 200.0);
            x = x + 1.0;
        }
        y = y + 1.0;
    }

    let save_bmp_res = vision_save_bmp(img_bmp, bmp_file);
    cartan_assert(save_bmp_res == 1.0, "vision_save_bmp must return 1.0 on success");
    cartan_assert(cartan_file_exists(bmp_file) == 1.0, "Saved BMP file must exist on disk");

    let loaded_bmp = vision_load_bmp(bmp_file);
    cartan_assert(loaded_bmp.width == 15.0, "Loaded BMP width must be exactly 15.0");
    cartan_assert(loaded_bmp.height == 11.0, "Loaded BMP height must be exactly 11.0");
    cartan_assert(loaded_bmp.channels == 3.0, "Loaded BMP channels must be 3.0");

    let bmp_p0_r = vision_get_pixel(loaded_bmp, 0.0, 0.0, 0.0);
    let bmp_p0_g = vision_get_pixel(loaded_bmp, 0.0, 0.0, 1.0);
    let bmp_p0_b = vision_get_pixel(loaded_bmp, 0.0, 0.0, 2.0);
    cartan_assert(bmp_p0_r == 16.0, "BMP Pixel (0,0) Red must match 16.0");
    cartan_assert(bmp_p0_g == 20.0, "BMP Pixel (0,0) Green must match 20.0");
    cartan_assert(bmp_p0_b == 200.0, "BMP Pixel (0,0) Blue must match 200.0");

    let bmp_p14_r = vision_get_pixel(loaded_bmp, 14.0, 10.0, 0.0);
    let bmp_p14_g = vision_get_pixel(loaded_bmp, 14.0, 10.0, 1.0);
    let bmp_p14_b = vision_get_pixel(loaded_bmp, 14.0, 10.0, 2.0);
    cartan_assert(bmp_p14_r == 240.0, "BMP Pixel (14,10) Red must match 240.0");
    cartan_assert(bmp_p14_g == 220.0, "BMP Pixel (14,10) Green must match 220.0");
    cartan_assert(bmp_p14_b == 200.0, "BMP Pixel (14,10) Blue must match 200.0");
    remove(bmp_file);
    printf("  -> [PASS] 24-bit uncompressed BMP round-trip verified with row-padding compensation.\n\n");

    // [3/5] Native 16-bit PCM RIFF/WAVE Audio Encoding & Decoding
    printf("[3/5] Verifying 16-bit PCM RIFF/WAVE Audio Encoding & Decoding...\n");
    let wav_file = "test_scratch_output.wav";
    let audio_buf = audio_create_buffer(256.0, 16000.0);
    var i = 0.0;
    let pi2 = 6.283185307179586;
    while (i < 256.0) {
        let t = i / 16000.0;
        let s = sin(pi2 * 440.0 * t);
        audio_set_sample(audio_buf, i, s);
        i = i + 1.0;
    }

    let save_wav_res = audio_save_wav(audio_buf, wav_file);
    cartan_assert(save_wav_res == 1.0, "audio_save_wav must return 1.0 on success");
    cartan_assert(cartan_file_exists(wav_file) == 1.0, "Saved WAV file must exist on disk");

    let loaded_wav = audio_load_wav(wav_file);
    cartan_assert(loaded_wav.length == 256.0, "Loaded WAV sample count must match 256.0");
    cartan_assert(loaded_wav.sample_rate == 16000.0, "Loaded WAV sample rate must match 16000.0");

    var max_sample_err = 0.0;
    i = 0.0;
    while (i < 256.0) {
        let s_orig = audio_get_sample(audio_buf, i);
        let s_load = audio_get_sample(loaded_wav, i);
        let diff = math_abs_val(s_load - s_orig);
        if (diff > max_sample_err) { max_sample_err = diff; }
        i = i + 1.0;
    }
    printf("  -> 16-bit PCM Max Quantization Error: %s\n", cartan_float_to_string(max_sample_err));
    cartan_assert(max_sample_err < 0.001, "PCM 16-bit quantization error must be < 0.001");
    remove(wav_file);
    printf("  -> [PASS] RIFF/WAVE round-trip confirmed with sub-milliradian precision.\n\n");

    // [4/5] Cross-Modal Stream Projection into Eikonal & Spectral Streams
    printf("[4/5] Verifying Cross-Modal Stream Projections (Eikonal & Spectral)...\n");
    let patch = vision_extract_patch(img_ppm, 0.0, 0.0, 16.0, 16.0);
    let eikonal_stream = vision_project_to_eikonal_stream(patch, 16.0 * 16.0 * 3.0, 320.0);
    cartan_assert(cartan_vec_len(eikonal_stream) == 320.0, "Eikonal stream vector must be 320-dim");

    let dft_spec = audio_compute_dft_spectrum(loaded_wav, 64.0);
    let spectral_stream = audio_project_to_spectral_stream(dft_spec, 64.0, 320.0);
    cartan_assert(cartan_vec_len(spectral_stream) == 320.0, "Spectral stream vector must be 320-dim");

    var eikonal_norm_sq = 0.0;
    var spectral_norm_sq = 0.0;
    i = 0.0;
    while (i < 320.0) {
        let ev = cartan_vec_get_f32(eikonal_stream, i);
        let sv = cartan_vec_get_f32(spectral_stream, i);
        eikonal_norm_sq = eikonal_norm_sq + ev * ev;
        spectral_norm_sq = spectral_norm_sq + sv * sv;
        i = i + 1.0;
    }
    cartan_assert(eikonal_norm_sq > 0.0, "Eikonal stream energy must be non-zero");
    cartan_assert(spectral_norm_sq > 0.0, "Spectral stream energy must be non-zero");
    printf("  -> [PASS] Patch and DFT projections yielded valid non-zero E8 coordinate streams.\n\n");

    // [5/5] Multimodal Hidden State Grounding & 42-Layer Manifold Step Execution
    printf("[5/5] Verifying Multimodal Grounding & 42-Layer Manifold Forward Step...\n");
    let h_initial = cartan_tensor_alloc(2560.0);
    i = 0.0;
    while (i < 2560.0) {
        cartan_vec_set_f32(h_initial, i, 0.1 * sin(i * 0.1));
        i = i + 1.0;
    }

    let ground_res = cartan_multimodal_ground_hidden(h_initial, eikonal_stream, spectral_stream);
    cartan_assert(ground_res == 1.0, "cartan_multimodal_ground_hidden must return 1.0");

    let h_stepped = e8_attention_forward_step(h_initial, 0.70);
    cartan_assert(h_stepped != 0.0, "e8_attention_forward_step must return valid hidden state ptr");

    var stepped_norm_sq = 0.0;
    i = 0.0;
    while (i < 2560.0) {
        let v = cartan_vec_get_f32(h_stepped, i);
        stepped_norm_sq = stepped_norm_sq + v * v;
        i = i + 1.0;
    }
    cartan_assert(stepped_norm_sq > 0.0, "Stepped hidden state manifold norm must be non-zero");
    printf("  -> Stepped Manifold State Norm: %s\n", cartan_float_to_string(sqrt(stepped_norm_sq)));
    printf("  -> [PASS] 42-layer manifold forward pass executed smoothly with multimodal grounding.\n\n");

    printf("=================================================================================\n");
    printf("  TARGET 58 VERIFICATION COMPLETE: ALL MULTIMODAL I/O TESTS PASSED (5/5)!\n");
    printf("=================================================================================\n");
    return 0.0;
}
