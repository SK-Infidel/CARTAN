// test/compiler_suite/test_async_coroutines.car
// CARTAN Regression Target [18/18]: First-Class Async/Await Coroutines & Event Loop Pass
// // run-pass

include "src/std/async.cl";

extern fn printf(fmt: string, s: string) -> float;
extern fn cartan_assert(cond: float, msg: string) -> float;

var g_worker_ran = 0.0;

fn async_worker(param: ptr) -> float {
    g_worker_ran = 42.0;
    return 0.0;
}

fn main(argc: float, argv: ptr) -> float {
    printf("Starting async coroutine regression test...\n", "");

    // Test 1: Null task spawn (fallback/noop handle)
    let null_id = cartan_async_spawn(0.0);
    cartan_assert(null_id >= 1.0, "cartan_async_spawn null failed");

    // Test 2: Authentic native thread worker spawn
    let task_id = cartan_async_spawn(async_worker);
    cartan_assert(task_id >= 2.0, "cartan_async_spawn worker failed");

    // Test 3: Cooperative yield
    let y = cartan_async_yield();
    cartan_assert(y == 1.0, "cartan_async_yield failed");

    // Test 4: Synchronous await on worker completion
    let res = cartan_async_await(task_id);
    cartan_assert(res == 1.0, "cartan_async_await failed");
    cartan_assert(g_worker_ran == 42.0, "Async worker did not execute or update state");

    // Test 5: Await null task
    let res_null = cartan_async_await(null_id);
    cartan_assert(res_null == 1.0, "cartan_async_await null task failed");

    printf("PASS: Authentic async coroutine and native thread execution verified cleanly!\n", "");
    return 0.0;
}
