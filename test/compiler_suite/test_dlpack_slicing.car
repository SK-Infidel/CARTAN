// test/compiler_suite/test_dlpack_slicing.car
// // run-pass
// Sprint 8 Test Target: DLPack Zero-Copy Interop & Multi-Dimensional Strided Slicing

include "src/cartanc/ast.ch";
include "src/std/collections.cl";
include "src/std/tensor.cl";

extern fn printf(fmt: string, v: float) -> float;
extern fn cartan_flush(v: float) -> float;

fn main() -> float {
    let t = cartan_tree_create();
    cartan_tree_push(t, 10.0);
    cartan_tree_push(t, 20.0);
    cartan_tree_push(t, 30.0);
    cartan_tree_push(t, 40.0);
    cartan_tree_push(t, 50.0);

    let sliced = cartan_slice_nd(t, 0.0, 5.0, 2.0);
    let len = cartan_tree_len(sliced);
    printf("Sliced tree length: %f\n", len);

    let dlpack_handle = cartan_tensor_to_dlpack(t, 0.0, 1.0);
    let restored_ptr = cartan_tensor_from_dlpack(dlpack_handle);
    if (restored_ptr != 0.0) {
        printf("DLPack zero-copy roundtrip succeeded!\n", 0.0);
    }

    cartan_flush(0.0);
    return 0.0;
}
