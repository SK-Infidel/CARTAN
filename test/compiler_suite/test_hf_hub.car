// CARTAN Compiler Suite: Test HuggingFace Model Hub & Safetensors Pipeline
include "../../src/std/hub.car";

fn main() -> float {
    printf("[test_hf_hub] Initializing HuggingFace Model Hub & Safetensors Pipeline verification...\n");
    let tok = hub_autotokenizer_from_pretrained("cartan-ai/llama-3-8b");
    static_assert(tok.vocab_size == 32000.0, "AutoTokenizer vocab size must match 32000");

    let model = hub_automodel_from_pretrained("cartan-ai/llama-3-8b");
    static_assert(model.num_layers == 32.0, "AutoModel layer count must match 32");

    let header = hub_load_safetensors("cache_model.safetensors");
    static_assert(cartan_tree_len(header) > 0.0, "Safetensors header must contain tensors");

    let ds = hub_load_dataset("tatsu-lab/alpaca", "train");
    static_assert(ds.num_samples == 1000.0, "Dataset sample count must match 1000");

    printf("[test_hf_hub] PASSED: HuggingFace Model Hub, Datasets & Safetensors Pipeline fully verified.\n");
    return 0.0;
}
