// test/compiler_suite/test_language_acquisition_cloze.car
// Verification Suite: Staged Language Acquisition & Attention-Trigger Cloze Engine

include "src/std/language_acquisition.cl";
include "test/geomind/cloze_engine.cl";
include "src/std/string.cl";
include "src/std/math.cl";

extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn cartan_float_to_string(v: float) -> string;
extern fn cartan_string_eq(s1: string, s2: string) -> float;

fn main() -> float {
    printf("=================================================================================\n");
    printf("  CARTAN TEST SUITE: STAGED LANGUAGE ACQUISITION & CLOZE ARCHITECTURE VERIFICATION\n");
    printf("=================================================================================\n\n");

    // [1/5] High-Frequency Noun-Noun Bigrams Taxonomy
    printf("[1/5] Verifying High-Frequency Noun-Noun Bigrams Taxonomy (100 pairs)...\n");
    lang_init_taxonomies();
    let p1 = lang_get_noun_pair(1.0);
    cartan_assert(cartan_string_eq(p1, "Health care") == 1.0, "Noun pair 1 must be Health care");
    let p10 = lang_get_noun_pair(10.0);
    cartan_assert(cartan_string_eq(p10, "Water bottle") == 1.0, "Noun pair 10 must be Water bottle");
    let p100 = lang_get_noun_pair(100.0);
    cartan_assert(cartan_string_eq(p100, "Drug addiction") == 1.0, "Noun pair 100 must be Drug addiction");
    cartan_assert(lang_is_registered_phrase("Credit card") == 1.0, "Credit card must be registered");
    let w_noun = lang_calculate_anchor_weight("Social media");
    cartan_assert(w_noun == 1.50, "Noun pair anchor weight must be 1.50");
    printf("  Noun-Noun taxonomy verified: %s ... %s (Count: 100)\n", p1, p100);
    printf("[1/5] High-Frequency Noun-Noun Bigrams assertions PASSED.\n\n");

    // [2/5] Binomial Non-Reversible Structural Pairs across 4 Categories
    printf("[2/5] Verifying Binomial Non-Reversible Structural Pairs (100 pairs across 4 categories)...\n");
    let b1 = lang_get_binomial_pair(1.0);
    cartan_assert(cartan_string_eq(b1, "Law and order") == 1.0, "Binomial pair 1 must be Law and order");
    cartan_assert(cartan_string_eq(lang_get_binomial_category(1.0), "Noun+Noun") == 1.0, "Category must be Noun+Noun");
    let b42 = lang_get_binomial_pair(42.0);
    cartan_assert(cartan_string_eq(b42, "Black and white") == 1.0, "Binomial pair 42 must be Black and white");
    cartan_assert(cartan_string_eq(lang_get_binomial_category(42.0), "Adjective+Adjective") == 1.0, "Category must be Adjective+Adjective");
    let b68 = lang_get_binomial_pair(68.0);
    cartan_assert(cartan_string_eq(b68, "Give and take") == 1.0, "Binomial pair 68 must be Give and take");
    cartan_assert(cartan_string_eq(lang_get_binomial_category(68.0), "Verb+Verb") == 1.0, "Category must be Verb+Verb");
    let b88 = lang_get_binomial_pair(88.0);
    cartan_assert(cartan_string_eq(b88, "Back and forth") == 1.0, "Binomial pair 88 must be Back and forth");
    cartan_assert(cartan_string_eq(lang_get_binomial_category(88.0), "Adverbial/Contrastive") == 1.0, "Category must be Adverbial/Contrastive");
    let w_bin = lang_calculate_anchor_weight("Peace and quiet");
    cartan_assert(w_bin == 1.80, "Binomial anchor weight must be 1.80");
    printf("  Binomial pairs verified across 4 categories (Count: 100)\n");
    printf("[2/5] Binomial Non-Reversible Pairs assertions PASSED.\n\n");

    // [3/5] Functional Discourse Markers & Social Rituals
    printf("[3/5] Verifying Functional Discourse Markers & Social Rituals (100 triggers)...\n");
    let d1 = lang_get_discourse_marker(1.0);
    cartan_assert(cartan_string_eq(d1, "Thank you") == 1.0, "Discourse marker 1 must be Thank you");
    cartan_assert(cartan_string_eq(lang_get_discourse_category(1.0), "Social Rituals & Politeness") == 1.0, "Category must be Social Rituals & Politeness");
    let d16 = lang_get_discourse_marker(16.0);
    cartan_assert(cartan_string_eq(d16, "By the way") == 1.0, "Discourse marker 16 must be By the way");
    cartan_assert(cartan_string_eq(lang_get_discourse_category(16.0), "Discourse Markers & Managing Conversation") == 1.0, "Category must be Discourse Markers & Managing Conversation");
    let d36 = lang_get_discourse_marker(36.0);
    cartan_assert(cartan_string_eq(d36, "Of course") == 1.0, "Discourse marker 36 must be Of course");
    cartan_assert(cartan_string_eq(lang_get_discourse_category(36.0), "Expressing Agreement, Certainty, & Doubt") == 1.0, "Category must be Agreement");
    let d56 = lang_get_discourse_marker(56.0);
    cartan_assert(cartan_string_eq(d56, "I want to") == 1.0, "Discourse marker 56 must be I want to");
    cartan_assert(cartan_string_eq(lang_get_discourse_category(56.0), "Expressing Desires, Intentions, & Requests") == 1.0, "Category must be Requests");
    let d75 = lang_get_discourse_marker(75.0);
    cartan_assert(cartan_string_eq(d75, "Oh my god") == 1.0, "Discourse marker 75 must be Oh my god");
    cartan_assert(cartan_string_eq(lang_get_discourse_category(75.0), "Emotional Responses & Empathy") == 1.0, "Category must be Empathy");
    let w_disc = lang_calculate_anchor_weight("By the way");
    cartan_assert(w_disc == 2.00, "Discourse anchor weight must be 2.00");
    printf("  Discourse markers verified across 5 functional categories (Count: 100)\n");
    printf("[3/5] Functional Discourse Markers assertions PASSED.\n\n");

    // [4/5] Narrative Progression & Structural Transition Bridges
    printf("[4/5] Verifying Narrative Progression & Structural Transition Bridges (100 bridges)...\n");
    let t1 = lang_get_transition_bridge(1.0);
    cartan_assert(cartan_string_eq(t1, "As previously mentioned") == 1.0, "Bridge 1 must be As previously mentioned");
    let t9 = lang_get_transition_bridge(9.0);
    cartan_assert(cartan_string_eq(t9, "Consequently") == 1.0, "Bridge 9 must be Consequently");
    let t64 = lang_get_transition_bridge(64.0);
    cartan_assert(cartan_string_eq(t64, "Long story short") == 1.0, "Bridge 64 must be Long story short");
    let t100 = lang_get_transition_bridge(100.0);
    cartan_assert(cartan_string_eq(t100, "In light of this") == 1.0, "Bridge 100 must be In light of this");
    let w_bridge = lang_calculate_anchor_weight("Consequently");
    cartan_assert(w_bridge == 2.50, "Bridge anchor weight must be 2.50");
    printf("  Transition bridges verified (Count: 100)\n");
    printf("[4/5] Narrative Transition Bridges assertions PASSED.\n\n");

    // [5/5] Authentic BPE Cloze Loss & Riemannian Natural Gradient Optimization
    printf("[5/5] Verifying Authentic BPE Cloze Loss & Riemannian Natural Gradient Optimization...\n");
    let loss_bridge = geomind_cloze_eval_bridge("The company was facing insolvency. [BLANK], they were completely broke.", "In other words");
    cartan_assert(loss_bridge > 0.0, "Anchored cloze bridge loss must be positive float");
    printf("  Evaluated authentic antecedent bridge cloze loss: %s\n", cartan_float_to_string(loss_bridge));

    let loss_sent = geomind_cloze_eval_finish_sentence("The engine reached peak temperature. Consequently, ", "cooling procedures were initiated.");
    cartan_assert(loss_sent > 0.0, "Finish-the-sentence continuation loss must be positive float");
    printf("  Evaluated authentic finish-the-sentence loss: %s\n", cartan_float_to_string(loss_sent));

    let curr_pass = geomind_cloze_run_curriculum_pass();
    cartan_assert(curr_pass == 1.0, "Curriculum pass must return 1.0");
    printf("[5/5] Authentic Cloze Optimization assertions PASSED.\n\n");

    printf("TEST_LANGUAGE_ACQUISITION_CLOZE_SUCCESS\n\n");
    return 0.0;
}
