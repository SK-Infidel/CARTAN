// test/compiler_suite/test_physics_geom_advanced.car
// CARTAN Regression Target [23/23]: Advanced 3D Geometry, Adaptive Calculus & N-Body Physics Pass
// // run-pass

include "../../src/std/constants.ch";
include "../../src/std/geom.car";
include "../../src/std/calculus.car";
include "../../src/std/physics.car";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    let d3 = geom::distance_3d(0.0, 0.0, 0.0, 1.0, 2.0, 2.0);
    cartan_assert(d3 == 3.0, "geom::distance_3d failed");

    let qn = geom::quaternion_norm(1.0, 0.0, 0.0, 0.0);
    cartan_assert(qn == 1.0, "geom::quaternion_norm failed");

    let adapt_step = calculus::rkf45_adaptive_step(1.0, 0.1, 0.01);
    cartan_assert(adapt_step > 0.0, "calculus::rkf45_adaptive_step failed");

    let df = calculus::finite_difference_derivative(2.0, 4.0, 1.0);
    cartan_assert(df == 2.0, "calculus::finite_difference_derivative failed");

    let p = physics::momentum(5.0, 10.0);
    cartan_assert(p == 50.0, "physics::momentum failed");

    let acc = physics::nbody_gravitational_acceleration(1.0e10, 10.0);
    cartan_assert(acc > 0.0, "physics::nbody_gravitational_acceleration failed");

    return 0.0;
}
