// CARTAN Compiler Suite: Test Target [42/42]
// Phase 16 WordNet/SlangNet Taxonomy & Information Content (IC) Loss Scaling Engine

include "src/std/semantics.cl";
include "src/std/tokenizer.cl";
include "src/std/distill.cl";

fn main() -> float {
    printf("==================================================\n");
    printf("  CARTAN COMPILER SUITE: TEST TARGET [42/42]\n");
    printf("  Phase 16 WordNet Taxonomy & IC Loss Engine\n");
    printf("==================================================\n");

    let p1 = "entity.physical_entity.object.organism.canine.dog";
    let p2 = "entity.physical_entity.object.organism.canine.wolf";

    let depth1 = semantics_dot_path_depth(p1);
    let depth2 = semantics_dot_path_depth(p2);
    let tree_dist = semantics_lca_tree_distance(p1, p2);

    printf("[Test Target 42] Path 1 Depth: %s\n", cartan_float_to_string(depth1));
    printf("[Test Target 42] Path 2 Depth: %s\n", cartan_float_to_string(depth2));
    printf("[Test Target 42] LCA Tree Distance: %s\n", cartan_float_to_string(tree_dist));

    let base_loss = 1.5;
    let stop_word_loss = tokenizer_scale_ic_loss(base_loss, 1.0); // Stop-word
    let domain_word_loss = tokenizer_scale_ic_loss(base_loss, 35.0); // Domain term "gas."

    printf("[Test Target 42] Stop-Word Scaled Loss: %s\n", cartan_float_to_string(stop_word_loss));
    printf("[Test Target 42] Domain Term Scaled Loss: %s\n", cartan_float_to_string(domain_word_loss));

    let hierarchy_loss = distill_sparse_hierarchy_loss(tree_dist, 2.0, 1.0);
    printf("[Test Target 42] Top-K Sparse Hierarchy Loss Penalty: %s\n", cartan_float_to_string(hierarchy_loss));

    if (depth1 == 6.0 && stop_word_loss == 0.75 && domain_word_loss == 3.75) {
        printf("[Test Target 42] WordNet Taxonomy & IC Loss Engine PASSED cleanly.\n");
        return 0.0;
    }
    printf("[Test Target 42] ERROR: Assertion mismatch.\n");
    return 1.0;
}
