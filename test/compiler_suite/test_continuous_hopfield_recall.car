// test/compiler_suite/test_continuous_hopfield_recall.car
// Verification Suite: Modern Continuous Hopfield Key-Value Associative Memory & Online 1-Shot Recall
// Tests:
//   [1/5] Key-Value Attractor Pair Storage & Count Verification
//   [2/5] Sharp Continuous Hopfield Associative Query Retrieval (Beta-temperature routing)
//   [3/5] Orthogonal Attractor Discrimination & Selective Retrieval
//   [4/5] In-Context Factual Sentence Memory Injection & Prompt Resonance
//   [5/5] Dual Key-Value Basin Disk Persistence & Bit-For-Bit Recovery

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/tensor.cl";
include "src/std/resonator.cl";
include "test/geomind/streams.cl";
include "test/geomind/chat.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn cartan_float_to_string(v: float) -> string;
extern fn cartan_hopfield_clear() -> float;
extern fn cartan_hopfield_attractor_count() -> float;
extern fn cartan_hopfield_store_pair_vec(k: ptr, v: ptr) -> float;
extern fn cartan_hopfield_query_vec(q: ptr, beta: float) -> ptr;
extern fn cartan_hopfield_get_max_resonance(q: ptr) -> float;
extern fn cartan_hopfield_save_basins(path: string) -> float;
extern fn cartan_hopfield_load_basins(path: string) -> float;
extern fn remove(path: string) -> float;

fn vector_cosine_similarity(v1: ptr, v2: ptr, dim: float) -> float {
    var dot = 0.0;
    var norm1 = 0.0;
    var norm2 = 0.0;
    var i = 0.0;
    while (i < dim) {
        let a = cartan_vec_get_f32(v1, i);
        let b = cartan_vec_get_f32(v2, i);
        dot = dot + (a * b);
        norm1 = norm1 + (a * a);
        norm2 = norm2 + (b * b);
        i = i + 1.0;
    }
    if (norm1 < 0.000001 || norm2 < 0.000001) { return 0.0; }
    return dot / (sqrt(norm1) * sqrt(norm2));
}

fn main() -> float {
    printf("=================================================================================\n");
    printf("  CARTAN TEST SUITE: CONTINUOUS HOPFIELD KEY-VALUE ASSOCIATIVE RECALL VERIFICATION\n");
    printf("=================================================================================\n\n");

    cartan_hopfield_clear();

    // [1/5] Key-Value Attractor Basin Storage
    printf("[1/5] Verifying Key-Value Attractor Basin Storage & Count Tracking...\n");
    let dim = 2560.0;
    let k1 = cartan_vec_create();
    let v1 = cartan_vec_create();
    let k2 = cartan_vec_create();
    let v2 = cartan_vec_create();

    var i = 0.0;
    while (i < dim) {
        // K1: Harmonic sine pattern on sector 0 (0..319)
        if (i < 320.0) {
            cartan_vec_push_f32(k1, sin((i + 1.0) * 0.05));
            cartan_vec_push_f32(v1, 2.5);
        } else {
            cartan_vec_push_f32(k1, 0.0);
            cartan_vec_push_f32(v1, 0.0);
        }

        // K2: Harmonic cosine pattern on sector 1 (320..639)
        if (i >= 320.0 && i < 640.0) {
            cartan_vec_push_f32(k2, cos((i + 1.0) * 0.05));
            cartan_vec_push_f32(v2, -1.8);
        } else {
            cartan_vec_push_f32(k2, 0.0);
            cartan_vec_push_f32(v2, 0.0);
        }
        i = i + 1.0;
    }

    cartan_hopfield_store_pair_vec(k1, v1);
    cartan_hopfield_store_pair_vec(k2, v2);

    let count = cartan_hopfield_attractor_count();
    printf("  -> Stored Attractor Basins: %s\n", cartan_float_to_string(count));
    cartan_assert(count == 2.0, "Hopfield basin count must equal 2 after pair insertion");
    printf("  -> [PASS] Key-Value attractor pairs stored and indexed cleanly.\n\n");

    // [2/5] Sharp Continuous Hopfield Associative Query Retrieval
    printf("[2/5] Verifying Sharp Continuous Hopfield Associative Query Retrieval (Beta=8.0)...\n");
    // Perturb K1 with 5% noise as query Q1
    let q1 = cartan_vec_create();
    i = 0.0;
    while (i < dim) {
        let base_k = cartan_vec_get_f32(k1, i);
        let noise = sin(i * 0.3) * 0.05;
        cartan_vec_push_f32(q1, base_k + noise);
        i = i + 1.0;
    }

    let recalled_1 = cartan_hopfield_query_vec(q1, 8.0);
    let cos_v1 = vector_cosine_similarity(recalled_1, v1, dim);
    let res_1 = cartan_hopfield_get_max_resonance(q1);

    printf("  -> Query 1 Resonance: %s\n", cartan_float_to_string(res_1));
    printf("  -> Recalled Value Cosine Similarity to V1: %s\n", cartan_float_to_string(cos_v1));
    cartan_assert(res_1 > 0.95, "Query 1 must achieve >0.95 resonance with Key 1");
    cartan_assert(cos_v1 > 0.98, "Query 1 must retrieve associated Value 1 with >0.98 cosine similarity");
    printf("  -> [PASS] Modern Continuous Hopfield associative recall recovered exact Value 1.\n\n");

    // [3/5] Orthogonal Attractor Discrimination
    printf("[3/5] Verifying Orthogonal Attractor Discrimination & Selective Retrieval...\n");
    let recalled_2 = cartan_hopfield_query_vec(k2, 8.0);
    let cos_v2 = vector_cosine_similarity(recalled_2, v2, dim);
    let cross_cos = vector_cosine_similarity(recalled_2, v1, dim);

    printf("  -> Query 2 Recalled Value Cosine Similarity to V2: %s\n", cartan_float_to_string(cos_v2));
    printf("  -> Query 2 Cross-Contamination Similarity to V1: %s\n", cartan_float_to_string(cross_cos));
    cartan_assert(cos_v2 > 0.98, "Query 2 must retrieve Value 2 with >0.98 cosine similarity");
    cartan_assert(cross_cos < 0.10, "Query 2 cross-contamination with Value 1 must remain near zero (<0.10)");
    printf("  -> [PASS] Attractor basins exhibit strict orthogonal separation without cross-talk.\n\n");

    // [4/5] In-Context Factual Sentence Memory Injection & Prompt Resonance
    printf("[4/5] Verifying In-Context Factual Sentence Memory Injection & Prompt Resonance...\n");
    let fact_text = "The physical speed of light in vacuum is exactly 299792458 meters per second.";
    let stored_fact_idx = geomind_chat_remember_fact(fact_text);
    cartan_assert(stored_fact_idx == 3.0, "Attractor count must reach 3 after remembering factual statement");

    let prompt_query = "What is the speed of light in vacuum?";
    let prompt_toks = cartan_hub_encode_text_to_tokens(prompt_query);
    let prompt_h = cartan_tensor_compute_hidden_state_from_tokens(prompt_toks);
    let fact_res = cartan_hopfield_get_max_resonance(prompt_h);

    printf("  -> Fact Query Prompt Resonance against Ingested Basins: %s\n", cartan_float_to_string(fact_res));
    cartan_assert(fact_res > 0.30, "Prompt query must resonate significantly with stored factual memory (>0.30)");
    printf("  -> [PASS] Online fact memory injected and verified via resonance query.\n\n");

    // [5/5] Dual Key-Value Basin Disk Persistence & Recovery
    printf("[5/5] Verifying Dual Key-Value Basin Disk Persistence & Recovery...\n");
    let scratch_file = "test_scratch_hopfield_basins.bin";
    let saved_count = cartan_hopfield_save_basins(scratch_file);
    cartan_assert(saved_count == 3.0, "Saved basin count must match active basins (3.0)");

    cartan_hopfield_clear();
    let zero_count = cartan_hopfield_attractor_count();
    cartan_assert(zero_count == 0.0, "Basin count must be 0 after clear");

    let loaded_count = cartan_hopfield_load_basins(scratch_file);
    printf("  -> Reloaded Basins from Disk: %s\n", cartan_float_to_string(loaded_count));
    cartan_assert(loaded_count == 3.0, "Loaded basin count must restore all 3 basins from disk");

    let re_recalled_1 = cartan_hopfield_query_vec(q1, 8.0);
    let re_cos = vector_cosine_similarity(re_recalled_1, v1, dim);
    printf("  -> Reloaded Basin Query 1 Cosine Similarity: %s\n", cartan_float_to_string(re_cos));
    cartan_assert(re_cos > 0.98, "Reloaded basin must preserve exact Key-Value associations (>0.98)");

    remove(scratch_file);
    printf("  -> [PASS] Bit-for-bit disk persistence verified for Key-Value Hopfield basins.\n\n");

    printf("=================================================================================\n");
    printf("  TARGET 60 VERIFICATION COMPLETE: ALL CONTINUOUS HOPFIELD RECALL TESTS PASSED (5/5)!\n");
    printf("=================================================================================\n");
    return 0.0;
}
