// Target 81: NSES Software Engineering, Application Programming & Algorithms Domain (Domain 18) Regression Test
// Empirical regression test verifying:
// 1. Ingestion of 19 cognitive domains (Domains 0..18) with >= 172 rules and >= 38 strict invariants.
// 2. Strict invariant and relational rule verification for Domain 18:
//    - Rule 162: Design by Contract Invariant (Hoare contract {P} C {Q})
//    - Rule 163: Algorithmic Termination and Bounded Space Invariant
//    - Rules 164..171: Idempotence, Interface Segregation, Deadlock Freedom, Input Sanitization,
//      Amortized Complexity, Idempotent Retry, Cache Locality, Structural Subtyping.
// 3. Stage 1 intent detection routing for Domain 18.
// 4. Stage 3 seed node selection (162.0) and CSR graph traversal across software engineering bridges.
// 5. Post-pass deterministic Veto Gate verification (Veto Rule 23: Software Engineering Anti-Patterns).
// 6. Contradiction token registration and logit penalty shaping (tokens 1801.0..1804.0).
// 7. Domain lexicon discourse framing (Frame 18: [Software Engineering Frame]) and category error enforcement.
// 8. Burroughs lateral prime sampling across tiers 1..3 for Domain 18 (fragments 49, 50, 51).
// 9. Dynamic gamma baseline computation for Domain 18 (b * 1.25).

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";
include "src/std/guardrails.cl";
include "src/std/csr_graph.cl";
include "src/std/plasticity.cl";
include "src/std/burroughs.cl";
include "src/std/prompt_scaffold.cl";
include "src/std/veto_gate.cl";
include "src/std/domain_lexicon.cl";
include "src/std/dynamic_gamma.cl";
include "src/std/nses_pipeline.cl";
include "src/std/saliency_attractor.cl";
include "src/std/resonator.cl";

extern fn printf(fmt: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn exit(code: float) -> void;

fn main() -> float {
    printf("=====================================================================\n");
    printf("  Target 81: NSES Domain 18 (Software Engineering & Algorithms)\n");
    printf("=====================================================================\n\n");
    cartan_flush(0.0);

    let graph_path = "test/geomind/trainingdata/nses_knowledge.car_graph";
    let cg = cargraph_load_binary(graph_path);
    if (cg.is_valid == 0.0) {
        printf("FAILED: Could not load knowledge graph at: %s\n", graph_path);
        cartan_flush(0.0);
        exit(1.0);
    }
    printf("[PASS] Loaded universal knowledge graph from: %s\n", graph_path);
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // 1. Verify Knowledge Graph Metrics & Domain 18 Header Allocation
    // -------------------------------------------------------------------------
    printf("Verifying Knowledge Architecture Metrics with Domain 18...\n");
    printf("  Total Domains: %.0f (expected >= 19)\n", cg.header.num_domains);
    printf("  Total Rules: %.0f (expected >= 172)\n", cg.header.num_rules);
    printf("  Strict Invariants: %.0f (expected >= 38)\n", cg.header.num_strict_rules);
    cartan_flush(0.0);

    if (cg.header.num_domains < 19.0 || cg.header.num_rules < 172.0 || cg.header.num_strict_rules < 38.0) {
        printf("FAILED: Domain 18 knowledge graph header counts mismatch\n");
        cartan_flush(0.0);
        exit(1.0);
    }

    // -------------------------------------------------------------------------
    // 2. Verify Rules 162..171 in Domain 18
    // -------------------------------------------------------------------------
    printf("Verifying Domain 18 Invariant and Relational Rules...\n");
    let rule162 = cargraph_get_rule_text(cg, 162.0); // Design by Contract Invariant
    let rule163 = cargraph_get_rule_text(cg, 163.0); // Algorithmic Termination
    let rule164 = cargraph_get_rule_text(cg, 164.0); // Idempotence & Pure Function
    let rule165 = cargraph_get_rule_text(cg, 165.0); // Interface Segregation
    let rule166 = cargraph_get_rule_text(cg, 166.0); // Deadlock Freedom
    let rule167 = cargraph_get_rule_text(cg, 167.0); // Defensive Input Sanitization
    let rule168 = cargraph_get_rule_text(cg, 168.0); // Amortized Complexity
    let rule169 = cargraph_get_rule_text(cg, 169.0); // Idempotent Retry
    let rule170 = cargraph_get_rule_text(cg, 170.0); // Cache Locality & SoA Layout
    let rule171 = cargraph_get_rule_text(cg, 171.0); // Structural Subtyping

    printf("  Rule 162: %s\n", rule162);
    printf("  Rule 163: %s\n", rule163);
    printf("  Rule 166: %s\n", rule166);
    printf("  Rule 168: %s\n", rule168);
    printf("  Rule 170: %s\n", rule170);
    cartan_flush(0.0);

    if (cartan_string_contains(rule162, "Design by Contract Invariant") == 0.0 ||
        cartan_string_contains(rule163, "Algorithmic Termination and Bounded Space") == 0.0 ||
        cartan_string_contains(rule164, "Idempotence & Pure Function") == 0.0 ||
        cartan_string_contains(rule165, "Interface Segregation") == 0.0 ||
        cartan_string_contains(rule166, "Deadlock Freedom") == 0.0 ||
        cartan_string_contains(rule167, "Defensive Input Sanitization") == 0.0 ||
        cartan_string_contains(rule168, "Amortized Complexity") == 0.0 ||
        cartan_string_contains(rule169, "Idempotent Retry") == 0.0 ||
        cartan_string_contains(rule170, "Cache Locality") == 0.0 ||
        cartan_string_contains(rule171, "Structural Subtyping") == 0.0) {
        printf("FAILED: Domain 18 rule textual content mismatch\n");
        cartan_flush(0.0);
        exit(1.0);
    }
    printf("[PASS] Rules 162..171 rigorously validated.\n\n");
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // 3. Pipeline Intent Routing for Domain 18
    // -------------------------------------------------------------------------
    printf("Verifying Pipeline Intent Routing for Domain 18...\n");
    let pipe = nses_pipeline_create(graph_path);
    if (pipe.is_ready == 0.0) {
        printf("FAILED: NSES Pipeline failed to initialize\n");
        cartan_flush(0.0);
        exit(1.0);
    }

    let res_sw = nses_pipeline_execute_turn(pipe, "How do we structure software contracts and prevent deadlock in algorithms?", 1.0, "clean candidate");
    printf("  Query routed to Domain: %.0f (expected 18)\n", res_sw.active_domain);
    cartan_flush(0.0);
    if (res_sw.active_domain != 18.0) {
        printf("FAILED: Pipeline failed to route software engineering query to Domain 18\n");
        cartan_flush(0.0);
        exit(1.0);
    }

    let res_prog = nses_pipeline_execute_turn(pipe, "Explain defensive programming and data_structure cache locality.", 1.0, "clean candidate");
    printf("  Programming query routed to Domain: %.0f (expected 18)\n", res_prog.active_domain);
    cartan_flush(0.0);
    if (res_prog.active_domain != 18.0) {
        printf("FAILED: Programming query failed to route to Domain 18\n");
        cartan_flush(0.0);
        exit(1.0);
    }
    printf("[PASS] Stage 1 intent detection correctly routes to Domain 18.\n\n");
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // 4. CSR Semantic Topology Traversal & Memory Grounding
    // -------------------------------------------------------------------------
    printf("Verifying CSR Graph Traversal from Seed Node 162.0...\n");
    let seeds = collections_create_list();
    let acts = collections_create_list();
    collections_list_push(seeds, 162.0); // Seed: Rule 162 (Design by Contract)
    collections_list_push(acts, 1.0);

    let pad = nses_scratchpad_create(256.0, 256.0);
    let trav_count = csr_traverse_bfs(pipe.csr, pad, seeds, acts, 2.0, 0.50, 0.85, 0.0);
    printf("  CSR BFS from Rule 162 traversed: %.0f nodes\n", trav_count);
    cartan_flush(0.0);
    if (trav_count < 2.0) {
        printf("FAILED: CSR graph traversal did not reach target node breadth\n");
        cartan_flush(0.0);
        exit(1.0);
    }
    collections_free_list(seeds);
    collections_free_list(acts);
    nses_scratchpad_free(pad);
    printf("[PASS] CSR semantic topology traversal operational from seed 162.0.\n\n");
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // 5. Post-Pass Deterministic Veto Gate (Veto Rule 23: Anti-Patterns)
    // -------------------------------------------------------------------------
    printf("Verifying Veto Gate Rule 23 (Software Engineering Anti-Patterns)...\n");
    let v_reg = pipe.veto_reg;

    let v_cand1 = "This lock acquisition protocol may cause a circular wait deadlock among workers.";
    let v_res1 = veto_gate_scan(v_reg, v_cand1);
    printf("  Deadlock candidate vetoed: %.0f (expected 1.0), Rule ID: %.0f (expected 23)\n", v_res1.is_vetoed, v_res1.violated_rule_id);
    if (v_res1.is_vetoed != 1.0 || v_res1.violated_rule_id != 23.0) {
        printf("FAILED: Veto Gate failed to catch circular wait deadlock\n");
        exit(1.0);
    }

    let v_cand2 = "Infinite recursion triggers an unbounded recursive stack overflow in execution.";
    let v_res2 = veto_gate_scan(v_reg, v_cand2);
    printf("  Stack overflow candidate vetoed: %.0f (expected 1.0), Rule ID: %.0f (expected 23)\n", v_res2.is_vetoed, v_res2.violated_rule_id);
    if (v_res2.is_vetoed != 1.0 || v_res2.violated_rule_id != 23.0) {
        printf("FAILED: Veto Gate failed to catch unbounded recursive stack overflow\n");
        exit(1.0);
    }

    let v_cand3 = "The routine terminates while violating method postcondition contract bounds.";
    let v_res3 = veto_gate_scan(v_reg, v_cand3);
    printf("  Postcondition breach vetoed: %.0f (expected 1.0), Rule ID: %.0f (expected 23)\n", v_res3.is_vetoed, v_res3.violated_rule_id);
    if (v_res3.is_vetoed != 1.0 || v_res3.violated_rule_id != 23.0) {
        printf("FAILED: Veto Gate failed to catch violating method postcondition contract\n");
        exit(1.0);
    }

    let v_cand4 = "Accepting input directly results in unvalidated external buffer indexing.";
    let v_res4 = veto_gate_scan(v_reg, v_cand4);
    printf("  Unvalidated buffer indexing vetoed: %.0f (expected 1.0), Rule ID: %.0f (expected 23)\n", v_res4.is_vetoed, v_res4.violated_rule_id);
    if (v_res4.is_vetoed != 1.0 || v_res4.violated_rule_id != 23.0) {
        printf("FAILED: Veto Gate failed to catch unvalidated external buffer indexing\n");
        exit(1.0);
    }

    let v_cand_clean = "Formal contracts and total lock ordering guarantee deadlock-free termination.";
    let v_res_clean = veto_gate_scan(v_reg, v_cand_clean);
    if (v_res_clean.is_vetoed != 0.0) {
        printf("FAILED: Veto Gate falsely flagged valid software engineering proposition\n");
        exit(1.0);
    }
    printf("[PASS] Veto Gate Rule 23 passed all anti-pattern tests.\n\n");

    // -------------------------------------------------------------------------
    // 6. Contradiction Token Registration & Logit Penalty Shaping
    // -------------------------------------------------------------------------
    printf("Verifying Contradiction Tokens 1801.0..1804.0 for Domain 18...\n");
    let f_toks = veto_registry_get_forbidden_tokens(v_reg, 18.0);
    let n_toks = cartan_vec_len(f_toks);
    printf("  Domain 18 registered forbidden token count: %.0f (expected 4)\n", n_toks);
    if (n_toks != 4.0) {
        printf("FAILED: Domain 18 should have exactly 4 contradiction tokens registered\n");
        exit(1.0);
    }

    let t1 = cartan_vec_get_f32(f_toks, 0.0);
    let t2 = cartan_vec_get_f32(f_toks, 1.0);
    let t3 = cartan_vec_get_f32(f_toks, 2.0);
    let t4 = cartan_vec_get_f32(f_toks, 3.0);
    printf("  Tokens: %.0f, %.0f, %.0f, %.0f\n", t1, t2, t3, t4);
    if (t1 != 1801.0 || t2 != 1802.0 || t3 != 1803.0 || t4 != 1804.0) {
        printf("FAILED: Contradiction token IDs do not match 1801..1804\n");
        exit(1.0);
    }

    // Verify logit penalty shaping on mock logits vector
    let mock_logits = cartan_vec_create();
    var li = 0.0;
    while (li < 1900.0) {
        cartan_vec_push_f32(mock_logits, 2.0);
        li = li + 1.0;
    }

    let penalty = veto_compute_symbolic_loss_penalty(v_reg, 18.0, mock_logits, f_toks, 0.20);
    let l1801 = cartan_vec_get_f32(mock_logits, 1801.0);
    let l1802 = cartan_vec_get_f32(mock_logits, 1802.0);
    let l1803 = cartan_vec_get_f32(mock_logits, 1803.0);
    let l1804 = cartan_vec_get_f32(mock_logits, 1804.0);
    let l_neutral = cartan_vec_get_f32(mock_logits, 500.0);

    printf("  Logit 1801: %.2f (expected <= 0.0)\n", l1801);
    printf("  Logit 1802: %.2f (expected <= 0.0)\n", l1802);
    printf("  Logit 1803: %.2f (expected <= 0.0)\n", l1803);
    printf("  Logit 1804: %.2f (expected <= 0.0)\n", l1804);
    printf("  Logit 500 (neutral): %.2f (expected 2.0)\n", l_neutral);
    printf("  Symbolic Loss Penalty: %s\n", cartan_float_to_string(penalty));

    if (l1801 > 0.0 || l1802 > 0.0 || l1803 > 0.0 || l1804 > 0.0 || l_neutral != 2.0 || penalty <= 0.0) {
        printf("FAILED: Logit shaping penalty was not applied to forbidden tokens\n");
        exit(1.0);
    }
    cartan_vec_free(mock_logits);
    printf("[PASS] Contradiction token registration and logit penalty verified.\n\n");

    // -------------------------------------------------------------------------
    // 7. Domain Lexicon Discourse Framing & Ontological Category Validation
    // -------------------------------------------------------------------------
    printf("Verifying Domain Lexicon Discourse Framing (Frame 18)...\n");
    let lex = domain_lexicon_create();
    domain_lexicon_populate_defaults(lex);

    let frame18 = domain_lexicon_get_discourse_frame(lex, 18.0);
    printf("  Frame 18: %s\n", frame18);
    if (cartan_string_contains(frame18, "[Software Engineering Frame]") == 0.0 ||
        cartan_string_contains(frame18, "Hoare logic contracts") == 0.0) {
        printf("FAILED: Frame 18 discourse template mismatch\n");
        exit(1.0);
    }

    // Verify specialized term IC weights
    let ic_hoare = domain_lexicon_lookup_ic(lex, "hoare_contract");
    let ic_term = domain_lexicon_lookup_ic(lex, "algorithmic_termination");
    let ic_deadlock = domain_lexicon_lookup_ic(lex, "deadlock_freedom");
    printf("  IC(hoare_contract): %s, IC(algorithmic_termination): %s, IC(deadlock_freedom): %s\n",
        cartan_float_to_string(ic_hoare), cartan_float_to_string(ic_term), cartan_float_to_string(ic_deadlock));
    if (ic_hoare < 0.90 || ic_term < 0.90 || ic_deadlock < 0.90) {
        printf("FAILED: Domain 18 terms should have high Information Content weight >= 0.90\n");
        exit(1.0);
    }

    // Verify ontological category enforcement for Domain 18
    let cat_err1 = domain_lexicon_validate_predicate_category(lex, 18.0, "photosynthesize", 4.0);
    let cat_err2 = domain_lexicon_validate_predicate_category(lex, 18.0, "exterior_derivative_of", 2.0);
    let cat_valid = domain_lexicon_validate_predicate_category(lex, 18.0, "validates_contract", 18.0);
    printf("  Category error checks -> photosynthesize: %.0f (exp 0.0), exterior_derivative: %.0f (exp 0.0), validates: %.0f (exp 1.0)\n",
        cat_err1, cat_err2, cat_valid);
    if (cat_err1 != 0.0 || cat_err2 != 0.0 || cat_valid != 1.0) {
        printf("FAILED: Ontological category validation failed for Domain 18\n");
        exit(1.0);
    }
    domain_lexicon_free(lex);
    printf("[PASS] Domain Lexicon discourse framing and category validation verified.\n\n");

    // -------------------------------------------------------------------------
    // 8. Burroughs Lateral Prime Sampling (Fragments 49..51)
    // -------------------------------------------------------------------------
    printf("Verifying Burroughs Lateral Prime Pool for Domain 18...\n");
    let b_pool = pipe.burroughs_pool;
    let f48_text = burroughs_get_fragment_text(b_pool, 48.0);
    let f49_text = burroughs_get_fragment_text(b_pool, 49.0);
    let f50_text = burroughs_get_fragment_text(b_pool, 50.0);
    let f48_tier = burroughs_get_fragment_tier(b_pool, 48.0);
    let f49_tier = burroughs_get_fragment_tier(b_pool, 49.0);
    let f50_tier = burroughs_get_fragment_tier(b_pool, 50.0);
    let f48_dom = burroughs_get_fragment_domain(b_pool, 48.0);

    printf("  Fragment 49 (Tier %.0f, Domain %.0f): %s\n", f48_tier, f48_dom, f48_text);
    printf("  Fragment 50 (Tier %.0f): %s\n", f49_tier, f49_text);
    printf("  Fragment 51 (Tier %.0f): %s\n", f50_tier, f50_text);
    cartan_flush(0.0);

    if (cartan_string_contains(f48_text, "Hoare") == 0.0 ||
        cartan_string_contains(f49_text, "circular wait") == 0.0 ||
        cartan_string_contains(f50_text, "cacheline") == 0.0 ||
        f48_dom != 18.0) {
        printf("FAILED: Burroughs lateral prime content mismatch for Domain 18\n");
        cartan_flush(0.0);
        exit(1.0);
    }

    let sampled_frag = burroughs_sample_fragment(b_pool, 18.0, 2.0, pipe.rng);
    printf("  Sampled Fragment: %s\n", sampled_frag);
    cartan_flush(0.0);
    if (cartan_string_length(sampled_frag) == 0.0) {
        printf("FAILED: Burroughs lateral prime sampling failed for Domain 18\n");
        cartan_flush(0.0);
        exit(1.0);
    }
    printf("[PASS] Burroughs lateral primes 49..51 verified across tiers 1..3.\n\n");
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // 9. Dynamic Gamma Baseline Coupling Factor
    // -------------------------------------------------------------------------
    printf("Verifying Dynamic Gamma Baseline for Domain 18...\n");
    let gamma_cfg = dynamic_gamma_create(0.10, 0.02, 0.35, 6.0, 0.10);
    let gamma_base = dynamic_gamma_domain_baseline(gamma_cfg, 18.0);
    printf("  Baseline gamma for Domain 18: %s (expected 0.125)\n", cartan_float_to_string(gamma_base));
    if (gamma_base < 0.124 || gamma_base > 0.126) {
        printf("FAILED: Dynamic gamma baseline coupling factor mismatch for Domain 18\n");
        exit(1.0);
    }
    printf("[PASS] Dynamic gamma baseline verified.\n\n");

    nses_pipeline_free(pipe);
    cargraph_free(cg);

    printf("=====================================================================\n");
    printf("  TARGET 81 PASSED: Domain 18 Software Engineering & Algorithms\n");
    printf("=====================================================================\n\n");
    return 0.0;
}
