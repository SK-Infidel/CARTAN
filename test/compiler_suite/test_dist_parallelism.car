// test/compiler_suite/test_dist_parallelism.car
// CARTAN Regression Target [32/32]: Distributed Multi-GPU Parallelism Engine (src/std/dist.car)
// // run-pass

include "../../src/std/dist.car";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    let init_res = dist::init(4.0, 0.0);
    cartan_assert(init_res == 0.0, "dist::init failed");

    let r = dist::get_rank();
    cartan_assert(r == 0.0, "dist::get_rank mismatch");

    let w = dist::get_world_size();
    cartan_assert(w == 4.0, "dist::get_world_size mismatch");

    let barrier_res = dist::barrier();
    cartan_assert(barrier_res == 0.0, "dist::barrier failed");

    return 0.0;
}
