// test/compiler_suite/test_wordnet_taxonomy_dag.car
// Target [61/61]: Verification of WordNet & SlangNet Hierarchical Semantic DAG Engine,
// Synset Path Resolution, LCA Distance, Lin/Resnik Similarity, and Concept Logit Biasing.

include "src/std/semantics.cl";
include "src/std/collections.cl";
include "src/std/string.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn cartan_hub_encode_text_to_tokens(text: string) -> ptr;
extern fn cartan_tensor_compute_hidden_state_from_tokens(toks: ptr) -> ptr;
extern fn cartan_tensor_compute_lm_head_logits(h: ptr, temp: float) -> ptr;

fn main() -> float {
    printf("=================================================================================\n");
    printf("  CARTAN TEST SUITE: WORDNET & SLANGNET TAXONOMY DAG & SEMANTIC BIASING (TARGET 61)\n");
    printf("=================================================================================\n\n");

    let dag_path = "test/geomind/trainingdata/wordnet_slangnet_dag.txt";

    // [1/5] Ingestion of WordNet & SlangNet Taxonomy DAG
    printf("[1/5] Verifying WordNet & SlangNet Taxonomy DAG Ingestion...\n");
    let load_status = semantics_load_taxonomy(dag_path);
    cartan_assert(load_status == 1.0, "Taxonomy DAG must load successfully from disk");
    let node_count = cartan_taxonomy_node_count();
    printf("  -> Indexed Synset Nodes: %s\n", cartan_float_to_string(node_count));
    cartan_assert(node_count >= 18.0, "Taxonomy DAG must index at least 18 concept synsets");
    printf("  -> [PASS] Taxonomy DAG ingested and verified.\n\n");

    // [2/5] Word-to-Synset Path Resolution
    printf("[2/5] Verifying Word-to-Synset Path Resolution...\n");
    let dog_path = semantics_resolve_concept_path("dog");
    let wolf_path = semantics_resolve_concept_path("wolf");
    let sus_path = semantics_resolve_concept_path("sus");
    let speed_path = semantics_resolve_concept_path("speed");
    let light_path = semantics_resolve_concept_path("light");

    printf("  -> Word 'dog'   resolved to: %s\n", dog_path);
    printf("  -> Word 'wolf'  resolved to: %s\n", wolf_path);
    printf("  -> Word 'sus'   resolved to: %s\n", sus_path);
    printf("  -> Word 'speed' resolved to: %s\n", speed_path);
    printf("  -> Word 'light' resolved to: %s\n", light_path);

    cartan_assert(cartan_string_contains(dog_path, "canine.dog") == 1.0, "Word 'dog' must resolve to canine.dog synset");
    cartan_assert(cartan_string_contains(wolf_path, "canine.wolf") == 1.0, "Word 'wolf' must resolve to canine.wolf synset");
    cartan_assert(cartan_string_contains(sus_path, "language.slang.sus") == 1.0, "Slang 'sus' must resolve to language.slang.sus synset");
    cartan_assert(cartan_string_contains(speed_path, "measure.rate.speed") == 1.0, "Word 'speed' must resolve to rate.speed synset");
    cartan_assert(cartan_string_contains(light_path, "phenomenon.energy.light") == 1.0, "Word 'light' must resolve to energy.light synset");
    printf("  -> [PASS] Word-to-synset path resolution verified across multiple domains.\n\n");

    // [3/5] LCA Tree Distance and Resnik / Lin Semantic Similarity
    printf("[3/5] Verifying Lowest Common Ancestor (LCA) Tree Distance & Lin Similarity...\n");
    let d_dog_wolf = semantics_lca_tree_distance("dog", "wolf");
    let d_dog_plasma = semantics_lca_tree_distance("dog", "plasma");
    let lin_dog_wolf = semantics_lin_similarity("dog", "wolf");
    let lin_dog_plasma = semantics_lin_similarity("dog", "plasma");
    let ic_plasma = semantics_get_concept_ic("plasma");
    let ic_sus = semantics_get_concept_ic("sus");

    printf("  -> LCA Tree Distance (dog <-> wolf): %s\n", cartan_float_to_string(d_dog_wolf));
    printf("  -> LCA Tree Distance (dog <-> plasma): %s\n", cartan_float_to_string(d_dog_plasma));
    printf("  -> Lin Semantic Similarity (dog <-> wolf): %s\n", cartan_float_to_string(lin_dog_wolf));
    printf("  -> Lin Semantic Similarity (dog <-> plasma): %s\n", cartan_float_to_string(lin_dog_plasma));
    printf("  -> Concept IC for 'plasma': %s\n", cartan_float_to_string(ic_plasma));
    printf("  -> Concept IC for 'sus': %s\n", cartan_float_to_string(ic_sus));

    cartan_assert(d_dog_wolf == 2.0, "Sibling species (dog <-> wolf) must have LCA distance 2.0");
    cartan_assert(d_dog_plasma > 6.0, "Distant concepts (dog <-> plasma) must have large LCA distance (>6.0)");
    cartan_assert(lin_dog_wolf > 0.70, "Related species (dog <-> wolf) must have high Lin similarity (>0.70)");
    cartan_assert(lin_dog_plasma < lin_dog_wolf, "Distant concepts must have lower Lin similarity than related species");
    cartan_assert(ic_plasma > 14.0, "Specialized domain term 'plasma' must have high IC (>14.0)");
    cartan_assert(ic_sus > 11.0, "Slang term 'sus' must have calibrated IC (>11.0)");
    printf("  -> [PASS] Taxonomic tree geometry, LCA metrics, and Information Content verified.\n\n");

    // [4/5] Natural Language Prompt Concept Extraction & Grounding
    printf("[4/5] Verifying Natural Language Prompt Concept Extraction & Grounding...\n");
    let query_prompt = "What is the speed of light in vacuum?";
    let extracted_concept = semantics_extract_primary_concept(query_prompt);
    let extracted_path = semantics_resolve_concept_path(extracted_concept);

    printf("  -> Extracted Primary Concept: \"%s\"\n", extracted_concept);
    printf("  -> Grounded Synset Path: %s\n", extracted_path);

    cartan_assert(cartan_string_length(extracted_concept) > 0.0, "Extracted concept must be non-empty");
    cartan_assert(cartan_string_length(extracted_path) > 0.0, "Extracted concept must resolve to non-empty synset");
    printf("  -> [PASS] Prompt concept extraction and semantic grounding verified.\n\n");

    // [5/5] Real-Time Semantic Coherence Logit Boosting
    printf("[5/5] Verifying Real-Time Semantic Coherence Logit Boosting...\n");
    let toks = cartan_hub_encode_text_to_tokens("canine dog puppy");
    let h = cartan_tensor_compute_hidden_state_from_tokens(toks);
    let logits_vec = cartan_tensor_compute_lm_head_logits(h, 0.7);
    let orig_len = cartan_vec_len(logits_vec);
    printf("  -> Real LM Head Logits Size: %s\n", cartan_float_to_string(orig_len));

    // Sample pre-boost logit for token 21029 ("dog")
    let pre_val = cartan_vec_get_f32(logits_vec, 21029.0);

    // Apply concept boost for "dog"
    semantics_apply_concept_logit_boost(logits_vec, "dog", 3.0);

    let post_val = cartan_vec_get_f32(logits_vec, 21029.0);
    printf("  -> Token 21029 ('dog') Pre-Boost: %s | Post-Boost: %s (Delta: %s)\n",
        cartan_float_to_string(pre_val),
        cartan_float_to_string(post_val),
        cartan_float_to_string(post_val - pre_val));

    cartan_assert(post_val > pre_val + 2.50, "Semantic logit boosting must elevate target vocabulary tokens by >= 2.50");
    printf("  -> [PASS] Real-time semantic coherence logit boosting verified.\n\n");

    printf("=================================================================================\n");
    printf("  TARGET 61 VERIFICATION COMPLETE: ALL WORDNET TAXONOMY DAG TESTS PASSED (5/5)!\n");
    printf("=================================================================================\n");
    return 0.0;
}
