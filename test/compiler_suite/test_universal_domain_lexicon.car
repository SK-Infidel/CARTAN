// Target 77: Universal Cross-Domain Lexicon, Ontology & Discourse Grounding Regression Test
// Empirical regression test verifying:
// 1. Lexicon registration and authentic Information Content (IC) weight lookup across all 9 domains.
// 2. Canonical discourse framing template retrieval across all 9 cognitive domains.
// 3. Ontological category error validation preventing cross-domain predicate mismatch.
// 4. Hub-and-spoke CSR linguistic grounding traversal from Rule 47 to domain roots.
// 5. Rule 11 category error veto gate detection and tokens 605-608 logit suppression.
// 6. Cross-domain ontology .car_graph flat binary loading and rule verification.

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";
include "src/std/guardrails.cl";
include "src/std/csr_graph.cl";
include "src/std/plasticity.cl";
include "src/std/burroughs.cl";
include "src/std/prompt_scaffold.cl";
include "src/std/veto_gate.cl";
include "src/std/domain_lexicon.cl";
include "src/std/nses_pipeline.cl";
include "src/std/saliency_attractor.cl";
include "src/std/resonator.cl";

extern fn printf(fmt: string) -> i32;
extern fn exit(code: float) -> void;

fn main() -> float {
    printf("=====================================================================\n");
    printf("  Target 77: Universal Cross-Domain Lexicon, Ontology & Discourse Grounding\n");
    printf("=====================================================================\n\n");

    // -------------------------------------------------------------------------
    // 1. Verify Domain Lexicon & Information Content (IC) Weights
    // -------------------------------------------------------------------------
    printf("Verifying Universal Domain Lexicon & IC Weights...\n");
    let lex = domain_lexicon_create();
    domain_lexicon_populate_defaults(lex);

    printf("  Total Lexicon Entries: %.0f (expected >= 45.0)\n", lex.count);
    if (lex.count < 45.0) {
        printf("FAILED: Domain lexicon population failed, count too low\n");
        exit(1.0);
    }

    let ic_bellman = domain_lexicon_lookup_ic(lex, "bellman");
    let ic_modus = domain_lexicon_lookup_ic(lex, "modus_ponens");
    let ic_manifold = domain_lexicon_lookup_ic(lex, "manifold");
    let ic_entropy = domain_lexicon_lookup_ic(lex, "entropy");
    let ic_photo = domain_lexicon_lookup_ic(lex, "photosynthesis");
    let ic_stopword = domain_lexicon_lookup_ic(lex, "the");

    printf("  IC ('bellman'): %.2f (expected >= 0.90)\n", ic_bellman);
    printf("  IC ('modus_ponens'): %.2f (expected >= 0.90)\n", ic_modus);
    printf("  IC ('manifold'): %.2f (expected >= 0.90)\n", ic_manifold);
    printf("  IC ('entropy'): %.2f (expected >= 0.90)\n", ic_entropy);
    printf("  IC ('photosynthesis'): %.2f (expected >= 0.90)\n", ic_photo);
    printf("  IC ('the' stopword): %.2f (expected <= 0.15)\n", ic_stopword);

    if (ic_bellman < 0.90 || ic_modus < 0.90 || ic_manifold < 0.90 || ic_entropy < 0.90 || ic_photo < 0.90 || ic_stopword > 0.15) {
        printf("FAILED: Lexicon IC weight lookup verification failed\n");
        exit(1.0);
    }
    printf("[PASS] Universal domain lexicon and IC weights verified.\n\n");

    // -------------------------------------------------------------------------
    // 2. Verify Canonical Discourse Framing Templates Across Domains (0..8)
    // -------------------------------------------------------------------------
    printf("Verifying Canonical Discourse Framing Templates Across Domains 0..8...\n");
    let f0 = domain_lexicon_get_discourse_frame(lex, 0.0); // System Core
    let f2 = domain_lexicon_get_discourse_frame(lex, 2.0); // Topology / Geometry
    let f4 = domain_lexicon_get_discourse_frame(lex, 4.0); // Biological Systems
    let f7 = domain_lexicon_get_discourse_frame(lex, 7.0); // Formal Logic
    let f8 = domain_lexicon_get_discourse_frame(lex, 8.0); // Decision Planning

    printf("  Domain 0 Frame: %s\n", f0);
    printf("  Domain 2 Frame: %s\n", f2);
    printf("  Domain 4 Frame: %s\n", f4);
    printf("  Domain 7 Frame: %s\n", f7);
    printf("  Domain 8 Frame: %s\n", f8);

    if (cartan_string_contains(f0, "[System Invariant Frame]") == 0.0 ||
        cartan_string_contains(f2, "[Differential Manifold Frame]") == 0.0 ||
        cartan_string_contains(f4, "[Biological Pathway Frame]") == 0.0 ||
        cartan_string_contains(f7, "[Deductive Proof Frame]") == 0.0 ||
        cartan_string_contains(f8, "[Decision Policy Frame]") == 0.0) {
        printf("FAILED: Canonical discourse frame header verification failed\n");
        exit(1.0);
    }
    printf("[PASS] Canonical discourse framing templates verified.\n\n");

    // -------------------------------------------------------------------------
    // 3. Verify Ontological Category Error Validation
    // -------------------------------------------------------------------------
    printf("Verifying Ontological Category Validation...\n");
    let valid_bio = domain_lexicon_validate_predicate_category(lex, 4.0, "photosynthesize", 0.0);
    let invalid_geom = domain_lexicon_validate_predicate_category(lex, 2.0, "photosynthesize", 0.0);
    let invalid_logic = domain_lexicon_validate_predicate_category(lex, 7.0, "exterior_derivative_of", 0.0);
    let invalid_ftl = domain_lexicon_validate_predicate_category(lex, 1.0, "accelerates_faster_than_light", 0.0);

    printf("  Valid Bio Predicate: %.0f (expected 1.0)\n", valid_bio);
    printf("  Invalid Geom Category: %.0f (expected 0.0)\n", invalid_geom);
    printf("  Invalid Logic Category: %.0f (expected 0.0)\n", invalid_logic);
    printf("  Invalid FTL Predicate: %.0f (expected 0.0)\n", invalid_ftl);

    if (valid_bio != 1.0 || invalid_geom != 0.0 || invalid_logic != 0.0 || invalid_ftl != 0.0) {
        printf("FAILED: Ontological category validation mismatch\n");
        exit(1.0);
    }
    printf("[PASS] Ontological category validation verified.\n\n");

    // -------------------------------------------------------------------------
    // 4. Verify Hub-and-Spoke CSR Linguistic Grounding Traversal
    // -------------------------------------------------------------------------
    printf("Verifying Hub-and-Spoke CSR Linguistic Grounding Traversal...\n");
    let graph_path = "test/geomind/trainingdata/nses_knowledge.car_graph";
    let pipe = nses_pipeline_create(graph_path);
    if (pipe.is_ready == 0.0) {
        printf("FAILED: NSES Pipeline failed to initialize\n");
        exit(1.0);
    }

    // Traverse starting at Rule 47 (Lexical Grounding)
    cartan_vec_clear(pipe.seed_list);
    cartan_vec_clear(pipe.act_list);
    collections_list_push(pipe.seed_list, 47.0); // Seed: Rule 47 (Lexical Grounding Hub)
    collections_list_push(pipe.act_list, 1.0);

    let traversed_cnt = csr_traverse_bfs(pipe.csr, pipe.scratchpad, pipe.seed_list, pipe.act_list, 2.0, 0.50, 0.85, 0.0);
    printf("  Hub Traversal from Rule 47 (Depth 2.0) reached: %.0f rules\n", traversed_cnt);

    if (traversed_cnt < 5.0) {
        printf("FAILED: Hub-and-spoke traversal reached fewer rules than expected (got %.0f, expected >= 5.0)\n", traversed_cnt);
        exit(1.0);
    }

    var has_root_logic = 0.0;
    var has_root_planning = 0.0;
    var ri = 0.0;
    while (ri < traversed_cnt) {
        let nid = collections_list_get(pipe.scratchpad.result_node_ids, ri);
        if (nid == 54.0) { has_root_logic = 1.0; } // Modus Ponens
        if (nid == 62.0) { has_root_planning = 1.0; } // Bellman Optimality
        ri = ri + 1.0;
    }

    printf("  Traversed to Domain 7 Root (Rule 54): %.0f (expected 1.0)\n", has_root_logic);
    printf("  Traversed to Domain 8 Root (Rule 62): %.0f (expected 1.0)\n", has_root_planning);

    if (has_root_logic != 1.0 || has_root_planning != 1.0) {
        printf("FAILED: Hub-and-spoke traversal failed to reach target domain roots\n");
        exit(1.0);
    }
    printf("[PASS] Hub-and-spoke CSR linguistic grounding topology verified.\n\n");

    // -------------------------------------------------------------------------
    // 5. Verify Rule 11 Category Error Veto Gate & Contradiction Logits
    // -------------------------------------------------------------------------
    printf("Verifying Rule 11 Ontological Category Error Veto & Logit Suppression...\n");
    let category_error_candidate = "Our model calculates the photosynthesizing manifold where the exterior derivative digests glucose.";
    let v_scan = veto_gate_scan(pipe.veto_reg, category_error_candidate);

    printf("  Candidate Text: '%s'\n", category_error_candidate);
    printf("  Vetoed: %.0f (expected 1.0)\n", v_scan.is_vetoed);
    printf("  Violated Rule ID: %.0f (expected 11.0)\n", v_scan.violated_rule_id);
    printf("  Canonical Assertion: %s\n", v_scan.output_text);

    if (v_scan.is_vetoed != 1.0 || v_scan.violated_rule_id != 11.0) {
        printf("FAILED: Category error text was not vetoed as expected\n");
        exit(1.0);
    }

    // Verify logit suppression of Domain 6 contradiction tokens (605-608)
    let logit_bank = cartan_vec_create();
    var li = 0.0;
    while (li < 1000.0) {
        cartan_vec_push_f32(logit_bank, 2.0);
        li = li + 1.0;
    }

    let penalty = nses_pipeline_shape_loss(pipe, 6.0, logit_bank, 0.0, 0.20);
    printf("  Domain 6 Symbolic Penalty: %.4f\n", penalty);
    if (penalty <= 0.0) {
        printf("FAILED: Expected positive loss penalty for Domain 6 contradiction tokens\n");
        exit(1.0);
    }

    let l605 = cartan_vec_get_f32(logit_bank, 605.0);
    let l606 = cartan_vec_get_f32(logit_bank, 606.0);
    let l607 = cartan_vec_get_f32(logit_bank, 607.0);
    let l608 = cartan_vec_get_f32(logit_bank, 608.0);
    let l_neutral = cartan_vec_get_f32(logit_bank, 500.0);

    printf("  Logit 605 (Category Mismatch): %.2f (expected <= 0.0)\n", l605);
    printf("  Logit 606 (Ungrounded Predicate): %.2f (expected <= 0.0)\n", l606);
    printf("  Logit 607 (Discourse Frame Rupture): %.2f (expected <= 0.0)\n", l607);
    printf("  Logit 608 (Ontological Type Violation): %.2f (expected <= 0.0)\n", l608);
    printf("  Logit 500 (Neutral Token): %.2f (expected 2.0)\n", l_neutral);

    if (l605 > 0.0 || l606 > 0.0 || l607 > 0.0 || l608 > 0.0 || l_neutral != 2.0) {
        printf("FAILED: Contradiction token suppression failed for Domain 6 category errors\n");
        exit(1.0);
    }
    printf("[PASS] Rule 11 category error veto and logit suppression verified.\n\n");

    // -------------------------------------------------------------------------
    // 6. Verify Cross-Domain Ontological Corpus Knowledge Graph
    // -------------------------------------------------------------------------
    printf("Verifying Compiled Cross-Domain Ontological Knowledge Graph...\n");
    let ont_path = "test/geomind/trainingdata/cross_domain_ontology.car_graph";
    let cg_ont = cargraph_load_binary(ont_path);
    if (cg_ont.is_valid == 0.0) {
        printf("FAILED: Could not load cross-domain ontology graph at: %s\n", ont_path);
        exit(1.0);
    }

    printf("  Ontology Rules Count: %.0f (expected >= 42.0)\n", cg_ont.header.num_rules);
    printf("  Ontology Strict Count: %.0f (expected >= 14.0)\n", cg_ont.header.num_strict_rules);

    if (cg_ont.header.num_rules < 42.0 || cg_ont.header.num_strict_rules < 14.0) {
        printf("FAILED: Cross-domain ontology header counts mismatch\n");
        exit(1.0);
    }

    let r0 = cargraph_get_rule_text(cg_ont, 0.0);
    printf("  Ontology Rule 0: %s\n", r0);
    if (cartan_string_contains(r0, "energy_conservation") == 0.0) {
        printf("FAILED: Expected energy_conservation rule at index 0\n");
        exit(1.0);
    }
    printf("[PASS] Cross-domain ontology flat binary verified.\n\n");

    // Clean up
    cartan_vec_free(logit_bank);
    nses_pipeline_free(pipe);
    domain_lexicon_free(lex);
    cargraph_free(cg_ont);

    printf("=====================================================================\n");
    printf("[PASS] Target 77: Universal Cross-Domain Lexicon & Ontology Verified Cleanly.\n");
    printf("=====================================================================\n");
    return 0.0;
}
