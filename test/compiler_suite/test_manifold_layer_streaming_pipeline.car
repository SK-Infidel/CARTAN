// test/compiler_suite/test_manifold_layer_streaming_pipeline.car
// Target [86]: Sovereign Manifold 42-Layer Streaming Execution & LM Head Projection Pipeline
// Verification Gates:
//   Gate 1: Layer Binary Header Validation (sliding vs global dims)
//   Gate 2: Fast Binary Buffer Layer Forward Pass (cartan_manifold_layer_forward_raw)
//   Gate 3: Dual-Theta RoPE Dispatch (10,000 sliding vs 1,000,000 global base frequency)
//   Gate 4: Sequential Multi-Layer Chaining & Buffer Lifecycle
//   Gate 5: Unmasked Full-Range LM Head Projection with [-30.0, 30.0] Soft-Capping

include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/math.cl";
include "src/std/fs.cl";
include "src/std/hub.cl";
include "src/std/transformer.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_float_to_string(v: float) -> string;
extern fn malloc(size: float) -> ptr;
extern fn free(p: ptr);
extern fn fopen(path: string, mode: string) -> ptr;
extern fn fclose(f: ptr);
extern fn fread(buf: ptr, elem_size: float, count: float, f: ptr) -> float;
extern fn cartan_set_f32(p: ptr, offset: float, val: float) -> void;

fn main() -> float {
    printf("=================================================================================\n");
    printf("  CARTAN TEST SUITE: SOVEREIGN MANIFOLD LAYER STREAMING & LM HEAD PIPELINE (TARGET 86)\n");
    printf("  Header Auth, Fast Raw Buffer Forward, Dual RoPE, Chaining, LM Head Softcap\n");
    printf("=================================================================================\n\n");
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // Gate 1: Layer Binary Header Validation (sliding vs global dims)
    // -------------------------------------------------------------------------
    printf("[1/5] Verifying Layer Binary Headers for Sliding and Global Layers...\n");
    let l0_path = "test/geomind/trainingdata/checkpoints/layers/manifold_layer_0.bin";
    let l5_path = "test/geomind/trainingdata/checkpoints/layers/manifold_layer_5.bin";

    cartan_assert(cartan_file_exists(l0_path) == 1.0, "Layer 0 checkpoint must exist on disk");
    cartan_assert(cartan_file_exists(l5_path) == 1.0, "Layer 5 checkpoint must exist on disk");

    let f0 = fopen(l0_path, "rb");
    cartan_assert(f0 != 0.0, "Must be able to open layer 0 file");
    let hdr0 = malloc(64.0); // 16 floats * 4 bytes
    fread(hdr0, 4.0, 16.0, f0);
    fclose(f0);

    let magic0 = cartan_f32_at(hdr0, 0.0);
    let idx0 = cartan_f32_at(hdr0, 1.0);
    let hdim0 = cartan_f32_at(hdr0, 2.0);
    let theta0 = cartan_f32_at(hdr0, 3.0);
    let qdim0 = cartan_f32_at(hdr0, 8.0);
    let kvdim0 = cartan_f32_at(hdr0, 9.0);
    free(hdr0);

    printf("  Layer 0 (Sliding): magic=%s, idx=%s, hdim=%s, theta=%s, qdim=%s, kvdim=%s\n",
        cartan_float_to_string(magic0), cartan_float_to_string(idx0),
        cartan_float_to_string(hdim0), cartan_float_to_string(theta0),
        cartan_float_to_string(qdim0), cartan_float_to_string(kvdim0));

    cartan_assert(magic0 == 1195724032.0, "Layer 0 magic must be 1195724032 ($GEM4 in float32)");
    cartan_assert(idx0 == 0.0, "Layer 0 index must be 0");
    cartan_assert(hdim0 == 256.0, "Layer 0 sliding attention head_dim must be 256");
    cartan_assert(theta0 == 10000.0, "Layer 0 sliding attention RoPE theta must be 10000");
    cartan_assert(qdim0 == 2048.0, "Layer 0 q_dim must be 2048 (8 heads * 256)");
    cartan_assert(kvdim0 == 512.0, "Layer 0 kv_dim must be 512 (2 heads * 256)");

    let f5 = fopen(l5_path, "rb");
    cartan_assert(f5 != 0.0, "Must be able to open layer 5 file");
    let hdr5 = malloc(64.0);
    fread(hdr5, 4.0, 16.0, f5);
    fclose(f5);

    let magic5 = cartan_f32_at(hdr5, 0.0);
    let idx5 = cartan_f32_at(hdr5, 1.0);
    let hdim5 = cartan_f32_at(hdr5, 2.0);
    let theta5 = cartan_f32_at(hdr5, 3.0);
    let qdim5 = cartan_f32_at(hdr5, 8.0);
    let kvdim5 = cartan_f32_at(hdr5, 9.0);
    free(hdr5);

    printf("  Layer 5 (Global):  magic=%s, idx=%s, hdim=%s, theta=%s, qdim=%s, kvdim=%s\n",
        cartan_float_to_string(magic5), cartan_float_to_string(idx5),
        cartan_float_to_string(hdim5), cartan_float_to_string(theta5),
        cartan_float_to_string(qdim5), cartan_float_to_string(kvdim5));

    cartan_assert(magic5 == 1195724032.0, "Layer 5 magic must be 1195724032 ($GEM4 in float32)");
    cartan_assert(idx5 == 5.0, "Layer 5 index must be 5");
    cartan_assert(hdim5 == 512.0, "Layer 5 global attention head_dim must be 512");
    cartan_assert(theta5 == 1000000.0, "Layer 5 global attention RoPE theta must be 1,000,000");
    cartan_assert(qdim5 == 4096.0, "Layer 5 q_dim must be 4096 (8 heads * 512)");
    cartan_assert(kvdim5 == 1024.0, "Layer 5 kv_dim must be 1024 (2 heads * 512)");

    printf("  -> [PASS] Gate 1: Sliding and Global layer headers verified.\n\n");

    // -------------------------------------------------------------------------
    // Gate 2: Fast Binary Buffer Layer Forward Pass (cartan_manifold_layer_forward_raw)
    // -------------------------------------------------------------------------
    printf("[2/5] Verifying Fast Binary Buffer Layer Forward Pass (AVX2 GEMV)...\n");
    let test_dim = 32.0;
    let test_inter = 64.0;
    let test_qdim = 32.0;
    let test_kvdim = 16.0;
    let test_hdim = 8.0;

    // Allocate synthetic layer buffer layout matching cartan_manifold_layer_forward_raw
    // Header: 16 floats
    // in_norm: 32 floats
    // w_q: 32 * 32 = 1024 floats
    // w_k: 16 * 32 = 512 floats
    // w_v: 16 * 32 = 512 floats
    // w_o: 32 * 32 = 1024 floats
    // q_norm: 512 floats
    // k_norm: 512 floats
    // post_attn_norm: 32 floats
    // pre_ffn_norm: 32 floats
    // gate_proj: 64 * 32 = 2048 floats
    // up_proj: 64 * 32 = 2048 floats
    // down_proj: 32 * 64 = 2048 floats
    // post_ffn_norm: 32 floats
    // ple_gate + ple_proj + ple_norm: minimal padding
    let total_test_floats = 15000.0;
    let test_layer_buf = malloc(total_test_floats * 4.0);
    cartan_assert(test_layer_buf != 0.0, "Synthetic layer buffer allocation must succeed");

    // Fill with zero then initialize
    var fi = 0.0;
    while (fi < total_test_floats) {
        let val = sin((fi + 1.0) * 0.01) * 0.05;
        // Float write via helper or direct slot:
        // Set header:
        if (fi == 0.0) { val = 1195724032.0; } // magic
        if (fi == 1.0) { val = 0.0; }          // layer_idx
        if (fi == 2.0) { val = test_hdim; }    // head_dim 8.0
        if (fi == 3.0) { val = 10000.0; }      // rope_theta
        if (fi == 4.0) { val = 1.0; }          // layer_scalar
        if (fi == 5.0) { val = 0.0; }          // has_ple = 0
        if (fi == 6.0) { val = test_dim; }     // dim = 32.0
        if (fi == 7.0) { val = test_inter; }   // inter_dim = 64.0
        if (fi == 8.0) { val = test_qdim; }    // q_dim = 32.0
        if (fi == 9.0) { val = test_kvdim; }   // kv_dim = 16.0
        if (fi == 10.0) { val = 16.0; }        // ple_dim
        // Set unit norms for stability
        if (fi >= 16.0 && fi < 48.0) { val = 1.0; } // in_norm
        // Float slot store into test_layer_buf:
        // test_layer_buf is ptr to float array
        // We write float bit representation:
        cartan_set_f32(test_layer_buf, fi, val);
        fi = fi + 1.0;
    }

    // Setup input state vector
    let h_test = cartan_vec_create();
    var di = 0.0;
    while (di < test_dim) {
        cartan_vec_push_f32(h_test, (di + 1.0) * 0.1);
        di = di + 1.0;
    }

    let h_out = cartan_manifold_layer_forward_raw(h_test, test_layer_buf, 0.0, 1.0, 0.0, 0.0);
    cartan_assert(h_out != 0.0, "cartan_manifold_layer_forward_raw must return non-null output vector");
    let out_len = cartan_vec_len(h_out);
    printf("  Output vector dimension: %s (expected %s)\n",
        cartan_float_to_string(out_len), cartan_float_to_string(test_dim));
    cartan_assert(out_len == test_dim, "Output vector dimension must match layer dim 32.0");

    var energy_sum = 0.0;
    di = 0.0;
    while (di < test_dim) {
        let val = cartan_vec_get_f32(h_out, di);
        energy_sum = energy_sum + (val * val);
        di = di + 1.0;
    }
    printf("  Output state energy sum(h^2): %s\n", cartan_float_to_string(energy_sum));
    cartan_assert(energy_sum > 0.0, "Layer output energy must be strictly non-zero and positive");

    cartan_vec_free(h_test);
    cartan_vec_free(h_out);
    free(test_layer_buf);
    printf("  -> [PASS] Gate 2: Fast raw layer forward pass verified.\n\n");

    // -------------------------------------------------------------------------
    // Gate 3: Dual-Theta RoPE Dispatch (10,000 sliding vs 1,000,000 global)
    // -------------------------------------------------------------------------
    printf("[3/5] Verifying Dual-Theta RoPE Frequency Dispatch...\n");
    let rope_vec = cartan_vec_create();
    var r_i = 0.0;
    while (r_i < 8.0) {
        cartan_vec_push_f32(rope_vec, (r_i + 1.0) * 0.25);
        r_i = r_i + 1.0;
    }

    let pos = 1.0;
    let head_d = 8.0;
    let rot_sliding = cartan_rope_apply(rope_vec, pos, head_d, 10000.0);
    let rot_global = cartan_rope_apply(rope_vec, pos, head_d, 1000000.0);

    cartan_assert(rot_sliding != 0.0, "Sliding RoPE must produce valid vector");
    cartan_assert(rot_global != 0.0, "Global RoPE must produce valid vector");

    // Show that the two rotations produce distinct, mathematically valid embeddings
    var diff_sum = 0.0;
    r_i = 0.0;
    while (r_i < 8.0) {
        let s_val = cartan_vec_get_f32(rot_sliding, r_i);
        let g_val = cartan_vec_get_f32(rot_global, r_i);
        let diff = math_abs(s_val - g_val);
        diff_sum = diff_sum + diff;
        r_i = r_i + 1.0;
    }
    printf("  Total absolute difference between 10k and 1M theta rotations: %s\n",
        cartan_float_to_string(diff_sum));
    cartan_assert(diff_sum > 0.001, "Dual-theta RoPE rotations must yield distinct geometric vectors");

    cartan_vec_free(rope_vec);
    cartan_vec_free(rot_sliding);
    cartan_vec_free(rot_global);
    printf("  -> [PASS] Gate 3: Dual-theta RoPE frequency dispatch verified.\n\n");

    // -------------------------------------------------------------------------
    // Gate 4: Sequential Multi-Layer Chaining & Buffer Lifecycle
    // -------------------------------------------------------------------------
    printf("[4/5] Verifying Sequential Multi-Layer Chaining & Memory Lifecycle...\n");
    // Allocate two separate layer buffers
    let buf_A = malloc(total_test_floats * 4.0);
    let buf_B = malloc(total_test_floats * 4.0);
    cartan_assert(buf_A != 0.0 && buf_B != 0.0, "Dual layer buffer allocation must succeed");

    var bi = 0.0;
    while (bi < total_test_floats) {
        let va = cos((bi + 1.0) * 0.02) * 0.04;
        let vb = sin((bi + 1.0) * 0.03) * 0.04;
        if (bi == 0.0) { va = 1195724032.0; vb = 1195724032.0; }
        if (bi == 1.0) { va = 0.0; vb = 1.0; }
        if (bi == 2.0) { va = test_hdim; vb = test_hdim; }
        if (bi == 3.0) { va = 10000.0; vb = 10000.0; }
        if (bi == 4.0) { va = 1.0; vb = 1.0; }
        if (bi == 5.0) { va = 0.0; vb = 0.0; }
        if (bi == 6.0) { va = test_dim; vb = test_dim; }
        if (bi == 7.0) { va = test_inter; vb = test_inter; }
        if (bi == 8.0) { va = test_qdim; vb = test_qdim; }
        if (bi == 9.0) { va = test_kvdim; vb = test_kvdim; }
        if (bi >= 16.0 && bi < 48.0) { va = 1.0; vb = 1.0; }
        cartan_set_f32(buf_A, bi, va);
        cartan_set_f32(buf_B, bi, vb);
        bi = bi + 1.0;
    }

    let chain_in = cartan_vec_create();
    var ci = 0.0;
    while (ci < test_dim) {
        cartan_vec_push_f32(chain_in, 0.5);
        ci = ci + 1.0;
    }

    // Step A: Feed input through Layer A
    let chain_mid = cartan_manifold_layer_forward_raw(chain_in, buf_A, 0.0, 1.0, 0.0, 0.0);
    cartan_assert(chain_mid != 0.0, "Layer A forward pass must succeed");

    // Step B: Chain Layer A output directly into Layer B
    let chain_final = cartan_manifold_layer_forward_raw(chain_mid, buf_B, 1.0, 2.0, 0.0, 0.0);
    cartan_assert(chain_final != 0.0, "Layer B forward pass must succeed");

    // Ensure state transformation occurred across both layers
    let val_in = cartan_vec_get_f32(chain_in, 0.0);
    let val_mid = cartan_vec_get_f32(chain_mid, 0.0);
    let val_final = cartan_vec_get_f32(chain_final, 0.0);

    printf("  Chained values: initial=%s -> after Layer A=%s -> after Layer B=%s\n",
        cartan_float_to_string(val_in), cartan_float_to_string(val_mid), cartan_float_to_string(val_final));

    cartan_assert(math_abs(val_mid - val_in) > 0.0001, "Layer A must transform the hidden state");
    cartan_assert(math_abs(val_final - val_mid) > 0.0001, "Layer B must transform the hidden state");

    // Clean up intermediate vectors without leaks
    cartan_vec_free(chain_in);
    cartan_vec_free(chain_mid);
    cartan_vec_free(chain_final);
    free(buf_A);
    free(buf_B);
    printf("  -> [PASS] Gate 4: Sequential 2-layer chaining and buffer lifecycle verified.\n\n");

    // -------------------------------------------------------------------------
    // Gate 5: Unmasked LM Head Projection with [-30.0, 30.0] Soft-Capping
    // -------------------------------------------------------------------------
    printf("[5/5] Verifying LM Head Soft-Capping (30.0 * tanh(x / 30.0))...\n");
    let test_logits = cartan_vec_create();
    cartan_vec_push_f32(test_logits, 100.0);   // Extreme positive
    cartan_vec_push_f32(test_logits, -100.0);  // Extreme negative
    cartan_vec_push_f32(test_logits, 0.0);     // Zero
    cartan_vec_push_f32(test_logits, 15.0);    // Linear region
    cartan_vec_push_f32(test_logits, 50.0);    // Saturation region

    let capped = cartan_logit_softcap(test_logits, 30.0);
    let c0 = cartan_vec_get_f32(capped, 0.0);
    let c1 = cartan_vec_get_f32(capped, 1.0);
    let c2 = cartan_vec_get_f32(capped, 2.0);
    let c3 = cartan_vec_get_f32(capped, 3.0);
    let c4 = cartan_vec_get_f32(capped, 4.0);

    printf("  Soft-capped logit (+100.0) -> %s (cap: 30.0)\n", cartan_float_to_string(c0));
    printf("  Soft-capped logit (-100.0) -> %s (cap: -30.0)\n", cartan_float_to_string(c1));
    printf("  Soft-capped logit (0.0)    -> %s (expected: 0.0)\n", cartan_float_to_string(c2));
    printf("  Soft-capped logit (+15.0)  -> %s (expected: ~13.86)\n", cartan_float_to_string(c3));
    printf("  Soft-capped logit (+50.0)  -> %s (expected: ~27.87)\n", cartan_float_to_string(c4));

    cartan_assert(c0 < 30.0 && c0 > 29.9, "Extreme positive logit must asymptotically approach 30.0");
    cartan_assert(c1 > -30.0 && c1 < -29.9, "Extreme negative logit must asymptotically approach -30.0");
    cartan_assert(c2 == 0.0, "Zero logit must remain exactly 0.0");
    cartan_assert(c3 > 13.0 && c3 < 14.5, "Softcap at 15.0 must be ~13.86");
    cartan_assert(c4 > 27.0 && c4 < 28.5, "Softcap at 50.0 must be ~27.87");

    cartan_vec_free(test_logits);
    cartan_vec_free(capped);
    printf("  -> [PASS] Gate 5: LM head soft-capping verified within [-30.0, 30.0].\n\n");

    printf("=================================================================================\n");
    printf("  TARGET [86] SOVEREIGN MANIFOLD LAYER STREAMING & LM HEAD PIPELINE: ALL 5 GATES PASSED!\n");
    printf("=================================================================================\n");
    return 0.0;
}
