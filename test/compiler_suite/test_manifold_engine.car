// test/compiler_suite/test_manifold_engine.car
// Verify Native Sovereign Manifold Engine Bridge Linking & Generation

extern fn printf(fmt: string) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_ollama_is_available() -> float;
extern fn cartan_ollama_generate_stream(prompt: string, temp: float) -> string;

fn main(argc: float, argv: ptr) -> float {
    printf("================================================================================\n");
    printf("  CARTAN TEST: SOVEREIGN MANIFOLD STREAMING ENGINE BRIDGE\n");
    printf("================================================================================\n\n");

    let is_avail = cartan_ollama_is_available();
    printf("Ollama Manifold Daemon Available: ");
    if (is_avail == 1.0) {
        printf("YES (Active)\n\n");
    } else {
        printf("NO (Offline)\n\n");
        return 0.0;
    }
    cartan_flush(0.0);

    let prompt = "<start_of_turn>user\nWhat is the capital of France?<end_of_turn>\n<start_of_turn>model\n";
    printf("Streaming generation for prompt: What is the capital of France?\n");
    printf("----------------------------------------------------------------\n");
    cartan_flush(0.0);

    let resp = cartan_ollama_generate_stream(prompt, 0.7);

    printf("\n----------------------------------------------------------------\n");
    printf("Generation Complete!\n");
    return 0.0;
}
