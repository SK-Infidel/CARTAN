// test/compiler_suite/test_math_string_full.car
// CARTAN Regression Target [22/22]: Full Math Trigonometry & String Module Pass
// // run-pass

include "../../src/std/math.car";
include "../../src/std/string.car";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    let s = math::sin(0.0);
    cartan_assert(s == 0.0, "math::sin failed");

    let c = math::cos(0.0);
    cartan_assert(c == 1.0, "math::cos failed");

    let t = math::tanh(0.0);
    cartan_assert(t == 0.0, "math::tanh failed");

    let fl = math::floor(3.7);
    cartan_assert(fl == 3.0, "math::floor failed");

    let cl = math::ceil(3.2);
    cartan_assert(cl == 4.0, "math::ceil failed");

    let str_len = string::len("CARTAN Full Math String");
    cartan_assert(str_len > 0.0, "string::len failed");

    let joined = string::concat("CARTAN ", "Language");
    cartan_assert(string::len(joined) > 0.0, "string::concat failed");

    return 0.0;
}
