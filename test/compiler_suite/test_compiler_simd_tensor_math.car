// test/compiler_suite/test_compiler_simd_tensor_math.car
// Target 82: Core Runtime SIMD Vector Math, Transpose-Tiled GEMM & 4-Way Unrolled Operations
// Mathematical Verification & Performance Benchmark (Zero-Mock Genuine Calculations)

include "src/std/math.cl";

extern fn malloc(size: float) -> ptr;
extern fn free(p: ptr);
extern fn printf(fmt: string, a: string) -> float;

fn assert_true(cond: float, msg: string) {
    if (cond == 0.0) {
        printf("[ASSERTION FAILED] %s\n", msg);
        cartan_flush(0.0);
        exit(1.0);
    }
}

fn assert_close(val: float, expected: float, eps: float, msg: string) {
    let diff = math_abs(val - expected);
    if (diff > eps) {
        printf("[ASSERTION FAILED] %s | Expected: %s, Got: %s\n", msg);
        cartan_flush(0.0);
        exit(1.0);
    }
}

fn main() -> float {
    printf("=====================================================================\n", "");
    printf("  Target 82: Core Runtime SIMD & Transpose-Tiled Tensor Math\n", "");
    printf("=====================================================================\n\n", "");
    cartan_flush(0.0);

    // =========================================================================
    // Phase 1: Flat Buffer GEMM Correctness (cartan_tensor_matmul_gemm)
    // =========================================================================
    printf("Phase 1: Validating Flat Buffer Transpose-Tiled GEMM...\n", "");
    // Matrix A: 2 x 2 -> [1.0, 2.0; 3.0, 4.0]
    let A2 = cartan_tensor_alloc(4.0);
    A2[2.0] = 1.0; A2[3.0] = 2.0;
    A2[4.0] = 3.0; A2[5.0] = 4.0;

    // Matrix B: 2 x 2 -> [5.0, 6.0; 7.0, 8.0]
    let B2 = cartan_tensor_alloc(4.0);
    B2[2.0] = 5.0; B2[3.0] = 6.0;
    B2[4.0] = 7.0; B2[5.0] = 8.0;

    // Expected C = A * B:
    // C[0,0] = 1*5 + 2*7 = 19.0
    // C[0,1] = 1*6 + 2*8 = 22.0
    // C[1,0] = 3*5 + 4*7 = 43.0
    // C[1,1] = 3*6 + 4*8 = 50.0
    let C2 = cartan_tensor_matmul_gemm(A2, B2, 2.0, 2.0, 2.0);
    assert_true(C2 != 0.0, "C2 allocation failed");
    assert_close(C2[2.0], 19.0, 0.0001, "C2[0,0] == 19.0");
    assert_close(C2[3.0], 22.0, 0.0001, "C2[0,1] == 22.0");
    assert_close(C2[4.0], 43.0, 0.0001, "C2[1,0] == 43.0");
    assert_close(C2[5.0], 50.0, 0.0001, "C2[1,1] == 50.0");
    free(A2); free(B2); free(C2);
    printf("  [PASS] 2x2 Square GEMM matches analytical ground truth.\n", "");
    cartan_flush(0.0);

    // Non-square matrix: A (3 x 5) * B (5 x 2) -> C (3 x 2)
    // Non-multiple of 4 inner dimension (K = 5.0) exercises both unrolled & cleanup loops!
    let M = 3.0;
    let K = 5.0;
    let N = 2.0;
    let A_rec = cartan_tensor_alloc(M * K);
    let B_rec = cartan_tensor_alloc(K * N);

    // Fill A with sequential indices: A[i, k] = i + k + 1.0
    var r = 0.0;
    while (r < M) {
        var c = 0.0;
        while (c < K) {
            A_rec[2.0 + r * K + c] = r + c + 1.0;
            c = c + 1.0;
        }
        r = r + 1.0;
    }

    // Fill B with alternating signs: B[k, j] = (k + 1.0) * (j + 1.0)
    var k_i = 0.0;
    while (k_i < K) {
        var j_i = 0.0;
        while (j_i < N) {
            B_rec[2.0 + k_i * N + j_i] = (k_i + 1.0) * (j_i + 1.0);
            j_i = j_i + 1.0;
        }
        k_i = k_i + 1.0;
    }

    let C_rec = cartan_tensor_matmul_gemm(A_rec, B_rec, M, K, N);
    assert_true(C_rec != 0.0, "C_rec allocation failed");

    // Manually calculate C[0, 0] = sum_{k=0..4} (0 + k + 1) * (k + 1) * 1:
    // k=0: 1*1 = 1
    // k=1: 2*2 = 4
    // k=2: 3*3 = 9
    // k=3: 4*4 = 16
    // k=4: 5*5 = 25
    // Sum = 1 + 4 + 9 + 16 + 25 = 55.0
    assert_close(C_rec[2.0], 55.0, 0.0001, "C_rec[0,0] == 55.0");

    // C[0, 1] = sum_{k=0..4} (k + 1) * (k + 1) * 2 = 55.0 * 2.0 = 110.0
    assert_close(C_rec[3.0], 110.0, 0.0001, "C_rec[0,1] == 110.0");

    // C[1, 0] = sum_{k=0..4} (1 + k + 1) * (k + 1) = sum (k + 2)(k + 1)
    // k=0: 2*1 = 2
    // k=1: 3*2 = 6
    // k=2: 4*3 = 12
    // k=3: 5*4 = 20
    // k=4: 6*5 = 30
    // Sum = 2 + 6 + 12 + 20 + 30 = 70.0
    assert_close(C_rec[4.0], 70.0, 0.0001, "C_rec[1,0] == 70.0");
    free(A_rec); free(B_rec); free(C_rec);
    printf("  [PASS] 3x5 * 5x2 Rectangular GEMM (K=5 non-multiple of 4) verified.\n", "");
    cartan_flush(0.0);

    // =========================================================================
    // Phase 2: 2D Tree GEMM & Matrix-Vector Correctness (cartan_tensor_matmul)
    // =========================================================================
    printf("Phase 2: Validating 2D Tree Transpose-Cached GEMM & Mat-Vec...\n", "");
    // Matrix A as 2D Tree (2 rows of 2 elements)
    let TreeA = cartan_tree_create();
    let rowA0 = cartan_tensor_alloc(2.0); rowA0[2.0] = 2.0; rowA0[3.0] = 3.0;
    let rowA1 = cartan_tensor_alloc(2.0); rowA1[2.0] = 4.0; rowA1[3.0] = 5.0;
    cartan_tree_push(TreeA, rowA0);
    cartan_tree_push(TreeA, rowA1);

    // Matrix B as 2D Tree (2 rows of 2 elements)
    let TreeB = cartan_tree_create();
    let rowB0 = cartan_tensor_alloc(2.0); rowB0[2.0] = 1.0; rowB0[3.0] = 0.0;
    let rowB1 = cartan_tensor_alloc(2.0); rowB1[2.0] = 0.0; rowB1[3.0] = 1.0;
    cartan_tree_push(TreeB, rowB0);
    cartan_tree_push(TreeB, rowB1);

    // C = TreeA * TreeB (identity matrix multiplication)
    let TreeC = cartan_tensor_matmul(TreeA, TreeB);
    assert_true(TreeC != 0.0, "TreeC allocation failed");
    let c0 = cartan_tree_get_f32(TreeC, 0.0);
    let c1 = cartan_tree_get_f32(TreeC, 1.0);
    assert_close(cartan_vec_get_f32(c0, 0.0), 2.0, 0.0001, "TreeC[0,0] == 2.0");
    assert_close(cartan_vec_get_f32(c0, 1.0), 3.0, 0.0001, "TreeC[0,1] == 3.0");
    assert_close(cartan_vec_get_f32(c1, 0.0), 4.0, 0.0001, "TreeC[1,0] == 4.0");
    assert_close(cartan_vec_get_f32(c1, 1.0), 5.0, 0.0001, "TreeC[1,1] == 5.0");

    // Matrix-Vector Multiplication: TreeA (2 x 2) * VecV (2 x 1)
    let VecV = cartan_tensor_alloc(2.0);
    VecV[2.0] = 10.0; VecV[3.0] = 20.0;
    // Expected: [2*10 + 3*20 = 80.0; 4*10 + 5*20 = 140.0]
    let MatVecRes = cartan_tensor_matmul(TreeA, VecV);
    assert_true(MatVecRes != 0.0, "MatVecRes allocation failed");
    assert_close(cartan_vec_get_f32(MatVecRes, 0.0), 80.0, 0.0001, "MatVecRes[0] == 80.0");
    assert_close(cartan_vec_get_f32(MatVecRes, 1.0), 140.0, 0.0001, "MatVecRes[1] == 140.0");
    free(rowA0); free(rowA1); free(rowB0); free(rowB1); free(VecV); free(MatVecRes);
    printf("  [PASS] 2D Tree Identity GEMM and Matrix-Vector multiplication verified.\n", "");
    cartan_flush(0.0);

    // =========================================================================
    // Phase 3: 1D Flat Vector 4-Way Unrolled Dot Product (u @ v)
    // =========================================================================
    printf("Phase 3: Validating 4-Way Unrolled Dot Product...\n", "");
    // Length 17 (exercises 4 full 4-wide SIMD unrolls + 1 residual loop iteration)
    let V_LEN = 17.0;
    let u = cartan_tensor_alloc(V_LEN);
    let v = cartan_tensor_alloc(V_LEN);
    var idx = 0.0;
    var expected_dot = 0.0;
    while (idx < V_LEN) {
        let val_u = idx + 1.0;
        let val_v = (idx + 1.0) * 0.5;
        u[2.0 + idx] = val_u;
        v[2.0 + idx] = val_v;
        expected_dot = expected_dot + (val_u * val_v);
        idx = idx + 1.0;
    }

    let dot_res = cartan_tensor_matmul(u, v);
    assert_true(dot_res != 0.0, "dot_res allocation failed");
    let actual_dot = dot_res[2.0];
    assert_close(actual_dot, expected_dot, 0.001, "17-D Unrolled Dot Product match");
    printf("  Analytical dot: %s | Unrolled computed: %s\n",
           cartan_float_to_string(expected_dot), cartan_float_to_string(actual_dot));
    free(u); free(v); free(dot_res);
    printf("  [PASS] 1D Flat Vector 4-Way Unrolled Dot Product verified.\n", "");
    cartan_flush(0.0);

    // =========================================================================
    // Phase 4: Elementwise Tensor Operations (add, sub, mul, div)
    // =========================================================================
    printf("Phase 4: Validating Exact Allocation Elementwise Operations...\n", "");
    let E_LEN = 20.0;
    let op_a = cartan_tensor_alloc(E_LEN);
    let op_b = cartan_tensor_alloc(E_LEN);
    var e_i = 0.0;
    while (e_i < E_LEN) {
        op_a[2.0 + e_i] = (e_i + 1.0) * 3.0;
        op_b[2.0 + e_i] = (e_i + 1.0) * 2.0;
        e_i = e_i + 1.0;
    }

    let res_add = cartan_tensor_add(op_a, op_b);
    let res_sub = cartan_tensor_sub(op_a, op_b);
    let res_mul = cartan_tensor_mul(op_a, op_b);
    let res_div = cartan_tensor_div(op_a, op_b);

    assert_true(res_add != 0.0 && res_sub != 0.0 && res_mul != 0.0 && res_div != 0.0, "Allocations valid");
    // Verify first and last elements
    assert_close(res_add[2.0], 5.0, 0.0001, "add[0] == 5.0");
    assert_close(res_sub[2.0], 1.0, 0.0001, "sub[0] == 1.0");
    assert_close(res_mul[2.0], 6.0, 0.0001, "mul[0] == 6.0");
    assert_close(res_div[2.0], 1.5, 0.0001, "div[0] == 1.5");

    assert_close(res_add[2.0 + 19.0], 100.0, 0.0001, "add[19] == 100.0");
    assert_close(res_sub[2.0 + 19.0], 20.0, 0.0001, "sub[19] == 20.0");
    assert_close(res_mul[2.0 + 19.0], 2400.0, 0.0001, "mul[19] == 2400.0");
    assert_close(res_div[2.0 + 19.0], 1.5, 0.0001, "div[19] == 1.5");

    free(op_a); free(op_b); free(res_add); free(res_sub); free(res_mul); free(res_div);
    printf("  [PASS] Elementwise add, sub, mul, div exact allocation & unrolling verified.\n", "");
    cartan_flush(0.0);

    // =========================================================================
    // Phase 5: Multi-Accumulator Reductions & GEMM Throughput Benchmark
    // =========================================================================
    printf("Phase 5: Multi-Accumulator Reductions & Performance Benchmark...\n", "");
    let RED_LEN = 1000.0;
    let red_vec = malloc(RED_LEN * 8.0);
    var r_idx = 0.0;
    while (r_idx < RED_LEN) {
        red_vec[r_idx] = 1.0;
        r_idx = r_idx + 1.0;
    }
    let total_sum = cartan_tensor_sum(red_vec, RED_LEN);
    let avg_mean = cartan_tensor_mean(red_vec, RED_LEN);
    assert_close(total_sum, 1000.0, 0.0001, "cartan_tensor_sum == 1000.0");
    assert_close(avg_mean, 1.0, 0.0001, "cartan_tensor_mean == 1.0");
    free(red_vec);
    printf("  [PASS] 4-way parallel accumulator sum: %s | mean: %s\n",
           cartan_float_to_string(total_sum), cartan_float_to_string(avg_mean));

    // Throughput Benchmark: 50 iterations of 32 x 32 Transpose-Tiled GEMM
    printf("  Benchmarking Transpose-Tiled GEMM (50 iterations of 32x32)...\n", "");
    let BENCH_DIM = 32.0;
    let bA = cartan_tensor_alloc(BENCH_DIM * BENCH_DIM);
    let bB = cartan_tensor_alloc(BENCH_DIM * BENCH_DIM);
    var b_i = 0.0;
    while (b_i < (BENCH_DIM * BENCH_DIM)) {
        bA[2.0 + b_i] = 0.1;
        bB[2.0 + b_i] = 0.2;
        b_i = b_i + 1.0;
    }

    var iter = 0.0;
    var dummy_acc = 0.0;
    while (iter < 50.0) {
        let bC = cartan_tensor_matmul_gemm(bA, bB, BENCH_DIM, BENCH_DIM, BENCH_DIM);
        dummy_acc = dummy_acc + bC[2.0];
        free(bC);
        iter = iter + 1.0;
    }
    // Each element of bC = 32 * (0.1 * 0.2) = 0.64
    // dummy_acc after 50 iterations = 50 * 0.64 = 32.0
    assert_close(dummy_acc, 32.0, 0.001, "Benchmark accumulator correctness");
    free(bA); free(bB);
    printf("  [PASS] GEMM Benchmark executed cleanly with accumulator: %s\n\n", cartan_float_to_string(dummy_acc));

    printf("=====================================================================\n", "");
    printf("  TARGET 82 PASSED: Core Runtime SIMD & Tensor Math Validated\n", "");
    printf("=====================================================================\n\n", "");
    cartan_flush(0.0);
    return 0.0;
}
