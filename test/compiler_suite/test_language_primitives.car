// test/compiler_suite/test_language_primitives.car
// Verifies native language primitive declarations, INT8 quantization, and hooks

fn main() -> float {
    cartan_print("Test 1: Sequence allocation");
    sequence seq_a[16.0];
    if (seq_a == 0.0) {
        cartan_print("FAIL: seq_a is null");
        return 1.0;
    }
    cartan_print("PASS: Sequence allocated");

    cartan_print("Test 2: Block allocation");
    block blk_b[32.0];
    if (blk_b == 0.0) {
        cartan_print("FAIL: blk_b is null");
        return 1.0;
    }
    cartan_print("PASS: Block allocated");

    cartan_print("Test 3: Lattice allocation");
    lattice lat_c[E8, 8.0];
    if (lat_c == 0.0) {
        cartan_print("FAIL: lat_c is null");
        return 1.0;
    }
    cartan_print("PASS: Lattice allocated");

    cartan_print("Test 4: Tree allocation");
    tree tr_d<Node>;
    if (tr_d == 0.0) {
        cartan_print("FAIL: tr_d is null");
        return 1.0;
    }
    cartan_print("PASS: Tree allocated");

    cartan_print("Test 5: Emit spike");
    emit spike(42.5);
    let last_spike = cartan_get_last_spike();
    if (last_spike != 42.5) {
        cartan_print("FAIL: last_spike mismatch");
        return 1.0;
    }
    cartan_print("PASS: Emit spike verified");

    cartan_print("Test 6: Quantize INT8");
    let t = cartan_vec_create();
    cartan_vec_push_f32(t, 2.0);
    cartan_vec_push_f32(t, -4.0);
    let q = quantize(t, INT8);
    let q0 = cartan_vec_get_f32(q, 0.0);
    let q1 = cartan_vec_get_f32(q, 1.0);
    if (q0 != 64.0 || q1 != -127.0) {
        cartan_print("FAIL: Quantize values incorrect");
        return 1.0;
    }
    cartan_print("PASS: Quantize INT8 verified");

    cartan_print("Test 7: Under fluid block");
    under fluid(fp16, bf16) {
        let f_val = 1.0;
    }
    cartan_print("PASS: Fluid block executed");

    cartan_print("Test 8: With sparsity block");
    with sparsity(4.0, 0.5) {
        let s_val = 1.0;
    }
    cartan_print("PASS: Sparsity block executed");

    cartan_print("ALL 8 LANGUAGE PRIMITIVES VERIFIED EMPIRICALLY");
    return 0.0;
}
