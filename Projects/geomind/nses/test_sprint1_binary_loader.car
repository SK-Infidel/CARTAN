// test/geomind/nses/test_sprint1_binary_loader.car
// NSES Phase 1 Verification Harness: .car_graph Flat Binary Loader & SIMD Vector Core
// Verification Gates: TS-1.1, TS-1.2, TS-1.3, TS-1.4

include "src/std/cargraph.cl";
include "src/cartanc/cargraph_simd.car";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn remove(path: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("================================================================================\n");
    printf("  NSES SPRINT 1 EMPIRICAL VERIFICATION HARNESS (test_sprint1_binary_loader)\n");
    printf("  Testing .car_graph Binary Storage Model & 1536-D SIMD Vector Math Core\n");
    printf("================================================================================\n\n");

    let test_file = "test_nses_graph_sprint1.car_graph";

    // -------------------------------------------------------------------------
    // GATE TS-1.1: Bitwise Roundtrip Serialization & Deserialization
    // -------------------------------------------------------------------------
    printf("[TS-1.1] Executing Flat Binary Serialization & Roundtrip Verification...\n");
    let builder = cargraph_builder_create(1536.0);
    cartan_assert(builder.embedding_dim == 1536.0, "TS-1.1 Builder embedding dim initialization");

    // Add Domain 0 (SYSTEM_CORE - universal conservation laws)
    cargraph_builder_add_domain(builder, 0.0, 0.0, 3.0, 3.0);
    // Add Domain 1 (PHYSICS)
    cargraph_builder_add_domain(builder, 1.0, 3.0, 1.0, 0.0);
    // Add Domain 2 (LOGIC)
    cargraph_builder_add_domain(builder, 2.0, 4.0, 1.0, 1.0);

    // Create synthetic 1536-D embeddings
    let v0 = malloc(1536.0 * 8.0);
    let v1 = malloc(1536.0 * 8.0);
    let v2 = malloc(1536.0 * 8.0);
    let v3 = malloc(1536.0 * 8.0);
    let v4 = malloc(1536.0 * 8.0);

    var k = 0.0;
    while (k < 1536.0) {
        v0[k] = sin(k * 0.1);
        v1[k] = cos(k * 0.1);
        v2[k] = sin(k * 0.2 + 1.0);
        v3[k] = cos(k * 0.2 + 0.5);
        v4[k] = sin(k * 0.3);
        k = k + 1.0;
    }
    // Normalize to unit sphere
    cargraph_simd_normalize_1536(v0);
    cargraph_simd_normalize_1536(v1);
    cargraph_simd_normalize_1536(v2);
    cargraph_simd_normalize_1536(v3);
    cargraph_simd_normalize_1536(v4);

    // Add rules to builder
    // Rule 0 (Domain 0): Energy conservation
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant: Total energy is conserved delta_E = 0", v0);
    // Rule 1 (Domain 0): Momentum conservation
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant: Total momentum is conserved delta_p = 0", v1);
    // Rule 2 (Domain 0): Mass conservation
    cargraph_builder_add_rule(builder, 0.0, 0.0, 1.0, "Invariant: Baryon number is conserved", v2);
    // Rule 3 (Domain 1): Electron mass (associative fact)
    cargraph_builder_add_rule(builder, 1.0, 1.0, 0.0, "Fact: Electron rest mass is 9.1093837e-31 kg", v3);
    // Rule 4 (Domain 2): Law of non-contradiction
    cargraph_builder_add_rule(builder, 2.0, 0.0, 1.0, "Axiom: Law of non-contradiction not(P and not_P)", v4);

    let write_ok = cargraph_serialize_to_file(builder, test_file);
    cartan_assert(write_ok == 1.0, "TS-1.1 Binary file write failure");
    printf("  -> Successfully serialized 5 rules across 3 domains into %s\n", test_file);

    // Load binary file back
    let cg = cargraph_load_binary(test_file);
    cartan_assert(cg.is_valid == 1.0, "TS-1.1 Loaded file is marked invalid");
    cartan_assert(cg.header.version == 1.0, "TS-1.1 Header version mismatch");
    cartan_assert(cg.header.embedding_dim == 1536.0, "TS-1.1 Embedding dimension mismatch");
    cartan_assert(cg.header.num_domains == 3.0, "TS-1.1 Domain count mismatch");
    cartan_assert(cg.header.num_rules == 5.0, "TS-1.1 Rule count mismatch");
    cartan_assert(cg.header.num_strict_rules == 4.0, "TS-1.1 Strict rule count mismatch");

    // Verify Rule 0 text and properties
    let r0 = cargraph_get_rule(cg, 0.0);
    cartan_assert(r0.element_id == 0.0, "TS-1.1 Rule 0 ID mismatch");
    cartan_assert(r0.domain_idx == 0.0, "TS-1.1 Rule 0 Domain mismatch (expected Domain 0 SYSTEM_CORE)");
    cartan_assert(r0.is_strict == 1.0, "TS-1.1 Rule 0 strictness mismatch (expected strict invariant)");

    let r0_text = cargraph_get_rule_text(cg, 0.0);
    cartan_assert(cartan_string_contains(r0_text, "Total energy is conserved") != 0.0, "TS-1.1 Rule 0 string text mismatch");
    printf("  -> Verified Rule 0 Text: '%s'\n", r0_text);

    // Verify Rule 3 (Domain 1, non-strict)
    let r3 = cargraph_get_rule(cg, 3.0);
    cartan_assert(r3.domain_idx == 1.0, "TS-1.1 Rule 3 Domain mismatch");
    cartan_assert(r3.is_strict == 0.0, "TS-1.1 Rule 3 strictness mismatch (expected non-strict)");
    let r3_text = cargraph_get_rule_text(cg, 3.0);
    cartan_assert(cartan_string_contains(r3_text, "Electron rest mass") != 0.0, "TS-1.1 Rule 3 text mismatch");
    printf("  -> Verified Rule 3 Text: '%s'\n", r3_text);

    // Verify embedding bitwise roundtrip accuracy
    let r0_emb = cargraph_get_rule_embedding(cg, 0.0);
    cartan_assert(r0_emb != 0.0, "TS-1.1 Rule 0 embedding pointer null");
    var max_err = 0.0;
    var chk_i = 0.0;
    while (chk_i < 1536.0) {
        let diff = math_abs_val(r0_emb[chk_i] - v0[chk_i]);
        if (diff > max_err) { max_err = diff; }
        chk_i = chk_i + 1.0;
    }
    cartan_assert(max_err < 0.0000001, "TS-1.1 Embedding numerical drift in roundtrip");
    printf("  -> Embedding roundtrip verified bit-for-bit exact (Max float diff: %g)\n", max_err);
    printf("  -> [PASS] GATE TS-1.1 Verified Cleanly!\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-1.2: Section & Vector 64-Byte Cacheline Alignment
    // -------------------------------------------------------------------------
    printf("[TS-1.2] Verifying Section Offsets & 64-Byte Alignment Invariants...\n");
    cartan_assert(math_mod_val(cg.header.offset_domains, 4096.0) == 0.0, "TS-1.2 Domains offset not 4096B page-aligned");
    cartan_assert(math_mod_val(cg.header.offset_rules, 4096.0) == 0.0, "TS-1.2 Rules offset not 4096B page-aligned");
    cartan_assert(math_mod_val(cg.header.offset_embeddings, 64.0) == 0.0, "TS-1.2 Embeddings offset not 64B cacheline-aligned");
    cartan_assert(math_mod_val(cg.header.offset_string_pool, 4096.0) == 0.0, "TS-1.2 String pool offset not 4096B page-aligned");

    // Verify vector stride is an exact multiple of 64 bytes
    let vector_stride_bytes = cg.header.embedding_dim * 8.0;
    cartan_assert(math_mod_val(vector_stride_bytes, 64.0) == 0.0, "TS-1.2 1536-D vector byte stride not multiple of 64B");
    printf("  -> Section offsets verified: Domains (Offset: %g), Rules (Offset: %g), Embeddings (Offset: %g)\n",
           cg.header.offset_domains, cg.header.offset_rules, cg.header.offset_embeddings);
    printf("  -> Vector stride verified: %g bytes (%g cachelines per vector)\n", vector_stride_bytes, vector_stride_bytes / 64.0);
    printf("  -> [PASS] GATE TS-1.2 Verified Cleanly!\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-1.3: Fuzzing & Corruption Protection Gate
    // -------------------------------------------------------------------------
    printf("[TS-1.3] Executing Header Fuzzing & Malformed Buffer Rejection...\n");
    
    // Test 1: Non-existent file
    let bad_file_view = cargraph_load_binary("non_existent_graph.car_graph");
    cartan_assert(bad_file_view.is_valid == 0.0, "TS-1.3 Non-existent file must return invalid view");
    printf("  -> Rejection 1: Non-existent file rejected safely.\n");

    // Test 2: Truncated file (< 128 bytes)
    let trunc_path = "fuzz_truncated.car_graph";
    let trunc_buf = cartan_alloc_binary_buffer(32.0);
    cartan_write_binary_file(trunc_path, trunc_buf, 32.0);
    cartan_free_binary_buffer(trunc_buf);
    let trunc_view = cargraph_load_binary(trunc_path);
    cartan_assert(trunc_view.is_valid == 0.0, "TS-1.3 Truncated file must return invalid view");
    remove(trunc_path);
    printf("  -> Rejection 2: Truncated header buffer (<128B) rejected safely.\n");

    // Test 3: Corrupt Magic Bytes
    let corrupt_magic_path = "fuzz_corrupt_magic.car_graph";
    let corrupt_buf = cartan_alloc_binary_buffer(256.0);
    cartan_set_byte(corrupt_buf, 0.0, 88.0); // 'X' instead of 'C'
    cartan_write_binary_file(corrupt_magic_path, corrupt_buf, 256.0);
    cartan_free_binary_buffer(corrupt_buf);
    let corrupt_view = cargraph_load_binary(corrupt_magic_path);
    cartan_assert(corrupt_view.is_valid == 0.0, "TS-1.3 Corrupt magic bytes must return invalid view");
    remove(corrupt_magic_path);
    printf("  -> Rejection 3: Corrupted magic signature rejected safely.\n");
    printf("  -> [PASS] GATE TS-1.3 Verified Cleanly (Zero crashes, zero memory faults)!\n\n");

    // -------------------------------------------------------------------------
    // GATE TS-1.4: SIMD Vector Math Core & Top-K Cosine Search Benchmark
    // -------------------------------------------------------------------------
    printf("[TS-1.4] Executing SIMD Cosine Similarity & Top-K Retrieval Benchmark...\n");
    
    // Test exact unit similarity
    let dot_self = cargraph_simd_cosine_sim_1536(v0, v0);
    let dot_self_diff = math_abs_val(dot_self - 1.0);
    cartan_assert(dot_self_diff < 0.000001, "TS-1.4 Self-dot product of unit vector must equal 1.0");
    printf("  -> Cosine self-similarity verified: %g (delta from 1.0: %g)\n", dot_self, dot_self_diff);

    // Test distinct vector cosine distance
    let sim_0_1 = cargraph_simd_cosine_sim_1536(v0, v1);
    printf("  -> Cross-vector cosine similarity (v0 vs v1): %g\n", sim_0_1);

    // Test Top-K retrieval across loaded rule embeddings
    let query_vec = v0; // Querying with v0 should find Rule 0 as Rank 1 match
    let topk_indices = malloc(3.0 * 8.0);
    let topk_scores = malloc(3.0 * 8.0);
    cargraph_simd_batch_topk(query_vec, cg.embeddings_ptr, cg.header.num_rules, 3.0, topk_indices, topk_scores);

    cartan_assert(topk_indices[0.0] == 0.0, "TS-1.4 Top-K Rank 1 match must be Rule 0");
    cartan_assert(math_abs_val(topk_scores[0.0] - 1.0) < 0.000001, "TS-1.4 Top-K Rank 1 score must be 1.0");
    printf("  -> Top-K Rank 1 match: Rule %g with Cosine Similarity: %g (Target: Rule 0)\n", topk_indices[0.0], topk_scores[0.0]);
    printf("  -> Top-K Rank 2 match: Rule %g with Cosine Similarity: %g\n", topk_indices[1.0], topk_scores[1.0]);
    printf("  -> Top-K Rank 3 match: Rule %g with Cosine Similarity: %g\n", topk_indices[2.0], topk_scores[2.0]);

    // 1,000-Iteration SIMD Dot Product Benchmark
    var iter = 0.0;
    var acc = 0.0;
    while (iter < 1000.0) {
        acc = acc + cargraph_simd_dot_1536(v0, v1);
        iter = iter + 1.0;
    }
    printf("  -> 1,000 SIMD 1536-D Dot Products completed successfully (Accumulator: %g)\n", acc);
    printf("  -> [PASS] GATE TS-1.4 Verified Cleanly!\n\n");

    // Clean up
    cargraph_free(cg);
    remove(test_file);
    free(v0); free(v1); free(v2); free(v3); free(v4);
    free(topk_indices); free(topk_scores);

    printf("================================================================================\n");
    printf("  ALL SPRINT 1 NSES GATES PASSED EMPIRICALLY WITH ZERO REGRESSIONS!\n");
    printf("================================================================================\n");
    return 0.0;
}
