// Projects/geomind/Testing-scratch/test_stdlib_algebra_lie.car
// // run-pass
// Target 93: CARTAN Standard Library — Pillar 3: Lie Algebras, Pre-Lie Systems, Lie Superalgebras & Poisson Brackets

include "src/std/constants.ch";
include "src/std/math.cl";
include "src/std/algebra/lie.cl";

extern fn printf(fmt: string, v: float) -> float;
extern fn puts(s: string) -> float;
extern fn exit(code: float) -> void;
extern fn cartan_flush(v: float) -> float;

fn approx_eq(a: float, b: float, eps: float) -> float {
    if (fabs(a - b) <= eps) { return 1.0; }
    return 0.0;
}

fn assert_true(cond: float, test_name: string) {
    if (cond == 1.0) {
        printf("  [PASS] ");
        puts(test_name);
    } else {
        printf("  [FAIL] ");
        puts(test_name);
        cartan_flush(0.0);
        exit(1.0);
    }
}

fn main() -> float {
    puts("======================================================================");
    puts("  TARGET 93: Lie Algebras, Pre-Lie Systems, Superalgebras & Poisson");
    puts("======================================================================");

    // ------------------------------------------------------------------------
    // Gate 1: Finite-Dimensional Lie Algebras, Structure Constants, Jacobi & Killing Form
    // ------------------------------------------------------------------------
    puts("\n[Gate 1: Finite-Dimensional Lie Algebras, Structure Constants, Jacobi & Killing Form]");

    // Instantiate so(3) Lie algebra (dim = 3)
    // Generators: e0, e1, e2 with [e0, e1] = e2, [e1, e2] = e0, [e2, e0] = e1
    let so3 = alg_lie_create(3.0);
    alg_lie_set_structure(so3, 0.0, 1.0, 2.0, 1.0);
    alg_lie_set_structure(so3, 1.0, 2.0, 0.0, 1.0);
    alg_lie_set_structure(so3, 2.0, 0.0, 1.0, 1.0);

    // Verify structure constants and automated skew-symmetry enforcement
    assert_true(approx_eq(alg_lie_get_structure(so3, 0.0, 1.0, 2.0), 1.0, 0.0001) == 1.0, "c_01^2 == 1.0");
    assert_true(approx_eq(alg_lie_get_structure(so3, 1.0, 0.0, 2.0), -1.0, 0.0001) == 1.0, "c_10^2 == -1.0 (skew-symmetry)");
    assert_true(approx_eq(alg_lie_get_structure(so3, 1.0, 2.0, 0.0), 1.0, 0.0001) == 1.0, "c_12^0 == 1.0");
    assert_true(approx_eq(alg_lie_get_structure(so3, 2.0, 1.0, 0.0), -1.0, 0.0001) == 1.0, "c_21^0 == -1.0");
    assert_true(approx_eq(alg_lie_get_structure(so3, 2.0, 0.0, 1.0), 1.0, 0.0001) == 1.0, "c_20^1 == 1.0");
    assert_true(approx_eq(alg_lie_get_structure(so3, 0.0, 2.0, 1.0), -1.0, 0.0001) == 1.0, "c_02^1 == -1.0");

    // Jacobi Identity Verification: [[e_i, e_j], e_k] + cyclic = 0 across all 27 triples
    let jacobi_so3 = alg_lie_jacobi_check(so3, 0.0001);
    assert_true(jacobi_so3 == 1.0, "Jacobi identity holds across all 27 triples of so(3)");

    // Adjoint Representation: ad_e0 where (ad_e0)_{kj} = c_{0j}^k
    let e0_vec = calloc(3.0, 8.0);
    e0_vec[0] = 1.0;
    let ad_e0 = alg_lie_adjoint_matrix(so3, e0_vec);
    // (ad_e0)_{2, 1} = c_{01}^2 = 1.0, (ad_e0)_{1, 2} = c_{02}^1 = -1.0
    assert_true(approx_eq(alg_mat_get(ad_e0, 2.0, 1.0), 1.0, 0.0001) == 1.0, "(ad_e0)_{2,1} == c_01^2 == 1.0");
    assert_true(approx_eq(alg_mat_get(ad_e0, 1.0, 2.0), -1.0, 0.0001) == 1.0, "(ad_e0)_{1,2} == c_02^1 == -1.0");

    // Killing Metric Form: K_ij = Tr(ad_ei ad_ej) = -2 * delta_ij for so(3)
    let k_so3 = alg_lie_killing_matrix(so3);
    assert_true(approx_eq(alg_mat_get(k_so3, 0.0, 0.0), -2.0, 0.0001) == 1.0, "Killing metric K_00 == -2.0");
    assert_true(approx_eq(alg_mat_get(k_so3, 1.0, 1.0), -2.0, 0.0001) == 1.0, "Killing metric K_11 == -2.0");
    assert_true(approx_eq(alg_mat_get(k_so3, 2.0, 2.0), -2.0, 0.0001) == 1.0, "Killing metric K_22 == -2.0");
    assert_true(approx_eq(alg_mat_get(k_so3, 0.0, 1.0), 0.0, 0.0001) == 1.0, "Killing metric K_01 off-diagonal == 0.0");

    // Cartan Semisimplicity Criterion: det(K) = (-2)^3 = -8.0 != 0
    let ss_so3 = alg_lie_is_semisimple(so3);
    assert_true(ss_so3 == 1.0, "Cartan semisimplicity criterion confirms so(3) is semisimple (det(K) = -8)");

    // Negative Control: 3D Abelian Lie algebra (all c_ij^k = 0)
    let abelian = alg_lie_create(3.0);
    let ss_abel = alg_lie_is_semisimple(abelian);
    assert_true(ss_abel == 0.0, "Negative control: abelian Lie algebra is NOT semisimple (det(K) == 0)");

    // Cleanup Gate 1
    alg_lie_free(so3);
    alg_lie_free(abelian);
    free(e0_vec);
    alg_mat_free(ad_e0);
    alg_mat_free(k_so3);

    // ------------------------------------------------------------------------
    // Gate 2: Classical Matrix Lie Algebras & BCH Formula
    // ------------------------------------------------------------------------
    puts("\n[Gate 2: Classical Matrix Lie Algebras & BCH Formula]");

    let jx = alg_so3_jx();
    let jy = alg_so3_jy();
    let jz = alg_so3_jz();

    // Verify matrix commutators: [Jx, Jy] = Jz, [Jy, Jz] = Jx, [Jz, Jx] = Jy
    let comm_xy = alg_lie_mat_commutator(jx, jy);
    assert_true(approx_eq(alg_mat_get(comm_xy, 0.0, 1.0), -1.0, 0.0001) == 1.0, "[Jx, Jy](0,1) matches Jz == -1.0");
    assert_true(approx_eq(alg_mat_get(comm_xy, 1.0, 0.0), 1.0, 0.0001) == 1.0, "[Jx, Jy](1,0) matches Jz == 1.0");

    let comm_yz = alg_lie_mat_commutator(jy, jz);
    assert_true(approx_eq(alg_mat_get(comm_yz, 1.0, 2.0), -1.0, 0.0001) == 1.0, "[Jy, Jz](1,2) matches Jx == -1.0");
    assert_true(approx_eq(alg_mat_get(comm_yz, 2.0, 1.0), 1.0, 0.0001) == 1.0, "[Jy, Jz](2,1) matches Jx == 1.0");

    // Symplectic Lie algebra condition: M^T J + J M = 0 for sp(2, R)
    let m_sp = alg_mat_create(2.0, 2.0);
    alg_mat_set(m_sp, 0.0, 0.0, 1.0);
    alg_mat_set(m_sp, 1.0, 1.0, -1.0); // Traceless diag(1, -1) in sp(2, R)
    assert_true(alg_sp_is_hamiltonian(m_sp, 1.0, 0.0001) == 1.0, "Matrix condition confirms M is in sp(2, R)");

    // Negative Control: Non-Hamiltonian matrix
    let m_non_sp = alg_mat_create(2.0, 2.0);
    alg_mat_set(m_non_sp, 0.0, 0.0, 1.0);
    alg_mat_set(m_non_sp, 1.0, 1.0, 1.0); // Trace = 2 != 0
    assert_true(alg_sp_is_hamiltonian(m_non_sp, 1.0, 0.0001) == 0.0, "Negative control: non-Hamiltonian matrix rejected from sp(2, R)");

    // Baker-Campbell-Hausdorff (BCH) Formula:
    // For commuting matrices X, Y: [X, Y] = 0 => Z = X + Y
    let x_diag = alg_mat_create(2.0, 2.0);
    alg_mat_set(x_diag, 0.0, 0.0, 2.0);
    let y_diag = alg_mat_create(2.0, 2.0);
    alg_mat_set(y_diag, 0.0, 0.0, 3.0);
    let bch_comm = alg_lie_bch_order2(x_diag, y_diag);
    assert_true(approx_eq(alg_mat_get(bch_comm, 0.0, 0.0), 5.0, 0.0001) == 1.0, "BCH on commuting matrices matches X + Y == 5.0");

    // BCH for non-commuting rotation generators: X = 0.1 Jx, Y = 0.1 Jy
    let x_rot = alg_mat_scale(jx, 0.1);
    let y_rot = alg_mat_scale(jy, 0.1);
    let bch_rot = alg_lie_bch_order2(x_rot, y_rot);
    // (1/2)[X, Y] = 0.5 * 0.01 * Jz => coeff at (0, 1) is 0.005 * (-1) = -0.005
    assert_true(approx_eq(alg_mat_get(bch_rot, 0.0, 1.0), -0.005, 0.0001) == 1.0, "BCH order-2 commutator contribution verified");

    // Cleanup Gate 2
    alg_mat_free(jx);
    alg_mat_free(jy);
    alg_mat_free(jz);
    alg_mat_free(comm_xy);
    alg_mat_free(comm_yz);
    alg_mat_free(m_sp);
    alg_mat_free(m_non_sp);
    alg_mat_free(x_diag);
    alg_mat_free(y_diag);
    alg_mat_free(bch_comm);
    alg_mat_free(x_rot);
    alg_mat_free(y_rot);
    alg_mat_free(bch_rot);

    // ------------------------------------------------------------------------
    // Gate 3: Pre-Lie (Vinberg) Left-Symmetric Algebras
    // ------------------------------------------------------------------------
    puts("\n[Gate 3: Pre-Lie (Vinberg) Left-Symmetric Algebras]");

    // Construct 2D affine Pre-Lie algebra on R^2:
    // e0 · e0 = e0, e0 · e1 = e1, e1 · e0 = 0, e1 · e1 = 0
    let pl = alg_prelie_create(2.0);
    alg_prelie_set(pl, 0.0, 0.0, 0.0, 1.0);
    alg_prelie_set(pl, 0.0, 1.0, 1.0, 1.0);

    // Verify left-symmetric identity: (x, y, z) = (y, x, z) across all triples
    let id_left = alg_prelie_verify_identity(pl, 0.0001);
    assert_true(id_left == 1.0, "Pre-Lie left-symmetric identity (x,y,z) == (y,x,z) verified");

    // Induced Lie Bracket: [e0, e1] = e0 · e1 - e1 · e0 = e1 - 0 = e1
    let v0 = calloc(2.0, 8.0);
    v0[0] = 1.0;
    let v1 = calloc(2.0, 8.0);
    v1[1] = 1.0;

    let ind_comm = alg_prelie_induced_bracket(pl, v0, v1);
    assert_true(approx_eq(ind_comm[1], 1.0, 0.0001) == 1.0, "Induced Pre-Lie commutator [e0, e1] == e1");
    assert_true(approx_eq(ind_comm[0], 0.0, 0.0001) == 1.0, "Induced Pre-Lie commutator [e0, e1] component 0 == 0.0");

    // Cleanup Gate 3
    alg_prelie_free(pl);
    free(v0);
    free(v1);
    free(ind_comm);

    // ------------------------------------------------------------------------
    // Gate 4: Graded Lie Superalgebras & Classical Poisson Phase Space
    // ------------------------------------------------------------------------
    puts("\n[Gate 4: Graded Lie Superalgebras & Classical Poisson Phase Space]");

    // 2D Lie Superalgebra: e0 is boson (|e0| = 0), e1 is fermion (|e1| = 1)
    // Anticommutator [e1, e1] = 2 * e1^2 = e0
    let l_super = alg_super_create(1.0, 1.0);
    alg_super_set(l_super, 1.0, 1.0, 0.0, 1.0);

    // Verify fermionic anticommutation: [f, f] = +[f, f] = e0
    assert_true(approx_eq(alg_super_get(l_super, 1.0, 1.0, 0.0), 1.0, 0.0001) == 1.0, "Superalgebra fermionic bracket [f, f] == e0 (boson)");

    // Verify Super-Jacobi identity
    let sj_check = alg_super_jacobi_check(l_super, 0.0001);
    assert_true(sj_check == 1.0, "Super-Jacobi identity verified on graded superalgebra");

    // Classical Poisson Phase Space (1 Degree of Freedom: q, p)
    let ps = alg_poisson_create(1.0);

    // Observable gradients: grad_q = (1, 0), grad_p = (0, 1)
    let g_q = calloc(2.0, 8.0);
    g_q[0] = 1.0; // dq/dq = 1, dq/dp = 0

    let g_p = calloc(2.0, 8.0);
    g_p[1] = 1.0; // dp/dq = 0, dp/dp = 1

    // Canonical Poisson Bracket: {q, p} = 1.0, {q, q} = 0.0, {p, p} = 0.0
    let pb_qp = alg_poisson_bracket(ps, g_q, g_p);
    assert_true(approx_eq(pb_qp, 1.0, 0.0001) == 1.0, "Canonical Poisson bracket {q, p} == 1.0");

    let pb_qq = alg_poisson_bracket(ps, g_q, g_q);
    assert_true(approx_eq(pb_qq, 0.0, 0.0001) == 1.0, "Canonical Poisson bracket {q, q} == 0.0");

    // Leibniz Derivation Rule: {q, p^2} = {q, p} * p + p * {q, p} = 2p
    // At p = 3.0, d(p^2)/dp = 2p = 6.0 => grad_(p^2) = (0, 6)
    let g_p2 = calloc(2.0, 8.0);
    g_p2[1] = 6.0;

    let pb_qp2 = alg_poisson_bracket(ps, g_q, g_p2);
    assert_true(approx_eq(pb_qp2, 6.0, 0.0001) == 1.0, "Poisson bracket {q, p^2} matches Leibniz derivation == 6.0");

    // Cleanup Gate 4
    alg_super_free(l_super);
    free(g_q);
    free(g_p);
    free(g_p2);

    puts("======================================================================");
    puts("  TARGET 93 RESULT: ALL ASSERTIONS PASSED (100% SUCCESS)");
    puts("======================================================================");
    return 0.0;
}
