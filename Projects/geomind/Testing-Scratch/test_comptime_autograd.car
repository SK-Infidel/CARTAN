// test/compiler_suite/test_comptime_autograd.car
// // run-pass
// Sprint 11 Test Target: Comptime Expression Evaluation & Static Autograd

include "src/cartanc/ast.ch";
include "src/std/calculus.cl";

extern fn printf(fmt: string, v: float) -> float;
extern fn cartan_flush(v: float) -> float;

fn square(x: float) -> float {
    return x * x;
}

fn main() -> float {
    let grad_val = cartan_rt_autograd_forward_grad(3.0, square);
    printf("Autograd gradient at x=3.0: %f\n", grad_val);
    cartan_flush(0.0);
    return 0.0;
}
