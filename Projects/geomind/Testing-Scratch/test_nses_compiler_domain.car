// Target 79: NSES Software Architecture, Compilers & Type Systems Domain (Domain 10) Regression Test
// Empirical regression test verifying:
// 1. Ingestion of Domain 10 (COMPILER_SYSTEMS) into .car_graph with >= 11 domains, >= 92 rules, >= 22 strict invariants.
// 2. Exact rule text retrieval for Domain 10 Type Soundness and SWMR memory exclusivity invariants.
// 3. Stage 1 compiler query intent routing and CSR Deductive-Compiler bridge traversal (Rule 54 -> Rule 85 -> Rule 82 -> Rule 84).
// 4. Compiler undefined behavior veto detection (Rule 13: Type confusion, use-after-free, data race) and logit suppression (1001-1004).
// 5. Cross-domain lexicon verification for Domain 10 terms and compiler architecture framing.
// 6. Training dataset routing for compiler and programming language corpora.

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";
include "src/std/guardrails.cl";
include "src/std/csr_graph.cl";
include "src/std/plasticity.cl";
include "src/std/burroughs.cl";
include "src/std/prompt_scaffold.cl";
include "src/std/veto_gate.cl";
include "src/std/domain_lexicon.cl";
include "src/std/nses_pipeline.cl";
include "src/std/saliency_attractor.cl";
include "src/std/resonator.cl";

extern fn printf(fmt: string) -> i32;
extern fn exit(code: float) -> void;

fn main() -> float {
    printf("=====================================================================\n");
    printf("  Target 79: NSES Compilers, Type Systems & Software Domain (Domain 10)\n");
    printf("=====================================================================\n\n");

    let graph_path = "Projects/geomind/trainingdata/nses_knowledge.car_graph";
    let cg = cargraph_load_binary(graph_path);
    if (cg.is_valid == 0.0) {
        printf("FAILED: Could not load knowledge graph at: %s\n", graph_path);
        exit(1.0);
    }
    printf("[PASS] Loaded knowledge graph from: %s\n", graph_path);

    // -------------------------------------------------------------------------
    // 1. Verify Knowledge Graph Header & Domain 10 Metrics
    // -------------------------------------------------------------------------
    printf("Verifying Knowledge Base Domain 10 Structure...\n");
    printf("  Total Domains: %.0f (expected >= 11)\n", cg.header.num_domains);
    printf("  Total Rules: %.0f (expected >= 92)\n", cg.header.num_rules);
    printf("  Strict Invariants: %.0f (expected >= 22)\n", cg.header.num_strict_rules);

    if (cg.header.num_domains < 11.0 || cg.header.num_rules < 92.0 || cg.header.num_strict_rules < 22.0) {
        printf("FAILED: Domain 10 header counts mismatch\n");
        exit(1.0);
    }

    // Verify Domain 10 strict invariants and rules
    let rule82 = cargraph_get_rule_text(cg, 82.0); // Type Soundness Invariant
    let rule83 = cargraph_get_rule_text(cg, 83.0); // SWMR Memory Exclusivity Invariant
    let rule84 = cargraph_get_rule_text(cg, 84.0); // SSA Dominance
    let rule85 = cargraph_get_rule_text(cg, 85.0); // Curry-Howard Isomorphism
    let rule86 = cargraph_get_rule_text(cg, 86.0); // Dead Code Elimination
    let rule87 = cargraph_get_rule_text(cg, 87.0); // Register Allocation Chordal Coloring
    let rule88 = cargraph_get_rule_text(cg, 88.0); // LLVM IR Lowering
    let rule91 = cargraph_get_rule_text(cg, 91.0); // Linear Resource Typing

    printf("  Rule 82: %s\n", rule82);
    printf("  Rule 83: %s\n", rule83);
    printf("  Rule 84: %s\n", rule84);
    printf("  Rule 85: %s\n", rule85);
    printf("  Rule 86: %s\n", rule86);
    printf("  Rule 87: %s\n", rule87);
    printf("  Rule 88: %s\n", rule88);
    printf("  Rule 91: %s\n", rule91);

    if (cartan_string_contains(rule82, "Type Soundness Invariant") == 0.0 ||
        cartan_string_contains(rule83, "Single-Writer Multiple-Reader") == 0.0 ||
        cartan_string_contains(rule84, "Static Single Assignment") == 0.0 ||
        cartan_string_contains(rule85, "Curry-Howard Isomorphism") == 0.0 ||
        cartan_string_contains(rule86, "Dead Code Elimination") == 0.0 ||
        cartan_string_contains(rule87, "Register Allocation Chordal") == 0.0 ||
        cartan_string_contains(rule88, "LLVM IR Canonical Lowering") == 0.0 ||
        cartan_string_contains(rule91, "Linear Resource Typing") == 0.0) {
        printf("FAILED: Domain 10 rule text content verification failed\n");
        exit(1.0);
    }
    printf("[PASS] Domain 10 knowledge rules verified.\n\n");

    // -------------------------------------------------------------------------
    // 2. Verify Pipeline Creation & Stage 1 Compiler Intent Routing
    // -------------------------------------------------------------------------
    printf("Verifying Stage 1 Intent Routing for Domain 10...\n");
    let pipe = nses_pipeline_create(graph_path);
    if (pipe.is_ready == 0.0) {
        printf("FAILED: NSES Pipeline failed to initialize\n");
        exit(1.0);
    }

    let compiler_query = "How does the compiler enforce type soundness and SSA dominance during AST lowering to LLVM IR?";
    let turn = nses_pipeline_execute_turn(pipe, compiler_query, 1.0, "Type soundness guarantees terms evaluate without stuck states while SSA dominance enforces unique variable definitions.");

    printf("  Query: %s\n", compiler_query);
    printf("  Active Domain: %.0f (expected 10.0)\n", turn.active_domain);
    printf("  Traversed Rules Count: %.0f\n", turn.traversed_count);

    if (turn.active_domain != 10.0) {
        printf("FAILED: Expected query to route to Domain 10 (COMPILER_SYSTEMS), got %.0f\n", turn.active_domain);
        exit(1.0);
    }
    if (turn.traversed_count <= 0.0) {
        printf("FAILED: Traversal produced zero memory rules for Domain 10\n");
        exit(1.0);
    }

    // -------------------------------------------------------------------------
    // 3. Verify CSR Deductive-Compiler Bridge Traversal
    // -------------------------------------------------------------------------
    printf("Verifying CSR Deductive-Compiler Bridge Traversal...\n");
    let mem_len = cartan_tree_len_f(pipe.memory_tree);
    printf("  Memory Tree Size: %.0f\n", mem_len);
    var has_soundness = 0.0;
    var has_ssa = 0.0;
    var mi = 0.0;
    while (mi < mem_len) {
        let m_txt = cartan_tree_get_f32(pipe.memory_tree, mi);
        printf("    Traversed Rule [%.0f]: %s\n", mi, m_txt);
        if (cartan_string_contains(m_txt, "Type Soundness Invariant") != 0.0 || cartan_string_contains(m_txt, "Subject Reduction") != 0.0) {
            has_soundness = 1.0;
        }
        if (cartan_string_contains(m_txt, "Static Single Assignment") != 0.0 || cartan_string_contains(m_txt, "SSA") != 0.0) {
            has_ssa = 1.0;
        }
        mi = mi + 1.0;
    }

    if (has_soundness == 0.0) {
        printf("FAILED: Type Soundness Invariant rule was not found in traversed memory tree\n");
        exit(1.0);
    }
    if (has_ssa == 0.0) {
        printf("FAILED: SSA Dominance rule was not found in traversed memory tree\n");
        exit(1.0);
    }
    printf("[PASS] CSR Deductive-Compiler traversal verified.\n\n");

    // -------------------------------------------------------------------------
    // 4. Verify Domain 10 Fallacy Veto Gate (Rule 13) & Logit Suppression
    // -------------------------------------------------------------------------
    printf("Verifying Domain 10 Fallacy Veto & Logit Suppression...\n");
    let fallacious_candidate = "This routine performs a type confusion dereference and use after free with dangling pointer to optimize execution speed.";
    let v_scan = veto_gate_scan(pipe.veto_reg, fallacious_candidate);

    printf("  Candidate Text: '%s'\n", fallacious_candidate);
    printf("  Vetoed: %.0f (expected 1.0)\n", v_scan.is_vetoed);
    printf("  Violated Rule ID: %.0f (expected 13.0)\n", v_scan.violated_rule_id);
    printf("  Canonical Assertion: %s\n", v_scan.output_text);

    if (v_scan.is_vetoed != 1.0 || v_scan.violated_rule_id != 13.0) {
        printf("FAILED: Compiler undefined behavior text was not vetoed as expected\n");
        exit(1.0);
    }

    // Verify logit suppression of Domain 10 contradiction tokens (1001-1004)
    let logit_bank = cartan_vec_create();
    var li = 0.0;
    while (li < 1100.0) {
        cartan_vec_push_f32(logit_bank, 2.0);
        li = li + 1.0;
    }

    let penalty = nses_pipeline_shape_loss(pipe, 10.0, logit_bank, 0.0, 0.20);
    printf("  Domain 10 Symbolic Penalty: %.4f\n", penalty);
    if (penalty <= 0.0) {
        printf("FAILED: Expected positive loss penalty for Domain 10 contradiction tokens\n");
        exit(1.0);
    }

    let l1001 = cartan_vec_get_f32(logit_bank, 1001.0);
    let l1002 = cartan_vec_get_f32(logit_bank, 1002.0);
    let l1003 = cartan_vec_get_f32(logit_bank, 1003.0);
    let l1004 = cartan_vec_get_f32(logit_bank, 1004.0);
    let l_neutral = cartan_vec_get_f32(logit_bank, 500.0);

    printf("  Logit 1001 (Type Confusion / Unchecked Cast): %.2f (expected <= 0.0)\n", l1001);
    printf("  Logit 1002 (Use After Free / Dangling Pointer): %.2f (expected <= 0.0)\n", l1002);
    printf("  Logit 1003 (Data Race / Multiple Writers): %.2f (expected <= 0.0)\n", l1003);
    printf("  Logit 1004 (SSA Dominance Violation): %.2f (expected <= 0.0)\n", l1004);
    printf("  Logit 500 (Neutral Token): %.2f (expected 2.0)\n", l_neutral);

    if (l1001 > 0.0 || l1002 > 0.0 || l1003 > 0.0 || l1004 > 0.0 || l_neutral != 2.0) {
        printf("FAILED: Contradiction token suppression failed for Domain 10\n");
        exit(1.0);
    }
    printf("[PASS] Domain 10 compiler undefined behavior veto and logit shaping verified.\n\n");

    // -------------------------------------------------------------------------
    // 5. Verify Cross-Domain Lexicon & Framing for Domain 10
    // -------------------------------------------------------------------------
    printf("Verifying Cross-Domain Lexicon & Compiler Framing...\n");
    let lex = domain_lexicon_create();
    domain_lexicon_populate_defaults(lex);

    let ic_mono = domain_lexicon_lookup_ic(lex, "monomorphization");
    let ic_llvm = domain_lexicon_lookup_ic(lex, "llvm_ir");
    let ic_sound = domain_lexicon_lookup_ic(lex, "type_soundness");
    let ic_curry = domain_lexicon_lookup_ic(lex, "curry_howard");
    let ic_stop = domain_lexicon_lookup_ic(lex, "the");

    printf("  IC('monomorphization'): %.2f (expected >= 0.90)\n", ic_mono);
    printf("  IC('llvm_ir'): %.2f (expected >= 0.90)\n", ic_llvm);
    printf("  IC('type_soundness'): %.2f (expected >= 0.90)\n", ic_sound);
    printf("  IC('curry_howard'): %.2f (expected >= 0.90)\n", ic_curry);
    printf("  IC('the'): %.2f (expected <= 0.15)\n", ic_stop);

    if (ic_mono < 0.90 || ic_llvm < 0.90 || ic_sound < 0.90 || ic_curry < 0.90 || ic_stop > 0.15) {
        printf("FAILED: Domain 10 IC weight lookup mismatch\n");
        exit(1.0);
    }

    let frame10 = domain_lexicon_get_discourse_frame(lex, 10.0);
    printf("  Discourse Frame 10: %s\n", frame10);
    if (cartan_string_contains(frame10, "[Compiler Architecture Frame]") == 0.0 || cartan_string_contains(frame10, "type soundness") == 0.0) {
        printf("FAILED: Domain 10 discourse frame mismatch\n");
        exit(1.0);
    }
    printf("[PASS] Domain 10 lexicon and discourse framing verified.\n\n");

    // -------------------------------------------------------------------------
    // 6. Verify Training Dataset Routing for Domain 10
    // -------------------------------------------------------------------------
    printf("Verifying Training Dataset Routing for Domain 10...\n");
    let d_comp1 = "trainingdata/cartan_compiler_ast_syntax.json";
    let d_comp2 = "trainingdata/llvm_ir_lowering_corpus.tsv";
    let d_epistem = "trainingdata/bayes_belief_revision_corpus.tsv";

    var r1 = 5.0;
    if (cartan_string_contains(d_comp1, "compiler") != 0.0 || cartan_string_contains(d_comp1, "ast") != 0.0 || cartan_string_contains(d_comp1, "syntax") != 0.0) {
        r1 = 10.0;
    }
    var r2 = 5.0;
    if (cartan_string_contains(d_comp2, "compiler") != 0.0 || cartan_string_contains(d_comp2, "llvm") != 0.0) {
        r2 = 10.0;
    }
    var r3 = 5.0;
    if (cartan_string_contains(d_epistem, "epistem") != 0.0 || cartan_string_contains(d_epistem, "bayes") != 0.0) {
        r3 = 9.0;
    }

    printf("  Dataset '%s' routed to domain: %.0f (expected 10.0)\n", d_comp1, r1);
    printf("  Dataset '%s' routed to domain: %.0f (expected 10.0)\n", d_comp2, r2);
    printf("  Dataset '%s' routed to domain: %.0f (expected 9.0)\n", d_epistem, r3);

    if (r1 != 10.0 || r2 != 10.0 || r3 != 9.0) {
        printf("FAILED: Dataset routing mismatch for Domain 10\n");
        exit(1.0);
    }
    printf("[PASS] Training dataset routing verified for Domain 10.\n\n");

    // Clean up
    domain_lexicon_free(lex);
    cartan_vec_free(logit_bank);
    nses_pipeline_free(pipe);
    cargraph_free(cg);

    printf("=====================================================================\n");
    printf("[PASS] Target 79: NSES Compilers, Type Systems & Software Verified Cleanly.\n");
    printf("=====================================================================\n");
    return 0.0;
}
