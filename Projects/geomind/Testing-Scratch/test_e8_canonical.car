// Projects/geomind/test_e8_canonical.car
// Verification Suite for Canonical Lie Group E8 Roots, Weyl Group Reflections & FRS Brainstem

include "geometry.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("================================================================================\n");
    printf("  TEST: CANONICAL E8 LIE GROUP ROOTS, WEYL REFLECTIONS & FRS BRAINSTEM\n");
    printf("================================================================================\n\n");

    // 1. Verify 240 Canonical E8 Roots Generation
    let n_roots = geomind_init_e8_roots_if_needed();
    printf("[E8 Test Gate 1] Initialized Canonical Roots: %s (Expected: 240.0)\n", cartan_float_to_string(n_roots));
    cartan_assert(n_roots == 240.0, "Canonical E8 root count must equal 240");

    // 2. Verify Norm of Roots: ||alpha||^2 == 2.0 for all 240 roots
    var r = 0.0;
    while (r < 240.0) {
        let n_sq = geomind_e8_root_norm_sq(r);
        let diff = math_abs_val(n_sq - 2.0);
        if (diff > 0.0001) {
            printf("[E8 Test Gate 2 Failed at root %s]: norm_sq = %s\n", cartan_float_to_string(r), cartan_float_to_string(n_sq));
            cartan_assert(diff <= 0.0001, "All E8 roots must have norm squared equal to 2.0");
        }
        r = r + 1.0;
    }
    printf("[E8 Test Gate 2] Verified all 240 roots have norm^2 == 2.0 (length = sqrt(2)).\n");

    // 3. Verify Inner Products in {-2, -1, 0, 1, 2}
    var dot_ok = 1.0;
    var a = 0.0;
    while (a < 20.0) {
        var b = 0.0;
        while (b < 20.0) {
            let dot = geomind_e8_root_dot(a, b);
            let round_dot = floor(dot + 0.5);
            let d_diff = math_abs_val(dot - round_dot);
            if (d_diff > 0.0001 || round_dot < -2.0 || round_dot > 2.0) {
                dot_ok = 0.0;
            }
            b = b + 1.0;
        }
        a = a + 1.0;
    }
    cartan_assert(dot_ok == 1.0, "Inner products between E8 roots must lie in {-2, -1, 0, 1, 2}");
    printf("[E8 Test Gate 3] Verified Cartan crystallographic condition: <alpha, beta> in {-2, -1, 0, 1, 2}.\n");

    // 4. Verify Weyl Group Reflection Operator
    let v_in = cartan_vec_create();
    let v_out = cartan_vec_create();
    var d = 0.0;
    while (d < 8.0) {
        cartan_vec_push_f32(v_in, 1.0 + d * 0.5);
        cartan_vec_push_f32(v_out, 0.0);
        d = d + 1.0;
    }
    // Reflect v_in across root 0
    let dot_va = geomind_weyl_reflect(v_in, 0.0, v_out);
    // Isometry check: ||v_out||^2 == ||v_in||^2
    var norm_in = 0.0;
    var norm_out = 0.0;
    d = 0.0;
    while (d < 8.0) {
        let vi = cartan_vec_get_f32(v_in, d);
        let vo = cartan_vec_get_f32(v_out, d);
        norm_in = norm_in + vi * vi;
        norm_out = norm_out + vo * vo;
        d = d + 1.0;
    }
    let norm_diff = math_abs_val(norm_in - norm_out);
    printf("[E8 Test Gate 4] Weyl Reflection Isometry: In = %s | Out = %s (Diff = %s)\n",
           cartan_float_to_string(norm_in), cartan_float_to_string(norm_out), cartan_float_to_string(norm_diff));
    cartan_assert(norm_diff < 0.0001, "Weyl reflection must be an exact isometry (norm-preserving)");

    // 5. Verify 248D Projection
    let out_248 = cartan_vec_create();
    d = 0.0;
    while (d < 248.0) {
        cartan_vec_push_f32(out_248, 0.0);
        d = d + 1.0;
    }
    let proj_dim = geomind_project_cartan_to_e8_248(v_in, out_248);
    printf("[E8 Test Gate 5] 248-D Manifold Projection: Projected %s dimensions (8 Cartan + 240 Root Amplitudes).\n",
           cartan_float_to_string(proj_dim));
    cartan_assert(proj_dim == 248.0, "E8 projection must evaluate all 248 dimensions");

    // 6. Verify FRS Brainstem Router
    let pos_2560 = cartan_vec_create();
    let mom_2560 = cartan_vec_create();
    d = 0.0;
    while (d < 2560.0) {
        cartan_vec_push_f32(pos_2560, sin(d * 0.01));
        cartan_vec_push_f32(mom_2560, cos(d * 0.01) * 0.1);
        d = d + 1.0;
    }
    let frs_weights = geomind_frs_stream_routing(pos_2560, mom_2560, 0.70);
    var sum_w = 0.0;
    var s = 0.0;
    while (s < 8.0) {
        let w_s = cartan_vec_get_f32(frs_weights, s);
        sum_w = sum_w + w_s;
        s = s + 1.0;
    }
    printf("[E8 Test Gate 6] FRS Brainstem Router: Sum of 8-Stream Softmax Weights = %s\n",
           cartan_float_to_string(sum_w));
    cartan_assert(math_abs_val(sum_w - 1.0) < 0.0001, "FRS Brainstem softmax weights must sum to 1.0");

    printf("\nAll 6 Canonical E8 Geometry and FRS Brainstem Gates PASSED Cleanly!\n");
    cartan_flush(0.0);
    return 0.0;
}
