// test/compiler_suite/test_security_sandboxing.car
// // run-pass
// Sprint 9 Test Target: VRAM Capability Locks, SWMR Memory Fences & Hot-Swapping

include "src/cartanc/ast.ch";
include "src/std/security.cl";

extern fn printf(fmt: string, v: float) -> float;
extern fn cartan_flush(v: float) -> float;

fn main() -> float {
    cartan_rt_vram_lock_parameters();
    let write_allowed = cartan_rt_check_vram_access(100.0, 1.0);
    if (write_allowed == 0.0) {
        printf("VRAM Write-Lock Protection Active!\n", 0.0);
    }
    cartan_rt_vram_unlock_parameters();

    let swmr_ok = cartan_rt_lock_swmr(100.0, 1.0);
    if (swmr_ok != 0.0) {
        printf("SWMR Read Lock Acquired!\n", 0.0);
    }
    cartan_rt_unlock_swmr(100.0);

    cartan_flush(0.0);
    return 0.0;
}
