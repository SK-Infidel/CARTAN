// test/compiler_suite/test_es_opt.car
// CARTAN Evolution Strategies (ES) Optimizer Test Suite
// Verifies Mirrored Noise Perturbation, Score Function Gradient Updates, and Target Phrase Alignment

include "src/std/es_opt.cl";

extern fn printf(format: string) -> i32;
extern fn cartan_float_to_string(v: float) -> string;
extern fn cartan_flush(v: float) -> float;

fn main() -> float {
    printf("======================================================================\n");
    printf("  CARTAN EVOLUTION STRATEGIES (ES) OPTIMIZER SUITE (es_opt.cl)\n");
    printf("======================================================================\n\n");

    let dimension = 2.0;       // "A", "I"
    let population_size = 10.0; // 5 positive + 5 negative mirrored pairs
    let sigma = 2.0;
    let alpha = 0.05;

    let opt = es_optimizer_create(dimension, population_size, sigma, alpha);

    // Initial random character weights
    es_optimizer_set_param(opt, 0.0, 70.0); // 'F'
    es_optimizer_set_param(opt, 1.0, 80.0); // 'P'

    printf("[ES Opt] Initial Parameters: [%s, %s]\n", cartan_float_to_string(es_optimizer_get_param(opt, 0.0)), cartan_float_to_string(es_optimizer_get_param(opt, 1.0)));

    let target_0 = 65.0; // 'A'
    let target_1 = 73.0; // 'I'

    let n_half = population_size / 2.0;
    let fitness_pos = cartan_vec_create();
    let fitness_neg = cartan_vec_create();

    var gen = 0.0;
    while (gen < 20.0) {
        // Clear previous fitness evaluations
        cartan_vec_clear(fitness_pos);
        cartan_vec_clear(fitness_neg);

        var i = 0.0;
        while (i < n_half) {
            let p0_pos = es_optimizer_get_perturbed_param(opt, i * 2.0, 0.0, 1.0);
            let p1_pos = es_optimizer_get_perturbed_param(opt, i * 2.0, 1.0, 1.0);
            let err_pos = (p0_pos - target_0) * (p0_pos - target_0) + (p1_pos - target_1) * (p1_pos - target_1);
            let fit_pos = -0.5 * err_pos;
            cartan_vec_push_f32(fitness_pos, fit_pos);

            let p0_neg = es_optimizer_get_perturbed_param(opt, i * 2.0, 0.0, -1.0);
            let p1_neg = es_optimizer_get_perturbed_param(opt, i * 2.0, 1.0, -1.0);
            let err_neg = (p0_neg - target_0) * (p0_neg - target_0) + (p1_neg - target_1) * (p1_neg - target_1);
            let fit_neg = -0.5 * err_neg;
            cartan_vec_push_f32(fitness_neg, fit_neg);

            i = i + 1.0;
        }

        es_optimizer_step(opt, fitness_pos, fitness_neg);
        gen = gen + 1.0;
    }

    let final_0 = es_optimizer_get_param(opt, 0.0);
    let final_1 = es_optimizer_get_param(opt, 1.0);
    printf("[ES Opt] Gen 20 Optimization Parameters: [%s, %s] (Target: [65.0, 73.0])\n", cartan_float_to_string(final_0), cartan_float_to_string(final_1));

    if (final_0 < 70.0 && final_1 < 80.0) {
        printf("\n[SUCCESS] ES Optimizer Converged Towards Target Weights without Backpropagation!\n");
        return 0.0;
    }

    printf("\n[FAILURE] ES Optimizer Did Not Update Parameters Correctly.\n");
    return 1.0;
}
