// Projects/geomind/test_domain9_persistence.car
// Verification Suite: Domain 9 (SELF_AND_IDENTITY) & Conversational Learning Persistence

fn sleep_detect_attractor_voids(basins_file: string, dim: float) -> float { return 0.0; }
fn cartan_tensor_train_step(hidden_ptr: ptr, target_tok_id: float, learning_rate: float) -> float { return 0.0; }

include "Projects/geomind/chat.cl";

fn test_assert(cond: float, msg: string) -> float {
    if (cond == 0.0) {
        printf("[FAILURE] %s\n", msg);
        cartan_flush(0.0);
        return 0.0;
    }
    printf("[SUCCESS] %s\n", msg);
    cartan_flush(0.0);
    return 1.0;
}

fn main() -> float {
    printf("================================================================================\n");
    printf("  GEOMIND DOMAIN 9 (SELF_AND_IDENTITY) & PERSISTENCE VERIFICATION SUITE\n");
    printf("================================================================================\n\n");
    cartan_flush(0.0);

    let test_db_path = "Projects/geomind/trainingdata/test_identity_restart.db";
    if (cartan_file_exists(test_db_path) == 1.0) {
        remove(test_db_path);
    }

    // --- PHASE 1: Initial Database Creation & Seeding ---
    printf("--- Phase 1: Database Initialization & Domain 9 Schema ---\n");
    let db1 = sqlite_vec_open(test_db_path);
    test_assert(db1 != 0.0, "Opened new test database");
    sqlite_vec_init_schema(db1);
    sqlite_vec_upsert_domain(db1, 0.0, "SYSTEM_INVARIANTS", "Safety and Boundaries");
    sqlite_vec_upsert_domain(db1, 1.0, "PHYSICS_AND_WORLD", "World State");
    sqlite_vec_upsert_domain(db1, 9.0, "SELF_AND_IDENTITY", "Introspective Identity");

    // Seed defaults
    sqlite_vec_upsert_entity_state(db1, 1.0, "User", "preferred_name", "Rick", 1.0);
    sqlite_vec_upsert_entity_state(db1, 9.0, "Self", "name", "GeoMind", 1.0);
    sqlite_vec_upsert_entity_state(db1, 9.0, "Self", "creator", "Rick", 1.0);
    sqlite_vec_upsert_entity_state(db1, 9.0, "Self", "role", "Neuro-Symbolic Cognitive Assistant", 1.0);

    let n_init = cartan_sqlite_get_entity_state(db1, 9.0, "Self", "name");
    test_assert(cartan_string_eq(n_init, "GeoMind") == 1.0, "Initial Self.name == 'GeoMind'");

    // Point g_chat_db to db1 for conversational learning tests
    g_chat_db = db1;
    g_chat_db_init = 1.0;

    // --- PHASE 2: Conversational Learning from User ---
    printf("\n--- Phase 2: Conversational Learning - User Teaching ---\n");
    let u_learn1 = geomind_chat_learn_conversational_turn("user", "Your name is Aether.");
    test_assert(u_learn1 > 0.0, "Detected user naming pattern 'Your name is Aether.'");
    let n_after_u1 = cartan_sqlite_get_entity_state(db1, 9.0, "Self", "name");
    test_assert(cartan_string_eq(n_after_u1, "Aether") == 1.0, "Self.name updated to 'Aether'");

    let u_learn2 = geomind_chat_learn_conversational_turn("user", "Call me Daddy Rick.");
    test_assert(u_learn2 > 0.0, "Detected user name pattern 'Call me Daddy Rick.'");
    let user_name = cartan_sqlite_get_entity_state(db1, 1.0, "User", "preferred_name");
    test_assert(cartan_string_eq(user_name, "Daddy Rick") == 1.0, "User.preferred_name updated to 'Daddy Rick'");

    // --- PHASE 3: Autonomous Self-Naming Decision by Model ---
    printf("\n--- Phase 3: Conversational Learning - Model Autonomous Self-Naming ---\n");
    let m_learn = geomind_chat_learn_conversational_turn("model", "After considering my role, I choose the name Lumina.");
    test_assert(m_learn > 0.0, "Detected model self-decision 'I choose the name Lumina.'");
    let n_after_m = cartan_sqlite_get_entity_state(db1, 9.0, "Self", "name");
    test_assert(cartan_string_eq(n_after_m, "Lumina") == 1.0, "Self.name updated to 'Lumina'");

    // --- PHASE 4: Cognitive Preamble Verification ---
    printf("\n--- Phase 4: Cognitive Preamble Generation ---\n");
    let preamble = geomind_chat_build_cognitive_preamble(db1);
    printf("Generated Preamble:\n%s\n", preamble);
    test_assert(cartan_string_contains(preamble, "Lumina") == 1.0, "Preamble contains Self.name 'Lumina'");
    test_assert(cartan_string_contains(preamble, "Daddy Rick") == 1.0, "Preamble contains User 'Daddy Rick'");

    // --- PHASE 5: Process Restart & Persistence Simulation ---
    printf("\n--- Phase 5: Simulating Process Termination & Restart ---\n");
    sqlite_vec_close(db1);
    g_chat_db = 0.0;
    g_chat_db_init = 0.0;
    printf("[Simulated Restart] Process terminated. Database closed.\n");

    // New process restarts: opens database afresh
    let db2 = sqlite_vec_open(test_db_path);
    test_assert(db2 != 0.0, "[Simulated Restart] Successfully re-opened database");
    g_chat_db = db2;
    g_chat_db_init = 1.0;

    // Run startup seeding check (must NOT overwrite existing values)
    let s_name_re = cartan_sqlite_get_entity_state(db2, 9.0, "Self", "name");
    if (cartan_string_length(s_name_re) == 0.0) {
        sqlite_vec_upsert_entity_state(db2, 9.0, "Self", "name", "GeoMind", 1.0);
    }
    let u_name_re = cartan_sqlite_get_entity_state(db2, 1.0, "User", "preferred_name");
    if (cartan_string_length(u_name_re) == 0.0) {
        sqlite_vec_upsert_entity_state(db2, 1.0, "User", "preferred_name", "Rick", 1.0);
    }

    test_assert(cartan_string_eq(s_name_re, "Lumina") == 1.0, "[PERSISTENCE VERIFIED] Self.name retained 'Lumina' across process restart!");
    test_assert(cartan_string_eq(u_name_re, "Daddy Rick") == 1.0, "[PERSISTENCE VERIFIED] User.preferred_name retained 'Daddy Rick' across restart!");

    let restart_preamble = geomind_chat_build_cognitive_preamble(db2);
    test_assert(cartan_string_contains(restart_preamble, "Lumina") == 1.0, "Restart Preamble contains 'Lumina'");
    test_assert(cartan_string_contains(restart_preamble, "Daddy Rick") == 1.0, "Restart Preamble contains 'Daddy Rick'");

    sqlite_vec_close(db2);
    remove(test_db_path);

    printf("\n================================================================================\n");
    printf("  ALL DOMAIN 9 PERSISTENCE & CONVERSATIONAL LEARNING TESTS PASSED CLEANLY!\n");
    printf("================================================================================\n\n");
    cartan_flush(0.0);
    return 0.0;
}
