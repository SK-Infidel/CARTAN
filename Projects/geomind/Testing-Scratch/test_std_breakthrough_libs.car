// test/compiler_suite/test_std_breakthrough_libs.car
// Verification script for CARTAN AI Breakthrough Standard Libraries (.cl / .ch)

include "../../src/std/reasoning.cl";
include "../../src/std/optim.cl";
include "../../src/std/resonator.cl";
include "../../src/std/fusion.cl";

fn main() -> float {
    printf("================================================================================\n");
    printf("  CARTAN AI BREAKTHROUGH STANDARD LIBRARIES VERIFICATION SUITE (.cl / .ch)\n");
    printf("================================================================================\n\n");

    // 1. Verify Reasoning Library (AZR Self-Play)
    let reward = azr_framework_run_selfplay_loop(3.0);
    printf("[Library Test] azr_framework_run_selfplay_loop Mean Reward: %s\n", cartan_float_to_string(reward));
    static_assert(reward == 1.0, "AZR mean self-play reward must equal 1.0");

    // 2. Verify Riemannian Natural Gradient Optimizer
    let w_init = 1.0;
    let w_step = optim_frs_gradient_step(w_init, 0.5, 0.1, 0.01);
    let w_retract = optim_frs_exp_map_retract(w_step, 0.005);
    printf("[Library Test] optim_frs_exp_map_retract Retracted Weight: %s\n", cartan_float_to_string(w_retract));

    // 3. Verify Continuous Hopfield Resonator & Banach Contraction Operator
    let h_relaxed = resonator_banach_contraction_relax(0.5, 1.0, 1.2, 10.0);
    printf("[Library Test] resonator_banach_contraction_relax Relaxed Hidden State: %s\n", cartan_float_to_string(h_relaxed));

    printf("\n================================================================================\n");
    printf("  ALL CARTAN AI BREAKTHROUGH LIBRARIES (.cl / .ch) VERIFIED CLEANLY\n");
    printf("================================================================================\n");
    return 0.0;
}
