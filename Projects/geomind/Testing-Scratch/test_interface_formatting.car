// Projects/geomind/test_interface_formatting.car
// Verification Suite: Terminal Interface Formatting, Async Key Interruption & Structured Output (Sprint 533)

fn sleep_detect_attractor_voids(basins_file: string, dim: float) -> float { return 0.0; }
fn cartan_tensor_train_step(hidden_ptr: ptr, target_tok_id: float, learning_rate: float) -> float { return 0.0; }

include "Projects/geomind/chat.cl";

fn test_assert(cond: float, msg: string) -> float {
    if (cond == 0.0) {
        printf("[FAILURE] %s\n", msg);
        cartan_flush(0.0);
        return 0.0;
    }
    printf("[SUCCESS] %s\n", msg);
    cartan_flush(0.0);
    return 1.0;
}

fn main() -> float {
    printf("================================================================================\n");
    printf("  GEOMIND SPRINT 533 INTERFACE FORMATTING & ASYNC INTERRUPT VERIFICATION SUITE\n");
    printf("================================================================================\n\n");
    cartan_flush(0.0);

    var all_pass = 1.0;

    // -------------------------------------------------------------------------
    // Gate 1: State Variables & Getter/Setter Mutability
    // -------------------------------------------------------------------------
    printf("--- Gate 1: State Variables & Getter/Setter Mutability ---\n");
    all_pass = all_pass * test_assert(geomind_chat_get_show_thinking() == 0.0, "Default g_chat_show_thinking is 0.0 (hidden)");
    all_pass = all_pass * test_assert(geomind_chat_get_show_telemetry() == 0.0, "Default g_chat_show_telemetry is 0.0 (hidden)");
    all_pass = all_pass * test_assert(geomind_chat_get_buffered_output() == 1.0, "Default g_chat_buffered_output is 1.0 (buffered)");
    all_pass = all_pass * test_assert(geomind_chat_get_interrupted() == 0.0, "Default g_chat_interrupted is 0.0");

    geomind_chat_set_show_thinking(1.0);
    all_pass = all_pass * test_assert(geomind_chat_get_show_thinking() == 1.0, "Mutated g_chat_show_thinking to 1.0");
    geomind_chat_set_show_thinking(0.0);
    all_pass = all_pass * test_assert(geomind_chat_get_show_thinking() == 0.0, "Reset g_chat_show_thinking to 0.0");

    geomind_chat_set_show_telemetry(1.0);
    all_pass = all_pass * test_assert(geomind_chat_get_show_telemetry() == 1.0, "Mutated g_chat_show_telemetry to 1.0");
    geomind_chat_set_show_telemetry(0.0);
    all_pass = all_pass * test_assert(geomind_chat_get_show_telemetry() == 0.0, "Reset g_chat_show_telemetry to 0.0");

    geomind_chat_set_buffered_output(0.0);
    all_pass = all_pass * test_assert(geomind_chat_get_buffered_output() == 0.0, "Mutated g_chat_buffered_output to 0.0 (streaming)");
    geomind_chat_set_buffered_output(1.0);
    all_pass = all_pass * test_assert(geomind_chat_get_buffered_output() == 1.0, "Reset g_chat_buffered_output to 1.0 (buffered)");
    printf("\n");

    // -------------------------------------------------------------------------
    // Gate 2: Zero-Mock Reasoning Pass & Sasaki Geometric Prior Seeding
    // -------------------------------------------------------------------------
    printf("--- Gate 2: Zero-Mock Reasoning Pass & Geometric Prior Seeding ---\n");
    g_active_dom_stream = -1.0;
    g_active_dom_w = -1.0;
    geomind_chat_set_show_thinking(0.0);

    let r_pass1 = geomind_chat_generate_reasoning_pass("Explain Riemann curvature tensor in general relativity", 0.7);
    all_pass = all_pass * test_assert(r_pass1 == 1.0, "Reasoning pass executes cleanly with thinking hidden");
    all_pass = all_pass * test_assert(g_active_dom_stream >= 0.0 && g_active_dom_stream < 8.0, "Sasaki dominant stream prior seeded genuinely into global state");
    all_pass = all_pass * test_assert(g_active_dom_w > 0.0, "Sasaki stream routing weight > 0.0");

    geomind_chat_set_show_thinking(1.0);
    let r_pass2 = geomind_chat_generate_reasoning_pass("What is the speed of light in vacuum?", 0.7);
    all_pass = all_pass * test_assert(r_pass2 == 1.0, "Reasoning pass executes cleanly with structured box thinking visible");
    geomind_chat_set_show_thinking(0.0);
    printf("\n");

    // -------------------------------------------------------------------------
    // Gate 3: Sanitization of Output Buffering (Protocol Tag Stripping)
    // -------------------------------------------------------------------------
    printf("--- Gate 3: Output Buffering Sanitization ---\n");
    let test_raw = "<think>Analyzing query...</think>I have analyzed your request.<tool_call:browse_web url=\"https://cartan-lang.org\"/>Here is the resulting data.<tool_response tool=\"browse_web\" status=\"ok\">\nCartan Language Home Page\n</tool_response>Have a wonderful day!<end_of_turn>";
    let sanitized = geomind_sanitize_output_for_display(test_raw);

    all_pass = all_pass * test_assert(cartan_string_contains(sanitized, "I have analyzed your request.") == 1.0, "Preserves conversational prefix");
    all_pass = all_pass * test_assert(cartan_string_contains(sanitized, "Here is the resulting data.") == 1.0, "Preserves conversational mid-text");
    all_pass = all_pass * test_assert(cartan_string_contains(sanitized, "Have a wonderful day!") == 1.0, "Preserves conversational conclusion");
    all_pass = all_pass * test_assert(cartan_string_contains(sanitized, "<tool_call:") == 0.0, "Strips <tool_call:...> tag");
    all_pass = all_pass * test_assert(cartan_string_contains(sanitized, "<tool_response") == 0.0, "Strips <tool_response...> tag");
    all_pass = all_pass * test_assert(cartan_string_contains(sanitized, "<think>") == 0.0, "Strips <think> tag");
    all_pass = all_pass * test_assert(cartan_string_contains(sanitized, "<end_of_turn>") == 0.0, "Strips <end_of_turn> marker");
    free(sanitized);
    printf("\n");

    // -------------------------------------------------------------------------
    // Gate 4: High-Frequency CRT _kbhit() Non-Blocking Polling Benchmark
    // -------------------------------------------------------------------------
    printf("--- Gate 4: High-Frequency CRT _kbhit() Non-Blocking Polling Benchmark ---\n");
    let t_start = clock();
    var poll_cnt = 0.0;
    while (poll_cnt < 10000.0) {
        let hit = _kbhit();
        poll_cnt = poll_cnt + 1.0;
    }
    let t_end = clock();
    let dt = t_end - t_start;
    printf("  10,000 _kbhit() non-blocking polling calls executed in %s ms (avg %s us/call)\n",
           cartan_float_to_string(dt), cartan_float_to_string((dt * 1000.0) / 10000.0));
    all_pass = all_pass * test_assert(dt < 500.0, "10k _kbhit() calls latency < 500 ms (< 50 us/call, zero decode jitter)");
    printf("\n");

    // -------------------------------------------------------------------------
    // Gate 5: Interrupt State Mechanics
    // -------------------------------------------------------------------------
    printf("--- Gate 5: Interrupt State Mechanics ---\n");
    geomind_chat_set_interrupted(1.0);
    all_pass = all_pass * test_assert(geomind_chat_get_interrupted() == 1.0, "g_chat_interrupted correctly set to 1.0");
    geomind_chat_set_interrupted(0.0);
    all_pass = all_pass * test_assert(geomind_chat_get_interrupted() == 0.0, "g_chat_interrupted successfully cleared to 0.0");
    printf("\n");

    printf("================================================================================\n");
    if (all_pass == 1.0) {
        printf("  ALL 5 GATES PASSED EMPIRICALLY WITH ZERO REGRESSIONS.\n");
        printf("================================================================================\n\n");
        return 0.0;
    } else {
        printf("  VERIFICATION FAILED.\n");
        printf("================================================================================\n\n");
        return 1.0;
    }
}
