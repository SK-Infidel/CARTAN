// test/compiler_suite/test_hybrid_resonant_transformer.car
// Target [64/64]: Verification of Hybrid Resonant Transformer Cognitive Architecture
// Causal Transformer Decoder Layer (RMSNorm, RoPE, GQA Attention, SwiGLU) coupled with Continuous Hopfield Resonator

include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/math.cl";
include "src/std/transformer.cl";
include "src/std/hybrid_resonator.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main() -> float {
    printf("=================================================================================\n");
    printf("  CARTAN TEST SUITE: HYBRID RESONANT TRANSFORMER ARCHITECTURE (TARGET 64)\n");
    printf("  Causal Transformer Decoder + Continuous Hopfield Resonator + E8 Manifold\n");
    printf("=================================================================================\n\n");

    // -------------------------------------------------------------------------
    // Gate 1: Root Mean Square Layer Normalization (RMSNorm) Precision
    // -------------------------------------------------------------------------
    printf("[1/4] Verifying Root Mean Square Layer Normalization (RMSNorm)...\n");
    let test_dim = 16.0;
    let x_vec = cartan_vec_create();
    let w_vec = cartan_vec_create();
    var i = 0.0;
    while (i < test_dim) {
        cartan_vec_push_f32(x_vec, (i + 1.0) * 0.5);
        cartan_vec_push_f32(w_vec, 1.0);
        i = i + 1.0;
    }
    let normed = cartan_rmsnorm(x_vec, w_vec, test_dim, 0.000001);
    cartan_assert(normed != 0.0, "RMSNorm output must not be null");
    
    // Compute root mean square of normalized vector: sqrt(mean(y_i^2)) ~ 1.0
    var sum_sq = 0.0;
    i = 0.0;
    while (i < test_dim) {
        let yi = cartan_vec_get_f32(normed, i);
        sum_sq = sum_sq + yi * yi;
        i = i + 1.0;
    }
    let rms_val = sqrt(sum_sq / test_dim);
    printf("  -> Input Vector Dim: %s | Post-RMSNorm Root Mean Square: %s\n",
        cartan_float_to_string(test_dim), cartan_float_to_string(rms_val));
    cartan_assert(rms_val > 0.999 && rms_val < 1.001, "Normalized vector RMS must equal 1.0 within epsilon");
    cartan_vec_free(x_vec);
    cartan_vec_free(w_vec);
    cartan_vec_free(normed);
    printf("  -> [PASS] Gate 1: Authentic RMSNorm mathematically validated.\n\n");

    // -------------------------------------------------------------------------
    // Gate 2: Rotary Position Embedding (RoPE) Rotational Invariance
    // -------------------------------------------------------------------------
    printf("[2/4] Verifying Rotary Position Embedding (RoPE) & Energy Conservation...\n");
    let rope_vec = cartan_vec_create();
    let head_dim = 8.0;
    i = 0.0;
    while (i < head_dim) {
        cartan_vec_push_f32(rope_vec, (i + 1.0) * 0.75);
        i = i + 1.0;
    }

    // At pos = 0, RoPE must be identity
    let rope_pos0 = cartan_rope_apply(rope_vec, 0.0, head_dim, 10000.0);
    var diff_pos0 = 0.0;
    i = 0.0;
    while (i < head_dim) {
        let v0 = cartan_vec_get_f32(rope_vec, i);
        let vr = cartan_vec_get_f32(rope_pos0, i);
        diff_pos0 = diff_pos0 + math_abs_val(v0 - vr);
        i = i + 1.0;
    }
    cartan_assert(diff_pos0 < 0.0001, "RoPE at pos=0 must be exact identity transformation");
    cartan_vec_free(rope_pos0);

    // At pos = 5.0, energy norm must be conserved for split-half pairs: x_0^2 + x_half^2 = x'_0^2 + x'_half^2
    let half = head_dim / 2.0;
    let rope_pos5 = cartan_rope_apply(rope_vec, 5.0, head_dim, 10000.0);
    let orig_energy = cartan_vec_get_f32(rope_vec, 0.0) * cartan_vec_get_f32(rope_vec, 0.0) +
                      cartan_vec_get_f32(rope_vec, half) * cartan_vec_get_f32(rope_vec, half);
    let rot_energy = cartan_vec_get_f32(rope_pos5, 0.0) * cartan_vec_get_f32(rope_pos5, 0.0) +
                     cartan_vec_get_f32(rope_pos5, half) * cartan_vec_get_f32(rope_pos5, half);
    printf("  -> RoPE Pair (x0, x_half) Energy Before: %s | Energy After Rotation: %s\n",
        cartan_float_to_string(orig_energy), cartan_float_to_string(rot_energy));
    cartan_assert(math_abs_val(orig_energy - rot_energy) < 0.0001, "RoPE rotation must preserve pair L2 norm exactly");
    cartan_vec_free(rope_vec);
    cartan_vec_free(rope_pos5);
    printf("  -> [PASS] Gate 2: RoPE identity & norm conservation validated.\n\n");

    // -------------------------------------------------------------------------
    // Gate 3: SwiGLU MLP Forward Projection & Non-Linear Gating
    // -------------------------------------------------------------------------
    printf("[3/4] Verifying SwiGLU Feedforward Expansion & Gating...\n");
    let in_dim = 16.0;
    let inter_dim = 32.0;
    let mlp_x = cartan_vec_create();
    let gate_w = cartan_vec_create();
    let up_w = cartan_vec_create();
    let down_w = cartan_vec_create();
    i = 0.0;
    while (i < in_dim) {
        cartan_vec_push_f32(mlp_x, 0.5);
        i = i + 1.0;
    }
    i = 0.0;
    let total_up = inter_dim * in_dim;
    while (i < total_up) {
        cartan_vec_push_f32(gate_w, 0.05);
        cartan_vec_push_f32(up_w, 0.05);
        i = i + 1.0;
    }
    i = 0.0;
    let total_down = in_dim * inter_dim;
    while (i < total_down) {
        cartan_vec_push_f32(down_w, 0.02);
        i = i + 1.0;
    }
    let ffn_res = cartan_swiglu_mlp_forward(mlp_x, gate_w, up_w, down_w, in_dim, inter_dim);
    cartan_assert(cartan_vec_len(ffn_res) == in_dim, "SwiGLU output dimension must match in_dim");
    let ffn_val0 = cartan_vec_get_f32(ffn_res, 0.0);
    printf("  -> SwiGLU MLP Output Vector Dim: %s | Output Sample [0]: %s\n",
        cartan_float_to_string(cartan_vec_len(ffn_res)), cartan_float_to_string(ffn_val0));
    cartan_assert(ffn_val0 > 0.0, "SwiGLU activation output must be positive for positive inputs");
    cartan_vec_free(mlp_x);
    cartan_vec_free(gate_w);
    cartan_vec_free(up_w);
    cartan_vec_free(down_w);
    cartan_vec_free(ffn_res);
    printf("  -> [PASS] Gate 3: SwiGLU feedforward expansion mathematically verified.\n\n");

    // -------------------------------------------------------------------------
    // Gate 4: End-to-End Dual-Process Hybrid Resonant Forward Step
    // -------------------------------------------------------------------------
    printf("[4/4] Verifying Dual-Process Hybrid Resonant Transformer Forward Step...\n");
    let h_dim = 32.0;
    let h_inter = 64.0;
    let q_heads = 4.0;
    let kv_heads = 2.0;
    let h_head_dim = 8.0;
    let vocab_sz = 16.0;

    let h_input = cartan_vec_create();
    i = 0.0;
    while (i < h_dim) {
        cartan_vec_push_f32(h_input, 0.25);
        i = i + 1.0;
    }

    let k_cache = cartan_vec_create();
    let v_cache = cartan_vec_create();
    let seq_l = 2.0;
    i = 0.0;
    let total_kv = seq_l * kv_heads * h_head_dim;
    while (i < total_kv) {
        cartan_vec_push_f32(k_cache, 0.1);
        cartan_vec_push_f32(v_cache, 0.2);
        i = i + 1.0;
    }

    let cortical_matrix = cartan_vec_create();
    i = 0.0;
    let total_cort = h_dim * vocab_sz;
    while (i < total_cort) {
        let val_c = (math_mod_val(i * 37.0 + 19.0, 100.0) / 100.0 - 0.5) * 1.0;
        cartan_vec_push_f32(cortical_matrix, val_c);
        i = i + 1.0;
    }

    let w_q = cartan_vec_create();
    i = 0.0;
    while (i < 1024.0) {
        let val_q = (math_mod_val(i * 17.0 + 3.0, 100.0) / 100.0 - 0.5) * 0.1;
        cartan_vec_push_f32(w_q, val_q);
        i = i + 1.0;
    }

    let w_o = cartan_vec_create();
    i = 0.0;
    while (i < 1024.0) {
        let val_o = (math_mod_val(i * 19.0 + 7.0, 100.0) / 100.0 - 0.5) * 0.1;
        cartan_vec_push_f32(w_o, val_o);
        i = i + 1.0;
    }

    let norm_attn_w = cartan_vec_create();
    let norm_ffn_w = cartan_vec_create();
    i = 0.0;
    while (i < h_dim) {
        cartan_vec_push_f32(norm_attn_w, 1.0);
        cartan_vec_push_f32(norm_ffn_w, 1.0);
        i = i + 1.0;
    }

    let gate_w = cartan_vec_create();
    let up_w = cartan_vec_create();
    i = 0.0;
    while (i < 2048.0) {
        let val_g = (math_mod_val(i * 23.0 + 11.0, 100.0) / 100.0 - 0.5) * 0.1;
        let val_u = (math_mod_val(i * 29.0 + 13.0, 100.0) / 100.0 - 0.5) * 0.1;
        cartan_vec_push_f32(gate_w, val_g);
        cartan_vec_push_f32(up_w, val_u);
        i = i + 1.0;
    }

    let down_w = cartan_vec_create();
    i = 0.0;
    while (i < 2048.0) {
        let val_d = (math_mod_val(i * 31.0 + 17.0, 100.0) / 100.0 - 0.5) * 0.1;
        cartan_vec_push_f32(down_w, val_d);
        i = i + 1.0;
    }

    let hybrid_logits = hybrid_resonator_forward_step(
        h_input,
        w_q, 0.0, 0.0, w_o,
        norm_attn_w, norm_ffn_w,
        gate_w, up_w, down_w,
        1.0, seq_l, h_dim, h_inter,
        q_heads, kv_heads, h_head_dim,
        k_cache, v_cache,
        3.5, 2.0,
        cortical_matrix, vocab_sz
    );

    cartan_assert(hybrid_logits != 0.0, "Hybrid logits must not be null");
    cartan_assert(cartan_vec_len(hybrid_logits) == vocab_sz, "Logits length must match vocab_size");
    
    // Check softcapping bounded strictly within [-30.0, 30.0] and verify non-trivial logit spread
    var max_logit = -100.0;
    var min_logit = 100.0;
    i = 0.0;
    while (i < vocab_sz) {
        let l = cartan_vec_get_f32(hybrid_logits, i);
        if (l > max_logit) { max_logit = l; }
        if (l < min_logit) { min_logit = l; }
        i = i + 1.0;
    }
    let logit_spread = max_logit - min_logit;
    printf("  -> Hybrid Logits Emitted: Vocab Dim %s | Min: %s | Max: %s | Spread: %s\n",
        cartan_float_to_string(vocab_sz), cartan_float_to_string(min_logit), cartan_float_to_string(max_logit), cartan_float_to_string(logit_spread));
    cartan_assert(max_logit <= 30.0 && min_logit >= -30.0, "Logits must strictly obey 30.0 softcapping");
    cartan_assert(logit_spread > 0.50, "Logit spread across vocabulary must exceed 0.5 for non-trivial neural separation");

    cartan_vec_free(h_input);
    cartan_vec_free(k_cache);
    cartan_vec_free(v_cache);
    cartan_vec_free(w_q);
    cartan_vec_free(w_o);
    cartan_vec_free(norm_attn_w);
    cartan_vec_free(norm_ffn_w);
    cartan_vec_free(gate_w);
    cartan_vec_free(up_w);
    cartan_vec_free(down_w);
    cartan_vec_free(cortical_matrix);
    cartan_vec_free(hybrid_logits);
    printf("  -> [PASS] Gate 4: Hybrid Resonant Transformer dual-process step verified cleanly.\n\n");

    printf("=================================================================================\n");
    printf("  ALL 4 GATES PASSED: HYBRID RESONANT TRANSFORMER COGNITIVE ARCHITECTURE VERIFIED!\n");
    printf("=================================================================================\n");
    return 0.0;
}
