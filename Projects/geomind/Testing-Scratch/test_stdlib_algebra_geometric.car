// Projects/geomind/Testing-scratch/test_stdlib_algebra_geometric.car
// // run-pass
// Target 92: CARTAN Standard Library — Pillar 2: Geometric, Clifford, Weyl & Hypercomplex Algebras

include "src/std/constants.ch";
include "src/std/math.cl";
include "src/std/algebra/geometric.cl";

extern fn printf(fmt: string, v: float) -> float;
extern fn puts(s: string) -> float;
extern fn exit(code: float) -> void;
extern fn cartan_flush(v: float) -> float;

fn approx_eq(a: float, b: float, eps: float) -> float {
    if (fabs(a - b) <= eps) { return 1.0; }
    return 0.0;
}

fn assert_true(cond: float, test_name: string) {
    if (cond == 1.0) {
        printf("  [PASS] ");
        puts(test_name);
    } else {
        printf("  [FAIL] ");
        puts(test_name);
        cartan_flush(0.0);
        exit(1.0);
    }
}

fn main() -> float {
    puts("======================================================================");
    puts("  TARGET 92: Geometric, Clifford, Weyl & Hypercomplex Algebra Suite");
    puts("======================================================================");

    // ------------------------------------------------------------------------
    // Gate 1: Generalized Clifford Algebra Cl(p, q, r) Primitives & Products
    // ------------------------------------------------------------------------
    puts("\n[Gate 1: Generalized Clifford Algebra Cl(p, q, r) Primitives & Products]");

    // Euclidean Cl(3, 0, 0)
    let e1 = alg_mv_create(3.0, 0.0, 0.0);
    alg_mv_set_blade(e1, 1.0, 1.0); // e1 is bitmask 1 (2^0)

    let e2 = alg_mv_create(3.0, 0.0, 0.0);
    alg_mv_set_blade(e2, 2.0, 1.0); // e2 is bitmask 2 (2^1)

    // e1^2 = +1
    let e1_sq = alg_mv_mul(e1, e1);
    assert_true(approx_eq(alg_mv_scalar(e1_sq), 1.0, 0.0001) == 1.0, "Euclidean e1^2 == +1.0");

    // e1 * e2 = e12 (mask 3)
    let e12 = alg_mv_mul(e1, e2);
    assert_true(approx_eq(alg_mv_get_blade(e12, 3.0), 1.0, 0.0001) == 1.0, "Geometric product e1 * e2 == e12");

    // e2 * e1 = -e12 (anti-commutation)
    let e21 = alg_mv_mul(e2, e1);
    assert_true(approx_eq(alg_mv_get_blade(e21, 3.0), -1.0, 0.0001) == 1.0, "Anti-commutation e2 * e1 == -e12");

    // Wedge product: e1 ^ e2 = e12, e1 ^ e1 = 0
    let w12 = alg_mv_wedge(e1, e2);
    assert_true(approx_eq(alg_mv_get_blade(w12, 3.0), 1.0, 0.0001) == 1.0, "Wedge product e1 ^ e2 == e12");
    let w11 = alg_mv_wedge(e1, e1);
    assert_true(approx_eq(alg_mv_norm(w11), 0.0, 0.0001) == 1.0, "Wedge nilpotence e1 ^ e1 == 0.0");

    // Left contraction: e1 _| e12 = e2, e2 _| e12 = -e1
    let c1_12 = alg_mv_left_contract(e1, e12);
    assert_true(approx_eq(alg_mv_get_blade(c1_12, 2.0), 1.0, 0.0001) == 1.0, "Left contraction e1 _| e12 == e2");
    let c2_12 = alg_mv_left_contract(e2, e12);
    assert_true(approx_eq(alg_mv_get_blade(c2_12, 1.0), -1.0, 0.0001) == 1.0, "Left contraction e2 _| e12 == -e1");

    // Minkowski Spacetime Cl(1, 3, 0)
    let m0 = alg_mv_create(1.0, 3.0, 0.0);
    alg_mv_set_blade(m0, 1.0, 1.0); // e0 is bitmask 1 (p=1, positive)
    let m0_sq = alg_mv_mul(m0, m0);
    assert_true(approx_eq(alg_mv_scalar(m0_sq), 1.0, 0.0001) == 1.0, "Minkowski timelike e0^2 == +1.0");

    let m1 = alg_mv_create(1.0, 3.0, 0.0);
    alg_mv_set_blade(m1, 2.0, 1.0); // e1 is bitmask 2 (q=3, spacelike/negative)
    let m1_sq = alg_mv_mul(m1, m1);
    assert_true(approx_eq(alg_mv_scalar(m1_sq), -1.0, 0.0001) == 1.0, "Minkowski spacelike e1^2 == -1.0");

    // Projective Degenerate Cl(3, 0, 1)
    let p_null = alg_mv_create(3.0, 0.0, 1.0);
    alg_mv_set_blade(p_null, 8.0, 1.0); // e0 (index 3) is bitmask 8 (r=1, degenerate)
    let p_null_sq = alg_mv_mul(p_null, p_null);
    assert_true(approx_eq(alg_mv_scalar(p_null_sq), 0.0, 0.0001) == 1.0, "Projective null basis e0^2 == 0.0");

    // Grade projection and reversion
    let mixed = alg_mv_create(3.0, 0.0, 0.0);
    alg_mv_set_blade(mixed, 0.0, 3.0); // scalar
    alg_mv_set_blade(mixed, 1.0, 2.0); // vector e1
    alg_mv_set_blade(mixed, 3.0, 5.0); // bivector e12

    let g2 = alg_mv_grade_project(mixed, 2.0);
    assert_true(approx_eq(alg_mv_get_blade(g2, 3.0), 5.0, 0.0001) == 1.0, "Grade-2 projection extracts bivector 5.0");
    assert_true(approx_eq(alg_mv_get_blade(g2, 1.0), 0.0, 0.0001) == 1.0, "Grade-2 projection zeroes vector part");

    let rev = alg_mv_reverse(mixed);
    assert_true(approx_eq(alg_mv_get_blade(rev, 3.0), -5.0, 0.0001) == 1.0, "Reversion flips bivector sign ~e12 == -e12");
    assert_true(approx_eq(alg_mv_get_blade(rev, 1.0), 2.0, 0.0001) == 1.0, "Reversion preserves vector ~e1 == e1");

    // Cleanup Gate 1
    alg_mv_free(e1);
    alg_mv_free(e2);
    alg_mv_free(e1_sq);
    alg_mv_free(e12);
    alg_mv_free(e21);
    alg_mv_free(w12);
    alg_mv_free(w11);
    alg_mv_free(c1_12);
    alg_mv_free(c2_12);
    alg_mv_free(m0);
    alg_mv_free(m0_sq);
    alg_mv_free(m1);
    alg_mv_free(m1_sq);
    alg_mv_free(p_null);
    alg_mv_free(p_null_sq);
    alg_mv_free(mixed);
    alg_mv_free(g2);
    alg_mv_free(rev);

    // ------------------------------------------------------------------------
    // Gate 2: Rotor & Spinor Sandwich Transformations
    // ------------------------------------------------------------------------
    puts("\n[Gate 2: Rotor & Spinor Sandwich Transformations]");

    // 90 degree (pi/2) rotation in xy-plane (e12)
    let pi_val = 3.141592653589793;
    let angle_90 = pi_val * 0.5;
    let rotor = alg_mv_rotor_3d(angle_90, 1.0, 0.0, 0.0);

    // Unimodularity: R ~R = 1.0
    let rev_rotor = alg_mv_reverse(rotor);
    let r_unit = alg_mv_mul(rotor, rev_rotor);
    assert_true(approx_eq(alg_mv_scalar(r_unit), 1.0, 0.0001) == 1.0, "Rotor unimodularity R ~R == 1.0");

    // Vector v = e1 (mask 1)
    let v_x = alg_mv_create(3.0, 0.0, 0.0);
    alg_mv_set_blade(v_x, 1.0, 1.0);

    // Transformed v' = R e1 ~R -> should be e2 (mask 2)
    let v_rot = alg_mv_sandwich(rotor, v_x);
    assert_true(approx_eq(alg_mv_get_blade(v_rot, 2.0), 1.0, 0.0001) == 1.0, "Rotor rotation e1 -> e2 (y component 1.0)");
    assert_true(approx_eq(alg_mv_get_blade(v_rot, 1.0), 0.0, 0.0001) == 1.0, "Rotor rotation e1 -> e2 (x component 0.0)");
    assert_true(approx_eq(alg_mv_norm(v_rot), 1.0, 0.0001) == 1.0, "Rotor norm preservation ||v'|| == 1.0");

    // Orthogonal invariance: v_z = e3 (mask 4) must remain strictly invariant under xy-rotation!
    let v_z = alg_mv_create(3.0, 0.0, 0.0);
    alg_mv_set_blade(v_z, 4.0, 1.0);
    let v_z_rot = alg_mv_sandwich(rotor, v_z);
    assert_true(approx_eq(alg_mv_get_blade(v_z_rot, 4.0), 1.0, 0.0001) == 1.0, "Orthogonal invariance R e3 ~R == e3");
    assert_true(approx_eq(alg_mv_get_blade(v_z_rot, 1.0), 0.0, 0.0001) == 1.0, "Orthogonal invariance x component 0.0");
    assert_true(approx_eq(alg_mv_get_blade(v_z_rot, 2.0), 0.0, 0.0001) == 1.0, "Orthogonal invariance y component 0.0");

    // Cleanup Gate 2
    alg_mv_free(rotor);
    alg_mv_free(rev_rotor);
    alg_mv_free(r_unit);
    alg_mv_free(v_x);
    alg_mv_free(v_rot);
    alg_mv_free(v_z);
    alg_mv_free(v_z_rot);

    // ------------------------------------------------------------------------
    // Gate 3: Cayley-Dickson Hypercomplex Systems & Octonion Associators
    // ------------------------------------------------------------------------
    puts("\n[Gate 3: Cayley-Dickson Hypercomplex Systems & Octonion Associators]");

    // Complex numbers: (3 + 4i) * (1 - 2i) = (3 + 8) + (-6 + 4)i = 11 - 2i
    let z1 = alg_complex_create(3.0, 4.0);
    let z2 = alg_complex_create(1.0, -2.0);
    let z_prod = alg_complex_mul(z1, z2);
    assert_true(approx_eq(z_prod.re, 11.0, 0.0001) == 1.0, "Complex multiplication re == 11.0");
    assert_true(approx_eq(z_prod.im, -2.0, 0.0001) == 1.0, "Complex multiplication im == -2.0");
    assert_true(approx_eq(alg_complex_norm(z1), 5.0, 0.0001) == 1.0, "Complex modulus ||3 + 4i|| == 5.0");

    // Dual numbers: f(x) = x^2 + 3x at x = 2.0 => f(2) = 10.0, f'(2) = 7.0
    let x_dual = alg_dual_var(2.0);
    let x_sq = alg_dual_mul(x_dual, x_dual);
    let x_3 = alg_dual_scale(x_dual, 3.0);
    let f_dual = alg_dual_add(x_sq, x_3);
    assert_true(approx_eq(f_dual.val, 10.0, 0.0001) == 1.0, "Dual number function value f(2) == 10.0");
    assert_true(approx_eq(f_dual.eps, 7.0, 0.0001) == 1.0, "Dual number exact automatic differentiation f'(2) == 7.0");

    // Split-complex numbers: interval (5 + 3j) => 5^2 - 3^2 = 16.0
    let s_split = alg_split_create(5.0, 3.0);
    assert_true(approx_eq(alg_split_interval(s_split), 16.0, 0.0001) == 1.0, "Split-complex hyperbolic interval == 16.0");

    // Quaternions: i * j = k
    let q_i = alg_quat_create(0.0, 1.0, 0.0, 0.0);
    let q_j = alg_quat_create(0.0, 0.0, 1.0, 0.0);
    let q_k = alg_quat_mul(q_i, q_j);
    assert_true(approx_eq(q_k.w, 0.0, 0.0001) == 1.0, "Quaternion i * j scalar w == 0.0");
    assert_true(approx_eq(q_k.z, 1.0, 0.0001) == 1.0, "Quaternion i * j yields k (z == 1.0)");

    // Octonions: Fano plane multiplication and genuine non-zero associator
    let o_e1 = alg_octonion_basis(1.0);
    let o_e2 = alg_octonion_basis(2.0);
    let o_e4 = alg_octonion_basis(4.0);

    // (e1 * e2) * e4 - e1 * (e2 * e4) = e7 - (-e7) = 2 e7
    let assoc = alg_octonion_associator(o_e1, o_e2, o_e4);
    assert_true(approx_eq(assoc.e7, 2.0, 0.0001) == 1.0, "Octonion non-zero associator [e1, e2, e4] yields 2 e7");
    assert_true(approx_eq(assoc.e0, 0.0, 0.0001) == 1.0, "Octonion associator scalar component == 0.0");

    // Alternativity: [a, a, b] = 0 identically for any octonion!
    let assoc_alt = alg_octonion_associator(o_e1, o_e1, o_e2);
    assert_true(approx_eq(alg_octonion_norm(assoc_alt), 0.0, 0.0001) == 1.0, "Octonion alternativity [e1, e1, e2] == 0.0");

    // ------------------------------------------------------------------------
    // Gate 4: Weyl Algebra Canonical Commutation Relations & Differential Action
    // ------------------------------------------------------------------------
    puts("\n[Gate 4: Weyl Algebra CCR & Differential Operator Action]");

    let op_x = alg_weyl_pos(8.0);
    let op_d = alg_weyl_der(8.0);

    // Canonical Commutation Relation: [d, x] = d * x - x * d = 1.0
    let ccr = alg_weyl_commutator(op_d, op_x);
    assert_true(approx_eq(alg_weyl_get(ccr, 0.0, 0.0), 1.0, 0.0001) == 1.0, "Weyl CCR [d, x] identity scalar == 1.0");
    assert_true(approx_eq(alg_weyl_get(ccr, 1.0, 1.0), 0.0, 0.0001) == 1.0, "Weyl CCR off-diagonal x*d term == 0.0");

    // Product of d and x^2: d * x^2 = x^2 * d + 2x
    let op_x2 = alg_weyl_create(8.0);
    alg_weyl_set(op_x2, 2.0, 0.0, 1.0); // x^2 * d^0

    let d_x2 = alg_weyl_mul(op_d, op_x2);
    assert_true(approx_eq(alg_weyl_get(d_x2, 2.0, 1.0), 1.0, 0.0001) == 1.0, "Leibniz product d * x^2 has x^2 * d == 1.0");
    assert_true(approx_eq(alg_weyl_get(d_x2, 1.0, 0.0), 2.0, 0.0001) == 1.0, "Leibniz product d * x^2 has 2x == 2.0");

    // Higher order Leibniz product: d^2 * x^2 = x^2 * d^2 + 4 * x * d + 2
    let op_d2 = alg_weyl_create(8.0);
    alg_weyl_set(op_d2, 0.0, 2.0, 1.0); // x^0 * d^2

    let d2_x2 = alg_weyl_mul(op_d2, op_x2);
    assert_true(approx_eq(alg_weyl_get(d2_x2, 2.0, 2.0), 1.0, 0.0001) == 1.0, "Higher-order d^2 * x^2 has x^2 * d^2 == 1.0");
    assert_true(approx_eq(alg_weyl_get(d2_x2, 1.0, 1.0), 4.0, 0.0001) == 1.0, "Higher-order d^2 * x^2 has 4 * x * d == 4.0");
    assert_true(approx_eq(alg_weyl_get(d2_x2, 0.0, 0.0), 2.0, 0.0001) == 1.0, "Higher-order d^2 * x^2 constant == 2.0");

    // Differential action on polynomial state: D(x^3) = 3 * x^2
    let poly_in = calloc(4.0, 8.0);
    poly_in[3] = 1.0; // f(x) = 1.0 * x^3

    let poly_out = alg_weyl_apply_poly(op_d, poly_in, 3.0, 3.0);
    assert_true(approx_eq(poly_out[2], 3.0, 0.0001) == 1.0, "Differential action d(x^3) coeff of x^2 == 3.0");
    assert_true(approx_eq(poly_out[3], 0.0, 0.0001) == 1.0, "Differential action d(x^3) coeff of x^3 == 0.0");
    assert_true(approx_eq(poly_out[1], 0.0, 0.0001) == 1.0, "Differential action d(x^3) coeff of x^1 == 0.0");

    // Quantum Harmonic Oscillator: a = (x + d)/sqrt(2), a^dag = (x - d)/sqrt(2)
    // [a, a^dag] = 1.0
    let inv_sqrt2 = 1.0 / sqrt(2.0);
    let a_ann = alg_weyl_create(8.0);
    alg_weyl_set(a_ann, 1.0, 0.0, inv_sqrt2); // +x / sqrt(2)
    alg_weyl_set(a_ann, 0.0, 1.0, inv_sqrt2); // +d / sqrt(2)

    let a_dag = alg_weyl_create(8.0);
    alg_weyl_set(a_dag, 1.0, 0.0, inv_sqrt2);  // +x / sqrt(2)
    alg_weyl_set(a_dag, 0.0, 1.0, -inv_sqrt2); // -d / sqrt(2)

    let qho_comm = alg_weyl_commutator(a_ann, a_dag);
    assert_true(approx_eq(alg_weyl_get(qho_comm, 0.0, 0.0), 1.0, 0.0001) == 1.0, "Harmonic oscillator commutator [a, a^dag] == 1.0");

    // Cleanup Gate 4
    alg_weyl_free(op_x);
    alg_weyl_free(op_d);
    alg_weyl_free(ccr);
    alg_weyl_free(op_x2);
    alg_weyl_free(d_x2);
    alg_weyl_free(op_d2);
    alg_weyl_free(d2_x2);
    free(poly_in);
    free(poly_out);
    alg_weyl_free(a_ann);
    alg_weyl_free(a_dag);
    alg_weyl_free(qho_comm);

    puts("======================================================================");
    puts("  TARGET 92 RESULT: ALL ASSERTIONS PASSED (100% SUCCESS)");
    puts("======================================================================");
    return 0.0;
}
