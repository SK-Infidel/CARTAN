// test/compiler_suite/test_inductive_biases.car
// CARTAN Regression Target [49/49]: Untrained Network Inductive Biases (WANN, DIP, ELM, ESN) Pass
// // run-pass

include "../../src/std/wann.car";
include "../../src/std/dip.car";
include "../../src/std/elm.car";
include "../../src/std/esn.car";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn fabs(x: float) -> float;
extern fn printf(format: string) -> float;
extern fn cartan_float_to_string(f: float) -> string;

fn main(argc: float, argv: ptr) -> float {
    // -------------------------------------------------------------
    // 1. Weight-Agnostic Neural Networks (WANN) Verification
    // -------------------------------------------------------------
    let wann = wann_create_network(2.0, 1.0);
    cartan_assert(wann != 0.0, "wann_create_network failed");

    // Add direct connections: in0 -> out0, in1 -> out0
    wann_mutate_add_connection(wann, 0.0, 2.0);
    wann_mutate_add_connection(wann, 1.0, 2.0);

    // Mutate to add hidden node splitting edge 0 (in0 -> out0)
    let hidden_id = wann_mutate_add_node(wann, 0.0, 1.0);
    cartan_assert(hidden_id == 3.0, "wann_mutate_add_node ID mismatch");

    // Direct connection path (in1 -> out0): odd degree (w^1) reverses with sign of w
    let inputs = cartan_vec_create();
    cartan_vec_push_f32(inputs, 0.0);
    cartan_vec_push_f32(inputs, 0.8);

    // Evaluate with positive shared weight
    let out_pos = wann_evaluate_shared_weight(wann, inputs, 1.2);
    let val_pos = cartan_vec_get_f32(out_pos, 0.0);
    printf("WANN VAL_POS: %s\n", cartan_float_to_string(val_pos));
    cartan_assert(cartan_vec_len(out_pos) == 1.0, "wann outputs length check");
    cartan_assert(val_pos > 0.0, "wann positive shared weight activation");

    // Evaluate with negative shared weight
    let out_neg = wann_evaluate_shared_weight(wann, inputs, -1.2);
    let val_neg = cartan_vec_get_f32(out_neg, 0.0);
    printf("WANN VAL_NEG: %s\n", cartan_float_to_string(val_neg));
    cartan_assert(val_neg < 0.0, "wann negative shared weight activation");

    // -------------------------------------------------------------
    // 2. Deep Image Prior (DIP) Optimization Verification
    // -------------------------------------------------------------
    let dip = dip_create_prior_network(2.0, 6.0);
    cartan_assert(dip != 0.0, "dip_create_prior_network failed");

    let corrupted = cartan_vec_create();
    var i = 0.0;
    while (i < 16.0) {
        let clean = sin(6.2831853 * (i / 16.0));
        // Alternating high-frequency noise spike
        var noise = 0.25;
        if (i == 1.0 || i == 3.0 || i == 5.0 || i == 7.0 || i == 9.0 || i == 11.0 || i == 13.0 || i == 15.0) {
            noise = -0.25;
        }
        cartan_vec_push_f32(corrupted, clean + noise);
        i = i + 1.0;
    }

    let reconstructed = dip_reconstruct_signal(dip, corrupted, 15.0);
    cartan_assert(cartan_vec_len(reconstructed) == 16.0, "dip reconstructed len 16");

    // Check peak region (i=4) and valley region (i=12) retain correct polarity
    let peak_val = cartan_vec_get_f32(reconstructed, 4.0);
    let valley_val = cartan_vec_get_f32(reconstructed, 12.0);
    cartan_assert(peak_val > valley_val, "dip reconstructed spectral shape monotonicity");

    // -------------------------------------------------------------
    // 3. Extreme Learning Machine (ELM) Pseudo-Inverse Verification
    // -------------------------------------------------------------
    let elm = elm_create(1.0, 6.0, 1.0);
    cartan_assert(elm != 0.0, "elm_create failed");

    let elm_x = cartan_vec_create();
    cartan_vec_push_f32(elm_x, -1.0);
    cartan_vec_push_f32(elm_x, -0.5);
    cartan_vec_push_f32(elm_x, 0.0);
    cartan_vec_push_f32(elm_x, 0.5);
    cartan_vec_push_f32(elm_x, 1.0);

    let elm_y = cartan_vec_create();
    cartan_vec_push_f32(elm_y, -0.8);
    cartan_vec_push_f32(elm_y, -0.4);
    cartan_vec_push_f32(elm_y, 0.0);
    cartan_vec_push_f32(elm_y, 0.4);
    cartan_vec_push_f32(elm_y, 0.8);

    let beta = elm_fit_zero_shot(elm, elm_x, elm_y, 0.01);
    cartan_assert(cartan_vec_len(beta) == 6.0, "elm beta readout dimension");

    let preds = elm_predict(elm, beta, elm_x);
    cartan_assert(cartan_vec_len(preds) == 5.0, "elm predictions count");

    let p_neg = cartan_vec_get_f32(preds, 0.0);
    let p_mid = cartan_vec_get_f32(preds, 2.0);
    let p_pos = cartan_vec_get_f32(preds, 4.0);
    cartan_assert(p_pos > p_neg, "elm monotonicity check");
    cartan_assert(fabs(p_mid) < 0.25, "elm zero origin fit check");

    // -------------------------------------------------------------
    // 4. Echo State Network (ESN) Reservoir Dynamics Verification
    // -------------------------------------------------------------
    let esn = esn_create_reservoir(1.0, 8.0, 0.90);
    cartan_assert(esn != 0.0, "esn_create_reservoir failed");

    let u_pulse = cartan_vec_create();
    cartan_vec_push_f32(u_pulse, 1.0);

    let u_zero = cartan_vec_create();
    cartan_vec_push_f32(u_zero, 0.0);

    // Excite reservoir
    let state_t1 = esn_step_forward(esn, u_pulse);
    cartan_assert(cartan_vec_len(state_t1) == 8.0, "esn state size 8");

    var state_norm1 = 0.0;
    i = 0.0;
    while (i < 8.0) {
        let v = cartan_vec_get_f32(state_t1, i);
        state_norm1 = state_norm1 + fabs(v);
        i = i + 1.0;
    }
    cartan_assert(state_norm1 > 0.01, "esn reservoir excited by pulse");

    // Let reservoir relax with zero input
    let state_t2 = esn_step_forward(esn, u_zero);
    var state_norm2 = 0.0;
    i = 0.0;
    while (i < 8.0) {
        let v = cartan_vec_get_f32(state_t2, i);
        state_norm2 = state_norm2 + fabs(v);
        i = i + 1.0;
    }
    // Echo state fading memory property
    cartan_assert(state_norm2 > 0.0001, "esn fading memory nonzero state");

    // Ridge readout solve
    let dummy_target = cartan_vec_create();
    cartan_vec_push_f32(dummy_target, 0.5);
    let readout_w = esn_solve_readout_ridge(state_t1, dummy_target, 0.05);
    cartan_assert(cartan_vec_len(readout_w) == 8.0, "esn readout weights dimension");

    printf("TEST_INDUCTIVE_BIASES_SUCCESS\n");
    return 0.0;
}
