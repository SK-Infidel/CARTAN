// test/compiler_suite/test_std_abstraction.car
// CARTAN Regression Target [14/14]: Standard Library C-FFI Abstraction Pass
// // run-pass

include "../../src/std/fs.car";
include "../../src/std/io.car";
include "../../src/std/math.car";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    // 1. Test std::math abstractions
    let abs_val = math::abs(-15.5);
    cartan_assert(abs_val == 15.5, "math::abs validation failed");

    let sqrt_val = math::sqrt(16.0);
    cartan_assert(sqrt_val == 4.0, "math::sqrt validation failed");

    let pow_val = math::pow(2.0, 3.0);
    cartan_assert(pow_val == 8.0, "math::pow validation failed");

    // 2. Test std::fs abstractions
    let test_file = "test_std_scratch.tmp";
    fs::write_all(test_file, "CARTAN stdlib abstraction verified!");
    cartan_assert(fs::exists(test_file) != 0.0, "fs::exists validation failed");

    let content = fs::read_all(test_file);
    cartan_assert(cartan_string_length(content) > 0.0, "fs::read_all validation failed");

    // 3. Test std::io abstractions
    io::println(" -> Standard Library C-FFI Abstractions Verified Successfully!");
    return 0.0;
}
