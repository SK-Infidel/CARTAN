// test/compiler_suite/test_optimizer.car
// // run-pass
// Sprint 15 Test Target: Compiler Optimizer & Constant Folding Verification

include "../../src/cartanc/ast.ch";

extern fn printf(fmt: string, v: float) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;

fn main() -> float {
    let x = 42.0;
    
    // Constant folding identity tests
    let add_zero = x + 0.0;
    cartan_assert(add_zero == 42.0, "x + 0.0 must fold to x!");

    let mul_one = x * 1.0;
    cartan_assert(mul_one == 42.0, "x * 1.0 must fold to x!");

    let mul_zero = x * 0.0;
    cartan_assert(mul_zero == 0.0, "x * 0.0 must fold to 0.0!");

    let div_one = x / 1.0;
    cartan_assert(div_one == 42.0, "x / 1.0 must fold to x!");

    let sub_zero = x - 0.0;
    cartan_assert(sub_zero == 42.0, "x - 0.0 must fold to x!");

    printf("Sprint 15 AST Constant Folding & Optimizer Pass verified cleanly!\n", 0.0);
    cartan_flush(0.0);
    return 0.0;
}
