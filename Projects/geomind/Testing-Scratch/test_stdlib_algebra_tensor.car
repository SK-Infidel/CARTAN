// Projects/geomind/Testing-scratch/test_stdlib_algebra_tensor.car
// // run-pass
// Target 91: CARTAN Standard Library — Pillar 1: Multilinear Tensor Algebra & Matrix Factorizations

include "src/std/constants.ch";
include "src/std/math.cl";
include "src/std/algebra/tensor.cl";

extern fn printf(fmt: string, v: float) -> float;
extern fn puts(s: string) -> float;
extern fn exit(code: float) -> void;
extern fn cartan_flush(v: float) -> float;

fn approx_eq(a: float, b: float, eps: float) -> float {
    if (fabs(a - b) <= eps) { return 1.0; }
    return 0.0;
}

fn assert_true(cond: float, test_name: string) {
    if (cond == 1.0) {
        printf("  [PASS] ");
        puts(test_name);
    } else {
        printf("  [FAIL] ");
        puts(test_name);
        cartan_flush(0.0);
        exit(1.0);
    }
}

fn main() -> float {
    puts("======================================================================");
    puts("  TARGET 91: Pure-CARTAN Multilinear Tensor Algebra & Matrix Suite");
    puts("======================================================================");

    // ------------------------------------------------------------------------
    // Gate 1: N-Dimensional Tensor Core Operations
    // ------------------------------------------------------------------------
    puts("\n[Gate 1: N-Dimensional Tensor Core Operations]");

    let sh3 = calloc(3.0, 8.0);
    sh3[0] = 2.0;
    sh3[1] = 3.0;
    sh3[2] = 4.0;

    let t3 = alg_tensor_create(sh3, 3.0);
    assert_true(t3.ndim == 3.0, "Tensor rank is 3.0");
    assert_true(t3.total_elements == 24.0, "Total elements == 24.0 (2 x 3 x 4)");
    assert_true(t3.strides[2] == 1.0, "Stride 2 == 1.0");
    assert_true(t3.strides[1] == 4.0, "Stride 1 == 4.0");
    assert_true(t3.strides[0] == 12.0, "Stride 0 == 12.0");

    let idx3 = calloc(3.0, 8.0);
    idx3[0] = 1.0;
    idx3[1] = 2.0;
    idx3[2] = 3.0; // Offset = 1 * 12 + 2 * 4 + 3 * 1 = 23
    alg_tensor_set(t3, idx3, 42.0);
    let val_get = alg_tensor_get(t3, idx3);
    assert_true(val_get == 42.0, "alg_tensor_get retrieved set value 42.0");

    // Clone verification
    let t3_clone = alg_tensor_clone(t3);
    let clone_val = alg_tensor_get(t3_clone, idx3);
    assert_true(clone_val == 42.0, "alg_tensor_clone preserved element value");
    alg_tensor_set(t3_clone, idx3, 99.0);
    assert_true(alg_tensor_get(t3, idx3) == 42.0, "Original tensor preserved after clone mutation");

    // Reshape verification (2x3x4 -> 4x6)
    let sh_resh = calloc(2.0, 8.0);
    sh_resh[0] = 4.0;
    sh_resh[1] = 6.0;
    let t_resh = alg_tensor_reshape(t3, sh_resh, 2.0);
    assert_true(t_resh.ndim == 2.0, "Reshaped rank == 2.0");
    let idx_resh = calloc(2.0, 8.0);
    idx_resh[0] = 3.0;
    idx_resh[1] = 5.0; // Offset = 3 * 6 + 5 = 23
    assert_true(alg_tensor_get(t_resh, idx_resh) == 42.0, "Reshaped tensor preserved linear data mapping");

    // Slice verification: slice axis 1 from 1 to 3 -> shape (2, 2, 4)
    let t_slice = alg_tensor_slice(t3, 1.0, 1.0, 3.0);
    assert_true(t_slice.shape[1] == 2.0, "Sliced dimension length == 2.0");
    assert_true(t_slice.total_elements == 16.0, "Sliced volume == 16.0");

    let idx_sl = calloc(3.0, 8.0);
    idx_sl[0] = 1.0;
    idx_sl[1] = 1.0; // Original index was 2.0 (1.0 + start 1.0)
    idx_sl[2] = 3.0;
    assert_true(alg_tensor_get(t_slice, idx_sl) == 42.0, "Sliced sub-tensor retrieved correct source element");

    // Cleanup Gate 1
    free(sh3);
    free(idx3);
    free(sh_resh);
    free(idx_resh);
    free(idx_sl);
    alg_tensor_free(t3);
    alg_tensor_free(t3_clone);
    alg_tensor_free(t_resh);
    alg_tensor_free(t_slice);

    // ------------------------------------------------------------------------
    // Gate 2: Multilinear Contraction & Einsum
    // ------------------------------------------------------------------------
    puts("\n[Gate 2: Multilinear Contraction & Einsum]");

    // Outer Product: Vector A (dim 3) ⊗ Vector B (dim 2) -> (3, 2)
    let sh_a = calloc(1.0, 8.0);
    sh_a[0] = 3.0;
    let vec_A = alg_tensor_create(sh_a, 1.0);
    vec_A.data[0] = 1.0;
    vec_A.data[1] = 2.0;
    vec_A.data[2] = 3.0;

    let sh_b = calloc(1.0, 8.0);
    sh_b[0] = 2.0;
    let vec_B = alg_tensor_create(sh_b, 1.0);
    vec_B.data[0] = 10.0;
    vec_B.data[1] = 20.0;

    let tensor_outer = alg_tensor_outer_product(vec_A, vec_B);
    assert_true(tensor_outer.ndim == 2.0, "Outer product rank == 2.0");
    assert_true(tensor_outer.shape[0] == 3.0 && tensor_outer.shape[1] == 2.0, "Outer product shape == (3, 2)");
    // A[1] * B[1] = 2.0 * 20.0 = 40.0 at index (1, 1) -> offset 1 * 2 + 1 = 3
    assert_true(tensor_outer.data[3] == 40.0, "Outer product element A[1]*B[1] == 40.0");

    // Trace Contraction of 2D Tensor (3 x 3)
    let sh_mat3 = calloc(2.0, 8.0);
    sh_mat3[0] = 3.0;
    sh_mat3[1] = 3.0;
    let t_mat3 = alg_tensor_create(sh_mat3, 2.0);
    // Diagonals: 2.0, 7.0, 11.0 -> Sum = 20.0
    t_mat3.data[0 * 3 + 0] = 2.0;
    t_mat3.data[1 * 3 + 1] = 7.0;
    t_mat3.data[2 * 3 + 2] = 11.0;

    let t_trace = alg_tensor_contract(t_mat3, 0.0, 1.0);
    assert_true(t_trace.data[0] == 20.0, "Tensor trace contraction computed 20.0");

    // Einsum Dot: Vector Dot Product via alg_tensor_einsum_dot
    let vec_D = alg_tensor_create(sh_a, 1.0);
    vec_D.data[0] = 4.0;
    vec_D.data[1] = 5.0;
    vec_D.data[2] = 6.0;
    // Dot A · D = 1*4 + 2*5 + 3*6 = 4 + 10 + 18 = 32.0
    let dot_res = alg_tensor_einsum_dot(vec_A, 0.0, vec_D, 0.0);
    assert_true(dot_res.data[0] == 32.0, "Einsum vector dot product computed 32.0");

    // Cleanup Gate 2
    free(sh_a);
    free(sh_b);
    free(sh_mat3);
    alg_tensor_free(vec_A);
    alg_tensor_free(vec_B);
    alg_tensor_free(vec_D);
    alg_tensor_free(tensor_outer);
    alg_tensor_free(t_mat3);
    alg_tensor_free(t_trace);
    alg_tensor_free(dot_res);

    // ------------------------------------------------------------------------
    // Gate 3: Matrix Algebra & Factorizations
    // ------------------------------------------------------------------------
    puts("\n[Gate 3: Matrix Algebra & Factorizations]");

    // Matrix Multiplication (2 x 3) * (3 x 2)
    let mat_A = alg_mat_create(2.0, 3.0);
    mat_A.data[0] = 1.0; mat_A.data[1] = 2.0; mat_A.data[2] = 3.0;
    mat_A.data[3] = 4.0; mat_A.data[4] = 5.0; mat_A.data[5] = 6.0;

    let mat_B = alg_mat_create(3.0, 2.0);
    mat_B.data[0] = 7.0; mat_B.data[1] = 8.0;
    mat_B.data[2] = 9.0; mat_B.data[3] = 1.0;
    mat_B.data[4] = 2.0; mat_B.data[5] = 3.0;

    let mat_C = alg_mat_mul(mat_A, mat_B);
    // C[0, 0] = 1*7 + 2*9 + 3*2 = 7 + 18 + 6 = 31.0
    // C[0, 1] = 1*8 + 2*1 + 3*3 = 8 + 2 + 9 = 19.0
    // C[1, 0] = 4*7 + 5*9 + 6*2 = 28 + 45 + 12 = 85.0
    // C[1, 1] = 4*8 + 5*1 + 6*3 = 32 + 5 + 18 = 55.0
    assert_true(alg_mat_get(mat_C, 0.0, 0.0) == 31.0, "Matmul C[0,0] == 31.0");
    assert_true(alg_mat_get(mat_C, 0.0, 1.0) == 19.0, "Matmul C[0,1] == 19.0");
    assert_true(alg_mat_get(mat_C, 1.0, 0.0) == 85.0, "Matmul C[1,0] == 85.0");
    assert_true(alg_mat_get(mat_C, 1.0, 1.0) == 55.0, "Matmul C[1,1] == 55.0");
    assert_true(alg_mat_trace(mat_C) == 86.0, "Mat trace C == 86.0 (31 + 55)");

    // LU Determinant with Partial Pivoting: A_00 == 0 requires row swap
    let mat_P = alg_mat_create(3.0, 3.0);
    mat_P.data[0] = 0.0; mat_P.data[1] = 2.0; mat_P.data[2] = 1.0;
    mat_P.data[3] = 3.0; mat_P.data[4] = -1.0; mat_P.data[5] = 2.0;
    mat_P.data[6] = 1.0; mat_P.data[7] = 1.0; mat_P.data[8] = 1.0;
    // Det = 0 - 2*(3-2) + 1*(3 - (-1)) = -2 + 4 = 2.0
    let det_val = alg_mat_determinant(mat_P);
    assert_true(approx_eq(det_val, 2.0, 0.0001) == 1.0, "LU Determinant with partial pivoting == 2.0");

    // Gauss-Jordan Inversion: Verify A * A^-1 == I
    let mat_inv = alg_mat_inverse(mat_P);
    let mat_ident = alg_mat_mul(mat_P, mat_inv);
    assert_true(approx_eq(alg_mat_get(mat_ident, 0.0, 0.0), 1.0, 0.0001) == 1.0, "Inverse (A * A^-1)[0,0] == 1.0");
    assert_true(approx_eq(alg_mat_get(mat_ident, 1.0, 1.0), 1.0, 0.0001) == 1.0, "Inverse (A * A^-1)[1,1] == 1.0");
    assert_true(approx_eq(alg_mat_get(mat_ident, 2.0, 2.0), 1.0, 0.0001) == 1.0, "Inverse (A * A^-1)[2,2] == 1.0");
    assert_true(approx_eq(alg_mat_get(mat_ident, 0.0, 1.0), 0.0, 0.0001) == 1.0, "Inverse (A * A^-1)[0,1] == 0.0");

    // Householder QR Factorization: A = Q * R
    let mat_Q = alg_mat_create(3.0, 3.0);
    let mat_R = alg_mat_create(3.0, 3.0);
    alg_mat_qr(mat_P, mat_Q, mat_R);

    // Verify R is upper triangular
    assert_true(approx_eq(alg_mat_get(mat_R, 1.0, 0.0), 0.0, 0.0001) == 1.0, "QR: R[1,0] == 0.0");
    assert_true(approx_eq(alg_mat_get(mat_R, 2.0, 0.0), 0.0, 0.0001) == 1.0, "QR: R[2,0] == 0.0");
    assert_true(approx_eq(alg_mat_get(mat_R, 2.0, 1.0), 0.0, 0.0001) == 1.0, "QR: R[2,1] == 0.0");

    // Verify Q is orthogonal: Q^T * Q == I
    let mat_Qt = alg_mat_transpose(mat_Q);
    let mat_QtQ = alg_mat_mul(mat_Qt, mat_Q);
    assert_true(approx_eq(alg_mat_get(mat_QtQ, 0.0, 0.0), 1.0, 0.0001) == 1.0, "QR: Q^T Q [0,0] == 1.0");
    assert_true(approx_eq(alg_mat_get(mat_QtQ, 1.0, 1.0), 1.0, 0.0001) == 1.0, "QR: Q^T Q [1,1] == 1.0");

    // Verify Q * R == A
    let mat_QR = alg_mat_mul(mat_Q, mat_R);
    assert_true(approx_eq(alg_mat_get(mat_QR, 0.0, 1.0), alg_mat_get(mat_P, 0.0, 1.0), 0.0001) == 1.0, "QR: (Q*R)[0,1] == A[0,1]");
    assert_true(approx_eq(alg_mat_get(mat_QR, 1.0, 0.0), alg_mat_get(mat_P, 1.0, 0.0), 0.0001) == 1.0, "QR: (Q*R)[1,0] == A[1,0]");

    // Jacobi Symmetric Eigensolver: S = [[4, 2], [2, 1]] -> eigenvalues: 5.0, 0.0
    let mat_S = alg_mat_create(2.0, 2.0);
    mat_S.data[0] = 4.0; mat_S.data[1] = 2.0;
    mat_S.data[2] = 2.0; mat_S.data[3] = 1.0;

    let evals2 = calloc(2.0, 8.0);
    let evecs2 = alg_mat_create(2.0, 2.0);
    alg_mat_symmetric_eigenvalues(mat_S, evals2, evecs2);

    let ev_sum = evals2[0] + evals2[1];
    let ev_prod = evals2[0] * evals2[1];
    assert_true(approx_eq(ev_sum, 5.0, 0.0001) == 1.0, "Jacobi eigenvalues sum == 5.0 (trace)");
    assert_true(approx_eq(ev_prod, 0.0, 0.0001) == 1.0, "Jacobi eigenvalues product == 0.0 (det)");

    // Matrix Exponential exp(K) for SO(2) 90-degree rotation: [[0, -pi/2], [pi/2, 0]] -> [[0, -1], [1, 0]]
    let mat_K = alg_mat_create(2.0, 2.0);
    let half_pi = 1.57079632679;
    mat_K.data[0] = 0.0; mat_K.data[1] = -half_pi;
    mat_K.data[2] = half_pi; mat_K.data[3] = 0.0;

    let mat_Rot = alg_mat_exp(mat_K, 12.0);
    assert_true(approx_eq(alg_mat_get(mat_Rot, 0.0, 0.0), 0.0, 0.0001) == 1.0, "exp(K) [0,0] == 0.0 (cos(pi/2))");
    assert_true(approx_eq(alg_mat_get(mat_Rot, 0.0, 1.0), -1.0, 0.0001) == 1.0, "exp(K) [0,1] == -1.0 (-sin(pi/2))");
    assert_true(approx_eq(alg_mat_get(mat_Rot, 1.0, 0.0), 1.0, 0.0001) == 1.0, "exp(K) [1,0] == 1.0 (sin(pi/2))");
    assert_true(approx_eq(alg_mat_get(mat_Rot, 1.0, 1.0), 0.0, 0.0001) == 1.0, "exp(K) [1,1] == 0.0 (cos(pi/2))");

    // Cleanup Gate 3
    alg_mat_free(mat_A);
    alg_mat_free(mat_B);
    alg_mat_free(mat_C);
    alg_mat_free(mat_P);
    alg_mat_free(mat_inv);
    alg_mat_free(mat_ident);
    alg_mat_free(mat_Q);
    alg_mat_free(mat_R);
    alg_mat_free(mat_Qt);
    alg_mat_free(mat_QtQ);
    alg_mat_free(mat_QR);
    alg_mat_free(mat_S);
    free(evals2);
    alg_mat_free(evecs2);
    alg_mat_free(mat_K);
    alg_mat_free(mat_Rot);

    // ------------------------------------------------------------------------
    // Gate 4: Symmetric Algebra, Quadratic Forms, Sylvester & Symplectic J
    // ------------------------------------------------------------------------
    puts("\n[Gate 4: Symmetric Algebra, Quadratic Forms & Symplectic Geometry]");

    // Quadratic Form Q(v) = v^T A v
    let mat_QF = alg_mat_create(2.0, 2.0);
    mat_QF.data[0] = 3.0; mat_QF.data[1] = 1.0;
    mat_QF.data[2] = 1.0; mat_QF.data[3] = 2.0;

    let vec_v = calloc(2.0, 8.0);
    vec_v[0] = 1.0; vec_v[1] = 2.0;
    // Q(v) = 1*(3*1 + 1*2) + 2*(1*1 + 2*2) = 1*(5) + 2*(5) = 15.0
    let qf_val = alg_quadratic_form(mat_QF, vec_v);
    assert_true(approx_eq(qf_val, 15.0, 0.0001) == 1.0, "Quadratic form Q([1, 2]) == 15.0");

    // Bilinear Form B(u, v) = u^T A v
    let vec_u = calloc(2.0, 8.0);
    vec_u[0] = 1.0; vec_u[1] = 0.0;
    let bf_val = alg_bilinear_form(mat_QF, vec_u, vec_v);
    // B([1, 0], [1, 2]) = 1*(3*1 + 1*2) = 5.0
    assert_true(approx_eq(bf_val, 5.0, 0.0001) == 1.0, "Bilinear form B([1, 0], [1, 2]) == 5.0");

    // Sylvester Metric Signature: Minkowski metric diag(1, -1, -1, -1) -> (1, 3, 0)
    let mat_Mink = alg_mat_create(4.0, 4.0);
    mat_Mink.data[0 * 4 + 0] = 1.0;
    mat_Mink.data[1 * 4 + 1] = -1.0;
    mat_Mink.data[2 * 4 + 2] = -1.0;
    mat_Mink.data[3 * 4 + 3] = -1.0;

    let sig_mink = calloc(3.0, 8.0);
    alg_sylvester_signature(mat_Mink, sig_mink);
    assert_true(sig_mink[0] == 1.0, "Minkowski metric signature p == 1.0");
    assert_true(sig_mink[1] == 3.0, "Minkowski metric signature q == 3.0");
    assert_true(sig_mink[2] == 0.0, "Minkowski metric signature r == 0.0 (non-degenerate)");

    // Sylvester Metric Signature on non-diagonal indefinite metric:
    // [[0, 1, 0], [1, 0, 0], [0, 0, -2]] -> eigenvalues: 1.0, -1.0, -2.0 -> (1, 2, 0)
    let mat_Indef = alg_mat_create(3.0, 3.0);
    mat_Indef.data[0 * 3 + 1] = 1.0;
    mat_Indef.data[1 * 3 + 0] = 1.0;
    mat_Indef.data[2 * 3 + 2] = -2.0;

    let sig_indef = calloc(3.0, 8.0);
    alg_sylvester_signature(mat_Indef, sig_indef);
    assert_true(sig_indef[0] == 1.0, "Indefinite metric signature p == 1.0");
    assert_true(sig_indef[1] == 2.0, "Indefinite metric signature q == 2.0");
    assert_true(sig_indef[2] == 0.0, "Indefinite metric signature r == 0.0");

    // Canonical Symplectic Matrix J for n = 2 (4 x 4)
    let mat_J = alg_symplectic_matrix(2.0);
    assert_true(mat_J.rows == 4.0 && mat_J.cols == 4.0, "Symplectic matrix J is 4x4");
    assert_true(alg_mat_get(mat_J, 0.0, 2.0) == 1.0, "J upper-right block [0, 2] == 1.0");
    assert_true(alg_mat_get(mat_J, 2.0, 0.0) == -1.0, "J lower-left block [2, 0] == -1.0");

    // Verify J^2 == -I (J * J = -I)
    let mat_J2 = alg_mat_mul(mat_J, mat_J);
    assert_true(approx_eq(alg_mat_get(mat_J2, 0.0, 0.0), -1.0, 0.0001) == 1.0, "Symplectic property J^2 [0,0] == -1.0");
    assert_true(approx_eq(alg_mat_get(mat_J2, 1.0, 1.0), -1.0, 0.0001) == 1.0, "Symplectic property J^2 [1,1] == -1.0");
    assert_true(approx_eq(alg_mat_get(mat_J2, 2.0, 2.0), -1.0, 0.0001) == 1.0, "Symplectic property J^2 [2,2] == -1.0");
    assert_true(approx_eq(alg_mat_get(mat_J2, 3.0, 3.0), -1.0, 0.0001) == 1.0, "Symplectic property J^2 [3,3] == -1.0");
    assert_true(approx_eq(alg_mat_get(mat_J2, 0.0, 1.0), 0.0, 0.0001) == 1.0, "Symplectic property J^2 [0,1] == 0.0");

    // Cleanup Gate 4
    alg_mat_free(mat_QF);
    free(vec_v);
    free(vec_u);
    alg_mat_free(mat_Mink);
    free(sig_mink);
    alg_mat_free(mat_Indef);
    free(sig_indef);
    alg_mat_free(mat_J);
    alg_mat_free(mat_J2);

    puts("\n>>> Target 91: All 35 assertions passed successfully! <<<");
    return 0.0;
}
