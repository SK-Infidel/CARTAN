// Target 72: Automated Neuro-Symbolic Rule Generator & Horn-Clause Ingestion Compiler
// Empirical regression test verifying TSV triple ingestion, relation normalization,
// SMT/SAT consistency checking, and dual binary/declarative emission under zero-mock standard.

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";

extern fn printf(fmt: string) -> i32;
extern fn exit(code: float) -> void;
extern fn atof(s: string) -> float;

// Normalizes a relational triple into natural language rule text
fn target72_normalize_triple(head: string, rel: string, tail: string) -> string {
    if (cartan_string_eq(rel, "HasPrerequisite") != 0.0) {
        return cartan_string_concat(cartan_string_concat(head, " is a mandatory prerequisite for "), cartan_string_concat(tail, "."));
    }
    if (cartan_string_eq(rel, "Causes") != 0.0) {
        return cartan_string_concat(cartan_string_concat(head, " directly causes "), cartan_string_concat(tail, "."));
    }
    if (cartan_string_eq(rel, "xIntent") != 0.0) {
        return cartan_string_concat("The communicative intent behind ", cartan_string_concat(cartan_string_concat(head, " is "), cartan_string_concat(tail, ".")));
    }
    if (cartan_string_eq(rel, "xNeed") != 0.0) {
        return cartan_string_concat("Executing ", cartan_string_concat(cartan_string_concat(head, " requires "), cartan_string_concat(tail, " beforehand.")));
    }
    if (cartan_string_eq(rel, "xEffect") != 0.0) {
        return cartan_string_concat("The pragmatic consequence of ", cartan_string_concat(cartan_string_concat(head, " is "), cartan_string_concat(tail, ".")));
    }
    if (cartan_string_eq(rel, "MustAgree") != 0.0) {
        return cartan_string_concat(head, cartan_string_concat(" must strictly maintain syntactic agreement with ", cartan_string_concat(tail, ".")));
    }
    if (cartan_string_eq(rel, "BoundedBy") != 0.0) {
        return cartan_string_concat(head, cartan_string_concat(" is structurally bounded by ", cartan_string_concat(tail, ".")));
    }
    if (cartan_string_eq(rel, "IsA") != 0.0) {
        return cartan_string_concat(head, cartan_string_concat(" is a specialized taxonomic instance of ", cartan_string_concat(tail, ".")));
    }
    return cartan_string_concat(cartan_string_concat(head, " "), cartan_string_concat(cartan_string_concat(rel, " "), cartan_string_concat(tail, ".")));
}

fn main() -> float {
    printf("=====================================================================\n");
    printf("  Target 72: Automated Neuro-Symbolic Rule Generator & Ingestion\n");
    printf("=====================================================================\n\n");

    // 1. Prepare authentic corpus with diverse linguistic & communicative relations
    var corpus = "# Head\tRelation\tTail\tConfidence\tIsStrict\n";
    corpus = cartan_string_concat(corpus, "speech\tHasPrerequisite\tvocabulary\t1.0\t1.0\n");
    corpus = cartan_string_concat(corpus, "question\txIntent\tanswer\t0.98\t1.0\n");
    corpus = cartan_string_concat(corpus, "pronoun\tMustAgree\tantecedent\t1.0\t1.0\n");
    corpus = cartan_string_concat(corpus, "contradiction\tCauses\tcommunication_failure\t0.96\t0.0\n");
    corpus = cartan_string_concat(corpus, "dialogue_turn\tBoundedBy\tdelimiters\t0.99\t0.0\n");
    corpus = cartan_string_concat(corpus, "assertion\txEffect\tlogical_commitment\t0.95\t0.0\n");
    corpus = cartan_string_concat(corpus, "asking\txNeed\tcomprehension\t0.97\t0.0\n");
    corpus = cartan_string_concat(corpus, "interrogative\tIsA\tspeech_act\t1.0\t0.0\n");

    let builder = cargraph_builder_create(1536.0);
    cargraph_builder_add_domain(builder, 6.0, 0.0, 8.0, 3.0); // Domain 6: LANGUAGE_DISCOURSE

    let solver = sat_solver_create(32.0);

    // 2. Parse and normalize triples
    let lines = string_split(corpus, "\n");
    let num_lines = cartan_tree_len_f(lines);
    var ingested = 0.0;
    var i = 0.0;

    while (i < num_lines) {
        let raw_line = cartan_tree_get_f32(lines, i);
        let line_len = cartan_string_length(raw_line);
        if (line_len > 2.0 && cartan_string_starts_with(raw_line, "#") == 0.0) {
            let fields = string_split(raw_line, "\t");
            if (cartan_tree_len_f(fields) >= 3.0) {
                let head = cartan_tree_get_f32(fields, 0.0);
                let rel = cartan_tree_get_f32(fields, 1.0);
                let tail = cartan_tree_get_f32(fields, 2.0);

                var conf = 1.0;
                if (cartan_tree_len_f(fields) >= 4.0) {
                    conf = atof(cartan_tree_get_f32(fields, 3.0));
                    if (conf <= 0.0) { conf = 1.0; }
                }

                var is_strict = 0.0;
                if (cartan_tree_len_f(fields) >= 5.0) {
                    is_strict = atof(cartan_tree_get_f32(fields, 4.0));
                }

                if (conf >= 0.95) {
                    let norm_rule = target72_normalize_triple(head, rel, tail);
                    cargraph_builder_add_rule(builder, 6.0, 1.0, is_strict, norm_rule);

                    let var_id = collections_list_len(builder.rule_domain_indices) - 1.0;
                    if (is_strict > 0.0 && var_id < solver.num_vars) {
                        sat_assert_axiom(solver, var_id);
                    }
                    ingested = ingested + 1.0;
                }
            }
        }
        i = i + 1.0;
    }

    printf("Ingested triples count: %.0f (expected 8.0)\n", ingested);
    if (ingested != 8.0) {
        printf("FAILED: Expected 8 ingested triples, got %.0f\n", ingested);
        exit(1.0);
    }

    // 3. SMT/SAT Consistency Proof
    let is_sat = sat_solve_consistency(solver);
    printf("SMT/SAT Consistency: %.0f (expected 1.0)\n", is_sat);
    if (is_sat != 1.0) {
        printf("FAILED: Triples generated an unsatisfiable contradiction!\n");
        exit(1.0);
    }
    printf("[PASS] Triples validated consistent under propositional Horn-clause SAT solver.\n\n");

    // 4. Binary Serialization
    let out_graph_path = "build/target72_test.car_graph";
    let s_ok = cargraph_serialize_to_file(builder, out_graph_path);
    if (s_ok == 0.0) {
        printf("FAILED: cargraph_serialize_to_file returned 0.0\n");
        exit(1.0);
    }

    // 5. Binary Verification Round-Trip
    let loaded_cg = cargraph_load_binary(out_graph_path);
    if (loaded_cg.is_valid == 0.0) {
        printf("FAILED: cargraph_load_binary failed to reload generated .car_graph\n");
        exit(1.0);
    }
    printf("Round-trip Loaded Rules: %.0f (expected 8.0)\n", loaded_cg.header.num_rules);
    printf("Round-trip Strict Invariants: %.0f (expected 3.0)\n", loaded_cg.header.num_strict_rules);

    if (loaded_cg.header.num_rules != 8.0) {
        printf("FAILED: Expected 8.0 rules in header, got %.0f\n", loaded_cg.header.num_rules);
        exit(1.0);
    }
    if (loaded_cg.header.num_strict_rules != 3.0) {
        printf("FAILED: Expected 3.0 strict rules in header, got %.0f\n", loaded_cg.header.num_strict_rules);
        exit(1.0);
    }

    // Verify Rule 0 text content
    let r0_text = cargraph_get_rule_text(loaded_cg, 0.0);
    printf("Rule 0: %s\n", r0_text);
    if (cartan_string_contains(r0_text, "mandatory prerequisite") == 0.0) {
        printf("FAILED: Rule 0 did not contain expected normalized prerequisite phrase\n");
        exit(1.0);
    }

    // Verify Rule 2 text content
    let r2_text = cargraph_get_rule_text(loaded_cg, 2.0);
    printf("Rule 2: %s\n\n", r2_text);
    if (cartan_string_contains(r2_text, "must strictly maintain syntactic agreement") == 0.0) {
        printf("FAILED: Rule 2 did not contain expected agreement phrase\n");
        exit(1.0);
    }

    // Clean up
    cargraph_free(loaded_cg);
    sat_solver_free(solver);
    cargraph_builder_free(builder);

    printf("=====================================================================\n");
    printf("[PASS] Target 72: Automated Neuro-Symbolic Rule Generator & Ingestion Verified Cleanly.\n");
    printf("=====================================================================\n");
    return 0.0;
}
