// test/compiler_suite/test_variadic_ret.car
// // run-pass
// Sprint 13 Test Target: FunctionDecl Return Type Propagation & Variadic Float Promotion

include "src/cartanc/ast.ch";

extern fn printf(fmt: string, val: float) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;

fn helper_ptr_ret() -> ptr {
    let t = cartan_tree_create();
    return t;
}

fn helper_float_ret(a: float, b: float) -> float {
    return a + b;
}

fn main() -> float {
    let p = helper_ptr_ret();
    cartan_assert(p != 0.0, "helper_ptr_ret should return non-null ptr!");

    let res = helper_float_ret(12.5, 7.5);
    cartan_assert(res == 20.0, "helper_float_ret should return 20.0!");

    printf("Function return type resolution & variadic float promotion passed: %f\n", res);
    cartan_flush(0.0);
    return 0.0;
}
