// test/compiler_suite/test_markov_conscious_agent.car
// // run-pass
// Empirical regression test verifying mathematical invariants of Hoffman Conscious Agents

include "src/std/math.cl";
include "src/std/tensor.cl";
include "src/std/markov.cl";
include "src/std/conscious_agent.cl";

fn main() -> float {
    printf("[Test CA-01] Testing Row-Softmax and Birkhoff Stochasticity...\n");
    let logits = tensor_alloc(4.0 * 4.0);
    let probs = tensor_alloc(4.0 * 4.0);
    var r = 0.0;
    while (r < 4.0) {
        var c = 0.0;
        while (c < 4.0) {
            logits[r * 4.0 + c] = (r + 1.0) * (c + 1.0) * 0.5 - 2.0;
            c = c + 1.0;
        }
        r = r + 1.0;
    }
    markov_row_softmax(logits, 4.0, 4.0, probs);

    // Verify each row sums to 1.0
    r = 0.0;
    while (r < 4.0) {
        var row_sum = 0.0;
        var c = 0.0;
        while (c < 4.0) {
            let val = probs[r * 4.0 + c];
            if (val < 0.0) {
                printf("Error: Negative probability in row-softmax!\n");
                return 1.0;
            }
            row_sum = row_sum + val;
            c = c + 1.0;
        }
        if (fabs(row_sum - 1.0) > 0.00001) {
            printf("Error: Row does not sum to 1.0! Sum: %s\n", cartan_float_to_string(row_sum));
            return 1.0;
        }
        r = r + 1.0;
    }
    printf("  -> Birkhoff row-stochasticity verified (Sum = 1.000000).\n");

    printf("[Test CA-02] Testing Bhattacharyya Spherical Geodesic Distance...\n");
    let p = tensor_alloc(4.0);
    let q = tensor_alloc(4.0);
    p[0] = 0.25; p[1] = 0.25; p[2] = 0.25; p[3] = 0.25;
    q[0] = 0.25; q[1] = 0.25; q[2] = 0.25; q[3] = 0.25;

    let dist_identical = markov_bhattacharyya_distance(p, q, 4.0);
    if (fabs(dist_identical) > 0.00001) {
        printf("Error: Distance between identical distributions must be 0! Got: %s\n", cartan_float_to_string(dist_identical));
        return 1.0;
    }

    q[0] = 0.70; q[1] = 0.10; q[2] = 0.10; q[3] = 0.10;
    let dist_diff = markov_bhattacharyya_distance(p, q, 4.0);
    if (dist_diff <= 0.0 || dist_diff > 3.14159) {
        printf("Error: Invalid geodesic distance: %s\n", cartan_float_to_string(dist_diff));
        return 1.0;
    }
    printf("  -> Geodesic distance verified: identical = 0.0, different = %s radians.\n", cartan_float_to_string(dist_diff));

    printf("[Test CA-03] Testing Perron-Frobenius Power Iteration Solver...\n");
    let pi_stat = tensor_alloc(4.0);
    let residual = markov_stationary_distribution(probs, pi_stat, 4.0, 100.0);
    if (residual > 0.0001) {
        printf("Error: Power iteration failed to converge. Residual: %s\n", cartan_float_to_string(residual));
        return 1.0;
    }

    // Verify pi * probs = pi
    r = 0.0;
    var pi_sum = 0.0;
    while (r < 4.0) {
        var dot = 0.0;
        var c = 0.0;
        while (c < 4.0) {
            dot = dot + pi_stat[c] * probs[c * 4.0 + r];
            c = c + 1.0;
        }
        if (fabs(dot - pi_stat[r]) > 0.0001) {
            printf("Error: Stationary condition violated at index %s! Got %s vs %s\n",
                cartan_float_to_string(r), cartan_float_to_string(dot), cartan_float_to_string(pi_stat[r]));
            return 1.0;
        }
        pi_sum = pi_sum + pi_stat[r];
        r = r + 1.0;
    }
    if (fabs(pi_sum - 1.0) > 0.0001) {
        printf("Error: Stationary state does not sum to 1.0! Sum: %s\n", cartan_float_to_string(pi_sum));
        return 1.0;
    }
    printf("  -> Stationary distribution verified: pi * T = pi (Residual: %s).\n", cartan_float_to_string(residual));

    printf("[Test CA-04] Testing Conscious Agent Lifecycle & Ising Glauber Dynamics...\n");
    let agent = conscious_agent_create(6.0, 4.0, 6.0, 1.5);
    let w_in = tensor_alloc(6.0);
    let w_out = tensor_alloc(6.0);
    var i = 0.0;
    while (i < 6.0) {
        w_in[i] = 1.0 / 6.0;
        i = i + 1.0;
    }

    let fe = conscious_agent_cycle(agent, w_in, w_out, 5.0);
    var out_sum = 0.0;
    i = 0.0;
    while (i < 6.0) {
        out_sum = out_sum + w_out[i];
        i = i + 1.0;
    }
    if (fabs(out_sum - 1.0) > 0.0001) {
        printf("Error: Conscious agent output does not sum to 1.0! Sum: %s\n", cartan_float_to_string(out_sum));
        return 1.0;
    }
    printf("  -> Agent cycle complete. Output sums to 1.0. Ising Free Energy: %s\n", cartan_float_to_string(fe));

    printf("[Test CA-05] Testing Hoffman Experience (X) & Temporal Change (ΔX)...\n");
    let change_1 = conscious_agent_experiential_change(agent);
    let entropy_1 = conscious_agent_experiential_entropy(agent);
    let qualia_1 = conscious_agent_dominant_qualia(agent);
    let qualia_int = conscious_agent_dominant_qualia_intensity(agent);

    if (entropy_1 <= 0.0) {
        printf("Error: Experiential entropy must be positive! Got: %s\n", cartan_float_to_string(entropy_1));
        return 1.0;
    }
    if (qualia_1 < 0.0 || qualia_1 >= 6.0) {
        printf("Error: Dominant qualia index out of bounds! Got: %s\n", cartan_float_to_string(qualia_1));
        return 1.0;
    }
    if (qualia_int <= 0.0 || qualia_int > 1.0) {
        printf("Error: Dominant qualia intensity out of range! Got: %s\n", cartan_float_to_string(qualia_int));
        return 1.0;
    }

    // Run a second cycle with distinct input to confirm non-zero temporal change ΔX
    w_in[0] = 0.8; w_in[1] = 0.04; w_in[2] = 0.04; w_in[3] = 0.04; w_in[4] = 0.04; w_in[5] = 0.04;
    let fe2 = conscious_agent_cycle(agent, w_in, w_out, 5.0);
    let change_2 = conscious_agent_experiential_change(agent);
    if (change_2 <= 0.0) {
        printf("Error: Temporal change ΔX between distinct experiences must be positive! Got: %s\n", cartan_float_to_string(change_2));
        return 1.0;
    }
    printf("  -> Experience verified: Active Qualia #%s (Salience: %s), Entropy H(X): %s, Temporal Change ΔX: %s\n",
        cartan_float_to_string(qualia_1), cartan_float_to_string(qualia_int),
        cartan_float_to_string(entropy_1), cartan_float_to_string(change_2));

    printf("\nAll Markovian Conscious Agent invariants verified successfully!\n");

    conscious_agent_free(agent);
    free(logits);
    free(probs);
    free(p);
    free(q);
    free(pi_stat);
    free(w_in);
    free(w_out);

    return 0.0;
}
