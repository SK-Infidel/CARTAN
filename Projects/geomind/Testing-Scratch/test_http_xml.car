// test/compiler_suite/test_http_xml.car
// CARTAN Regression Target [20/20]: Layer 1 HTTP & XML Standard Libraries Pass
// // run-pass

include "../../src/std/http.car";
include "../../src/std/xml.car";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    let get_resp = http::get("cartan-lang.org");
    cartan_assert(cartan_string_length(get_resp) > 0.0, "http::get failed");

    let post_resp = http::post("cartan-lang.org", "{\"query\":\"test\"}");
    cartan_assert(cartan_string_length(post_resp) > 0.0, "http::post failed");

    let xml_root = xml::parse("<root><data>CARTAN</data></root>");
    cartan_assert(xml_root != 0.0, "xml::parse failed");

    let elem = xml::get_element(xml_root, "data");
    cartan_assert(cartan_string_length(elem) > 0.0, "xml::get_element failed");

    return 0.0;
}
