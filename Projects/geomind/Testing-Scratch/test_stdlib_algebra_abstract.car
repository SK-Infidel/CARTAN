// Projects/geomind/Testing-Scratch/test_stdlib_algebra_abstract.car
// Test Target 94: Standard Library Abstract, Jordan, Tropical, Boolean & Universal Algebras
// Comprehensive regression suite for Pillar 4 of the CARTAN Unified Algebraic Taxonomy

include "src/std/algebra.cl";

extern fn printf(fmt: string, v: float) -> float;
extern fn puts(s: string) -> float;
extern fn exit(code: float) -> void;
extern fn cartan_flush(v: float) -> float;

fn assert_true(cond: float, name: string) -> float {
    if (cond > 0.5) {
        printf("  [PASS] ");
        puts(name);
        return 1.0;
    } else {
        printf("  [FAIL] Assertion failed: ");
        puts(name);
        cartan_flush(0.0);
        exit(1.0);
        return 0.0;
    }
}

fn assert_near(val: float, expected: float, tol: float, name: string) -> float {
    var diff = fabs(val - expected);
    if (diff <= tol) {
        printf("  [PASS] ");
        puts(name);
        return 1.0;
    } else {
        printf("  [FAIL] Value mismatch in ");
        puts(name);
        cartan_flush(0.0);
        exit(1.0);
        return 0.0;
    }
}

fn main() -> float {
    puts("======================================================================");
    puts("  TARGET 94: Abstract, Jordan, Tropical, Boolean & Universal Algebras ");
    puts("======================================================================");

    // =========================================================================
    // GATE 1: Jordan Algebras, Matrix Jordan Products & Identities
    // =========================================================================
    puts("\n[Gate 1: Jordan Algebras, Matrix Products & Identities]");

    // Two non-commuting 3x3 matrices
    let mat_a = alg_mat_create(3.0, 3.0);
    alg_mat_set(mat_a, 0.0, 0.0, 1.0);
    alg_mat_set(mat_a, 0.0, 1.0, 2.0);
    alg_mat_set(mat_a, 0.0, 2.0, 0.0);
    alg_mat_set(mat_a, 1.0, 0.0, 0.0);
    alg_mat_set(mat_a, 1.0, 1.0, 1.0);
    alg_mat_set(mat_a, 1.0, 2.0, 1.0);
    alg_mat_set(mat_a, 2.0, 0.0, 2.0);
    alg_mat_set(mat_a, 2.0, 1.0, 0.0);
    alg_mat_set(mat_a, 2.0, 2.0, 3.0);

    let mat_b = alg_mat_create(3.0, 3.0);
    alg_mat_set(mat_b, 0.0, 0.0, 2.0);
    alg_mat_set(mat_b, 0.0, 1.0, 1.0);
    alg_mat_set(mat_b, 0.0, 2.0, 1.0);
    alg_mat_set(mat_b, 1.0, 0.0, 1.0);
    alg_mat_set(mat_b, 1.0, 1.0, 0.0);
    alg_mat_set(mat_b, 1.0, 2.0, 2.0);
    alg_mat_set(mat_b, 2.0, 0.0, 0.0);
    alg_mat_set(mat_b, 2.0, 1.0, 1.0);
    alg_mat_set(mat_b, 2.0, 2.0, 1.0);

    // Confirm A and B do not commute: AB != BA
    let ab = alg_mat_mul(mat_a, mat_b);
    let ba = alg_mat_mul(mat_b, mat_a);
    var comm_diff = fabs(alg_mat_get(ab, 0.0, 1.0) - alg_mat_get(ba, 0.0, 1.0));
    assert_true(comm_diff > 0.01, "Negative control: Matrices A and B do NOT commute (AB != BA)");
    alg_mat_free(ab);
    alg_mat_free(ba);

    // Jordan product is commutative: A o B == B o A
    let jordan_ab = alg_jordan_mat_mul(mat_a, mat_b);
    let jordan_ba = alg_jordan_mat_mul(mat_b, mat_a);
    var j_diff = fabs(alg_mat_get(jordan_ab, 0.0, 1.0) - alg_mat_get(jordan_ba, 0.0, 1.0));
    assert_near(j_diff, 0.0, 0.0000001, "Jordan product commutativity: A o B == B o A");
    alg_mat_free(jordan_ba);

    // Jordan triple product: {A, B, C} == 0.5 * (A*B*C + C*B*A)
    let mat_c = alg_mat_create(3.0, 3.0);
    alg_mat_set(mat_c, 0.0, 0.0, 1.0);
    alg_mat_set(mat_c, 1.0, 1.0, 2.0);
    alg_mat_set(mat_c, 2.0, 2.0, 1.0);

    let j_triple = alg_jordan_mat_triple(mat_a, mat_b, mat_c);
    let ab_mul = alg_mat_mul(mat_a, mat_b);
    let abc_mul = alg_mat_mul(ab_mul, mat_c);
    alg_mat_free(ab_mul);

    let cb_mul = alg_mat_mul(mat_c, mat_b);
    let cba_mul = alg_mat_mul(cb_mul, mat_a);
    alg_mat_free(cb_mul);

    let sum_cba = alg_mat_add(abc_mul, cba_mul);
    let expected_triple = alg_mat_scale(sum_cba, 0.5);
    alg_mat_free(abc_mul);
    alg_mat_free(cba_mul);
    alg_mat_free(sum_cba);

    var triple_diff = fabs(alg_mat_get(j_triple, 1.0, 2.0) - alg_mat_get(expected_triple, 1.0, 2.0));
    assert_near(triple_diff, 0.0, 0.0000001, "Jordan triple product matches 0.5*(ABC + CBA)");
    alg_mat_free(j_triple);
    alg_mat_free(expected_triple);

    // Quadratic Jordan Operator: U_A(B) == A * B * A
    let quad_u = alg_jordan_mat_quadratic(mat_a, mat_b);
    let aba_part = alg_mat_mul(mat_a, mat_b);
    let expected_aba = alg_mat_mul(aba_part, mat_a);
    alg_mat_free(aba_part);

    var quad_diff = fabs(alg_mat_get(quad_u, 0.0, 2.0) - alg_mat_get(expected_aba, 0.0, 2.0));
    assert_near(quad_diff, 0.0, 0.0000001, "Quadratic Jordan operator U_A(B) matches A * B * A");
    alg_mat_free(quad_u);
    alg_mat_free(expected_aba);

    // Jordan identity verification on matrices: (A o B) o A^2 == A o (B o A^2)
    var j_id_ok = alg_jordan_mat_identity_check(mat_a, mat_b);
    assert_true(j_id_ok, "Matrix Jordan identity (A o B) o A^2 == A o (B o A^2) verified");

    // Formal Finite-Dimensional Jordan Algebra (2D Spin Factor: e0=id, e1^2=e0)
    let ja = alg_jordan_create(2.0);
    alg_jordan_set_constant(ja, 0.0, 0.0, 0.0, 1.0); // e0 o e0 = e0
    alg_jordan_set_constant(ja, 0.0, 1.0, 1.0, 1.0); // e0 o e1 = e1
    alg_jordan_set_constant(ja, 1.0, 1.0, 0.0, 1.0); // e1 o e1 = e0

    var basis_j_ok = alg_jordan_identity_check(ja);
    assert_true(basis_j_ok, "Formal 2D Jordan spin algebra satisfies Jordan identity");

    // Negative control on formal Jordan algebra: break Jordan identity
    // Commutative algebra with e0^2 = e1, e0 o e1 = 0, e1^2 = e0
    // Violates (e0 o e1) o e0^2 = 0 != e0 o (e1 o e0^2) = e0 o e0 = e1
    let bad_ja = alg_jordan_create(2.0);
    alg_jordan_set_constant(bad_ja, 0.0, 0.0, 1.0, 1.0); // e0 o e0 = e1
    alg_jordan_set_constant(bad_ja, 1.0, 1.0, 0.0, 1.0); // e1 o e1 = e0
    var bad_j_ok = alg_jordan_identity_check(bad_ja);
    assert_true(bad_j_ok < 0.5, "Negative control: Corrupted algebra fails Jordan identity check");

    alg_jordan_free(ja);
    alg_jordan_free(bad_ja);
    alg_mat_free(jordan_ab);
    alg_mat_free(mat_c);
    alg_mat_free(mat_a);
    alg_mat_free(mat_b);

    // =========================================================================
    // GATE 2: Tropical Semirings (Min-Plus & Max-Plus) & Kleene Star
    // =========================================================================
    puts("\n[Gate 2: Tropical Semirings & Matrix Kleene Star Closure]");

    // Min-Plus and Max-Plus scalars
    assert_near(alg_tropical_min_add(3.0, 7.0), 3.0, 0.0001, "Tropical min addition min(3, 7) == 3");
    assert_near(alg_tropical_max_add(3.0, 7.0), 7.0, 0.0001, "Tropical max addition max(3, 7) == 7");
    assert_near(alg_tropical_min_mul(3.0, 7.0), 10.0, 0.0001, "Tropical multiplication 3 (*) 7 == 10");

    // Absorbing sentinel check
    var abs_mul = alg_tropical_min_mul(5.0, alg_tropical_inf());
    assert_true(abs_mul >= alg_tropical_threshold(), "Tropical absorbing infinity: 5 (*) +Inf == +Inf");

    // 4-Node Directed Weighted Graph All-Pairs Shortest Paths
    // Nodes: 0, 1, 2, 3
    // Edges: 0->1 (3), 0->2 (8), 1->2 (2), 1->3 (5), 2->3 (1)
    let adj = alg_tropical_mat_create_inf(4.0, 4.0);
    alg_mat_set(adj, 0.0, 0.0, 0.0);
    alg_mat_set(adj, 1.0, 1.0, 0.0);
    alg_mat_set(adj, 2.0, 2.0, 0.0);
    alg_mat_set(adj, 3.0, 3.0, 0.0);

    alg_mat_set(adj, 0.0, 1.0, 3.0);
    alg_mat_set(adj, 0.0, 2.0, 8.0);
    alg_mat_set(adj, 1.0, 2.0, 2.0);
    alg_mat_set(adj, 1.0, 3.0, 5.0);
    alg_mat_set(adj, 2.0, 3.0, 1.0);

    // Compute Kleene Star Closure A*
    let kleene_star = alg_tropical_kleene_star(adj);

    // Direct path 0->1 is 3
    assert_near(alg_mat_get(kleene_star, 0.0, 1.0), 3.0, 0.0001, "Shortest path 0->1 == 3.0");
    // Path 0->2: min(8, 3+2) = 5
    assert_near(alg_mat_get(kleene_star, 0.0, 2.0), 5.0, 0.0001, "Shortest path 0->2 == 5.0 (via node 1)");
    // Path 0->3: min(3+5, 5+1) = 6
    assert_near(alg_mat_get(kleene_star, 0.0, 3.0), 6.0, 0.0001, "Shortest path 0->3 == 6.0 (0->1->2->3)");
    // Path 1->3: min(5, 2+1) = 3
    assert_near(alg_mat_get(kleene_star, 1.0, 3.0), 3.0, 0.0001, "Shortest path 1->3 == 3.0 (via node 2)");
    // Disconnected reverse path 3->0 remains infinity
    assert_true(alg_mat_get(kleene_star, 3.0, 0.0) >= alg_tropical_threshold(), "Disconnected reverse path 3->0 remains infinity");

    alg_mat_free(adj);
    alg_mat_free(kleene_star);

    // =========================================================================
    // GATE 3: Boolean Algebras, Stone Boolean Rings & BitVectors
    // =========================================================================
    puts("\n[Gate 3: Boolean Algebras, Stone Rings & Multi-Word BitVectors]");

    // De Morgan's laws: not(a or b) == (not a) and (not b)
    var demorgan_ok = 1.0;
    var a_bit = 0.0;
    while (a_bit <= 1.0) {
        var b_bit = 0.0;
        while (b_bit <= 1.0) {
            var lhs1 = alg_bool_not(alg_bool_join(a_bit, b_bit));
            var rhs1 = alg_bool_meet(alg_bool_not(a_bit), alg_bool_not(b_bit));
            if (lhs1 != rhs1) { demorgan_ok = 0.0; }

            var lhs2 = alg_bool_not(alg_bool_meet(a_bit, b_bit));
            var rhs2 = alg_bool_join(alg_bool_not(a_bit), alg_bool_not(b_bit));
            if (lhs2 != rhs2) { demorgan_ok = 0.0; }

            b_bit = b_bit + 1.0;
        }
        a_bit = a_bit + 1.0;
    }
    assert_true(demorgan_ok, "De Morgan laws hold across all boolean truth values");

    // Stone Boolean Ring Isomorphism: a + a = 0 (char 2) and a * a = a (idempotent)
    var char2_ok = 1.0;
    var idemp_ok = 1.0;
    a_bit = 0.0;
    while (a_bit <= 1.0) {
        if (alg_bool_ring_add(a_bit, a_bit) != 0.0) { char2_ok = 0.0; }
        if (alg_bool_ring_mul(a_bit, a_bit) != a_bit) { idemp_ok = 0.0; }
        a_bit = a_bit + 1.0;
    }
    assert_true(char2_ok, "Stone Boolean ring has characteristic 2 (x + x == 0)");
    assert_true(idemp_ok, "Stone Boolean ring multiplication is idempotent (x * x == x)");

    // Multi-Word BitVector: 70 bits (spans 3 32-bit words)
    let bv1 = alg_bitvec_create(70.0);
    alg_bitvec_set_bit(bv1, 5.0, 1.0);   // Word 0
    alg_bitvec_set_bit(bv1, 35.0, 1.0);  // Word 1
    alg_bitvec_set_bit(bv1, 68.0, 1.0);  // Word 2

    assert_true(alg_bitvec_get_bit(bv1, 5.0) > 0.5, "Bit 5 retrieved in word 0");
    assert_true(alg_bitvec_get_bit(bv1, 35.0) > 0.5, "Bit 35 retrieved in word 1");
    assert_true(alg_bitvec_get_bit(bv1, 68.0) > 0.5, "Bit 68 retrieved in word 2");
    assert_true(alg_bitvec_get_bit(bv1, 6.0) < 0.5, "Bit 6 is 0 (negative control)");
    assert_near(alg_bitvec_popcount(bv1), 3.0, 0.0001, "Popcount of 3-bit multi-word vector == 3.0");

    // Subvector bv2 with bits 5 and 35 set
    let bv2 = alg_bitvec_create(70.0);
    alg_bitvec_set_bit(bv2, 5.0, 1.0);
    alg_bitvec_set_bit(bv2, 35.0, 1.0);

    assert_true(alg_bitvec_is_subset(bv2, bv1) > 0.5, "Lattice subset ordering: bv2 <= bv1 holds");
    assert_true(alg_bitvec_is_subset(bv1, bv2) < 0.5, "Negative control: bv1 <= bv2 fails");

    // Hamming distance between bv1 and bv2 (differ only at bit 68)
    assert_near(alg_bitvec_hamming_dist(bv1, bv2), 1.0, 0.0001, "Hamming distance dist(bv1, bv2) == 1.0");

    // BitVector Inversion with padding mask: NOT(bv2) has 70 - 2 = 68 ones
    let not_bv2 = alg_bitvec_not(bv2);
    assert_near(alg_bitvec_popcount(not_bv2), 68.0, 0.0001, "BitVector NOT correctly masks padding bits (popcount == 68)");

    alg_bitvec_free(bv1);
    alg_bitvec_free(bv2);
    alg_bitvec_free(not_bv2);

    // =========================================================================
    // GATE 4: Universal Algebra & General Structural Taxonomy
    // =========================================================================
    puts("\n[Gate 4: Universal Algebra & Structural Taxonomy]");

    // 1. Klein 4-Group V4 = Z2 x Z2 (elements 0, 1, 2, 3)
    // Every element squared is 0 (identity)
    let v4 = alg_cayley_create(4.0);
    // Row 0 (identity)
    alg_cayley_set(v4, 0.0, 0.0, 0.0); alg_cayley_set(v4, 0.0, 1.0, 1.0);
    alg_cayley_set(v4, 0.0, 2.0, 2.0); alg_cayley_set(v4, 0.0, 3.0, 3.0);
    // Row 1
    alg_cayley_set(v4, 1.0, 0.0, 1.0); alg_cayley_set(v4, 1.0, 1.0, 0.0);
    alg_cayley_set(v4, 1.0, 2.0, 3.0); alg_cayley_set(v4, 1.0, 3.0, 2.0);
    // Row 2
    alg_cayley_set(v4, 2.0, 0.0, 2.0); alg_cayley_set(v4, 2.0, 1.0, 3.0);
    alg_cayley_set(v4, 2.0, 2.0, 0.0); alg_cayley_set(v4, 2.0, 3.0, 1.0);
    // Row 3
    alg_cayley_set(v4, 3.0, 0.0, 3.0); alg_cayley_set(v4, 3.0, 1.0, 2.0);
    alg_cayley_set(v4, 3.0, 2.0, 1.0); alg_cayley_set(v4, 3.0, 3.0, 0.0);

    assert_near(alg_cayley_classify(v4), 5.0, 0.0001, "Klein 4-group classified as Abelian Group (level 5.0)");
    alg_cayley_free(v4);

    // 2. Symmetric Group S3 (order 6, non-abelian group)
    // Elements: 0=(), 1=(12), 2=(23), 3=(13), 4=(123), 5=(132)
    let s3 = alg_cayley_create(6.0);
    // Multiplication table for S3:
    alg_cayley_set(s3, 0.0, 0.0, 0.0); alg_cayley_set(s3, 0.0, 1.0, 1.0); alg_cayley_set(s3, 0.0, 2.0, 2.0); alg_cayley_set(s3, 0.0, 3.0, 3.0); alg_cayley_set(s3, 0.0, 4.0, 4.0); alg_cayley_set(s3, 0.0, 5.0, 5.0);
    alg_cayley_set(s3, 1.0, 0.0, 1.0); alg_cayley_set(s3, 1.0, 1.0, 0.0); alg_cayley_set(s3, 1.0, 2.0, 4.0); alg_cayley_set(s3, 1.0, 3.0, 5.0); alg_cayley_set(s3, 1.0, 4.0, 2.0); alg_cayley_set(s3, 1.0, 5.0, 3.0);
    alg_cayley_set(s3, 2.0, 0.0, 2.0); alg_cayley_set(s3, 2.0, 1.0, 5.0); alg_cayley_set(s3, 2.0, 2.0, 0.0); alg_cayley_set(s3, 2.0, 3.0, 4.0); alg_cayley_set(s3, 2.0, 4.0, 3.0); alg_cayley_set(s3, 2.0, 5.0, 1.0);
    alg_cayley_set(s3, 3.0, 0.0, 3.0); alg_cayley_set(s3, 3.0, 1.0, 4.0); alg_cayley_set(s3, 3.0, 2.0, 5.0); alg_cayley_set(s3, 3.0, 3.0, 0.0); alg_cayley_set(s3, 3.0, 4.0, 1.0); alg_cayley_set(s3, 3.0, 5.0, 2.0);
    alg_cayley_set(s3, 4.0, 0.0, 4.0); alg_cayley_set(s3, 4.0, 1.0, 3.0); alg_cayley_set(s3, 4.0, 2.0, 1.0); alg_cayley_set(s3, 4.0, 3.0, 2.0); alg_cayley_set(s3, 4.0, 4.0, 5.0); alg_cayley_set(s3, 4.0, 5.0, 0.0);
    alg_cayley_set(s3, 5.0, 0.0, 5.0); alg_cayley_set(s3, 5.0, 1.0, 2.0); alg_cayley_set(s3, 5.0, 2.0, 3.0); alg_cayley_set(s3, 5.0, 3.0, 1.0); alg_cayley_set(s3, 5.0, 4.0, 0.0); alg_cayley_set(s3, 5.0, 5.0, 4.0);

    assert_near(alg_cayley_classify(s3), 4.0, 0.0001, "Symmetric group S3 classified as Non-Abelian Group (level 4.0)");
    assert_true(alg_cayley_is_commutative(s3) < 0.5, "S3 confirmed non-commutative (1*2 != 2*1)");
    alg_cayley_free(s3);

    // 3. Monoid without Inverses: Min operation on {0, 1, 2}
    // Closed, associative, identity = 2 (min(a, 2) = a), but elements lack inverses
    let min_monoid = alg_cayley_create(3.0);
    var x = 0.0;
    while (x < 3.0) {
        var y = 0.0;
        while (y < 3.0) {
            var min_xy = x;
            if (y < x) { min_xy = y; }
            alg_cayley_set(min_monoid, x, y, min_xy);
            y = y + 1.0;
        }
        x = x + 1.0;
    }
    assert_near(alg_cayley_classify(min_monoid), 3.0, 0.0001, "Min operation on {0,1,2} classified as Monoid (level 3.0)");
    alg_cayley_free(min_monoid);

    // 4. Galois Field GF(2): (+ = XOR, * = AND)
    let gf2_add = alg_cayley_create(2.0);
    alg_cayley_set(gf2_add, 0.0, 0.0, 0.0); alg_cayley_set(gf2_add, 0.0, 1.0, 1.0);
    alg_cayley_set(gf2_add, 1.0, 0.0, 1.0); alg_cayley_set(gf2_add, 1.0, 1.0, 0.0);

    let gf2_mul = alg_cayley_create(2.0);
    alg_cayley_set(gf2_mul, 0.0, 0.0, 0.0); alg_cayley_set(gf2_mul, 0.0, 1.0, 0.0);
    alg_cayley_set(gf2_mul, 1.0, 0.0, 0.0); alg_cayley_set(gf2_mul, 1.0, 1.0, 1.0);

    assert_true(alg_cayley_is_field(gf2_add, gf2_mul) > 0.5, "GF(2) verified as a genuine Field");
    alg_cayley_free(gf2_add);
    alg_cayley_free(gf2_mul);

    // 5. Universal Homomorphism: phi: Z4 -> Z2 (x mod 2)
    // Z4 addition
    let z4 = alg_cayley_create(4.0);
    x = 0.0;
    while (x < 4.0) {
        var y = 0.0;
        while (y < 4.0) {
            alg_cayley_set(z4, x, y, fmod(x + y, 4.0));
            y = y + 1.0;
        }
        x = x + 1.0;
    }

    // Z2 addition
    let z2 = alg_cayley_create(2.0);
    alg_cayley_set(z2, 0.0, 0.0, 0.0); alg_cayley_set(z2, 0.0, 1.0, 1.0);
    alg_cayley_set(z2, 1.0, 0.0, 1.0); alg_cayley_set(z2, 1.0, 1.0, 0.0);

    // Map: phi[x] = x mod 2
    var phi = calloc(4.0, 8.0);
    phi[0.0] = 0.0;
    phi[1.0] = 1.0;
    phi[2.0] = 0.0;
    phi[3.0] = 1.0;

    assert_true(alg_cayley_is_homomorphism(z4, z2, phi) > 0.5, "Homomorphism phi: Z4 -> Z2 (x mod 2) verified");

    free(phi);
    alg_cayley_free(z4);
    alg_cayley_free(z2);

    puts("======================================================================");
    puts("  TARGET 94 RESULT: ALL ASSERTIONS PASSED (100% SUCCESS)              ");
    puts("======================================================================");
    return 0.0;
}
