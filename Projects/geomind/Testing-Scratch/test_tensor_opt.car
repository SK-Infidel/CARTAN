// test/compiler_suite/test_tensor_opt.car
// // run-pass
// Sprint 14 Test Target: Tensor Activations, High-Performance Reductions & Optimizations

include "../../src/cartanc/ast.ch";

extern fn printf(fmt: string, v: float) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;

extern fn malloc(size: float) -> ptr;
extern fn free(p: ptr) -> void;
extern fn cartan_tensor_sum(arr: ptr, size: float) -> float;
extern fn cartan_tensor_mean(arr: ptr, size: float) -> float;
extern fn cartan_tensor_max(arr: ptr, size: float) -> float;
extern fn cartan_tensor_min(arr: ptr, size: float) -> float;
extern fn cartan_tensor_sigmoid(arr: ptr, size: float) -> ptr;

fn main() -> float {
    let p = malloc(32.0); // 4 doubles (32 bytes)
    p[0.0] = 1.0;
    p[1.0] = 2.0;
    p[2.0] = 3.0;
    p[3.0] = 4.0;
    
    // Perform tensor reductions on scalar allocations
    let s = cartan_tensor_sum(p, 4.0);
    cartan_assert(s == 10.0, "cartan_tensor_sum failed!");

    let m = cartan_tensor_mean(p, 4.0);
    cartan_assert(m == 2.5, "cartan_tensor_mean failed!");

    let mx = cartan_tensor_max(p, 4.0);
    let mn = cartan_tensor_min(p, 4.0);
    cartan_assert(mx == 4.0, "cartan_tensor_max must equal 4.0!");
    cartan_assert(mn == 1.0, "cartan_tensor_min must equal 1.0!");
    cartan_assert(mx >= mn, "cartan_tensor_max must be >= min!");

    let sig_ptr = cartan_tensor_sigmoid(p, 4.0);
    cartan_assert(sig_ptr != 0.0, "cartan_tensor_sigmoid returned null!");
    free(sig_ptr);
    free(p);

    printf("Sprint 14 tensor reductions and activations verified cleanly!\n", 0.0);
    cartan_flush(0.0);
    return 0.0;
}
