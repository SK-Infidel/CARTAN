// test/compiler_suite/test_primitives.car
// Regression Test 1: Primitive arithmetic, functions, string concats

include "src/cartanc/ast.ch";

extern fn printf(fmt: string, val: float) -> float;

fn add(a: float, b: float) -> float {
    return a + b;
}

fn main() -> float {
    let result = add(40.0, 2.0);
    printf("Test Primitives Result: %f\n", result);
    return 0.0;
}
