// Projects/geomind/test_interface_coloring_and_animation.car
// Verification Suite for ANSI Terminal Text Coloring & Dynamic ASCII Animations (Sprint 534)

fn sleep_detect_attractor_voids(basins_file: string, dim: float) -> float { return 0.0; }
fn cartan_tensor_train_step(hidden_ptr: ptr, target_tok_id: float, learning_rate: float) -> float { return 0.0; }

include "Projects/geomind/chat.cl";

extern fn printf(fmt: string, s: string) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn exit(code: float) -> void;

fn main() -> float {
    printf("================================================================================\n");
    printf("  GEOMIND INTERFACE COLORING & ASCII ANIMATION VERIFICATION SUITE\n");
    printf("  Empirical Validation: ANSI Escape Lowering, Palette Collapse & Zero-Mock Math\n");
    printf("================================================================================\n\n");
    cartan_flush(0.0);

    // =========================================================================
    // GATE 1: Compiler \e Lowering & Dynamic Escape Synthesis
    // =========================================================================
    printf("=== TEST GATE 1: Compiler \\e Lowering & Escape Synthesis ===\n");
    let esc_reset = "\e[0m";
    let len_reset = cartan_string_length(esc_reset);
    let c0_reset = cartan_string_get_char(esc_reset, 0.0);
    if (len_reset != 4.0 || c0_reset != 27.0) {
        printf("[FAIL] Gate 1: Literal \\e[0m failed (len: %.0f, c0: %.0f, expected len 4, c0 27)\n", len_reset, c0_reset);
        return 1.0;
    }
    printf("[PASS] Gate 1: Literal \\e[0m lowered to 4 bytes with leading ESC (27.0).\n");

    let esc_green = "\e[1;32m";
    let len_green = cartan_string_length(esc_green);
    let c0_green = cartan_string_get_char(esc_green, 0.0);
    if (len_green != 7.0 || c0_green != 27.0) {
        printf("[FAIL] Gate 1: Literal \\e[1;32m failed (len: %.0f, c0: %.0f)\n", len_green, c0_green);
        return 1.0;
    }
    printf("[PASS] Gate 1: Compound ANSI sequence \\e[1;32m verified (7 bytes, leading ESC).\n");

    let dyn_esc = geomind_ansi_esc();
    let dyn_len = cartan_string_length(dyn_esc);
    let dyn_c0 = cartan_string_get_char(dyn_esc, 0.0);
    if (dyn_len != 1.0 || dyn_c0 != 27.0) {
        printf("[FAIL] Gate 1: Dynamic escape synthesis failed (len: %.0f, c0: %.0f)\n", dyn_len, dyn_c0);
        return 1.0;
    }
    printf("[PASS] Gate 1: Dynamic escape synthesizer parity verified.\n\n");
    cartan_flush(0.0);

    // =========================================================================
    // GATE 2: Color Toggles & Palette Collapse
    // =========================================================================
    printf("=== TEST GATE 2: Color Toggles & Palette Collapse ===\n");
    let def_col = geomind_chat_get_use_color();
    let def_anim = geomind_chat_get_use_animation();
    if (def_col != 1.0 || def_anim != 1.0) {
        printf("[FAIL] Gate 2: Default color/anim flags must be 1.0 (got col=%.0f, anim=%.0f)\n", def_col, def_anim);
        return 1.0;
    }
    printf("[PASS] Gate 2: Default state verified (color=1.0, anim=1.0).\n");

    // Test enabled palette helpers
    let col_grn = geomind_col_green();
    let col_cyn = geomind_col_cyan();
    let col_amb = geomind_col_amber();
    let col_red = geomind_col_red();
    let col_rst = geomind_col_reset();
    if (cartan_string_length(col_grn) == 0.0 || cartan_string_get_char(col_grn, 0.0) != 27.0) {
        printf("[FAIL] Gate 2: Enabled green helper invalid.\n");
        return 1.0;
    }
    if (cartan_string_length(col_cyn) == 0.0 || cartan_string_get_char(col_cyn, 0.0) != 27.0) {
        printf("[FAIL] Gate 2: Enabled cyan helper invalid.\n");
        return 1.0;
    }
    printf("[PASS] Gate 2: Enabled palette helpers return valid ANSI escape sequences.\n");

    // Test disabled palette collapse (Zero-Leak)
    geomind_chat_set_use_color(0.0);
    let dis_grn = geomind_col_green();
    let dis_cyn = geomind_col_cyan();
    let dis_amb = geomind_col_amber();
    let dis_red = geomind_col_red();
    let dis_rst = geomind_col_reset();
    if (cartan_string_length(dis_grn) != 0.0 || cartan_string_length(dis_cyn) != 0.0 ||
        cartan_string_length(dis_amb) != 0.0 || cartan_string_length(dis_red) != 0.0 ||
        cartan_string_length(dis_rst) != 0.0) {
        printf("[FAIL] Gate 2: Palette helpers must return empty strings when color is disabled.\n");
        return 1.0;
    }
    let dis_erase = geomind_col_erase_line();
    if (cartan_string_get_char(dis_erase, 0.0) == 27.0) {
        printf("[FAIL] Gate 2: Erase line helper must not emit ESC byte 27 when color is disabled.\n");
        return 1.0;
    }
    printf("[PASS] Gate 2: Palette zero-leak collapse verified (all empty strings when color=0.0).\n");

    // Restore enabled state
    geomind_chat_set_use_color(1.0);
    printf("[PASS] Gate 2: Restored color state to 1.0.\n\n");
    cartan_flush(0.0);

    // =========================================================================
    // GATE 3: In-Place Thinking Animation & Zero-Mock Cognitive Pass
    // =========================================================================
    printf("=== TEST GATE 3: In-Place Thinking Animation & Zero-Mock Cognitive Pass ===\n");
    // Verify spinner frames
    let f0 = geomind_get_spinner_frame(0.0);
    let f1 = geomind_get_spinner_frame(1.0);
    let f9 = geomind_get_spinner_frame(9.0);
    let f10 = geomind_get_spinner_frame(10.0);
    if (cartan_string_eq(f0, f10) != 1.0) {
        printf("[FAIL] Gate 3: Spinner modulo indexing failed (f0 != f10).\n");
        return 1.0;
    }
    printf("[PASS] Gate 3: Spinner frame generator and modulo wrapping verified.\n");

    // Verify ASCII fallback spinner
    let a0 = geomind_get_spinner_ascii_frame(0.0);
    let a1 = geomind_get_spinner_ascii_frame(1.0);
    let a4 = geomind_get_spinner_ascii_frame(4.0);
    if (cartan_string_eq(a0, "|") != 1.0 || cartan_string_eq(a1, "/") != 1.0 || cartan_string_eq(a0, a4) != 1.0) {
        printf("[FAIL] Gate 3: ASCII fallback spinner failed.\n");
        return 1.0;
    }
    printf("[PASS] Gate 3: ASCII fallback spinner verified (| / - \\).\n");

    // Execute genuine cognitive reasoning pass (Zero-Mock Rule)
    geomind_chat_set_show_thinking(1.0);
    let pass_res = geomind_chat_generate_reasoning_pass("Explain differential geometry, geodesics, and curvature", 0.7);
    if (pass_res != 1.0) {
        printf("[FAIL] Gate 3: Reasoning pass failed to return 1.0.\n");
        return 1.0;
    }
    if (g_active_dom_stream < 0.0 || g_active_dom_w <= 0.0) {
        printf("[FAIL] Gate 3: Sasaki geometric prior not seeded (stream=%.0f, w=%.4f).\n", g_active_dom_stream, g_active_dom_w);
        return 1.0;
    }
    printf("[PASS] Gate 3: Zero-mock cognitive pass executed with Sasaki prior (stream=%.0f, weight=%.4f).\n\n",
           g_active_dom_stream, g_active_dom_w);
    cartan_flush(0.0);

    // =========================================================================
    // GATE 4: Buffered Decode Progress & Output Sanitization
    // =========================================================================
    printf("=== TEST GATE 4: Buffered Decode Progress & Output Sanitization ===\n");
    let raw_out = "<think>Internal deliberation</think>The geodesic curvature is zero.<tool_call:read_file path=\"test\"/>";
    let sanitized = geomind_sanitize_output_for_display(raw_out);
    if (cartan_string_contains(sanitized, "<think>") == 1.0 || cartan_string_contains(sanitized, "<tool_call") == 1.0) {
        printf("[FAIL] Gate 4: Output sanitization leaked protocol tags: \"%s\"\n", sanitized);
        return 1.0;
    }
    if (cartan_string_contains(sanitized, "The geodesic curvature is zero.") == 0.0) {
        printf("[FAIL] Gate 4: Sanitization clobbered conversational text: \"%s\"\n", sanitized);
        return 1.0;
    }
    printf("[PASS] Gate 4: Output sanitization stripped tags and preserved conversational text.\n");

    let erase_line_str = geomind_col_erase_line();
    if (cartan_string_length(erase_line_str) == 0.0) {
        printf("[FAIL] Gate 4: Erase line string is empty.\n");
        return 1.0;
    }
    printf("[PASS] Gate 4: Erase line helper validated.\n\n");
    cartan_flush(0.0);

    // =========================================================================
    // GATE 5: REPL Command Parsing & Mutability
    // =========================================================================
    printf("=== TEST GATE 5: REPL Command Parsing & Mutability ===\n");
    geomind_chat_set_use_color(0.0);
    if (geomind_chat_get_use_color() != 0.0) {
        printf("[FAIL] Gate 5: set_use_color failed.\n");
        return 1.0;
    }
    geomind_chat_set_use_color(1.0);
    if (geomind_chat_get_use_color() != 1.0) {
        printf("[FAIL] Gate 5: reset set_use_color failed.\n");
        return 1.0;
    }

    geomind_chat_set_use_animation(0.0);
    if (geomind_chat_get_use_animation() != 0.0) {
        printf("[FAIL] Gate 5: set_use_animation failed.\n");
        return 1.0;
    }
    geomind_chat_set_use_animation(1.0);
    if (geomind_chat_get_use_animation() != 1.0) {
        printf("[FAIL] Gate 5: reset set_use_animation failed.\n");
        return 1.0;
    }
    printf("[PASS] Gate 5: State mutators for /color and /anim verified.\n\n");

    printf("================================================================================\n");
    printf("  ALL 5 GATES PASSED: ANSI COLORING & ASCII ANIMATION VERIFIED (Status 0)\n");
    printf("================================================================================\n");
    cartan_flush(0.0);
    return 0.0;
}
