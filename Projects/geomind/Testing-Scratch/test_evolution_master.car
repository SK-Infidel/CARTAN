// test/compiler_suite/test_evolution_master.car
// CARTAN Master Evolutionary Learning Suite Test Driver

include "src/std/evolution.cl";

fn main() -> float {
    printf("======================================================================\n", "");
    printf("  CARTAN MASTER EVOLUTIONARY LEARNING SUITE TEST (evolution.cl)\n", "");
    printf("======================================================================\n\n", "");

    evolution_suite_status();

    // 1. Test ES Optimizer
    let opt = es_optimizer_create(2.0, 10.0, 1.0, 0.1);
    es_optimizer_set_param(opt, 0.0, 5.0);
    let p0 = es_optimizer_get_param(opt, 0.0);
    printf("[Master Evolution] ES Optimizer Initialized. Param[0] = %f\n", p0);

    // 2. Test WANN Topology Creation
    let wann_net = wann_create_network(2.0, 1.0);
    wann_mutate_add_connection(wann_net, 0.0, 2.0);
    let inputs = cartan_tree_create();
    cartan_tree_push_f32(inputs, 1.0);
    let wann_out = wann_evaluate_shared_weight(wann_net, inputs, 1.5);
    let w_score = cartan_tree_get_f32(wann_out, 0.0);
    printf("[Master Evolution] WANN Topology Evaluated (Shared Weight=1.5). Output = %f\n", w_score);

    // 3. Test AZR Compiler Rewards
    let reward = azr_evaluate_binary_reward("fn test() -> float { return 1.0; }");
    printf("[Master Evolution] AZR Binary Compiler Reward = %f\n", reward);

    printf("\n[SUCCESS] Master Evolutionary Learning Suite Verified!\n", "");
    return 0.0;
}
