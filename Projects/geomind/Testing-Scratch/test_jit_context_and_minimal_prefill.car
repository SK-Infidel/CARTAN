// =============================================================================
// CARTAN TEST: Dynamic Just-In-Time (JIT) Context Grounding & Minimal Prefill
// Projects/geomind/test_jit_context_and_minimal_prefill.car
// Sprint 536 Verification Suite: 5-Gate Empirical Acceptance Test (Zero-Mock)
// =============================================================================

fn sleep_detect_attractor_voids(basins_file: string, dim: float) -> float { return 0.0; }
fn cartan_tensor_train_step(hidden_ptr: ptr, target_tok_id: float, learning_rate: float) -> float { return 0.0; }

include "src/std/tokenizer.cl";
include "Projects/geomind/chat.cl";

fn main() -> float {
    printf("================================================================================\n");
    printf("  TEST: Dynamic JIT Context Grounding & Minimal Startup Prefill\n");
    printf("================================================================================\n\n");

    let db = geomind_chat_get_db();
    if (db == 0.0) {
        printf("[FAIL] Failed to open Cognitive Memory DB\n");
        return 1.0;
    }

    // Ensure Rick is seeded in Domain 10
    sqlite_vec_set_user_attr(db, "User:Rick", "preferred_name", "Rick");
    sqlite_vec_set_user_attr(db, "User:Rick", "first_name", "Richard");
    sqlite_vec_set_user_attr(db, "User:Rick", "surname", "Weber");
    sqlite_vec_set_user_attr(db, "User:Rick", "role", "Creator & Architect");
    sqlite_vec_set_user_attr(db, "User:Rick", "relationship", "Father / Primary Creator");
    sqlite_vec_set_user_attr(db, "User:Rick", "pet", "Athena (dog)");
    sqlite_vec_set_user_attr(db, "User:Rick", "birthday", "May 14");
    sqlite_vec_set_user_attr(db, "User:Rick", "occupation", "Software Architect");
    sqlite_vec_set_user_attr(db, "User:Rick", "location", "Puget Sound");

    // =========================================================================
    // GATE 1: Minimal Preamble Length & Negative Bloat Suppression
    // =========================================================================
    printf("=== TEST GATE 1: Minimal Preamble Length & Bloat Suppression ===\n");

    // 1A. Verified User Preamble
    geomind_chat_set_active_user("User:Rick", 1.0);
    let pre_rick = geomind_chat_build_cognitive_preamble(db);
    let toks_rick = cartan_hub_encode_text_to_tokens(pre_rick);
    let len_rick = cartan_vec_len(toks_rick);
    cartan_vec_free(toks_rick);

    printf("  Verified User Preamble (Rick):\n\"%s\"\n", pre_rick);
    printf("  -> Token length: %.0f tokens (Threshold <= 30.0)\n", len_rick);

    if (len_rick > 30.0) {
        printf("[FAIL] Verified preamble exceeded 30 tokens: %.0f\n", len_rick);
        return 1.0;
    }
    if (cartan_string_contains(pre_rick, "Richard Weber") == 1.0 ||
        cartan_string_contains(pre_rick, "created by") == 1.0) {
        printf("[FAIL] Creator full attribution leaked into greeting preamble!\n");
        return 1.0;
    }
    if (cartan_string_contains(pre_rick, "[Interlocutor Profile:") == 1.0) {
        printf("[FAIL] Static interlocutor profile dump leaked into preamble!\n");
        return 1.0;
    }
    if (cartan_string_contains(pre_rick, "[Available Tools:") == 1.0) {
        printf("[FAIL] Static tool definition schema leaked into preamble!\n");
        return 1.0;
    }
    printf("[PASS] Gate 1A: Verified User Preamble is minimal and bloat-free (%.0f tokens <= 30).\n", len_rick);

    // 1B. Unverified Guest Preamble
    geomind_chat_set_active_user("User:Guest", 0.0);
    let pre_guest = geomind_chat_build_cognitive_preamble(db);
    let toks_guest = cartan_hub_encode_text_to_tokens(pre_guest);
    let len_guest = cartan_vec_len(toks_guest);
    cartan_vec_free(toks_guest);

    printf("  Unverified Guest Preamble:\n\"%s\"\n", pre_guest);
    printf("  -> Token length: %.0f tokens (Threshold <= 30.0)\n", len_guest);

    if (len_guest > 30.0) {
        printf("[FAIL] Guest preamble exceeded 30 tokens: %.0f\n", len_guest);
        return 1.0;
    }
    printf("[PASS] Gate 1B: Unverified Guest Preamble is minimal (%.0f tokens <= 30).\n\n", len_guest);

    // =========================================================================
    // GATE 2: Greeting Directives Format Compliance
    // =========================================================================
    printf("=== TEST GATE 2: Greeting Directives Format Compliance ===\n");

    if (cartan_string_contains(pre_rick, "Address Rick warmly by name.") == 0.0) {
        printf("[FAIL] Rick preamble missing directive to address by name.\n");
        return 1.0;
    }
    if (cartan_string_contains(pre_guest, "Introduce yourself warmly and ask their name.") == 0.0) {
        printf("[FAIL] Guest preamble missing directive to introduce and ask name.\n");
        return 1.0;
    }
    printf("[PASS] Gate 2: Greeting directives format verified for verified user and guest.\n\n");

    // Reset user to Rick for remaining tests
    geomind_chat_set_active_user("User:Rick", 1.0);

    // =========================================================================
    // GATE 3: Just-In-Time (JIT) Targeted User Attribute Retrieval
    // =========================================================================
    printf("=== TEST GATE 3: Just-In-Time (JIT) Targeted User Attribute Retrieval ===\n");

    // 3A. Pet Domain
    let jit_pet = geomind_chat_retrieve_jit_user_context(db, "User:Rick", "My dog is sick, what should I do?");
    printf("  Prompt: 'My dog is sick, what should I do?'\n  -> JIT Context: '%s'\n", jit_pet);
    if (cartan_string_contains(jit_pet, "Interlocutor's pet is Athena (dog)") == 0.0) {
        printf("[FAIL] Pet lookup failed to retrieve Athena (dog): '%s'\n", jit_pet);
        return 1.0;
    }

    // 3B. Birthday Domain
    let jit_bday = geomind_chat_retrieve_jit_user_context(db, "User:Rick", "When is my birthday?");
    printf("  Prompt: 'When is my birthday?'\n  -> JIT Context: '%s'\n", jit_bday);
    if (cartan_string_contains(jit_bday, "Interlocutor's birthday is May 14") == 0.0) {
        printf("[FAIL] Birthday lookup failed: '%s'\n", jit_bday);
        return 1.0;
    }

    // 3C. Occupation Domain
    let jit_job = geomind_chat_retrieve_jit_user_context(db, "User:Rick", "What is my job?");
    printf("  Prompt: 'What is my job?'\n  -> JIT Context: '%s'\n", jit_job);
    if (cartan_string_contains(jit_job, "Interlocutor's occupation is Software Architect") == 0.0) {
        printf("[FAIL] Occupation lookup failed: '%s'\n", jit_job);
        return 1.0;
    }

    // 3D. Location Domain
    let jit_loc = geomind_chat_retrieve_jit_user_context(db, "User:Rick", "Where do I live?");
    printf("  Prompt: 'Where do I live?'\n  -> JIT Context: '%s'\n", jit_loc);
    if (cartan_string_contains(jit_loc, "Interlocutor's location is Puget Sound") == 0.0) {
        printf("[FAIL] Location lookup failed: '%s'\n", jit_loc);
        return 1.0;
    }

    // 3E. Identity / Relationship Domain
    let jit_id = geomind_chat_retrieve_jit_user_context(db, "User:Rick", "Do you know who I am?");
    printf("  Prompt: 'Do you know who I am?'\n  -> JIT Context: '%s'\n", jit_id);
    if (cartan_string_contains(jit_id, "Interlocutor is Rick") == 0.0 ||
        cartan_string_contains(jit_id, "Father / Primary Creator") == 0.0) {
        printf("[FAIL] Identity JIT lookup failed: '%s'\n", jit_id);
        return 1.0;
    }

    // 3F. Negative Boundary (Unrelated prompt injects NOTHING)
    let jit_none = geomind_chat_retrieve_jit_user_context(db, "User:Rick", "What is the speed of light?");
    printf("  Prompt: 'What is the speed of light?'\n  -> JIT Context: '%s'\n", jit_none);
    if (cartan_string_length(jit_none) != 0.0) {
        printf("[FAIL] Unrelated prompt injected unexpected JIT context: '%s'\n", jit_none);
        return 1.0;
    }
    printf("[PASS] Gate 3: JIT Targeted User Attribute Retrieval verified across all domains.\n\n");

    // =========================================================================
    // GATE 4: Conditional Tool Schema Activation & Suppression
    // =========================================================================
    printf("=== TEST GATE 4: Conditional Tool Schema Activation & Suppression ===\n");

    // 4A. Conversational suppression (zero tool tokens)
    let req_conv1 = geomind_chat_requires_tool_definitions("Hello GeoMind!");
    let req_conv2 = geomind_chat_requires_tool_definitions("Do you know who I am?");
    let req_conv3 = geomind_chat_requires_tool_definitions("My dog is feeling ill.");
    if (req_conv1 != 0.0 || req_conv2 != 0.0 || req_conv3 != 0.0) {
        printf("[FAIL] Tool definitions activated on conversational prompts!\n");
        return 1.0;
    }
    printf("[PASS] Conversational prompts correctly suppress 176-token tool schema.\n");

    // 4B. Action prompt activation
    let req_tool1 = geomind_chat_requires_tool_definitions("Please read file src/main.car");
    let req_tool2 = geomind_chat_requires_tool_definitions("run command git status");
    let req_tool3 = geomind_chat_requires_tool_definitions("browse web https://google.com");
    let req_tool4 = geomind_chat_requires_tool_definitions("read screen to see my terminal");
    let req_tool5 = geomind_chat_requires_tool_definitions("list dir .");

    if (req_tool1 != 1.0 || req_tool2 != 1.0 || req_tool3 != 1.0 || req_tool4 != 1.0 || req_tool5 != 1.0) {
        printf("[FAIL] Tool intent failed to activate on tool action prompts!\n");
        return 1.0;
    }
    printf("[PASS] Tool action prompts correctly activate tool schema injection.\n");

    // 4C. Tool schema integrity
    let tools_str = geomind_chat_get_tool_definitions();
    if (cartan_string_contains(tools_str, "read_file") == 0.0 ||
        cartan_string_contains(tools_str, "exec_command") == 0.0 ||
        cartan_string_contains(tools_str, "browse_web") == 0.0 ||
        cartan_string_contains(tools_str, "read_screen") == 0.0) {
        printf("[FAIL] Standalone tool schema missing core tool signatures!\n");
        return 1.0;
    }
    printf("[PASS] Gate 4: Conditional tool schema gating and schema integrity verified.\n\n");

    // =========================================================================
    // GATE 5: Quantitative Prefill Reduction & Assembly Verification
    // =========================================================================
    printf("=== TEST GATE 5: Quantitative Prefill Reduction ===\n");

    // Measure prefill for pure conversational greeting "Hello"
    var sim_conv = pre_rick;
    sim_conv = cartan_string_concat(sim_conv, "\n");
    sim_conv = cartan_string_concat(sim_conv, "Hello");
    let toks_conv = cartan_hub_encode_text_to_tokens(sim_conv);
    let total_conv_tokens = cartan_vec_len(toks_conv);
    cartan_vec_free(toks_conv);

    printf("  Opening turn for 'Hello':\n  -> Assembled content:\n\"%s\"\n", sim_conv);
    printf("  -> Total content tokens: %.0f (Baseline was ~343 tokens)\n", total_conv_tokens);

    if (total_conv_tokens > 30.0) {
        printf("[FAIL] Conversational opening turn exceeded 30 tokens: %.0f\n", total_conv_tokens);
        return 1.0;
    }

    // Measure prefill for identity query "Do you know who I am?"
    var sim_id = pre_rick;
    sim_id = cartan_string_concat(sim_id, "\n");
    sim_id = cartan_string_concat(sim_id, jit_id);
    sim_id = cartan_string_concat(sim_id, "Do you know who I am?");
    let toks_id = cartan_hub_encode_text_to_tokens(sim_id);
    let total_id_tokens = cartan_vec_len(toks_id);
    cartan_vec_free(toks_id);

    printf("  Opening turn for 'Do you know who I am?':\n  -> Assembled content:\n\"%s\"\n", sim_id);
    printf("  -> Total content tokens: %.0f (Baseline was 351 tokens)\n", total_id_tokens);

    let drop_pct = ((351.0 - total_id_tokens) / 351.0) * 100.0;
    printf("  -> Empirical prefill reduction: %.1f%% drop!\n", drop_pct);

    if (drop_pct < 80.0) {
        printf("[FAIL] Prefill reduction was less than 80%%: %.1f%%\n", drop_pct);
        return 1.0;
    }

    printf("[PASS] Gate 5: Empirical prefill reduction verified (%.1f%% reduction, %.0f tokens vs 351 baseline).\n\n", drop_pct, total_id_tokens);

    printf(">>> ALL 5 GATES PASSED: Dynamic JIT Context Grounding & Minimal Prefill Verified! <<<\n");
    return 0.0;
}
