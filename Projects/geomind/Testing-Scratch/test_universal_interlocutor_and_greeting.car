// Projects/geomind/test_universal_interlocutor_and_greeting.car
// Dedicated verification suite for Sprint 535:
// Gate 1: LM Head Channel Token Masking (98, 100, 101, 9731)
// Gate 2: Robust Output Sanitization & Channel Thought Stripping
// Gate 3: Universal Interlocutor Recognition & Cognitive Preamble Assembly
// Gate 4: Dynamic Session Greeting Formatting
// Gate 5: End-to-End Consistency & Zero Leak Verification

fn sleep_detect_attractor_voids(basins_file: string, dim: float) -> float { return 0.0; }
fn cartan_tensor_train_step(hidden_ptr: ptr, target_tok_id: float, learning_rate: float) -> float { return 0.0; }

include "Projects/geomind/chat.cl";

fn main() -> float {
    printf("================================================================================\n");
    printf("  SPRINT 535: UNIVERSAL INTERLOCUTOR & CHANNEL THOUGHT SUPPRESSION TEST SUITE\n");
    printf("================================================================================\n\n");

    let db = geomind_chat_get_db();
    if (db == 0.0) {
        printf("[FAIL] Failed to open cognitive memory database.\n");
        return 1.0;
    }

    // =========================================================================
    // GATE 1: LM Head Channel Token Masking
    // =========================================================================
    printf("=== TEST GATE 1: LM Head Channel & Control Token Masking ===\n");
    cartan_flush(0.0);
    let test_logits = cartan_vec_create();
    var vi = 0.0;
    while (vi < 256.0) {
        cartan_vec_push_f32(test_logits, 5.0); // positive logit
        vi = vi + 1.0;
    }
    // Verify softcap native masking with authentic raw float buffers
    printf("Gate 1: Allocating test buffers...\n");
    cartan_flush(0.0);
    let dummy_emb = calloc(256.0 * 2560.0, 4.0);
    let dummy_h = calloc(2560.0, 4.0);
    printf("Gate 1: Calling cartan_compute_lm_head_softcap_native...\n");
    cartan_flush(0.0);
    cartan_compute_lm_head_softcap_native(dummy_h, dummy_emb, g_e8_ics, g_e8_vocab_mask, test_logits, 256.0, 2560.0, 30.0);
    printf("Gate 1: Returned from softcap native. Checking logits...\n");
    cartan_flush(0.0);

    let l_pad = cartan_vec_get_f32(test_logits, 0.0);
    let l_bos = cartan_vec_get_f32(test_logits, 2.0);
    let l_think = cartan_vec_get_f32(test_logits, 98.0);
    let l_chan_in = cartan_vec_get_f32(test_logits, 100.0);
    let l_chan_out = cartan_vec_get_f32(test_logits, 101.0);
    let l_turn = cartan_vec_get_f32(test_logits, 105.0);
    let l_eos = cartan_vec_get_f32(test_logits, 106.0);

    if (l_think > -9999.0 || l_chan_in > -9999.0 || l_chan_out > -9999.0) {
        printf("[FAIL] Channel tokens not masked in LM head: 98=%.1f, 100=%.1f, 101=%.1f\n",
            l_think, l_chan_in, l_chan_out);
        cartan_flush(0.0);
        return 1.0;
    }
    if (l_pad > -9999.0 || l_bos > -9999.0 || l_turn > -9999.0) {
        printf("[FAIL] Control tokens not masked: pad=%.1f, bos=%.1f, turn=%.1f\n",
            l_pad, l_bos, l_turn);
        cartan_flush(0.0);
        return 1.0;
    }
    // EOS (106) must remain unmasked for clean turn termination
    if (l_eos < -9999.0) {
        printf("[FAIL] EOS token 106 was accidentally masked!\n");
        cartan_flush(0.0);
        return 1.0;
    }
    printf("[PASS] Control and channel tokens (98, 100, 101, 105) masked to -10000.0; EOS (106) preserved.\n\n");
    cartan_flush(0.0);
    cartan_vec_free(test_logits);
    free(dummy_h);
    free(dummy_emb);

    // =========================================================================
    // GATE 2: Robust Output Sanitization & Channel Stripping
    // =========================================================================
    printf("=== TEST GATE 2: Robust Output Sanitization & Channel Stripping ===\n");

    // Case 2A: Full channel thought block with closing tags
    let raw_sample1 = "<|channel>thought gwrl_internal / private thought structure. User asked who are. The user profile is about to be reinforced.</body></html>\nHello Rick! Yes, I know you are Richard Weber, my creator and architect.";
    let clean1 = geomind_sanitize_output_for_display(raw_sample1);
    if (cartan_string_contains(clean1, "gwrl_internal") == 1.0 ||
        cartan_string_contains(clean1, "<|channel>") == 1.0 ||
        cartan_string_contains(clean1, "</body></html>") == 1.0) {
        printf("[FAIL] Channel thoughts or tags leaked in sanitized output: '%s'\n", clean1);
        return 1.0;
    }
    if (cartan_string_starts_with(clean1, "Hello Rick! Yes, I know you are") == 0.0) {
        printf("[FAIL] User text corrupted after channel strip: '%s'\n", clean1);
        return 1.0;
    }
    printf("[PASS] Channel thought block stripped cleanly; conversational text preserved.\n");

    // Case 2B: Unclosed channel thought truncated at EOF
    let raw_sample2 = "<|channel>thought truncated thought stream that hits token horizon without close tag";
    let clean2 = geomind_sanitize_output_for_display(raw_sample2);
    if (cartan_string_length(clean2) > 0.0) {
        printf("[FAIL] Unclosed channel thought at EOF was not truncated: '%s'\n", clean2);
        return 1.0;
    }
    printf("[PASS] Unclosed channel thought at EOF truncated cleanly with zero leaks.\n");

    // Case 2C: Trimming whitespace
    let untrimmed = "   \n\t  Hello World!   \n ";
    let trimmed = geomind_string_trim(untrimmed);
    if (cartan_string_eq(trimmed, "Hello World!") == 0.0) {
        printf("[FAIL] String trim failed: '%s'\n", trimmed);
        return 1.0;
    }
    printf("[PASS] String whitespace trimming verified.\n\n");

    // =========================================================================
    // GATE 3: Universal Interlocutor Recognition & Preamble Assembly
    // =========================================================================
    printf("=== TEST GATE 3: Universal Interlocutor Recognition & Preamble Assembly ===\n");

    // Test 3A: Rick (Creator & Architect)
    geomind_chat_set_active_user("User:Rick", 1.0);
    let pre_rick = geomind_chat_build_cognitive_preamble(db);
    if (cartan_string_contains(pre_rick, "Identity: GeoMind") == 0.0) {
        printf("[FAIL] Preamble missing identity declaration.\n");
        return 1.0;
    }
    if (cartan_string_contains(pre_rick, "Address Rick") == 0.0) {
        printf("[FAIL] Preamble missing directive to address Rick by name.\n");
        return 1.0;
    }
    if (cartan_string_contains(pre_rick, "experimental frontier AI model") == 1.0) {
        printf("[FAIL] Preamble still contains refusal trigger phrase!\n");
        return 1.0;
    }
    printf("[PASS] Verified creator preamble correctly grounded with direct identity directives.\n");

    // Test 3B: Enrolled User (e.g. User:Sarah)
    sqlite_vec_set_user_attr(db, "User:Sarah", "preferred_name", "Sarah");
    sqlite_vec_set_user_attr(db, "User:Sarah", "role", "Research Scientist");
    sqlite_vec_set_user_attr(db, "User:Sarah", "relationship", "Collaborator");
    geomind_chat_set_active_user("User:Sarah", 1.0);
    let pre_sarah = geomind_chat_build_cognitive_preamble(db);
    if (cartan_string_contains(pre_sarah, "Address Sarah") == 0.0) {
        printf("[FAIL] Preamble missing directive to address Sarah by name.\n");
        return 1.0;
    }
    printf("[PASS] Dynamic preamble adapts universally to enrolled interlocutor Sarah.\n");

    // Test 3C: Unverified Guest
    geomind_chat_set_active_user("User:Guest", 0.0);
    let pre_guest = geomind_chat_build_cognitive_preamble(db);
    if (cartan_string_contains(pre_guest, "Unverified Guest") == 0.0) {
        printf("[FAIL] Preamble did not handle unverified guest properly: '%s'\n", pre_guest);
        return 1.0;
    }
    printf("[PASS] Unverified guest preamble instructs model to greet and invite introduction.\n\n");

    // Reset active user to Rick for subsequent tests
    geomind_chat_set_active_user("User:Rick", 1.0);

    // =========================================================================
    // GATE 4: Dynamic Session Greeting Formatting
    // =========================================================================
    printf("=== TEST GATE 4: Dynamic Session Greeting Formatting ===\n");
    let active_user = geomind_chat_get_active_user();
    var pref_name = sqlite_vec_get_user_attr(db, active_user, "preferred_name");
    if (cartan_string_length(pref_name) == 0.0) { pref_name = active_user; }

    var expected_greeting = "Hello ";
    expected_greeting = cartan_string_concat(expected_greeting, pref_name);
    expected_greeting = cartan_string_concat(expected_greeting, "! Great to see you. How can I assist you today?");

    if (cartan_string_contains(expected_greeting, "Hello Rick!") == 0.0) {
        printf("[FAIL] Greeting format mismatch: '%s'\n", expected_greeting);
        return 1.0;
    }
    printf("[PASS] Personalized session greeting format verified: '%s'\n\n", expected_greeting);

    // =========================================================================
    // GATE 5: Conversational Learning of New Interlocutor
    // =========================================================================
    printf("=== TEST GATE 5: Conversational Learning of New Interlocutor ===\n");
    geomind_chat_set_active_user("User:Guest", 0.0);
    let learn_res = geomind_chat_learn_conversational_turn("user", "Hello! My name is Alexander and I am an astrophysicist.");
    if (learn_res <= 0.0) {
        printf("[FAIL] Failed to learn interlocutor name from conversational turn.\n");
        return 1.0;
    }
    let alex_fn = sqlite_vec_get_user_attr(db, "User:Alexander", "first_name");
    if (cartan_string_eq(alex_fn, "Alexander") == 0.0) {
        printf("[FAIL] User:Alexander not registered in Domain 10: first_name='%s'\n", alex_fn);
        return 1.0;
    }
    if (geomind_chat_is_user_verified() == 0.0) {
        printf("[FAIL] Interlocutor was not promoted to verified state after introducing self.\n");
        return 1.0;
    }
    let pre_alex = geomind_chat_build_cognitive_preamble(db);
    if (cartan_string_contains(pre_alex, "Alexander") == 0.0) {
        printf("[FAIL] Preamble did not immediately incorporate newly learned interlocutor: '%s'\n", pre_alex);
        return 1.0;
    }
    printf("[PASS] Interlocutor dynamically learned from dialogue, registered in Domain 10, and incorporated into preamble.\n\n");

    // Clean up test users
    sqlite_vec_delete_entity_state(db, 10.0, "User:Sarah");
    sqlite_vec_delete_entity_state(db, 10.0, "User:Alexander");
    geomind_chat_set_active_user("User:Rick", 1.0);

    printf(">>> ALL 5 GATES PASSED: Universal interlocutor recognition & channel suppression verified! <<<\n");
    cartan_flush(0.0);
    return 0.0;
}
