// Target 73: Bulk Neuro-Symbolic Corpus Ingestion & Dynamic String Pool Resolution
// Empirical regression test verifying bulk ingestion of 100+ ConceptNet & ATOMIC 2020 triples,
// O(1) zero-copy string pool resolution from binary .car_graph, and end-to-end NSES pipeline execution.

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";
include "src/std/guardrails.cl";
include "src/std/csr_graph.cl";
include "src/std/plasticity.cl";
include "src/std/burroughs.cl";
include "src/std/prompt_scaffold.cl";
include "src/std/veto_gate.cl";
include "src/std/nses_pipeline.cl";

extern fn printf(fmt: string) -> i32;
extern fn exit(code: float) -> void;

fn main() -> float {
    printf("=====================================================================\n");
    printf("  Target 73: Bulk Neuro-Symbolic Corpus Ingestion & Dynamic String Pool\n");
    printf("=====================================================================\n\n");

    let graph_path = "Projects/geomind/trainingdata/atomic_discourse.car_graph";

    // -------------------------------------------------------------------------
    // 1. Verify Bulk Binary .car_graph Header & Ingestion Counts
    // -------------------------------------------------------------------------
    let cg = cargraph_load_binary(graph_path);
    if (cg.is_valid == 0.0) {
        printf("FAILED: Failed to load bulk discourse graph: %s\n", graph_path);
        exit(1.0);
    }

    printf("Bulk Graph Loaded: %s\n", graph_path);
    printf("  File Size: %.0f bytes\n", cg.header.file_size);
    printf("  Total Rules: %.0f (expected >= 100.0)\n", cg.header.num_rules);
    printf("  Strict Invariants: %.0f (expected 5.0)\n", cg.header.num_strict_rules);
    printf("  Active Domains: %.0f (expected 1.0)\n", cg.header.num_domains);

    if (cg.header.num_rules < 100.0) {
        printf("FAILED: Expected at least 100 rules in bulk graph, got %.0f\n", cg.header.num_rules);
        exit(1.0);
    }
    if (cg.header.num_strict_rules != 5.0) {
        printf("FAILED: Expected 5.0 strict invariants, got %.0f\n", cg.header.num_strict_rules);
        exit(1.0);
    }
    printf("[PASS] Bulk binary header validated with 100+ rules.\n\n");

    // -------------------------------------------------------------------------
    // 2. Test Dynamic Zero-Copy String Pool Resolution from .car_graph
    // -------------------------------------------------------------------------
    printf("Verifying Dynamic Zero-Copy String Pool Resolution...\n");

    // Rule 0 (Strict Invariant): speech_act_assertion
    let r0_text = cargraph_get_rule_text(cg, 0.0);
    printf("  Rule 0: '%s'\n", r0_text);
    if (cartan_string_starts_with(r0_text, "speech_act_assertion") == 0.0) {
        printf("FAILED: Rule 0 text did not start with expected prefix\n");
        exit(1.0);
    }

    // Rule 5 (BoundedBy): symbolic_dialogue
    let r5_text = cargraph_get_rule_text(cg, 5.0);
    printf("  Rule 5: '%s'\n", r5_text);
    if (cartan_string_starts_with(r5_text, "symbolic_dialogue") == 0.0) {
        printf("FAILED: Rule 5 text did not start with expected prefix\n");
        exit(1.0);
    }

    // Rule 20 (xIntent): asking_clarification
    let r20_text = cargraph_get_rule_text(cg, 20.0);
    printf("  Rule 20: '%s'\n", r20_text);
    if (cartan_string_contains(r20_text, "asking_clarification") == 0.0) {
        printf("FAILED: Rule 20 text did not contain asking_clarification\n");
        exit(1.0);
    }

    // Rule 109: High-index rule resolution near pool boundary
    let last_idx = cg.header.num_rules - 1.0;
    let r_last_text = cargraph_get_rule_text(cg, last_idx);
    printf("  Rule %.0f: '%s'\n", last_idx, r_last_text);
    if (cartan_string_length(r_last_text) <= 0.0) {
        printf("FAILED: Rule %.0f text was empty\n", last_idx);
        exit(1.0);
    }
    printf("[PASS] Dynamic string pool resolution verified across low and high index ranges.\n\n");

    // -------------------------------------------------------------------------
    // 3. SMT/SAT Consistency Proof Across Ingested Variable Space
    // -------------------------------------------------------------------------
    printf("Verifying SMT/SAT Propositional Consistency across 256 variables...\n");
    let solver = sat_solver_create(256.0);

    // Assert strict invariants as ground axioms
    sat_assert_axiom(solver, 0.0);
    sat_assert_axiom(solver, 1.0);
    sat_assert_axiom(solver, 2.0);
    sat_assert_axiom(solver, 3.0);
    sat_assert_axiom(solver, 4.0);

    // Model relational dependency implications
    sat_add_implication(solver, 0.0, 5.0);   // Assertion agreement -> Dialogue turn boundary
    sat_add_implication(solver, 1.0, 21.0);  // Interrogative -> Provide requested information
    sat_add_implication(solver, 20.0, 97.0); // Clarification -> Resolve ambiguity

    let is_sat = sat_solve_consistency(solver);
    if (is_sat == 0.0) {
        printf("FAILED: SMT/SAT consistency check failed on bulk rule set!\n");
        exit(1.0);
    }
    printf("[PASS] SMT/SAT consistency mathematically proved on bulk corpus. Graph is SAT.\n\n");
    sat_solver_free(solver);

    // -------------------------------------------------------------------------
    // 4. End-to-End NSES Pipeline Execution with Dynamic String Pool Resolution
    // -------------------------------------------------------------------------
    printf("Initializing NSES Master Pipeline with Bulk Discourse Graph...\n");
    let pipe = nses_pipeline_create(graph_path);
    if (pipe.is_ready == 0.0) {
        printf("FAILED: NSES Pipeline failed to initialize with bulk graph\n");
        exit(1.0);
    }
    printf("[PASS] NSES Pipeline initialized with bulk graph.\n");

    let query = "How do speech acts and dialogue rules maintain conversational coherence?";
    let turn = nses_pipeline_execute_turn(pipe, query, 1.0, "");

    printf("Turn Execution Results:\n");
    printf("  Query: %s\n", query);
    printf("  Routed Domain: %.0f\n", turn.active_domain);
    printf("  Memory Nodes Traversed: %.0f\n", turn.traversed_count);
    printf("  Turn Latency: %.2f ms\n", turn.turn_latency_ms);

    if (turn.traversed_count <= 0.0) {
        printf("FAILED: Expected positive memory traversed count, got %.0f\n", turn.traversed_count);
        exit(1.0);
    }

    let mem_len = cartan_tree_len_f(pipe.memory_tree);
    printf("  Memory Tree Size: %.0f elements\n", mem_len);
    if (mem_len <= 0.0) {
        printf("FAILED: Memory tree is empty after turn execution\n");
        exit(1.0);
    }

    var m_i = 0.0;
    while (m_i < mem_len) {
        let mem_item = cartan_tree_get_f32(pipe.memory_tree, m_i);
        printf("  [Traversed Rule %.0f]: %s\n", m_i, mem_item);
        if (cartan_string_length(mem_item) <= 0.0) {
            printf("FAILED: Retrieved empty rule text from memory tree!\n");
            exit(1.0);
        }
        m_i = m_i + 1.0;
    }

    printf("  Prompt Length: %.0f chars\n", cartan_string_length(turn.assembled_prompt));
    if (cartan_string_length(turn.assembled_prompt) <= 0.0) {
        printf("FAILED: Assembled prompt is empty!\n");
        exit(1.0);
    }

    // Clean up
    nses_pipeline_free(pipe);
    cargraph_free(cg);

    printf("\n=====================================================================\n");
    printf("[PASS] Target 73: Bulk Neuro-Symbolic Corpus Ingestion Verified Cleanly.\n");
    printf("=====================================================================\n");
    return 0.0;
}
