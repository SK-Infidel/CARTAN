// test/compiler_suite/test_doubt_reflective_rewind.car
// Target [62/62]: Verification of Reflective Skepticism, Doubt Verification (`doubt { }`),
// Authentic Softmax Confidence, Shannon Entropy, and Adaptive Tangent Bundle Context Rewind.

include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/math.cl";
include "src/std/reasoning.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main() -> float {
    printf("=================================================================================\n");
    printf("  CARTAN TEST SUITE: REFLECTIVE DOUBT & ADAPTIVE CONTEXT REWIND (TARGET 62)\n");
    printf("=================================================================================\n\n");

    // [1/5] Native doubt { } Language Block Execution
    printf("[1/5] Verifying Native doubt { } Block Language Syntax & Scope Hooks...\n");
    let pre_active = cartan_doubt_is_active();
    cartan_assert(pre_active == 0.0, "Doubt scope must be inactive before entering doubt block");

    var inside_tested = 0.0;
    doubt {
        let inside_active = cartan_doubt_is_active();
        cartan_assert(inside_active == 1.0, "cartan_doubt_is_active() must return 1.0 inside doubt { } block");
        inside_tested = 1.0;
    }
    cartan_assert(inside_tested == 1.0, "Inner doubt { } statements must execute cleanly");

    let post_active = cartan_doubt_is_active();
    cartan_assert(post_active == 0.0, "Doubt scope must be deactivated after exiting doubt block");
    printf("  -> [PASS] Native doubt { } block entered, executed, and exited with active scope lifecycle.\n\n");

    // [2/5] Authentic Softmax Top-1 Confidence & Shannon Entropy Calculation
    printf("[2/5] Verifying Authentic Softmax Top-1 Confidence & Shannon Entropy...\n");
    let peaked_logits = cartan_vec_create();
    var idx = 0.0;
    while (idx < 50.0) {
        if (idx == 7.0) {
            cartan_vec_push_f32(peaked_logits, 20.0);
        } else {
            cartan_vec_push_f32(peaked_logits, -5.0);
        }
        idx = idx + 1.0;
    }

    let peaked_conf = cartan_tensor_compute_confidence(peaked_logits, 50.0);
    let peaked_ent = cartan_doubt_get_last_entropy();
    printf("  -> Peaked Distribution: Top-1 Prob = %s | Shannon Entropy = %s\n",
        cartan_float_to_string(peaked_conf), cartan_float_to_string(peaked_ent));
    cartan_assert(peaked_conf > 0.99, "Peaked logit distribution must have top-1 confidence > 0.99");
    cartan_assert(peaked_ent < 0.05, "Peaked logit distribution must have Shannon entropy < 0.05");

    let uniform_logits = cartan_vec_create();
    idx = 0.0;
    while (idx < 50.0) {
        cartan_vec_push_f32(uniform_logits, 2.0);
        idx = idx + 1.0;
    }

    let uniform_conf = cartan_tensor_compute_confidence(uniform_logits, 50.0);
    let uniform_ent = cartan_doubt_get_last_entropy();
    printf("  -> Uniform Distribution: Top-1 Prob = %s | Shannon Entropy = %s\n",
        cartan_float_to_string(uniform_conf), cartan_float_to_string(uniform_ent));
    cartan_assert(uniform_conf < 0.05, "Uniform logit distribution (K=50) must have top-1 confidence < 0.05");
    cartan_assert(uniform_ent > 3.5, "Uniform logit distribution (K=50) must have Shannon entropy > 3.5");

    cartan_assert(peaked_conf > uniform_conf, "Peaked confidence must strictly exceed uniform confidence");
    cartan_assert(peaked_ent < uniform_ent, "Peaked entropy must strictly be lower than uniform entropy");
    printf("  -> [PASS] Mathematical confidence and entropy differentiation verified.\n\n");

    // [3/5] 2560-D Tangent Bundle State Checkpoint Fidelity
    printf("[3/5] Verifying 2560-D Manifold Hidden State & Momentum Checkpoint Fidelity...\n");
    let h_orig = cartan_vec_create();
    let mom_orig = cartan_vec_create();
    let hist_orig = cartan_vec_create();

    var d = 0.0;
    while (d < 2560.0) {
        let v_h = sin(d * 0.02);
        let v_m = cos(d * 0.03);
        cartan_vec_push_f32(h_orig, v_h);
        cartan_vec_push_f32(mom_orig, v_m);
        d = d + 1.0;
    }
    cartan_vec_push_f32(hist_orig, 101.0);
    cartan_vec_push_f32(hist_orig, 202.0);
    cartan_vec_push_f32(hist_orig, 303.0);

    let chk_status = cartan_doubt_checkpoint(h_orig, mom_orig, hist_orig, 3.0, 0.70);
    cartan_assert(chk_status == 1.0, "cartan_doubt_checkpoint must return 1.0 on success");

    // Mutate and perturb state
    d = 0.0;
    while (d < 2560.0) {
        cartan_vec_set_f32(h_orig, d, 999.0);
        cartan_vec_set_f32(mom_orig, d, -999.0);
        d = d + 1.0;
    }
    cartan_vec_push_f32(hist_orig, 404.0);
    cartan_vec_push_f32(hist_orig, 505.0);

    // Rewind back to checkpoint
    let restored_count = cartan_doubt_rewind(h_orig, mom_orig, hist_orig);
    cartan_assert(restored_count == 3.0, "cartan_doubt_rewind must restore token count to 3.0");
    let restored_hist_len = cartan_vec_len(hist_orig);
    cartan_assert(restored_hist_len == 3.0, "Restored history vector length must be 3.0");

    // Check high-precision fidelity across multiple manifold coordinates
    let check_dims = cartan_vec_create();
    cartan_vec_push_f32(check_dims, 0.0);
    cartan_vec_push_f32(check_dims, 42.0);
    cartan_vec_push_f32(check_dims, 128.0);
    cartan_vec_push_f32(check_dims, 512.0);
    cartan_vec_push_f32(check_dims, 1024.0);
    cartan_vec_push_f32(check_dims, 2559.0);

    var c_idx = 0.0;
    while (c_idx < cartan_vec_len(check_dims)) {
        let dim_idx = cartan_vec_get_f32(check_dims, c_idx);
        let expected_h = sin(dim_idx * 0.02);
        let expected_m = cos(dim_idx * 0.03);
        let actual_h = cartan_vec_get_f32(h_orig, dim_idx);
        let actual_m = cartan_vec_get_f32(mom_orig, dim_idx);

        var diff_h = actual_h - expected_h;
        if (diff_h < 0.0) { diff_h = 0.0 - diff_h; }
        var diff_m = actual_m - expected_m;
        if (diff_m < 0.0) { diff_m = 0.0 - diff_m; }

        cartan_assert(diff_h < 0.0001, "Restored h coordinate must match original value within 1e-4");
        cartan_assert(diff_m < 0.0001, "Restored mom coordinate must match original value within 1e-4");
        c_idx = c_idx + 1.0;
    }
    printf("  -> [PASS] 2560-D manifold coordinates and token history restored with exact fidelity.\n\n");

    // [4/5] Pure Cartan Standard Library API (src/std/reasoning.cl)
    printf("[4/5] Verifying Pure Cartan Standard Library Reasoning & Doubt API...\n");
    let std_conf = doubt_evaluate_confidence(peaked_logits, 50.0);
    let std_ent = doubt_evaluate_entropy(peaked_logits, 50.0);
    cartan_assert(std_conf > 0.99, "doubt_evaluate_confidence must match peaked confidence > 0.99");
    cartan_assert(std_ent < 0.05, "doubt_evaluate_entropy must match peaked entropy < 0.05");

    let rewind_needed = doubt_should_rewind_threshold(0.01, 0.05, 8.0, 7.0);
    cartan_assert(rewind_needed == 1.0, "doubt_should_rewind_threshold must trigger when conf < min or ent > max");
    let flag_active = cartan_doubt_should_rewind();
    cartan_assert(flag_active == 1.0, "cartan_doubt_should_rewind must report triggered state");
    cartan_doubt_clear_rewind();
    cartan_assert(cartan_doubt_should_rewind() == 0.0, "cartan_doubt_clear_rewind must reset trigger");
    printf("  -> [PASS] Pure Cartan standard library reasoning functions verified.\n\n");

    // [5/5] End-to-End Adaptive Context Rewind Lifecycle
    printf("[5/5] Verifying End-to-End Autoregressive Rewind & Temperature Cooling...\n");
    let h_sim = cartan_vec_create();
    let m_sim = cartan_vec_create();
    let hist_sim = cartan_vec_create();
    var s = 0.0;
    while (s < 2560.0) {
        cartan_vec_push_f32(h_sim, 1.0);
        cartan_vec_push_f32(m_sim, 0.5);
        s = s + 1.0;
    }

    var temp = 0.70;
    doubt_checkpoint(h_sim, m_sim, hist_sim, 0.0, temp);

    var step = 0.0;
    var rewind_done = 0.0;
    var total_emitted = 0.0;

    while (step < 6.0) {
        if (step == 2.0 && rewind_done == 0.0) {
            // Simulate uncertainty spike triggering doubt rewind
            printf("  -> [Simulation] Uncertainty spike at step %s! Initiating reflective context rewind...\n",
                cartan_float_to_string(step));
            step = doubt_rewind(h_sim, m_sim, hist_sim);
            temp = temp * 0.75;
            rewind_done = 1.0;
            printf("  -> [Simulation] Context rewound to step %s, temperature cooled to %s.\n",
                cartan_float_to_string(step), cartan_float_to_string(temp));
        } else {
            cartan_vec_push_f32(hist_sim, 1000.0 + step);
            step = step + 1.0;
            total_emitted = total_emitted + 1.0;
        }
    }

    cartan_assert(rewind_done == 1.0, "Rewind must execute during generation loop");
    cartan_assert(temp < 0.55, "Temperature must be cooled following rewind pass");
    cartan_assert(cartan_vec_len(hist_sim) == 6.0, "Final history length must equal 6 tokens");
    printf("  -> [PASS] End-to-end adaptive context rewind and temperature cooling loop verified.\n\n");

    printf("=================================================================================\n");
    printf("  TARGET 62 SUMMARY: ALL 5/5 REFLECTIVE DOUBT & REWIND ASSERTIONS PASSED\n");
    printf("=================================================================================\n");
    return 0.0;
}
