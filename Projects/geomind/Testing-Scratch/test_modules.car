// Sprint 4 Test Target: Structured Module System (mod, pub, use)

include "src/cartanc/ast.ch";

mod math;
use math;

pub fn calculate_sum(a: float, b: float) -> float {
    return a + b;
}

fn main() -> float {
    let result = calculate_sum(10.0, 20.0);
    return 0.0;
}
