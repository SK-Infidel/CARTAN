// test/compiler_suite/test_read_line.car
extern fn printf(fmt: string) -> float;
extern fn cartan_read_line() -> string;
extern fn cartan_flush(v: float) -> float;

fn main(argc: float, argv: ptr) -> float {
    printf("Prompt> ");
    cartan_flush(0.0);
    let line = cartan_read_line();
    printf("You typed: ");
    printf(line);
    printf("\n");
    return 0.0;
}
