// test/compiler_suite/test_webgpu_compute.car
// // run-pass
// Sprint 251 WebGPU Compute Engine Test Target

include "../../src/std/gpu.cl";

extern fn printf(fmt: string, val: float) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> void;
extern fn cartan_tree_create() -> ptr;
extern fn cartan_tree_push(t: ptr, item: ptr) -> void;

fn main() -> float {
    printf("Initializing WebGPU Compute Engine...\n", 0.0);
    let init_res = gpu_init();
    cartan_assert(init_res == 1.0, "WebGPU hardware initialization failed!");

    let N = 64.0;
    let size_bytes = N * 4.0;

    // Allocate host memory buffers
    let host_in_a = cartan_f32_buffer_alloc(N);
    let host_in_b = cartan_f32_buffer_alloc(N);
    let host_out = cartan_f32_buffer_alloc(N);

    // Populate input data
    var i = 0.0;
    while (i < N) {
        cartan_f32_buffer_set(host_in_a, i, i * 2.0);
        cartan_f32_buffer_set(host_in_b, i, 10.0);
        i = i + 1.0;
    }

    // Allocate GPU storage buffers
    let buf_a = gpu_alloc(size_bytes);
    let buf_b = gpu_alloc(size_bytes);
    let buf_out = gpu_alloc(size_bytes);

    // Upload to VRAM
    gpu_write(buf_a, host_in_a, size_bytes);
    gpu_write(buf_b, host_in_b, size_bytes);

    // WGSL compute shader for vector add & scale: out[i] = a[i] * b[i] + 5.0
    let wgsl = "@group(0) @binding(0) var<storage, read_write> in_a: array<f32>;\n@group(0) @binding(1) var<storage, read_write> in_b: array<f32>;\n@group(0) @binding(2) var<storage, read_write> out_c: array<f32>;\n\n@compute @workgroup_size(64, 1, 1)\nfn vec_fma(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_id) lid: vec3<u32>) {\n    let idx = gid.x;\n    out_c[idx] = in_a[idx] * in_b[idx] + 5.0;\n}\n";

    let pipe = gpu_create_pipeline(wgsl, "vec_fma");

    // Package buffers for dispatch
    let buffers = cartan_tree_create();
    cartan_tree_push(buffers, buf_a);
    cartan_tree_push(buffers, buf_b);
    cartan_tree_push(buffers, buf_out);

    // Dispatch compute grid across 64 invocations
    gpu_dispatch(pipe, buffers, 3.0, N, 1.0, 1.0);
    gpu_sync();

    // Read back results from VRAM
    gpu_read(buf_out, host_out, size_bytes);

    // Verify mathematical operations on real GPU hardware
    var check_idx = 0.0;
    while (check_idx < N) {
        let expected = (check_idx * 2.0) * 10.0 + 5.0;
        let actual = cartan_f32_buffer_get(host_out, check_idx);
        cartan_assert(actual == expected, "GPU calculation mismatch!");
        check_idx = check_idx + 1.0;
    }

    printf("WebGPU Hardware Compute Test Passed Cleanly! Output verified across %f elements.\n", N);
    cartan_flush(0.0);

    cartan_f32_buffer_free(host_in_a);
    cartan_f32_buffer_free(host_in_b);
    cartan_f32_buffer_free(host_out);

    return 0.0;
}
