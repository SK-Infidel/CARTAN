// Target 78: NSES Epistemology, Belief Revision & Probabilistic Reasoning Domain (Domain 9) Regression Test
// Empirical regression test verifying:
// 1. Ingestion of Domain 9 (EPISTEMOLOGY_BELIEF) into .car_graph with >= 10 domains, >= 82 rules, >= 20 strict invariants.
// 2. Exact rule text retrieval for Domain 9 Bayesian and AGM invariants.
// 3. Stage 1 epistemic query intent routing and CSR Deductive-Epistemic-Decision bridge traversal (Rule 72 -> Rule 74, Rule 54 -> Rule 75 -> Rule 77).
// 4. Epistemic fallacy veto detection (Rule 12: Dogmatic priors, confirmation bias, base rate neglect) and logit suppression (901-904).
// 5. Cross-domain lexicon verification for Domain 9 terms and discourse framing.
// 6. Training dataset routing for epistemic and probabilistic reasoning corpora.

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";
include "src/std/guardrails.cl";
include "src/std/csr_graph.cl";
include "src/std/plasticity.cl";
include "src/std/burroughs.cl";
include "src/std/prompt_scaffold.cl";
include "src/std/veto_gate.cl";
include "src/std/domain_lexicon.cl";
include "src/std/nses_pipeline.cl";
include "src/std/saliency_attractor.cl";
include "src/std/resonator.cl";

extern fn printf(fmt: string) -> i32;
extern fn exit(code: float) -> void;

fn main() -> float {
    printf("=====================================================================\n");
    printf("  Target 78: NSES Epistemology, Belief Revision & Probabilistic Domain (Domain 9)\n");
    printf("=====================================================================\n\n");

    let graph_path = "Projects/geomind/trainingdata/nses_knowledge.car_graph";
    let cg = cargraph_load_binary(graph_path);
    if (cg.is_valid == 0.0) {
        printf("FAILED: Could not load knowledge graph at: %s\n", graph_path);
        exit(1.0);
    }
    printf("[PASS] Loaded knowledge graph from: %s\n", graph_path);

    // -------------------------------------------------------------------------
    // 1. Verify Knowledge Graph Header & Domain 9 Metrics
    // -------------------------------------------------------------------------
    printf("Verifying Knowledge Base Domain 9 Structure...\n");
    printf("  Total Domains: %.0f (expected >= 10)\n", cg.header.num_domains);
    printf("  Total Rules: %.0f (expected >= 82)\n", cg.header.num_rules);
    printf("  Strict Invariants: %.0f (expected >= 20)\n", cg.header.num_strict_rules);

    if (cg.header.num_domains < 10.0 || cg.header.num_rules < 82.0 || cg.header.num_strict_rules < 20.0) {
        printf("FAILED: Domain 9 header counts mismatch\n");
        exit(1.0);
    }

    // Verify Domain 9 strict invariants and rules
    let rule72 = cargraph_get_rule_text(cg, 72.0); // Bayesian Posterior Invariant
    let rule73 = cargraph_get_rule_text(cg, 73.0); // AGM Minimal Information Loss Invariant
    let rule74 = cargraph_get_rule_text(cg, 74.0); // Likelihood Evidence Ratio
    let rule75 = cargraph_get_rule_text(cg, 75.0); // Defeasible Default Inference
    let rule76 = cargraph_get_rule_text(cg, 76.0); // Occam Model Selection
    let rule77 = cargraph_get_rule_text(cg, 77.0); // POMDP Epistemic State Estimation
    let rule80 = cargraph_get_rule_text(cg, 80.0); // Bayesian Confirmation Holism

    printf("  Rule 72: %s\n", rule72);
    printf("  Rule 73: %s\n", rule73);
    printf("  Rule 74: %s\n", rule74);
    printf("  Rule 75: %s\n", rule75);
    printf("  Rule 76: %s\n", rule76);
    printf("  Rule 77: %s\n", rule77);
    printf("  Rule 80: %s\n", rule80);

    if (cartan_string_contains(rule72, "Bayesian Posterior Invariant") == 0.0 ||
        cartan_string_contains(rule73, "AGM Minimal Information Loss") == 0.0 ||
        cartan_string_contains(rule74, "Likelihood Evidence Ratio") == 0.0 ||
        cartan_string_contains(rule75, "Defeasible Default Inference") == 0.0 ||
        cartan_string_contains(rule76, "Occam Model Selection") == 0.0 ||
        cartan_string_contains(rule77, "POMDP Epistemic State Estimation") == 0.0 ||
        cartan_string_contains(rule80, "Bayesian Confirmation Holism") == 0.0) {
        printf("FAILED: Domain 9 rule text content verification failed\n");
        exit(1.0);
    }
    printf("[PASS] Domain 9 knowledge rules verified.\n\n");

    // -------------------------------------------------------------------------
    // 2. Verify Pipeline Creation & Stage 1 Epistemic Intent Routing
    // -------------------------------------------------------------------------
    printf("Verifying Stage 1 Intent Routing for Domain 9...\n");
    let pipe = nses_pipeline_create(graph_path);
    if (pipe.is_ready == 0.0) {
        printf("FAILED: NSES Pipeline failed to initialize\n");
        exit(1.0);
    }

    let epistemic_query = "How does incoming evidence update our prior credence under Bayes rule and defeasible belief revision?";
    let turn = nses_pipeline_execute_turn(pipe, epistemic_query, 1.0, "Posterior belief updates through likelihood ratio and prior probability.");

    printf("  Query: %s\n", epistemic_query);
    printf("  Active Domain: %.0f (expected 9.0)\n", turn.active_domain);
    printf("  Traversed Rules Count: %.0f\n", turn.traversed_count);

    if (turn.active_domain != 9.0) {
        printf("FAILED: Expected query to route to Domain 9 (EPISTEMOLOGY_BELIEF), got %.0f\n", turn.active_domain);
        exit(1.0);
    }
    if (turn.traversed_count <= 0.0) {
        printf("FAILED: Traversal produced zero memory rules for Domain 9\n");
        exit(1.0);
    }

    // -------------------------------------------------------------------------
    // 3. Verify CSR Deductive-Epistemic Bridge Traversal
    // -------------------------------------------------------------------------
    printf("Verifying CSR Deductive-Epistemic-Decision Bridge Traversal...\n");
    let mem_len = cartan_tree_len_f(pipe.memory_tree);
    printf("  Memory Tree Size: %.0f\n", mem_len);
    var has_bayes = 0.0;
    var has_likelihood = 0.0;
    var mi = 0.0;
    while (mi < mem_len) {
        let m_txt = cartan_tree_get_f32(pipe.memory_tree, mi);
        printf("    Traversed Rule [%.0f]: %s\n", mi, m_txt);
        if (cartan_string_contains(m_txt, "Bayesian Posterior Invariant") != 0.0 || cartan_string_contains(m_txt, "P(H|E)") != 0.0) {
            has_bayes = 1.0;
        }
        if (cartan_string_contains(m_txt, "Likelihood Evidence Ratio") != 0.0 || cartan_string_contains(m_txt, "P(E|H)") != 0.0) {
            has_likelihood = 1.0;
        }
        mi = mi + 1.0;
    }

    if (has_bayes == 0.0) {
        printf("FAILED: Bayesian Posterior Invariant rule was not found in traversed memory tree\n");
        exit(1.0);
    }
    if (has_likelihood == 0.0) {
        printf("FAILED: Likelihood Evidence Ratio rule was not found in traversed memory tree\n");
        exit(1.0);
    }
    printf("[PASS] CSR Deductive-Epistemic traversal verified.\n\n");

    // -------------------------------------------------------------------------
    // 4. Verify Domain 9 Fallacy Veto Gate (Rule 12) & Logit Suppression
    // -------------------------------------------------------------------------
    printf("Verifying Domain 9 Fallacy Veto & Logit Suppression...\n");
    let fallacious_candidate = "This hypothesis holds a dogmatic prior immune to evidence so we will never update our credence.";
    let v_scan = veto_gate_scan(pipe.veto_reg, fallacious_candidate);

    printf("  Candidate Text: '%s'\n", fallacious_candidate);
    printf("  Vetoed: %.0f (expected 1.0)\n", v_scan.is_vetoed);
    printf("  Violated Rule ID: %.0f (expected 12.0)\n", v_scan.violated_rule_id);
    printf("  Canonical Assertion: %s\n", v_scan.output_text);

    if (v_scan.is_vetoed != 1.0 || v_scan.violated_rule_id != 12.0) {
        printf("FAILED: Epistemic fallacy text was not vetoed as expected\n");
        exit(1.0);
    }

    // Verify logit suppression of Domain 9 contradiction tokens (901-904)
    let logit_bank = cartan_vec_create();
    var li = 0.0;
    while (li < 1000.0) {
        cartan_vec_push_f32(logit_bank, 2.0);
        li = li + 1.0;
    }

    let penalty = nses_pipeline_shape_loss(pipe, 9.0, logit_bank, 0.0, 0.20);
    printf("  Domain 9 Symbolic Penalty: %.4f\n", penalty);
    if (penalty <= 0.0) {
        printf("FAILED: Expected positive loss penalty for Domain 9 contradiction tokens\n");
        exit(1.0);
    }

    let l901 = cartan_vec_get_f32(logit_bank, 901.0);
    let l902 = cartan_vec_get_f32(logit_bank, 902.0);
    let l903 = cartan_vec_get_f32(logit_bank, 903.0);
    let l904 = cartan_vec_get_f32(logit_bank, 904.0);
    let l_neutral = cartan_vec_get_f32(logit_bank, 500.0);

    printf("  Logit 901 (Dogmatic Prior Assertion): %.2f (expected <= 0.0)\n", l901);
    printf("  Logit 902 (Confirmation Bias Fallacy): %.2f (expected <= 0.0)\n", l902);
    printf("  Logit 903 (Base Rate Neglect): %.2f (expected <= 0.0)\n", l903);
    printf("  Logit 904 (AGM Postulate Violation): %.2f (expected <= 0.0)\n", l904);
    printf("  Logit 500 (Neutral Token): %.2f (expected 2.0)\n", l_neutral);

    if (l901 > 0.0 || l902 > 0.0 || l903 > 0.0 || l904 > 0.0 || l_neutral != 2.0) {
        printf("FAILED: Contradiction token suppression failed for Domain 9\n");
        exit(1.0);
    }
    printf("[PASS] Domain 9 epistemic fallacy veto and logit shaping verified.\n\n");

    // -------------------------------------------------------------------------
    // 5. Verify Cross-Domain Lexicon & Framing for Domain 9
    // -------------------------------------------------------------------------
    printf("Verifying Cross-Domain Lexicon & Epistemic Framing...\n");
    let lex = domain_lexicon_create();
    domain_lexicon_populate_defaults(lex);

    let ic_bayes = domain_lexicon_lookup_ic(lex, "bayes");
    let ic_posterior = domain_lexicon_lookup_ic(lex, "posterior");
    let ic_likelihood = domain_lexicon_lookup_ic(lex, "likelihood");
    let ic_defeasible = domain_lexicon_lookup_ic(lex, "defeasible");
    let ic_stop = domain_lexicon_lookup_ic(lex, "the");

    printf("  IC('bayes'): %.2f (expected >= 0.90)\n", ic_bayes);
    printf("  IC('posterior'): %.2f (expected >= 0.90)\n", ic_posterior);
    printf("  IC('likelihood'): %.2f (expected >= 0.90)\n", ic_likelihood);
    printf("  IC('defeasible'): %.2f (expected >= 0.90)\n", ic_defeasible);
    printf("  IC('the'): %.2f (expected <= 0.15)\n", ic_stop);

    if (ic_bayes < 0.90 || ic_posterior < 0.90 || ic_likelihood < 0.90 || ic_defeasible < 0.90 || ic_stop > 0.15) {
        printf("FAILED: Domain 9 IC weight lookup mismatch\n");
        exit(1.0);
    }

    let frame9 = domain_lexicon_get_discourse_frame(lex, 9.0);
    printf("  Discourse Frame 9: %s\n", frame9);
    if (cartan_string_contains(frame9, "[Epistemic Belief Frame]") == 0.0 || cartan_string_contains(frame9, "Bayes rule") == 0.0) {
        printf("FAILED: Domain 9 discourse frame mismatch\n");
        exit(1.0);
    }
    printf("[PASS] Domain 9 lexicon and discourse framing verified.\n\n");

    // -------------------------------------------------------------------------
    // 6. Verify Training Dataset Routing for Domain 9
    // -------------------------------------------------------------------------
    printf("Verifying Training Dataset Routing for Domain 9...\n");
    let d_epistem1 = "trainingdata/bayes_belief_revision_corpus.tsv";
    let d_epistem2 = "trainingdata/epistemic_evidence_weights.json";
    let d_logic = "trainingdata/proofwriter_deductive_rules.tsv";

    var r1 = 5.0;
    if (cartan_string_contains(d_epistem1, "epistem") != 0.0 || cartan_string_contains(d_epistem1, "belief") != 0.0 || cartan_string_contains(d_epistem1, "bayes") != 0.0) {
        r1 = 9.0;
    }
    var r2 = 5.0;
    if (cartan_string_contains(d_epistem2, "epistem") != 0.0 || cartan_string_contains(d_epistem2, "evidence") != 0.0) {
        r2 = 9.0;
    }
    var r3 = 5.0;
    if (cartan_string_contains(d_logic, "logic") != 0.0 || cartan_string_contains(d_logic, "proof") != 0.0) {
        r3 = 7.0;
    }

    printf("  Dataset '%s' routed to domain: %.0f (expected 9.0)\n", d_epistem1, r1);
    printf("  Dataset '%s' routed to domain: %.0f (expected 9.0)\n", d_epistem2, r2);
    printf("  Dataset '%s' routed to domain: %.0f (expected 7.0)\n", d_logic, r3);

    if (r1 != 9.0 || r2 != 9.0 || r3 != 7.0) {
        printf("FAILED: Dataset routing mismatch for Domain 9\n");
        exit(1.0);
    }
    printf("[PASS] Training dataset routing verified for Domain 9.\n\n");

    // Clean up
    domain_lexicon_free(lex);
    cartan_vec_free(logit_bank);
    nses_pipeline_free(pipe);
    cargraph_free(cg);

    printf("=====================================================================\n");
    printf("[PASS] Target 78: NSES Epistemology, Belief Revision & Probabilistic Domain Verified Cleanly.\n");
    printf("=====================================================================\n");
    return 0.0;
}
