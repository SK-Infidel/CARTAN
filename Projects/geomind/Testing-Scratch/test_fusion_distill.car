// CARTAN Compiler Suite: Test Model Fusion & Distillation Engine Module
include "../../src/std/fusion.car";
include "../../src/std/distill.car";

fn main() -> float {
    printf("[test_fusion_distill] Initializing Model Fusion & Distillation Engine verification...\n");
    let t1 = cartan_tensor_alloc(100.0);
    let t2 = cartan_tensor_alloc(100.0);
    var i = 0.0;
    while (i < 100.0) {
        cartan_tree_set(t1, i, 1.0);
        cartan_tree_set(t2, i, 2.0);
        i = i + 1.0;
    }

    let merged_slerp = fusion_slerp_tensors(t1, t2, 0.5);
    static_assert(cartan_tree_len(merged_slerp) == 100.0, "SLERP merged tensor size must match 100");
    let val_mid = cartan_tree_get_f32(merged_slerp, 0.0);
    static_assert(val_mid == 1.5, "SLERP midpoint value must equal 1.5");

    let kl_loss = distill_kl_divergence_loss(t1, t2, 1.0);
    static_assert(kl_loss >= 0.0, "KL divergence loss must be non-negative");

    printf("[test_fusion_distill] PASSED: Model Fusion & Distillation Engine fully verified.\n");
    return 0.0;
}
