// test/compiler_suite/test_ns_gradient_supervision.car
// Target [87]: Neuro-Symbolic Gradient Supervision & Active Critic Backward Pass Shaping
// Verification Gates:
//   Gate 1: Baseline Cross-Entropy Loss & Delta Covector Validation
//   Gate 2: Active Critic Echo Suppression & Domain Penalty Shaping
//   Gate 3: 1-Step Analytical SGD Weight Update Verification
//   Gate 4: Zero-Mock Parameter Delta & Veto Registry Integration

include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/math.cl";
include "src/std/veto_gate.cl";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_float_to_string(v: float) -> string;
extern fn malloc(size: float) -> ptr;
extern fn free(p: ptr);
extern fn cartan_set_f32(p: ptr, offset: float, val: float) -> void;
extern fn cartan_f32_at(p: ptr, offset: float) -> float;

fn main() -> float {
    printf("=================================================================================\n");
    printf("  CARTAN TEST SUITE: NEURO-SYMBOLIC GRADIENT SUPERVISION (TARGET 87)\n");
    printf("  Covector Shaping, Echo Suppression, Domain Penalty & 1-Step Analytical SGD\n");
    printf("=================================================================================\n\n");
    cartan_flush(0.0);

    let vocab_size = 64.0;
    let dim_size = 16.0;

    // -------------------------------------------------------------------------
    // Gate 1: Baseline Cross-Entropy Loss & Delta Covector Validation
    // -------------------------------------------------------------------------
    printf("[1/4] Verifying Baseline Cross-Entropy Loss & Delta Covector...\n");

    let logits = malloc(vocab_size * 4.0);
    var i = 0.0;
    while (i < vocab_size) {
        // Initial synthetic logits with moderate spread
        let z_i = sin((i + 1.0) * 0.35) * 2.0;
        cartan_set_f32(logits, i, z_i);
        i = i + 1.0;
    }

    let target_tok = 25.0;
    let prev_tok = 10.0;
    let ic_weight = 1.85;
    let temp = 1.0;

    // Compute max for numerical stability
    var max_z = -1000.0;
    i = 0.0;
    while (i < vocab_size) {
        let z = cartan_f32_at(logits, i);
        if (z > max_z) { max_z = z; }
        i = i + 1.0;
    }

    // Compute Softmax partition function
    let probs = malloc(vocab_size * 4.0);
    var sum_exp = 0.0;
    i = 0.0;
    while (i < vocab_size) {
        let diff = cartan_f32_at(logits, i) - max_z;
        let p_unnorm = exp(diff / temp);
        cartan_set_f32(probs, i, p_unnorm);
        sum_exp = sum_exp + p_unnorm;
        i = i + 1.0;
    }

    var prob_sum = 0.0;
    i = 0.0;
    while (i < vocab_size) {
        let p = cartan_f32_at(probs, i) / sum_exp;
        cartan_set_f32(probs, i, p);
        prob_sum = prob_sum + p;
        i = i + 1.0;
    }

    // Softmax partition validation
    cartan_assert(prob_sum > 0.999 && prob_sum < 1.001, "Softmax probabilities must sum to 1.0");

    let p_target = cartan_f32_at(probs, target_tok);
    let ce_loss = -log(p_target) * ic_weight;
    cartan_assert(ce_loss > 0.0, "Cross-entropy loss must be strictly positive");

    // Baseline delta covector: delta_i = (p_i - y_i) * ic_weight / temp
    let delta_raw = malloc(vocab_size * 4.0);
    i = 0.0;
    while (i < vocab_size) {
        let p = cartan_f32_at(probs, i);
        var y_i = 0.0;
        if (i == target_tok) { y_i = 1.0; }
        let d = (p - y_i) * ic_weight / temp;
        cartan_set_f32(delta_raw, i, d);
        i = i + 1.0;
    }

    let delta_target = cartan_f32_at(delta_raw, target_tok);
    let delta_prev = cartan_f32_at(delta_raw, prev_tok);

    cartan_assert(delta_target < 0.0, "Target delta must be negative (gradient pulls target logit up)");
    cartan_assert(delta_prev > 0.0, "Non-target delta must be positive (gradient pushes non-target logit down)");

    printf("  Base CE Loss: %s | P(target): %s | Delta(target): %s | Delta(prev): %s\n",
        cartan_float_to_string(ce_loss), cartan_float_to_string(p_target),
        cartan_float_to_string(delta_target), cartan_float_to_string(delta_prev));
    printf("  [PASS] Gate 1: Baseline cross-entropy covector validated cleanly.\n\n");
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // Gate 2: Active Critic Echo Suppression & Domain Penalty Shaping
    // -------------------------------------------------------------------------
    printf("[2/4] Verifying Active Critic Echo Suppression & Domain Penalty Shaping...\n");

    let lambda_echo = 0.35;
    let lambda_sym = 0.25;
    let lambda_boost = 0.15;
    let forbidden_tok = 14.0; // Simulated active domain violation token

    let forbidden_mask = malloc(vocab_size * 4.0);
    i = 0.0;
    while (i < vocab_size) {
        if (i == forbidden_tok) {
            cartan_set_f32(forbidden_mask, i, 1.0);
        } else {
            cartan_set_f32(forbidden_mask, i, 0.0);
        }
        i = i + 1.0;
    }

    // Apply Critic shaping: delta* = delta + echo_pen + sym_pen - target_boost
    let delta_critic = malloc(vocab_size * 4.0);
    i = 0.0;
    while (i < vocab_size) {
        var d = cartan_f32_at(delta_raw, i);
        // 1. Echo suppression
        if (i == prev_tok && prev_tok != target_tok) {
            d = d + lambda_echo;
        }
        // 2. Domain contradiction penalty
        if (cartan_f32_at(forbidden_mask, i) > 0.5) {
            d = d + lambda_sym;
        }
        // 3. Ground truth domain attractor boost
        if (i == target_tok) {
            d = d - lambda_boost;
        }
        cartan_set_f32(delta_critic, i, d);
        i = i + 1.0;
    }

    let delta_echo_shaped = cartan_f32_at(delta_critic, prev_tok);
    let delta_forb_shaped = cartan_f32_at(delta_critic, forbidden_tok);
    let delta_tgt_shaped = cartan_f32_at(delta_critic, target_tok);

    // Assertions for Critic shaping
    cartan_assert(delta_echo_shaped > delta_prev, "Echo token delta must increase under critic penalty");
    cartan_assert(delta_forb_shaped > cartan_f32_at(delta_raw, forbidden_tok), "Forbidden token delta must increase under critic penalty");
    cartan_assert(delta_tgt_shaped < delta_target, "Target token delta must become more negative under critic boost");

    // Neutral token preservation
    let neutral_tok = 3.0;
    let diff_neutral = cartan_f32_at(delta_critic, neutral_tok) - cartan_f32_at(delta_raw, neutral_tok);
    cartan_assert(diff_neutral > -0.0001 && diff_neutral < 0.0001, "Neutral tokens must remain unperturbed by critic");

    printf("  Delta Echo (Raw -> Shaped): %s -> %s (Shift: +%s)\n",
        cartan_float_to_string(delta_prev), cartan_float_to_string(delta_echo_shaped),
        cartan_float_to_string(delta_echo_shaped - delta_prev));
    printf("  Delta Forbid (Raw -> Shaped): %s -> %s (Shift: +%s)\n",
        cartan_float_to_string(cartan_f32_at(delta_raw, forbidden_tok)), cartan_float_to_string(delta_forb_shaped),
        cartan_float_to_string(delta_forb_shaped - cartan_f32_at(delta_raw, forbidden_tok)));
    printf("  Delta Target (Raw -> Shaped): %s -> %s (Shift: -%s)\n",
        cartan_float_to_string(delta_target), cartan_float_to_string(delta_tgt_shaped),
        cartan_float_to_string(delta_target - delta_tgt_shaped));
    printf("  [PASS] Gate 2: Active critic covector shaping verified.\n\n");
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // Gate 3: 1-Step Analytical SGD Weight Update Verification
    // -------------------------------------------------------------------------
    printf("[3/4] Verifying 1-Step Analytical SGD Weight Update...\n");

    let total_weights = dim_size * vocab_size;
    let weights_init = malloc(total_weights * 4.0);
    let weights_raw = malloc(total_weights * 4.0);
    let weights_critic = malloc(total_weights * 4.0);
    let hidden = malloc(dim_size * 4.0);

    // Initialize hidden state activations (RMS-normalized)
    var r = 0.0;
    var h_sq_sum = 0.0;
    while (r < dim_size) {
        let hr = 0.5 + sin((r + 1.0) * 0.5) * 0.3;
        cartan_set_f32(hidden, r, hr);
        h_sq_sum = h_sq_sum + hr * hr;
        r = r + 1.0;
    }
    let h_rms = sqrt(h_sq_sum / dim_size);
    r = 0.0;
    while (r < dim_size) {
        cartan_set_f32(hidden, r, cartan_f32_at(hidden, r) / h_rms);
        r = r + 1.0;
    }

    // Initialize weight matrix
    var idx = 0.0;
    while (idx < total_weights) {
        let w_init = cos((idx + 1.0) * 0.25) * 0.1;
        cartan_set_f32(weights_init, idx, w_init);
        cartan_set_f32(weights_raw, idx, w_init);
        cartan_set_f32(weights_critic, idx, w_init);
        idx = idx + 1.0;
    }

    let lr = 0.01;
    let decay = 0.999;

    // Execute 1-step SGD on weights_raw and weights_critic
    r = 0.0;
    while (r < dim_size) {
        let hr = cartan_f32_at(hidden, r);
        var col = 0.0;
        while (col < vocab_size) {
            let w_idx = r * vocab_size + col;
            let w_old = cartan_f32_at(weights_init, w_idx);

            // Raw CE update
            let d_raw = cartan_f32_at(delta_raw, col);
            let w_new_raw = w_old * decay - lr * hr * d_raw;
            cartan_set_f32(weights_raw, w_idx, w_new_raw);

            // Critic shaped update
            let d_crit = cartan_f32_at(delta_critic, col);
            let w_new_crit = w_old * decay - lr * hr * d_crit;
            cartan_set_f32(weights_critic, w_idx, w_new_crit);

            col = col + 1.0;
        }
        r = r + 1.0;
    }

    // Verify directional suppression of echo token column:
    // Because delta_critic > delta_raw for echo token, and hr > 0, weights_critic must be strictly lower
    r = 0.0;
    var echo_suppression_verified = 1.0;
    while (r < dim_size) {
        let w_idx = r * vocab_size + prev_tok;
        let wr = cartan_f32_at(weights_raw, w_idx);
        let wc = cartan_f32_at(weights_critic, w_idx);
        if (wc >= wr) {
            echo_suppression_verified = 0.0;
        }
        r = r + 1.0;
    }
    cartan_assert(echo_suppression_verified == 1.0, "Critic must suppress echo column weights strictly more than raw CE");

    // Verify target column weights boosted more than raw CE:
    r = 0.0;
    var target_boost_verified = 1.0;
    while (r < dim_size) {
        let w_idx = r * vocab_size + target_tok;
        let wr = cartan_f32_at(weights_raw, w_idx);
        let wc = cartan_f32_at(weights_critic, w_idx);
        if (wc <= wr) {
            target_boost_verified = 0.0;
        }
        r = r + 1.0;
    }
    cartan_assert(target_boost_verified == 1.0, "Critic must boost target column weights strictly more than raw CE");

    printf("  Echo Column Weight (Row 0): Raw=%s, Critic=%s (Delta: %s)\n",
        cartan_float_to_string(cartan_f32_at(weights_raw, prev_tok)),
        cartan_float_to_string(cartan_f32_at(weights_critic, prev_tok)),
        cartan_float_to_string(cartan_f32_at(weights_critic, prev_tok) - cartan_f32_at(weights_raw, prev_tok)));
    printf("  Target Column Weight (Row 0): Raw=%s, Critic=%s (Delta: %s)\n",
        cartan_float_to_string(cartan_f32_at(weights_raw, target_tok)),
        cartan_float_to_string(cartan_f32_at(weights_critic, target_tok)),
        cartan_float_to_string(cartan_f32_at(weights_critic, target_tok) - cartan_f32_at(weights_raw, target_tok)));
    printf("  [PASS] Gate 3: 1-step analytical SGD weight update verified.\n\n");
    cartan_flush(0.0);

    // -------------------------------------------------------------------------
    // Gate 4: Zero-Mock Parameter Delta & Veto Registry Integration
    // -------------------------------------------------------------------------
    printf("[4/4] Verifying Zero-Mock Parameter Delta & Veto Registry Integration...\n");

    // Compute Frobenius norm of weight update: ||W_critic - W_init||_F
    var frob_sq_total = 0.0;
    var frob_sq_divergence = 0.0;
    idx = 0.0;
    while (idx < total_weights) {
        let diff_init = cartan_f32_at(weights_critic, idx) - cartan_f32_at(weights_init, idx);
        let diff_raw = cartan_f32_at(weights_critic, idx) - cartan_f32_at(weights_raw, idx);
        frob_sq_total = frob_sq_total + diff_init * diff_init;
        frob_sq_divergence = frob_sq_divergence + diff_raw * diff_raw;
        idx = idx + 1.0;
    }
    let frob_total = sqrt(frob_sq_total);
    let frob_divergence = sqrt(frob_sq_divergence);

    cartan_assert(frob_total > 0.001, "Total parameter update Frobenius norm must be non-zero");
    cartan_assert(frob_divergence > 0.001, "Critic-to-Raw divergence Frobenius norm must be non-zero");

    // Test Veto Registry Integration
    let reg = veto_registry_create();
    veto_registry_populate_defaults(reg);

    let v_mask = malloc(2560.0 * 4.0);
    let mask_cnt = veto_registry_get_domain_forbidden_mask(reg, 0.0, v_mask, 2560.0);
    cartan_assert(mask_cnt > 0.0, "Veto registry must provide active domain forbidden mask");

    let f_array = malloc(64.0 * 4.0);
    let arr_cnt = veto_registry_get_domain_forbidden_array(reg, 0.0, f_array, 64.0);
    cartan_assert(arr_cnt > 0.0, "Veto registry must export forbidden token array");
    cartan_assert(arr_cnt == mask_cnt, "Forbidden array count must match forbidden mask count");

    printf("  Frobenius Parameter Delta ||W_crit - W_init||_F: %s\n", cartan_float_to_string(frob_total));
    printf("  Critic Impact Divergence ||W_crit - W_raw||_F:   %s\n", cartan_float_to_string(frob_divergence));
    printf("  Veto Registry Export: %s forbidden tokens identified for Domain 0\n", cartan_float_to_string(arr_cnt));
    printf("  [PASS] Gate 4: Zero-mock genuine parameter update and veto registry verified.\n\n");
    cartan_flush(0.0);

    // Clean up allocated test memory
    free(logits);
    free(probs);
    free(delta_raw);
    free(delta_critic);
    free(forbidden_mask);
    free(weights_init);
    free(weights_raw);
    free(weights_critic);
    free(hidden);
    free(v_mask);
    free(f_array);
    veto_registry_free(reg);

    printf("=================================================================================\n");
    printf("  TARGET 87 VERIFICATION COMPLETE: ALL 4 GATES PASSED (100%% EMPIRICAL ZERO-MOCK)\n");
    printf("=================================================================================\n");
    cartan_flush(0.0);

    return 0.0;
}
