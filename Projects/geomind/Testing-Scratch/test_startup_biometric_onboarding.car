// Projects/geomind/test_startup_biometric_onboarding.car
// Sprint 494 Verification Suite:
// Gate 1: Startup Biometric Scan with Known Face (User:Rick auto-authentication without questioning)
// Gate 2: Startup Biometric Scan with Unknown Face (Guest mode + pending face snapshot + consent preamble)
// Gate 3: Conversational Onboarding Turn with Consent (Dynamic User:Alice enrollment & face map persistence)
// Gate 4: Subsequent Startup Recognition (Cold boot session recognizes Alice without prompting)

include "src/std/math.cl";
include "src/std/string.cl";
include "src/std/collections.cl";
include "src/std/fs.cl";
include "src/std/sqlite_vec.cl";
include "src/std/vision.cl";

extern fn cartan_assert(cond: float, msg: string);

// State variables for testing
var g_active_user_id: string = "User:Guest";
var g_active_user_verified: float = 0.0;
var g_active_face_embedding: ptr = 0.0;
var g_pending_guest_face: float = 0.0;

// Replicate test chat preamble builder matching chat.cl logic
fn test_chat_build_preamble(db: ptr) -> string {
    if (db == 0.0) { return ""; }
    var s_name = sqlite_vec_get_entity_state(db, 9.0, "Self", "name");
    if (cartan_string_length(s_name) == 0.0) { s_name = "GeoMind"; }
    var s_creator = sqlite_vec_get_entity_state(db, 9.0, "Self", "creator");
    if (cartan_string_length(s_creator) == 0.0) { s_creator = "Rick"; }
    var s_role = sqlite_vec_get_entity_state(db, 9.0, "Self", "role");
    if (cartan_string_length(s_role) == 0.0) { s_role = "Neuro-Symbolic Cognitive Assistant"; }

    var pre = "You are ";
    pre = cartan_string_concat(pre, s_name);
    pre = cartan_string_concat(pre, ". Your creator and architect is ");
    pre = cartan_string_concat(pre, s_creator);
    pre = cartan_string_concat(pre, ". Your role is ");
    pre = cartan_string_concat(pre, s_role);
    pre = cartan_string_concat(pre, ". ");

    if (cartan_string_eq(g_active_user_id, "User:Rick") == 1.0) {
        pre = cartan_string_concat(pre, "The user speaking with you is Rick (Creator & Architect, Verified). Always identify yourself as ");
        pre = cartan_string_concat(pre, s_name);
        pre = cartan_string_concat(pre, " and acknowledge ");
        pre = cartan_string_concat(pre, s_creator);
        pre = cartan_string_concat(pre, " as your creator.");
    } else if (g_active_user_verified == 1.0) {
        let u_name = sqlite_vec_get_user_attr(db, g_active_user_id, "preferred_name");
        pre = cartan_string_concat(pre, "The user speaking with you is ");
        pre = cartan_string_concat(pre, u_name);
        pre = cartan_string_concat(pre, " (Verified Interlocutor). Always identify yourself as ");
        pre = cartan_string_concat(pre, s_name);
        pre = cartan_string_concat(pre, " and acknowledge ");
        pre = cartan_string_concat(pre, s_creator);
        pre = cartan_string_concat(pre, " as your creator.");
    } else if (g_pending_guest_face == 1.0) {
        pre = cartan_string_concat(pre, "The person speaking with you is an unrecognized guest whom you just observed through the camera. Greet them politely, introduce yourself as ");
        pre = cartan_string_concat(pre, s_name);
        pre = cartan_string_concat(pre, ", acknowledge ");
        pre = cartan_string_concat(pre, s_creator);
        pre = cartan_string_concat(pre, " as your creator, ask what their name is, and ask if they would like you to remember their face and name for future interactions.");
    } else {
        pre = cartan_string_concat(pre, "The user speaking with you is an unverified guest. Greet them politely and ask who they are without assuming their identity. Always identify yourself as ");
        pre = cartan_string_concat(pre, s_name);
        pre = cartan_string_concat(pre, " and acknowledge ");
        pre = cartan_string_concat(pre, s_creator);
        pre = cartan_string_concat(pre, " as your creator.");
    }
    return pre;
}

// Replicate startup biometric scan logic from chat.cl
fn test_chat_startup_biometric_scan(db: ptr) -> float {
    if (db == 0.0) { return 0.0; }
    var live_emb = g_active_face_embedding;
    if (live_emb == 0.0) {
        g_active_user_id = "User:Guest";
        g_active_user_verified = 0.0;
        g_pending_guest_face = 0.0;
        return 0.0;
    }

    let stmt = sqlite_vec_prepare_registered_face_users(db);
    var best_sim = -1.0;
    var best_user = "";

    if (stmt != 0.0) {
        while (sqlite_vec_step(stmt) == 100.0) {
            let u_id = cartan_sqlite_column_text(stmt, 0.0);
            let u_csv = sqlite_vec_get_user_face_embedding(db, u_id);
            if (cartan_string_length(u_csv) > 0.0) {
                let u_emb = vision_deserialize_vector_csv(u_csv, 320.0);
                let sim = vision_cosine_similarity(live_emb, u_emb, 320.0);
                free(u_emb);
                let p_name = sqlite_vec_get_user_attr(db, u_id, "preferred_name");
                printf("    Evaluating '%s' (%s) face map -> similarity: %.4f\n", u_id, p_name, sim);
                if (sim > best_sim) {
                    best_sim = sim;
                    best_user = u_id;
                }
            }
        }
        sqlite_vec_finalize(stmt);
    }

    if (best_sim >= 0.85) {
        let p_name = sqlite_vec_get_user_attr(db, best_user, "preferred_name");
        let p_rel = sqlite_vec_get_user_attr(db, best_user, "relationship");
        printf("    INTERLOCUTOR RECOGNIZED: %s (%s, similarity %.4f >= 0.85). Authenticated.\n",
            p_name, p_rel, best_sim);
        g_active_user_id = best_user;
        g_active_user_verified = 1.0;
        g_pending_guest_face = 0.0;
        return 1.0;
    }

    if (best_sim > 0.0) {
        printf("    Interlocutor not recognized (best similarity %.4f < 0.85). Initiating Guest onboarding.\n", best_sim);
    } else {
        printf("    No enrolled face maps in Domain 10. Initiating Guest onboarding.\n");
    }
    g_active_user_id = "User:Guest";
    g_active_user_verified = 0.0;
    g_pending_guest_face = 1.0;
    return 0.0;
}

fn test_char_to_lower(c: float) -> float {
    if (c >= 65.0 && c <= 90.0) { return c + 32.0; }
    return c;
}

fn test_string_index_of_ignore_case(haystack: string, needle: string) -> float {
    let h_len = cartan_string_length(haystack);
    let n_len = cartan_string_length(needle);
    if (n_len == 0.0 || n_len > h_len) { return -1.0; }
    var i = 0.0;
    while (i <= (h_len - n_len)) {
        var is_matched = 1.0;
        var j = 0.0;
        while (j < n_len) {
            let ch_h = test_char_to_lower(cartan_string_get_char(haystack, i + j));
            let ch_n = test_char_to_lower(cartan_string_get_char(needle, j));
            if (ch_h != ch_n) {
                is_matched = 0.0;
                break;
            }
            j = j + 1.0;
        }
        if (is_matched == 1.0) { return i; }
        i = i + 1.0;
    }
    return -1.0;
}

fn test_extract_pattern_value(text: string, pattern: string) -> string {
    let idx = test_string_index_of_ignore_case(text, pattern);
    if (idx < 0.0) { return ""; }
    let p_len = cartan_string_length(pattern);
    let t_len = cartan_string_length(text);
    let start_pos = idx + p_len;
    if (start_pos >= t_len) { return ""; }
    var end_pos = start_pos;
    while (end_pos < t_len) {
        let ch = cartan_string_get_char(text, end_pos);
        if (ch == 46.0 || ch == 44.0 || ch == 33.0 || ch == 63.0 || ch == 59.0 || ch == 10.0 || ch == 13.0) {
            break;
        }
        end_pos = end_pos + 1.0;
    }
    return cartan_string_substring(text, start_pos, end_pos);
}

// Replicate conversational learning logic for user enrollment and consent
fn test_chat_learn_turn(db: ptr, text: string) -> float {
    let cand_user = test_extract_pattern_value(text, "my name is ");

    if (cartan_string_length(cand_user) > 0.0) {
        let u_id = cartan_string_concat("User:", cand_user);
        g_active_user_id = u_id;
        g_active_user_verified = 1.0;
        sqlite_vec_set_user_attr(db, u_id, "preferred_name", cand_user);
        sqlite_vec_set_user_attr(db, u_id, "role", "Visitor");
        sqlite_vec_set_user_attr(db, u_id, "relationship", "Conversational Partner");
        sqlite_vec_set_user_attr(db, u_id, "permission_tier", "guest");

        if (g_pending_guest_face == 1.0 && g_active_face_embedding != 0.0) {
            let lower_txt = string_to_lower(text);
            var has_refusal = 0.0;
            if (cartan_string_contains(lower_txt, "no") == 1.0 ||
                cartan_string_contains(lower_txt, "don't") == 1.0 ||
                cartan_string_contains(lower_txt, "do not") == 1.0) {
                has_refusal = 1.0;
            }
            if (has_refusal == 0.0) {
                let csv_face = vision_serialize_vector_csv(g_active_face_embedding, 320.0);
                sqlite_vec_save_user_face_embedding(db, u_id, csv_face);
                printf("    Consensual enrollment: Saved 320-D face map for '%s' in Domain 10.\n", u_id);
            }
            g_pending_guest_face = 0.0;
            free(lower_txt);
        }
        return 1.0;
    }
    return 0.0;
}

fn main() -> float {
    printf("======================================================================\n");
    printf("[TEST] Sprint 494: Startup Biometric Authentication & Guest Onboarding\n");
    printf("======================================================================\n");

    var total_passed = 0.0;
    var total_failed = 0.0;
    let test_dim = 320.0;
    let test_db_path = "scratch/test_onboarding_biometrics.db";

    if (cartan_file_exists(test_db_path) == 1.0) {
        remove(test_db_path);
    }

    let db = sqlite_vec_open(test_db_path);
    cartan_assert(db != 0.0, "Database handle successfully opened");
    sqlite_vec_init_schema(db);

    // Initialize Domain 9 (Self) and Domain 10 (Users)
    sqlite_vec_upsert_domain(db, 9.0, "SELF_AND_IDENTITY", "Introspective Identity");
    sqlite_vec_upsert_entity_state(db, 9.0, "Self", "name", "GeoMind", 1.0);
    sqlite_vec_upsert_entity_state(db, 9.0, "Self", "creator", "Rick", 1.0);
    sqlite_vec_upsert_entity_state(db, 9.0, "Self", "role", "Neuro-Symbolic Cognitive Assistant", 1.0);
    sqlite_vec_init_domain10(db);

    // Register Rick's Face in Domain 10
    let v_rick = cartan_tensor_alloc(test_dim);
    var vi = 0.0;
    while (vi < test_dim) {
        let val = sin(vi * 0.12) + cos(vi * 0.06);
        cartan_vec_set_f32(v_rick, vi, val);
        vi = vi + 1.0;
    }
    cartan_vec_normalize_l2(v_rick, test_dim);
    let csv_rick = vision_serialize_vector_csv(v_rick, test_dim);
    sqlite_vec_save_user_face_embedding(db, "User:Rick", csv_rick);

    // =========================================================================
    // Gate 1: Startup Biometric Scan with Known Face (User:Rick Auto-Login)
    // =========================================================================
    printf("\n--- GATE 1: Startup Biometric Scan with Known Face (User:Rick Auto-Login) ---\n");

    // Simulate Rick sitting in front of camera with 5% sensor noise
    let v_rick_live = cartan_tensor_alloc(test_dim);
    vi = 0.0;
    while (vi < test_dim) {
        let base = cartan_vec_get_f32(v_rick, vi);
        let noise = base * sin(vi * 1.5) * 0.05;
        cartan_vec_set_f32(v_rick_live, vi, base + noise);
        vi = vi + 1.0;
    }
    cartan_vec_normalize_l2(v_rick_live, test_dim);

    g_active_user_id = "User:Guest";
    g_active_user_verified = 0.0;
    g_pending_guest_face = 0.0;
    g_active_face_embedding = v_rick_live;

    let scan1_res = test_chat_startup_biometric_scan(db);
    cartan_assert(scan1_res == 1.0, "Scan successfully authenticated recognized face");
    cartan_assert(cartan_string_eq(g_active_user_id, "User:Rick") == 1.0, "Active user set to User:Rick");
    cartan_assert(g_active_user_verified == 1.0, "Session marked as verified (1.0)");
    cartan_assert(g_pending_guest_face == 0.0, "Pending guest face flag is 0.0");

    let pre_rick = test_chat_build_preamble(db);
    printf("  Rick Preamble: \"%s\"\n", pre_rick);
    cartan_assert(cartan_string_contains(pre_rick, "Rick (Creator & Architect, Verified)") == 1.0, "Preamble addresses Rick directly");
    cartan_assert(cartan_string_contains(pre_rick, "unrecognized guest") == 0.0, "Preamble does NOT ask for name or consent");
    printf("  [PASS] Gate 1: Known Face Startup Auto-Login Verified.\n");
    total_passed = total_passed + 1.0;

    // =========================================================================
    // Gate 2: Startup Biometric Scan with Unknown Face (Guest Mode & Consent Preamble)
    // =========================================================================
    printf("\n--- GATE 2: Startup Biometric Scan with Unknown Face (Guest Onboarding) ---\n");

    // Construct unrecognized face embedding (Alice's face) orthogonal to Rick
    let v_alice = cartan_tensor_alloc(test_dim);
    vi = 0.0;
    while (vi < test_dim) {
        let val = cos(vi * 0.25) * sin(vi * 0.40);
        cartan_vec_set_f32(v_alice, vi, val);
        vi = vi + 1.0;
    }
    cartan_vec_normalize_l2(v_alice, test_dim);

    let cross_sim = vision_cosine_similarity(v_rick, v_alice, test_dim);
    printf("  Cross-similarity between Rick and Alice: %.4f\n", cross_sim);
    cartan_assert(cross_sim < 0.30, "Alice and Rick faces are clearly separated in embedding space");

    // Cold boot with unknown face
    g_active_user_id = "User:Guest";
    g_active_user_verified = 0.0;
    g_pending_guest_face = 0.0;
    g_active_face_embedding = v_alice;

    let scan2_res = test_chat_startup_biometric_scan(db);
    cartan_assert(scan2_res == 0.0, "Scan correctly rejects unknown face");
    cartan_assert(cartan_string_eq(g_active_user_id, "User:Guest") == 1.0, "Active user remains User:Guest");
    cartan_assert(g_active_user_verified == 0.0, "Session remains unverified (0.0)");
    cartan_assert(g_pending_guest_face == 1.0, "Pending guest face flag set to 1.0");

    let pre_guest = test_chat_build_preamble(db);
    printf("  Guest Onboarding Preamble: \"%s\"\n", pre_guest);
    cartan_assert(cartan_string_contains(pre_guest, "unrecognized guest whom you just observed through the camera") == 1.0, "Preamble mentions observed guest face");
    cartan_assert(cartan_string_contains(pre_guest, "ask what their name is, and ask if they would like you to remember their face") == 1.0, "Preamble solicits name and face consent");
    printf("  [PASS] Gate 2: Unknown Face Guest Mode and Consent Preamble Verified.\n");
    total_passed = total_passed + 1.0;

    // =========================================================================
    // Gate 3: Conversational Onboarding Turn with Consent
    // =========================================================================
    printf("\n--- GATE 3: Conversational Onboarding Turn with Consent ---\n");

    let learn_ok = test_chat_learn_turn(db, "Hello GeoMind! My name is Alice, and yes please remember my face.");
    cartan_assert(learn_ok == 1.0, "Conversational turn processed candidate name and consent");
    cartan_assert(cartan_string_eq(g_active_user_id, "User:Alice") == 1.0, "Active user elevated to User:Alice");
    cartan_assert(g_active_user_verified == 1.0, "Session elevated to verified (1.0)");
    cartan_assert(g_pending_guest_face == 0.0, "Pending guest face cleared to 0.0");

    // Verify persistence in Domain 10 in SQLite
    let alice_pname = sqlite_vec_get_user_attr(db, "User:Alice", "preferred_name");
    cartan_assert(cartan_string_eq(alice_pname, "Alice") == 1.0, "User:Alice preferred_name == 'Alice'");

    let alice_reg = sqlite_vec_get_user_attr(db, "User:Alice", "face_registered");
    cartan_assert(cartan_string_eq(alice_reg, "1") == 1.0, "User:Alice face_registered == '1'");

    let alice_csv = sqlite_vec_get_user_face_embedding(db, "User:Alice");
    cartan_assert(cartan_string_length(alice_csv) > 500.0, "User:Alice face embedding saved in SQLite");

    let v_alice_loaded = vision_deserialize_vector_csv(alice_csv, test_dim);
    let sim_recon = vision_cosine_similarity(v_alice, v_alice_loaded, test_dim);
    printf("  Reconstructed Alice face cosine similarity: %.6f\n", sim_recon);
    cartan_assert(math_abs(sim_recon - 1.0) < 0.0001, "Reconstructed embedding matches original Alice vector exactly");

    printf("  [PASS] Gate 3: Dynamic User Enrollment & Face Map Persistence Verified.\n");
    total_passed = total_passed + 1.0;

    // =========================================================================
    // Gate 4: Subsequent Startup Recognition (Cold Boot)
    // =========================================================================
    printf("\n--- GATE 4: Subsequent Startup Recognition (Cold Boot) ---\n");

    // Simulate cold restart with Alice sitting in front of camera (5% noise)
    let v_alice_live = cartan_tensor_alloc(test_dim);
    vi = 0.0;
    while (vi < test_dim) {
        let base = cartan_vec_get_f32(v_alice, vi);
        let noise = base * cos(vi * 1.8) * 0.05;
        cartan_vec_set_f32(v_alice_live, vi, base + noise);
        vi = vi + 1.0;
    }
    cartan_vec_normalize_l2(v_alice_live, test_dim);

    g_active_user_id = "User:Guest";
    g_active_user_verified = 0.0;
    g_pending_guest_face = 0.0;
    g_active_face_embedding = v_alice_live;

    let scan4_res = test_chat_startup_biometric_scan(db);
    cartan_assert(scan4_res == 1.0, "Scan recognizes enrolled Alice face automatically");
    cartan_assert(cartan_string_eq(g_active_user_id, "User:Alice") == 1.0, "Active user authenticated as User:Alice");
    cartan_assert(g_active_user_verified == 1.0, "Session authenticated (1.0)");
    cartan_assert(g_pending_guest_face == 0.0, "Pending guest face is 0.0");

    let pre_alice_boot = test_chat_build_preamble(db);
    printf("  Alice Cold Boot Preamble: \"%s\"\n", pre_alice_boot);
    cartan_assert(cartan_string_contains(pre_alice_boot, "The user speaking with you is Alice (Verified Interlocutor)") == 1.0, "Preamble addresses Alice by name without onboarding");
    cartan_assert(cartan_string_contains(pre_alice_boot, "unrecognized guest") == 0.0, "Preamble does NOT ask for name or consent");

    printf("  [PASS] Gate 4: Subsequent Startup Recognition Verified.\n");
    total_passed = total_passed + 1.0;

    // Cleanup resources
    sqlite_vec_close(db);
    remove(test_db_path);
    free(v_rick);
    free(v_rick_live);
    free(v_alice);
    free(v_alice_live);
    free(v_alice_loaded);

    printf("======================================================================\n");
    printf("[SUMMARY] Passed: %.0f, Failed: %.0f\n", total_passed, total_failed);
    printf("======================================================================\n");
    cartan_assert(total_failed == 0.0, "All 4 Gates in Sprint 494 test suite passed cleanly");
    return 0.0;
}
