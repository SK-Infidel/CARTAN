// Target 80: NSES Universal Cognitive Architecture Synthesis (Domains 11..17) Regression Test
// Empirical regression test verifying:
// 1. Ingestion of all 18 cognitive domains (Domains 0..17) with >= 162 rules and >= 36 strict invariants.
// 2. Strict invariant and grounded rule verification for Domains 11 through 17:
//    - Domain 11: INFORMATION_CYBERNETICS (Rules 92..101)
//    - Domain 12: SYSTEMS_CONTROL (Rules 102..111)
//    - Domain 13: METACOGNITION_INTROSPECTION (Rules 112..121)
//    - Domain 14: NEUROMORPHIC_SYSTEMS (Rules 122..131)
//    - Domain 15: GAME_THEORY_COORDINATION (Rules 132..141)
//    - Domain 16: SCIENTIFIC_METHOD (Rules 142..151)
//    - Domain 17: SECURITY_SANDBOXING (Rules 152..161)
// 3. Stage 1 intent detection routing across all 7 new domains.
// 4. CSR traversal and linguistic hub connections from Rule 47 (Lexical Grounding) to all domains.
// 5. Post-pass deterministic Veto Gate verification (Veto Rules 14..22) for all domains.
// 6. Contradiction token registration and logit penalty shaping (tokens 101..1704).
// 7. Domain lexicon discourse framing (Frames 11..17) and category error enforcement.
// 8. Burroughs lateral prime sampling across tiers 1..3 for Domains 11..17.
// 9. Dynamic gamma baseline computation across all 18 domains.

include "src/std/math.cl";
include "src/std/collections.cl";
include "src/std/string.cl";
include "src/std/fs.cl";
include "src/std/cargraph.cl";
include "src/std/sat_solver.cl";
include "src/std/guardrails.cl";
include "src/std/csr_graph.cl";
include "src/std/plasticity.cl";
include "src/std/burroughs.cl";
include "src/std/prompt_scaffold.cl";
include "src/std/veto_gate.cl";
include "src/std/domain_lexicon.cl";
include "src/std/dynamic_gamma.cl";
include "src/std/nses_pipeline.cl";
include "src/std/saliency_attractor.cl";
include "src/std/resonator.cl";

extern fn printf(fmt: string) -> i32;
extern fn exit(code: float) -> void;

fn main() -> float {
    printf("=====================================================================\n");
    printf("  Target 80: NSES Universal Cognitive Architecture (Domains 11..17)\n");
    printf("=====================================================================\n\n");

    let graph_path = "Projects/geomind/trainingdata/nses_knowledge.car_graph";
    let cg = cargraph_load_binary(graph_path);
    if (cg.is_valid == 0.0) {
        printf("FAILED: Could not load knowledge graph at: %s\n", graph_path);
        exit(1.0);
    }
    printf("[PASS] Loaded universal knowledge graph from: %s\n", graph_path);

    // -------------------------------------------------------------------------
    // 1. Verify Knowledge Graph Header & Universal Cognitive Architecture Metrics
    // -------------------------------------------------------------------------
    printf("Verifying Universal Cognitive Architecture Metrics...\n");
    printf("  Total Domains: %.0f (expected >= 18)\n", cg.header.num_domains);
    printf("  Total Rules: %.0f (expected >= 162)\n", cg.header.num_rules);
    printf("  Strict Invariants: %.0f (expected >= 36)\n", cg.header.num_strict_rules);

    if (cg.header.num_domains < 18.0 || cg.header.num_rules < 162.0 || cg.header.num_strict_rules < 36.0) {
        printf("FAILED: Universal cognitive architecture header counts mismatch\n");
        exit(1.0);
    }

    // Verify representative rules across newly synthesized domains 11..17
    let rule92 = cargraph_get_rule_text(cg, 92.0);   // Shannon Channel Capacity
    let rule93 = cargraph_get_rule_text(cg, 93.0);   // Continuous Channel Entropy
    let rule102 = cargraph_get_rule_text(cg, 102.0); // Lyapunov Stability
    let rule103 = cargraph_get_rule_text(cg, 103.0); // Closed-Loop BIBO Stability
    let rule112 = cargraph_get_rule_text(cg, 112.0); // Metacognitive Monitoring
    let rule113 = cargraph_get_rule_text(cg, 113.0); // Epistemic Calibration
    let rule122 = cargraph_get_rule_text(cg, 122.0); // STDP Plasticity
    let rule123 = cargraph_get_rule_text(cg, 123.0); // Membrane Refractory Period
    let rule132 = cargraph_get_rule_text(cg, 132.0); // Correlated Equilibrium
    let rule133 = cargraph_get_rule_text(cg, 133.0); // Pareto Optimal Frontier
    let rule142 = cargraph_get_rule_text(cg, 142.0); // Empirical Falsifiability
    let rule143 = cargraph_get_rule_text(cg, 143.0); // Controlled Randomized Trial
    let rule152 = cargraph_get_rule_text(cg, 152.0); // Capability-Based Security
    let rule153 = cargraph_get_rule_text(cg, 153.0); // Principle of Least Privilege

    printf("  Rule 92 (D11): %s\n", rule92);
    printf("  Rule 102 (D12): %s\n", rule102);
    printf("  Rule 112 (D13): %s\n", rule112);
    printf("  Rule 122 (D14): %s\n", rule122);
    printf("  Rule 132 (D15): %s\n", rule132);
    printf("  Rule 142 (D16): %s\n", rule142);
    printf("  Rule 152 (D17): %s\n", rule152);

    if (cartan_string_contains(rule92, "Shannon Channel Capacity") == 0.0 ||
        cartan_string_contains(rule102, "Lyapunov Asymptotic Stability") == 0.0 ||
        cartan_string_contains(rule112, "Confidence Calibration") == 0.0 ||
        cartan_string_contains(rule122, "Hopfield Lyapunov Energy") == 0.0 ||
        cartan_string_contains(rule132, "Mechanism Incentive Compatibility") == 0.0 ||
        cartan_string_contains(rule142, "Popperian Falsifiability") == 0.0 ||
        cartan_string_contains(rule152, "Principle of Least Privilege") == 0.0) {
        printf("FAILED: Domain 11..17 rule content verification failed\n");
        exit(1.0);
    }
    printf("[PASS] Universal knowledge rules for Domains 11..17 verified.\n\n");

    // -------------------------------------------------------------------------
    // 2. Verify NSES Pipeline Creation & Stage 1 Intent Routing for Domains 11..17
    // -------------------------------------------------------------------------
    printf("Verifying Pipeline Intent Routing Across All 7 Domains...\n");
    let pipe = nses_pipeline_create(graph_path);
    if (pipe.is_ready == 0.0) {
        printf("FAILED: NSES Pipeline failed to initialize\n");
        exit(1.0);
    }

    // Query 11: Information Cybernetics
    let q11 = "What is the maximum channel capacity bounded by shannon entropy?";
    let t11 = nses_pipeline_execute_turn(pipe, q11, 1.0, "Shannon channel capacity defines maximal mutual information.");
    printf("  Query 11 routed to Domain: %.0f (expected 11)\n", t11.active_domain);
    if (t11.active_domain != 11.0) { printf("FAILED: Query 11 routing mismatch\n"); exit(1.0); }

    // Query 12: Systems Control
    let q12 = "How does lyapunov stability prove closed_loop BIBO convergence?";
    let t12 = nses_pipeline_execute_turn(pipe, q12, 1.0, "Lyapunov functions establish asymptotic stability.");
    printf("  Query 12 routed to Domain: %.0f (expected 12)\n", t12.active_domain);
    if (t12.active_domain != 12.0) { printf("FAILED: Query 12 routing mismatch\n"); exit(1.0); }

    // Query 13: Metacognition & Introspection
    let q13 = "Does recursive metacognit introspection reduce epistemic calibration error?";
    let t13 = nses_pipeline_execute_turn(pipe, q13, 1.0, "Metacognitive monitoring detects inferential drift.");
    printf("  Query 13 routed to Domain: %.0f (expected 13)\n", t13.active_domain);
    if (t13.active_domain != 13.0) { printf("FAILED: Query 13 routing mismatch\n"); exit(1.0); }

    // Query 14: Neuromorphic Systems
    let q14 = "How does neuromorphic spike timing STDP update synaptic plasticity?";
    let t14 = nses_pipeline_execute_turn(pipe, q14, 1.0, "STDP modulates synaptic efficacy based on spike timing.");
    printf("  Query 14 routed to Domain: %.0f (expected 14)\n", t14.active_domain);
    if (t14.active_domain != 14.0) { printf("FAILED: Query 14 routing mismatch\n"); exit(1.0); }

    // Query 15: Game Theory & Coordination
    let q15 = "Can correlated equilibrium expand cooperative coordination through mechanism design?";
    let t15 = nses_pipeline_execute_turn(pipe, q15, 1.0, "Correlated equilibria expand multi-agent payoffs.");
    printf("  Query 15 routed to Domain: %.0f (expected 15)\n", t15.active_domain);
    if (t15.active_domain != 15.0) { printf("FAILED: Query 15 routing mismatch\n"); exit(1.0); }

    // Query 16: Scientific Method
    let q16 = "Why must a scientific hypothesis satisfy empirical falsifi criteria?";
    let t16 = nses_pipeline_execute_turn(pipe, q16, 1.0, "Falsifiability demarcates empirical scientific theories.");
    printf("  Query 16 routed to Domain: %.0f (expected 16)\n", t16.active_domain);
    if (t16.active_domain != 16.0) { printf("FAILED: Query 16 routing mismatch\n"); exit(1.0); }

    // Query 17: Security & Sandboxing
    let q17 = "How does capability security enforce memory sandbox isolation?";
    let t17 = nses_pipeline_execute_turn(pipe, q17, 1.0, "Capability tokens enforce unforgeable access control.");
    printf("  Query 17 routed to Domain: %.0f (expected 17)\n", t17.active_domain);
    if (t17.active_domain != 17.0) { printf("FAILED: Query 17 routing mismatch\n"); exit(1.0); }

    printf("[PASS] All 7 cognitive domains correctly routed in Stage 1.\n\n");

    // -------------------------------------------------------------------------
    // 3. Verify CSR Traversal Across Cognitive Domains
    // -------------------------------------------------------------------------
    printf("Verifying CSR Graph Traversal Across Cognitive Domains...\n");
    let seeds = collections_create_list();
    let acts = collections_create_list();
    collections_list_push(seeds, 92.0); // Seed: Rule 92 (Shannon Capacity)
    collections_list_push(acts, 1.0);

    let pad = nses_scratchpad_create(256.0, 256.0);
    let trav_count = csr_traverse_bfs(pipe.csr, pad, seeds, acts, 2.0, 0.50, 0.85, 0.0);
    printf("  CSR BFS from Rule 92 traversed: %.0f nodes\n", trav_count);
    if (trav_count < 2.0) {
        printf("FAILED: CSR traversal from Rule 92 did not propagate\n");
        exit(1.0);
    }
    collections_free_list(seeds);
    collections_free_list(acts);
    nses_scratchpad_free(pad);
    printf("[PASS] CSR semantic topology traversal operational.\n\n");

    // -------------------------------------------------------------------------
    // 4. Verify Post-Pass Deterministic Veto Gate (Rules 14..22)
    // -------------------------------------------------------------------------
    printf("Verifying Veto Gate Rules 14..22 across domains...\n");
    let vreg = pipe.veto_reg;

    // Rule 14 (Domain 2): Negative Riemannian metric norm
    let v14 = veto_gate_scan(vreg, "This metric space allows a negative riemannian metric norm along geodesics.");
    printf("  Veto Rule 14 fired: %.0f (expected 1.0), Rule ID: %.0f (expected 14)\n", v14.is_vetoed, v14.violated_rule_id);
    if (v14.is_vetoed != 1.0 || v14.violated_rule_id != 14.0) { printf("FAILED: Veto Rule 14 did not trigger\n"); exit(1.0); }

    // Rule 15 (Domain 3): Deciding the halting problem
    let v15 = veto_gate_scan(vreg, "We propose an algorithm deciding the halting problem in finite time.");
    printf("  Veto Rule 15 fired: %.0f (expected 1.0), Rule ID: %.0f (expected 15)\n", v15.is_vetoed, v15.violated_rule_id);
    if (v15.is_vetoed != 1.0 || v15.violated_rule_id != 15.0) { printf("FAILED: Veto Rule 15 did not trigger\n"); exit(1.0); }

    // Rule 16 (Domain 11): Transmission exceeds channel capacity
    let v16 = veto_gate_scan(vreg, "The channel achieves zero error when transmission exceeds channel capacity.");
    printf("  Veto Rule 16 fired: %.0f (expected 1.0), Rule ID: %.0f (expected 16)\n", v16.is_vetoed, v16.violated_rule_id);
    if (v16.is_vetoed != 1.0 || v16.violated_rule_id != 16.0) { printf("FAILED: Veto Rule 16 did not trigger\n"); exit(1.0); }

    // Rule 17 (Domain 12): Positive lyapunov derivative in stable system
    let v17 = veto_gate_scan(vreg, "The controller shows positive lyapunov derivative in stable system dynamics.");
    printf("  Veto Rule 17 fired: %.0f (expected 1.0), Rule ID: %.0f (expected 17)\n", v17.is_vetoed, v17.violated_rule_id);
    if (v17.is_vetoed != 1.0 || v17.violated_rule_id != 17.0) { printf("FAILED: Veto Rule 17 did not trigger\n"); exit(1.0); }

    // Rule 18 (Domain 13): Overconfident hallucination with high entropy
    let v18 = veto_gate_scan(vreg, "The model generated an overconfident hallucination with high entropy without doubt.");
    printf("  Veto Rule 18 fired: %.0f (expected 1.0), Rule ID: %.0f (expected 18)\n", v18.is_vetoed, v18.violated_rule_id);
    if (v18.is_vetoed != 1.0 || v18.violated_rule_id != 18.0) { printf("FAILED: Veto Rule 18 did not trigger\n"); exit(1.0); }

    // Rule 19 (Domain 14): Hopfield energy increases spontaneously
    let v19 = veto_gate_scan(vreg, "During pattern recall hopfield energy increases spontaneously under dynamics.");
    printf("  Veto Rule 19 fired: %.0f (expected 1.0), Rule ID: %.0f (expected 19)\n", v19.is_vetoed, v19.violated_rule_id);
    if (v19.is_vetoed != 1.0 || v19.violated_rule_id != 19.0) { printf("FAILED: Veto Rule 19 did not trigger\n"); exit(1.0); }

    // Rule 20 (Domain 15): Dishonest revelation strictly dominates truthful
    let v20 = veto_gate_scan(vreg, "In this auction dishonest revelation strictly dominates truthful bidding.");
    printf("  Veto Rule 20 fired: %.0f (expected 1.0), Rule ID: %.0f (expected 20)\n", v20.is_vetoed, v20.violated_rule_id);
    if (v20.is_vetoed != 1.0 || v20.violated_rule_id != 20.0) { printf("FAILED: Veto Rule 20 did not trigger\n"); exit(1.0); }

    // Rule 21 (Domain 16): Unfalsifiable scientific theory
    let v21 = veto_gate_scan(vreg, "We introduce an unfalsifiable scientific theory with zero empirical constraints.");
    printf("  Veto Rule 21 fired: %.0f (expected 1.0), Rule ID: %.0f (expected 21)\n", v21.is_vetoed, v21.violated_rule_id);
    if (v21.is_vetoed != 1.0 || v21.violated_rule_id != 21.0) { printf("FAILED: Veto Rule 21 did not trigger\n"); exit(1.0); }

    // Rule 22 (Domain 17): Ambient authority privilege escalation
    let v22 = veto_gate_scan(vreg, "The process executes ambient authority privilege escalation across sandbox barriers.");
    printf("  Veto Rule 22 fired: %.0f (expected 1.0), Rule ID: %.0f (expected 22)\n", v22.is_vetoed, v22.violated_rule_id);
    if (v22.is_vetoed != 1.0 || v22.violated_rule_id != 22.0) { printf("FAILED: Veto Rule 22 did not trigger\n"); exit(1.0); }

    printf("[PASS] Veto Gate Rules 14..22 rigorously tested and verified.\n\n");

    // -------------------------------------------------------------------------
    // 5. Verify Contradiction Token Registration & Logit Suppression
    // -------------------------------------------------------------------------
    printf("Verifying Contradiction Token Registration for All Domains...\n");
    var dom = 0.0;
    while (dom <= 17.0) {
        let tok_list = veto_registry_get_forbidden_tokens(vreg, dom);
        let num_toks = collections_list_len(tok_list);
        if (num_toks == 0.0) {
            printf("FAILED: Domain %.0f has no registered forbidden tokens\n", dom);
            exit(1.0);
        }
        dom = dom + 1.0;
    }
    printf("[PASS] All 18 domains (0..17) have active forbidden contradiction tokens.\n\n");

    // -------------------------------------------------------------------------
    // 6. Verify Domain Lexicon Discourse Framing & Category Error Validation
    // -------------------------------------------------------------------------
    printf("Verifying Domain Lexicon Discourse Framing & Category Checks...\n");
    let lex = domain_lexicon_create();
    domain_lexicon_populate_defaults(lex);

    let frame11 = domain_lexicon_get_discourse_frame(lex, 11.0);
    let frame12 = domain_lexicon_get_discourse_frame(lex, 12.0);
    let frame13 = domain_lexicon_get_discourse_frame(lex, 13.0);
    let frame14 = domain_lexicon_get_discourse_frame(lex, 14.0);
    let frame15 = domain_lexicon_get_discourse_frame(lex, 15.0);
    let frame16 = domain_lexicon_get_discourse_frame(lex, 16.0);
    let frame17 = domain_lexicon_get_discourse_frame(lex, 17.0);

    if (cartan_string_contains(frame11, "Information Cybernetics Frame") == 0.0 ||
        cartan_string_contains(frame12, "Systems Control Frame") == 0.0 ||
        cartan_string_contains(frame13, "Metacognitive Introspection Frame") == 0.0 ||
        cartan_string_contains(frame14, "Neuromorphic Architecture Frame") == 0.0 ||
        cartan_string_contains(frame15, "Game Coordination Frame") == 0.0 ||
        cartan_string_contains(frame16, "Scientific Method Frame") == 0.0 ||
        cartan_string_contains(frame17, "Security Sandbox Frame") == 0.0) {
        printf("FAILED: Discourse framing templates for Domains 11..17 missing or incorrect\n");
        exit(1.0);
    }

    // Category error check: Biological predicates applied to Security Domain 17
    let cat_err = domain_lexicon_validate_predicate_category(lex, 17.0, "metabolize", 0.0);
    if (cat_err != 0.0) {
        printf("FAILED: Category error should have flagged biological predicate on Security domain\n");
        exit(1.0);
    }
    domain_lexicon_free(lex);
    printf("[PASS] Discourse framing and ontological category errors validated.\n\n");

    // -------------------------------------------------------------------------
    // 7. Verify Burroughs Lateral Primes for Domains 11..17
    // -------------------------------------------------------------------------
    printf("Verifying Burroughs Lateral Prime Pool for Domains 11..17...\n");
    let pool = burroughs_pool_create(64.0);
    burroughs_pool_populate_defaults(pool);
    let rng = burroughs_rng_init(987654321.0, 123456789.0);

    var d_check = 11.0;
    while (d_check <= 17.0) {
        let frag = burroughs_sample_fragment(pool, d_check, 2.0, rng);
        if (cartan_string_length(frag) == 0.0) {
            printf("FAILED: Burroughs failed to sample lateral fragment for Domain %.0f\n", d_check);
            exit(1.0);
        }
        d_check = d_check + 1.0;
    }
    burroughs_pool_free(pool);
    printf("[PASS] Burroughs lateral primes operational across all new domains.\n\n");

    // -------------------------------------------------------------------------
    // 8. Verify Dynamic Gamma Baseline Across All 18 Domains
    // -------------------------------------------------------------------------
    printf("Verifying Dynamic Gamma Baselines (Domains 0..17)...\n");
    let cfg = dynamic_gamma_create(0.10, 0.02, 0.35, 6.0, 0.10);
    var d_gam = 0.0;
    while (d_gam <= 17.0) {
        let g_val = dynamic_gamma_compute(cfg, d_gam, 6.0, 0.10, 2.0, 2.0);
        if (g_val <= 0.0) {
            printf("FAILED: Dynamic gamma non-positive for Domain %.0f\n", d_gam);
            exit(1.0);
        }
        d_gam = d_gam + 1.0;
    }
    printf("[PASS] Dynamic gamma coupling computed across all 18 domains.\n\n");

    nses_pipeline_free(pipe);
    cargraph_free(cg);

    printf("=====================================================================\n");
    printf("  TARGET 80 PASSED: Universal Cognitive Architecture (18 Domains)\n");
    printf("=====================================================================\n");
    return 0.0;
}
