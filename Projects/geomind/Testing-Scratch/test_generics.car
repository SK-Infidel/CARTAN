// test/compiler_suite/test_generics.car
// CARTAN Regression Target [17/17]: Generic Collections & Monomorphization Pass
// // run-pass

include "../../src/std/collections.car";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    let list = collections::create_list();
    cartan_assert(list != 0.0, "collections::create_list failed");

    collections::list_push(list, "Item 1");
    collections::list_push(list, "Item 2");
    collections::list_push(list, "Item 3");

    let len = collections::list_len(list);
    cartan_assert(len == 3.0, "collections::list_len validation failed");

    let first = collections::list_get(list, 0.0);
    cartan_assert(cartan_string_length(first) > 0.0, "collections::list_get validation failed");

    return 0.0;
}
