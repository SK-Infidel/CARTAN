// test/compiler_suite/test_tokenizer.car
// CARTAN Regression Target [24/24]: Tokenizer Standard Library Integration Pass
// // run-pass

include "../../src/std/tokenizer.car";

extern fn cartan_assert(cond: float, msg: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    let rank = tokenizer::bpe_get_rank(72.0, 101.0);
    cartan_assert(rank == 1.0, "tokenizer::bpe_get_rank failed");

    let bos = tokenizer::sp_bos_token_id();
    cartan_assert(bos == 2.0, "tokenizer::sp_bos_token_id failed");

    let tok_buf = tokenizer::sentencepiece_encode("CARTAN Tokenizer Test");
    cartan_assert(tok_buf[0] == 2.0, "tokenizer::sentencepiece_encode failed");

    return 0.0;
}
