// CARTAN Compiler Suite: Test Computer Vision Module
include "../../src/std/vision.car";

fn main() -> float {
    printf("[test_vision] Initializing Computer Vision Module verification...\n");
    let img = vision_create_image(224.0, 224.0, 3.0);
    static_assert(img.width == 224.0, "Image width must match 224");
    static_assert(img.height == 224.0, "Image height must match 224");
    static_assert(img.channels == 3.0, "Image channel count must match 3");

    let tensor_data = vision_image_to_tensor(img);
    static_assert(cartan_tree_len(tensor_data) == 150528.0, "RGB Tensor pixel count must match 224x224x3 (150528)");

    let resized = vision_resize_bilinear(img, 112.0, 112.0);
    static_assert(resized.width == 112.0, "Resized image width must match 112");
    static_assert(resized.height == 112.0, "Resized image height must match 112");

    let norm_img = vision_normalize(img, 0.485, 0.456, 0.406, 0.229, 0.224, 0.225);
    static_assert(norm_img.channels == 3.0, "Normalized image channels must match 3");

    printf("[test_vision] PASSED: Computer Vision Module fully verified.\n");
    return 0.0;
}
