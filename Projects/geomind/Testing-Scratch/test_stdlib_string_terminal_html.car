// Projects/geomind/Testing-scratch/test_stdlib_string_terminal_html.car
// Regression Test Target 89: CARTAN Standard Library String, Terminal & HTML Modules

include "src/std/string.cl";
include "src/std/terminal.cl";
include "src/std/html.cl";

extern fn printf(format: string) -> i32;

fn test_assert(cond: float, msg: string) -> float {
    if (cond == 1.0) {
        printf("  [PASS] ");
        printf(msg);
        printf("\n");
        return 1.0;
    }
    printf("  [FAIL] ");
    printf(msg);
    printf("\n");
    return 0.0;
}

fn main() -> float {
    printf("================================================================================\n");
    printf("  CARTAN STANDARD LIBRARY VERIFICATION: String, Terminal & HTML (Target 89)\n");
    printf("================================================================================\n\n");

    var all_pass = 1.0;

    // -------------------------------------------------------------------------
    // Gate 1: Extended String Primitives (src/std/string.cl)
    // -------------------------------------------------------------------------
    printf("--- Gate 1: Extended String Primitives ---\n");

    let lower_a = string_char_to_lower(65.0); // 'A' -> 'a' (97)
    let lower_z = string_char_to_lower(90.0); // 'Z' -> 'z' (122)
    let lower_b = string_char_to_lower(98.0); // 'b' -> 'b' (98)
    all_pass = all_pass * test_assert(lower_a == 97.0 && lower_z == 122.0 && lower_b == 98.0, "string_char_to_lower maps ASCII uppercase to lowercase");

    let sp_space = string_char_is_space(32.0);
    let sp_tab = string_char_is_space(9.0);
    let sp_nl = string_char_is_space(10.0);
    let sp_cr = string_char_is_space(13.0);
    let sp_char = string_char_is_space(65.0);
    all_pass = all_pass * test_assert(sp_space == 1.0 && sp_tab == 1.0 && sp_nl == 1.0 && sp_cr == 1.0 && sp_char == 0.0, "string_char_is_space identifies whitespace codes");

    let trimmed = string_trim("  \t\n CARTAN Compiler \r\n  ");
    all_pass = all_pass * test_assert(cartan_string_eq(trimmed, "CARTAN Compiler") == 1.0, "string_trim strips leading and trailing whitespace");

    let empty_trimmed = string_trim("   \t  \n");
    all_pass = all_pass * test_assert(cartan_string_length(empty_trimmed) == 0.0, "string_trim returns empty string on all-whitespace input");

    let idx1 = string_index_of("CARTAN Self-Hosting Language", "Self");
    all_pass = all_pass * test_assert(idx1 == 7.0, "string_index_of finds exact substring offset");

    let idx_not_found = string_index_of("CARTAN Self-Hosting Language", "Rust");
    all_pass = all_pass * test_assert(idx_not_found == -1.0, "string_index_of returns -1.0 on missing needle");

    let idx_ic = string_index_of_ignore_case("CARTAN Self-Hosting Language", "self-hosting");
    all_pass = all_pass * test_assert(idx_ic == 7.0, "string_index_of_ignore_case finds substring case-insensitively");

    let idx_offset = string_index_of_offset("abc abc abc", "abc", 4.0);
    all_pass = all_pass * test_assert(idx_offset == 4.0, "string_index_of_offset respects start offset");

    let pfx_off = string_starts_with_offset("https://cartan-lang.org", "cartan", 8.0);
    all_pass = all_pass * test_assert(pfx_off == 1.0, "string_starts_with_offset checks prefix at offset");

    let trim_single = string_trim(" ");
    let trim_none = string_trim("cartan");
    all_pass = all_pass * test_assert(cartan_string_length(trim_single) == 0.0 && cartan_string_eq(trim_none, "cartan") == 1.0, "string_trim handles single-space and unpadded edge cases");

    let idx_case_contrast_exact = string_index_of("CARTAN", "cartan");
    let idx_case_contrast_nocase = string_index_of_ignore_case("CARTAN", "cartan");
    all_pass = all_pass * test_assert(idx_case_contrast_exact == -1.0 && idx_case_contrast_nocase == 0.0, "case-sensitivity contrast: exact fails while ignore_case matches");

    // -------------------------------------------------------------------------
    // Gate 2: Terminal ANSI Formatting & Cursor Control (src/std/terminal.cl)
    // -------------------------------------------------------------------------
    printf("\n--- Gate 2: Terminal ANSI Formatting & Cursor Control ---\n");

    terminal_set_color_enabled(1.0);
    all_pass = all_pass * test_assert(terminal_get_color_enabled() == 1.0, "terminal_get_color_enabled returns 1.0");

    let col_g = terminal_col_green();
    let col_rst = terminal_col_reset();
    let col_erase = terminal_erase_line();
    all_pass = all_pass * test_assert(cartan_string_eq(col_g, "\e[1;32m") == 1.0, "terminal_col_green returns ANSI bright green code");
    all_pass = all_pass * test_assert(cartan_string_eq(col_rst, "\e[0m") == 1.0, "terminal_col_reset returns ANSI reset code");
    all_pass = all_pass * test_assert(cartan_string_eq(col_erase, "\e[2K\r") == 1.0, "terminal_erase_line returns ANSI line clear code");

    terminal_set_color_enabled(0.0);
    let col_g_off = terminal_col_green();
    let col_rst_off = terminal_col_reset();
    all_pass = all_pass * test_assert(cartan_string_length(col_g_off) == 0.0 && cartan_string_length(col_rst_off) == 0.0, "terminal color codes collapse to empty string when disabled");

    terminal_set_color_enabled(1.0); // Restore

    let braille0 = terminal_spinner_braille(0.0);
    let braille1 = terminal_spinner_braille(1.0);
    all_pass = all_pass * test_assert(cartan_string_eq(braille0, "⠋") == 1.0 && cartan_string_eq(braille1, "⠙") == 1.0, "terminal_spinner_braille emits correct unicode frames");

    let ascii0 = terminal_spinner_ascii(0.0);
    let ascii1 = terminal_spinner_ascii(1.0);
    let ascii2 = terminal_spinner_ascii(2.0);
    let ascii3 = terminal_spinner_ascii(3.0);
    all_pass = all_pass * test_assert(cartan_string_eq(ascii0, "|") == 1.0 && cartan_string_eq(ascii1, "/") == 1.0 && cartan_string_eq(ascii2, "-") == 1.0 && cartan_string_eq(ascii3, "\\") == 1.0, "terminal_spinner_ascii emits correct 4-frame rotation");

    let hit = terminal_kbhit();
    all_pass = all_pass * test_assert(hit == 0.0 || hit == 1.0, "terminal_kbhit returns valid boolean flag without blocking");

    // -------------------------------------------------------------------------
    // Gate 3: HTML Parsing, Sanitization & URL Resolution (src/std/html.cl)
    // -------------------------------------------------------------------------
    printf("\n--- Gate 3: HTML Parsing, Sanitization & URL Resolution ---\n");

    let decoded = html_decode_entities("&lt;div&gt;Tom &amp; Jerry &quot;Show&quot;&lt;/div&gt;");
    all_pass = all_pass * test_assert(cartan_string_eq(decoded, "<div>Tom & Jerry \"Show\"</div>") == 1.0, "html_decode_entities correctly resolves XML/HTML entities");

    let doc = "<html><head><title>CARTAN Language Specification</title></head><body><h1>Title</h1><p>Hello world.</p></body></html>";
    let title = html_extract_title(doc);
    all_pass = all_pass * test_assert(cartan_string_eq(title, "CARTAN Language Specification") == 1.0, "html_extract_title extracts <title> text");

    let with_script = "<div>Visible Text</div><script type=\"text/javascript\">alert('evil');</script><p>After script</p>";
    let stripped_script = html_remove_tag_block(with_script, "<script", "</script>");
    all_pass = all_pass * test_assert(cartan_string_contains(stripped_script, "alert") == 0.0 && cartan_string_contains(stripped_script, "Visible Text") == 1.0, "html_remove_tag_block excises entire <script> block");

    let html_content = "<h1>Overview</h1><p>This is <b>bold</b> and <i>italic</i>.</p>";
    let plain = html_strip_tags(html_content);
    all_pass = all_pass * test_assert(cartan_string_contains(plain, "<p>") == 0.0 && cartan_string_contains(plain, "Overview") == 1.0 && cartan_string_contains(plain, "bold") == 1.0, "html_strip_tags converts markup to plaintext");

    let base = "https://example.com/docs/chapter1.html";
    let rel1 = url_resolve(base, "chapter2.html");
    let rel2 = url_resolve(base, "/index.html");
    let rel3 = url_resolve(base, "//cdn.example.com/asset.js");
    let rel4 = url_resolve(base, "https://google.com");
    all_pass = all_pass * test_assert(cartan_string_eq(rel1, "https://example.com/docs/chapter2.html") == 1.0, "url_resolve handles relative sibling path");
    all_pass = all_pass * test_assert(cartan_string_eq(rel2, "https://example.com/index.html") == 1.0, "url_resolve handles absolute domain path");
    all_pass = all_pass * test_assert(cartan_string_eq(rel3, "https://cdn.example.com/asset.js") == 1.0, "url_resolve handles protocol-relative URL");
    all_pass = all_pass * test_assert(cartan_string_eq(rel4, "https://google.com") == 1.0, "url_resolve preserves absolute URL");

    let ssrf_local = url_is_ssrf_blacklisted("http://localhost:8080/admin");
    let ssrf_loopback = url_is_ssrf_blacklisted("http://127.0.0.1/status");
    let ssrf_priv1 = url_is_ssrf_blacklisted("http://192.168.1.254/router");
    let ssrf_priv2 = url_is_ssrf_blacklisted("http://10.200.0.1/internal");
    let ssrf_safe = url_is_ssrf_blacklisted("https://cartan-lang.org/index.html");
    let ssrf_path10 = url_is_ssrf_blacklisted("https://example.com/v10.0/release");
    all_pass = all_pass * test_assert(ssrf_local == 1.0 && ssrf_loopback == 1.0 && ssrf_priv1 == 1.0 && ssrf_priv2 == 1.0, "url_is_ssrf_blacklisted blocks internal/loopback IPs");
    all_pass = all_pass * test_assert(ssrf_safe == 0.0, "url_is_ssrf_blacklisted permits public URLs");
    all_pass = all_pass * test_assert(ssrf_path10 == 0.0, "url_is_ssrf_blacklisted isolates host and permits URL path containing '10.'");

    let attr_extracted = html_extract_attribute("<a href=\"https://cartan-lang.org\" class=\"nav\">", "href");
    all_pass = all_pass * test_assert(cartan_string_eq(attr_extracted, "https://cartan-lang.org") == 1.0, "html_extract_attribute extracts href attribute value");

    let html_with_links = "<p>Visit <a href=\"https://cartan-lang.org\">CARTAN Language</a> or <a href=\"docs.html\">Documentation</a></p>";
    let links = html_extract_links(html_with_links, "https://cartan-lang.org/", 10.0);
    all_pass = all_pass * test_assert(cartan_string_contains(links, "CARTAN Language") == 1.0 && cartan_string_contains(links, "Documentation") == 1.0, "html_extract_links extracts hyperlinks with resolved targets");

    printf("\n================================================================================\n");
    if (all_pass == 1.0) {
        printf("  ALL TESTS PASSED: Standard Library String, Terminal & HTML Modules Verified!\n");
        printf("================================================================================\n");
        return 0.0;
    }
    printf("  TESTS FAILED: Regressions detected!\n");
    printf("================================================================================\n");
    return 1.0;
}
