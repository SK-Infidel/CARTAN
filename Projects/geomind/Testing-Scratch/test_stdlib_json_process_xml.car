// Projects/geomind/Testing-scratch/test_stdlib_json_process_xml.car
// Regression Test Target 90: CARTAN Standard Library JSON, Process & XML Modules

include "src/std/string.cl";
include "src/std/json.cl";
include "src/std/process.cl";
include "src/std/xml.cl";

extern fn printf(format: string) -> i32;

fn test_assert(cond: float, msg: string) -> float {
    if (cond == 1.0) {
        printf("  [PASS] ");
        printf(msg);
        printf("\n");
        return 1.0;
    }
    printf("  [FAIL] ");
    printf(msg);
    printf("\n");
    return 0.0;
}

fn main() -> float {
    printf("================================================================================\n");
    printf("  CARTAN STANDARD LIBRARY VERIFICATION: JSON, Process & XML (Target 90)\n");
    printf("================================================================================\n\n");

    var all_pass = 1.0;

    // -------------------------------------------------------------------------
    // Gate 1: Pure-CARTAN JSON Engine (src/std/json.cl)
    // -------------------------------------------------------------------------
    printf("--- Gate 1: Pure-CARTAN JSON Engine ---\n");

    let sample_json = "{\"model\": \"GeoMind-4B\", \"temperature\": 0.7, \"enabled\": true, \"disabled\": false, \"tags\": [\"sovereign\", \"e8\", \"manifold\"], \"lr_schedule\": [0.001, 0.0005, 0.0001], \"escaped\": \"Line1\\nLine2 with \\\"quotes\\\" and \\\\ slash\"}";

    // String extraction & unescaping
    let model_name = json_get_string(sample_json, "model");
    all_pass = all_pass * test_assert(cartan_string_eq(model_name, "GeoMind-4B") == 1.0, "json_get_string extracts clean unquoted string");
    free(model_name);

    let escaped_str = json_get_string(sample_json, "escaped");
    let has_newline = cartan_string_contains(escaped_str, "\n");
    let has_quote = cartan_string_contains(escaped_str, "\"");
    let has_slash = cartan_string_contains(escaped_str, "\\");
    all_pass = all_pass * test_assert(has_newline == 1.0 && has_quote == 1.0 && has_slash == 1.0, "json_get_string resolves \\n, \\\", and \\\\ escape sequences");
    free(escaped_str);

    let missing_str = json_get_string(sample_json, "nonexistent");
    all_pass = all_pass * test_assert(cartan_string_length(missing_str) == 0.0, "json_get_string returns empty string on missing key");

    // Float extraction
    let temp_val = json_get_float(sample_json, "temperature", 1.0);
    all_pass = all_pass * test_assert(temp_val > 0.69 && temp_val < 0.71, "json_get_float extracts decimal float values");

    let missing_flt = json_get_float(sample_json, "nonexistent_float", 42.0);
    all_pass = all_pass * test_assert(missing_flt == 42.0, "json_get_float returns fallback default on missing key");

    // Boolean extraction
    let bool_true = json_get_bool(sample_json, "enabled");
    let bool_false = json_get_bool(sample_json, "disabled");
    let bool_missing = json_get_bool(sample_json, "missing_flag");
    all_pass = all_pass * test_assert(bool_true == 1.0 && bool_false == 0.0 && bool_missing == 0.0, "json_get_bool parses true/false and defaults absent to 0.0");

    // Raw array extraction
    let raw_arr = json_get_array(sample_json, "tags");
    all_pass = all_pass * test_assert(cartan_string_starts_with(raw_arr, "[") == 1.0 && cartan_string_contains(raw_arr, "sovereign") == 1.0, "json_get_array extracts raw bracketed array slice");

    // String array parsing
    let str_list = json_parse_string_array(raw_arr);
    let n_tags = cartan_tree_len_f(str_list);
    let tag0 = cartan_tree_get_f32(str_list, 0.0);
    let tag1 = cartan_tree_get_f32(str_list, 1.0);
    let tag2 = cartan_tree_get_f32(str_list, 2.0);
    all_pass = all_pass * test_assert(n_tags == 3.0 && cartan_string_eq(tag0, "sovereign") == 1.0 && cartan_string_eq(tag1, "e8") == 1.0 && cartan_string_eq(tag2, "manifold") == 1.0, "json_parse_string_array unpacks string array elements into tree");
    json_free_string_array(str_list);
    free(raw_arr);

    // Float array parsing
    let raw_floats = json_get_array(sample_json, "lr_schedule");
    let flt_vec = json_parse_float_array(raw_floats, 0.0);
    let n_floats = cartan_vec_len(flt_vec);
    let f0 = cartan_vec_get_f32(flt_vec, 0.0);
    let f1 = cartan_vec_get_f32(flt_vec, 1.0);
    let f2 = cartan_vec_get_f32(flt_vec, 2.0);
    all_pass = all_pass * test_assert(n_floats == 3.0 && f0 > 0.0009 && f1 > 0.0004 && f2 > 0.00009, "json_parse_float_array parses numeric arrays into cartan_vec");
    cartan_vec_free(flt_vec);
    free(raw_floats);

    // String escaping & serialization
    let esc_sample = json_escape_string("Hello \"CARTAN\"\nNext line\tTabbed");
    all_pass = all_pass * test_assert(cartan_string_contains(esc_sample, "\\\"") == 1.0 && cartan_string_contains(esc_sample, "\\n") == 1.0 && cartan_string_contains(esc_sample, "\\t") == 1.0, "json_escape_string escapes quotes, newlines, and tabs");
    free(esc_sample);

    let ser_str = json_serialize_field_string("lang", "CARTAN");
    let ser_flt = json_serialize_field_float("version", 8.499);
    let ser_b = json_serialize_field_bool("self_hosting", 1.0);
    all_pass = all_pass * test_assert(cartan_string_eq(ser_str, "\"lang\": \"CARTAN\"") == 1.0, "json_serialize_field_string formats key-value pair");
    all_pass = all_pass * test_assert(cartan_string_contains(ser_flt, "\"version\": 8.499") == 1.0, "json_serialize_field_float formats key-value pair");
    all_pass = all_pass * test_assert(cartan_string_eq(ser_b, "\"self_hosting\": true") == 1.0, "json_serialize_field_bool formats boolean pair");
    free(ser_str);
    free(ser_flt);
    free(ser_b);

    // -------------------------------------------------------------------------
    // Gate 2: Sandboxed Process Execution Engine (src/std/process.cl)
    // -------------------------------------------------------------------------
    printf("\n--- Gate 2: Sandboxed Process Execution Engine ---\n");

    let echo_out = process_exec("echo CARTAN_PROCESS_OK");
    all_pass = all_pass * test_assert(cartan_string_contains(echo_out, "CARTAN_PROCESS_OK") == 1.0, "process_exec captures shell stdout cleanly");
    free(echo_out);

    let empty_proc = process_exec("");
    all_pass = all_pass * test_assert(cartan_string_length(empty_proc) == 0.0, "process_exec guards against empty command string");

    let err_out = process_exec("exit 42");
    all_pass = all_pass * test_assert(cartan_string_contains(err_out, "[Exit code: 42]") == 1.0, "process_exec captures non-zero exit code indicator");
    all_pass = all_pass * test_assert(process_last_exit_code() == 42.0, "process_last_exit_code accurately reports last status");
    free(err_out);

    let rc_file = process_exec_to_file("echo FILE_OUT_TEST", "scratch/_test_proc_to_file.tmp");
    let file_exists = cartan_file_exists("scratch/_test_proc_to_file.tmp");
    var file_content = "";
    if (file_exists == 1.0) {
        file_content = cartan_read_file("scratch/_test_proc_to_file.tmp");
        remove("scratch/_test_proc_to_file.tmp");
    }
    all_pass = all_pass * test_assert(rc_file == 0.0 && cartan_string_contains(file_content, "FILE_OUT_TEST") == 1.0, "process_exec_to_file redirects output directly to disk");
    if (cartan_string_length(file_content) > 0.0) { free(file_content); }

    let safe_p1 = process_is_path_safe("docs/spec.md", "");
    let safe_p2 = process_is_path_safe("docs/../secret.txt", "");
    let safe_p3 = process_is_path_safe("..\\windows\\system32", "");
    all_pass = all_pass * test_assert(safe_p1 == 1.0 && safe_p2 == 0.0 && safe_p3 == 0.0, "process_is_path_safe rejects directory traversal sequences");

    // -------------------------------------------------------------------------
    // Gate 3: Lightweight XML String Extractors (src/std/xml.cl)
    // -------------------------------------------------------------------------
    printf("\n--- Gate 3: Lightweight XML String Extractors ---\n");

    let xml_tag1 = "<tool_call:exec_command cmd=\"dir /B\" timeout=\"1000\"/>";
    let attr_cmd = xml_extract_attribute(xml_tag1, "cmd");
    let attr_to = xml_extract_attribute(xml_tag1, "timeout");
    all_pass = all_pass * test_assert(cartan_string_eq(attr_cmd, "dir /B") == 1.0 && cartan_string_eq(attr_to, "1000") == 1.0, "xml_extract_attribute parses double-quoted attributes");
    free(attr_cmd);
    free(attr_to);

    let xml_tag2 = "<tool_call:write_file path='scratch/test.txt' mode='append'/>";
    let attr_path = xml_extract_attribute(xml_tag2, "path");
    let attr_mode = xml_extract_attribute(xml_tag2, "mode");
    all_pass = all_pass * test_assert(cartan_string_eq(attr_path, "scratch/test.txt") == 1.0 && cartan_string_eq(attr_mode, "append") == 1.0, "xml_extract_attribute parses single-quoted attributes");
    free(attr_path);
    free(attr_mode);

    let xml_block = "<message id=\"101\"><content>This is the inner XML content</content></message>";
    let inner_body = xml_extract_tag_body(xml_block);
    all_pass = all_pass * test_assert(cartan_string_contains(inner_body, "<content>") == 1.0, "xml_extract_tag_body extracts body between outer tags");
    free(inner_body);

    let target_body = xml_extract_tag_body_by_name(xml_block, "content");
    all_pass = all_pass * test_assert(cartan_string_eq(target_body, "This is the inner XML content") == 1.0, "xml_extract_tag_body_by_name targets specific named element body");
    free(target_body);

    // -------------------------------------------------------------------------
    // Gate 4: Manifest Parsing & Linear Scan Benchmark Gate
    // -------------------------------------------------------------------------
    printf("\n--- Gate 4: Manifest Parsing & Linear Scan Benchmark ---\n");

    var line_idx = 0.0;
    var bench_pass = 1.0;
    while (line_idx < 10.0) {
        let manifest_line = "{\"idx\": 1.0, \"dataset\": \"alpaca_instructions\", \"cloze\": \"Linear scan test cloze.\", \"target\": \"Success\"}";
        let c = json_get_string(manifest_line, "cloze");
        let t = json_get_string(manifest_line, "target");
        let ds = json_get_string(manifest_line, "dataset");
        if (cartan_string_eq(c, "Linear scan test cloze.") == 0.0 || cartan_string_eq(t, "Success") == 0.0 || cartan_string_eq(ds, "alpaca_instructions") == 0.0) {
            bench_pass = 0.0;
        }
        free(c);
        free(t);
        free(ds);
        line_idx = line_idx + 1.0;
    }
    all_pass = all_pass * test_assert(bench_pass == 1.0, "JSON parser reliably processes repeated manifest lines with zero memory leaks");

    printf("\n================================================================================\n");
    if (all_pass == 1.0) {
        printf("  ALL TESTS PASSED: Standard Library JSON, Process & XML Modules Verified!\n");
        printf("================================================================================\n");
        return 0.0;
    }
    printf("  TESTS FAILED: Regressions detected!\n");
    printf("================================================================================\n");
    return 1.0;
}
