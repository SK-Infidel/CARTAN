// test/compiler_suite/test_hebbian_plasticity.car
// Verification Suite: Three-Factor Hebbian Synaptic Plasticity & Inference Learning

include "../../src/std/hebbian.cl";
include "../../src/std/math.cl";
include "../../src/std/collections.cl";
include "../../src/std/string.cl";

extern fn printf(format: string) -> i32;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn cartan_float_to_string(v: float) -> string;
extern fn cartan_tensor_hebbian_update(pre: ptr, post: ptr, m: float, lr: float) -> float;
extern fn cartan_hebbian_step_token(h: ptr, tok: float, m: float, lr: float) -> float;

fn main() -> float {
    printf("=================================================================================\n");
    printf("  CARTAN TEST SUITE: THREE-FACTOR HEBBIAN PLASTICITY VERIFICATION\n");
    printf("=================================================================================\n\n");

    let dim = 8.0;

    // [1/5] Vector Outer Product Calculation
    printf("[1/5] Verifying Vector Outer Product (Pre (x) Post)...\n");
    let pre = cartan_vec_create();
    let post = cartan_vec_create();
    var idx = 0.0;
    while (idx < dim) {
        cartan_vec_push_f32(pre, (idx + 1.0) * 0.2);
        cartan_vec_push_f32(post, (idx + 2.0) * 0.1);
        idx = idx + 1.0;
    }
    let outer = hebbian_vector_outer_product(pre, post);
    let total_elements = cartan_vec_len(outer);
    cartan_assert(total_elements == 64.0, "Outer product of 8x8 must yield 64 elements");
    let w00 = cartan_vec_get_f32(outer, 0.0);
    // pre[0] = 0.2, post[0] = 0.2 -> 0.04
    cartan_assert(w00 > 0.039 && w00 < 0.041, "Outer product [0,0] must equal 0.04");
    printf("  Outer product verified: Dim %s x %s = %s elements (w[0,0] = %s)\n",
        cartan_float_to_string(dim), cartan_float_to_string(dim),
        cartan_float_to_string(total_elements), cartan_float_to_string(w00));
    printf("[1/5] Vector Outer Product assertions PASSED.\n\n");

    // [2/5] Canonical Three-Factor Hebbian Synaptic Update (\Delta W = \eta \cdot Pre \cdot Post \cdot M)
    printf("[2/5] Verifying Canonical Three-Factor Synaptic Update...\n");
    let w_mat = cartan_tensor_alloc(64.0);
    var k = 0.0;
    while (k < 64.0) {
        cartan_vec_set_f32(w_mat, k, 0.0);
        k = k + 1.0;
    }
    // Apply update with learning rate 0.1 and positive neuromodulator M = +1.0
    hebbian_three_factor_update(w_mat, dim, dim, pre, post, 1.0, 0.1, 0.0);
    let updated_w00 = cartan_vec_get_f32(w_mat, 0.0);
    // delta = 0.1 * 1.0 * (0.2 * 0.2) = 0.004
    cartan_assert(updated_w00 > 0.0039 && updated_w00 < 0.0041, "Three-factor update must match mathematical product");
    printf("  Three-Factor Hebbian update: delta W[0,0] = %s\n", cartan_float_to_string(updated_w00));
    printf("[2/5] Three-Factor Synaptic Update assertions PASSED.\n\n");

    // [3/5] Neuromodulated Sign Inversion: Positive Reinforcement vs Negative Penalty
    printf("[3/5] Verifying Neuromodulated Directional Plasticity (M = +1.0 vs M = -1.0)...\n");
    let w_pos = cartan_tensor_alloc(64.0);
    let w_neg = cartan_tensor_alloc(64.0);
    k = 0.0;
    while (k < 64.0) {
        cartan_vec_set_f32(w_pos, k, 0.5);
        cartan_vec_set_f32(w_neg, k, 0.5);
        k = k + 1.0;
    }
    // Positive reward: M = +1.0 -> weight increases
    hebbian_three_factor_update(w_pos, dim, dim, pre, post, 1.0, 0.05, 0.0);
    // Negative penalty: M = -1.0 -> weeight decreases
    hebbian_three_factor_update(w_neg, dim, dim, pre, post, -1.0, 0.05, 0.0);
    let val_pos = cartan_vec_get_f32(w_pos, 0.0);
    let val_neg = cartan_vec_get_f32(w_neg, 0.0);
    cartan_assert(val_pos > 0.5, "Positive neuromodulator must strengthen synapse");
    cartan_assert(val_neg < 0.5, "Negative neuromodulator must weaken synapse");
    printf("  Reward strengthened W[0,0]: 0.5 -> %s | Penalty weakened W[0,0]: 0.5 -> %s\n",
        cartan_float_to_string(val_pos), cartan_float_to_string(val_neg));
    printf("[3/5] Neuromodulated Directional Plasticity assertions PASSED.\n\n");

    // [4/5] Oja Stabilization & Weight Bounding under Repeated Stimulation
    printf("[4/5] Verifying Oja Stabilized Hebbian Plasticity...\n");
    let w_oja = cartan_tensor_alloc(64.0);
    k = 0.0;
    while (k < 64.0) {
        cartan_vec_set_f32(w_oja, k, 0.1);
        k = k + 1.0;
    }
    var step = 0.0;
    while (step < 50.0) {
        hebbian_oja_update(w_oja, dim, dim, pre, post, 1.0, 0.05, 0.5);
        step = step + 1.0;
    }
    let norm_oja = hebbian_matrix_norm(w_oja, 64.0);
    cartan_assert(norm_oja > 0.0 && norm_oja < 50.0, "Oja rule must prevent runaway weight explosion");
    printf("  Oja stabilized matrix Frobenius norm after 50 iterations: %s\n", cartan_float_to_string(norm_oja));
    printf("[4/5] Oja Stabilized Hebbian Plasticity assertions PASSED.\n\n");

    // [5/5] C Runtime In-Place Synaptic Updates & Inference Learning Binding
    printf("[5/5] Verifying C Runtime Three-Factor Hebbian Binding...\n");
    let h_pre = cartan_vec_create();
    let h_post = cartan_vec_create();
    var d = 0.0;
    while (d < 2560.0) {
        cartan_vec_push_f32(h_pre, sin((d + 1.0) * 0.01) * 0.2);
        cartan_vec_push_f32(h_post, cos((d + 1.0) * 0.01) * 0.2);
        d = d + 1.0;
    }
    let rt_status1 = cartan_tensor_hebbian_update(h_pre, h_post, 1.0, 0.001);
    cartan_assert(rt_status1 == 1.0, "C runtime tensor hebbian update must return 1.0");

    let rt_status2 = cartan_hebbian_step_token(h_pre, 42.0, 1.0, 0.002);
    cartan_assert(rt_status2 == 1.0, "C runtime token hebbian step must return 1.0");
    printf("  C Runtime in-place synaptic updates verified: Matrix status %s | Token status %s\n",
        cartan_float_to_string(rt_status1), cartan_float_to_string(rt_status2));
    printf("[5/5] C Runtime Hebbian Binding assertions PASSED.\n\n");

    printf("TEST_HEBBIAN_PLASTICITY_SUCCESS\n\n");
    cartan_flush(0.0);
    return 0.0;
}
