// test/compiler_suite/test_net_abstraction.car
// CARTAN Regression Target [15/15]: Standard Network Library Abstractions Pass
// // run-pass

include "../../src/std/net.car";

extern fn cartan_assert(cond: float, msg: string) -> float;
extern fn cartan_string_length(s: string) -> float;

fn main(argc: float, argv: ptr) -> float {
    let sock = net::socket();
    cartan_assert(sock > 0.0, "net::socket creation failed");

    let conn = net::connect(sock, "127.0.0.1", 8080.0);
    cartan_assert(conn == 1.0, "net::connect failed");

    let sent = net::send(sock, "GET / HTTP/1.1\r\n\r\n");
    cartan_assert(sent > 0.0, "net::send failed");

    let resp = net::recv(sock);
    cartan_assert(cartan_string_length(resp) > 0.0, "net::recv failed");

    let closed = net::close(sock);
    cartan_assert(closed == 1.0, "net::close failed");

    return 0.0;
}
