fn print_help_dialogue() -> float {
    printf("================================================================================\n");
    printf("  GEOMIND PRODUCTION AI ENGINE (geomind.exe)\n");
    printf("  Lie Group E8 Manifold Architecture | Continuous Hopfield Resonator\n");
    printf("  Powered by CARTAN Standard Library Layer 1/Layer 2 Stack\n");
    printf("================================================================================\n\n");
    printf("Usage: geomind.exe [mode flag] [options]\n");
    printf("  (Default: Launches interactive WebGPU chat engine when run without mode flags)\n\n");
    printf("Modes:\n");
    printf("  --chat          Start interactive E8 Hopfield multimodal chat engine (DEFAULT MODE)\n");
    printf("                  Flags: -prompt <text>, -tokens <num>, -temp <float>, -cpu, -stream-prune, -speculative-draft\n");
    printf("  --hf-download   Explore & download HuggingFace datasets (-repo <repo_id>)\n");
    printf("  --train-pre     Pre-train model on skill corpus (-target <file>|-repo <id>)\n");
    printf("  --train-cloze   Run Anchored Cloze Curriculum Stream (-target <file>)\n");
    printf("  --train-ce      Run Cross-Entropy Autoregressive Pre-Trainer (-target <file>)\n");
    printf("  --train-sft     Run Supervised Fine-Tuning loop (-repo <id>|-target <file>)\n");
    printf("  --train-distill Run Teacher-Student KL divergence logit distillation pass\n");
    printf("  --merge-slerp   Run Zero-Day SLERP geodesic model weight merging pipeline\n");
    printf("  --graft         Graft 42-layer sovereign multimodal weights into manifold\n");
    printf("  --azr-selfplay  Run Absolute Zero Reasoning (AZR) compiler self-play loop\n");
    printf("  --ingest        Ingest material into Continuous Hopfield memory (-target <file>)\n");
    printf("  --sleep         Run Autonomous Metacognitive Sleep memory consolidation\n");
    printf("  --train-webgpu  Run pure native CARTAN WebGPU Causal Training Engine\n");
    printf("  --help, -h      Display this help dialogue and exit\n\n");
    printf("Hardware & Compute Flags:\n");
    printf("  (WebGPU hardware acceleration on NVIDIA RTX 2000 Ada GPU is ENABLED BY DEFAULT)\n");
    printf("  -cpu, --cpu, -no-gpu, --no-gpu: Run on CPU only (disables WebGPU hardware acceleration)\n");
    printf("  -context <num>, --context <num>: Set max context window capacity in tokens (Default: 8192 [8k], up to 131072 [128k])\n");
    printf("                                   Accepted values: 2048, 8192, 32768, 65536, 131072\n\n");
    printf("Training & Optimization Flags (Optional - All have calibrated defaults):\n");
    printf("  -target-loss <float>, -tl, -loss, -training-loss: Universal target loss stopping threshold\n");
    printf("                       Default: 2.50 Cloze, 3.00 CE, 2.00 SFT. Accepted universally across all modes.\n");
    printf("                       When any individual dataset in the corpus reaches this loss,\n");
    printf("                       weight updates on the backward pass are frozen for that dataset.\n");
    printf("  -epochs <num>, -ep   Optional maximum epoch ceiling (Default: Unlimited until target loss reached)\n");
    printf("                       Each epoch traverses 100%% of the dataset corpus from start to finish.\n");
    printf("  -lr <float>          Starting base learning rate ceiling (Default: 0.001)\n");
    printf("                       Omitting -lr uses the optimal default: starts at 0.001,\n");
    printf("                       decays 0.90/epoch to 0.0001 floor. Never exceeds this ceiling.\n");
    printf("  -target <file>       Explicit dataset file path on disk (Defaults to stage corpus)\n");
    printf("  -stride <bytes>      Sliding curriculum stride in bytes (Default: 2048 Cloze, 1024 CE)\n");
    printf("  -manifest <file>     Multi-dataset JSON manifest path (Default: Projects/geomind/trainingdata/corpus.json)\n");
    printf("  -reset-manifest      Reset manifest position to dataset 0, offset 0.0, epoch 1.0\n");
    printf("  -focus-delta <float> Focus trigger PPL delta above anchor (Default: 25.0)\n");
    printf("  -focus-ratio <float> Focus trigger PPL ratio above anchor (Default: 1.35)\n");
    printf("  -focus-budget <num>  Maximum focused chunk budget before yielding (Default: 24.0)\n");
    printf("  -auto-sft [loss]     Automatically transition to SFT when CE target loss is reached\n");
    printf("                       Optional argument specifies SFT target loss (Default: 2.00, e.g. -auto-sft 2.5)\n\n");
    printf("Targeting & Multimodal Flags:\n");
    printf("  -target <file>  Explicit dataset file path on disk\n");
    printf("  -repo <repo_id> HuggingFace dataset repository ID\n");
    printf("  --image <file>  Input image file (PPM / BMP) for visual Eikonal grounding\n");
    printf("  --audio <file>  Input audio file (WAV PCM) for auditory Spectral grounding\n\n");
    printf("Safety, Resumption & Persistence:\n");
    printf("  - Multi-Dataset Manifest: Sequences across all datasets configured in corpus.json.\n");
    printf("  - Byte-Exact Resumption: Tracks dataset index, byte offset, and epoch in corpus.json.\n");
    printf("    Interrupted training (Ctrl-C) automatically preserves current weights and resumes\n");
    printf("    from the exact byte offset without restarting or losing progress.\n");
    printf("  - Pre-Training Backup: Automatically creates .bin.bak before fresh multi-epoch runs.\n\n");
    printf("================================================================================\n");
    cartan_flush(0.0);
    return 0.0;
}

// Validate pre-training mode flags and aliases
fn is_pre_mode(flag: string) -> float {
    if (cartan_string_eq(flag, "--train-pre") == 1.0 ||
        cartan_string_eq(flag, "-train-pre") == 1.0 ||
        cartan_string_eq(flag, "train-pre") == 1.0 ||
        cartan_string_eq(flag, "--pre") == 1.0 ||
        cartan_string_eq(flag, "-pre") == 1.0 ||
        cartan_string_eq(flag, "pre") == 1.0) {
        return 1.0;
    }
    return 0.0;
}

// Validate cloze curriculum mode flags and aliases
fn is_cloze_mode(flag: string) -> float {
    if (cartan_string_eq(flag, "--train-cloze") == 1.0 ||
        cartan_string_eq(flag, "-train-cloze") == 1.0 ||
        cartan_string_eq(flag, "train-cloze") == 1.0 ||
        cartan_string_eq(flag, "--cloze") == 1.0 ||
        cartan_string_eq(flag, "-cloze") == 1.0 ||
        cartan_string_eq(flag, "cloze") == 1.0) {
        return 1.0;
    }
    return 0.0;
}

