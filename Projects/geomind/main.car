// Determines if a command line flag is an explicit non-chat command mode
fn is_explicit_non_chat_mode(flag: string) -> float {
    if (cartan_string_eq(flag, "--help") == 1.0 || cartan_string_eq(flag, "-h") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--hf-download") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--sleep") == 1.0) { return 1.0; }
    if (is_cloze_mode(flag) == 1.0) { return 1.0; }
    if (is_ce_mode(flag) == 1.0) { return 1.0; }
    if (is_sft_mode(flag) == 1.0) { return 1.0; }
    if (is_pre_mode(flag) == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--train-distill") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--train-webgpu") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--rlaif") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--ingest") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--analogy") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--merge-slerp") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--graft") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--azr-selfplay") == 1.0) { return 1.0; }
    return 0.0;
}

// Checks if any non-chat mode was explicitly specified on the command line
fn has_non_chat_mode_arg(arg_count: float) -> float {
    var i = 1.0;
    while (i < arg_count) {
        let flag = sys_get_arg(i);
        if (is_explicit_non_chat_mode(flag) == 1.0) {
            return 1.0;
        }
        i = i + 1.0;
    }
    return 0.0;
}

// Retrieve string CLI parameter value matching single or double dash
fn get_cli_param(flag_name: string, arg_count: float) -> string {
    var i = 1.0;
    while (i < arg_count) {
        let arg = sys_get_arg(i);
        var is_matched = 0.0;
        if (cartan_string_eq(arg, flag_name) == 1.0) {
            is_matched = 1.0;
        }
        if (is_matched == 0.0 && cartan_string_starts_with(flag_name, "-") == 1.0) {
            let dbl = cartan_string_concat("-", flag_name);
            if (cartan_string_eq(arg, dbl) == 1.0) {
                is_matched = 1.0;
            }
        }
        if (is_matched == 1.0 && (i + 1.0) < arg_count) {
            return sys_get_arg(i + 1.0);
        }
        i = i + 1.0;
    }
    return "";
}

// Retrieve multi-word CLI prompt argument across single/double dash, assembling tokens until next flag
fn get_cli_prompt(arg_count: float) -> string {
    var i = 1.0;
    while (i < arg_count) {
        let arg = sys_get_arg(i);
        if (cartan_string_eq(arg, "-prompt") == 1.0 || cartan_string_eq(arg, "--prompt") == 1.0) {
            var full_prompt = "";
            var j = i + 1.0;
            while (j < arg_count) {
                let next_arg = sys_get_arg(j);
                if (cartan_string_starts_with(next_arg, "-") == 1.0) {
                    break;
                }
                if (cartan_string_length(full_prompt) > 0.0) {
                    full_prompt = cartan_string_concat(full_prompt, " ");
                }
                full_prompt = cartan_string_concat(full_prompt, next_arg);
                j = j + 1.0;
            }
            return full_prompt;
        }
        i = i + 1.0;
    }
    return "";
}

// Check presence of CLI flag matching single or double dash
fn get_cli_flag_present(flag_name: string, arg_count: float) -> float {
    var i = 1.0;
    while (i < arg_count) {
        let arg = sys_get_arg(i);
        if (cartan_string_eq(arg, flag_name) == 1.0) {
            return 1.0;
        }
        if (cartan_string_starts_with(flag_name, "-") == 1.0) {
            let dbl = cartan_string_concat("-", flag_name);
            if (cartan_string_eq(arg, dbl) == 1.0) {
                return 1.0;
            }
        }
        i = i + 1.0;
    }
    return 0.0;
}

fn get_cli_target_path(arg_count: float) -> string {
    return get_cli_param("-target", arg_count);
}

fn get_cli_train_target(arg_count: float) -> string {
    let manifest_arg = get_cli_param("-manifest", arg_count);
    if (cartan_string_length(manifest_arg) > 0.0) {
        return manifest_arg;
    }
    return get_cli_param("-target", arg_count);
}

fn check_and_apply_manifest_reset(target: string, arg_count: float, default_manifest: string) {
    let reset_flag = get_cli_flag_present("-reset-manifest", arg_count);
    if (reset_flag == 1.0) {
        var m_path = geomind_resolve_path(default_manifest);
        if (cartan_string_length(target) > 0.0 && cartan_string_ends_with(target, ".json") == 1.0) {
            m_path = geomind_resolve_path(target);
        }
        if (cartan_file_exists(m_path) == 1.0) {
            let m_content = cartan_read_file(m_path);
            let list = geomind_manifest_parse_datasets(m_content);
            var reset_lr = 0.05;
            if (cartan_string_contains(m_path, "corpus.json") == 1.0) {
                reset_lr = 0.0022;
            }
            geomind_manifest_save(m_path, list, 0.0, 0.0, 1.0, reset_lr);
            printf("[GeoMind Main] Manifest reset to dataset 0, offset 0.0, epoch 1.0 (LR: %s): %s\n", cartan_float_to_string(reset_lr), m_path);
            cartan_flush(0.0);
        }
    }
}

fn get_cli_param_float(flag_name: string, arg_count: float, default_val: float) -> float {
    let p = get_cli_param(flag_name, arg_count);
    if (cartan_string_length(p) > 0.0) {
        return atof(p);
    }
    var i = 1.0;
    let eq_flag = cartan_string_concat(flag_name, "=");
    let dbl_eq_flag = cartan_string_concat("-", eq_flag);
    while (i < arg_count) {
        let arg = sys_get_arg(i);
        if (cartan_string_starts_with(arg, eq_flag) == 1.0) {
            let val_str = cartan_string_substring(arg, cartan_string_length(eq_flag), cartan_string_length(arg));
            return atof(val_str);
        }
        if (cartan_string_starts_with(arg, dbl_eq_flag) == 1.0) {
            let val_str = cartan_string_substring(arg, cartan_string_length(dbl_eq_flag), cartan_string_length(arg));
            return atof(val_str);
        }
        i = i + 1.0;
    }
    return default_val;
}

// Parse target loss stopping threshold across all aliases
fn get_cli_target_loss(arg_count: float, default_val: float) -> float {
    var i = 1.0;
    while (i < arg_count) {
        let arg = sys_get_arg(i);
        if (cartan_string_eq(arg, "-training-loss") == 1.0 ||
            cartan_string_eq(arg, "--training-loss") == 1.0 ||
            cartan_string_eq(arg, "-target-loss") == 1.0 ||
            cartan_string_eq(arg, "--target-loss") == 1.0 ||
            cartan_string_eq(arg, "-tl") == 1.0 ||
            cartan_string_eq(arg, "--tl") == 1.0 ||
            cartan_string_eq(arg, "-loss") == 1.0 ||
            cartan_string_eq(arg, "--loss") == 1.0) {
            if ((i + 1.0) < arg_count) {
                return atof(sys_get_arg(i + 1.0));
            }
        }
        i = i + 1.0;
    }
    return default_val;
}

